build/
*.mzML
*.parquet
*.tsv
__pycache__/

# Sample registry: real acquisition and specimen paths, never committed.
harness/samples.yaml

# Benchmark drivers with real acquisition paths, never committed.
bench/run_joint.sh
bench/run_open.sh

# Frozen run records: kept locally, not in the repository.
evidence/

# Review dispatch/stderr logs: the .md reviews are the artefact.
docs/reviews/**/*.log

# Corpus review inputs: the review brief and the raw session transcripts of the reviewer that
# returned nothing (the brief echoed back, then a quota error) quote the sample registry, so they
# carry 43 raw acquisition paths. No tracked file names a raw acquisition path; these stay local.
# The review artefacts themselves -- the verdicts, the per-reviewer reports and the dispatch log --
# are committed.
harness/review/corpus-brief.md
harness/review/*.transcript
