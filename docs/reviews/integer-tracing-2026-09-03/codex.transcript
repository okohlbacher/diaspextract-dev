  1363	        it != group_to_frames.end() ? static_cast<int>(it->second.size()) : 0);
  1364	    }
  1365	
  1366	    return meta;
  1367	  }
  1368	
  1369	  // =====================================================================
  1370	  // loadDIAStreaming: stream DIA spectra to consumer one-at-a-time
  1371	  // =====================================================================
  1372	  void BrukerTimsFile::loadDIAStreaming(const String& path, FullSwathFileConsumer& consumer)
  1373	  {
  1374	    loadDIAStreaming(path, consumer, Config());
  1375	  }
  1376	
  1377	  void BrukerTimsFile::loadDIAStreaming(
  1378	      const String& path, FullSwathFileConsumer& consumer, const Config& config)
  1379	  {
  1380	    auto handle = openTimsDataHandle(path, config);
  1381	    String tdf_path = handle->get_tims_dir_path() + "/analysis.tdf";
  1382	    SQLite::Database db(std::string(tdf_path), SQLite::OPEN_READONLY);
  1383	
  1384	    // --- MS1 frames ---
  1385	    FrameCentroider centroider;
  1386	    FrameAggregator ms1_aggregator(0.01);
  1387	
  1388	    std::vector<uint32_t> ms1_frame_ids;
  1389	    for (uint32_t fid = handle->min_frame_id(); fid <= handle->max_frame_id(); ++fid)
  1390	    {
  1391	      if (handle->has_frame(fid) && handle->get_frame(fid).msms_type == 0)
  1392	        ms1_frame_ids.push_back(fid);
  1393	    }
  1394	    warnPartialMS1AggregationConfig(config, ms1_frame_ids.size());
  1395	    if (config.ms1_n_neighbors > 0) ms1_aggregator.reserve(300'000);
  1396	
  1397	    const size_t ms1_to_emit = config.load_ms1 ? ms1_frame_ids.size() : 0;
  1398	    startProgress(0, ms1_to_emit, "Streaming DIA-PASEF MS1 frames");
  1399	    for (size_t i = 0; i < ms1_to_emit; ++i)
  1400	    {
  1401	      MSSpectrum spec;
  1402	      if (config.ms1_n_neighbors > 0)
  1403	      {
  1404	        loadAggregatedMS1Spectrum(*handle, ms1_frame_ids, i, config,
  1405	                                  ms1_aggregator, centroider, spec);
  1406	      }
  1407	      else
  1408	      {
  1409	        TimsFrame& frame = handle->get_frame(ms1_frame_ids[i]);
  1410	        loadMS1Spectrum(frame, spec, config, centroider);
  1411	      }
  1412	      // Sort peaks by m/z (and the associated IM float data array alongside).
  1413	      // TIMS save_to_buffs returns peaks in (scan_id, m/z-within-scan) order,
  1414	      // which is NOT globally m/z-sorted. Downstream consumers
  1415	      // (OpenSwath's chromatogram extraction) assume sorted m/z for lower_bound /
  1416	      // upper_bound range queries; without this sort, queries silently miss
  1417	      // peaks, producing empty chromatograms and breaking iRT calibration.
  1418	      // The non-streaming load() path gets this sort for free via exp.sortSpectra(true).
  1419	      spec.sortByPosition();
  1420	      consumer.consumeSpectrum(spec);
  1421	      setProgress(i);
  1422	    }
  1423	    endProgress();
  1424	    centroider.reportCapSummary(static_cast<size_t>(config.ms1_centroid_max_peaks));
  1425	
  1426	    // --- MS2 frames: raw per-WindowGroup iteration (no aggregation) ---
  1427	    auto windows = readDIAWindows(db, *handle->scan2inv_ion_mobility_converter);
  1428	    if (windows.empty())
  1429	    {
  1430	      OPENMS_LOG_WARN << "Warning: DIA dataset detected but no SWATH windows found" << std::endl;
  1431	      return;
  1432	    }
  1433	
  1434	    auto group_to_frames = readFrameToWindowGroupMapping(db, windows);
  1435	
  1436	    std::map<int, std::vector<const DIAWindow*>> group_to_windows;
  1437	    for (const auto& w : windows)
  1438	      group_to_windows[w.window_group].push_back(&w);
  1439	
  1440	    Size total_work = 0;
  1441	    for (const auto& [group, frames] : group_to_frames)
  1442	    {
  1443	      auto wit = group_to_windows.find(group);
  1444	      if (wit != group_to_windows.end())
  1445	        total_work += frames.size() * wit->second.size();
  1446	    }
  1447	
  1448	    startProgress(0, total_work, "Streaming DIA-PASEF MS2 frames");
  1449	    Size progress_count = 0;
  1450	
  1451	    for (const auto& [group, frame_ids] : group_to_frames)
  1452	    {
  1453	      auto wit = group_to_windows.find(group);
  1454	      if (wit == group_to_windows.end()) continue;
  1455	      const auto& dia_windows = wit->second;
  1456	
  1457	      for (const DIAWindow* win : dia_windows)
  1458	      {
  1459	        for (size_t i = 0; i < frame_ids.size(); ++i)
  1460	        {
  1461	          setProgress(progress_count++);
  1462	          TimsFrame& frame = handle->get_frame(frame_ids[i]);
  1463	          if (frame.num_peaks == 0) continue;
  1464	
  1465	          std::vector<uint32_t> scan_ids(frame.num_peaks);
  1466	          std::vector<uint32_t> intensities(frame.num_peaks);
  1467	          std::vector<double> mzs(frame.num_peaks);
  1468	          std::vector<double> inv_ion_mobilities(frame.num_peaks);
  1469	
  1470	          frame.save_to_buffs(nullptr, scan_ids.data(), nullptr, intensities.data(),
  1471	                              mzs.data(), inv_ion_mobilities.data(), nullptr);
  1472	
  1473	          MSSpectrum spec;
  1474	          spec.setRT(frame.time);
  1475	          spec.setMSLevel(2);
  1476	          spec.setDriftTimeUnit(DriftTimeUnit::VSSC);
  1477	          spec.setType(SpectrumSettings::SpectrumType::CENTROID);
  1478	          spec.setNativeID("frame=" + String(frame.id) + " windowGroup=" + String(win->window_group) + " scan=" + String(win->scan_begin));
  1479	
  1480	          Precursor prec;
  1481	          prec.setMZ(win->mz_center);
  1482	          prec.setIsolationWindowLowerOffset(win->mz_width / 2.0);
  1483	          prec.setIsolationWindowUpperOffset(win->mz_width / 2.0);
  1484	          spec.setPrecursors({prec});
  1485	
  1486	          spec.setMetaValue("ion mobility lower limit", win->im_lower);
  1487	          spec.setMetaValue("ion mobility upper limit", win->im_upper);
  1488	
  1489	          DataArrays::FloatDataArray im_array;
  1490	          IMDataConverter::setIMUnit(im_array, DriftTimeUnit::VSSC);
  1491	
  1492	          for (uint32_t p = 0; p < frame.num_peaks; ++p)
  1493	          {
  1494	            if (inv_ion_mobilities[p] >= win->im_lower && inv_ion_mobilities[p] <= win->im_upper)
  1495	            {
  1496	              Peak1D peak;
  1497	              peak.setMZ(mzs[p]);
  1498	              peak.setIntensity(static_cast<double>(intensities[p]));
  1499	              spec.push_back(peak);
  1500	              im_array.push_back(static_cast<float>(inv_ion_mobilities[p]));
  1501	            }
  1502	          }
  1503	
  1504	          if (!spec.empty())
  1505	          {
  1506	            spec.getFloatDataArrays().push_back(std::move(im_array));
  1507	            spec.setIMPeakType(IMPeakType::IM_PROFILE);
  1508	            // Sort peaks by m/z (and the IM float data array alongside).
  1509	            // See the matching comment in the MS1 loop above — TIMS save_to_buffs
  1510	            // returns peaks in (scan_id, m/z-within-scan) order; OpenSwath's
  1511	            // chromatogram extraction assumes globally m/z-sorted input.
  1512	            spec.sortByPosition();
  1513	            consumer.consumeSpectrum(spec);
  1514	          }
  1515	        }
  1516	      }
  1517	    }
  1518	    endProgress();
  1519	  }
