  2158	  /// Per-precursor assembly: this precursor claims every fragment passing its gate (a fragment may
  2159	  /// be shared across precursors -> chimeric). Leaves @p out empty on failure.
  2160	  void assembleOne_(const Precursor_& pc, double win_lo, double win_hi,
  2161	                    const vector<Trace>& frag_traces, const vector<double>& frag_im,
  2162	                    const vector<double>& frag_rt,
  2163	                    const vector<Trace>& ms1_traces, const FragGrid& fg,
  2164	                    double delta_im, double delta_rt, double min_corr, int min_corr_pts,
  2165	                    Size min_frags, Size max_frags, vector<float>& pdense, MSSpectrum& out) const
  2166	  {
  2167	    vector<pair<double, double>> frags;
  2168	    vector<double> frag_scores;
  2169	    scoreCandidates_(pc, frag_traces, frag_im, frag_rt, ms1_traces, fg, delta_im, delta_rt, min_corr,
  2170	                     min_corr_pts, pdense, [&](size_t fi, double c) {
  2171	      const auto [inten, emit_inten] = weighted_(frag_traces[fi].intensity, c, frag_im[fi] - pc.im);
  2172	      frags.emplace_back(exportMz_(frag_traces[fi].tof, frag_traces[fi].b, frag_traces[fi].mz), emit_inten);
  2173	      frag_scores.push_back(c * inten);
  2174	    });
  2175	    assembleFromList_(pc, win_lo, win_hi, frags, frag_scores, min_frags, max_frags, out);
  2176	  }
