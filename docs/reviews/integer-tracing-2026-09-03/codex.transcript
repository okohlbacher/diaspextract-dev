  1508	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1509	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1510	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1511	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1512	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1513	  {
  1514	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1515	    out.assign(n, 0.0);
  1516	    double term = 1.0;
  1517	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1518	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1519	    if (mx > 0) for (double& v : out) v /= mx;
  1520	  }
  1521	
  1522	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1523	  {
  1524	    double dot = 0, na = 0, nb = 0;
  1525	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1526	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1527	  }
  1528	
  1529	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1530	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1531	  /// coincidental peak at the right m/z spacing usually does not.
  1532	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1533	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1534	  static double xicCorr(const Trace& a, const Trace& b, double /*rt_tol*/)
  1535	  {
  1536	    size_t i = 0, j = 0; double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1537	    while (i < a.np() && j < b.np())
  1538	    {
  1539	      if (a.xi[i] == b.xi[j])
  1540	      { const double x = a.intAt(i), y = b.intAt(j);
  1541	        sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; ++i; ++j; }
  1542	      else if (a.xi[i] < b.xi[j]) ++i; else ++j;
  1543	    }
  1544	    if (m < 3) return -2.0;
  1545	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1546	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1547	  }
  1548	
  1549	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1550	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1551	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, int max_charge,
  1552	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1553	                                      bool envelope_scoring, double ambig_margin)
  1554	  {
  1555	    const double ISO = 1.0033548;
  1556	    const double PROTON_ = 1.00727646;
  1557	    const size_t N = ms1.size();
  1558	
  1559	    // m/z-sorted index for O(log N) isotope-partner lookup (avoids O(N^2) over all MS1 traces). [H-8]
  1560	    vector<size_t> by_mz(N);
  2140	    out.setMetaValue("spx_n_isotopes", pc.n_isotopes);
  2141	  }
  2142	
  2143	  /// [E5, 2026-09-02] The ONE place the emitted-intensity weights live. Returns {cap-key intensity,
  2144	  /// emitted intensity}: the IM-proximity weight feeds both (IM-on-c, orthogonal to correlation); the
  2145	  /// [Q2] correlation-power weight feeds ONLY the emitted (engine-visible) intensity -- putting it in the
  2146	  /// cap key made frag_scores = base*c^(k+1) and double-hit borderline-c faint fragments at the 500-cap.
  2147	  /// Until today apportion and rp_max emitted RAW intensities, so every A/B of those flags silently
  2148	  /// compared corr_power=2 against corr_power=0.
  2149	  pair<double, double> weighted_(double base, double c, double dim) const
  2150	  {
  2151	    double inten = base;
  2152	    if (im_weight_sigma_ > 0.0) inten *= std::exp(-(dim * dim) / (2.0 * im_weight_sigma_ * im_weight_sigma_));
  2153	    double emit_inten = inten;
  2154	    if (corr_power_ > 0.0 && c > 0.0) emit_inten *= std::pow(c, corr_power_);
  2155	    return {inten, emit_inten};
  2156	  }
