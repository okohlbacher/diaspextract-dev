   820	      // The extraction never needed a calibrated m/z; it is applied HERE, once per trace, with
   821	      // the apex frame's own temperature factor -- which is also the most accurate place for it.
   822	      // Carry the BIN, not just a number derived from it: the calibration is re-applied at
   823	      // export so the written m/z can never be a value that drifted through the intermediate
   824	      // gates. `mz` here is the cached form those gates still use.
   825	      t.tof = (mz_est == "apex") ? L.apex_tof : (TofIdx)llround(L.mz_sum / L.int_sum);
   826	      t.b = L.apex_b;
   827	      t.mz = ax.mzOf(t.tof, t.b);
   828	      t.rt = rtAxis()[L.apex_frame];
   829	      t.im = IM_LO + (L.im_sum / L.int_sum) / IM_Q;
   830	      t.intensity = L.apex_int;
   831	      t.xi = std::move(L.xi); t.xv = std::move(L.xv);
   832	      out.push_back(std::move(t));
   833	    }
   834	    return out;
   835	  }
   836	
   837	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   838	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   839	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   840	  {
   841	    PeakMap m;
   842	    m.reserve(frames.size());
   843	    for (auto& f : frames)
   844	    {
   845	      MSSpectrum s;
   846	      s.setRT(f.rt);
   847	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   848	      s.reserve(f.mzq.size());
   849	      OpenMS::DataArrays::FloatDataArray ima;
   850	      ima.setName(Constants::UserParam::ION_MOBILITY);
   851	      ima.reserve(f.mzq.size());
   852	      for (size_t i = 0; i < f.mzq.size(); ++i)
   853	      {
   854	        Peak1D p;
   855	        p.setMZ((double)f.mzq[i] / MZ_Q);
   856	        p.setIntensity(f.inten[i]);
   857	        s.push_back(p);
   858	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   859	      }
   860	      s.getFloatDataArrays().push_back(std::move(ima));
   861	      m.addSpectrum(std::move(s));
   862	      // release this frame's compact storage immediately
   863	      vector<uint32_t>().swap(f.mzq);
   864	      vector<float>().swap(f.inten);
   865	      vector<uint16_t>().swap(f.imq);
   866	    }
   867	    vector<CompactFrame>().swap(frames);
   868	    return m;
   869	  }
   870	
   871	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
   872	  ///
   873	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
   874	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
   875	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
   876	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
   877	  ///
   878	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
   879	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
   880	  /// ordering is the reader's business and need not match ours.
1321:  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
2412:    ms1_traces = detectTraces_(ms1_map, delta_im, getDoubleOption_("trace:noise_threshold_int"),
2963:          frag_traces = detectTraces_(wmap, delta_im, ms2_noise, ms2_snr, ms2_minlen, ms2_msr, max_trace_len, ms2_split, &ms2_span, w_bands);
  1340	
  1341	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
  1342	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
  1343	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
  1344	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
  1345	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
  1346	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
  1347	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
  1348	      ElutionPeakDetection epd;
  1349	      epd.setLogType(ProgressLogger::NONE);
  1350	      Param ep = epd.getParameters();
  1351	      ep.setValue("chrom_fwhm", split_valleys);
  1352	      ep.setValue("width_filtering", "off");
  1353	      ep.setValue("masstrace_snr_filtering", "false");
  1354	      epd.setParameters(ep);
  1355	      vector<MassTrace> out; out.reserve(in.size());
  1356	      epd.detectPeaks(in, out);
  1357	      return out;
  1358	    };
  1359	
  1360	    vector<MassTrace> mts;
  1361	    if (bands > 1)
  1362	    {
  1363	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
  1364	      // windows caps us at 24 threads however many cores exist. Fragment traces at
  1365	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
  1366	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
  1367	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
  1368	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
  1369	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
  1370	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
  1371	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
  1372	      vector<double> sample;
  1373	      for (const auto& s : map)
  1374	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
  1375	      sort(sample.begin(), sample.end());
  1376	      vector<double> edge(bands + 1);
  1377	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
  1378	      else
  1379	        for (int b = 0; b <= bands; ++b)
  1380	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
  1381	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
  1382	      vector<double> ().swap(sample);
  1383	
  1384	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
  1385	      // then release the source map so the halo duplicates are the only overhead.
  1386	      vector<PeakMap> sub(bands);
  1387	      for (auto& s : map)          // non-const: each spectrum is released once distributed
  1388	      {
  1389	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
  1390	        for (int b = 0; b < bands; ++b)
  1391	        {
  1392	          // Size each halo from ITS OWN edge: one h derived from edge[b] under-sizes the upper
  1393	          // side by the ppm growth across the band. [adv-review 2026-09-03]
  1394	          const double lo = edge[b] - edge[b] * ppm * 1e-6 * 20.0;
  1395	          const double hi = edge[b + 1] + edge[b + 1] * ppm * 1e-6 * 20.0;
  1396	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
  1397	          OpenMS::DataArrays::FloatDataArray ia;
  1398	          ia.setName(Constants::UserParam::ION_MOBILITY);
  1399	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
  1400	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
  1401	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
  1402	          Size i0 = 0, i1 = s.size();
  1403	          if (s.isSorted())
  1404	          {
  1405	            i0 = (Size)(s.MZBegin(lo) - s.begin());
  1406	            i1 = (Size)(s.MZBegin(hi) - s.begin());
  1407	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
  1408	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1409	          }
  1410	          else
  1411	            for (Size i = 0; i < s.size(); ++i)
  1412	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
  1413	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1414	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); sub[b].addSpectrum(std::move(t)); }
  1415	        }
  1416	        s.clear(true);   // distributed: release it now, so the source and the copies do not both
  1417	      }                  // stand at full size (the transient was ~2x the map)
  1418	      map.clear(true);
  1419	      vector<vector<MassTrace>> per(bands);
  1420	      #pragma omp taskloop grainsize(1) default(shared)
  1421	      for (int b = 0; b < bands; ++b)
  1422	      {
  1423	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
  1424	        vector<MassTrace> t;
  1425	        sub[b].sortSpectra();
  1426	        if (sub[b].size() < 3) { sub[b].clear(true); continue; }   // MTD aborts below 3 spectra
  1427	        m2.run(sub[b], t);
  1428	        sub[b].clear(true);
  1429	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
  1430	        for (auto& mt : t)
  1431	        {
  1432	          const double c = mt.getCentroidMZ();
  1433	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
  1434	        }
  1435	      }
  1436	      size_t tot = 0; for (const auto& v : per) tot += v.size();
  1437	      mts.reserve(tot);
  1438	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
  1439	    }
  1440	    else
  1441	    {
  1442	      if (map.size() >= 3) mtd.run(map, mts);   // MTD aborts below 3 spectra; a tiny input is not an error
  1443	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
  1444	    }
  1445	
  1446	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
  1447	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1448	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1449	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1450	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1451	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1452	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1453	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off S30 20:46 vs 28:40 for
  1454	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1455	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1456	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1457	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1458	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1459	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1460	    // determinism bug, now fixed.
  1461	    if (split_valleys > 0.0 && mts.size() > 1)
  1462	    {
  1463	      const int nthreads = std::max(1, bands);
  1464	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1465	      const size_t n_in = mts.size();
  1466	      vector<vector<MassTrace>> parts(nchunk);
  1467	      #pragma omp taskloop grainsize(1) default(shared)
  1468	      for (int ci = 0; ci < nchunk; ++ci)
  1469	      {
  1470	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1471	        if (lo >= hi) continue;
  1472	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1473	                                std::make_move_iterator(mts.begin() + hi));
  1474	        parts[ci] = do_split(chunk);
  1475	      }
  1476	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1477	      vector<MassTrace> out; out.reserve(tot);
  1478	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1479	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1480	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1481	      mts.swap(out);
  1482	    }
  1483	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1484	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1485	    if (!mts.empty())
  1486	    {
  1487	      vector<double> spans;
  1488	      spans.reserve(mts.size());
  1489	      for (const auto& mt : mts)
  1490	      {
  1491	        double lo = 1e30, hi = -1e30;
  1492	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1493	        spans.push_back(hi - lo);
  1494	      }
  1495	      sort(spans.begin(), spans.end());
  1496	      size_t n = spans.size();
  1497	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1498	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1499	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1500	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1501	    }
  1502	    vector<Trace> out;
  1503	    out.reserve(mts.size());
  1504	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1505	    return out;
  1506	  }
