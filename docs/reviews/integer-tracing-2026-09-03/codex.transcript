   903	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
   904	  ///
   905	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
   906	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
   907	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
   908	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
   909	  ///
   910	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
   911	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
   912	  /// ordering is the reader's business and need not match ours.
   913	  class PickCompactConsumer : public FullSwathFileConsumer
   914	  {
   915	  public:
   916	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
   917	                        PeakMap& ms1, CompactStats& stats,
   918	                        std::function<pair<int, int>(double, double)> keyfn)
   919	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
   920	
   921	    size_t frames_seen = 0;
   922	
   923	    /// [perf-load] Pick+compact a BATCH of buffered frames in parallel, then append in arrival
   924	    /// order. OpenMS hands frames over a strictly serial `for (fid..) consumeSpectrum(spec)` loop,
   925	    /// so before this the peak picking of 1.26e9 peaks ran on ONE thread and was 53% of total wall
   926	    /// (measured: 1046 s wall, parallel factor 1.0). Buffering here parallelises it without
   927	    /// touching the reader. Appending strictly by buffer index keeps the output order identical to
   928	    /// the serial path; the emitted spectra matched it in m/z and differed in ~2% of intensities at
   929	    /// the 1e-5..1e-4 relative level (Sage count unchanged) -- see docs/RUNTIME-PLAN [pick-det].
   930	    void flush_()
   931	    {
   932	      const int n = (int)buf_.size();
   933	      if (n == 0) return;
   934	      const double _tf0 = phase_clock_();
   935	      std::vector<CompactFrame> compacted((size_t)n);
   936	      std::vector<CompactStats> st((size_t)n);          // per-frame stats, merged serially below
   937	      PeakPickerIM picker = picker_;                    // Param is a deep-copy value type
   938	      // SPEXTRACT_PICK_SERIAL=1 runs this loop on one thread: the A/B that separates picker
   939	      // scheduling-sensitivity from downstream chaos (kimi, plan review). [pick-det]
   940	      static const bool par_pick = std::getenv("SPEXTRACT_PICK_SERIAL") == nullptr;
   941	      static const bool sched_set = []{ const bool st = std::getenv("SPEXTRACT_PICK_STATIC") != nullptr; omp_set_schedule(st ? omp_sched_static : omp_sched_dynamic, st ? 0 : 1); return true; }(); (void)sched_set;
   942	      std::exception_ptr pick_err;                      // an exception escaping an OMP region aborts
   943	      // chunk 1: with chunk 8 a 64-frame batch made only 8 chunks = 8 workers (codex, plan review)
   944	      #pragma omp parallel for firstprivate(picker) schedule(runtime) if(par_pick)   // SPEXTRACT_PICK_STATIC=1 -> static (history-vs-race probe)
   945	      for (int i = 0; i < n; ++i)
   946	      {
   947	        try
   948	        {
   949	          auto& s = buf_[(size_t)i];
   950	          ensureIMArrayName(s);
   951	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   952	          ensureIMArrayName(s);
   953	          compacted[(size_t)i] = compactify(s, st[(size_t)i]);
   954	          s.clear(true);                                // raw frame dies here, inside the loop
   955	        }
   956	        catch (...)
   957	        {
   958	          #pragma omp critical(pick_err)
   959	          if (!pick_err) pick_err = std::current_exception();
   960	        }
   961	      }
   962	      if (pick_err) std::rethrow_exception(pick_err);
   963	      for (int i = 0; i < n; ++i)
   964	      {
   965	        stats_ += st[(size_t)i];
   966	        windows_[key_[(size_t)i]].push_back(std::move(compacted[(size_t)i]));
   967	      }
   968	      flush_wall_() += phase_clock_() - _tf0;
   969	      buf_.clear(); key_.clear();
   970	    }
   971	
   972	  protected:
   973	    void consumeMS1Spectrum_(MapType::SpectrumType& s) override
   974	    {
   975	      // MS1 stays a PeakMap (MassTraceDetection needs it whole), but its pick is NOT small: 1,343
   976	      // frames x ~690k raw peaks = 37% of all peaks, and it used to run serially here (~400 s of
   977	      // LOAD, measured 2026-09-02). Buffer and pick in parallel like MS2; order is kept by index.
   978	      ms1_buf_.push_back(std::move(s));
   979	      ++frames_seen;
   980	      if (ms1_buf_.size() >= kBatch) flushMS1_();
   981	    }
   982	
   983	    void flushMS1_()
   984	    {
   985	      const int n = (int)ms1_buf_.size();
   986	      if (n == 0) return;
   987	      const double _tf0 = phase_clock_();
   988	      PeakPickerIM picker = picker_;
   989	      std::exception_ptr pick_err;
   990	      #pragma omp parallel for firstprivate(picker) schedule(dynamic, 1)
   991	      for (int i = 0; i < n; ++i)
   992	      {
   993	        try
   994	        {
   995	          auto& s = ms1_buf_[(size_t)i];
   996	          ensureIMArrayName(s);
   997	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   998	          ensureIMArrayName(s);
   999	        }
  1000	        catch (...)
  1001	        {
  1002	          #pragma omp critical(pick_err_ms1)
  1003	          if (!pick_err) pick_err = std::current_exception();
  1004	        }
  1005	      }
  1006	      if (pick_err) std::rethrow_exception(pick_err);
  1007	      for (auto& s : ms1_buf_) ms1_.addSpectrum(std::move(s));
  1008	      ms1_buf_.clear();
  1009	      flush_wall_() += phase_clock_() - _tf0;
  1010	    }
