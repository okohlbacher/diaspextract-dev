  1558	  // =====================================================================
  1559	  // transform() overloads
  1560	  // =====================================================================
  1561	  void BrukerTimsFile::transform(const String& path, Interfaces::IMSDataConsumer* consumer)
  1562	  {
  1563	    transform(path, consumer, Config());
  1564	  }
  1565	
  1566	  void BrukerTimsFile::transform(const String& path, Interfaces::IMSDataConsumer* consumer, const Config& config)
  1567	  {
  1568	    auto handle = openTimsDataHandle(path, config);
  1569	
  1570	    String tdf_path = path + "/analysis.tdf";
  1571	    SQLite::Database db(std::string(tdf_path), SQLite::OPEN_READONLY);
  1572	
  1573	    bool is_dia = isDIA(db);
  1574	    Config::ExportMode mode = config.export_mode;
  1575	
  1576	    // Compute expected size for consumer. Must mirror what loadFrames_/loadDIA_/
  1577	    // loadDDA_ actually emit, which skip MS1 entirely when load_ms1=false.
  1578	    FrameCounts counts = readFrameCounts(db);
  1579	    const size_t ms1_emitted = config.load_ms1 ? counts.ms1 : 0;
  1580	    size_t expected = 0;
  1581	    if (mode == Config::FRAME)
  1582	    {
  1583	      expected = ms1_emitted + counts.ms2;
  1584	    }
  1585	    else if (is_dia && mode != Config::SPECTRUM)
  1586	    {
  1587	      // DIA: each MS2 frame belongs to exactly ONE WindowGroup and only
  1588	      // produces spectra for that group's windows. So the emit count is
  1589	      //   Σ_group (frames_in_group × windows_in_group)
  1590	      // — NOT frames × all_windows. Mirrors the total_work computation in
  1591	      // loadDIA_.
  1592	      auto windows = readDIAWindows(db, *handle->scan2inv_ion_mobility_converter);
  1593	      auto group_to_frames = readFrameToWindowGroupMapping(db, windows);
  1594	      std::map<int, size_t> group_window_count;
  1595	      for (const auto& w : windows) ++group_window_count[w.window_group];
  1596	      size_t dia_ms2_spectra = 0;
  1597	      for (const auto& [group, frames] : group_to_frames)
  1598	      {
  1599	        auto wit = group_window_count.find(group);
  1600	        if (wit != group_window_count.end())
  1601	          dia_ms2_spectra += frames.size() * wit->second;
  1602	      }
  1603	      expected = ms1_emitted + dia_ms2_spectra;
  1604	    }
  1605	    else
  1606	    {
  1607	      // DDA: MS1 frames + per-precursor MS2 spectra
  1608	      uint32_t num_precursors = countDDAPrecursors(db);
  1609	      expected = ms1_emitted + num_precursors;
  1610	    }
  1611	
  1612	    consumer->setExpectedSize(expected, 0);
  1613	
  1614	    // Populate source file metadata (same as load())
  1615	    ExperimentalSettings settings;
  1616	    loadExperimentalSettings_(path, settings);
  1617	    consumer->setExperimentalSettings(settings);
  1618	
  1619	    // NOTE: This loads into a temporary experiment then feeds to consumer.
  1620	    // Not truly constant-memory -- a future optimization should iterate
  1621	    // frame-by-frame and call consumer->consumeSpectrum() inline.
  1622	    OPENMS_LOG_INFO << "BrukerTimsFile::transform(): loading full dataset (streaming optimization pending)" << std::endl;
  1623	    MSExperiment exp;
  1624	    if (mode == Config::FRAME)
  1625	      loadFrames_(*handle, exp, config);
  1626	    else if (is_dia && mode != Config::SPECTRUM)
  1627	      loadDIA_(*handle, exp, config);
  1628	    else
  1629	      loadDDA_(*handle, exp, config);
  1630	
  1631	    exp.sortSpectra(true);
  1632	    for (auto& spec : exp)
  1633	    {
  1634	      consumer->consumeSpectrum(spec);
  1635	    }
  1636	  }
  1637	
  1638	  // =====================================================================
  1639	  // loadDDA_: MS1 frames (IM_PEAK) + MS2 spectra (scalar IM)
  1640	  // =====================================================================
  1641	  void BrukerTimsFile::loadDDA_(TimsDataHandle& handle, MSExperiment& exp, const Config& config)
  1642	  {
  1643	    String tdf_path = handle.get_tims_dir_path() + "/analysis.tdf";
  1644	    SQLite::Database db(std::string(tdf_path), SQLite::OPEN_READONLY);
  1645	
  1646	    // Collect frame IDs by MS level
  1647	    std::vector<uint32_t> ms1_frame_ids;
  1648	    std::vector<uint32_t> ms2_frame_ids;
  1649	
  1650	    for (uint32_t fid = handle.min_frame_id(); fid <= handle.max_frame_id(); ++fid)
  1651	    {
  1652	      if (!handle.has_frame(fid)) continue;
  1653	      TimsFrame& frame = handle.get_frame(fid);
  1654	      if (frame.msms_type == 0)
  1655	        ms1_frame_ids.push_back(fid);
  1656	      else
  1657	        ms2_frame_ids.push_back(fid);
  1658	    }
  1659	    warnPartialMS1AggregationConfig(config, ms1_frame_ids.size());
  1660	
  1661	    // Read DDA precursors from SQL
  1662	    std::vector<DDAPrecursorInfo> precursor_entries = readDDAPrecursors(db);
  1663	
  1664	    // Group by precursor ID
  1665	    std::map<int, std::vector<const DDAPrecursorInfo*>> precursor_groups;

