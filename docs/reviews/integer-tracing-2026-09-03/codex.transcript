  1011	        OPENMS_LOG_WARN << "Warning: Ion mobility data is in CCS units (square angstroms), but im_tolerance_cluster"
  1012	                        << " = " << im_tolerance_cluster_ << " appears to be set for 1/K0 data. "
  1013	                        << "For CCS data, consider using larger values (e.g., 10-20 for clustering, 1.0 for summing)." << '\n';
  1014	        ccs_warning_shown_ = true;
  1015	      }
  1016	
  1017	      struct Point {
  1018	        double mz;
  1019	        double im;
  1020	        float intensity;
  1021	        OpenMS::Size original_index;
  1022	
  1023	        Point(double mz_val, double im_val, float int_val, OpenMS::Size idx) :
  1024	            mz(mz_val), im(im_val), intensity(int_val), original_index(idx) {}
  1025	      };
  1026	
  1027	      // Convert peaks to Points (same as before)
  1028	      std::vector<Point> points;
