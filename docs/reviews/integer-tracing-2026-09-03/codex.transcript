docs/reviews/banding-halo-2026-09-03/codex.transcript:1174:   871	    registerDoubleOption_("trace:ms2_split_valleys", "<chrom_fwhm>", 7.0, "[way-2] Split MS2 mass traces at chromatographic local minima via ElutionPeakDetection (which MassTraceDetection never does - it only terminates on outliers, so two peptides 25 s apart within the m/z tolerance MERGE). Value is chrom_fwhm in seconds; it sets both the Savitzky-Golay window and the local-extrema half-window. 0 = OFF. Try 6-8 (peaks here are 5-30 s). width_filtering is forced off so this only SPLITS, never deletes.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1176:   873	    registerDoubleOption_("trace:wavelet_smooth", "<x>", 0.0, "[wavelet] Smooth the PRECURSOR XIC with a stationary (a-trous) B3-spline wavelet before correlating fragments against it, at a scale of x TIMES THE MEASURED MS1 FWHM. diaTracer smooths its precursor profile (2D Gaussian + Savitzky-Golay) and then applies a 0.3 correlation threshold; we copied the 0.3 but not the smoothing. Pearson r between two NOISY profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker constraint than a smoothed 0.3 -- and worst at faint precursors, which is where the coverage analysis says peptides are lost. Fragment XICs stay RAW (as in diaTracer) and emitted peak intensities are unaffected. 0 = off. Try 0.25-0.5 (measured MS1 FWHM is 3.61 s on S30, so 0.5 ~ 1.8 s ~ 1.3 cycles).", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1177:   874	    registerDoubleOption_("trace:split_valleys_fwhm", "<x>", 0.0, "[fwhm] Set the valley-splitting window as a MULTIPLE OF THE MEASURED MS1 FWHM instead of absolute seconds. Overrides trace:ms2_split_valleys when > 0 (the MS2 window is the one it sets). Absolute seconds cannot be right across methods: 14.0 s is +0.0% peptides on a 31 min gradient and -1.06% on a 5.6 min one. Measured MS1 FWHM is 3.61 s on S30, so the old 7.0 s default is ~1.9x FWHM and 14.0 s is ~3.9x. 0 = off (use absolute seconds).", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1178:   875	    registerDoubleOption_("trace:ms1_split_valleys", "<chrom_fwhm>", 7.0, "Split MS1 mass traces at chromatographic valleys via ElutionPeakDetection. DEFAULT 7.0 s: MassTraceDetection never splits at a local minimum, so two peptides eluting ~25 s apart within the m/z tolerance merge into ONE multi-modal trace, producing a merged precursor with the wrong monoisotope and charge. Measured +36.7% peptides on S23 and +37.4% on S08 at peptide-level FDR. Costs ~1.7x wall time and ~25% peak RAM. 0 = off.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1179:   876	    registerDoubleOption_("trace:max_trace_length_sec", "<sec>", -1.0, "DANGER - NOT a guard. MassTraceDetection::isTraceValid_ RETURNS FALSE on over-length traces and peaks are marked visited only for VALID traces, so an over-length blob is rejected, re-seeded by the next apex, and rejected again - emitting NOTHING at that m/z. Setting this DELETES signal (the falsified direction). Kept only for diagnostics; leave at -1. Splitting requires ElutionPeakDetection, not this. [merged-trace]", false, true);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1180:   877	registerIntOption_("trace:frame_aggregation_ms1_n", "<n>", 1, "[cross-frame] Same as frame_aggregation_n but for the MS1 (PRECURSOR) map. This is the one that can add DEPTH: measurement shows we identify MORE spectra than diaTracer (3.7%% vs 2.0%% of spectra) but cover FEWER distinct peptides (4.6 vs 1.46 PSMs/peptide), i.e. we miss low-abundance PRECURSORS. Aggregating MS2 alone cannot fix that. 1 = off.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1181:   878	    registerIntOption_("trace:frame_aggregation_n", "<n>", 1, "[cross-frame] Number of ADJACENT RT frames (= adjacent diaPASEF CYCLES, since each isolation window is sampled once per cycle) summed into a composite (m/z x 1/K0) frame BEFORE MS2 peak/trace detection, diaTracer-style. 1 = off (current behaviour). 5 = user request. Sliding window, stride 1, so the RT axis and point count are preserved; note adjacent output points then share input frames and are AUTOCORRELATED, which inflates Pearson r - benchmark, do not assume.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1182:   879	    registerDoubleOption_("trace:ms2_min_sample_rate", "<r>", -1.0, "MS2 min fraction of visited scans that must contain a peak (MassTraceDetection min_sample_rate). OpenMS default 0.5 hard-deletes gappy fragment traces; MEASURED: 0.3 and 0.1 both LOSE peptides (8,865 -> 8,735 at 0.3), so -1 (= OpenMS 0.5) is the default. Lowering it produces longer, more-merged traces with wrong apexes.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1183:   880	    registerDoubleOption_("trace:ms1_min_sample_rate", "<r>", -1.0, "MS1 min_sample_rate. -1 = OpenMS default 0.5 (strict, MS1 stays strict).", false, true);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1191:   888	    registerDoubleOption_("merge:rt_window", "<sec>", 0.0, "FALSIFIED on S30 (every merge/collapse variant lost peptides) -- keep 0 = OFF. [merge] Merge spectra sharing a precursor identity within this RT window into ONE spectrum by UNION of peaks; matching peaks take the MAX intensity by default (merge:sum_intensity sums instead). This is not consolidate: consolidate SELECTS the richest member and DISCARDS the rest (measured -12.7% peptides), while 41% of peaks are present in only one member. Measured MS1 FWHM is 3.61 s (2.61 cycles) and flat across the gradient, so ~3.6 s is one peak width -- the principled window. 0 = off.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1193:   890	    registerDoubleOption_("merge:delta_im", "<1/K0>", 0.02, "[merge] Precursor ion-mobility tolerance.", false, true);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1198:   895	    registerDoubleOption_("consolidate:delta_rt", "<sec>", 0.0, "FALSIFIED on S30 (-12.7% peptides at 5 s; every merge/collapse variant lost) -- keep 0 = OFF. Consolidate spectra whose precursors agree within this RT window (and mass_ppm/delta_im) into ONE feature, keeping the richest spectrum. Attacks emission multiplicity (ours 4.6 PSMs/peptide vs diaTracer 1.46) without changing fragment content.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1204:   901	    registerIntOption_("trace:native_ms2_neighbors", "<n>", 0, "[stream] NATIVE cross-frame aggregation in the READER (BrukerTimsFile Config dia_ms2_n_neighbors): adjacent frames each side, 0=off, 1=3-frame sum, 2=5-frame sum. This sums RAW frames BEFORE centroiding, which is what diaTracer does; the tool-level frame_aggregation_n sums AFTER centroiding and lost 26% of peptides. Requires perf:stream_load.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1205:   902	    registerIntOption_("trace:native_ms1_neighbors", "<n>", 0, "[stream] Same, for MS1 frames (BrukerTimsFile Config ms1_n_neighbors). Requires perf:stream_load.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1211:   908	    registerIntOption_("perf:ms1_trace_bands", "<n>", 12, "[parallel] Band-parallel MS1 mass-trace detection, same exact-partition scheme as perf:trace_bands. MS1 tracing was running SINGLE-THREADED (the call simply never passed a band count) while MS2 was banded, so the MS1 phase pinned one core. That is invisible at default thresholds because MS1 is only ~4% of frames, but it makes the MS1 SENSITIVITY sweep impossible: lowering trace:noise_threshold_int / ms1_chrom_peak_snr explodes MassTraceDetection's intensity-sorted apex list, and MassTraceDetection is a SERIAL greedy loop, so runtime blows up superlinearly on one core (measured: 40 min with no progress at 1.5 of 128 cores, vs 24 min for a whole default run). 1 = off (old behaviour).", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1212:   909	    registerIntOption_("perf:trace_bands", "<n>", 12, "[parallel] Split each window's fragment m/z range into N bands traced CONCURRENTLY. The diaPASEF method fixes the window count (24 here), which caps window-level parallelism far below the core count; banding lifts the ceiling to threads. Traces cannot span more than trace:mass_error_ppm in m/z, so banding with a halo is exact. 0 = auto (windows x bands >= threads), 1 = off.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1213:   910	    registerDoubleOption_("perf:mem_fraction", "<f>", 0.75, "[dyn-mem] Fraction of currently-FREE RAM (/proc/meminfo MemAvailable + our own RSS) the window loop may commit. Concurrency is re-decided at every window admission, so the run adapts to other jobs on a shared node. One window is always admitted regardless, so a single oversized window cannot deadlock.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1214:   911	    registerIntOption_("perf:max_concurrent_windows", "<n>", 0, "UPPER bound on isolation windows processed concurrently (memory admission may run fewer). Peak RAM scales with windows IN FLIGHT (each holds its frames + traces + grid), not with the total window count, so lowering this trades wall time for RAM. 0 = unlimited (use all threads).", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1242:   939	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). A reviewer argued 0.01 (isotopes of one species share mobility, so 0.05 can admit cross-species partners), but 0.01 has NOT been measured on S30; change only behind the S30 set gate.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1258:   955	    setMinFloat_("trace:ms1_chrom_peak_snr", 0.0);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1259:   956	    setMinFloat_("trace:ms2_chrom_peak_snr", 0.0);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1260:   957	    setMinFloat_("trace:ms2_noise_threshold_int", 0.0);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1261:   958	    setMinFloat_("trace:noise_threshold_int", 0.0);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1268:   965	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
docs/reviews/banding-halo-2026-09-03/codex.transcript:1269:   966	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
docs/reviews/banding-halo-2026-09-03/codex.transcript:1270:   967	  ///   peak_int > chrom_peak_snr * noise_threshold_int
docs/reviews/banding-halo-2026-09-03/codex.transcript:1275:   972	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
docs/reviews/banding-halo-2026-09-03/codex.transcript:1277:   974	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
docs/reviews/banding-halo-2026-09-03/codex.transcript:1278:   975	  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
docs/reviews/banding-halo-2026-09-03/codex.transcript:1279:   976	                              double snr, double min_len, double min_sample_rate, double max_len,
docs/reviews/banding-halo-2026-09-03/codex.transcript:1282:   979	    MassTraceDetection mtd;
docs/reviews/banding-halo-2026-09-03/codex.transcript:1283:   980	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
docs/reviews/banding-halo-2026-09-03/codex.transcript:1285:   982	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
docs/reviews/banding-halo-2026-09-03/codex.transcript:1286:   983	    p.setValue("noise_threshold_int", noise);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1287:   984	    p.setValue("chrom_peak_snr", snr);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1288:   985	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
docs/reviews/banding-halo-2026-09-03/codex.transcript:1290:   987	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
docs/reviews/banding-halo-2026-09-03/codex.transcript:1294:   991	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1296:   993	    mtd.setParameters(p);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1300:   997	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
docs/reviews/banding-halo-2026-09-03/codex.transcript:1302:   999	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
docs/reviews/banding-halo-2026-09-03/codex.transcript:1311:  1008	      epd.setParameters(ep);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1313:  1010	      epd.detectPeaks(in, out);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1320:  1017	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
docs/reviews/banding-halo-2026-09-03/codex.transcript:1321:  1018	      // windows caps us at 24 threads however many cores exist. Fragment traces at
docs/reviews/banding-halo-2026-09-03/codex.transcript:1322:  1019	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
docs/reviews/banding-halo-2026-09-03/codex.transcript:1326:  1023	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
docs/reviews/banding-halo-2026-09-03/codex.transcript:1328:  1025	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
docs/reviews/banding-halo-2026-09-03/codex.transcript:1357:  1054	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
docs/reviews/banding-halo-2026-09-03/codex.transcript:1358:  1055	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
docs/reviews/banding-halo-2026-09-03/codex.transcript:1377:  1074	      #pragma omp taskloop grainsize(1) default(shared)
docs/reviews/banding-halo-2026-09-03/codex.transcript:1380:  1077	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1400:  1097	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
docs/reviews/banding-halo-2026-09-03/codex.transcript:1404:  1101	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
docs/reviews/banding-halo-2026-09-03/codex.transcript:1413:  1110	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
docs/reviews/banding-halo-2026-09-03/codex.transcript:1415:  1112	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
docs/reviews/banding-halo-2026-09-03/codex.transcript:1424:  1121	      #pragma omp taskloop grainsize(1) default(shared)
docs/reviews/banding-halo-2026-09-03/codex.transcript:1540:  1237	      // the m/z index, scan only the ppm-window candidates); -1 if none. [H-8]
docs/reviews/banding-halo-2026-09-03/codex.transcript:1810:   829	    registerInputFile_("in", "<file>", "", "Input diaPASEF data (ion-mobility DIA; 1/K0 / VSSC): mzML, mzPeak, or a Bruker .d directory.");
docs/reviews/banding-halo-2026-09-03/codex.transcript:1817:   836	    registerDoubleOption_("gate:delta_im", "<1/K0>", 0.01, "Max |precursor - fragment| ion mobility difference (1/K0). (diaTracer deltaApexIM default 0.01)", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1829:   848	    registerDoubleOption_("assembly:im_weight_sigma", "<1/K0>", 0.0, "[recall] Down-weight each emitted fragment's intensity by a Gaussian of its ion-mobility distance from the precursor, exp(-(dIM)^2 / 2 sigma^2). TIMS precedes fragmentation so a TRUE fragment shares the precursor's 1/K0 exactly; a co-isolating interferent at the edge of the gate:delta_im band is suppressed. WITHIN-spectrum (no fragment removed or redistributed across precursors) so it escapes the fan-out depletion that falsified competitive/apex/deconvolution, and directly un-buries faint true fragments under the engine's intensity top-150. 0 = off. Try ~0.005 (half the 0.01 IM gate). [bench]", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1835:   854	    registerTOPPSubsection_("trace", "Mass-trace detection (see MassTraceDetection)");
docs/reviews/banding-halo-2026-09-03/codex.transcript:1836:   855	    registerDoubleOption_("trace:mass_error_ppm", "<ppm>", 15.0, "m/z tolerance for trace detection.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1837:   856	    registerDoubleOption_("trace:noise_threshold_int", "<int>", 100.0, "MS1 (precursor) noise intensity threshold.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1838:   857	    registerDoubleOption_("trace:ms2_noise_threshold_int", "<int>", 10.0, "MS2 (fragment) noise threshold. Lower it (e.g. 50, 20) to recover weak fragments toward diaTracer-like density; the grid-Pearson optimization keeps that affordable.", false);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1839:   858	    registerDoubleOption_("trace:min_length_sec", "<sec>", 3.0, "Minimum MS1 mass-trace length (seconds).", false, true);
docs/reviews/banding-halo-2026-09-03/codex.transcript:1841:   860	    // apex gate is chrom_peak_snr*noise_threshold_int, so the stock snr=3.0 silently TRIPLES the
