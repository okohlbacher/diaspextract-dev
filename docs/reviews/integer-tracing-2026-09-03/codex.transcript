   628	
   629	  /// One window's peaks in INDEX SPACE, frame-major. This is what the compact store already holds;
   630	  /// the point is that it is never converted back to Peak1D doubles. Replaces the materialised
   631	  /// PeakMap for the integer detector. See docs/MZ-AXIS-DESIGN.md.
   632	  struct PeakSlab
   633	  {
   634	    vector<uint32_t> frame_off;    ///< size F+1: frame f owns [frame_off[f], frame_off[f+1])
   635	    vector<uint32_t> rt_index;     ///< size F: the frame's index on the GLOBAL RT axis
   636	    vector<TofIdx>   tof;          ///< flight-time bin, ascending within a frame
   637	    vector<double>   b;            ///< size F: the frame's calibration factor (bin -> m/z)
   638	    vector<float>    inten;
   639	    vector<uint16_t> imq;          ///< the store's quantised 1/K0, kept for export
   640	    vector<uint16_t> scan;         ///< TIMS scan index: the RANK of this peak's mobility in its
   641	                                   ///  frame. Within a frame the distinct 1/K0 values ARE the
   642	                                   ///  scans, so ranking recovers the index without the vendor
   643	                                   ///  TIMS table -- and comparing scans is what the gate wants,
   644	                                   ///  since the calibrated value drifts frame to frame.
   645	    vector<uint16_t> scan_tol;     ///< per frame: gate:delta_im expressed in scans for THAT frame
   646	    size_t frames() const { return rt_index.size(); }
   647	    size_t peaks()  const { return tof.size(); }
   648	  };
   649	
   650	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   651	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   652	  PeakSlab toSlab(vector<CompactFrame>& frames)
   653	  {
   654	    PeakSlab sl;
   655	    const size_t F = frames.size();
   656	    sl.frame_off.resize(F + 1, 0);
   657	    sl.rt_index.resize(F);
   658	    size_t total = 0;
   659	    for (const auto& f : frames) total += f.mzq.size();
   660	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   661	    sl.b.resize(F);
   662	    const TofAxis& ax = tofAxis();
   663	    for (size_t i = 0; i < F; ++i)
   664	    {
   665	      CompactFrame& f = frames[i];
   666	      sl.rt_index[i] = rtIndex(f.rt);
   667	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   668	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   669	      // introduced here, and the loader does not have to change.
   670	      const double b = ax.factor(f.frame_id);
   671	      sl.b[i] = b;
   672	      sl.frame_off[i] = (uint32_t)sl.tof.size();
   673	      for (size_t k = 0; k < f.mzq.size(); ++k)
   674	        sl.tof.push_back(ax.tofOf((double)f.mzq[k] / MZ_Q, b));
   675	      sl.inten.insert(sl.inten.end(), f.inten.begin(), f.inten.end());
   676	      sl.imq.insert(sl.imq.end(), f.imq.begin(), f.imq.end());
   677	      vector<uint32_t>().swap(f.mzq);
   678	      vector<float>().swap(f.inten);
   679	      vector<uint16_t>().swap(f.imq);
   680	    }
   681	    sl.frame_off[F] = (uint32_t)sl.tof.size();
   682	    return sl;
   683	  }
   684	
   685	  /// Rank each frame's mobility values into TIMS scan indices, and express the mobility tolerance
   686	  /// in scans for that frame. Not a constant across frames: the ramp is not uniform, and assuming
   687	  /// it were would repeat the fixed-halo mistake in the other dimension.
   688	  void indexScans(PeakSlab& sl, double im_tol)
   689	  {
   690	    const size_t F = sl.frames();
   691	    sl.scan.assign(sl.tof.size(), 0);
   692	    sl.scan_tol.assign(F, 1);
   693	    vector<uint16_t> vals;
   694	    for (size_t f = 0; f < F; ++f)
   695	    {
   696	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
   697	      if (b <= a) continue;
   698	      vals.assign(sl.imq.begin() + a, sl.imq.begin() + b);
   699	      sort(vals.begin(), vals.end());
   700	      vals.erase(unique(vals.begin(), vals.end()), vals.end());
   701	      for (uint32_t k = a; k < b; ++k)
   702	        sl.scan[k] = (uint16_t)(lower_bound(vals.begin(), vals.end(), sl.imq[k]) - vals.begin());
   703	      // how many ranks does the tolerance span here? measure it on this frame's own spacing
   704	      const double q = im_tol * IM_Q;                 // tolerance in quantised 1/K0 units
   705	      size_t worst = 1;
   706	      for (size_t i = 0; i < vals.size(); ++i)
   707	      {
   708	        const size_t hi = upper_bound(vals.begin(), vals.end(), (uint16_t)std::min<double>(65535.0, vals[i] + q)) - vals.begin();
   709	        worst = std::max(worst, hi - i);
   710	      }
   711	      sl.scan_tol[f] = (uint16_t)std::min<size_t>(65535, worst);
   712	    }
   713	  }
   714	
   715	  /// Mass-trace detection on the integer m/z axis.
   716	  ///
   717	  /// The OpenMS detector accepts a peak when it lies within `mass_error_ppm` of a trace's RUNNING
   718	  /// centroid, which needs a tolerance comparison against every live trace and makes the cost
   719	  /// superlinear in peaks per band -- measured on S30: 4 bands 18:25 wall / 163 GB against 12 bands
   720	  /// 12:53 / 103 GB, i.e. the same work costs more when the bands are bigger. On a uniform integer
   721	  /// axis the candidates for a peak are found by ARITHMETIC: a live trace can only accept indices
   722	  /// within `ppmSpan` of its centroid, so bucketing by `mz >> shift` with a bucket wider than the
   723	  /// largest span puts every candidate in the peak's own bucket or its two neighbours.
   724	  ///
   725	  /// This is a DIFFERENT ALGORITHM, not a reimplementation: it will not reproduce the OpenMS
   726	  /// detector peak for peak. It is therefore gated behind `trace:detector=integer` (default
   727	  /// `openms`) and must be judged on identified peptides with both search engines, never on a
   728	  /// spectrum digest.
   729	  ///
   730	  /// Mobility is part of the identity, as in the IM-aware OpenMS path: a candidate must also be
   731	  /// within `im_tol` of the trace's mobility. Valley splitting is NOT done here -- the existing
   732	  /// ElutionPeakDetection step runs afterwards on the traces this produces.
   733	  /// Mass-trace detection on integer arrays: a FAITHFUL reimplementation of the algorithm OpenMS
   734	  /// `MassTraceDetection` runs -- intensity-ordered seeding, bidirectional extension against a
   735	  /// running centroid, `min_sample_rate` termination -- with every axis an integer and no
   736	  /// `PeakMap`, `MSSpectrum` or `Peak1D` anywhere. The science is meant to be the same; only the
   737	  /// data structures change. Valley splitting is NOT reimplemented: ElutionPeakDetection still runs
   738	  /// afterwards on what this returns.
   739	  ///
   740	  /// `band_lo`/`band_hi` restrict it to a slice of the FLIGHT-TIME range. A trace's centroid cannot
   741	  /// leave `seed +- span`, so a halo of `2*span` cannot cut one and the partition is exact by
   742	  /// construction -- which the OpenMS path's m/z halo can only approximate, since its traces drift
   743	  /// without bound. A trace belongs to the band whose core holds its seed, so there are no
   744	  /// duplicates. See docs/INTEGER-TRACING-DESIGN.md.
   745	  vector<Trace> detectTracesInteger_(PeakSlab& sl, double mass_ppm, double im_tol,
   746	                                     double noise, double snr, double min_len_sec,
   747	                                     double min_sample_rate, double max_len_sec,
   748	                                     const std::string& mz_est,
   749	                                     TofIdx band_lo = 0, TofIdx band_hi = 0)
   750	  {
   751	    vector<Trace> out;
   752	    const size_t F = sl.frames(), P = sl.tof.size();
   753	    if (F == 0 || P == 0) return out;
   754	    const bool banded = band_hi > band_lo;
   755	    const TofAxis& ax = tofAxis();
   756	
   757	    // frame of each peak, so a seed knows where it starts
   758	    vector<uint32_t> frame_of(P, 0);
   759	    for (size_t f = 0; f < F; ++f)
   760	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k) frame_of[k] = (uint32_t)f;
   761	
   762	    // Seeding order: intensity descending, as OpenMS does. Ties broken on (tof, index) so the run
   763	    // is reproducible -- an unstable order here would make the output depend on the sort.
   764	    vector<uint32_t> order;
   765	    order.reserve(P);
   766	    for (uint32_t k = 0; k < P; ++k)
   767	      if (sl.inten[k] > (float)noise &&
   768	          (!banded || (sl.tof[k] >= band_lo && sl.tof[k] < band_hi)))
   769	        order.push_back(k);
   770	    sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) {
   771	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   772	      if (sl.tof[a] != sl.tof[b]) return sl.tof[a] < sl.tof[b];
   773	      return a < b;
   774	    });
   775	
   776	    vector<char> used(P, 0);
   777	    const double min_apex = snr * noise;
   778	    vector<uint32_t> xi; vector<float> xv;
   779	
   780	    /// Closest unused peak of frame `f` within `span` bins of `centroid` and `stol` scans of
   781	    /// `scan0`. One binary search plus a short walk over the tolerance window.
   782	    auto pick = [&](size_t f, TofIdx centroid, TofIdx span, uint16_t scan0, uint16_t stol) -> long {
   783	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
   784	      if (b <= a) return -1;
   785	      const TofIdx lo = centroid > span ? centroid - span : 0;
   786	      const uint32_t s0 = (uint32_t)(lower_bound(sl.tof.begin() + a, sl.tof.begin() + b, lo) - sl.tof.begin());
   787	      long best = -1; TofIdx best_d = span + 1;
   788	      for (uint32_t k = s0; k < b && sl.tof[k] <= centroid + span; ++k)
   789	      {
   790	        if (used[k]) continue;
   791	        const int ds = (int)sl.scan[k] - (int)scan0;
   792	        if (ds > (int)stol || -ds > (int)stol) continue;
   793	        const TofIdx d = sl.tof[k] > centroid ? sl.tof[k] - centroid : centroid - sl.tof[k];
   794	        if (d < best_d) { best_d = d; best = (long)k; }
   795	      }
   796	      return best;
   797	    };
   798	
   799	    for (uint32_t seed : order)
   800	    {
   801	      if (used[seed]) continue;
   802	      if ((double)sl.inten[seed] < min_apex) break;      // intensity-ordered: none left above it
   803	      const size_t f0 = frame_of[seed];
   804	      const uint16_t scan0 = sl.scan[seed];
   805	      double wsum = sl.inten[seed], msum = (double)sl.tof[seed] * sl.inten[seed];
   806	      double imsum = (double)sl.imq[seed] * sl.inten[seed];
   807	      TofIdx centroid = sl.tof[seed];
   808	      used[seed] = 1;
   809	      xi.clear(); xv.clear();
   810	      xi.push_back(sl.rt_index[f0]); xv.push_back(sl.inten[seed]);
   811	
   812	      for (int dir = 1; dir >= -1; dir -= 2)
   813	      {
   814	        size_t hits = 0, visited = 0;
   815	        for (long f = (long)f0 + dir; f >= 0 && f < (long)F; f += dir)
   816	        {
   817	          const TofIdx span = ax.ok ? ax.span(centroid, sl.b[(size_t)f], mass_ppm)
   818	                                    : std::max<TofIdx>(1, (TofIdx)(centroid * mass_ppm * 1e-6 + 0.5));
   819	          const long k = pick((size_t)f, centroid, span, scan0, sl.scan_tol[(size_t)f]);
   820	          ++visited;
   821	          if (k < 0)
   822	          {
   823	            // OpenMS stops a direction when the hit rate over the frames it has visited falls
   824	            // below min_sample_rate; the same rule, on the same denominator.
   825	            if (min_sample_rate > 0.0 && (double)hits / (double)visited < min_sample_rate) break;
   826	            continue;
   827	          }
   828	          ++hits;
   829	          used[(size_t)k] = 1;
   830	          wsum += sl.inten[k]; msum += (double)sl.tof[k] * sl.inten[k];
   831	          imsum += (double)sl.imq[k] * sl.inten[k];
   832	          centroid = (TofIdx)llround(msum / wsum);
   833	          // drift cap: keeps a trace inside seed +- span, which is what makes banding exact
   834	          const TofIdx cap = ax.ok ? ax.span(sl.tof[seed], sl.b[f0], mass_ppm) : span;
   835	          if (centroid > sl.tof[seed] + cap) centroid = sl.tof[seed] + cap;
   836	          else if (sl.tof[seed] > cap && centroid < sl.tof[seed] - cap) centroid = sl.tof[seed] - cap;
   837	          xi.push_back(sl.rt_index[(size_t)f]); xv.push_back(sl.inten[k]);
   838	        }
   839	      }
   840	
   841	      if (xi.size() < 2) continue;
   842	      sort(xi.begin(), xi.end());   // the backward direction appended in reverse
   843	      // xv must follow xi: rebuild both from pairs rather than sorting one of them
   844	      {
   845	        vector<pair<uint32_t, float>> pts(xi.size());
   846	        for (size_t i2 = 0; i2 < xi.size(); ++i2) pts[i2] = {xi[i2], xv[i2]};
   847	        sort(pts.begin(), pts.end());
   848	        for (size_t i2 = 0; i2 < pts.size(); ++i2) { xi[i2] = pts[i2].first; xv[i2] = pts[i2].second; }
   849	      }
   850	      const double len = rtAxis()[xi.back()] - rtAxis()[xi.front()];
   851	      if (min_len_sec > 0.0 && len < min_len_sec) continue;
   852	      if (max_len_sec > 0.0 && len > max_len_sec) continue;
   853	
   854	      Trace t;
   855	      size_t ap = 0;
   856	      for (size_t i2 = 1; i2 < xv.size(); ++i2) if (xv[i2] > xv[ap]) ap = i2;
   857	      t.tof = (mz_est == "apex") ? sl.tof[seed] : (TofIdx)llround(msum / wsum);
   858	      t.b = sl.b[f0];
   859	      t.mz = ax.ok ? ax.mzOf(t.tof, t.b) : (double)t.tof / MZ_Q;
   860	      t.rt = rtAxis()[xi[ap]];
   861	      t.im = IM_LO + (imsum / wsum) / IM_Q;
   862	      t.intensity = xv[ap];
   863	      t.xi = xi; t.xv = xv;
   864	      out.push_back(std::move(t));
   865	    }
   866	    return out;
   867	  }
   868	
   869	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   870	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   871	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   872	  {
   873	    PeakMap m;
   874	    m.reserve(frames.size());
   875	    for (auto& f : frames)
   876	    {
   877	      MSSpectrum s;
   878	      s.setRT(f.rt);
   879	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   880	      s.reserve(f.mzq.size());
   881	      OpenMS::DataArrays::FloatDataArray ima;
   882	      ima.setName(Constants::UserParam::ION_MOBILITY);
   883	      ima.reserve(f.mzq.size());
   884	      for (size_t i = 0; i < f.mzq.size(); ++i)
   885	      {
   886	        Peak1D p;
   887	        p.setMZ((double)f.mzq[i] / MZ_Q);
   888	        p.setIntensity(f.inten[i]);
   889	        s.push_back(p);
   890	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   891	      }
   892	      s.getFloatDataArrays().push_back(std::move(ima));
   893	      m.addSpectrum(std::move(s));
   894	      // release this frame's compact storage immediately
   895	      vector<uint32_t>().swap(f.mzq);
   896	      vector<float>().swap(f.inten);
   897	      vector<uint16_t>().swap(f.imq);
   898	    }
   899	    vector<CompactFrame>().swap(frames);
   900	    return m;
     1	# Trace detection on integer arrays
     2	
     3	**Why now.** After the scoring gate was fixed (parallel arrays, 2026-09-03) the window loop is
     4	**90.9% trace detection** and 4.8% scoring. Everything else is rounding. Tracing is the tool.
     5	
     6	**What it runs on today.** `materializeWindow()` rebuilds an OpenMS `PeakMap` from the compact store:
     7	`Peak1D` (double m/z + float intensity) plus a parallel `FloatDataArray` of mobility, wrapped in an
     8	`MSSpectrum` per frame -- ~20 B/peak against the store's 10 B, plus per-spectrum object overhead,
     9	and every m/z is a double that was an integer twice over (a TOF bin, then a 1e-5 Da store index).
    10	`MassTraceDetection` then matches by a ppm tolerance on those doubles.
    11	
    12	**Goal.** Reimplement the SAME tracing semantics on integer arrays, with all three axes integer:
    13	
    14	| axis | today | here |
    15	|---|---|---|
    16	| retention time | `double` per peak, per spectrum | `uint32` frame index on the global RT axis |
    17	| m/z | `double`, twice-derived | `uint32` flight-time bin (`TofAxis`) |
    18	| ion mobility | `double` 1/K0, from a `uint16` quantum | `uint16` TIMS scan index |
    19	
    20	## 1. The mobility axis, derived without the vendor table
    21	
    22	Within one frame the distinct 1/K0 values ARE the scans, so ranking them recovers the scan index
    23	exactly: collect a frame's distinct mobility values (about a thousand), sort descending (1/K0 falls
    24	as scan number rises), and a peak's rank is its scan. No TIMS calibration table is needed to say
    25	that two peaks came from the same scan -- and comparing scans is what the gate actually wants,
    26	because the calibrated value drifts frame to frame while the scan does not.
    27	
    28	Tolerance conversion: `gate:delta_im` in 1/K0 becomes a scan count per frame, from that frame's own
    29	ranked values. It is not a constant across frames, and pretending it is would be the same mistake as
    30	a fixed ppm halo.
    31	
    32	## 2. The data structure
    33	
    34	```cpp
    35	struct PeakSlab                    // one window, frame-major, 10 B/peak, no OpenMS objects
    36	{
    37	  vector<uint32_t> frame_off;      // F+1: frame f owns [frame_off[f], frame_off[f+1])
    38	  vector<uint32_t> rt_index;       // F: frame -> global RT axis
    39	  vector<double>   b;              // F: calibration factor, for export only
    40	  vector<uint32_t> tof;            // ascending within a frame
    41	  vector<float>    inten;
    42	  vector<uint16_t> scan;           // TIMS scan index
    43	};
    44	```
    45	
    46	Ascending `tof` within a frame is what makes extension a binary search over ~50k values rather than
    47	a scan, and it comes free: the loader already sorts by m/z, which is monotone in TOF.
    48	
    49	## 3. The algorithm, kept faithful to the current one
    50	
    51	`MassTraceDetection` is: seed on the most intense unused peak; extend in both RT directions taking
    52	the closest unused peak within the mass tolerance of a RUNNING centroid; stop a direction when the
    53	hit rate over visited frames falls below `min_sample_rate`; emit if the length is in range. That is
    54	what is reimplemented -- not a new algorithm -- so the comparison is about data structures, not
    55	about science.
    56	
    57	```
    58	  order = peak indices sorted by intensity DESC          // seeding order, as today
    59	  used  = bitset over peaks
    60	  for seed in order:
    61	      if used[seed] or inten[seed] < snr * noise: continue
    62	      centroid = tof[seed]; sum = inten*tof; wsum = inten
    63	      for dir in (+1, -1):
    64	          misses = 0; visited = 0
    65	          for f = frame(seed)+dir, stepping by dir:
    66	              span = tofSpan(centroid, b[f], mass_ppm)        // integer, per frame
    67	              k = closest unused peak in frame f with |tof-centroid| <= span
    68	                                       and |scan - scan(seed)| <= scanTol(f)
    69	              visited++
    70	              if none: misses++; if hits/visited < min_sample_rate: break
    71	              else: take it, update centroid, used[k] = true
    72	      emit if length in [min_trace_length, max_trace_length]
    73	```
    74	
    75	Every inner step is: one binary search in a sorted `uint32` array, then a short linear walk over
    76	candidates in the tolerance window. No doubles are compared, no objects are constructed, and the
    77	peak arrays are touched at 10 B/peak instead of 20 B plus indirection.
    78	
    79	**Valley splitting is NOT reimplemented.** `ElutionPeakDetection` runs afterwards on the traces this
    80	produces, exactly as it does now, so that stage's behaviour is unchanged and out of scope.
    81	
    82	## 4. What this is expected to buy, and what would falsify it
    83	
    84	Trace detection is 3,869 s of 4,256 s of window-elapsed time on S30.
    85	
    86	| source of gain | mechanism | estimate |
    87	|---|---|---|
    88	| no `PeakMap` materialisation | 20 B/peak + object overhead -> 10 B/peak, and the conversion loop disappears | memory: −1 to −2 GB per in-flight window |
    89	| integer comparison | `uint32` difference instead of a ppm test on doubles | small; the loop is not ALU-bound |
    90	| **cache** | a frame's peaks are three contiguous arrays instead of `Peak1D` + a parallel array behind an `MSSpectrum` | **the term that should dominate** |
    91	| no double conversion | the store's integers are used as integers | one pass over 1.2e9 peaks removed |
    92	
    93	**Estimate: 30-50% off trace detection, i.e. S30 from 7:04 to roughly 5:00-6:00**, with peak memory
    94	down by the materialisation. Stated as a range because the split between bandwidth and the
    95	detector's own arithmetic has not been isolated -- the same uncertainty that made me underestimate
    96	the scoring gate by a factor of five, in the conservative direction.
    97	
    98	**Falsifier:** if trace detection does not fall by at least 15%, the cost was never the data
    99	structure and is in the extension search itself -- in which case the lever is the search (bucketing
   100	by tof, or capping candidates per frame), not the layout, and this refactor should be reverted
   101	rather than kept for tidiness.
   102	
   103	**Output.** Faithful, but not bit-identical: the seeding order among equal intensities and the
   104	closest-peak tie-breaks will differ. Judged on identified peptides with both engines.
   105	
   106	## 5. Risks, stated before the review
   107	
   108	1. **`min_sample_rate` semantics.** OpenMS computes the hit rate over the frames it has visited in
   109	   that direction. Reimplementing it subtly differently changes which traces survive, and it is the
   110	   one MS2 trace-validity lever this project has found to matter.
   111	2. **Seeding order.** OpenMS sorts by intensity; ties are broken by whatever the sort does. Ours
   112	   must be deterministic, or runs will not reproduce.
   113	3. **The `used` marking is the parallelism hazard.** It is what makes tracing sequential within a
   114	   band; bands are independent, so the parallel structure is unchanged, but a shared `used` across
   115	   bands would be a race.
   116	4. **The mobility rank assumes a frame's distinct 1/K0 values are its scans.** If a converter has
   117	   already merged or re-binned mobility, the rank is not the scan. This must be checked on real data
   118	   before it is trusted, not assumed.

