   629	  /// One window's peaks in INDEX SPACE, frame-major. This is what the compact store already holds;
   630	  /// the point is that it is never converted back to Peak1D doubles. Replaces the materialised
   631	  /// PeakMap for the integer detector. See docs/MZ-AXIS-DESIGN.md.
   632	  struct PeakSlab
   633	  {
   634	    vector<uint32_t> frame_off;    ///< size F+1: frame f owns [frame_off[f], frame_off[f+1])
   635	    vector<uint32_t> rt_index;     ///< size F: the frame's index on the GLOBAL RT axis
   636	    vector<TofIdx>   tof;          ///< flight-time bin, ascending within a frame
   637	    vector<double>   b;            ///< size F: the frame's calibration factor (bin -> m/z)
   638	    vector<float>    inten;
   639	    vector<uint16_t> imq;
   640	    size_t frames() const { return rt_index.size(); }
   641	    size_t peaks()  const { return tof.size(); }
   642	  };
   643	
   644	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   645	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   646	  PeakSlab toSlab(vector<CompactFrame>& frames)
   647	  {
   648	    PeakSlab sl;
   649	    const size_t F = frames.size();
   650	    sl.frame_off.resize(F + 1, 0);
   651	    sl.rt_index.resize(F);
   652	    size_t total = 0;
   653	    for (const auto& f : frames) total += f.mzq.size();
   654	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   655	    sl.b.resize(F);
   656	    const TofAxis& ax = tofAxis();
   657	    for (size_t i = 0; i < F; ++i)
   658	    {
   659	      CompactFrame& f = frames[i];
   660	      sl.rt_index[i] = rtIndex(f.rt);
   661	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   662	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   663	      // introduced here, and the loader does not have to change.
   664	      const double b = ax.factor(f.frame_id);
   665	      sl.b[i] = b;
   666	      sl.frame_off[i] = (uint32_t)sl.tof.size();
   667	      for (size_t k = 0; k < f.mzq.size(); ++k)
   668	        sl.tof.push_back(ax.tofOf((double)f.mzq[k] / MZ_Q, b));
