  2200	    mzEstimator() = getStringOption_("trace:mz_estimator");   // before any toTrace() call
  2201	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  2202	
  2203	    PeakMap exp;
  2204	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
