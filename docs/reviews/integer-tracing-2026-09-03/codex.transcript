  1540	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1541	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1542	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1543	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1544	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1545	  {
  1546	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1547	    out.assign(n, 0.0);
  1548	    double term = 1.0;
  1549	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1550	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1551	    if (mx > 0) for (double& v : out) v /= mx;
  1552	  }
  1553	
  1554	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1555	  {
  1556	    double dot = 0, na = 0, nb = 0;
  1557	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1558	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1559	  }
