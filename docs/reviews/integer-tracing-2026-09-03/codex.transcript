  1521	  // =====================================================================
  1522	  // load() overloads
  1523	  // =====================================================================
  1524	  void BrukerTimsFile::load(const String& path, MSExperiment& exp)
  1525	  {
  1526	    load(path, exp, Config());
  1527	  }
  1528	
  1529	  void BrukerTimsFile::load(const String& path, MSExperiment& exp, const Config& config)
  1530	  {
  1531	    exp.clear(true);
  1532	    auto handle = openTimsDataHandle(path, config);
  1533	
  1534	    String tdf_path = path + "/analysis.tdf";
  1535	    bool is_dia = isDIA_(tdf_path);
  1536	    Config::ExportMode mode = config.export_mode;
  1537	
  1538	    if (mode == Config::FRAME)
  1539	    {
  1540	      loadFrames_(*handle, exp, config);
  1541	    }
  1542	    else if (mode == Config::SPECTRUM || (mode == Config::AUTO && !is_dia))
  1543	    {
  1544	      loadDDA_(*handle, exp, config);
  1545	    }
  1546	    else // AUTO + DIA
  1547	    {
  1548	      loadDIA_(*handle, exp, config);
  1549	    }
  1550	
  1551	    loadExperimentalSettings_(path, exp);
  1552	
  1553	    // Sort by RT, interleaved across MS levels
  1554	    exp.sortSpectra(true);
  1555	    exp.updateRanges();
  1556	  }
