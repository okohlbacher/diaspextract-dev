   670	      sl.imq.insert(sl.imq.end(), f.imq.begin(), f.imq.end());
   671	      vector<uint32_t>().swap(f.mzq);
   672	      vector<float>().swap(f.inten);
   673	      vector<uint16_t>().swap(f.imq);
   674	    }
   675	    sl.frame_off[F] = (uint32_t)sl.tof.size();
   676	    return sl;
   677	  }
