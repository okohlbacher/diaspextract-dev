   309	  inline uint32_t Trace::gframe(size_t k) const { return st->rt_index[frame0 + k]; }
   310	
   311	  /// The real points of a trace, packed in frame order, for the consumers that were written over
   312	  /// point lists (smoother, FWHM): identical sequences, so identical arithmetic.
   313	  inline void packReal(const Trace& t, vector<double>& rt, vector<double>& v)
   314	  {
   315	    rt.clear(); v.clear();
  1090	  /// MassTrace (a list<Peak2D>, ~48 B/point) on ONE thread and then ran ElutionPeakDetection over
  1091	  /// all of them at once, also on one thread: a serial section of a stage that is 95% of the window
  1092	  /// loop, and the whole window's list-based copy alive at the same time. That is consistent with
  1093	  /// what was measured -- occupancy 44x against 81x for the OpenMS path, and MORE peak memory,
  1094	  /// after the per-band sorts and the per-visit calibration calls had already been removed and
  1095	  /// changed nothing.
  1096	  vector<Trace> splitIntegerTraces(vector<Trace>& in, double split_valleys, TraceStore& wst, int nchunk)
  1097	  {
  1098	    if (split_valleys <= 0.0 || in.size() < 2) return std::move(in);   // OpenMS branch: EPD needs > 1
  1099	    const TofAxis& ax = tofAxis();
  1100	    nchunk = std::max(1, std::min<int>(nchunk, (int)in.size()));
  1101	    vector<vector<Trace>> parts(nchunk);
  1102	    vector<TraceStore> stores(nchunk);                         // chunk-private arenas, merged after
  1103	    const size_t n_in = in.size();
  1104	    #pragma omp taskloop grainsize(1) default(shared)
  1105	    for (int ci = 0; ci < nchunk; ++ci)
  1106	    {
  1107	      const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1108	      TraceStore& cst = stores[ci];
  1109	      cst.setFrames(wst.rt_index, &wst.b);
  1110	      // STREAMED: one MassTrace in flight, not the chunk's worth. The two-phase version built every
  1111	      // input trace of the chunk as a MassTrace and kept them all alive across the split, so the
  1112	      // input payload and the whole split output coexisted -- the two largest ledger lines after the
  1113	      // slab. Per-trace is exactly equivalent: with width_filtering=off and masstrace_snr_filtering
  1114	      // =false the cross-trace routines are unreachable, and the lock-free patch's nested path is
  1115	      // itself `for (i..) detectElutionPeaks_(mt_vec[i], out)` appending in the same order.
  1116	      //
  1117	      // epd is hoisted to chunk scope deliberately. splitValleys constructed one and did
  1118	      // getParameters/setValue x4/setParameters on EVERY call; moving that inside a per-trace loop
  1119	      // would be ~4e4 Param round-trips per chunk and would trade the memory win for a slowdown.
  1120	      ElutionPeakDetection epd;
  1121	      epd.setLogType(ProgressLogger::NONE);
  1122	      {
  1123	        Param ep = epd.getParameters();
  1124	        ep.setValue("chrom_fwhm", split_valleys);
  1125	        ep.setValue("width_filtering", "off");
  1126	        ep.setValue("masstrace_snr_filtering", "false");
  1127	        epd.setParameters(ep);
  1128	      }
  1129	      long long mt_live = 0;                                  // peak of ONE parent + its children
  1130	      vector<Trace>& out = parts[ci];
  1131	      out.reserve(hi - lo);
  1132	      vector<Peak2D> pk;                                      // reused: a vector, not a per-point list
  1133	      vector<MassTrace> split;                                // reused: detectPeaks clears it itself
  1134	      for (size_t q = lo; q < hi; ++q)
  1135	      {
  1136	        const Trace& t = in[q];
