  2240	  {
  2241	    vector<double> rt;
  2242	    vector<uint16_t> q;
  2243	    double rt0 = 0.0, inv = 0.0;
  2244	    double operator[](size_t i) const { return rt[i]; }
  2245	    /// Signed and unclamped: a precursor may sit outside the window's fragment RT range.
  2246	    int bucketOf(double v) const
