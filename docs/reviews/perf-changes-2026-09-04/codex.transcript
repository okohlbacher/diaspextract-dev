   274	  struct TraceStore
   275	  {
   276	    vector<uint32_t> rt_index;   ///< frame -> global RT axis
   277	    vector<double>   b;          ///< frame -> calibration factor (empty on the OpenMS path)
   278	    vector<double>   frame_rt;   ///< frame -> RT value, for toTrace()'s frame lookup
   279	    vector<float>    inten;      ///< arena of spans
   280	    vector<uint32_t> bins;       ///< arena of per-frame bins (integer path, until EPD)
   281	    size_t frames() const { return rt_index.size(); }
   282	    void setFrames(const vector<uint32_t>& ri, const vector<double>* bb)
   283	    {
   284	      rt_index = ri; if (bb) b = *bb; else b.clear();
   285	      frame_rt.resize(ri.size());
   286	      for (size_t f = 0; f < ri.size(); ++f) frame_rt[f] = rtAxis()[ri[f]];
   287	    }
   288	    /// Store-local frame of an RT value (exact by construction; nearest guards a last-ulp slip).
   289	    uint32_t frameOf(double rt) const
   290	    {
   291	      auto it = lower_bound(frame_rt.begin(), frame_rt.end(), rt);
   292	      if (it == frame_rt.end()) return (uint32_t)(frame_rt.size() - 1);
   293	      if (it != frame_rt.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   294	      return (uint32_t)(it - frame_rt.begin());
   295	    }
   296	    /// Append `other`'s arenas and return the offset they now start at (for rebasing).
   297	    uint32_t absorb(TraceStore& other)
   298	    {
   299	      const size_t base = inten.size();
   300	      if (base + other.inten.size() >= (size_t)std::numeric_limits<uint32_t>::max())
   301	        throw OpenMS::Exception::OutOfRange(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION);
   302	      inten.insert(inten.end(), other.inten.begin(), other.inten.end());
   303	      if (!other.bins.empty()) { bins.resize(base, 0u); bins.insert(bins.end(), other.bins.begin(), other.bins.end()); }
   304	      vector<float>().swap(other.inten); vector<uint32_t>().swap(other.bins);
   305	      return (uint32_t)base;
   306	    }
   307	  };
