  2754	        // land at 2-3x it -- far more random-match opportunities, diluting the score. Keep the
  2755	        // top max_frags by intensity, then restore m/z order (mzML requires ascending m/z).
  2756	        if (max_frags > 0 && (int)out.size() > max_frags)
  2757	        {
  2758	          vector<Peak1D> v(out.begin(), out.end());
  2759	          std::nth_element(v.begin(), v.begin() + max_frags, v.end(),
