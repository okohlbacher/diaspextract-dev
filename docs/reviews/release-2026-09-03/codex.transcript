  2688	          // identified pairs, SAME-peptide neighbours differ by a median 9.0 ppm and 0.0074
  2689	          // 1/K0 while DIFFERENT-peptide neighbours differ by 205,065 ppm and 0.0906, so the
  2690	          // coordinate gate already admits only 1.8% chimeras. The problem is that only 12,380
  2691	          // of 161,798 spectra identify at all, so a coordinate gate happily merges a good
  2692	          // spectrum with several spectra that carry no identifiable signal -- their peaks
  2693	          // dilute the matched fraction without contributing matches. Cosine sees that;
  2694	          // coordinates cannot. Measured reference distribution: within-cycle pairs 0.845,
  2695	          // same peptide across cycles 0.687, unrelated spectra 0.007.
  2696	          if (mg_cos > 0.0)
  2697	          {
  2698	            const MSSpectrum& A = all_out[i];
  2699	            const MSSpectrum& B = all_out[j];
  2700	            double dot = 0.0, na = 0.0, nb = 0.0;
  2701	            for (const auto& pa : A) na += (double)pa.getIntensity() * pa.getIntensity();
  2702	            for (const auto& pb : B) nb += (double)pb.getIntensity() * pb.getIntensity();
  2703	            if (na <= 0.0 || nb <= 0.0) continue;
