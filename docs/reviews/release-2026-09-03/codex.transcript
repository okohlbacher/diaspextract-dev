  2603	    // Canonical total-order sort (RT, precursor m/z, charge): thread-count-independent and free of
  2604	    // RT-tie ambiguity (RT-only sortSpectra is NOT canonical). [par-Crit-2]
  2605	    { Phase _ph("SORT(canonical)");
  2606	    sort(all_out.begin(), all_out.end(), [](const MSSpectrum& a, const MSSpectrum& b) {
  2607	      if (a.getRT() != b.getRT()) return a.getRT() < b.getRT();
  2608	      const double amz = a.getPrecursors().empty() ? 0.0 : a.getPrecursors()[0].getMZ();
  2609	      const double bmz = b.getPrecursors().empty() ? 0.0 : b.getPrecursors()[0].getMZ();
  2610	      if (amz != bmz) return amz < bmz;
  2611	      const int ac = a.getPrecursors().empty() ? 0 : a.getPrecursors()[0].getCharge();
  2612	      const int bc = b.getPrecursors().empty() ? 0 : b.getPrecursors()[0].getCharge();
  2613	      if (ac != bc) return ac < bc;
  2614	      // fragment-sequence tiebreaks so equal-precursor spectra have a canonical order [code-review]
  2615	      if (a.size() != b.size()) return a.size() < b.size();
  2616	      for (Size i = 0; i < a.size(); ++i)
  2617	      {
  2618	        if (a[i].getMZ() != b[i].getMZ()) return a[i].getMZ() < b[i].getMZ();
  2619	        if (a[i].getIntensity() != b[i].getIntensity()) return a[i].getIntensity() < b[i].getIntensity();
  2620	      }
  2621	      return false;
  2622	    }); }
