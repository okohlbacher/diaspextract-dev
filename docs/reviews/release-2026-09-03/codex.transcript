  2552	          for (size_t b = 0; b < 9; ++b) fanout_hist[b] += h[b];
  2553	        }
  2554	      }
  2555	      catch (...)
  2556	      {
  2557	        #pragma omp critical
  2558	        if (!worker_err) worker_err = std::current_exception();
  2559	      }
  2560	    }
  2561	    if (worker_err) std::rethrow_exception(worker_err);
  2562	
  2563	    if (rp_max > 0)
  2564	    {
  2565	      uint64_t tot = 0; for (auto v : fanout_hist) tot += v;
  2566	      if (tot > 0)
  2567	      {
  2568	        const char* lbl[9] = {"1","2","3","4","5","6-10","11-25","26-50","51+"};
  2569	        String msg = "Fan-out histogram (precursors per fragment, before rp_max=" + String(rp_max) + " cap): ";
  2570	        for (size_t b = 0; b < 9; ++b)
  2571	          msg += String(lbl[b]) + "=" + String(fanout_hist[b]) + "(" + String((int)(1000.0 * fanout_hist[b] / tot) / 10.0) + "%) ";
  2572	        writeLogInfo_(msg);
  2573	      }
  2574	    }
  2575	
  2576	    { auto& st = phase_stats_()["WINDOW_LOOP"]; if (st.n++ == 0) phase_order_().push_back("WINDOW_LOOP");
  2577	      st.wall += phase_clock_() - _t_win; st.cpu += cpu_seconds_() - _c_win; st.rss_end_mb = rss_mb_(); }
  2578	    writeLogInfo_("All windows done." + clk_() + rss_()); // parallel-phase peak? [mem]
  2579	    {
  2580	      // These are CPU-seconds summed across threads, not wall time -- a stage that runs on 20
  2581	      // threads contributes 20x its wall. That is the right denominator for "where does the work
  2582	      // go", but it must not be read as wall time, so both are printed.
  2583	      const double S = 1e-9;
  2584	      const double tot = S * (t_mat + t_trace + t_grid + t_score + t_emit);
  2585	      auto pct = [&](long long v) { return tot > 0 ? 100.0 * S * v / tot : 0.0; };
  2586	      writeLogInfo_("Window-loop stage breakdown (CPU-seconds across all threads, "
  2587	                    + String(tot) + " s total):");
  2588	      writeLogInfo_("  materialize " + String(S * t_mat)   + " s (" + String(pct(t_mat))   + "%)");
  2589	      writeLogInfo_("  trace       " + String(S * t_trace) + " s (" + String(pct(t_trace)) + "%)");
  2590	      writeLogInfo_("  fraggrid    " + String(S * t_grid)  + " s (" + String(pct(t_grid))  + "%)");
  2591	      writeLogInfo_("  score       " + String(S * t_score) + " s (" + String(pct(t_score)) + "%)");
  2592	      writeLogInfo_("  emit        " + String(S * t_emit)  + " s (" + String(pct(t_emit))  + "%)");
  2593	    }
  2594	
  2595	    vector<MSSpectrum> all_out;
  2596	    {
  2597	      size_t n_tot = 0;
  2598	      for (const auto& bucket : win_out) n_tot += bucket.size();
  2599	      all_out.reserve(n_tot); // avoid repeated reallocation of ~1M spectrum objects
  2600	    }
