  2846	    out_exp.setMetaValue("spx:mz_calibration", BrukerTimsFile::lastMzCalibration());
  2847	    out_exp.setMetaValue("spx:corr_power", corr_power_);
  2848	    out_exp.setMetaValue("spx:im_weight_sigma", im_weight_sigma_);
  2849	    out_exp.setMetaValue("spx:require_isotope_support", (int)getFlag_("assembly:require_isotope_support"));
  2850	    { Phase _ph("WRITE(mzML)");
  2851	      FileHandler().storeExperiment(out, out_exp, {FileTypes::MZML}, log_type_); }
  2852	    writeLogInfo_("Wrote " + String(n_out) + " pseudo-MS2 spectra to " + out);
  2853	    report_phases_(phase_clock_());
  2854	    return EXECUTION_OK;
  2855	  }
  2856	};
