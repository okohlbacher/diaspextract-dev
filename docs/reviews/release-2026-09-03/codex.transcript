     1	#!/usr/bin/env bash
     2	# Joint benchmark: 3 samples x {the reference implementation, speXtract} x {Sage, MSFragger}
     3	# Metrics: FDR-corrected PSMs and FDR-corrected unique peptides, both at 1%, both computed by
     4	# ONE procedure in joint_bench.py so the engine is the only thing that varies.
     5	#
     6	# Both engines search ONE pre-built target+decoy database (Sage's internal decoy generation is
     7	# OFF), so they see byte-identical search spaces. Search parameters are matched to
     8	# sage_closed.json -- the config behind every number in the README.
     9	set -u
    10	B=/scratch/kohlbach/bench
    11	cd $B
    12	SAGE=$B/sage-v0.14.7-x86_64-unknown-linux-gnu/sage
    13	MSF=/scratch/agxt-liver/work/fp-tools/MSFragger-4.4.1.jar
    14	DTP=/scratch/agxt-liver/work/mzml-reference-implementation-patched
    15	L=$B/joint.log
    16	J=$B/joint_results.json
    17	echo "=== joint benchmark $(date) ===" > $L
    18	
    19	# do not contend with the open-search benchmark on this node
    20	while pgrep -f "run_open" >/dev/null 2>&1; do sleep 60; done
    21	
    22	# ---- shared target+decoy database --------------------------------------------------------------
    23	DB=$B/human_decoy.fasta
    24	[ -s "$DB" ] || python3 $B/joint_bench.py decoydb --target $B/human.fasta --out "$DB" >> $L 2>&1
    25	grep -c "^>rev_" "$DB" | xargs echo "decoys in shared DB:" >> $L
    26	
    27	# ---- Sage config: same as closed, but decoys come from the FILE --------------------------------
    28	python3 - "$B/sage_closed.json" "$DB" "$B/sage_joint.json" <<'PY'
    29	import json, sys
    30	c = json.load(open(sys.argv[1]))
    31	c["database"]["fasta"] = sys.argv[2]
    32	c["database"]["generate_decoys"] = False      # decoys are in the shared file
    33	c["database"]["decoy_tag"] = "rev_"
    34	json.dump(c, open(sys.argv[3], "w"), indent=2)
    35	PY
    36	
    37	# ---- MSFragger params, matched to sage_closed.json ---------------------------------------------
    38	cat > $B/msfragger.params <<EOF
    39	database_name = $DB
    40	decoy_prefix = rev_
    41	num_threads = 100
    42	precursor_mass_lower = -25
    43	precursor_mass_upper = 25
    44	precursor_mass_units = 1
    45	precursor_true_tolerance = 25
    46	precursor_true_units = 1
    47	fragment_mass_tolerance = 25
    48	fragment_mass_units = 1
    49	isotope_error = -1/0/1/2
    50	search_enzyme_name_1 = trypsin
    51	search_enzyme_cut_1 = KR
    52	search_enzyme_nocut_1 = P
    53	allowed_missed_cleavage_1 = 2
    54	num_enzyme_termini = 2
    55	digest_min_length = 7
    56	digest_max_length = 35
    57	digest_mass_range = 500.0 5000.0
    58	max_variable_mods_per_peptide = 2
    59	variable_mod_01 = 15.9949 M 3
    60	variable_mod_02 = 42.0106 [^ 1
    61	add_C_cysteine = 57.02146
    62	precursor_charge = 2 4
    63	override_charge = 0
    64	output_format = tsv
    65	output_report_topN = 1
    66	output_max_expect = 50
    67	minimum_peaks = 6
    68	min_matched_fragments = 4
    69	use_topN_peaks = 150
    70	EOF
    71	
    72	run_cell () {
    73	  local TOOL=$1 SAMPLE=$2 MZ=$3
    74	  if [ ! -s "$MZ" ]; then echo "[$TOOL/$SAMPLE] SKIP: missing $MZ" >> $L; return; fi
    75	
    76	  # ---- Sage ----
    77	  local O=$B/joint/${TOOL}_${SAMPLE}_sage; mkdir -p $O
    78	  if [ ! -s "$O/results.sage.tsv" ]; then
    79	    local t0=$SECONDS
    80	    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
    81	      $SAGE $B/sage_joint.json -o $O --disable-telemetry-i-dont-want-to-improve-sage \
    82	      "$MZ" > $O/engine.log 2>&1
    83	    echo "[$TOOL/$SAMPLE] sage $((SECONDS-t0))s" >> $L
    84	  fi
    85	  [ -s "$O/results.sage.tsv" ] \
    86	    && python3 $B/joint_bench.py score "$O/results.sage.tsv" --engine sage \
    87	         --label "${TOOL}_${SAMPLE}" --json $J >> $L 2>&1 \
    88	    || { echo "[$TOOL/$SAMPLE] SAGE FAILED" >> $L; tail -3 $O/engine.log >> $L; }
    89	
    90	  # ---- MSFragger ----
    91	  local M=$B/joint/${TOOL}_${SAMPLE}_msf; mkdir -p $M
    92	  local TSV=$M/$(basename "${MZ%.*}").tsv
    93	  if [ ! -s "$TSV" ]; then
    94	    local t1=$SECONDS
    95	    ( cd $M && java -Xmx220G -jar $MSF $B/msfragger.params "$MZ" > $M/engine.log 2>&1 )
    96	    echo "[$TOOL/$SAMPLE] msfragger $((SECONDS-t1))s" >> $L
    97	    # MSFragger writes next to the INPUT unless told otherwise -- same trap the reference implementation set
    98	    for f in "$(dirname "$MZ")/$(basename "${MZ%.*}").tsv" "$M"/*.tsv; do
    99	      [ -s "$f" ] && TSV="$f" && break
   100	    done
   101	  fi
   102	  [ -s "$TSV" ] \
   103	    && python3 $B/joint_bench.py score "$TSV" --engine msfragger \
   104	         --label "${TOOL}_${SAMPLE}" --json $J >> $L 2>&1 \
   105	    || { echo "[$TOOL/$SAMPLE] MSFRAGGER FAILED (no tsv)" >> $L; tail -4 $M/engine.log >> $L; }
   106	}
   107	
   108	mkdir -p $B/joint
   109	run_cell reference-implementation dataset A "$DTP/dataset-A"
   110	run_cell reference-implementation dataset B "$DTP/dataset-B"
   111	run_cell reference-implementation dataset D "$DTP/dataset-D"
   112	run_cell spextract dataset A "$B/out/m_S08_treat/pseudo.mzML"
   113	run_cell spextract dataset B "$B/out/open_split_count/pseudo.mzML"
   114	run_cell spextract dataset D "$B/out/m_S30_treat/pseudo.mzML"
   115	
   116	echo "--- TABLE ---" >> $L
   117	python3 $B/joint_bench.py collate $J >> $L 2>&1
   118	echo DONE >> $L
     1	#!/usr/bin/env bash
     2	# Entrapment-controlled OPEN-search benchmark.
     3	#
     4	# The closed benchmark that produced every number in README.md cannot see the failure mode this
     5	# tool exists to avoid: a charge error fabricates dM = (z'-z)(m/z - 1.00728), hundreds of Da, and
     6	# a +-25 ppm search simply does not report those PSMs. This measures in the mode the tool is for.
     7	#
     8	# Arms, all on dataset B, all from EXISTING mzML (no re-extraction -- the spectra are already produced):
     9	#   base         ms1_split_valleys 0,   charge:scoring envelope   (the pre-2026-07-21 default)
    10	#   split_count  ms1_split_valleys 7.0, charge:scoring count      (the shipped default)
    11	#   envelope     ms1_split_valleys 7.0, charge:scoring envelope   (POSITIVE CONTROL: 10,199 known
    12	#                                                                  4->2 errors must show as
    13	#                                                                  slope -2 ray mass)
    14	#
    15	# Two windows: -150/+500 Da for the primary metric, -3000/+1000 for the positive control, because
    16	# a 4->2 error at m/z 500-1400 lands at -1000 to -2800 Da and is NOT REPORTED inside +-500.
    17	set -u
    18	cd /scratch/kohlbach/bench
    19	B=/scratch/kohlbach/bench
    20	SAGE=$B/sage-v0.14.7-x86_64-unknown-linux-gnu/sage
    21	L=$B/open_bench.log
    22	echo "=== entrapment open-search benchmark $(date) ===" > $L
    23	
    24	# ---- entrapment database ----------------------------------------------------------------------
    25	ENTRAP=$B/human_entrap.fasta
    26	if [ ! -s "$ENTRAP" ]; then
    27	  python3 $B/open_bench.py fasta --target $B/human.fasta --foreign $B/arabidopsis.fasta \
    28	      --out "$ENTRAP" >> $L 2>&1
    29	fi
    30	NT=$(grep -c "^>" $B/human.fasta)
    31	NE=$(grep -c "^>ENTRAP_" "$ENTRAP")
    32	RATIO=$(python3 -c "print(%.6f % ($NE/$NT))" 2>/dev/null || python3 -c "print($NE/$NT)")
    33	echo "entrapment: $NT target / $NE foreign, ratio $RATIO" >> $L
    34	
    35	# ---- arms: reuse mzML already produced --------------------------------------------------------
    36	# All three arms must come from ONE node and ONE binary. base and envelope already exist here;
    37	# split_count exists only on spock, from a different binary. Comparing across nodes/binaries is
    38	# precisely the error class this benchmark was built to eliminate, so it is re-extracted here
    39	# rather than copied.
    40	TOOL=/scratch/kohlbach/OpenMS/build/bin/DIAPseudoSpectra
    41	DD=/scratch/kohlbach/rawd/dataset-B
    42	COMMON="-trace:ms2_chrom_peak_snr 1.0 -trace:ms2_noise_threshold_int 10 -trace:ms2_min_length_sec 0 -trace:ms2_split_valleys 7.0"
    43	SC=$B/out/open_split_count
    44	if [ ! -s "$SC/pseudo.mzML" ]; then
    45	  mkdir -p "$SC"
    46	  echo "extracting split_count on this node (same binary as base/envelope) $(date)" >> $L
    47	  LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
    48	  LD_LIBRARY_PATH=/scratch/kohlbach/OpenMS/build/lib \
    49	    $TOOL -in "$DD" -out "$SC/pseudo.mzML" -threads 120 $COMMON \
    50	      -trace:ms1_split_valleys 7.0 -charge:scoring count \
    51	      -assembly:open_search_safe > "$SC/run.log" 2>&1
    52	  echo "  extraction done $(date)" >> $L
    53	fi
    54	
    55	declare -A MZ
    56	MZ[base]=$B/out/m_S23_base/pseudo.mzML
    57	MZ[split_count]=$SC/pseudo.mzML
    58	MZ[envelope]=$B/out/way2_both/pseudo.mzML
    59	
    60	run_one () {
    61	  local ARM=$1 CFG=$2 WIN=$3
    62	  local SRC=${MZ[$ARM]}
    63	  local O=$B/open/${ARM}_${WIN}
    64	  if [ ! -s "$SRC" ]; then echo "[$ARM/$WIN] SKIP: no mzML at $SRC" >> $L; return; fi
    65	  mkdir -p "$O"
    66	  # point the version-controlled config at the entrapment database
    67	  python3 - "$CFG" "$ENTRAP" "$O/sage.json" <<'PY'
    68	import json, sys
    69	c = json.load(open(sys.argv[1]))
    70	c["database"]["fasta"] = sys.argv[2]
    71	json.dump(c, open(sys.argv[3], "w"), indent=2)
    72	PY
    73	  local t0=$SECONDS
    74	  LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
    75	    "$SAGE" "$O/sage.json" -o "$O" --disable-telemetry-i-dont-want-to-improve-sage \
    76	    "$SRC" > "$O/sage.log" 2>&1
    77	  if [ ! -s "$O/results.sage.tsv" ]; then
    78	    echo "[$ARM/$WIN] SAGE FAILED after $((SECONDS-t0))s" >> $L
    79	    tail -3 "$O/sage.log" >> $L
    80	    return
    81	  fi
    82	  echo "--- $ARM / $WIN  ($((SECONDS-t0))s)" >> $L
    83	  python3 $B/open_bench.py analyse "$O/results.sage.tsv" --label "${ARM}_${WIN}" \
    84	      --ratio "$RATIO" --json $B/open/results.json >> $L 2>&1
    85	}
    86	
    87	mkdir -p $B/open
    88	for ARM in base split_count envelope; do
    89	  run_one "$ARM" "$B/sage_open.json" w500
    90	done
    91	# positive control only: the wide window is expensive and its FDR is less trustworthy
    92	run_one envelope    "$B/sage_open_wide.json" wide
    93	run_one split_count "$B/sage_open_wide.json" wide
    94	
    95	echo DONE >> $L
     1	#!/bin/bash
     2	# Apply speXtract's OpenMS patches to an OpenMS source tree and install the shared calibration header.
     3	#
     4	# WITHOUT these patches the tool builds and runs, but the Bruker .d reader falls back to a two-point
     5	# linear-in-sqrt TOF->m/z chord that is -5..-11 ppm biased on the files we measured -- which costs
     6	# ~6-11% of closed-search peptide identifications (docs/BENCHMARK-MATRIX-2026-09-01.md). The build is
     7	# silent about it; only the run log says which calibration was used, and every emitted mzML carries
     8	# the answer in the spx:mz_calibration userParam.
     9	#
    10	# Usage: scripts/apply_openms_patches.sh /path/to/OpenMS
    11	set -euo pipefail
    12	cd "$(dirname "$0")/.."
    13	TREE=${1:?usage: apply_openms_patches.sh /path/to/OpenMS-source-tree}
    14	[ -f "$TREE/src/openms/source/FORMAT/BrukerTimsFile.cpp" ] || {
    15	  echo "not an OpenMS source tree (no src/openms/source/FORMAT/BrukerTimsFile.cpp): $TREE" >&2; exit 1; }
    16	
    17	# the calibration model is header-only and lives in THIS repo; the patch includes it
    18	install -m 0644 src/TdfMzCalibration.h "$TREE/src/openms/include/OpenMS/FORMAT/TdfMzCalibration.h"
    19	echo "installed src/TdfMzCalibration.h -> $TREE/src/openms/include/OpenMS/FORMAT/"
    20	
    21	for p in patches/*.patch; do
    22	  if patch -p0 -N --dry-run -d "$TREE" < "$p" >/dev/null 2>&1; then
    23	    patch -p0 -N -d "$TREE" < "$p"; echo "applied  $p"
    24	  elif patch -p0 -R --dry-run -d "$TREE" < "$p" >/dev/null 2>&1; then
    25	    echo "already applied, skipping  $p"
    26	  else
    27	    echo "FAILED to apply $p -- the tree may be a different OpenMS version" >&2; exit 1
    28	  fi
    29	done
    30	echo "done. Rebuild the DIAPseudoSpectra target, then verify the run log says:"
    31	echo "  TOF m/z calibration: TDF MzCalibration table model (exact, license-free)"
     1	#!/bin/bash
     2	# Build the mzPeak C++ library (github.com/OpenMS/mzpeak; fork okohlbacher/mzpeak-openms trunk) for
     3	# speXtract's streaming .mzpeak input, against the SAME Arrow/Parquet/libzip OpenMS was built with.
     4	#   MZPEAK_SRC   checkout of the library                     (default /scratch/kohlbach/mzpeak-cpp)
     5	#   PKGCONF      pkg-config dir with arrow/parquet/libzip .pc (default OpenMS contrib)
     6	#   BOOST_ROOT   Boost >= 1.89 (json, compat)                 (default: OpenDIAlyzer env on ceph)
     7	#   TOOLS        dir with meson + ninja on PATH               (default: same env)
     8	# GCC 13 lacks std::ranges::to (GCC 14 has it): the four `| std::ranges::to<C>()` sites are rewritten to
     9	# `| spx_to<C>()` and patches/spx_ranges_to.h is force-included. The library pins arrow>=24; OpenMS
    10	# contrib ships 23.0.0 and the code compiles against it, so the pin is relaxed here.
    11	set -eu
    12	MZPEAK_SRC=${MZPEAK_SRC:-/scratch/kohlbach/mzpeak-cpp}
    13	PKGCONF=${PKGCONF:-/scratch/kohlbach/contrib/build/lib/pkgconfig}
    14	BOOST_ROOT=${BOOST_ROOT:-/ceph/ibmi/abi/oliver/AI/OpenDIAlyzer/opt/env}
    15	TOOLS=${TOOLS:-$BOOST_ROOT/bin}
    16	HERE=$(cd "$(dirname "$0")/.." && pwd)
    17	export PATH=$TOOLS:$PATH PKG_CONFIG_PATH=$PKGCONF BOOST_ROOT
    18	cd "$MZPEAK_SRC"
    19	cp "$HERE/patches/spx_ranges_to.h" .
    20	sed -i "s/std::ranges::to</spx_to</g" src/wavelength_spectra.cpp src/data/array_index.cpp src/chromatograms.cpp src/spectra.cpp
    21	sed -i "s/arrow_ver_str = '>=24.0.0'/arrow_ver_str = '>=23.0.0'/" meson.build
    22	python3 "$HERE/patches/mzpeak-cpp-arrow23.py" "$MZPEAK_SRC/src/util/metadata_model.cpp"   # one Result-API site
    23	rm -rf build
    24	meson setup build --buildtype=release -Dcpp_args="-I$BOOST_ROOT/include -include $MZPEAK_SRC/spx_ranges_to.h" -Dcpp_link_args="-L$BOOST_ROOT/lib -Wl,-rpath,$BOOST_ROOT/lib"
    25	ninja -C build -j${JOBS:-16}
    26	ls -la build/libmzpeak.a build/subprojects/msnumpress/*.a

