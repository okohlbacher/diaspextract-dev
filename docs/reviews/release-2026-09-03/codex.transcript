  2624	    //-------------------------------------------------------------
  2625	    // [route-1] FEATURE-LEVEL CONSOLIDATION
  2626	    //
  2627	    // We emit 4.6 PSMs per unique peptide; the reference implementation emits 1.46. We are not producing WORSE spectra
  2628	    // (purity 8.3% vs their 4.0%) - we are producing the SAME peptide many times while missing others.
  2629	    // Emission is per precursor HYPOTHESIS (per trace), not per chromatographic FEATURE, so one real
  2630	    // feature can be emitted from several RT slices / IM sub-ranges / charge hypotheses.
  2630	    // feature can be emitted from several RT slices / IM sub-ranges / charge hypotheses.
  2631	    //
  2632	    // Consolidate: spectra whose precursors agree in m/z (ppm), RT and IM are ONE feature -> keep the
  2633	    // single best (most fragments, then most intense) and drop the rest. This changes emission
  2634	    // multiplicity WITHOUT touching fragment content, so it is orthogonal to every falsified
  2635	    // fragment-count knob. It should also relieve FDR competition among near-duplicate spectra.
  2636	    //
  2637	    // NOTE this is a DELETION, and deletion has repeatedly cost peptides here - hence default OFF and
  2638	    // a hard kill criterion (see TRACING.md): keep only if unique peptides rise >=3%.
  2639	    //-------------------------------------------------------------
  2640	    //-------------------------------------------------------------
  2641	    // [merge] Recombine SPLIT spectra into one joint spectrum -- union of peaks, intensities
  2642	    // SUMMED. This is not consolidate: consolidate SELECTS the richest member and discards the
  2643	    // rest, which measured -12.7% peptides. Measured basis for merging instead:
  2644	    //   * within-cycle pairs share a precursor (93.2% same charge, 7.5 ppm) and 41% of peaks
  2645	    //     are present in only ONE member; the union is 1.355x the larger member
  2646	    //   * ms1_split_valleys quadruples the affected groups (3,398 -> 14,379)
  2647	    // RT window: measured MS1 FWHM on dataset D is 3.61 s (2.61 cycles), flat across the gradient
  2648	    // (1.04x end to end), and our own spread is 2.66 cycles -- so ONE FWHM is the principled
  2649	    // window. It is 13x narrower than the 45.7 s at which an earlier analysis still saw
  2650	    // "benefit", which is the regime where two spectra cannot be one feature.
  2651	    //-------------------------------------------------------------
  2652	    const double merge_rt = getDoubleOption_("merge:rt_window");
  2653	    if (merge_rt > 0.0 && !all_out.empty())
  2654	    {
  2655	      const double mg_ppm = getDoubleOption_("merge:mass_ppm");
  2656	      const double mg_im  = getDoubleOption_("merge:delta_im");
  2657	      const double mg_mz  = getDoubleOption_("merge:mz_tol");
  2658	      const bool   mg_z   = !getFlag_("merge:any_charge");
  2659	      const bool   mg_sum = getFlag_("merge:sum_intensity");
  2660	      const double mg_cos = getDoubleOption_("merge:min_cosine");
  2661	      vector<MSSpectrum> kept;
  2662	      kept.reserve(all_out.size());
  2663	      vector<char> used(all_out.size(), 0);
  2664	      Size n_merged = 0, n_groups = 0;
  2665	
  2666	      for (size_t i = 0; i < all_out.size(); ++i)
  2667	      {
  2668	        if (used[i]) continue;
  2669	        const auto& pi = all_out[i].getPrecursors();
  2670	        if (pi.empty()) { kept.push_back(std::move(all_out[i])); used[i] = 1; continue; }
  2671	        const double mz_i = pi[0].getMZ();
  2672	        const int    z_i  = pi[0].getCharge();
  2673	        const double im_i = pi[0].getDriftTime();
