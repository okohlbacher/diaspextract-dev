     1	// speXtract: streaming diaPASEF load from an .mzpeak archive through the mzPeak C++ library
     2	// (github.com/OpenMS/mzpeak, fork okohlbacher/mzpeak-openms). Mirrors BrukerTimsFile::
     3	// loadDIAStreaming's contract so PickCompactConsumer sees the same stream: every MS1 spectrum
     4	// first (frame order), then one MSSpectrum per (MS2 frame, isolation window) holding only the
     5	// peaks inside that window's 1/K0 band, handed over serially in frame order.
     6	//
     7	// mzPeak stores a diaPASEF frame as ONE spectrum carrying N precursors (one per window, each
     8	// with an ion-mobility band) and a per-peak ion-mobility array; ims-compact archives carry raw
     9	// TOF and the library reconstructs m/z with the archive's own two-point transform. Peaks arrive
    10	// mobility-major, so each per-window spectrum is m/z-sorted here.
    11	//
    12	// ponytail: decode is parallel over contiguous frame ranges with one Index per thread (decodes
    13	// serialise on a reader's mutex); the hand-off is serial. No caching beyond the library's own.
    14	#pragma once
    15	#ifdef SPEXTRACT_WITH_MZPEAK
    16	
    17	#include <mzpeak/open.h>
    18	#include <mzpeak/index.h>
    19	#include <mzpeak/spectra.h>
    20	#include <mzpeak/spectrum.h>
    21	#include <mzpeak/spectrum_metadata.h>
    22	
    23	// [D1 exact m/z] the archive stores raw TOF behind a two-point transform; the exact ModelType-1 calibration
    24	// lives only in the embedded vendor/analysis.tdf.gz. Recover tof = round((sqrt(mz) - c0) / c1) and re-apply
    25	// TdfMzCalibration per frame. Enabled with SPEXTRACT_MZPEAK_EXACT=1.
    26	#include <OpenMS/FORMAT/TdfMzCalibration.h>   // installed by the OpenMS patch (same header as src/TdfMzCalibration.h)
    27	#include <zip.h>
    28	#include <zlib.h>
    29	#if __has_include(<SQLiteCpp/SQLiteCpp.h>)
    30	#include <SQLiteCpp/SQLiteCpp.h>   // OpenMS' in-tree extern (src/openms/extern/SQLiteCpp); not installed by OpenMS
    31	#define SPX_HAVE_SQLITECPP 1
    32	#endif
    33	#include <arrow/api.h>
    34	#include <arrow/io/memory.h>
    35	#include <parquet/file_reader.h>
    36	#include <parquet/arrow/schema.h>
