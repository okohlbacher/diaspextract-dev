    49	/**
    50	  @page TOPP_DIAPseudoSpectra DIAPseudoSpectra
    51	
    52	  @brief Extracts pseudo-MS/MS ("pseudo-DDA") spectra from diaPASEF (ion-mobility DIA) data.
    53	
    54	  Reconstructs DDA-like MS2 spectra from ion-mobility DIA (timsTOF / diaPASEF) data by
    55	  exploiting the fact that, in PASEF, fragments are recorded at the ion-mobility (1/K0)
    56	  elution coordinate of their precursor. Precursor and fragment mass traces are detected
    57	  IM-aware (@ref MassTraceDetection with an ion-mobility tolerance), then fragments are
    58	  assigned to a precursor when they co-localize in ion mobility, retention time, and
    59	  elution-profile (Pearson) correlation. The result is written as searchable mzML.
    60	
    61	  This is the OpenMS-native, BSD-3 analogue of Nesvilab the reference implementation. It is a discovery
    62	  front-end (enables open / semi-tryptic / PTM searches); it does not perform the database
    63	  search, FDR, library building or quantification.
    64	
    65	  See PLAN.md / REVIEW.md in the project workspace for the full design and adversarial review.
    66	
    67	  <B>The command line parameters of this tool are:</B>
    68	  @verbinclude TOPP_DIAPseudoSpectra.cli
    69	  <B>INI file documentation of this tool:</B>
    70	  @htmlinclude TOPP_DIAPseudoSpectra.html
    71	*/
    72	
    73	/// @cond TOPPCLASSES
    74	
    75	namespace
    76	{
    77	  /// A detected mass trace reduced to the quantities we correlate/gate on.
    78	  /// Current + peak resident set, read from /proc/self/status (Linux). Logged at phase boundaries so
    79	  /// the memory peak is MEASURED rather than estimated: it tells us whether the peak sits in the
    80	  /// raw-load phase or in the parallel per-window phase. Returns "" where unsupported. [mem]
    81	  /// seconds since tool start, for per-phase bottleneck attribution [perf]
    82	  static double phase_clock_()
    83	  {
    84	    static const auto t0 = std::chrono::steady_clock::now();
    85	    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
    86	  }
    87	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
    88	
    89	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
    90	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
    91	  /// printed unconditionally at the end so a benchmark log always says where the time went.
    92	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
    93	  inline double& flush_wall_() { static double v = 0; return v; }   // [perf-load] pick inside LOAD
    94	  inline std::map<std::string, PhaseStat>& phase_stats_()
    95	  { static std::map<std::string, PhaseStat> m; return m; }
    96	  inline std::vector<std::string>& phase_order_()
    97	  { static std::vector<std::string> v; return v; }
    98	  static double cpu_seconds_()
    99	  {
   100	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   101	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
   102	    return ru.ru_utime.tv_sec + ru.ru_utime.tv_usec * 1e-6
   103	         + ru.ru_stime.tv_sec + ru.ru_stime.tv_usec * 1e-6;
   104	  }
   105	  static long rss_mb_()
   106	  {
   107	    std::ifstream f("/proc/self/status"); std::string k;   // ponytail: Linux-only, returns 0 elsewhere
   108	    while (f >> k) { if (k == "VmRSS:") { long v; f >> v; return v / 1024; } f.ignore(1 << 20, '\n'); }
   109	    return 0;
   110	  }
   111	  struct Phase
   112	  {
   113	    std::string name; double w0, c0;
   114	    explicit Phase(std::string n) : name(std::move(n)), w0(phase_clock_()), c0(cpu_seconds_()) {}
   115	    ~Phase()
   116	    {
   117	      auto& st = phase_stats_()[name];
   118	      if (st.n == 0) phase_order_().push_back(name);
   119	      st.wall += phase_clock_() - w0; st.cpu += cpu_seconds_() - c0;
   120	      st.rss_end_mb = rss_mb_(); ++st.n;
   121	    }
   122	  };
   123	  static void report_phases_(double total_wall)
   124	  {
   125	    if (phase_order_().empty()) return;
   126	    OPENMS_LOG_INFO << "\n[perf] phase breakdown (wall s | % of total | CPU s | par x | RSS MB at end)\n";
   127	    double acc = 0;
   128	    for (const auto& n : phase_order_())
   129	    {
   130	      const auto& p = phase_stats_()[n];
   131	      acc += p.wall;
   132	      char b[220];
   133	      snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  %9.1f  %5.1fx  %8ld%s\n", n.c_str(), p.wall,
   134	               total_wall > 0 ? 100.0 * p.wall / total_wall : 0.0, p.cpu,
   135	               p.wall > 0 ? p.cpu / p.wall : 0.0, p.rss_end_mb, p.n > 1 ? "  (summed)" : "");
   136	      OPENMS_LOG_INFO << b;
   137	    }
   138	    char b[160];
   139	    snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  (unattributed %.1f s)\n", "TOTAL(measured)", acc,
   140	             total_wall > 0 ? 100.0 * acc / total_wall : 0.0, total_wall - acc);
   141	    OPENMS_LOG_INFO << b;
   142	  }
   143	
   144	  bool log_overlap_ = false;   ///< [B0] gate:coelution == "logoverlap"
   145	  /// [wavelet] Precursor-XIC smoothing scale in SECONDS, derived from the MEASURED MS1 FWHM
   146	  /// (trace:wavelet_smooth x median FWHM). 0 = off. Set once, after MS1 tracing, before the
   147	  /// window loop -- it cannot be read from a parameter directly because the FWHM is a measurement.
   148	  double wl_scale_ = 0.0;
   149	  bool rank_by_intensity_ = false;   ///< [rank] assembly:rank_by == "intensity" (the reference implementation-style)
   150	  double im_weight_sigma_ = 0.0;     ///< [recall] Gaussian IM-proximity weight on emitted fragment intensity (0=off)
   151	  double mono_guard_ = 0.0;          ///< [mono-guard] averagine slack on leftward isotope steps (0=off)
   152	  bool mono_select_ = false;         ///< [mono-select] pick the mono by averagine fit over the isotope run
   153	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   154	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   155	  bool drop_prec_iso_ = std::getenv("SPEXTRACT_DROP_PREC_ISO") != nullptr;   ///< [C9 A/B] drop precursor M+1..M+3 from fragment lists
   156	
   157	  static std::string rss_()
   158	  {
   159	    std::ifstream st("/proc/self/status");
   160	    if (!st) return "";
   161	    std::string line, cur = "?", peak = "?";
   162	    while (std::getline(st, line))
   163	    {
   164	      auto val = [&line]() {
   165	        std::string v = line.substr(line.find(':') + 1);
   166	        size_t a = v.find_first_not_of(" \t");
   167	        return a == std::string::npos ? std::string("?") : v.substr(a);
   168	      };
   169	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   170	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   171	    }
   172	    return " [RSS " + cur + ", peak " + peak + "]";
   173	  }
   174	
   175	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   176	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   177	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   178	  /// the other users. Add our own RSS back: memory we already hold is part of our budget, not
   179	  /// somebody else's. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   180	  static size_t availableBytes_()
   181	  {
   182	    std::ifstream mi("/proc/meminfo");
   183	    if (!mi) return 0;
   184	    std::string line;
   185	    size_t avail_kb = 0;
   186	    while (std::getline(mi, line))
   187	      if (line.rfind("MemAvailable:", 0) == 0)
   188	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   189	    if (!avail_kb) return 0;
   190	    std::ifstream st("/proc/self/status");
   191	    size_t rss_kb = 0;
   192	    while (st && std::getline(st, line))
   193	      if (line.rfind("VmRSS:", 0) == 0)
   194	      { rss_kb = strtoull(line.c_str() + 6, nullptr, 10); break; }
   195	    return (avail_kb + rss_kb) * 1024ull;
   196	  }
   197	
   198	  struct Trace
   199	  {
   200	    double mz = 0.0;
   201	    double rt = 0.0;   ///< apex/centroid RT
   202	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   203	    double intensity = 0.0;
   204	    // elution profile as (rt, intensity) points, sorted by rt
   205	    vector<pair<double, double>> xic;
   206	  };
   207	
   208	  /// A precursor hypothesis after isotope/charge inference.
   209	  struct Precursor_
   210	  {
   211	    double mono_mz = 0.0;
   212	    int charge = 0;          ///< 0 == unknown
   213	    double rt = 0.0;
   214	    double im = 0.0;
   215	    size_t trace_idx = 0;    ///< index into ms1 traces
   216	    bool guessed = false;    ///< [way-4] charge was DEFAULTED, not isotope-supported
   217	    int n_isotopes = 0;      ///< [Q4] isotope peaks behind the mono call (0/1 = weak, mono ±1.00335 uncertain)
   218	  };
   219	
   220	  /// MassTraceDetection locates the per-peak IM array by the exact name
   221	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   222	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   223	  void ensureIMArrayName(MSSpectrum& s)
   224	  {
   225	    auto& fdas = s.getFloatDataArrays();
   226	    if (s.containsIMData())
   227	    {
   228	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   229	      return;
   230	    }
   231	    for (auto& fda : fdas)
   232	    {
   233	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   234	      {
   235	        fda.setName(Constants::UserParam::ION_MOBILITY);
   236	        return;
   237	      }
   238	    }
   239	  }
   240	
   241	  Trace toTrace(const MassTrace& mt)
   242	  {
   243	    Trace t;
   244	    // [C2 A/B, 2026-09-02] reported m/z estimator. Default = OpenMS centroid (intensity-weighted mean over
   245	    // the trace). Paired vs the reference implementation on shared peptides our precursor m/z is +1.5..+2.6 ppm high and our
   246	    // fragment m/z ~2 ppm low, so the estimator is under test: SPEXTRACT_MZ_ESTIMATOR=apex|median|mean.
   247	    // DEFAULT = apex since 2026-09-02 18:42: +2.6% Sage (12,537 vs 12,217) AND +4.1% MSFragger (11,927 vs 11,463)
   248	    // on dataset D with the precursor bias vs the reference implementation +1.12 -> +0.78 ppm; "mean" restores the OpenMS centroid.
   249	    static const std::string mz_est = std::getenv("SPEXTRACT_MZ_ESTIMATOR") ? std::getenv("SPEXTRACT_MZ_ESTIMATOR") : "apex";
   250	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   251	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   252	    else t.mz = mt.getCentroidMZ();
   253	    t.rt = mt.getCentroidRT();
   254	    t.im = mt.getCentroidIM();
   255	    t.intensity = mt.getMaxIntensity(false);
   256	    t.xic.reserve(mt.getSize());
   257	    for (Size i = 0; i < mt.getSize(); ++i)
   258	    {
   259	      t.xic.emplace_back(mt[i].getRT(), mt[i].getIntensity());
   260	    }
   261	    sort(t.xic.begin(), t.xic.end());
   262	    return t;
   263	  }
   264	
   265	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   266	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   267	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   268	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   269	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   270	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   271	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   272	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   273	  struct FragGrid
   274	  {
   275	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   276	    vector<uint32_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   277	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   278	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   279	    size_t supBegin(size_t i) const { return off[i]; }
   280	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   281	  };
   282	
   283	
   284	  /// [cross-frame] Sliding-window aggregation of adjacent RT frames within ONE isolation window.
   285	  ///
   286	  /// the reference implementation sums "adjacent neighbor RT frames" of the same isolation window into a composite
   287	  /// (m/z x 1/K0) matrix BEFORE peak picking, which raises per-point S/N by ~sqrt(N) and lets weak
   288	  /// fragments form traces at all (Nat Commun 16:95 Methods). Because a diaPASEF isolation window is
   289	  /// sampled exactly ONCE per cycle, "adjacent frames" == adjacent CYCLES.
   290	  ///
   291	  /// SLIDING (stride 1), not block: block summing would divide our RT point count by N, and peaks here
   292	  /// span only 4-22 points, which would leave too few points to correlate at all. The cost of sliding
   293	  /// is that adjacent output points share input frames and are therefore AUTOCORRELATED, which inflates
   294	  /// Pearson r for signal and noise alike - the reason this must be benchmarked, not assumed.
   295	  ///
   296	  /// Output spectrum i = intensity-weighted (m/z, IM) clustering of the peaks of spectra
   297	  /// [i-N/2, i+N/2], carrying the ORIGINAL RT of spectrum i so the RT axis is unchanged.
   298	  void aggregateFrames_(PeakMap& wmap, int n_frames, double ppm, double im_tol)
   299	  {
   300	    if (n_frames <= 1 || wmap.empty()) return;
   301	    const int half = n_frames / 2;
   302	    const Size N = wmap.size();
   303	
   304	    struct Pk { double mz; double im; double in; };
   305	    PeakMap out;
   306	    out.reserve(N);
   307	
   308	    vector<Pk> buf;
   309	    for (Size i = 0; i < N; ++i)
   310	    {
   311	      const Size lo = (i > (Size)half) ? i - half : 0;
   312	      const Size hi = std::min(N - 1, i + (Size)half);
   313	
   314	      buf.clear();
   315	      for (Size k = lo; k <= hi; ++k)
   316	      {
   317	        const MSSpectrum& sp = wmap[k];
   318	        if (!sp.containsIMData()) continue;
   319	        const auto& imarr = sp.getFloatDataArrays()[sp.getIMData().first];
   320	        for (Size p = 0; p < sp.size(); ++p) buf.push_back({sp[p].getMZ(), (double)imarr[p], sp[p].getIntensity()});
   321	      }
   322	      sort(buf.begin(), buf.end(), [](const Pk& a, const Pk& b) {
   323	        if (a.mz != b.mz) return a.mz < b.mz;
   324	        return a.im < b.im;
   325	      });
   326	
   327	      MSSpectrum agg;
   328	      agg.setRT(wmap[i].getRT());                 // RT axis preserved (sliding, stride 1)
   329	      agg.setMSLevel(wmap[i].getMSLevel());
   330	      agg.setPrecursors(wmap[i].getPrecursors());
   331	      OpenMS::DataArrays::FloatDataArray im_out;
   332	      im_out.setName(Constants::UserParam::ION_MOBILITY);   // keep tracing IM-aware
   333	
   334	      // greedy cluster in m/z (ppm) then IM: same ion across adjacent cycles collapses, intensities SUM
   335	      for (size_t a = 0; a < buf.size(); )
   336	      {
   337	        const double mz0 = buf[a].mz;
   338	        const double tol = mz0 * ppm * 1e-6;
   339	        size_t b = a;
   340	        double sum = 0.0, wmz = 0.0, wim = 0.0;
   341	        while (b < buf.size() && buf[b].mz - mz0 <= tol)
   342	        {
   343	          if (fabs(buf[b].im - buf[a].im) <= im_tol)
   344	          {
   345	            sum += buf[b].in; wmz += buf[b].mz * buf[b].in; wim += buf[b].im * buf[b].in;
   346	            buf[b].in = -1.0;                    // consumed
   347	          }
   348	          ++b;
   349	        }
   350	        if (sum > 0.0)
   351	        {
   352	          Peak1D pk; pk.setMZ(wmz / sum); pk.setIntensity((float)sum);
   353	          agg.push_back(pk);
   354	          im_out.push_back((float)(wim / sum));
   355	        }
   356	        // advance to next unconsumed peak
   357	        while (a < buf.size() && buf[a].in < 0.0) ++a;
   358	        if (a >= buf.size()) break;
   359	      }
   360	      agg.getFloatDataArrays().push_back(im_out);
   361	      agg.sortByPosition();
   362	      out.addSpectrum(std::move(agg));
   363	    }
   364	    wmap = std::move(out);
   365	  }
   366	
   367	  /// [compact] Quantised frame store for the per-window buffer.
   368	  ///
   369	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   370	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   371	  /// cores (the reference implementation uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   372	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   373	  /// that is about to trace it, freeing the compact copy immediately.
   374	  ///
   375	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   376	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   377	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   378	  ///   intensity: float32, unchanged (Peak1D already stores float)
   379	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   380	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   381	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   382	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   383	
   384	  struct CompactFrame
   385	  {
   386	    double rt = 0.0;
   387	    vector<uint32_t> mzq;
   388	    vector<float> inten;
   389	    vector<uint16_t> imq;
   390	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   391	  };
   392	
   393	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   394	  /// [adv-fix] The first version CLAMPED out-of-range 1/K0 to IM_LO/IM_HI, which would pin outliers
   395	  /// from many frames onto two artificial, perfectly-aligned mobility values — manufacturing spurious
   396	  /// traces out of nothing. NaN also passed straight through clamp into llround (UB on unsigned
   397	  /// conversion). Dropping + counting is the only defensible behaviour.
   398	  struct CompactStats
   399	  {
   400	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   401	    /// merge per-frame stats after a parallel batch [perf-load]
   402	    CompactStats& operator+=(const CompactStats& o)
   403	    {
   404	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   405	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   406	      return *this;
   407	    }
   408	  };
   409	
   410	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   411	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   412	  {
   413	    CompactFrame f;
   414	    f.rt = s.getRT();
   415	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   416	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   417	    const Size n = s.size();
   418	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
   419	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   420	    for (Size i = 0; i < n; ++i)
   421	    {
   422	      const double mz = s[i].getMZ();
   423	      const double imv = (double)im[i];
   424	      // [adv-fix] validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   425	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   426	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   427	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   428	      f.inten.push_back(s[i].getIntensity());
   429	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   430	      ++st.kept;
   431	    }
   432	    return f;
   433	  }
   434	
   435	
   436	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   437	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACT_DET=1.
   438	  static uint64_t detDigest_(vector<uint64_t> bits)
   439	  {
   440	    std::sort(bits.begin(), bits.end());
   441	    uint64_t h = 1469598103934665603ULL;
   442	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   443	    return h;
   444	  }
   445	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACT_DET") != nullptr; return on; }
   446	  static uint64_t traceDigest_(const vector<Trace>& ts)
   447	  {
   448	    vector<uint64_t> b; b.reserve(ts.size() * 3);
   449	    for (const auto& t : ts)
   450	    {
   451	      uint64_t u; double v;
   452	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   453	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   454	      v = t.intensity; std::memcpy(&u, &v, 8); b.push_back(u);
   455	    }
   456	    return detDigest_(std::move(b));
   457	  }
   458	
   459	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   460	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   460	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   461	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   462	  {
   463	    PeakMap m;
   464	    m.reserve(frames.size());
   465	    for (auto& f : frames)
   466	    {
   467	      MSSpectrum s;
   468	      s.setRT(f.rt);
   469	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   470	      s.reserve(f.mzq.size());
   471	      OpenMS::DataArrays::FloatDataArray ima;
   472	      ima.setName(Constants::UserParam::ION_MOBILITY);
   473	      ima.reserve(f.mzq.size());
   474	      for (size_t i = 0; i < f.mzq.size(); ++i)
   475	      {
   476	        Peak1D p;
   477	        p.setMZ((double)f.mzq[i] / MZ_Q);
   478	        p.setIntensity(f.inten[i]);
   479	        s.push_back(p);
   480	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   481	      }
   482	      s.getFloatDataArrays().push_back(std::move(ima));
   483	      m.addSpectrum(std::move(s));
   484	      // release this frame's compact storage immediately
   485	      vector<uint32_t>().swap(f.mzq);
   486	      vector<float>().swap(f.inten);
   487	      vector<uint16_t>().swap(f.imq);
   488	    }
   489	    vector<CompactFrame>().swap(frames);
   490	    return m;
   491	  }
   492	
   493	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
   494	  ///
   495	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
   496	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
   497	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
   498	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
   499	  ///
   500	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
   501	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
   502	  /// ordering is the reader's business and need not match ours.
   503	  class PickCompactConsumer : public FullSwathFileConsumer
   504	  {
   505	  public:
   506	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
   507	                        PeakMap& ms1, CompactStats& stats,
   508	                        std::function<pair<int, int>(double, double)> keyfn)
   509	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
   510	
   511	    size_t frames_seen = 0;
   512	
   513	    /// [perf-load] Pick+compact a BATCH of buffered frames in parallel, then append in arrival
   514	    /// order. OpenMS hands frames over a strictly serial `for (fid..) consumeSpectrum(spec)` loop,
   515	    /// so before this the peak picking of 1.26e9 peaks ran on ONE thread and was 53% of total wall
   516	    /// (measured: 1046 s wall, parallel factor 1.0). Buffering here parallelises it without
   517	    /// touching the reader. Appending strictly by buffer index keeps the output order identical to
   518	    /// the serial path; the emitted spectra matched it in m/z and differed in ~2% of intensities at
   519	    /// the 1e-5..1e-4 relative level (Sage count unchanged) -- see docs/RUNTIME-PLAN [pick-det].
   520	    void flush_()
   521	    {
   522	      const int n = (int)buf_.size();
   523	      if (n == 0) return;
   524	      const double _tf0 = phase_clock_();
   525	      std::vector<CompactFrame> compacted((size_t)n);
   526	      std::vector<CompactStats> st((size_t)n);          // per-frame stats, merged serially below
   527	      PeakPickerIM picker = picker_;                    // Param is a deep-copy value type
   528	      // SPEXTRACT_PICK_SERIAL=1 runs this loop on one thread: the A/B that separates picker
   529	      // scheduling-sensitivity from downstream chaos (kimi, plan review). [pick-det]
   530	      static const bool par_pick = std::getenv("SPEXTRACT_PICK_SERIAL") == nullptr;
   531	      static const bool sched_set = []{ const bool st = std::getenv("SPEXTRACT_PICK_STATIC") != nullptr; omp_set_schedule(st ? omp_sched_static : omp_sched_dynamic, st ? 0 : 1); return true; }(); (void)sched_set;
   532	      std::exception_ptr pick_err;                      // an exception escaping an OMP region aborts
   533	      // chunk 1: with chunk 8 a 64-frame batch made only 8 chunks = 8 workers (codex, plan review)
   534	      #pragma omp parallel for firstprivate(picker) schedule(runtime) if(par_pick)   // SPEXTRACT_PICK_STATIC=1 -> static (history-vs-race probe)
   535	      for (int i = 0; i < n; ++i)
   536	      {
   537	        try
   538	        {
   539	          auto& s = buf_[(size_t)i];
   540	          ensureIMArrayName(s);
   541	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   542	          ensureIMArrayName(s);
   543	          compacted[(size_t)i] = compactify(s, st[(size_t)i]);
   544	          s.clear(true);                                // raw frame dies here, inside the loop
   545	        }
   546	        catch (...)
   547	        {
   548	          #pragma omp critical(pick_err)
   549	          if (!pick_err) pick_err = std::current_exception();
   550	        }
   551	      }
   552	      if (pick_err) std::rethrow_exception(pick_err);
   553	      for (int i = 0; i < n; ++i)
   554	      {
   555	        stats_ += st[(size_t)i];
   556	        windows_[key_[(size_t)i]].push_back(std::move(compacted[(size_t)i]));
   557	      }
   558	      flush_wall_() += phase_clock_() - _tf0;
   559	      buf_.clear(); key_.clear();
   560	    }
   561	
   562	  protected:
   563	    void consumeMS1Spectrum_(MapType::SpectrumType& s) override
   564	    {
   565	      // MS1 stays a PeakMap (MassTraceDetection needs it whole), but its pick is NOT small: 1,343
   566	      // frames x ~690k raw peaks = 37% of all peaks, and it used to run serially here (~400 s of
   567	      // LOAD, measured 2026-09-02). Buffer and pick in parallel like MS2; order is kept by index.
   568	      ms1_buf_.push_back(std::move(s));
   569	      ++frames_seen;
   570	      if (ms1_buf_.size() >= kBatch) flushMS1_();
   571	    }
   572	
   573	    void flushMS1_()
   574	    {
   575	      const int n = (int)ms1_buf_.size();
   576	      if (n == 0) return;
   577	      const double _tf0 = phase_clock_();
   578	      PeakPickerIM picker = picker_;
   579	      std::exception_ptr pick_err;
   580	      #pragma omp parallel for firstprivate(picker) schedule(dynamic, 1)
   581	      for (int i = 0; i < n; ++i)
   582	      {
   583	        try
   584	        {
   585	          auto& s = ms1_buf_[(size_t)i];
   586	          ensureIMArrayName(s);
   587	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   588	          ensureIMArrayName(s);
   589	        }
   590	        catch (...)
   591	        {
   592	          #pragma omp critical(pick_err_ms1)
   593	          if (!pick_err) pick_err = std::current_exception();
   594	        }
   595	      }
   596	      if (pick_err) std::rethrow_exception(pick_err);
   597	      for (auto& s : ms1_buf_) ms1_.addSpectrum(std::move(s));
   598	      ms1_buf_.clear();
   599	      flush_wall_() += phase_clock_() - _tf0;
   600	    }
   601	
   602	    void consumeSwathSpectrum_(MapType::SpectrumType& s, size_t /*swath_nr*/) override
   603	    {
   604	      const auto& prec = s.getPrecursors();
   605	      if (prec.empty()) return;                      // no isolation window -> not routable
   606	      const double c = prec[0].getMZ();
   607	      const double lo = c - prec[0].getIsolationWindowLowerOffset();
   608	      const double hi = c + prec[0].getIsolationWindowUpperOffset();
   609	      flushMS1_();                                   // MS1 arrives first; pick it before any MS2 work
   610	      key_.push_back(keyfn_(lo, hi));
   611	      buf_.push_back(std::move(s));                  // pick+compact deferred to flush_()
   612	      ++frames_seen;
   613	      if (buf_.size() >= kBatch) flush_();
   614	    }
   615	
   616	    void ensureMapsAreFilled_() override { flushMS1_(); flush_(); }   // pick up the tails
   617	
   618	  private:
   619	    /// ponytail: 256 frames is ~1 GB of raw buffer at ~37k peaks/frame -- 2.5 work items per
   620	    /// thread at 100 threads (64 gave 8 chunks of 8 = 8 workers), small next to the 12 GB compact
   621	    /// store. SPEXTRACT_PICK_BATCH overrides for the sweep.
   622	    static const size_t kBatch;
   623	    std::vector<MapType::SpectrumType> buf_;
   624	    std::vector<pair<int, int>> key_;
   625	    PeakPickerIM& picker_;
   626	    std::vector<MapType::SpectrumType> ms1_buf_;   // MS1 frames awaiting the parallel pick
   627	    map<pair<int, int>, vector<CompactFrame>>& windows_;
   628	    PeakMap& ms1_;
   629	    CompactStats& stats_;
   630	    std::function<pair<int, int>(double, double)> keyfn_;
   631	  };
   632	  const size_t PickCompactConsumer::kBatch =
   633	    std::getenv("SPEXTRACT_PICK_BATCH") ? (size_t)std::atoi(std::getenv("SPEXTRACT_PICK_BATCH")) : 256;
   634	
   635	  /// [wavelet] Stationary ("a trous") B3-spline wavelet smoothing of an elution profile.
   636	  ///
   637	  /// WHY. the reference implementation correlates a SMOOTHED precursor XIC against RAW fragment XICs (Nat Commun
   638	  /// 16:95, Methods: 2D Gaussian pre-filter, then Savitzky-Golay for elongated peaks). We copied
   639	  /// its 0.3 correlation threshold WITHOUT copying the smoothing. Pearson r between two noisy
   640	  /// profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker
   641	  /// constraint than a smoothed 0.3 -- and the attenuation is worst exactly at faint precursors,
   642	  /// which is where the coverage analysis says we lose peptides (MISS precursors are 3.2x dimmer).
   643	  /// Raising the threshold to compensate was tried and produced only an FDR artefact; smoothing
   644	  /// attacks the cause instead of the symptom.
   645	  ///
   646	  /// A-TROUS, not a decimated DWT: no downsampling, so the output stays sample-aligned with the
   647	  /// input and can be scattered onto the correlation grid at the SAME RT positions. That matters
   648	  /// for correctness here, not just convenience -- the overlap gate counts grid points where the
   649	  /// precursor is non-zero, so a transform that moved or resampled points would silently change
   650	  /// what `min_correlation_points` means.
   651	  ///
   652	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
   653	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
   654	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
   655	  {
   656	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
   657	    const int n = (int)in.size();
   658	    out = in;
   659	    if (n < 3 || levels <= 0) return;
   660	    vector<double> tmp(n);
   661	    for (int j = 1; j <= levels; ++j)
   662	    {
   663	      const int step = 1 << (j - 1);
   664	      for (int i = 0; i < n; ++i)
   665	      {
   666	        double acc = 0.0;
   667	        for (int k = -2; k <= 2; ++k)
   668	        {
   669	          int idx = i + k * step;
   670	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
   671	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
   672	          if (idx < 0) idx = -idx;
   673	          if (idx >= n) idx = 2 * (n - 1) - idx;
   674	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
   675	          acc += H[k + 2] * out[idx];
   676	        }
   677	        tmp[i] = acc;
   678	      }
   679	      out.swap(tmp);
   680	    }
   681	  }
   682	
   683	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
   684	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
   685	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
   686	  /// physical widths on different traces.
   687	  int atrousLevels(const vector<pair<double, double>>& xic, double scale_sec)
   688	  {
   689	    if (xic.size() < 5 || scale_sec <= 0.0) return 0;
   690	    vector<double> d;
   691	    d.reserve(xic.size() - 1);
   692	    for (size_t i = 1; i < xic.size(); ++i)
   693	    {
   694	      const double g = xic[i].first - xic[i - 1].first;
   695	      if (g > 0) d.push_back(g);
   696	    }
   697	    if (d.empty()) return 0;
   698	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
   699	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
   700	    if (dt <= 0.0) return 0;
   701	    const double want = scale_sec / dt;                // desired support, in SAMPLES
   702	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
   703	    const int j = (int)std::lround(std::log2(want));
   704	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
   705	  }
   706	
   707	  /// Build the per-window FragGrid from IM-sorted fragment traces.
   708	  FragGrid buildFragGrid(const vector<Trace>& frags)
   709	  {
   710	    FragGrid g;
   711	    // union of all fragment RTs -> the common grid
   712	    for (const auto& f : frags) for (const auto& p : f.xic) g.rt.push_back(p.first);
   713	    sort(g.rt.begin(), g.rt.end());
   714	    g.rt.erase(unique(g.rt.begin(), g.rt.end()), g.rt.end());
   715	    const double G = (double)g.rt.size();
   716	    g.mean.resize(frags.size());
   717	    g.invnorm.resize(frags.size());
   718	    g.off.resize(frags.size() + 1, 0);
   719	    size_t total = 0;
   720	    for (const auto& f : frags) total += f.xic.size();
   721	    g.flat.reserve(total);
   722	    for (size_t i = 0; i < frags.size(); ++i)
   723	    {
   724	      double sum = 0, sumsq = 0;
   725	      g.off[i] = (uint32_t)g.flat.size();
   726	      for (const auto& p : frags[i].xic)
   727	      {
   728	        int gi = (int)(lower_bound(g.rt.begin(), g.rt.end(), p.first) - g.rt.begin());
   729	        g.flat.emplace_back(gi, (float)p.second);
   730	        sum += p.second; sumsq += p.second * p.second;
   731	      }
   732	      g.mean[i] = sum / G;
   733	      double var = sumsq - G * g.mean[i] * g.mean[i];
   734	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0; // 0 => constant/degenerate -> never correlates
   735	    }
   736	    g.off[frags.size()] = (uint32_t)g.flat.size();   // CSR sentinel
   737	    return g;
   738	  }
   739	}
