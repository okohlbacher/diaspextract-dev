  2823	                    + " spectra (" + String((int)(1000.0 * kept.size() / std::max<size_t>(all_out.size(), 1)) / 10.0)
  2824	                    + "% kept)" + rss_());
  2825	      all_out.swap(kept);
  2826	    }
