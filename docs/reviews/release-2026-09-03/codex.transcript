  2684	          if (mg_z && pj[0].getCharge() != z_i) continue;
  2685	          const double im_j = pj[0].getDriftTime();
  2686	          if (im_i > 0 && im_j > 0 && fabs(im_j - im_i) > mg_im) continue;
