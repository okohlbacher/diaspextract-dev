  2523	          vector<uint64_t> h(9, 0);
  2524	          for (size_t fi = 0; fi < NF; ++fi) {
  2525	            uint32_t n = nfan[fi];
  2526	            if (n == 0) continue;
  2527	            size_t b = n <= 5 ? n - 1 : n <= 10 ? 5 : n <= 25 ? 6 : n <= 50 ? 7 : 8;
  2528	            ++h[b];
  2529	          }
  2530	          // invert to per-precursor fragment lists (ordered by pi -> deterministic)
  2531	          map<long, vector<size_t>> won;
  2532	          for (size_t fi = 0; fi < NF; ++fi) for (auto& cp : topk[fi]) won[cp.second].push_back(fi);
  2533	          for (auto& kv2 : won)
  2534	          {
  2535	            const Precursor_& pc = precursors[kv2.first];
  2536	            vector<pair<double, double>> frags;
  2537	            vector<double> frag_scores;
  2538	            for (size_t fi : kv2.second)
  2539	            {
  2540	              // this fragment's corr for THIS precursor (from its kept top-k list)
  2541	              double c = -1.0;
  2542	              for (auto& cp : topk[fi]) if (cp.second == kv2.first) { c = cp.first; break; }
  2543	              const auto [inten, emit_inten] = weighted_(frag_traces[fi].intensity, c, frag_im[fi] - pc.im);   // [E5]
  2544	              frags.emplace_back(frag_traces[fi].mz, emit_inten);
  2545	              frag_scores.push_back(c * inten);
