  2802	          if (all_out[j].getRT() - all_out[i].getRT() > cons_rt) break;
  2803	          if (dropped[j]) continue;
  2804	          const auto& pj = all_out[j].getPrecursors();
  2805	          if (pj.empty()) continue;
  2806	          if (fabs(pj[0].getMZ() - mz_i) > mz_i * cons_ppm * 1e-6) continue;
  2807	          if (cons_z && pj[0].getCharge() != z_i) continue;
  2808	          const double im_j = pj[0].getDriftTime();
  2809	          if (im_i > 0 && im_j > 0 && fabs(im_j - im_i) > cons_im) continue;
  2810	          // same feature: keep whichever carries more fragments (tie -> higher TIC)
  2811	          if (all_out[j].size() > all_out[best].size() ||
  2812	              (all_out[j].size() == all_out[best].size() &&
  2813	               all_out[j].calculateTIC() > all_out[best].calculateTIC()))
  2814	          {
  2815	            dropped[best] = 1; best = j;
  2816	          }
  2817	          else dropped[j] = 1;
  2818	        }
  2819	        kept.push_back(std::move(all_out[best]));
  2820	        dropped[best] = 1;
  2821	      }
