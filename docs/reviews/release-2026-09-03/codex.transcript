   795	    registerIntOption_("trace:frame_aggregation_n", "<n>", 1, "[cross-frame] Number of ADJACENT RT frames (= adjacent diaPASEF CYCLES, since each isolation window is sampled once per cycle) summed into a composite (m/z x 1/K0) frame BEFORE MS2 peak/trace detection, the reference implementation-style. 1 = off (current behaviour). 5 = user request. Sliding window, stride 1, so the RT axis and point count are preserved; note adjacent output points then share input frames and are AUTOCORRELATED, which inflates Pearson r - benchmark, do not assume.", false);
   796	    registerDoubleOption_("trace:ms2_min_sample_rate", "<r>", -1.0, "MS2 min fraction of visited scans that must contain a peak (MassTraceDetection min_sample_rate). OpenMS default 0.5 hard-deletes gappy fragment traces; MEASURED: 0.3 and 0.1 both LOSE peptides (8,865 -> 8,735 at 0.3), so -1 (= OpenMS 0.5) is the default. Lowering it produces longer, more-merged traces with wrong apexes.", false);
   797	    registerDoubleOption_("trace:ms1_min_sample_rate", "<r>", -1.0, "MS1 min_sample_rate. -1 = OpenMS default 0.5 (strict, MS1 stays strict).", false, true);
   798	
   799	    // NB: "threads" is reserved by TOPPBase (the standard -threads option), so this lives under "perf".
   800	    // [route-1] feature-level consolidation: collapse spectra that are the SAME chromatographic
   801	    // feature emitted more than once (RT slices / IM sub-ranges / charge hypotheses). Targets the
   802	    // measured 4.6 vs 1.46 PSMs-per-peptide gap. OFF by default (delta_rt 0) - it is a deletion.
   803	    registerTOPPSubsection_("consolidate", "Feature-level de-duplication of emitted spectra");
   804	    registerTOPPSubsection_("merge", "Recombine split spectra (union, not selection)");
   805	    registerDoubleOption_("merge:rt_window", "<sec>", 0.0, "FALSIFIED on dataset D (every merge/collapse variant lost peptides) -- keep 0 = OFF. [merge] Merge spectra sharing a precursor identity within this RT window into ONE spectrum by UNION of peaks; matching peaks take the MAX intensity by default (merge:sum_intensity sums instead). This is not consolidate: consolidate SELECTS the richest member and DISCARDS the rest (measured -12.7% peptides), while 41% of peaks are present in only one member. Measured MS1 FWHM is 3.61 s (2.61 cycles) and flat across the gradient, so ~3.6 s is one peak width -- the principled window. 0 = off.", false);
   806	    registerDoubleOption_("merge:mass_ppm", "<ppm>", 20.0, "[merge] Precursor m/z tolerance for deciding two spectra share an identity.", false, true);
   807	    registerDoubleOption_("merge:delta_im", "<1/K0>", 0.02, "[merge] Precursor ion-mobility tolerance.", false, true);
   808	    registerDoubleOption_("merge:mz_tol", "<Da>", 0.01, "[merge] Peak m/z tolerance when summing the union. Peaks within this of the running intensity-weighted centroid are combined.", false, true);
   809	    registerDoubleOption_("merge:min_cosine", "<x>", 0.0, "[merge] Require this normalised dot product between two spectra before merging them. Coordinate proximity is NOT the problem (the coordinate gate already admits only 1.8% different-peptide pairs); the problem is that only ~8% of emitted spectra identify at all, so a coordinate gate merges good spectra with unidentifiable ones whose peaks dilute the match. Measured reference: within-cycle pairs 0.845, same peptide across cycles 0.687, unrelated 0.007. 0 = off.", false);
   810	    registerFlag_("merge:sum_intensity", "[merge] Sum intensities of matching peaks instead of taking the MAX. Summing distorts the merged spectrum: members share only ~37% of peaks (Jaccard 0.374), so shared peaks get Nx and unique peaks 1x, wrecking the fragment intensity ratios the engine scores on. MAX takes each ion's best single observation. Off (i.e. MAX) by default.");
   811	    registerFlag_("merge:any_charge", "[merge] Also merge spectra whose precursor charges disagree. Off by default: 93.2% of split pairs already agree in charge, so merging across charges mostly pools genuinely different precursors.");
   812	    registerDoubleOption_("consolidate:delta_rt", "<sec>", 0.0, "FALSIFIED on dataset D (-12.7% peptides at 5 s; every merge/collapse variant lost) -- keep 0 = OFF. Consolidate spectra whose precursors agree within this RT window (and mass_ppm/delta_im) into ONE feature, keeping the richest spectrum. Attacks emission multiplicity (ours 4.6 PSMs/peptide vs the reference implementation 1.46) without changing fragment content.", false);
   813	    registerDoubleOption_("consolidate:mass_ppm", "<ppm>", 20.0, "Precursor m/z tolerance for feature consolidation.", false, true);
   814	    registerDoubleOption_("consolidate:delta_im", "<1/K0>", 0.02, "Precursor IM tolerance for feature consolidation. Set larger than the 12 m/z x 2 IM sub-range split to merge a feature emitted from BOTH IM sub-ranges.", false, true);
   815	    registerFlag_("consolidate:same_charge_only", "Only merge spectra that also agree in charge (safer; leaves genuine multi-charge observations intact).");
   816	
   817	    registerFlag_("perf:stream_load", "[stream] Read the .d frame-by-frame via BrukerTimsFile::loadDIAStreaming, peak-picking and compacting each frame on arrival, instead of loadExperiment() which holds the entire run (MEASURED 90.3 GB RSS at t=0s - that one-shot read IS the memory floor and no downstream compaction can lower it). Bruker .d only.");
   818	    registerIntOption_("trace:native_ms2_neighbors", "<n>", 0, "[stream] NATIVE cross-frame aggregation in the READER (BrukerTimsFile Config dia_ms2_n_neighbors): adjacent frames each side, 0=off, 1=3-frame sum, 2=5-frame sum. This sums RAW frames BEFORE centroiding, which is what the reference implementation does; the tool-level frame_aggregation_n sums AFTER centroiding and lost 26% of peptides. Requires perf:stream_load.", false);
   819	    registerIntOption_("trace:native_ms1_neighbors", "<n>", 0, "[stream] Same, for MS1 frames (BrukerTimsFile Config ms1_n_neighbors). Requires perf:stream_load.", false);
   820	
   821	    registerTOPPSubsection_("perf", "Concurrency / memory tradeoff");
   822	    registerStringOption_("gate:coelution", "<mode>", "pearson", "[B0] Fragment-precursor co-elution statistic. 'pearson' takes variance over the FULL RT grid, so a fragment present in a handful of points is scored against ~1300 implicit zeros -- it rewards sparse fragments that spike where the precursor spikes, and its scale depends on grid size rather than evidence. 'logoverlap' is the AlphaDIA-style alternative: profile overlap in log space, summed only where the precursor has signal, normalised to [0,1]. The two are on DIFFERENT SCALES, so gate:min_correlation must be retuned when switching.", false);
   823	    setValidStrings_("gate:coelution", {"pearson", "logoverlap"});
   824	    registerFlag_("gate:variance_support", "[Q1] Compute the Pearson co-elution variance over the UNION SUPPORT of the precursor and fragment profiles (points where either is non-zero) rather than the full RT grid G (~1300). Fixes the [B0] zero-padding: a fragment present in a handful of grid points is no longer scored against ~1300 implicit zeros, and the score no longer depends on grid size. Only affects gate:coelution=pearson. Retune gate:min_correlation when enabling -- the score scale changes. [bench]");
   825	    registerIntOption_("perf:ms1_trace_bands", "<n>", 12, "[parallel] Band-parallel MS1 mass-trace detection, same exact-partition scheme as perf:trace_bands. MS1 tracing was running SINGLE-THREADED (the call simply never passed a band count) while MS2 was banded, so the MS1 phase pinned one core. That is invisible at default thresholds because MS1 is only ~4% of frames, but it makes the MS1 SENSITIVITY sweep impossible: lowering trace:noise_threshold_int / ms1_chrom_peak_snr explodes MassTraceDetection's intensity-sorted apex list, and MassTraceDetection is a SERIAL greedy loop, so runtime blows up superlinearly on one core (measured: 40 min with no progress at 1.5 of 128 cores, vs 24 min for a whole default run). 1 = off (old behaviour).", false);
   826	    registerIntOption_("perf:trace_bands", "<n>", 12, "[parallel] Split each window's fragment m/z range into N bands traced CONCURRENTLY. The diaPASEF method fixes the window count (24 here), which caps window-level parallelism far below the core count; banding lifts the ceiling to threads. Traces cannot span more than trace:mass_error_ppm in m/z, so banding with a halo is exact. 0 = auto (windows x bands >= threads), 1 = off.", false);
   827	    registerDoubleOption_("perf:mem_fraction", "<f>", 0.75, "[dyn-mem] Fraction of currently-FREE RAM (/proc/meminfo MemAvailable + our own RSS) the window loop may commit. Concurrency is re-decided at every window admission, so the run adapts to other jobs on a shared node. One window is always admitted regardless, so a single oversized window cannot deadlock.", false);
   828	    registerIntOption_("perf:max_concurrent_windows", "<n>", 0, "UPPER bound on isolation windows processed concurrently (memory admission may run fewer). Peak RAM scales with windows IN FLIGHT (each holds its frames + traces + grid), not with the total window count, so lowering this trades wall time for RAM. 0 = unlimited (use all threads).", false);
   829	
   830	    registerTOPPSubsection_("diag", "Diagnostics ('debug' is reserved by TOPP)");
   831	    registerStringOption_("diag:dump_ms1_tsv", "<prefix>", "", "[ms1-funnel] Write MS1 traces and inferred precursors to <prefix>.traces.tsv / <prefix>.precursors.tsv so precursor loss can be attributed to a stage (no trace / no hypothesis / no spectrum) rather than inferred from the final count. Empty = off.", false, true);
   832	
   833	    registerIntOption_("max_charge", "<n>", 5, "Maximum precursor charge considered during isotope inference.", false);
   834	    // NOTE: the subsection MUST be registered or printUsage_() throws ElementNotFound — which turns
   835	    // any user parameter typo into a FATAL crash instead of a usage message. [bugfix]
   836	    registerTOPPSubsection_("charge", "Isotope / charge-state inference");
   837	    registerIntOption_("charge:min_charge", "<n>", 2, "Minimum precursor charge to EMIT. DEFAULT 2: singly-charged hypotheses "
   838	                       "are 29.3%% of emission on dataset D and 1.73%% of peptides -- a z=1 pseudo-spectrum is identified on 0.42%% of "
   839	                       "its own spectra against 15.3%% for z=2. Tryptic peptides are essentially never 1+ in ESI and "
   840	                       "charge:scoring breaks ties toward the LOW charge, so the mis-assignments land there. Dropping them GAINS "
   841	                       "peptides on both engines on all three files (Sage +0.8/+2.7/+1.4%%, MSFragger +1.2/+5.4/+0.9%%) because "
   842	                       "their share of the multiple-testing burden goes too, and cuts runtime 17%%. Set 1 to emit them again; "
   843	                       "3+ is catastrophic (charge 2 carries 56.9%% of peptides).", false);
   844	    // [route-1] Only 25.7%% of the reference implementation's precursors are matched by us with the RIGHT m/z AND charge;
   845	    // 17.2%% have the wrong charge and 22.9%% (decoy-corrected) the wrong monoisotope. A wrong charge or
   846	    // mono gives a wrong NEUTRAL MASS, so the peptide can never be identified no matter how good the
   847	    // fragments are. Partner-COUNTING cannot tell a real envelope from a coincidence; averagine shape
   848	    // x isotope co-elution can.
   849	    registerStringOption_("charge:scoring", "<mode>", "count", "Charge/monoisotope inference. 'count' is the partner-count heuristic (ties favour LOW charge, break-on-first-miss) and is the DEFAULT: measured against a DIA-NN reference on dataset B it gives 71.8% charge agreement vs 49.7% for 'envelope', and it eliminates the catastrophic 4->2 confusion (10,199 cases) that fabricates a ~-1198 Da phantom modification at m/z 600 in open search. 'envelope' scores each (charge, mono) hypothesis by averagine cosine x isotope co-elution and allows gapped envelopes; it was the default until 2026-07-21 and is kept for comparison. NOTE both are close to trivial: always answering z=2 scores 69.6%.", false);
   850	    setValidStrings_("charge:scoring", {"envelope", "count"});
   851	    registerDoubleOption_("charge:ambiguity_margin", "<x>", 0.0, "[route-3] If a different-charge hypothesis scores within this margin of the best, emit it too (the reference implementation retains multiple charges when ambiguous). 0 = single charge per precursor.", false);
   852	    registerFlag_("assembly:dedup_precursors", "[route-4] Collapse precursor hypotheses that are the same species (same charge, m/z within ppm, co-eluting RT, co-located IM). Measured redundancy: 4.6 identified spectra per unique peptide vs the reference implementation's 1.46.");
   853	    registerFlag_("assembly:require_isotope_support", "[emission] Drop precursor hypotheses with NO isotope partner (the 'guessed' singletons, ~40% of emission) instead of assigning them a default charge. Emission is over-GENERATION of distinct low-quality precursors, not redundancy, so merge/dedup cannot cut it (oracle: same-coordinate collapse only 1.1-1.3x); this gate can. Measured on dataset D (2026-07-26): drops 603,858 of 1,528,113 spectra (-39.5%) for 78 of 10,036 peptides (-0.78%) -- guessed spectra identify at 1.30%% vs 11.39%% for supported (8.8x). The 0.78%% are low-abundance/no-envelope species (the open-search caveat), so keep this OFF by default and confirm FDR-recalibrated peptides on any run that enables it.");
   854	    registerDoubleOption_("charge:mono_averagine_guard", "<slack>", 0.0, "[mono-guard] Reject a leftward isotope step (the walk that defines the MONOISOTOPE in charge:scoring=count) when the candidate peak is too weak to be a real lighter isotope under averagine. The partner search matches m/z, RT and IM but NEVER intensity, so it can latch onto a noise peak or a co-eluting species one isotope spacing below the true monoisotope -- making the reported precursor mass ~1.00335 Da TOO LIGHT. Closed search hides this (the engine enumerates isotope_errors and corrects it for free); OPEN/blind search turns it into a phantom -1.003 Da modification, and it is our single largest open-search delta-mass artefact on dataset D (8.20%% isotope-shifted PSMs vs the reference implementation's 3.46%%). The bound is averagine's LOOSEST: stepping from isotope m+1 to m the lighter peak is >= (m+1)/lambda times the heavier one, minimised at m=0 -> 1/lambda (lambda = 0.000594*neutral mass), so a value of 1.0 enforces exactly that minimum and never rejects a legitimate envelope; smaller values add slack for noise. 0 = off (old behaviour). [bench]", false);
   855	    registerFlag_("charge:mono_averagine_select", "[mono-select] Choose the MONOISOTOPE by averagine envelope fit over the whole isotope run found by the charge:scoring=count walk, instead of taking the furthest-left peak reached. 'Furthest-left' is a STOPPING rule and can only trade over-reach (mono ~1.003 Da too LIGHT, a phantom -1 Da modification in open search) for under-reach (+1.003 Da) -- measured: an averagine STOPPING guard cut the -1 artefact 64%% but tripled +1, because a walk that halts early also leaves the M+1 peak unconsumed so it seeds its own too-heavy precursor. This is a SCORING decision instead: score every candidate mono position in the run by cosine against the averagine envelope and keep the best. Every found peak is still consumed, so de-isotoping and emission are unchanged -- only the reported precursor mass moves. [bench]");
   856	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). A reviewer argued 0.01 (isotopes of one species share mobility, so 0.05 can admit cross-species partners), but 0.01 has NOT been measured on dataset D; change only behind the dataset D set gate.", false);
   857	    // ponytail: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
   858	  }
   859	
   860	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
   861	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
   862	  ///   peak_int > chrom_peak_snr * noise_threshold_int
   863	  /// so the EFFECTIVE apex threshold is snr*noise, while trace MEMBERSHIP only needs > noise.
   864	  /// Leaving snr at the OpenMS default 3.0 silently triples the fragment apex threshold.
   865	  /// the reference implementation deliberately runs MS2 with "more relaxed constraints" than MS1 (Nat Commun 16:95
   866	  /// Methods) — so MS1 and MS2 get INDEPENDENT snr / min-length here. [recall]
   867	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
   868	  /// it is dead from that point on, but at ~20 B/peak (Peak1D 16 + IM float 4) it is ~1.1 GB per
   869	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
   870	  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
   871	                              double snr, double min_len, double min_sample_rate, double max_len,
   872	                              double split_valleys, String* span_log = nullptr, int bands = 1)
   873	  {
   874	    MassTraceDetection mtd;
   875	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
   876	    Param p = mtd.getParameters();
   877	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
   878	    p.setValue("noise_threshold_int", noise);
   879	    p.setValue("chrom_peak_snr", snr);
   880	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
   881	    p.setValue("min_trace_length", min_len);
   882	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
   883	    // trace extension when occupancy drops below it — an intensity-INDEPENDENT deletion of gappy but
   884	    // real fragment traces in sparse diaPASEF data. Relaxing it for MS2 is the sole surviving MS2
   885	    // trace-validity lever. [recall]
   886	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
   887	    if (max_len > 0.0) p.setValue("max_trace_length", max_len);
   888	    mtd.setParameters(p);
   889	
   890	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
   891	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
   892	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
   893	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
   894	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
   895	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
   896	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
   897	      ElutionPeakDetection epd;
   898	      epd.setLogType(ProgressLogger::NONE);
   899	      Param ep = epd.getParameters();
   900	      ep.setValue("chrom_fwhm", split_valleys);
   901	      ep.setValue("width_filtering", "off");
   902	      ep.setValue("masstrace_snr_filtering", "false");
   903	      epd.setParameters(ep);
   904	      vector<MassTrace> out; out.reserve(in.size());
   905	      epd.detectPeaks(in, out);
   906	      return out;
   907	    };
   908	
   909	    vector<MassTrace> mts;
   910	    if (bands > 1)
   911	    {
   912	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
   913	      // windows caps us at 24 threads however many cores exist. Fragment traces at
   914	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
   915	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
   916	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
   917	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
   918	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
   919	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
   920	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
   921	      vector<double> sample;
   922	      for (const auto& s : map)
   923	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
   924	      sort(sample.begin(), sample.end());
   925	      vector<double> edge(bands + 1);
   926	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
   927	      else
   928	        for (int b = 0; b <= bands; ++b)
   929	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
   930	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
   931	      vector<double> ().swap(sample);
   932	
   933	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
   934	      // then release the source map so the halo duplicates are the only overhead.
   935	      vector<PeakMap> sub(bands);
   936	      for (const auto& s : map)
   937	      {
   938	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
   939	        for (int b = 0; b < bands; ++b)
   940	        {
   941	          const double h = edge[b] * ppm * 1e-6 * 20.0;
   942	          const double lo = edge[b] - h, hi = edge[b + 1] + h;
   943	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
   944	          OpenMS::DataArrays::FloatDataArray ia;
   945	          ia.setName(Constants::UserParam::ION_MOBILITY);
   946	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
   947	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
   948	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
   949	          Size i0 = 0, i1 = s.size();
   950	          if (s.isSorted())
   951	          {
   952	            i0 = (Size)(s.MZBegin(lo) - s.begin());
   953	            i1 = (Size)(s.MZBegin(hi) - s.begin());
   954	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
   955	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
   956	          }
   957	          else
   958	            for (Size i = 0; i < s.size(); ++i)
   959	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
   960	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
   961	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); sub[b].addSpectrum(std::move(t)); }
   962	        }
   963	      }
   964	      map.clear(true);
   965	      vector<vector<MassTrace>> per(bands);
   966	      #pragma omp parallel for schedule(dynamic) num_threads(bands)
   967	      for (int b = 0; b < bands; ++b)
   968	      {
   969	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
   970	        vector<MassTrace> t;
   971	        sub[b].sortSpectra();
   972	        m2.run(sub[b], t);
   973	        sub[b].clear(true);
   974	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
   975	        for (auto& mt : t)
   976	        {
   977	          const double c = mt.getCentroidMZ();
   978	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
   979	        }
   980	      }
   981	      size_t tot = 0; for (const auto& v : per) tot += v.size();
   982	      mts.reserve(tot);
   983	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
   984	    }
   985	    else
   986	    {
   987	      mtd.run(map, mts);
   988	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
   989	    }
   990	
   991	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
   992	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
   993	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
   994	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
   995	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
   996	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
   997	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
   998	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off dataset D 20:46 vs 28:40 for
   999	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1000	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1001	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1002	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1003	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1004	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1005	    // determinism bug, now fixed.
  1006	    if (split_valleys > 0.0 && mts.size() > 1)
  1007	    {
  1008	      const int nthreads = std::max(1, bands);
  1009	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1010	      const size_t n_in = mts.size();
  1011	      vector<vector<MassTrace>> parts(nchunk);
  1012	      #pragma omp parallel for schedule(dynamic) num_threads(nthreads)
  1013	      for (int ci = 0; ci < nchunk; ++ci)
  1014	      {
  1015	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1016	        if (lo >= hi) continue;
  1017	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1018	                                std::make_move_iterator(mts.begin() + hi));
  1019	        parts[ci] = do_split(chunk);
  1020	      }
  1021	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1022	      vector<MassTrace> out; out.reserve(tot);
  1023	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1024	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1025	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1026	      mts.swap(out);
  1027	    }
  1028	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1029	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1030	    if (!mts.empty())
  1031	    {
  1032	      vector<double> spans;
  1033	      spans.reserve(mts.size());
  1034	      for (const auto& mt : mts)
  1035	      {
  1036	        double lo = 1e30, hi = -1e30;
  1037	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1038	        spans.push_back(hi - lo);
  1039	      }
  1040	      sort(spans.begin(), spans.end());
  1041	      size_t n = spans.size();
  1042	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1043	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1044	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1045	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1046	    }
  1047	    vector<Trace> out;
  1048	    out.reserve(mts.size());
  1049	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1050	    return out;
  1051	  }
  1052	
  1053	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1054	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1055	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1056	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1057	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1058	  {
  1059	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1060	    out.assign(n, 0.0);
  1061	    double term = 1.0;
  1062	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1063	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1064	    if (mx > 0) for (double& v : out) v /= mx;
  1065	  }
  1066	
  1067	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1068	  {
  1069	    double dot = 0, na = 0, nb = 0;
  1070	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1071	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1072	  }
  1073	
  1074	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1075	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1076	  /// coincidental peak at the right m/z spacing usually does not.
  1077	  static double xicCorr(const vector<pair<double,double>>& a, const vector<pair<double,double>>& b, double rt_tol)
  1078	  {
  1079	    vector<double> x, y;
  1080	    size_t i = 0, j = 0;
  1081	    while (i < a.size() && j < b.size())
  1082	    {
  1083	      double d = a[i].first - b[j].first;
  1084	      if (fabs(d) <= rt_tol) { x.push_back(a[i].second); y.push_back(b[j].second); ++i; ++j; }
  1085	      else if (d < 0) ++i; else ++j;
  1086	    }
  1087	    const size_t n = x.size();
  1088	    if (n < 5) return 0.0;  // [adv-fix] n=3 gives P(r>0.9)~14.4% under the null
  1089	    double mx = 0, my = 0;
  1090	    for (size_t k = 0; k < n; ++k) { mx += x[k]; my += y[k]; }
  1091	    mx /= n; my /= n;
  1092	    double num = 0, sx = 0, sy = 0;
  1093	    for (size_t k = 0; k < n; ++k) { double dx = x[k]-mx, dy = y[k]-my; num += dx*dy; sx += dx*dx; sy += dy*dy; }
  1094	    return (sx > 0 && sy > 0) ? num / sqrt(sx*sy) : 0.0;
  1095	  }
  1096	
  1097	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1098	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1099	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, int max_charge,
  1100	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1101	                                      bool envelope_scoring, double ambig_margin)
  1102	  {
  1103	    const double ISO = 1.0033548;
  1104	    const double PROTON_ = 1.00727646;
  1105	    const size_t N = ms1.size();
  1105	    const size_t N = ms1.size();
  1106	
  1107	    // m/z-sorted index for O(log N) isotope-partner lookup (avoids O(N^2) over all MS1 traces). [H-8]
  1108	    vector<size_t> by_mz(N);
  1109	    for (size_t i = 0; i < N; ++i) by_mz[i] = i;
  1110	    sort(by_mz.begin(), by_mz.end(), [&](size_t a, size_t b) { return ms1[a].mz < ms1[b].mz; });
  1111	    vector<double> sorted_mz(N);
  1112	    for (size_t i = 0; i < N; ++i) sorted_mz[i] = ms1[by_mz[i]].mz;
  1113	
  1114	    vector<size_t> order(N);
  1115	    for (size_t i = 0; i < N; ++i) order[i] = i;
  1116	    sort(order.begin(), order.end(), [&](size_t a, size_t b) {
  1117	      if (ms1[a].intensity != ms1[b].intensity) return ms1[a].intensity > ms1[b].intensity;
  1118	      if (ms1[a].mz != ms1[b].mz) return ms1[a].mz < ms1[b].mz;
  1119	      return a < b; // total order so greedy isotope assignment is deterministic [code-review]
  1120	    });
  1121	
  1122	    vector<bool> used(N, false);
  1123	    vector<Precursor_> out;
  1124	    for (size_t seed : order)
  1125	    {
  1126	      if (used[seed]) continue;
  1127	      const Trace& s = ms1[seed];
  1128	      const double tol = s.mz * mass_ppm * 1e-6;
  1129	
  1130	      // Find an unused isotope partner near `target` m/z, co-localized in RT and IM (binary-search
  1131	      // the m/z index, scan only the ppm-window candidates); -1 if none. [H-8]
  1132	      auto findPartner = [&](double target) -> long {
  1133	        size_t klo = lower_bound(sorted_mz.begin(), sorted_mz.end(), target - tol) - sorted_mz.begin();
  1134	        size_t khi = upper_bound(sorted_mz.begin(), sorted_mz.end(), target + tol) - sorted_mz.begin();
  1135	        for (size_t k = klo; k < khi; ++k)
  1136	        {
  1137	          size_t j = by_mz[k];
  1138	          if (used[j] || j == seed) continue;
  1139	          if (fabs(ms1[j].rt - s.rt) <= delta_rt && fabs(ms1[j].im - s.im) <= iso_im_tol)
  1140	            return (long)j;
  1141	        }
  1142	        return -1;
  1143	      };
  1144	
  1145	      // [baseline-fix v2] When envelope scoring is OFF, run the ORIGINAL algorithm end-to-end, not
  1146	      // just the original scoring. The previous attempt reverted only the score while keeping the new
  1147	      // candidate generation (gapped walk + lead 0..3), producing a THIRD algorithm: 2.52M MS1 traces
  1148	      // -> 1.21M precursors, 967,956 spectra, 7,308 peptides (baseline: 1.76M -> 956k, 741k, 9,103).
  1149	      // The original is: contiguous walk with BREAK-ON-FIRST-MISS, seed is always the starting point
  1150	      // (no lead offsets), monoisotope = furthest-LEFT partner reached, pick z by partner COUNT with
  1151	      // ties favouring the LOWEST z.
  1152	      if (!envelope_scoring)
  1153	      {
  1154	        int best_z = 0, best_n = 1;
  1155	        double best_mono = s.mz;
  1156	        vector<size_t> best_partners;
  1157	        for (int z = 1; z <= max_charge; ++z)
  1158	        {
  1159	          vector<size_t> partners;
  1160	          double mono = s.mz;
  1161	          double prev_int = s.intensity;
  1162	          vector<long> lefts;
  1163	          for (int k = 1; k <= 5; ++k)          // lighter partners define the monoisotope
  1164	          {
  1165	            long j = findPartner(s.mz - k * ISO / z);
  1166	            if (j < 0) break;                   // BREAK on first miss (contiguous only)
  1167	            // [mono-guard] A LEFTWARD step asserts the new peak is a LIGHTER ISOTOPE of the same
  1168	            // peptide, but findPartner only checks m/z, RT and IM -- never intensity. So the walk
  1169	            // happily latches onto a noise peak or a co-eluting species' peak that happens to sit
  1170	            // one isotope spacing below, and the monoisotope ends up one isotope TOO LIGHT.
  1171	            // Closed search hides this (the engine enumerates isotope_errors [-1,2] and corrects it
  1172	            // for free); OPEN search cannot, so it becomes a phantom -1.003 Da "modification" --
  1173	            // measured as our single largest open-search delta-mass artefact on dataset D.
  1174	            // Averagine bounds how weak a genuine lighter isotope may be: stepping from isotope m+1
  1175	            // to m, theo[m]/theo[m+1] = (m+1)/lambda, minimised at m=0 -> 1/lambda. Requiring the
  1176	            // candidate to reach that (times a slack factor) rejects the latch without touching a
  1177	            // real envelope.
  1178	            if (mono_guard_ > 0.0)
  1179	            {
  1180	              const double neutral = (s.mz - k * ISO / z) * z - z * PROTON_;
  1181	              const double lam = std::max(0.10, 0.000594 * neutral);
  1182	              if (ms1[j].intensity < mono_guard_ * prev_int / lam) break;
  1183	            }
  1184	            lefts.push_back(j);
  1185	            partners.push_back((size_t)j); mono = ms1[j].mz; prev_int = ms1[j].intensity;
  1186	          }
  1187	          vector<long> rights;
  1188	          for (int k = 1; k <= 5; ++k)          // heavier partners add confidence
  1189	          {
  1190	            long j = findPartner(s.mz + k * ISO / z);
  1191	            if (j < 0) break;
  1192	            rights.push_back(j);
  1193	            partners.push_back((size_t)j);
  1194	          }
  1195	          // [mono-select] Choosing the monoisotope by "furthest-left peak reached" is a STOPPING
  1196	          // rule, and a stopping rule can only trade over-reach (-1.003 Da) for under-reach (+1.003
  1197	          // Da) -- measured: the guard above cut the -1 artefact 64% but tripled +1, because a walk
  1198	          // that stops early also leaves the M+1 peak unconsumed, so it later seeds its OWN
  1199	          // precursor one isotope too heavy. Make it a SCORING decision instead: walk the full run,
  1200	          // then pick which peak IS the monoisotope by averagine fit of the envelope starting
  1201	          // there. Corrects both directions, and every found peak is still marked used below, so
  1202	          // de-isotoping and emission are untouched (only the reported mono m/z changes).
  1203	          if (mono_select_ && !lefts.empty())
  1204	          {
  1205	            const int nL = (int)lefts.size();
  1206	            vector<double> runI;                                  // ascending m/z: lefts, seed, rights
  1207	            for (int i = nL - 1; i >= 0; --i) runI.push_back(ms1[lefts[i]].intensity);
  1208	            runI.push_back(s.intensity);
  1209	            for (long j : rights) runI.push_back(ms1[j].intensity);
  1210	            double best_cos = -1.0; int best_c = nL;              // default: seed is the mono
  1211	            vector<double> theo, obs;
  1212	            for (int c = 0; c <= nL; ++c)                         // mono cannot be right of the seed
  1213	            {
  1214	              const int len = std::min(4, (int)runI.size() - c);
  1215	              if (len < 2) break;                                 // need >=2 peaks to score a shape
  1216	              const double neutral = (s.mz - (double)(nL - c) * ISO / z) * z - z * PROTON_;
  1217	              averagineRatios(neutral, len, theo);
  1218	              obs.assign(runI.begin() + c, runI.begin() + c + len);
  1219	              double mx = 0.0; for (double v : obs) mx = std::max(mx, v);
  1220	              if (mx <= 0.0) continue;
  1221	              for (double& v : obs) v /= mx;
  1222	              // [adv-fix] The SAME trap the envelope scorer documents below: the cosine of a short
  1223	              // vector is nearly always high, and `len` SHRINKS as the candidate mono moves right,
  1224	              // so raw cosine systematically prefers a too-HEAVY mono. Measured (first cut, raw
  1225	              // cosine): -1 bin 7,616 -> 2,314 as intended, but +1 exploded 4,697 -> 21,591 and the
  1226	              // unmodified fraction fell 31.2% -> 26.4%, at flat emission -- i.e. precursors that
  1227	              // were CORRECT were pushed one isotope right. Weight by evidence exactly as the
  1228	              // envelope scorer does: (n-1)/3 capped at 1 (4 isotopes 1.00, 3 -> 0.67, 2 -> 0.33).
  1229	              const double cs = cosineSim(obs, theo) * std::min(1.0, (double)(len - 1) / 3.0);
  1230	              if (cs > best_cos) { best_cos = cs; best_c = c; }
  1231	            }
  1232	            mono = (best_c < nL) ? ms1[lefts[nL - 1 - best_c]].mz : s.mz;
  1233	          }
  1234	          const int n = 1 + (int)partners.size();
  1235	          if (n > best_n) { best_n = n; best_z = z; best_mono = mono; best_partners = partners; }
  1236	        }
  1237	        Precursor_ pc0;
  1238	        pc0.trace_idx = seed;
  1239	        pc0.rt = s.rt; pc0.im = s.im;
  1240	        pc0.mono_mz = best_mono;
  1241	        pc0.charge = best_z;                    // 0 => unknown, default_charge applied later
  1242	        pc0.n_isotopes = best_n;                // [Q4] envelope confidence for the mono call
  1243	        out.push_back(pc0);
  1244	        used[seed] = true;
  1245	        for (size_t j : best_partners) used[j] = true;   // de-isotope
  1246	        continue;
  1247	      }
  1248	
  1249	      struct Hyp { int z; double mono; double score; vector<size_t> partners; };
  1250	      vector<Hyp> hyps;
  1251	      vector<double> theo, obs(4), obsn(4);
  1252	
  1253	      for (int z = 1; z <= max_charge; ++z)
  1254	      {
  1255	        // [route-1] GAPPED envelopes: no break-on-first-miss (a sub-threshold M+1 with a present
  1256	        // M+2 previously killed the whole walk). Try the seed AND up to 3 isotopes below it as the
  1257	        // monoisotope candidate; averagine decides which one really is the mono.
  1258	        for (int lead = 0; lead <= 3; ++lead)
  1259	        {
  1260	          const double mono_mz = s.mz - lead * ISO / z;
  1261	          long mono_idx = (lead == 0) ? (long)seed : findPartner(mono_mz);
  1262	          if (lead > 0 && mono_idx < 0) continue;
  1263	          const double neutral = mono_mz * z - z * PROTON_;
  1264	          if (neutral < 400.0 || neutral > 6000.0) continue;
  1265	
  1266	          vector<size_t> members;
  1267	          vector<long> iso_idx(4, -1);
  1268	          obs.assign(4, 0.0);
  1269	          obs[0] = ms1[mono_idx].intensity;
  1270	          iso_idx[0] = mono_idx;
  1271	          if ((size_t)mono_idx != seed) members.push_back((size_t)mono_idx);
  1272	          int found = 1;
  1273	          for (int k = 1; k <= 3; ++k)
  1274	          {
  1275	            long j = findPartner(mono_mz + k * ISO / z);
  1276	            if (j >= 0) { obs[k] = ms1[j].intensity; iso_idx[k] = j; ++found;
  1277	                          if ((size_t)j != seed) members.push_back((size_t)j); }
  1278	          }
  1279	          if (found < 2) continue;   // need >=2 isotopes before a shape can be scored
  1280	
  1281	          averagineRatios(neutral, 4, theo);
  1282	          double mx = 0.0; for (double v : obs) mx = std::max(mx, v);
  1283	          if (mx <= 0) continue;
  1284	          for (int k = 0; k < 4; ++k) obsn[k] = obs[k] / mx;
  1285	          const double cos_sim = cosineSim(obsn, theo);
  1286	
  1287	          double csum = 0.0; int cn = 0;
  1288	          for (int k = 1; k <= 3; ++k)
  1289	            if (iso_idx[k] >= 0) { csum += xicCorr(ms1[iso_idx[0]].xic, ms1[iso_idx[k]].xic, delta_rt); ++cn; }
  1290	          const double mean_corr = cn ? std::max(0.0, csum / cn) : 0.0;
  1291	
  1292	          // Composite: shape AND co-elution must BOTH hold, WEIGHTED BY EVIDENCE.
  1293	          // [adv-fix] The naive product cos*corr + 0.01*n is statistically indefensible: a 2-isotope
  1294	          // hypothesis (cos 0.99 x corr 0.95 = 0.9605) BEATS 4 genuine isotopes (0.95 x 0.85 = 0.8475),
  1295	          // because the cosine of a 2-vector is nearly always high and the +0.01*n bonus (0.02 between
  1296	          // 2 and 4 isotopes) sits far below correlation noise. That biases us toward exactly the
  1297	          // sparse, weakly-supported envelopes we are trying to eliminate.
  1298	          // Fix: multiply by an evidence weight (n-1)/3 capped at 1 => 4 isotopes 1.00, 3 -> 0.67,
  1299	          // 2 -> 0.33. The counterexample now scores 0.808 vs 0.313 - correctly ordered.
  1300	          const double evidence = std::min(1.0, (found - 1) / 3.0);
  1301	          hyps.push_back({z, mono_mz, cos_sim * mean_corr * evidence, members});
  1302	        }
  1303	      }
  1304	
  1305	      Precursor_ pc;
  1306	      pc.trace_idx = seed;
  1307	      pc.rt = s.rt; pc.im = s.im;
  1308	
  1309	      if (hyps.empty())
  1310	      {
  1311	        pc.mono_mz = s.mz; pc.charge = 0;   // no envelope evidence at all -> unknown charge
  1312	        out.push_back(pc);
  1313	        used[seed] = true;
  1314	        continue;
  1315	      }
  1316	
  1317	      // [baseline-fix] When envelope scoring is OFF we must still DE-ISOTOPE, otherwise every isotope
  1318	      // peak seeds its own precursor and the spectrum count explodes (measured: 741k -> 1,209,295
  1319	      // spectra, 9,103 -> 7,830 peptides). The off-branch therefore falls back to the ORIGINAL
  1320	      // partner-COUNT criterion with the original low-z tie-break, and still marks members used.
  1321	      if (!envelope_scoring)
  1322	      {
  1323	        for (auto& h : hyps) h.score = (double)h.partners.size();  // count, not shape
  1324	        sort(hyps.begin(), hyps.end(), [](const Hyp& a, const Hyp& b) {
  1325	          if (a.score != b.score) return a.score > b.score;
  1326	          if (a.z != b.z) return a.z < b.z;                        // original: ties favour LOW z
  1327	          return a.mono < b.mono;
  1328	        });
  1329	      }
  1330	      else
  1331	      sort(hyps.begin(), hyps.end(), [](const Hyp& a, const Hyp& b) {
  1332	        if (a.score != b.score) return a.score > b.score;
  1333	        if (a.z != b.z) return a.z > b.z;   // [route-1] ties now favour HIGHER z (old code favoured low z)
  1334	        return a.mono < b.mono;
  1335	      });
  1336	      const Hyp& best = hyps[0];
  1337	      pc.mono_mz = best.mono; pc.charge = best.z;
  1338	      pc.n_isotopes = 1 + (int)best.partners.size();   // [Q4] envelope confidence for the mono call
  1339	      out.push_back(pc);
  1340	      used[seed] = true;
  1341	      for (size_t j : best.partners) used[j] = true;
  1342	
  1343	      // [route-3] Ambiguous charge -> retain a second hypothesis (the reference implementation: "when the charge state
  1344	      // cannot be confidently determined, multiple values are retained"). 0 disables.
  1345	      if (ambig_margin > 0.0)
  1346	      {
  1347	        for (size_t h = 1; h < hyps.size(); ++h)
  1348	        {
  1349	          if (hyps[h].z == best.z) continue;
  1350	          if (best.score - hyps[h].score > ambig_margin) break;
  1351	          Precursor_ alt = pc;
  1352	          alt.mono_mz = hyps[h].mono; alt.charge = hyps[h].z;
  1353	          alt.n_isotopes = 1 + (int)hyps[h].partners.size();   // [Q4]
  1354	          out.push_back(alt);
  1355	          break;                            // at most one alternative
  1356	        }
  1357	      }
  1358	    }
  1359	    return out;
  1360	  }
  1361	
  1362	  /// [route-4] Collapse precursor hypotheses that are the SAME species (same charge, m/z within ppm,
  1363	  /// co-eluting in RT, co-located in IM). Measured redundancy is 4.6 identified spectra per unique
  1364	  /// peptide vs the reference implementation's 1.46, so duplicates cost spectra, RAM and FDR budget without adding
  1365	  /// peptides. Keeps the most intense representative. Deterministic (total-order sort).
  1366	  static size_t dedupPrecursors_(vector<Precursor_>& pcs, const vector<Trace>& ms1,
  1367	                                 double mass_ppm, double rt_tol, double im_tol)
  1368	  {
  1369	    if (pcs.empty()) return 0;
  1370	    vector<size_t> idx(pcs.size());
  1371	    for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  1372	    sort(idx.begin(), idx.end(), [&](size_t a, size_t b) {
  1373	      if (pcs[a].charge != pcs[b].charge) return pcs[a].charge < pcs[b].charge;
  1374	      if (pcs[a].mono_mz != pcs[b].mono_mz) return pcs[a].mono_mz < pcs[b].mono_mz;
  1375	      if (pcs[a].rt != pcs[b].rt) return pcs[a].rt < pcs[b].rt;
  1376	      return a < b;
  1377	    });
  1378	    vector<bool> drop(pcs.size(), false);
  1379	    for (size_t a = 0; a < idx.size(); ++a)
  1380	    {
  1381	      size_t i = idx[a];
  1382	      if (drop[i]) continue;
  1383	      const double tol = pcs[i].mono_mz * mass_ppm * 1e-6;
  1384	      for (size_t b = a + 1; b < idx.size(); ++b)
  1385	      {
  1386	        size_t j = idx[b];
  1387	        if (pcs[j].charge != pcs[i].charge) break;
  1388	        if (pcs[j].mono_mz - pcs[i].mono_mz > tol) break;
  1389	        if (drop[j]) continue;
  1390	        if (fabs(pcs[j].rt - pcs[i].rt) <= rt_tol && fabs(pcs[j].im - pcs[i].im) <= im_tol)
  1391	        {
  1392	          if (ms1[pcs[j].trace_idx].intensity > ms1[pcs[i].trace_idx].intensity) { drop[i] = true; break; }
  1393	          drop[j] = true;
  1394	        }
  1395	      }
  1396	    }
  1397	    vector<Precursor_> keep;
  1398	    keep.reserve(pcs.size());
  1399	    size_t removed = 0;
  1400	    for (size_t i = 0; i < pcs.size(); ++i) { if (drop[i]) ++removed; else keep.push_back(pcs[i]); }
  1401	    pcs.swap(keep);
  1402	    return removed;
  1403	  }
