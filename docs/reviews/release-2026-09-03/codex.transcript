    60	namespace spx
    61	{
    62	  struct MzPeakWin { double lo, hi, im_lo, im_hi; };
    63	
    64	  /// Calibration provenance of the last mzPeak load (the archive's two-point tof transform, applied by the
    65	  /// library; NOT the TDF table model). Stamped into the output instead of BrukerTimsFile's state.
    66	  inline std::string& lastMzPeakCalibration() { static std::string s = "unset"; return s; }
    67	
    68	
    69	  /// Exact TOF->m/z for an ims-compact archive: (c0, c1) from the peaks table's column metadata, the
    70	  /// MzCalibration row and Frames.T1 from the embedded vendor tdf. Throws on anything missing (fail closed).
    71	  struct MzPeakExactMz
    72	  {
    73	    double c0 = 0, c1 = 0;
    74	    spextract::TdfMzCalibration cal;
    75	    std::vector<double> t1_by_frame;          // index = Frames.Id
    76	    bool enabled = false;
    77	
    78	    static std::vector<char> readMember_(zip_t* z, const char* name, zip_int64_t from = 0, zip_int64_t len = -1)
    79	    {
    80	      zip_int64_t idx = zip_name_locate(z, name, 0);
    81	      if (idx < 0) throw std::runtime_error(std::string("mzpeak: member missing: ") + name);
    82	      zip_stat_t st; zip_stat_index(z, (zip_uint64_t)idx, 0, &st);
    83	      if (len < 0) len = (zip_int64_t)st.size - from;
    84	      zip_file_t* f = zip_fopen_index(z, (zip_uint64_t)idx, 0);
    85	      if (!f) throw std::runtime_error(std::string("mzpeak: cannot open member ") + name);
    86	      if (from > 0 && zip_fseek(f, from, SEEK_SET) != 0) { zip_fclose(f); throw std::runtime_error(std::string("mzpeak: cannot seek in ") + name + " (member not stored?)"); }
    87	      std::vector<char> buf((size_t)len); zip_int64_t got = 0;
    88	      while (got < len) { zip_int64_t n = zip_fread(f, buf.data() + got, (zip_uint64_t)(len - got)); if (n <= 0) break; got += n; }
    89	      zip_fclose(f);
    90	      if (got != len) throw std::runtime_error(std::string("mzpeak: short read of ") + name);
    91	      return buf;
    92	    }
    93	
    94	    explicit MzPeakExactMz(const std::string& path)
    95	    {
    96	      int err = 0; zip_t* z = zip_open(path.c_str(), ZIP_RDONLY, &err);
    97	      if (!z) throw std::runtime_error("mzpeak: zip_open failed on " + path);
    98	      try
    99	      {
   100	        // (1) two-point transform params from the parquet footer of spectra_peaks.parquet (stored member)
   101	        zip_int64_t idx = zip_name_locate(z, "spectra_peaks.parquet", 0);
   102	        if (idx < 0) throw std::runtime_error("mzpeak: spectra_peaks.parquet missing");
   103	        zip_stat_t st; zip_stat_index(z, (zip_uint64_t)idx, 0, &st);
   104	        std::vector<char> tail = readMember_(z, "spectra_peaks.parquet", (zip_int64_t)st.size - 8, 8);
   105	        uint32_t flen; std::memcpy(&flen, tail.data(), 4);
   106	        if (std::string(tail.data() + 4, 4) != "PAR1") throw std::runtime_error("mzpeak: peaks member is not parquet");
   107	        std::vector<char> footer = readMember_(z, "spectra_peaks.parquet", (zip_int64_t)st.size - 8 - flen, flen);
   108	        uint32_t flen2 = flen;
   109	        std::shared_ptr<parquet::FileMetaData> md = parquet::FileMetaData::Make(footer.data(), &flen2);
   110	        std::shared_ptr<arrow::Schema> schema;
   111	        parquet::ArrowReaderProperties props;
   112	        PARQUET_THROW_NOT_OK(parquet::arrow::FromParquetSchema(md->schema(), props, md->key_value_metadata(), &schema));
   113	        auto point = schema->GetFieldByName("point");
   114	        if (!point) throw std::runtime_error("mzpeak: no 'point' column");
   115	        auto tof = std::dynamic_pointer_cast<arrow::StructType>(point->type())->GetFieldByName("tof");
   116	        if (!tof || !tof->metadata()) throw std::runtime_error("mzpeak: no tof column / metadata (not an ims-compact archive?)");
   117	        auto tp = tof->metadata()->Get("mzpeak:transform_params");
   118	        if (!tp.ok()) throw std::runtime_error("mzpeak: tof column has no mzpeak:transform_params");
   119	        if (std::sscanf(tp->c_str(), "%lf,%lf", &c0, &c1) != 2 || !(c1 > 0)) throw std::runtime_error("mzpeak: bad transform_params " + *tp);
   120	
   121	        // (2) the vendor tdf: gunzip vendor/analysis.tdf.gz to a temp file, read MzCalibration + Frames.T1
   122	        // --no-vendor archives have no embedded tdf: accept a sidecar via SPEXTRACT_MZPEAK_TDF=<analysis.tdf.gz>
   123	        std::vector<char> gz;
   124	        if (const char* side = std::getenv("SPEXTRACT_MZPEAK_TDF"))
   125	        {
   126	          FILE* sf = std::fopen(side, "rb"); if (!sf) throw std::runtime_error(std::string("mzpeak: cannot read SPEXTRACT_MZPEAK_TDF ") + side);
   127	          char b[1 << 16]; size_t n; while ((n = std::fread(b, 1, sizeof b, sf)) > 0) gz.insert(gz.end(), b, b + n); std::fclose(sf);
   128	        }
   129	        else gz = readMember_(z, "vendor/analysis.tdf.gz");
   130	        char tmpl[] = "/tmp/spx_mzpeak_tdf_XXXXXX"; int fd = mkstemp(tmpl); if (fd < 0) throw std::runtime_error("mzpeak: mkstemp");
   131	        close(fd);
   132	        { z_stream zs{}; inflateInit2(&zs, 16 + MAX_WBITS); FILE* out = std::fopen(tmpl, "wb");
   133	          zs.next_in = (Bytef*)gz.data(); zs.avail_in = (uInt)gz.size(); std::vector<char> ob(1 << 20); int rc;
   134	          do { zs.next_out = (Bytef*)ob.data(); zs.avail_out = (uInt)ob.size(); rc = inflate(&zs, Z_NO_FLUSH);
   135	               if (rc != Z_OK && rc != Z_STREAM_END) { std::fclose(out); inflateEnd(&zs); throw std::runtime_error("mzpeak: gunzip of analysis.tdf.gz failed"); }
   136	               std::fwrite(ob.data(), 1, ob.size() - zs.avail_out, out); } while (rc != Z_STREAM_END);
   137	          inflateEnd(&zs); std::fclose(out); }
   138	#ifndef SPX_HAVE_SQLITECPP
   139	        throw std::runtime_error("mzpeak exact m/z needs SQLiteCpp headers at build time (OpenMS extern); rebuild inside the OpenMS tree");
   140	#else
   141	        {
   142	          SQLite::Database db(std::string(tmpl), SQLite::OPEN_READONLY);
   143	          SQLite::Statement q(db, "SELECT ModelType, DigitizerTimebase, DigitizerDelay, C0, C1, C2, T1, dC1, dC2, C3, C4 FROM MzCalibration");
   144	          if (!q.executeStep()) throw std::runtime_error("mzpeak: no MzCalibration row in the embedded tdf");
   145	          cal.model_type = q.getColumn(0).getInt(); cal.digitizer_timebase = q.getColumn(1).getDouble(); cal.digitizer_delay = q.getColumn(2).getDouble();
   146	          cal.C0 = q.getColumn(3).getDouble(); cal.C1 = q.getColumn(4).getDouble(); cal.C2 = q.getColumn(5).getDouble(); cal.T1_ref = q.getColumn(6).getDouble();
   147	          cal.dC1 = q.getColumn(7).getDouble(); cal.dC2 = q.getColumn(8).getDouble(); cal.C3 = q.getColumn(9).getDouble(); cal.C4 = q.getColumn(10).getDouble();
   148	          if (q.executeStep()) throw std::runtime_error("mzpeak: more than one MzCalibration row");
   149	          if (!cal.isSupported()) throw std::runtime_error("mzpeak: " + cal.unsupportedReason());
   150	          SQLite::Statement f(db, "SELECT Id, T1 FROM Frames");
   151	          while (f.executeStep())
   152	          {
   153	            const long id = f.getColumn(0).getInt64(); if (id < 0 || id > 10000000) throw std::runtime_error("mzpeak: implausible Frames.Id");
   154	            if ((size_t)id >= t1_by_frame.size()) t1_by_frame.resize((size_t)id + 1, cal.T1_ref);
   155	            t1_by_frame[(size_t)id] = f.getColumn(1).isNull() ? cal.T1_ref : f.getColumn(1).getDouble();
   156	          }
   157	        }
   158	#endif
   159	        std::remove(tmpl);
   160	        enabled = true;
   161	      }
   162	      catch (...) { zip_close(z); throw; }
   163	      zip_close(z);
   164	    }
   165	
   166	    /// Recover the integer tof from the archive's two-point m/z and re-apply the exact model.
   167	    void exact(std::vector<double>& mz, long frame_id) const
   168	    {
   169	      const double b = cal.frameFactor(frame_id >= 0 && (size_t)frame_id < t1_by_frame.size() ? t1_by_frame[(size_t)frame_id] : cal.T1_ref);
   170	      for (double& v : mz)
   171	      {
   172	        const double tof = std::llround((std::sqrt(v) - c0) / c1);
   173	        const double e = cal.tofToMz(tof, b);
   174	        if (std::isfinite(e)) v = e;
   175	      }
   176	    }
   177	  };
   178	
   179	  /// One decoded frame split per window (index-aligned with `wins` of that frame).
   180	  inline void frameToSpectra_(const MzPeak::Spectrum& sp, double rt, std::size_t frame_idx,
   181	                              const std::vector<MzPeakWin>& wins, std::vector<OpenMS::MSSpectrum>& out,
   182	                              const MzPeakExactMz* exact = nullptr, long frame_id = -1)
   183	  {
   184	    using namespace OpenMS;
   185	    std::vector<double> mz_exact;
   186	    if (exact && exact->enabled) { mz_exact = sp.mz(); exact->exact(mz_exact, frame_id); }
   187	    const std::vector<double>& mz = (exact && exact->enabled) ? mz_exact : sp.mz();
   188	    const std::vector<float>& in = sp.intensity();
   189	    const std::vector<double>& im = sp.ion_mobility_array();
   190	    const std::size_t n = std::min(mz.size(), in.size());
   191	    const bool have_im = im.size() >= n;
   192	    out.assign(wins.size(), MSSpectrum());
   193	    for (std::size_t w = 0; w < wins.size(); ++w)
   194	    {
   195	      const MzPeakWin& win = wins[w];
   196	      MSSpectrum& spec = out[w];
   197	      spec.setRT(rt);
   198	      spec.setMSLevel(wins.size() == 1 && !(win.lo < win.hi) ? 1 : 2);
   199	      spec.setDriftTimeUnit(DriftTimeUnit::VSSC);
   200	      spec.setNativeID("mzpeak=" + std::to_string(frame_idx) + " window=" + std::to_string(w));
   201	      if (spec.getMSLevel() == 2)
   202	      {
   203	        Precursor prec;
   204	        prec.setMZ(0.5 * (win.lo + win.hi));
   205	        prec.setIsolationWindowLowerOffset(0.5 * (win.hi - win.lo));
   206	        prec.setIsolationWindowUpperOffset(0.5 * (win.hi - win.lo));
   207	        spec.setPrecursors({prec});
   208	        spec.setMetaValue("ion mobility lower limit", win.im_lo);
   209	        spec.setMetaValue("ion mobility upper limit", win.im_hi);
   210	      }
   211	      DataArrays::FloatDataArray im_array;
   212	      IMDataConverter::setIMUnit(im_array, DriftTimeUnit::VSSC);
   213	      spec.reserve(n / wins.size() + 64); im_array.reserve(n / wins.size() + 64);
   214	      for (std::size_t k = 0; k < n; ++k)
   215	      {
   216	        const double k0 = have_im ? im[k] : 0.0;
   217	        if (have_im && (k0 < win.im_lo || k0 > win.im_hi)) continue;
   218	        if (!(in[k] > 0)) continue;
   219	        spec.emplace_back(mz[k], in[k]);
   220	        im_array.push_back(static_cast<float>(k0));
   221	      }
   222	      if (spec.empty()) continue;
   223	      // mobility-major on disk -> sort by m/z, carrying the IM array along
   224	      std::vector<std::size_t> ord(spec.size());
   225	      for (std::size_t k = 0; k < ord.size(); ++k) ord[k] = k;
   226	      std::stable_sort(ord.begin(), ord.end(), [&](std::size_t a, std::size_t b) { return spec[a].getMZ() < spec[b].getMZ(); });
   227	      std::vector<Peak1D> sorted; sorted.reserve(spec.size());
   228	      DataArrays::FloatDataArray im_sorted; IMDataConverter::setIMUnit(im_sorted, DriftTimeUnit::VSSC); im_sorted.reserve(spec.size());
   229	      for (std::size_t k : ord) { sorted.push_back(spec[k]); im_sorted.push_back(im_array[k]); }
   230	      spec.clear(false);                                          // peaks only; RT/precursor/meta stay
   231	      for (const Peak1D& pk : sorted) spec.push_back(pk);
   232	      spec.getFloatDataArrays().push_back(std::move(im_sorted));
   233	      spec.setIMPeakType(IMPeakType::IM_PROFILE);
   234	    }
   235	  }
   236	
   237	  /// Stream an .mzpeak run into `consumer` (MS1 first, then MS2 per (frame, window), frame order).
   238	  /// Returns the number of frames seen.
   239	  inline std::size_t loadMzPeakStreaming(const std::string& path, OpenMS::FullSwathFileConsumer& consumer, int threads)
   240	  {
   241	    // 1) metadata sweep (no peak decode): RT, level, windows with IM bands, per frame
   242	    MzPeak::Index index = MzPeak::open(path);
   243	    MzPeak::Spectra spectra = index.spectra();
   244	    const std::size_t n = spectra.size();
   245	    lastMzPeakCalibration() = "mzpeak_two_point_transform (library-applied MS:1003825 from the archive; not the TDF MzCalibration model) archive=" + path.substr(path.find_last_of('/') + 1);
   246	    std::vector<double> rt(n);
   247	    std::vector<long> frame_id(n, -1);
   248	    std::vector<std::vector<MzPeakWin>> wins(n);
   249	    std::vector<std::size_t> ms1, ms2;
   250	    std::unique_ptr<MzPeakExactMz> exact;
   251	    // DEFAULT ON (2026-09-02 18:58): with the exact model recovered from the tdf, mzPeak input gives 12,082 Sage
   252	    // peptides vs 10,785 with the archive's two-point transform (and 12,217 from .d): the transform was 91% of the
   253	    // loss. Fail closed like the .d path: no tdf (embedded or SPEXTRACT_MZPEAK_TDF sidecar) -> error, unless
   254	    // SPEXTRACT_MZPEAK_EXACT=0 explicitly accepts the two-point m/z.
   255	    const char* ex = std::getenv("SPEXTRACT_MZPEAK_EXACT");
   256	    if (!(ex && std::string(ex) == "0"))
   257	    {
   258	      try { exact = std::make_unique<MzPeakExactMz>(path); }
   259	      catch (const std::exception& e)
   260	      {
   261	        throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   262	          std::string("mzPeak input: cannot recover the exact TDF calibration (") + e.what() + "). The archive's two-point transform is ~7 ppm off and costs ~12% peptides; set SPEXTRACT_MZPEAK_TDF=<analysis.tdf.gz> or SPEXTRACT_MZPEAK_EXACT=0 to accept it.", path);
   263	      }
   264	      lastMzPeakCalibration() = "tdf_table_modeltype1 (recovered from the archive's two-point transform + embedded vendor/analysis.tdf.gz) archive=" + path.substr(path.find_last_of('/') + 1);
   265	    }
   266	    for (std::size_t i = 0; i < n; ++i)
   267	    {
   268	      MzPeak::Spectrum sp = spectra[i];
   269	      const auto& md = sp.metadata();
   270	      rt[i] = md.retention_time.value_or(0.0);
   271	      { const std::string& id = md.id; const auto pos = id.find("frame="); if (pos != std::string::npos) frame_id[i] = std::atol(id.c_str() + pos + 6); }
   272	      if (md.ms_level.value_or(1) == 1) { wins[i] = {MzPeakWin{0, 0, -1e9, 1e9}}; ms1.push_back(i); continue; }
   273	      // Selected ions carry the per-window 1/K0 band. mzpeak-convert 0.9.x writes precursor_index
   274	      // as NULL and the band as NAME-ONLY CV params; the reader then attaches every ion of the
   275	      // frame to the FIRST precursor. So: flatten all ions of the spectrum and match each window
   276	      // to the ion whose selected_ion_mz is its isolation target.
   277	      struct Ion { double mz, lo, hi; };
   278	      std::vector<Ion> ions;
   279	      for (const auto& p : md.precursors)
   280	        for (const auto& si : p.selected_ions)
   281	        {
   282	          Ion ion{si.selected_ion_mz.value_or(-1.0), -1e9, 1e9};
   283	          if (si.ion_mobility_lower_limit && si.ion_mobility_upper_limit) { ion.lo = *si.ion_mobility_lower_limit; ion.hi = *si.ion_mobility_upper_limit; }
   284	          for (const auto& cv : si.parameters)
   285	          {
   286	            if (!cv.name || !cv.value) continue;
   287	            if (cv.name->find("ion mobility lower limit") != std::string::npos) ion.lo = std::stod(*cv.value);
   288	            else if (cv.name->find("ion mobility upper limit") != std::string::npos) ion.hi = std::stod(*cv.value);
   289	          }
   290	          ions.push_back(ion);
   291	        }
   292	      for (const auto& p : md.precursors)
   293	      {
   294	        if (!p.isolation_window.target_mz) continue;
   295	        const double c = *p.isolation_window.target_mz;
   296	        const double lo = c - p.isolation_window.lower_offset.value_or(0.f), hi = c + p.isolation_window.upper_offset.value_or(0.f);
   297	        const Ion* best = nullptr;
   298	        for (const Ion& ion : ions) if (!best || std::fabs(ion.mz - c) < std::fabs(best->mz - c)) best = &ion;
   299	        if (!best || std::fabs(best->mz - c) > 0.05 || best->lo < -1e8 || best->hi > 1e8)
   300	          throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   301	                                                "mzPeak MS2 window without a matching ion-mobility band (spectrum " + std::to_string(i) + ")", std::to_string(c));
   302	        wins[i].push_back(MzPeakWin{lo, hi, best->lo, best->hi});
   303	      }
   304	      if (!wins[i].empty()) ms2.push_back(i);
   305	    }
   306	
   307	    // 2) decode in parallel over contiguous ranges (row-group locality), hand off serially in order
   308	    int nthr = std::max(1, threads);
   309	#ifdef _OPENMP
   310	    nthr = std::min(nthr, std::max(1, omp_get_max_threads()));
   311	#endif
   312	    auto run = [&](const std::vector<std::size_t>& ids)
   313	    {
   314	      const std::size_t per = 12;                                  // frames per thread per batch (~1 row group)
   315	      const std::size_t batch = std::max<std::size_t>(per, per * (std::size_t)nthr);
   316	      for (std::size_t b0 = 0; b0 < ids.size(); b0 += batch)
   317	      {
   318	        const std::size_t b1 = std::min(ids.size(), b0 + batch);
   319	        const int nchunk = (int)((b1 - b0 + per - 1) / per);
   320	        std::vector<std::vector<std::vector<OpenMS::MSSpectrum>>> out((std::size_t)nchunk);
   321	        std::exception_ptr err;
   322	        #pragma omp parallel for schedule(dynamic, 1) num_threads(nthr)
   323	        for (int c = 0; c < nchunk; ++c)
   324	        {
   325	          try
   326	          {
   327	            const std::size_t c0 = b0 + (std::size_t)c * per, c1 = std::min(b1, c0 + per);
   328	            // one reader per THREAD (not per work item): MzPeak::open re-reads the zip directory and
   329	            // every parquet footer; ~1,450 opens cost ~1 h of system time on dataset D (measured 13:55).
   330	            static thread_local std::unique_ptr<MzPeak::Index> tidx;   // Index is neither movable nor copyable:
   331	            static thread_local std::string tidx_path;                  // construct it from the prvalue (elided)
   332	            if (!tidx || tidx_path != path) { tidx.reset(new MzPeak::Index(MzPeak::open(path))); tidx_path = path; }
   333	            MzPeak::Spectra tsp = tidx->spectra();
   334	            std::vector<std::size_t> want(ids.begin() + (std::ptrdiff_t)c0, ids.begin() + (std::ptrdiff_t)c1);
   335	            std::vector<MzPeak::Spectrum> got = tsp.get_spectra_batch(want);
   336	            auto& slot = out[(std::size_t)c]; slot.resize(want.size());
   337	            for (std::size_t k = 0; k < want.size() && k < got.size(); ++k)
   338	              frameToSpectra_(got[k], rt[want[k]], want[k], wins[want[k]], slot[k], exact.get(), frame_id[want[k]]);
   339	          }
   340	          catch (...)
   341	          {
   342	            #pragma omp critical(mzpeak_err)
   343	            if (!err) err = std::current_exception();
   344	          }
   345	        }
   346	        if (err) std::rethrow_exception(err);
   347	        for (auto& chunk : out) for (auto& frame : chunk) for (auto& spec : frame)
   348	          if (!spec.empty()) consumer.consumeSpectrum(spec);
   349	      }
   350	    };
   351	    run(ms1);
   352	    run(ms2);
   353	    return ms1.size() + ms2.size();
   354	  }
   355	} // namespace spx
   356	#endif // SPEXTRACT_WITH_MZPEAK
     1	# speXtract
     2	
     3	Extraction of pseudo-DDA ("pseudo-MS/MS") spectra from Bruker timsTOF **diaPASEF** data.
     4	
     5	An open, BSD-3, standalone alternative to the closed-source [the reference implementation](https://github.com/Nesvilab/the reference implementation).
     6	The goal is **blind / open search** — finding variants and unexpected modifications that a
     7	library-based DIA tool cannot report, because its search space is enumerated before the search
     8	begins.
     9	
    10	speXtract is a standalone application. **OpenMS is a prerequisite, not a host** — the tool links
    11	against an OpenMS installation but lives outside the OpenMS source tree.
    12	
    13	## Build
    14	
    15	Needs OpenMS with `WITH_OPENTIMS` (to read Bruker `.d`). **Apply this repo's OpenMS patches first:**
    16	
    17	```bash
    18	scripts/apply_openms_patches.sh /path/to/OpenMS      # installs src/TdfMzCalibration.h + patches
    19	# then rebuild the OpenMS DIAPseudoSpectra target
    20	```
    21	
    22	**Why this is not optional.** Without the calibration patch the Bruker reader converts TOF to m/z with
    23	a two-point linear-in-sqrt chord that is **-5 to -11 ppm biased** (m/z dependent) on every file we
    24	measured, costing roughly **6-11% of closed-search peptide identifications**. The build says nothing
    25	about it; the run log names the calibration used, and every emitted mzML records it in the
    26	`spx:mz_calibration` userParam (`tdf_table_modeltype1` | `bruker_sdk` | `legacy_chord_APPROXIMATE`).
    27	An unsupported calibration table now **fails closed** rather than silently producing biased masses;
    28	`SPEXTRACT_ALLOW_CHORD_FALLBACK=1` opts back into the old behaviour.
    29	
    30	Verified against OpenMS `3.6.0-pre-exported-20260717`. Other versions may need the patch rebased.
    31	Optionally, `OPENMS_BRUKER_SDK_PATH=/path/to/libtimsdata.so` uses Bruker's own library instead (an
    32	oracle for cross-checking; not required, not redistributed).
    33	
    34	### Optional: `.mzpeak` input (mzPeak C++ library)
    35	
    36	Build the library once against the same Arrow/Parquet/libzip OpenMS uses (`scripts/build_mzpeak_lib.sh`;
    37	GCC 13 / Arrow 23 need `patches/spx_ranges_to.h` and `patches/mzpeak-cpp-arrow23.py`, both applied by the
    38	script), then configure speXtract with `-DMZPEAK_ROOT=<checkout>`. Inside an OpenMS source tree use
    39	`patches/openms-topp-mzpeak-cmake.py` instead. ims-compact archives store raw TOF behind a two-point
    40	transform; the loader recovers the exact TDF calibration from the embedded `vendor/analysis.tdf.gz` (or
    41	`SPEXTRACT_MZPEAK_TDF=<analysis.tdf.gz>` for `--no-vendor` archives) and refuses to run without it unless
    42	`SPEXTRACT_MZPEAK_EXACT=0`.
    43	
    44	## Run
    45	
    46	```bash
    47	build/DIAPseudoSpectra -in sample.d -out pseudo.mzML -threads 64
    48	```
    49	
    50	Recommended: preload tcmalloc. It is worth more than the structural memory work in this
    51	repository (measured: -18.4% peak RSS combined, of which compaction alone is -6.1%).
    52	
    53	## Where it stands
    54	
    55	Measured on three diaPASEF acquisitions (one cohort, one instrument), both engines, identical search
    56	settings for both tools. Current arm: apex m/z estimator + `charge:min_charge` 2 (2026-09-03).
    57	Full matrix: `docs/BENCHMARK-MATRIX-2026-09-01.md`; decisions: `docs/dataset D-BASELINE.md`.
    58	
    59	| | dataset D | dataset A | dataset B | vs the reference implementation |
    60	|---|---|---|---|---|
    61	| **Sage** peptides @1% FDR | **12,642** | **11,084** | **10,294** | 109.8 / 108.2 / 115.0% |
    62	| Sage, before the charge gate (2026-09-02) | 12,537 | 10,789 | 10,156 | 108.9 / 105.3 / 113.5% |
    63	| **MSFragger** peptidoforms @1% | **12,073** | **12,061** | **9,822** | 86.7 / 88.3 / 92.6% |
    64	| MSFragger, before the charge gate | 11,927 | 11,444 | 9,738 | 85.6 / 83.7 / 91.8% |
    65	| the reference implementation reference (Sage / MSFragger) | 11,517 / 13,932 | 10,242 / 13,666 | 8,948 / 10,606 | -- |
    66	| entrapment FDR at nominal 1% | 1.38% [1.15-1.64] | 0.99% [0.77-1.23] | 1.28% [1.01-1.54] | the reference implementation 1.24 / 1.22% on dataset A/dataset B |
    67	| precursor mass error, paired vs the reference implementation on shared peptides | +0.78 ppm | +1.47 | +1.17 | fragment: -2.4 / -2.0 / -2.1 (the reference implementation-side reporting) |
    68	| pseudo-spectra emitted | 0.66 M | 0.86 M | 0.59 M | **0.94 / 0.99 / 0.82x the reference implementation** |
    69	| wall time, 128-core node (dataset D) | 12:49 | -- | -- | -- |
    70	
    71	Read honestly: **on Sage the result is above parity on all three files; on MSFragger the deficit
    72	stands (7-13%) and is statistically supported.** The emission excess is gone -- since 2026-09-03 we
    73	emit FEWER spectra than the reference implementation on all three files, so per-spectrum efficiency no longer favours
    74	the reference implementation and the MSFragger gap cannot be attributed to over-emission. It also survives perfect
    75	masses, so it is search/detection-side, not calibration.
    76	
    77	The 2026-09-01 calibration fix is worth +6-11% closed-search peptides on Sage. It is an
    78	identification-*yield* effect, not better spectra (emission moved -0.2%): mass error is a feature of
    79	Sage's discriminant. Since the reference implementation's spectra always carried vendor-calibrated masses, every earlier
    80	comparison was biased against the open path -- **this is the removal of a self-inflicted handicap,
    81	not a lead.**
    82	
    83	Determinism: the spectrum data is **byte-identical at any thread count and any loader batch size**
    84	(verified 2026-09-02 on three independent pairs: threads 8 vs 100 twice, loader batch 64 vs 256;
    85	`bench/semantic_digest.py` hashes `<spectrumList>`..`</spectrumList>`, excluding the wall-clock
    86	stamp, the recorded parameters and the trailing byte-offset index, none of which can match across
    87	invocations -- the last of these had produced two false "differs" verdicts before it was excluded).
    88	Last-ulp *code* changes still cascade to ~2% in peptide counts, so compare builds by the accepted
    89	peptide SET and the ppm median, not by raw counts.
    90	
    91	Runtime (dataset D, 33,553 frames, 100 threads on a 128-core node): **15:21 wall, 106 GB peak RSS**
    92	(2026-09-02; was 33:05 on 09-01 -- the serial floor was the MS1 path, now parallel). The loader is
    93	4% of the run; the window loop is 83%. Reading from `.mzpeak` instead of `.d` is supported
    94	(build-optional, mzPeak C++ library) but slower (17:04); the archive's two-point TOF transform costs
    95	12% of identifications, so the loader recovers the exact TDF calibration from the embedded
    96	`vendor/analysis.tdf.gz` (or a `SPEXTRACT_MZPEAK_TDF=` sidecar) by default and fails closed without
    97	it (-1% vs `.d` then). `.d` remains the primary input.
    98	
    99	## The main open defect
   100	
   101	**Charge annotation.** Now **74.6%** with the current defaults (was 47.8%), against the reference implementation's
   102	**82.6%**. The catastrophic `4->2` confusion is gone. But **always answering z=2 would score
   103	69.6%** — so charge inference beats a constant by 5.0 points. It has stopped failing
   104	catastrophically rather than started working, and it remains the largest headroom in the tool.
   105	
   106	An MS1 funnel attempting to localise *where* precursors are lost was **retracted the same day it
   107	was produced** — see [docs/ms1-funnel.md](docs/ms1-funnel.md). A decoy floor added afterwards
   108	showed that a precursor which does not exist still matched an MS1 trace 91.9% of the time, so the
   109	assay measured trace density rather than correctness. **"97.8% detection ceiling" and "26.5% lost
   110	in inference" are withdrawn.** A tolerance sweep is running to find a usable operating point.
   111	
   112	The charge-agreement number does not depend on that assay and stands.
   113	
   114	This matters disproportionately for the intended use: dM = (z'-z)(m/z - 1.00728), so a z4->z2
   115	error at m/z 600 fabricates a -1198 Da phantom modification. A closed search hides this because
   116	the engine enumerates charge; an open search does not.
   117	
   118	**Run-to-run reproducibility is 0.17%** (4 runs of an identical effective configuration:
   119	8,411 / 8,408 / 8,406 / 8,397). Differences below ~0.2% are noise; the +46% delta is far above it.
   120	
   121	See [docs/](docs/) for the measurements, including levers that were **falsified** — every
   122	redundancy-reducing knob loses peptides at peptide-level FDR. One falsification has been
   123	**withdrawn**: ion mobility was retired against the wrong null (`max p_z` = 69.6% instead of
   124	`sum p_z^2` = 55.8%), so its true margin is **+19.2 points, not +5.4**. See
   125	[docs/charge-inference.md](docs/charge-inference.md).
   126	
   127	## Layout
   128	
   129	```
   130	src/        the tool
   131	scripts/    truth-set, funnel, FDR-recount and charge analyses
   132	docs/       benchmark results and architecture reviews
   133	```
   134	
   135	## License
   136	
   137	BSD-3-Clause. Derived from OpenMS (BSD-3-Clause) — see [NOTICE](NOTICE).
   138	
   139	## Charge inference: the two defaults are coupled, not independent
   140	
   141	Measured against a DIA-NN dataset B reference (`charge agreement` = our charge vs truth on matched
   142	spectra; always answering z=2 would score **69.6%**):
   143	
   144	| arm | charge agreement | `4->2` errors |
   145	|---|---|---|
   146	| ms1split + ambiguity_margin | **41.7%** | 34,554 |
   147	| ms1split alone | 45.8% | 19,995 |
   148	| baseline (`envelope`) | 49.7% | 10,199 |
   149	| `count` | 71.8% | -- |
   150	| **`ms1split` + `count`** (default) | **74.6%** | -- |
   151	
   152	**MS1 splitting must not ship without `count`** — an *empirical* coupling, not an architectural
   153	one. The two touch separate code paths (`trace:ms1_split_valleys` in `detectTraces_`,
   154	`charge:scoring` in `inferPrecursors_`); nothing in the code enforces the pairing, so the
   155	combination is a benchmark finding that a future edit could silently break. On its own MS1
   156	splitting drops charge agreement below baseline and
   157	more than triples the `4->2` confusion, which fabricates a ~-1198 Da phantom modification at
   158	m/z 600 -- invisible to closed search (the engine enumerates charge) and fatal to open search.
   159	Shipping `trace:ms1_split_valleys` without `charge:scoring count` would have been actively
   160	harmful for this tool's actual purpose.
   161	
   162	### `charge:ambiguity_margin` -- falsified, four tests
   163	
   164	| margin | peptide_q | vs `split_count` 8,411 |
   165	|---|---|---|
   166	| 0.5 | 8,408 | -0.04% |
   167	| 1.0 | 8,406 | -0.06% |
   168	| 2.0 | 8,397 | -0.2% |
   169	
   170	2.0 is the first value that can genuinely fire against an integer partner count (it admits any
   171	hypothesis within 2 partners of the best) and it still changes nothing. Hedging charge does not
   172	help; deciding it well does. Left at 0.
     1	# Changelog
     2	
     3	## [Unreleased]
     4	
     5	### Changed
     6	- **`charge:min_charge` now defaults to 2**, dropping singly-charged precursor hypotheses before
     7	  extraction. They are ~30% of emission and ~1.7% of peptides, and removing them GAINS peptides on
     8	  both search engines on all three benchmark files (Sage +0.8/+2.7/+1.4%, MSFragger +1.2/+5.4/+0.9%)
     9	  while cutting emission ~30% and runtime 17%. Entrapment FDR stays inside the previous 95% interval
    10	  on every file. Set `charge:min_charge=1` to restore the previous behaviour.
    11	
    12	### Added
    13	- `SPEXTRACT_ISO_COLLAPSE` (experimental, default off): collapses precursor hypotheses on the isotope
    14	  lattice before extraction. Measured on dataset D and NOT adopted -- it loses peptides at every setting,
    15	  and loses more on top of the charge gate. Kept for reproducibility of that finding.
    16	- `bench/iso_dup.py`, `bench/iso_collapse.py`, `bench/iso_sim.py`, `bench/iso_loss.py`,
    17	  `bench/iso_guard.py`: the isotope-duplication census, collapse-rule evaluation, content-similarity
    18	  test and loss trace behind those results.
    19	
    20	### Runtime
    21	- **MS1 path parallelised** (loader `[speXtract ms1-par]`: batched parallel MS1 decode with per-thread ZSTD contexts and
    22	  `FrameCentroider`, ordered hand-off; consumer `flushMS1_`: parallel MS1 pick). dataset D/100 threads: LOAD 445 s -> 39 s,
    23	  total 22:22 -> **15:21**; spectrum data byte-identical, Sage peptide set identical.
    24	- Decode-once frame-major parallel MS2 loader (`[speXtract par-load]`), batched parallel MS2 pick; per-phase `[perf]`
    25	  table and `[perf-load]` decode/hand-off/pick timers; `SPEXTRACT_LOAD_ONLY=1` for load-only profiling.
    26	- Falsified and recorded: `MALLOC_ARENA_MAX=4` (10x slower at 100 threads), loader batch depth (64/256/1024 flat).
    27	
    28	### Input
    29	- **Streaming `.mzpeak` input** (`src/MzPeakStreamLoad.h`, build-optional `-DMZPEAK_ROOT`) on the mzPeak C++ library
    30	  (OpenMS/mzpeak fork trunk); reads ims-compact archives with per-window mobility bands (works around name-only band
    31	  params and NULL `precursor_index`). Benchmarked: not faster (the floor was the MS1 pick), and -11.7% peptides from the
    32	  archive's two-point TOF transform (fragment error +10 ppm) -- see docs/RUNTIME-PLAN-2026-09-02.md and the converter
    33	  handoff. Output stamps `spx:mz_calibration = mzpeak_two_point_transform ...` for this path.
    34	- Library build recipe for GCC 13 / Arrow 23 (`scripts/build_mzpeak_lib.sh`, `patches/spx_ranges_to.h`,
    35	  `patches/mzpeak-cpp-arrow23.py`).
    36	
    37	### Determinism
    38	- `bench/semantic_digest.py` now stops at `</spectrumList>`: the trailing `<indexList>` byte offsets shift with any header
    39	  length change and had falsely flagged two spectrum-identical files. Loader batch size does NOT change content
    40	  (922,902 spectra, 0 differ; Sage set identical), and **neither does the thread count**: threads 8 == threads 100 on two pairs with the fixed digest, retracting the 2026-09-01 "thread-count dependent" finding. Output is byte-identical spectrum data at any thread count and loader batch.
    41	
    42	### Scoring / assembly
    43	- **E5:** `apportion` and `rp_max` now go through the same emitted-intensity weights as the default path
    44	  (`weighted_()`); they had silently bypassed `corr_power`/`im_weight`, so every earlier A/B of those flags was
    45	  confounded. First clean apportion run: -3.9% peptides (falsified again; NNLS cut).
    46	- **Reported m/z of every trace is now the APEX member's m/z** (`SPEXTRACT_MZ_ESTIMATOR=apex`, the new default;
    47	  `mean` restores the OpenMS intensity-weighted centroid): dataset D +2.6% Sage (12,537 vs 12,217) and +4.1% MSFragger
    48	  (11,927 vs 11,463) with the paired precursor mass error vs the reference implementation +1.12 -> +0.78 ppm. Both-engines gate passed;
    49	  generalises: dataset A +4.4% (10,789), dataset B +2.7% (10,156); mean ratio vs the reference implementation on Sage 105.1% -> 109.2%;
    50	  entrapment of the apex arm 1.28% [1.03-1.53] at nominal 1%.
    51	- Under test (env switches, defaults unchanged): `SPEXTRACT_PICK_MZ_MODE=seed|top3` (pick-level m/z; the -2.4 ppm
    52	  fragment offset vs the reference implementation is upstream of the trace estimator), `SPEXTRACT_DROP_PREC_ISO=1` (drop the precursor's
    53	  M+1..M+3 from fragment lists; 28%/25% of spectra carried them -- FALSIFIED, -2.3%, keep off), `SPEXTRACT_MZPEAK_EXACT` (now the default; `=0` accepts the two-point m/z),
    54	  `SPEXTRACT_MIN_ISOTOPES=k` (precursor gate by envelope depth; k=3 = -39% emission, -23% wall, MSFragger -0.9%, Sage -6.4%),
    55	  `SPEXTRACT_PRECURSOR_LIST=<tsv>` (emit only precursors matching a reference list), `SPEXTRACT_BACKFILL_RAW=N` /
    56	  `SPEXTRACT_BACKFILL_MAXFRAGS=K` (add the N most intense untraced raw peaks of the apex frame inside the IM band:
    57	  N=50 lifts MSFragger to 90% of the reference implementation at -2.6% Sage; faint-tail-only variant under test).
    58	- Output-identical: band partition by binary search (R3), early skip of fragments below `min_corr_pts` support.
    59	- Help texts of falsified flags (`rp_max`, `consolidate`, `merge`) now say so; `charge:iso_im_tolerance` help
    60	  no longer contradicts its default.
    61	
    62	### Benchmark findings
    63	- MSFragger gap is per-precursor CONTENT of the faint tail: same precursor population as the reference implementation -> 85.0%; emission -39% -> 84.8%;
    64	  dt-only peptides are searched but short by ~2 of ~9 matched ions that never become a trace; raw apex-frame peak
    65	  backfill recovers 1,151 of them (MSFragger 85.6% -> 90.0%). FragPipe rescoring (Percolator, MSBooster off for both) gives 13,211 vs the reference implementation
    66	  15,947 peptides (82.8%; raw-hyperscore walk 85.6%) -- rescoring lifts both tools and leaves the ratio; ours has
    67	  8.6 PSMs/peptide vs 2.0. Entrapment of the shipping arm: 1.28% / 0.95% / 1.32% at nominal 1% on dataset D/dataset A/dataset B.
    68	- Falsified today (kept in docs so they are not re-proposed): apportion (clean, -3.9%), precursor-isotope stripping
    69	  (-2.3%), median/seed/top3 m/z estimators, 48 MS1 trace bands (slower, not output-identical), MALLOC_ARENA_MAX=4.
    70	
    71	### Docs
    72	- `docs/BACKLOG-ANALYSIS-2026-09-02.md`: every open issue with status, root cause, fix, gate; reviewed by kimi + codex
    73	  (`docs/reviews/`). Confirmed today: apportion/rp_max bypass corr_power (E5); 28% of spectra carry the precursor M+1 as a
    74	  fragment (C9); false mzPeak calibration provenance (fixed).
    75	
    76	## v0.2.0 — 2026-09-02
    77	
    78	First release with a verified calibration, tests, and CI. Supersedes v0.1.0, which was tagged on the
    79	day-one commit and never represented a working state.
    80	
    81	### Headline: exact, license-free TOF -> m/z calibration
    82	The Bruker `.d` reader converted TOF to m/z with a two-point linear-in-sqrt chord that is **-5 to -11
    83	ppm biased** (m/z dependent). We derived the exact ModelType-1 model from the constants in each
    84	file's own `MzCalibration` table and verified it to **2.5e-5 ppm** against Bruker's library:
    85	
    86	    t_ns   = tof * DigitizerTimebase + DigitizerDelay
    87	    C1_eff = C1 * (1 + dC1 * (T1_ref - T1_frame) / 1e6)
    88	    t_ns   = C0 + (1e6 / sqrt(C1_eff)) * sqrt(m) + C2 * m
    89	
    90	The widely-copied open implementation (timsrust-calibration, adapted then disabled by mzdata as "not
    91	consistently better") **drops the `C2*m` term** -- worth -11..-40 ppm. That omission, not translation
    92	subtlety, is why the port underperformed. Reported upstream.
    93	
    94	Measured on three diaPASEF files, closed search: **+6-11% Sage peptide identifications**, no vendor
    95	library. This is an identification-YIELD effect, not better spectra (emission moved -0.2%): mass
    96	error is a feature of Sage's discriminant. Since the reference implementation always carried vendor-calibrated masses,
    97	every earlier head-to-head was biased against the open path -- this removes a self-inflicted
    98	handicap rather than establishing a lead.
    99	
   100	### Benchmarks (3 files, both engines, identical settings; docs/BENCHMARK-MATRIX-2026-09-01.md)
   101	| | dataset D | dataset A | dataset B | vs the reference implementation |
   102	|---|---|---|---|---|
   103	| Sage peptides @1% FDR | 11,976 | 10,333 | 9,891 | mean 105.1%, 95% CI [93.0, 117.3] -- consistent with PARITY |
   104	| MSFragger peptidoforms @1% | 11,463 | 11,465 | 9,404 | mean 85.0%, 95% CI [76.7, 93.2] -- a supported DEFICIT |
   105	| median precursor mass error | +1.5 | +3.2 | +2.3 ppm | the reference implementation -1.4 / +0.3 / -0.6 |
   106	speXtract also emits ~1.32x more spectra, so per-spectrum efficiency favours the reference implementation. The MSFragger
   107	gap survives perfect masses and is therefore search/detection-side.
   108	
   109	### Safety
   110	- **Fails closed.** ModelType != 1, `C2 <= 0` (a NULL/text C2 reads as 0.0 and selects the known-bad
   111	  pure-sqrt law), `dC2`/`C3`/`C4` != 0, implausible `C1`, NaN, multi-row tables, or an unreadable
   112	  `Frames.T1` are all errors, not silent approximations. `SPEXTRACT_ALLOW_CHORD_FALLBACK=1` (exactly
   113	  "1") opts back into the biased chord.
   114	- **Provenance.** Every emitted mzML records `spx:mz_calibration` =
   115	  `tdf_table_modeltype1` | `bruker_sdk` | `legacy_chord_APPROXIMATE`, via an exported accessor that
   116	  works across the shared-library boundary.
   117	- Out-of-model inputs return NaN, never a plausible-looking 0.0.
   118	
   119	### Tests and CI (first in this repo)
   120	- `tests/test_calibration_cpp.cpp` -- 60 vendor-derived golden cases against the **shipped** header,
   121	  round-trip inverse, and every rejection path. Ablation guards prove the suite can catch the
   122	  known-bad implementation (39.4 ppm) and the temperature term (0.67 ppm).
   123	- `tests/test_calibration.py` -- an independent re-implementation as a cross-check.
   124	- `tests/test_entrapment.py` -- estimator CI, determinism, NaN-on-empty.
   125	- `.github/workflows/tests.yml` runs all three. None needs a vendor library, cluster, or raw data.
   126	
   127	### Determinism (scoped honestly)
   128	Bit-reproducible **at a fixed thread count** -- verified by `bench/semantic_digest.py`, which compares
   129	spectrum data and ignores the wall-clock stamp and the recorded parameters (two runs can never be
   130	byte-identical otherwise; this also explains a July md5 mismatch left unexplained at the time).
   131	Output DOES differ across thread counts, and last-ulp code changes cascade to ~2% in peptide counts.
   132	The 0.06% noise floor in the decision rule is a SAME-BINARY figure.
   133	
   134	### Also
   135	- Entrapment estimator corrected (peptide-hypothesis ratio 0.6805, foreign-only counting, bootstrap
   136	  CIs): actual FDR at nominal 1% is ~1.0-1.45%, not the ~2.3% previously reported.
   137	- `assembly:corr_power=2` default (validated +8-10%, three files, both engines).
   138	- Spectrum collapse falsified (-20..-60% peptides at every operating point, intrinsic to both tools).
   139	- `scripts/apply_openms_patches.sh`; `scripts/sync_cluster.sh` refuses to deploy into an unpatched
   140	  tree; evidence chain archived to durable storage.
   141	
   142	### Known limitations
   143	- Verified on ONE cohort/instrument; the three golden files share ONE MzCalibration vector.
   144	- Public-data replication not yet done; every claim is single-cohort.
   145	- A +1.5..+3.2 ppm residual remains, 2-4 ppm above the reference implementation on the same files. It survives every
   146	  calibration path, so it is downstream of the m/z axis (centroiding / monoisotope reporting).
   147	- Peptide counts are partly a mass-calibration measurement: compare only at similar residual ppm.

