  1714	    const int max_charge = getIntOption_("max_charge");
  1715	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  1716	
  1717	    PeakMap exp;
  1718	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  1719	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  1720	    PeakMap ms1_map;
  1721	    map<pair<int, int>, vector<CompactFrame>> ms2_by_window;
  1722	    CompactStats cstat;
  1723	    auto winKey = [](double lo, double hi) {
  1724	      return make_pair((int)llround(lo * 100.0), (int)llround(hi * 100.0));
  1725	    };
  1726	    const bool stream_load = getFlag_("perf:stream_load");
  1727	    bool streamed = false;
  1728	
  1729	    if (stream_load)
  1730	    {
  1731	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  1732	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  1733	      BrukerTimsFile::Config cfg;
  1734	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  1735	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  1736	      PeakPickerIM spicker;
  1737	      Param sp = spicker.getParameters();
  1738	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  1739	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  1740	      if (const char* m = std::getenv("SPEXTRACT_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  1741	      spicker.setParameters(sp);
  1742	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  1743	      try
  1744	      {
  1745	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  1746	        {
  1747	#ifdef SPEXTRACT_WITH_MZPEAK
  1748	          spx::loadMzPeakStreaming(in, consumer, getIntOption_("threads"));   // consumer counts frames itself
  1749	#else
  1750	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  1751	#endif
  1752	        }
  1753	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  1754	        streamed = true;
  1755	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  1756	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  1757	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  1758	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  1759	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  1760	        if (std::getenv("SPEXTRACT_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  1761	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  1762	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  1763	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
  1764	                      + String(cfg.dia_ms2_n_neighbors) + ")" + clk_() + rss_());
  1765	      }
  1766	      catch (const Exception::BaseException& e)
  1767	      {
  1768	        writeLogWarn_(String("[stream] streaming load failed (") + e.getName()
  1769	                      + "); falling back to loadExperiment. " + e.getMessage());
  1770	      }
  1771	    }
  1772	
  1773	    if (!streamed)
  1774	    {
  1775	      Phase _ph("LOAD(full)");
  1776	      FileHandler().loadExperiment(in, exp, {FileTypes::MZML, FileTypes::MZPEAK, FileTypes::BRUKER_TDF}, log_type_);
  1777	    }
  1778	
  1779	    //-------------------------------------------------------------
  1780	    // Input normalization / validation [C-4]
  1781	    //-------------------------------------------------------------
  1782	    // [stream] The streaming path fills ms1_map/ms2_by_window directly via an IM-aware consumer
  1783	    // (PickCompactConsumer calls ensureIMArrayName), leaving `exp` EMPTY -- so the exp-based IM check
  1784	    // only applies to the non-streaming load. Running it on the streamed (empty) `exp` wrongly aborted
  1785	    // with "no ion-mobility data at MS1", which is why native pre-centroiding aggregation could never
  1786	    // be benchmarked. Streamed data is guarded by the ms1_map.empty() check below instead.
  1787	    if (!streamed)
  1788	    {
  1789	      IMFormat imf = IMTypes::determineIMFormat(exp, 1);
  1790	      if (imf == IMFormat::NONE)
  1791	      {
  1792	        writeLogError_("Error: input has no ion-mobility data at MS1. DIAPseudoSpectra requires diaPASEF (IM DIA) input.");
  1793	        return ILLEGAL_PARAMETERS;
  1794	      }
  1795	    }
  1796	    // ponytail: assumes 1/K0 (VSSC). ms/CCS conversion and FAIMS rejection are Phase 2 [M-2].
  1797	
  1798	    // Centroid IM frames that are still profile, keeping per-peak IM at a tolerance no coarser
  1799	    // than the trace IM tolerance [C-2]. Split MS1 vs MS2 into separate working maps.
  1800	    PeakPickerIM picker;
  1801	    Param pp = picker.getParameters();
  1802	    pp.setValue("pickIMCluster:im_tolerance_cluster", delta_im);
  1803	    pp.setValue("pickIMCluster:ppm_tolerance_cluster", mass_ppm);
  1804	    picker.setParameters(pp);
  1805	
  1806	    // Peak-pick (centroid) all IM frames in PARALLEL. PeakPickerIM is firstprivate so each thread
  1807	    // has its own copy -> the mutable ccs_warning_shown_ flag is not shared (a shared const picker
  1808	    // would be a real data race). pickIMCluster mutates only its own spectrum; distinct indices are
  1809	    // independent. [par-Crit-1]
  1810	    writeLogInfo_("Loaded " + String(exp.size()) + " frames." + clk_() + rss_()); // raw residency peak? [mem]
  1811	    writeLogInfo_("Peak-picking " + String(exp.size()) + " frames (OpenMP)...");
  1812	    // Param is a deep-copy value type (mutable ParamNode root_, defaulted copy) so firstprivate
  1813	    // gives each thread a fully independent picker -> no refcount/COW race. pickIMCluster can throw
  1814	    // (e.g. unexpected IM format); an exception escaping an OMP region terminates the process, so
  1815	    // capture it and rethrow serially. [par-Crit-1, code-review]
  1816	    std::exception_ptr pick_err;
  1817	    #pragma omp parallel for firstprivate(picker) schedule(dynamic, 16)
  1818	    for (long i = 0; i < (long)exp.size(); ++i)
  1819	    {
  1820	      try
  1821	      {
  1822	        MSSpectrum& s = exp[i];
  1823	        if (!s.containsIMData()) continue;
  1824	        if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  1825	        ensureIMArrayName(s); // so MassTraceDetection reads per-peak IM (IM-aware tracing) [C-1]
  1826	      }
  1827	      catch (...)
  1828	      {
  1829	        #pragma omp critical
  1830	        if (!pick_err) pick_err = std::current_exception();
  1831	      }
  1832	    }
  1833	    if (pick_err) std::rethrow_exception(pick_err);
  1834	
  1835	    // Serial dispatch: MOVE (not copy) frames into the MS1 map / per-window MS2 maps to avoid
  1836	    // transient memory doubling; container inserts aren't thread-safe so this stays serial.
  1837	    if (!streamed)
  1838	    for (MSSpectrum& s : exp)
  1839	    {
  1840	      if (!s.containsIMData()) continue;
  1841	      if (s.getMSLevel() == 1)
  1842	      {
  1843	        ms1_map.addSpectrum(std::move(s));
  1844	      }
  1845	      else if (s.getMSLevel() == 2 && !s.getPrecursors().empty())
  1846	      {
  1847	        const OpenMS::Precursor& pr = s.getPrecursors()[0];
  1848	        double lo = pr.getMZ() - pr.getIsolationWindowLowerOffset();
  1849	        double hi = pr.getMZ() + pr.getIsolationWindowUpperOffset();
  1850	        ms2_by_window[winKey(lo, hi)].push_back(compactify(s, cstat));
  1851	      }
  1852	    }
  1853	    exp.clear(true); // frames moved out; release the container
  1854	    {
  1855	      size_t cb = 0, cp = 0;
  1856	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) { cb += f.bytes(); cp += f.mzq.size(); }
  1857	      const size_t lost = cstat.no_im_array + cstat.size_mismatch + cstat.bad_mz + cstat.bad_im;
  1858	      if (lost)
  1859	      {
  1860	        writeLogWarn_("[compact] DROPPED " + String(lost) + " peaks: no_im_array=" + String(cstat.no_im_array)
  1861	                      + " size_mismatch=" + String(cstat.size_mismatch) + " bad_mz=" + String(cstat.bad_mz)
  1862	                      + " bad_im=" + String(cstat.bad_im) + " (kept " + String(cstat.kept) + ") -- if this is"
  1863	                      + " nonzero the compact store is NOT lossless and results differ from the old path.");
  1864	      }
  1865	      writeLogInfo_("Split into MS1 + " + String(ms2_by_window.size()) + " windows (picked); compact store "
  1866	                    + String(cb / (1024ULL * 1024ULL)) + " MB for " + String(cp) + " peaks (~"
  1867	                    + String(cp ? (double)cb / cp : 0.0) + " B/peak)." + clk_() + rss_()); // [mem]
  1868	    }
  1869	
  1870	    if (ms1_map.empty())
  1871	    {
  1872	      writeLogError_("Error: no MS1 ion-mobility frames found; cannot seed precursors.");
  1873	      return INCOMPATIBLE_INPUT_DATA;
  1874	    }
  1875	
  1876	    //-------------------------------------------------------------
  1877	    // MS1 traces + precursor/charge inference (shared, once) [H-8,H-10]
  1878	    //-------------------------------------------------------------
  1879	    const int agg_ms1 = getIntOption_("trace:frame_aggregation_ms1_n");
  1880	    ms1_map.sortSpectra();
  1881	    if (agg_ms1 > 1) { aggregateFrames_(ms1_map, agg_ms1, mass_ppm, delta_im); writeLogInfo_("MS1 cross-frame aggregation N=" + String(agg_ms1) + rss_()); }
  1882	    const double ms1_snr = getDoubleOption_("trace:ms1_chrom_peak_snr");
  1883	    const double ms2_snr = getDoubleOption_("trace:ms2_chrom_peak_snr");
  1884	    const double ms2_minlen = getDoubleOption_("trace:ms2_min_length_sec");
  1885	    const double ms2_msr = getDoubleOption_("trace:ms2_min_sample_rate");
  1886	    double ms2_split = getDoubleOption_("trace:ms2_split_valleys");
  1887	    const double max_trace_len = getDoubleOption_("trace:max_trace_length_sec");
  1888	    const int agg_n = getIntOption_("trace:frame_aggregation_n");
  1889	    String ms1_span;
  1890	    // [parallel] MS1 tracing was UNBANDED: the call never passed a band count, so it defaulted to
  1891	    // 1 and MassTraceDetection -- a serial greedy loop over an intensity-sorted apex list -- ran on
  1892	    // ONE core while MS2 was banded across the machine. Invisible at default thresholds (MS1 is ~4%
  1893	    // of frames), fatal for the MS1 sensitivity sweep, which is the one lever the literature names
  1894	    // as the root cause of low-abundance loss in this tool class.
  1895	    int ms1_bands = getIntOption_("perf:ms1_trace_bands");
  1896	    if (ms1_bands < 1) ms1_bands = 1;
  1897	    double _t_ms1 = phase_clock_(), _c_ms1 = cpu_seconds_();   // [perf-instr]
  1898	    vector<Trace> ms1_traces = detectTraces_(ms1_map, delta_im, getDoubleOption_("trace:noise_threshold_int"),
  1899	                                             ms1_snr, getDoubleOption_("trace:min_length_sec"), getDoubleOption_("trace:ms1_min_sample_rate"), max_trace_len, getDoubleOption_("trace:ms1_split_valleys"), &ms1_span, ms1_bands);
  1900	    if (detOn_()) writeLogInfo_("[det] MS1 traces n=" + String(ms1_traces.size()) + " digest=" + String(traceDigest_(ms1_traces)));
  1901	    { auto& st = phase_stats_()["MS1_TRACE"]; if (st.n++ == 0) phase_order_().push_back("MS1_TRACE");
  1902	      st.wall += phase_clock_() - _t_ms1; st.cpu += cpu_seconds_() - _c_ms1; st.rss_end_mb = rss_mb_(); }
  1903	    writeLogInfo_("MS1 " + ms1_span);   // [merged-trace] measure, do not assume
  1904	
  1905	    // [fwhm] Measure the actual chromatographic peak width from the MS1 traces just built, and
  1906	    // use it to set the MS2 valley-splitting window. chrom_fwhm is an ABSOLUTE TIME, so a fixed
  1907	    // default cannot be right across methods: 14.0 s gave +0.0% peptides on a 31 min gradient
  1908	    // and -1.06% on a 5.6 min one, where the same 14 s is proportionally 5.5x wider.
  1909	    // Median, not mean: FWHM distributions are heavy-tailed and a mean is dominated by a handful
  1910	    // of merged or truncated traces. Traces that never fall to half maximum on both sides are
  1911	    // EXCLUDED rather than imputed -- a truncated peak is not a narrow one, and imputing it
  1912	    // would bias the estimate downward exactly where peaks are broadest.
  1913	    double ms1_fwhm_med = -1.0;
  1914	    {
  1915	      vector<double> fw;
  1916	      fw.reserve(ms1_traces.size() / 4 + 1);
  1917	      for (const auto& t : ms1_traces)
  1918	      {
  1919	        if (t.xic.size() < 5) continue;
  1920	        size_t ap = 0;
  1921	        for (size_t i = 1; i < t.xic.size(); ++i) if (t.xic[i].second > t.xic[ap].second) ap = i;
  1922	        const double half = t.xic[ap].second * 0.5;
  1923	        if (half <= 0.0) continue;
  1924	        double lo = -1.0, hi = -1.0;
  1925	        for (size_t i = ap; i > 0; --i)
  1926	          if (t.xic[i - 1].second <= half)
  1927	          { const double d = t.xic[i].second - t.xic[i - 1].second;
  1928	            const double f = d > 0 ? (t.xic[i].second - half) / d : 0.0;
  1929	            lo = t.xic[i].first - f * (t.xic[i].first - t.xic[i - 1].first); break; }
  1930	        for (size_t i = ap; i + 1 < t.xic.size(); ++i)
  1931	          if (t.xic[i + 1].second <= half)
  1932	          { const double d = t.xic[i].second - t.xic[i + 1].second;
  1933	            const double f = d > 0 ? (t.xic[i].second - half) / d : 0.0;
  1934	            hi = t.xic[i].first + f * (t.xic[i + 1].first - t.xic[i].first); break; }
  1935	        if (lo >= 0.0 && hi > lo) fw.push_back(hi - lo);
  1936	      }
  1937	      if (!fw.empty())
  1938	      {
  1939	        std::nth_element(fw.begin(), fw.begin() + fw.size() / 2, fw.end());
  1940	        ms1_fwhm_med = fw[fw.size() / 2];
  1941	        writeLogInfo_("Measured MS1 FWHM: median " + String(ms1_fwhm_med) + " s over "
  1942	                      + String(fw.size()) + " traces (of " + String(ms1_traces.size())
  1943	                      + "; truncated peaks excluded)");
  1944	      }
  1945	      else writeLogInfo_("Measured MS1 FWHM: NO usable traces -- falling back to absolute seconds");
  1946	    }
  1947	    // ms2_split is declared at :1324 but the FWHM is only known HERE, after MS1 tracing --
  1948	    // that ordering is why only the MS2 side can use the measured width for free. Doing the
  1949	    // same for MS1 needs a two-pass trace (measure with splitting off, then re-trace), which is
  1950	    // a real cost and is deliberately not done blind.
  1951	    // [wavelet] The smoothing scale is a MEASUREMENT, not a parameter: trace:wavelet_smooth is a
  1952	    // multiple of the median MS1 FWHM just measured above. A fixed absolute width cannot be right
  1953	    // across gradients (the same 14 s was +0.0% on a 31 min method and -1.06% on a 5.6 min one).
  1954	    // Refuse rather than guess if no FWHM could be measured -- silently falling back to some
  1955	    // absolute default is how the split_valleys work produced method-dependent results.
  1956	    const double wl_mult = getDoubleOption_("trace:wavelet_smooth");
  1957	    if (wl_mult > 0.0 && ms1_fwhm_med > 0.0)
  1958	    {
  1959	      wl_scale_ = wl_mult * ms1_fwhm_med;
  1960	      writeLogInfo_("[wavelet] precursor-XIC smoothing ON: " + String(wl_mult) + " x measured FWHM "
  1961	                    + String(ms1_fwhm_med) + " s = " + String(wl_scale_) + " s");
  1962	    }
  1963	    else if (wl_mult > 0.0)
  1964	    {
  1965	      wl_scale_ = 0.0;
  1966	      writeLogWarn_("[wavelet] trace:wavelet_smooth requested but NO MS1 FWHM could be measured; "
  1967	                    "smoothing stays OFF rather than guessing an absolute width");
  1968	    }
  1969	    const double sv_fwhm = getDoubleOption_("trace:split_valleys_fwhm");
  1970	    if (sv_fwhm > 0.0 && ms1_fwhm_med > 0.0)
  1971	    {
  1972	      const double old_split = ms2_split;
  1973	      ms2_split = sv_fwhm * ms1_fwhm_med;
  1974	      writeLogInfo_("MS2 valley-split window set from measured FWHM: " + String(sv_fwhm) + " x "
  1975	                    + String(ms1_fwhm_med) + " s = " + String(ms2_split) + " s (was "
  1976	                    + String(old_split) + " s absolute)");
  1977	    }
  1978	    else if (sv_fwhm > 0.0)
  1979	      writeLogWarn_("trace:split_valleys_fwhm requested but no FWHM could be measured; "
  1980	                    "keeping the absolute trace:ms2_split_valleys value");
  1981	    const double iso_im_tol = getDoubleOption_("charge:iso_im_tolerance");
  1982	    const double ms2_noise = getDoubleOption_("trace:ms2_noise_threshold_int");
  1983	    writeLogInfo_("MS2 trace gate: apex > " + String(ms2_snr * ms2_noise) + " (snr " + String(ms2_snr)
  1984	                  + " x noise " + String(ms2_noise) + "), membership > " + String(ms2_noise)
  1985	                  + ", min_length " + String(ms2_minlen) + " s");
  1986	    const bool env_scoring = (getStringOption_("charge:scoring") == "envelope");
  1987	    const double ambig_margin = getDoubleOption_("charge:ambiguity_margin");
  1988	    // [determinism] Canonically order the MS1 traces before precursor inference. inferPrecursors_
  1989	    // is a GREEDY seed-and-mark-used loop; its output depends on ms1_traces' CONTAINER ORDER, and
  1990	    // that order is non-deterministic -- MS1 detectTraces_ runs at top level so EPD's internal
  1991	    // parallel-for is active and appends split traces in thread-completion order. The greedy
  1992	    // seed sort already tie-breaks on index (a<b), but the index maps to a different physical
  1993	    // trace each run. Result: ~0.7% run-to-run peptide wobble, and the deterministic -0.8% when a
  1994	    // parallel change reshuffled the order. A total physical sort here mirrors the MS2-side sort
  1995	    // that already exists (fragment traces are canonicalised right after detectTraces_) and makes
  1996	    // the whole tool reproducible -- which also makes the emitted-count/peptide correctness gate
  1997	    // MEASURABLE. [adv-review kimi/codex 2026-07-26]
  1998	    sort(ms1_traces.begin(), ms1_traces.end(), [](const Trace& a, const Trace& b) {
  1999	      if (a.mz != b.mz) return a.mz < b.mz;
  2000	      if (a.rt != b.rt) return a.rt < b.rt;
  2001	      if (a.im != b.im) return a.im < b.im;
  2002	      return a.intensity < b.intensity;
  2003	    });
  2004	    double _t_win = 0, _c_win = 0;                             // [perf-instr] window loop (function scope)
  2005	    double _t_inf = phase_clock_(), _c_inf = cpu_seconds_();   // [perf-instr]
  2006	    vector<Precursor_> precursors = inferPrecursors_(ms1_traces, max_charge, delta_rt, iso_im_tol,
  2007	                                                     mass_ppm, env_scoring, ambig_margin);
  2008	    if (detOn_())
  2009	    {
  2010	      vector<uint64_t> b;
  2011	      for (const auto& pc : precursors) { uint64_t u; double v; v = pc.rt; std::memcpy(&u, &v, 8); b.push_back(u); v = pc.im; std::memcpy(&u, &v, 8); b.push_back(u); }
  2012	      writeLogInfo_("[det] precursors n=" + String(precursors.size()) + " digest=" + String(detDigest_(std::move(b))));
  2013	    }
  2014	    if (getFlag_("assembly:dedup_precursors"))
  2015	    {
  2016	      const size_t before = precursors.size();
  2017	      const size_t removed = dedupPrecursors_(precursors, ms1_traces, mass_ppm, delta_rt, delta_im);
  2018	      writeLogInfo_("Precursor dedup: removed " + String(removed) + " of " + String(before)
  2019	                    + " hypotheses (" + String((int)(1000.0 * removed / std::max<size_t>(before, 1)) / 10.0) + "%)");
  2020	    }
  2021	    // Emulate the reference implementation, which assigns a charge to every precursor: give isotope-unsupported
  2022	    // precursors the default charge (0 = keep the strict isotope-only behavior and drop them).
  2023	    const int default_charge = getIntOption_("assembly:default_charge");
  2024	    // rp_max = per-fragment precursor cap. 0 = share-all (stream, memory-light). competitive flag = rp_max 1.
  2025	    int rp_max = getIntOption_("assembly:rp_max");
  2026	    const double apportion = getDoubleOption_("assembly:apportion");
  2027	    if (getFlag_("assembly:competitive") && rp_max <= 0) rp_max = 1;
  2028	    Size n_default = 0;
  2029	    const bool open_safe = getFlag_("assembly:open_search_safe");
  2030	    // [way-4] A GUESSED charge and an isotope-SUPPORTED charge must not be emitted identically.
  2031	    // Closed search hides the difference (engine enumerates); open search does not.
  2032	    for (auto& pc : precursors)
  2033	      if (pc.charge == 0) { pc.guessed = true; pc.charge = open_safe ? 0 : default_charge; ++n_default; }
  2034	    // [emission] Isotope-support gate: drop the guessed singletons rather than emit them. They are
  2035	    // coordinate-distinct (merge/dedup cannot cut them) and identify 8.8x less often; dropping all
  2036	    // guessed cost 0.78% peptides for -39.5% emission on dataset D. OFF by default (open-search caveat).
  2037	    if (getFlag_("assembly:require_isotope_support"))
  2038	    {
  2039	      const size_t before = precursors.size();
  2040	      precursors.erase(std::remove_if(precursors.begin(), precursors.end(),
  2041	                       [](const Precursor_& pc){ return pc.guessed; }), precursors.end());
  2042	      writeLogInfo_("require_isotope_support: dropped " + String(before - precursors.size())
  2043	                    + " guessed precursors, " + String(precursors.size()) + " isotope-supported remain");
  2044	    }
  2045	    // [min-charge, 2026-09-03] 29.3% of dataset D emission is SINGLY-charged precursor hypotheses (271,559
  2046	    // spectra) and they carry 259 unique peptides, 1.73%. They are identified on 0.42% of their own
  2047	    // spectra against 15.3% for z=2 -- 36x less often. Tryptic peptides are essentially never 1+ in
