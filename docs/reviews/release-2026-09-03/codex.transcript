   854	    registerDoubleOption_("charge:mono_averagine_guard", "<slack>", 0.0, "[mono-guard] Reject a leftward isotope step (the walk that defines the MONOISOTOPE in charge:scoring=count) when the candidate peak is too weak to be a real lighter isotope under averagine. The partner search matches m/z, RT and IM but NEVER intensity, so it can latch onto a noise peak or a co-eluting species one isotope spacing below the true monoisotope -- making the reported precursor mass ~1.00335 Da TOO LIGHT. Closed search hides this (the engine enumerates isotope_errors and corrects it for free); OPEN/blind search turns it into a phantom -1.003 Da modification, and it is our single largest open-search delta-mass artefact on dataset D (8.20%% isotope-shifted PSMs vs the reference implementation's 3.46%%). The bound is averagine's LOOSEST: stepping from isotope m+1 to m the lighter peak is >= (m+1)/lambda times the heavier one, minimised at m=0 -> 1/lambda (lambda = 0.000594*neutral mass), so a value of 1.0 enforces exactly that minimum and never rejects a legitimate envelope; smaller values add slack for noise. 0 = off (old behaviour). [bench]", false);
   855	    registerFlag_("charge:mono_averagine_select", "[mono-select] Choose the MONOISOTOPE by averagine envelope fit over the whole isotope run found by the charge:scoring=count walk, instead of taking the furthest-left peak reached. 'Furthest-left' is a STOPPING rule and can only trade over-reach (mono ~1.003 Da too LIGHT, a phantom -1 Da modification in open search) for under-reach (+1.003 Da) -- measured: an averagine STOPPING guard cut the -1 artefact 64%% but tripled +1, because a walk that halts early also leaves the M+1 peak unconsumed so it seeds its own too-heavy precursor. This is a SCORING decision instead: score every candidate mono position in the run by cosine against the averagine envelope and keep the best. Every found peak is still consumed, so de-isotoping and emission are unchanged -- only the reported precursor mass moves. [bench]");
   856	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). A reviewer argued 0.01 (isotopes of one species share mobility, so 0.05 can admit cross-species partners), but 0.01 has NOT been measured on dataset D; change only behind the dataset D set gate.", false);
   857	    // ponytail: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
   858	  }
  1405	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  1406	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  1407	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  1408	  template <class Emit>
  1409	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  1410	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  1411	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
  1412	                        int min_corr_pts, vector<float>& pdense, Emit&& emit) const
  1413	  {
  1414	    const double G = (double)fg.rt.size();
  1415	    const vector<pair<double, double>>& p_xic = ms1_traces[pc.trace_idx].xic;
  1416	    // [wavelet] Correlate against a SMOOTHED precursor profile, as the reference implementation does. Only the
  1417	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  1418	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  1419	    // (the reference implementation smooths only the precursor side), and emitted peak intensities are unaffected
  1420	    // because they come from the fragment traces, not from here.
  1421	    const vector<double>* p_int = nullptr;
  1422	    if (wl_scale_ > 0.0)
  1423	    {
  1424	      const int lv = atrousLevels(p_xic, wl_scale_);
  1425	      if (lv > 0)
  1426	      {
  1427	        thread_local vector<double> raw_i, sm_i;   // window loop is parallel; scratch is per-thread
  1428	        raw_i.resize(p_xic.size());
  1429	        for (size_t i = 0; i < p_xic.size(); ++i) raw_i[i] = p_xic[i].second;
  1430	        atrousSmooth(raw_i, lv, sm_i);
  1431	        p_int = &sm_i;
  1432	      }
  1433	    }
  1434	    vector<int> touched;
  1435	    touched.reserve(p_xic.size());
  1436	    for (size_t pi = 0; pi < p_xic.size(); ++pi)
  1437	    {
  1438	      const auto& p = p_xic[pi];
  1439	      const double pval = p_int ? (*p_int)[pi] : p.second;
  1440	      auto it = lower_bound(fg.rt.begin(), fg.rt.end(), p.first);
  1441	      int gi = -1; double bd = delta_rt;
  1442	      for (auto c : {it == fg.rt.begin() ? it : prev(it), it})
  1443	      {
  1444	        if (c == fg.rt.end()) continue;
  1445	        double d = fabs(*c - p.first);
  1446	        if (d <= bd) { bd = d; gi = (int)(c - fg.rt.begin()); }
  1447	      }
  1448	      if (gi >= 0) { if (pdense[gi] == 0.0f) touched.push_back(gi); pdense[gi] += (float)pval; }
  1449	    }
  1450	    double psum = 0, psumsq = 0, plogsum = 0;
  1451	    // plogsum normalises the precursor profile for gate:coelution=logoverlap. Constant across
  1452	    // every fragment of this precursor, so hoist it out of the inner loop.
  1453	    for (int gi : touched)
  1454	    {
  1455	      double v = pdense[gi];
  1456	      psum += v; psumsq += v * v;
  1457	      if (log_overlap_) plogsum += std::log1p(v);
  1458	    }
  1459	    double pmean = psum / G, pvar = psumsq - G * pmean * pmean;
  1460	    double pinv = pvar > 0 ? 1.0 / sqrt(pvar) : 0.0;
  1461	    if (pinv > 0.0)
  1462	    {
  1463	      size_t lo = lower_bound(frag_im.begin(), frag_im.end(), pc.im - delta_im) - frag_im.begin();
  1464	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  1465	      for (size_t fi = lo; fi < hi; ++fi)
  1466	      {
  1467	        const Trace& f = frag_traces[fi];
  1468	        if (fabs(f.rt - pc.rt) > delta_rt) continue;                   // RT gate
  1469	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  1470	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  1471	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  1472	        // "fragments" (unfragmented survivors). SPEXTRACT_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  1473	        if (drop_prec_iso_ && pc.charge > 0)
  1474	        {
  1475	          bool iso = false;
  1476	          for (int k = 1; k <= 3 && !iso; ++k) iso = fabs(f.mz - (pc.mono_mz + k * 1.00335 / pc.charge)) < 0.01;
  1477	          if (iso) continue;
  1478	        }
  1479	        double dot = 0; int overlap = 0;
  1480	        // [R2-late, 2026-09-02] overlap <= support, so a fragment with fewer support points than
  1481	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  1482	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  1483	        if (fg.supEnd(fi) - fg.supBegin(fi) < (size_t)std::max(min_corr_pts, 0)) continue;
  1484	        for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1485	        { const auto& gv = fg.flat[k]; float pv = pdense[gv.first]; if (pv != 0.0f) { dot += (double)pv * gv.second; ++overlap; } }
  1486	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  1487	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  1488	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  1489	        // defect the adversarial review flagged. It rewards sparse fragments that happen to spike
  1490	        // where the precursor spikes, and its scale depends on G rather than on the evidence.
  1491	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  1492	        // independence, where one missing point does not zero the score (unlike a product) and
  1493	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  1494	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  1495	        // [0,1]. No zero padding, no dependence on G.
  1496	        double c;
  1497	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  1498	        {
  1499	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  1500	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  1501	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  1502	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  1503	          double fsum = 0.0, fsumsq = 0.0;
  1504	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1505	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  1506	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  1507	          double pm = psum / n, fm = fsum / n;
  1508	          double pv2 = psumsq - n * pm * pm, fv2 = fsumsq - n * fm * fm;
  1509	          if (pv2 <= 0.0 || fv2 <= 0.0) continue;                      // degenerate on union support
  1510	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  1511	        }
  1512	        else if (log_overlap_)
  1513	        {
  1514	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  1515	          // the intersection by the precursor's total log-intensity alone, which made the score
  1516	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  1517	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  1518	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  1519	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  1520	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  1521	          // which is what Pearson gets right and the first version did not.
  1522	          double fsum = 0.0;
  1523	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1524	            fsum += std::log1p((double)fg.flat[k].second);
  1525	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  1526	          double inter = 0.0;
  1527	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1528	          {
  1529	            const auto& gv = fg.flat[k];
  1530	            inter += std::min(std::log1p((double)gv.second) / fsum,
  1531	                              std::log1p((double)pdense[gv.first]) / plogsum);
  1532	          }
  1533	          c = inter;
  1534	        }
  1535	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  1536	        if (c < min_corr) continue;                                    // correlation gate
  1537	        emit(fi, c);
  1538	      }
  1539	    }
  1540	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  1541	  }
  1542	
  1543	  /// [wavelet] Assertions on the SHIPPED a-trous smoother. Each check corresponds to a way the
  1544	  /// transform could be wrong while still "looking smoothed" in a plot.
  1545	  ExitCodes selftestWavelet_()
  1546	  {
  1547	    int fail = 0;
  1548	    auto chk = [&](bool ok, const char* what) {
  1549	      if (!ok) { writeLogError_(String("FAIL: ") + what); ++fail; }
  1550	      else writeLogInfo_(String("  ok  ") + what);
  1551	    };
  1552	
  1553	    // 1. DC preservation. The B3 taps must sum to exactly 1: if they do not, smoothing RESCALES
  1554	    //    the precursor profile, and since Pearson is scale-invariant the error would be silent
  1555	    //    here but corrupt gate:coelution=logoverlap, which is NOT scale-invariant.
  1556	    {
  1557	      vector<double> flat(64, 7.5), out;
  1558	      atrousSmooth(flat, 4, out);
  1559	      double worst = 0.0;
  1560	      for (double v : out) worst = std::max(worst, fabs(v - 7.5));
  1561	      chk(worst < 1e-9, "DC preserved (constant signal unchanged)");
  1562	    }
  1563	
  1564	    // 2. Noise reduction, and 3. peak retention -- the two must hold TOGETHER, else "smoothing"
  1565	    //    is either a no-op or a peak destroyer. Deterministic pseudo-noise (no RNG dependence).
  1566	    {
  1567	      const int n = 128;
  1568	      vector<double> sig(n), noisy(n), out;
  1569	      for (int i = 0; i < n; ++i)
  1570	      {
  1571	        const double x = (i - 64.0) / 8.0;               // Gaussian peak, sigma = 8 samples
  1572	        sig[i] = 1000.0 * std::exp(-0.5 * x * x);
  1573	        noisy[i] = sig[i] + 60.0 * std::sin(i * 2.7) * std::cos(i * 1.31);   // high-frequency
  1574	      }
  1575	      atrousSmooth(noisy, 2, out);
  1576	      double e_in = 0, e_out = 0;
  1577	      for (int i = 0; i < n; ++i) { e_in += fabs(noisy[i] - sig[i]); e_out += fabs(out[i] - sig[i]); }
  1578	      chk(e_out < 0.75 * e_in, "noise reduced (residual vs clean peak shrinks >25%)");
  1579	      chk(out[64] > 0.80 * sig[64], "peak height retained (>80% at apex)");
  1580	    }
  1581	
  1582	    // 4. Mirror edges. Zero-padding would fabricate a downslope at a truncated peak -- the same
  1583	    //    bias the FWHM estimator avoids by excluding truncated traces.
  1584	    {
  1585	      vector<double> edge(32, 0.0), out;
  1586	      for (int i = 0; i < 32; ++i) edge[i] = 1000.0 - 25.0 * i;    // apex sits AT sample 0
  1587	      atrousSmooth(edge, 2, out);
  1588	      chk(out[0] > 0.85 * edge[0], "mirror boundary (edge apex not pulled toward zero)");
  1589	    }
  1590	
  1591	    // 5. Level selection follows the SAMPLING, not a constant. Two traces of the same physical
  1592	    //    width but different cycle times must get different level counts.
  1593	    {
  1594	      vector<pair<double, double>> fast, slow;
  1595	      for (int i = 0; i < 40; ++i) fast.emplace_back(i * 0.5, 100.0);   // dt = 0.5 s
  1596	      for (int i = 0; i < 40; ++i) slow.emplace_back(i * 2.0, 100.0);   // dt = 2.0 s
  1597	      const int lf = atrousLevels(fast, 4.0), ls = atrousLevels(slow, 4.0);
  1598	      chk(lf > ls, "levels scale with sampling (finer dt -> more levels)");
  1599	      chk(atrousLevels(fast, 0.0) == 0, "scale 0 disables smoothing");
  1600	      chk(atrousLevels(vector<pair<double, double>>(3, {1.0, 1.0}), 4.0) == 0, "too-short XIC -> 0 levels");
  1601	    }
  1602	
  1603	    writeLogInfo_(fail ? "[wavelet] SELFTEST FAILED" : "[wavelet] selftest passed");
  1604	    return fail ? UNEXPECTED_RESULT : EXECUTION_OK;
  1605	  }
  1606	
  1607	  /// Build a pseudo-MS2 from a fragment list (m/z,intensity) + ranking scores: keeps top
  1608	  /// max_frags by score, drops if < min_frags, annotates the synthetic precursor. Deterministic.
  1609	  void assembleFromList_(const Precursor_& pc, double win_lo, double win_hi,
  1610	                         vector<pair<double, double>>& frags, vector<double>& frag_scores,
  1611	                         Size min_frags, Size max_frags, MSSpectrum& out) const
  1612	  {
  1613	    if (frags.size() < min_frags) return;
  1614	    if (frags.size() > max_frags)
  1615	    {
  1616	      vector<size_t> idx(frags.size());
  1617	      for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  1618	      // [rank] Rank by correlation (ours) or by intensity (the reference implementation's "top N highest intensity").
  1619	      // The engine re-ranks by INTENSITY downstream (Sage max_peaks=150), so a correlation-ranked
  1620	      // cap can discard high-intensity peaks the engine would have scored. Ties break on m/z then
  1621	      // index in BOTH modes so the output stays deterministic.
  1622	      const bool by_int = rank_by_intensity_;
  1623	      partial_sort(idx.begin(), idx.begin() + max_frags, idx.end(), [&](size_t a, size_t b) {
  1624	        const double ka = by_int ? frags[a].second : frag_scores[a];
  1625	        const double kb = by_int ? frags[b].second : frag_scores[b];
  1626	        if (ka != kb) return ka > kb;
  1627	        if (frags[a].first != frags[b].first) return frags[a].first < frags[b].first;
  1628	        return a < b;
  1629	      });
  1630	      vector<pair<double, double>> keep; keep.reserve(max_frags);
  1631	      for (size_t i = 0; i < max_frags; ++i) keep.push_back(frags[idx[i]]);
  1632	      frags.swap(keep);
  1633	    }
  1634	    out.setMSLevel(2);
  1635	    out.setType(SpectrumSettings::SpectrumType::CENTROID);
  1636	    out.setRT(pc.rt);
  1637	    for (const auto& fr : frags) out.emplace_back(fr.first, fr.second);
  1638	    out.sortByPosition();
  1639	    OpenMS::Precursor prec;
  1640	    prec.setMZ(pc.mono_mz);
  1641	    if (pc.charge > 0) prec.setCharge(pc.charge);
  1642	    prec.setIsolationWindowLowerOffset(max(0.0, pc.mono_mz - win_lo));   // [C-5]
  1643	    prec.setIsolationWindowUpperOffset(max(0.0, win_hi - pc.mono_mz));
  1644	    prec.setDriftTime(pc.im);
  1645	    prec.setDriftTimeUnit(DriftTimeUnit::VSSC);
  1646	    out.setPrecursors({prec});
  1647	    // [provenance] Stamp the inference class onto the emitted spectrum so identified peptides can be
  1648	    // joined back to guessed (no isotope support) vs isotope-supported precursors -- the number that
  1649	    // sets the peptide cost of an isotope-support gate. Written as a <userParam> in the mzML.
  1650	    out.setMetaValue("spx_guessed", (int)(pc.guessed ? 1 : 0));
  1651	    // [Q4] Isotope-offset hypothesis for open/blind search: the number of isotope peaks behind the
  1652	    // mono call. 0/1 => the mono is weakly determined and could be off by +-k*1.00335 Da, so a
  1653	    // downstream delta-mass corrector should treat a near-integer-Da delta as an isotope miscall to
  1654	    // reassign rather than a real modification. This is the metadata assembly:open_search_safe's doc
  1655	    // promised but never wrote (only spx_guessed was stamped). Harmless in closed search (ignored).
  1656	    out.setMetaValue("spx_n_isotopes", pc.n_isotopes);
  1657	  }
  1658	
  1659	  /// [E5, 2026-09-02] The ONE place the emitted-intensity weights live. Returns {cap-key intensity,
  1660	  /// emitted intensity}: the IM-proximity weight feeds both (IM-on-c, orthogonal to correlation); the
  1661	  /// [Q2] correlation-power weight feeds ONLY the emitted (engine-visible) intensity -- putting it in the
  1662	  /// cap key made frag_scores = base*c^(k+1) and double-hit borderline-c faint fragments at the 500-cap.
  1663	  /// Until today apportion and rp_max emitted RAW intensities, so every A/B of those flags silently
  1664	  /// compared corr_power=2 against corr_power=0.
  1665	  pair<double, double> weighted_(double base, double c, double dim) const
  1666	  {
  1667	    double inten = base;
  1668	    if (im_weight_sigma_ > 0.0) inten *= std::exp(-(dim * dim) / (2.0 * im_weight_sigma_ * im_weight_sigma_));
  1669	    double emit_inten = inten;
  1670	    if (corr_power_ > 0.0 && c > 0.0) emit_inten *= std::pow(c, corr_power_);
  1671	    return {inten, emit_inten};
  1672	  }
  1673	
  1674	  /// Per-precursor assembly: this precursor claims every fragment passing its gate (a fragment may
  1675	  /// be shared across precursors -> chimeric). Leaves @p out empty on failure.
  1676	  void assembleOne_(const Precursor_& pc, double win_lo, double win_hi,
  1677	                    const vector<Trace>& frag_traces, const vector<double>& frag_im,
  1678	                    const vector<Trace>& ms1_traces, const FragGrid& fg,
  1679	                    double delta_im, double delta_rt, double min_corr, int min_corr_pts,
  1680	                    Size min_frags, Size max_frags, vector<float>& pdense, MSSpectrum& out) const
  1681	  {
  1682	    vector<pair<double, double>> frags;
  1683	    vector<double> frag_scores;
  1684	    scoreCandidates_(pc, frag_traces, frag_im, ms1_traces, fg, delta_im, delta_rt, min_corr,
  1685	                     min_corr_pts, pdense, [&](size_t fi, double c) {
  1686	      const auto [inten, emit_inten] = weighted_(frag_traces[fi].intensity, c, frag_im[fi] - pc.im);
  1687	      frags.emplace_back(frag_traces[fi].mz, emit_inten);
  1688	      frag_scores.push_back(c * inten);
  1689	    });
  1690	    assembleFromList_(pc, win_lo, win_hi, frags, frag_scores, min_frags, max_frags, out);
  1691	  }
