  2457	          // buffer assembleOne_ writes through, so it must be firstprivate: sharing it across
  2458	          // threads is precisely the corruption the reverted attempt suffered.
  2459	          //
  2460	          // Order-safety: a canonical total-order sort over all_out runs after the window loop
  2461	          // (RT, precursor m/z, charge, then fragment sequence), so emission order is already
  2462	          // thread-count-independent. Only slot CONTENTS matter here.
  2463	          // THREAD CAP -- this region is NESTED inside the window loop (num_threads(n_conc)).
  2464	          // Without a cap it requests the full team PER WINDOW, i.e. n_conc x omp_get_max_threads()
  2465	          // threads on a fixed core count. That is precisely the defect diagnosed in
  2466	          // ElutionPeakDetection.cpp:328 (a bare parallel-for with no num_threads, reached from
  2467	          // inside this same loop, measured at 43.5% kernel time) -- reproduced here by omission.
  2468	          // Divide the budget instead of multiplying it.
  2469	          int p_team = 1;
  2470	#ifdef _OPENMP
  2471	          p_team = std::max(1, omp_get_max_threads() / std::max(n_conc, 1));
  2472	#endif
  2473	          auto _t5 = std::chrono::steady_clock::now();
  2474	          vector<MSSpectrum> pslot(phi > plo ? phi - plo : 0);
  2475	          #pragma omp parallel for schedule(dynamic, 32) firstprivate(pdense) num_threads(p_team)
  2476	          for (long pii = (long)plo; pii < (long)phi; ++pii)
  2477	          {
  2478	            const size_t pi = (size_t)pii;
  2479	            const Precursor_& pc = precursors[pi];
  2480	            if (!std::isfinite(pc.rt) || !std::isfinite(pc.im)) continue;
  2481	            MSSpectrum ms2;
  2482	            assembleOne_(pc, win_lo, win_hi, frag_traces, frag_im, ms1_traces, fg,
  2483	                         delta_im, delta_rt, min_corr, min_corr_pts, min_frags, max_frags, pdense, ms2);
  2484	            if (!ms2.empty()) pslot[pi - plo] = std::move(ms2);
  2485	          }
  2486	          auto _t6 = std::chrono::steady_clock::now();
  2487	          t_score += std::chrono::duration_cast<std::chrono::nanoseconds>(_t6 - _t5).count();
  2488	          for (auto& s : pslot) if (!s.empty()) bucket.push_back(std::move(s));
  2489	          t_emit += std::chrono::duration_cast<std::chrono::nanoseconds>(
  2490	                      std::chrono::steady_clock::now() - _t6).count();
  2491	        }
  2492	        else
  2493	        {
  2494	          // Soft RP rank-pruning (rp_max>=1; 1 == competitive): keep each fragment in only its
  2495	          // top-rp_max best-correlating precursors. Pass A: per fragment, a bounded top-rp_max heap of
  2496	          // (corr,pi) + total gate count for the fan-out histogram. Pass B: assemble per winning precursor.
  2497	          const size_t NF = frag_traces.size();
  2498	          vector<vector<pair<double, long>>> topk(NF); // ascending by corr; back() = weakest kept
  2499	          vector<uint32_t> nfan(NF, 0);                 // total precursors that gated this fragment
  2500	          for (size_t pi = plo; pi < phi; ++pi)
  2501	          {
  2502	            const Precursor_& pc = precursors[pi];
  2503	            if (!std::isfinite(pc.rt) || !std::isfinite(pc.im)) continue;
  2504	            scoreCandidates_(pc, frag_traces, frag_im, ms1_traces, fg, delta_im, delta_rt, min_corr,
  2505	                             min_corr_pts, pdense, [&](size_t fi, double c) {
  2506	              ++nfan[fi];
  2507	              auto& tk = topk[fi];
  2508	              // insertion sort into a size-<=rp_max list kept ascending; deterministic tie-break on pi.
  2509	              if ((int)tk.size() < rp_max) {
  2510	                tk.emplace_back(c, (long)pi);
  2511	                for (size_t j = tk.size() - 1; j > 0 && (tk[j].first < tk[j-1].first ||
  2512	                     (tk[j].first == tk[j-1].first && tk[j].second < tk[j-1].second)); --j)
  2513	                  std::swap(tk[j], tk[j-1]);
  2514	              } else if (c > tk.front().first || (c == tk.front().first && (long)pi < tk.front().second)) {
  2515	                tk.front() = {c, (long)pi};
  2516	                for (size_t j = 1; j < tk.size() && (tk[j-1].first > tk[j].first ||
  2517	                     (tk[j-1].first == tk[j].first && tk[j-1].second > tk[j].second)); ++j)
  2518	                  std::swap(tk[j-1], tk[j]);
  2519	              }
  2520	            });
  2521	          }
