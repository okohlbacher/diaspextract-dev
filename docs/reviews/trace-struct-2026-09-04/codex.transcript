  2309	  void assembleFromList_(const Precursor_& pc, double win_lo, double win_hi,
  2310	                         vector<pair<double, double>>& frags, vector<double>& frag_scores,
  2311	                         Size min_frags, Size max_frags, MSSpectrum& out) const
  2312	  {
