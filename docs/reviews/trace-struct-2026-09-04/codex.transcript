   220	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   221	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   222	  inline uint32_t rtIndex(double rt)
   223	  {
   224	    const vector<double>& a = rtAxis();
   225	    if (a.empty()) return 0;
   226	    auto it = lower_bound(a.begin(), a.end(), rt);
   227	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   228	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   229	    return (uint32_t)(it - a.begin());
   230	  }
