  2886	      fp.close();
  2887	      writeLogInfo_("MS1 funnel dump: " + String(ms1_traces.size()) + " traces, "
  2888	                    + String(precursors.size()) + " precursors -> " + ms1_dump + ".{traces,precursors}.tsv");
  2889	    }
  2890	    // sort precursors by mono m/z so each window can binary-search its members instead of
  2891	    // rescanning all ~1M precursors per window (total order for determinism). [code-review]
  2892	    sort(precursors.begin(), precursors.end(), [](const Precursor_& a, const Precursor_& b) {
