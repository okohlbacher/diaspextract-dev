  1723	
  1724	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1725	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1726	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1727	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1728	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1729	  {
  1730	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1731	    out.assign(n, 0.0);
  1732	    double term = 1.0;
  1733	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1734	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1735	    if (mx > 0) for (double& v : out) v /= mx;
  1736	  }
  1737	
  1738	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1739	  {
  1740	    double dot = 0, na = 0, nb = 0;
  1741	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1742	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1743	  }
  1744	
  1745	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1746	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1747	  /// coincidental peak at the right m/z spacing usually does not.
  1748	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1749	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1750	  static double xicCorr(const Trace& a, const Trace& b, double /*rt_tol*/)
  1751	  {
  1752	    size_t i = 0, j = 0; double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1753	    while (i < a.np() && j < b.np())
  1754	    {
  1755	      if (a.xi[i] == b.xi[j])
  1756	      { const double x = a.intAt(i), y = b.intAt(j);
  1757	        sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; ++i; ++j; }
  1758	      else if (a.xi[i] < b.xi[j]) ++i; else ++j;
  1759	    }
  1760	    if (m < 3) return -2.0;
  1761	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1762	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1763	  }
  1764	
  1765	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1766	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1767	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, int max_charge,
  1768	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1769	                                      bool envelope_scoring, double ambig_margin)
