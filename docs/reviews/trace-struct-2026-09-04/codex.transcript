   659	  inline bool memOn() { static const bool on = std::getenv("SPEXTRACT_MEM_LEDGER") != nullptr; return on; }
   660	  inline void memAdd(int c, long long bytes)
   661	  {
   662	    if (!memOn() || bytes <= 0) return;
   663	    const long long now = memCur()[c].fetch_add(bytes) + bytes;
   664	    long long p = memPeak()[c].load();
   665	    while (now > p && !memPeak()[c].compare_exchange_weak(p, now)) {}
   666	    long long tot = 0; for (int i = 0; i < MEM_N; ++i) tot += memCur()[i].load();
   667	    long long tp = memTotalPeak().load();
   668	    while (tot > tp && !memTotalPeak().compare_exchange_weak(tp, tot)) {}
   669	  }
   670	  inline void memSub(int c, long long bytes) { if (memOn() && bytes > 0) memCur()[c].fetch_sub(bytes); }
