   681	  struct PeakSlab
   682	  {
   683	    vector<uint32_t> frame_off;    ///< size F+1: frame f owns [frame_off[f], frame_off[f+1])
   684	    vector<uint32_t> rt_index;     ///< size F: the frame's index on the GLOBAL RT axis
   685	    vector<TofIdx>   tof;          ///< flight-time bin, ascending within a frame
   686	    vector<double>   b;            ///< size F: the frame's calibration factor (bin -> m/z)
   687	    vector<float>    inten;
   688	    vector<uint16_t> imq;          ///< the store's quantised 1/K0, kept for export
   689	    size_t frames() const { return rt_index.size(); }
   690	    size_t peaks()  const { return tof.size(); }
