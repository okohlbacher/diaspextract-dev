  2828	      writeLogInfo_("SPEXTRACT_PRECURSOR_LIST: " + String(refs.size()) + " reference precursors; kept "
  2829	                    + String(precursors.size()) + " of " + String(before) + " (matched within 10 s / 10 ppm / z)");
  2830	    }
  2831	    // [ms1-funnel] Measured recall against a DIA-NN truth set is 74.3% vs diaTracer's 84.4%, but a
  2832	    // single number cannot say WHERE a precursor is lost: no MS1 trace at all, a trace that never
  2833	    // became a hypothesis, or a hypothesis that never produced a spectrum. Dump both upstream
  2834	    // stages so the loss can be attributed to one of them instead of guessed at.
