   692	
   693	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   694	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   695	  PeakSlab toSlab(vector<CompactFrame>& frames)
   696	  {
   697	    PeakSlab sl;
   698	    const size_t F = frames.size();
   699	    sl.frame_off.resize(F + 1, 0);
   700	    sl.rt_index.resize(F);
   701	    size_t total = 0;
   702	    for (const auto& f : frames) total += f.mzq.size();
   703	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   704	    sl.b.resize(F);
   705	    const TofAxis& ax = tofAxis();
   706	    for (size_t i = 0; i < F; ++i)
   707	    {
   708	      CompactFrame& f = frames[i];
   709	      sl.rt_index[i] = rtIndex(f.rt);
   710	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   711	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   712	      // introduced here, and the loader does not have to change.
   713	      const double b = ax.factor(f.frame_id);
   714	      sl.b[i] = b;
   715	      sl.frame_off[i] = (uint32_t)sl.tof.size();
   716	      for (size_t k = 0; k < f.mzq.size(); ++k)
   717	        sl.tof.push_back(ax.tofOf((double)f.mzq[k] / MZ_Q, b));
   718	      sl.inten.insert(sl.inten.end(), f.inten.begin(), f.inten.end());
   719	      sl.imq.insert(sl.imq.end(), f.imq.begin(), f.imq.end());
   720	      vector<uint32_t>().swap(f.mzq);
   721	      vector<float>().swap(f.inten);
   722	      vector<uint16_t>().swap(f.imq);
   723	    }
   724	    sl.frame_off[F] = (uint32_t)sl.tof.size();
   725	    // The extension loop steps frames by index and takes the RT span as last minus first, so the
   726	    // frames must be in RT order -- the OpenMS path sorts its spectra for the same reason. The
   727	    // loader delivers them ordered; this checks rather than assumes.
   728	    for (size_t i = 1; i < F; ++i)
   729	      if (sl.rt_index[i] < sl.rt_index[i - 1])
   730	        throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   731	              "window frames are not in retention-time order at frame", std::to_string(i));
   732	    return sl;
   733	  }
