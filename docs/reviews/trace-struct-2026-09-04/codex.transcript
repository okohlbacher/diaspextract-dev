  2359	  /// [E5, 2026-09-02] The ONE place the emitted-intensity weights live. Returns {cap-key intensity,
  2360	  /// emitted intensity}: the IM-proximity weight feeds both (IM-on-c, orthogonal to correlation); the
  2361	  /// [Q2] correlation-power weight feeds ONLY the emitted (engine-visible) intensity -- putting it in the
  2362	  /// cap key made frag_scores = base*c^(k+1) and double-hit borderline-c faint fragments at the 500-cap.
  2363	  /// Until today apportion and rp_max emitted RAW intensities, so every A/B of those flags silently
  2364	  /// compared corr_power=2 against corr_power=0.
  2365	  pair<double, double> weighted_(double base, double c, double dim) const
  2366	  {
  2367	    double inten = base;
