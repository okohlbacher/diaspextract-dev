   180	        return a == std::string::npos ? std::string("?") : v.substr(a);
   181	      };
   182	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   183	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   184	    }
   185	    return " [RSS " + cur + ", peak " + peak + "]";
