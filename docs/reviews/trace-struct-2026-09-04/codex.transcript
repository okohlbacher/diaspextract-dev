   296	
   297	  Trace toTrace(const MassTrace& mt)
   298	  {
   299	    Trace t;
   300	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   301	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   302	    // `trace:mz_estimator` -- see docs/S30-BASELINE.md for the comparison that chose apex.
   303	    const std::string& mz_est = mzEstimator();
   304	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   305	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   306	    else t.mz = mt.getCentroidMZ();
   307	    t.rt = mt.getCentroidRT();
   308	    t.im = mt.getCentroidIM();
   309	    t.intensity = mt.getMaxIntensity(false);
   310	    // MassTrace peaks are not guaranteed RT-ordered, and the profile must be ascending for the
   311	    // correlation loops, so index them and sort the small (index, intensity) pairs.
   312	    const Size np = mt.getSize();
   313	    vector<pair<uint32_t, float>> pts;
   314	    pts.reserve(np);
   315	    for (Size i = 0; i < np; ++i) pts.emplace_back(rtIndex(mt[i].getRT()), (float)mt[i].getIntensity());
   316	    sort(pts.begin(), pts.end());
   317	    t.xi.reserve(np); t.xv.reserve(np);
   318	    for (const auto& q : pts) { t.xi.push_back(q.first); t.xv.push_back(q.second); }
   319	    return t;
   320	  }
