  1929	        // M+2 previously killed the whole walk). Try the seed AND up to 3 isotopes below it as the
  1930	        // monoisotope candidate; averagine decides which one really is the mono.
  1931	        for (int lead = 0; lead <= 3; ++lead)
  1932	        {
  1933	          const double mono_mz = s.mz - lead * ISO / z;
  1934	          long mono_idx = (lead == 0) ? (long)seed : findPartner(mono_mz);
  1935	          if (lead > 0 && mono_idx < 0) continue;
  1936	          const double neutral = mono_mz * z - z * PROTON_;
  1937	          if (neutral < 400.0 || neutral > 6000.0) continue;
