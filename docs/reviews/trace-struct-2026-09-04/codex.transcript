   672	  struct MemGuard
   673	  {
   674	    int c; long long b;
   675	    MemGuard(int cat, long long bytes) : c(cat), b(bytes) { memAdd(c, b); }
   676	    void grow(long long extra) { memAdd(c, extra); b += extra; }
   677	    ~MemGuard() { memSub(c, b); }
