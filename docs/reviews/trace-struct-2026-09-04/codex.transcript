  2294	  /// Build a pseudo-MS2 from a fragment list (m/z,intensity) + ranking scores: keeps top
  2295	  /// max_frags by score, drops if < min_frags, annotates the synthetic precursor. Deterministic.
  2296	  /// EXPORT-TIME CALIBRATION. On a flight-time axis the measured quantity is a bin; m/z is a
  2297	  /// calibrated function of it and of the frame's digitizer temperature. Applying that function
  2298	  /// ONCE, here, when the value is written, is what keeps the reported mass free of anything the
  2299	  /// intermediate gates did in cached m/z space -- and the apex frame's own factor is the most
  2300	  /// accurate one to use. A zero bin means the trace came from the OpenMS detector, which has no
  2301	  /// bin, and the value it computed stands.
  2302	  static double exportMz_(uint32_t tof, double b, double cached)
  2303	  {
  2304	    if (tof == 0 || !(b > 0.0) || !tofAxis().ok) return cached;
  2305	    const double v = tofAxis().mzOf(tof, b);
  2306	    return std::isfinite(v) && v > 0.0 ? v : cached;
  2307	  }
