    57	
    58	/**
    59	  @page TOPP_DIAPseudoSpectra DIAPseudoSpectra
    60	
    61	  @brief Extracts pseudo-MS/MS ("pseudo-DDA") spectra from diaPASEF (ion-mobility DIA) data.
    62	
    63	  Reconstructs DDA-like MS2 spectra from ion-mobility DIA (timsTOF / diaPASEF) data by
    64	  exploiting the fact that, in PASEF, fragments are recorded at the ion-mobility (1/K0)
    65	  elution coordinate of their precursor. Precursor and fragment mass traces are detected
    66	  IM-aware (@ref MassTraceDetection with an ion-mobility tolerance), then fragments are
    67	  assigned to a precursor when they co-localize in ion mobility, retention time, and
    68	  elution-profile (Pearson) correlation. The result is written as searchable mzML.
    69	
    70	  This is the OpenMS-native, BSD-3 analogue of Nesvilab diaTracer. It is a discovery
    71	  front-end (enables open / semi-tryptic / PTM searches); it does not perform the database
    72	  search, FDR, library building or quantification.
    73	
    74	  See docs/S30-BASELINE.md for the measured decisions behind every default, and docs/reviews/
    75	  for the adversarial reviews.
    76	
    77	  <B>The command line parameters of this tool are:</B>
    78	  @verbinclude TOPP_DIAPseudoSpectra.cli
    79	  <B>INI file documentation of this tool:</B>
    80	  @htmlinclude TOPP_DIAPseudoSpectra.html
    81	*/
    82	
    83	/// @cond TOPPCLASSES
    84	
    85	namespace
    86	{
    87	  /// A detected mass trace reduced to the quantities we correlate/gate on.
    88	  /// Current + peak resident set, read from /proc/self/status (Linux). Logged at phase boundaries so
    89	  /// the memory peak is MEASURED rather than estimated: it tells us whether the peak sits in the
    90	  /// raw-load phase or in the parallel per-window phase. Returns "" where unsupported. [mem]
    91	  /// seconds since tool start, for per-phase bottleneck attribution [perf]
    92	  static double phase_clock_()
    93	  {
    94	    static const auto t0 = std::chrono::steady_clock::now();
    95	    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
    96	  }
    97	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
    98	
    99	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
   100	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
   101	  /// printed unconditionally at the end so a benchmark log always says where the time went.
   102	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
   103	  inline double& flush_wall_() { static double v = 0; return v; }   // [perf-load] pick inside LOAD
   104	  inline std::map<std::string, PhaseStat>& phase_stats_()
   105	  { static std::map<std::string, PhaseStat> m; return m; }
   106	  inline std::vector<std::string>& phase_order_()
   107	  { static std::vector<std::string> v; return v; }
   108	  static double cpu_seconds_()
   109	  {
   110	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   111	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
   112	    return ru.ru_utime.tv_sec + ru.ru_utime.tv_usec * 1e-6
   113	         + ru.ru_stime.tv_sec + ru.ru_stime.tv_usec * 1e-6;
   114	  }
