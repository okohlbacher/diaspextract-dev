   810	  vector<Trace> detectTracesInteger_(const PeakSlab& sl, const TracePrep& tp, double mass_ppm,
   811	                                     double im_tol, double min_len_sec, double min_sample_rate,
   812	                                     double max_len_sec, TofIdx band_lo = 0, TofIdx band_hi = 0)
   813	  {
   814	    vector<Trace> out;
   815	    const size_t F = sl.frames(), P = sl.tof.size();
   816	    if (F == 0 || P == 0) return out;
   817	    const bool banded = band_hi > band_lo;
   818	    const TofAxis& ax = tofAxis();
   819	    const double msr = min_sample_rate >= 0.0 ? min_sample_rate : 0.5;   // -1 = OpenMS default
   820	    const double imq_tol = im_tol * IM_Q;
   821	    const Size max_missed = 5;                                            // trace_termination_outliers
   822	    const vector<uint32_t>& frame_of = tp.frame_of;
   823	    const vector<char>& member = tp.member;
   824	
   825	    vector<char> visited(P, 0);                    // the only per-band P-sized array
   826	    MemGuard g_vis(MEM_VISITED, vbytes(visited));  // x n_bands concurrently: the thing to watch
   827	    auto mzAt = [&](uint32_t k) { return ax.mzOf(sl.tof[k], sl.b[frame_of[k]]); };
   828	    auto iwm = [](double v, double w, double& c, double& cnt, double& den) {   // updateIterativeWeightedMean_
   829	      const double ct = 1.0 + (w * v) / cnt, dt = 1.0 + w / den;
   830	      c *= (ct / dt); cnt += w * v; den += w;
   831	    };
   832	    auto sdRobust = [](double mz, double w, double mean, double& sd, double& wsum) {   // updateWeightedSDEstimateRobust
   833	      const double d1 = std::log(wsum) + 2.0 * std::log(sd);
   834	      const double d2 = std::log(w) + 2.0 * std::log(std::abs(mz - mean));
   835	      const double denom = std::sqrt(std::exp(d1) + std::exp(d2));
   836	      const double ws = wsum + w;
   837	      const double t = denom / std::sqrt(ws);
   838	      if (t > std::numeric_limits<double>::epsilon()) sd = t;
   839	      wsum = ws;
   840	    };
   841	    /// findBestPeak_ + isPeakAcceptable_: the closest peak in m/z within +-3 sd of the running
   842	    /// centroid whose mobility is inside the gate; -1 for "no candidate", and `taken` set when the
   843	    /// closest one is already used, which OpenMS counts as a miss rather than trying the next.
   844	    /// The +-3 sd window is converted to a BIN range once per frame step, so the walk is bounded
   845	    /// by two calibration calls and a binary search; only candidates inside that window are
   846	    /// converted back to m/z for the comparison.
   847	    auto best = [&](size_t f, double cmz, double sd, double cim, bool& taken) -> long {
   848	      taken = false;
   849	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
   850	      if (b <= a) return -1;
   851	      const double bf = sl.b[f];
   852	      const double lo_mz = cmz - 3.0 * sd, hi_mz = cmz + 3.0 * sd;
   853	      const TofIdx lo_t = ax.tofOf(lo_mz > 0.0 ? lo_mz : 1e-9, bf);
   854	      const TofIdx hi_t = ax.tofOf(hi_mz, bf);
   855	      const uint32_t s0 = (uint32_t)(lower_bound(sl.tof.begin() + a, sl.tof.begin() + b, lo_t) - sl.tof.begin());
   856	      long bk = -1; double bd = std::numeric_limits<double>::infinity();
   857	      for (uint32_t k = s0; k < b && sl.tof[k] <= hi_t; ++k)
   858	      {
   859	        if (!member[k]) continue;
   860	        if (std::abs((double)sl.imq[k] - cim) > imq_tol) continue;
   861	        // "Closest" is measured in m/z, as OpenMS does, NOT in bins: I had argued the calibration
   862	        // is monotone so the two agree, and that is true only for candidates on the same side of
   863	        // the centroid -- across it, the map's curvature can flip which is nearer. Measured: the
   864	        // bin metric cost 1.4% of peptides (12,650 -> 12,466) and bought no time (the speed came
   865	        // from parallel valley splitting). The walk is still bounded in bins; only candidates
   866	        // inside the window pay the conversion.
   867	        const double d = std::abs(ax.mzOf(sl.tof[k], bf) - cmz);
   868	        if (d < bd) { bd = d; bk = (long)k; }          // strict <: first of equals wins
   869	      }
   870	      if (bk >= 0 && visited[(size_t)bk]) { taken = true; return -1; }
   871	      return bk;
   872	    };
   873	
   874	    struct Dir { Size hits = 0, missed = 0, scans = 0; bool active = true; };
   875	    vector<uint32_t> got;                 // provisional members, marked only if the trace is valid
   876	    for (uint32_t seed : tp.order)
   877	    {
   878	      if (banded && (sl.tof[seed] < band_lo || sl.tof[seed] >= band_hi)) continue;   // not this band's core
   879	      if (visited[seed]) continue;
   880	      const size_t f0 = frame_of[seed];
   881	      const double w0 = sl.inten[seed], m0 = mzAt(seed);
   882	      double cmz = m0, cnt = w0 * m0, den = w0;
   883	      iwm(m0, w0, cmz, cnt, den);                             // seed counted twice, as run_ does
   884	      double cim = sl.imq[seed], cnt_im = w0 * cim, den_im = w0;
   885	      iwm((double)sl.imq[seed], w0, cim, cnt_im, den_im);
   886	      double sd = (cmz / 1e6) * mass_ppm, wsum = w0;
   887	      got.clear(); got.push_back(seed);
   888	      Dir dn, up;
   889	      long fd = (long)f0, fu = (long)f0;
   890	      while ((fd > 0 && dn.active) || (fu + 1 < (long)F && up.active))
   891	      {
   892	        for (int side = 0; side < 2; ++side)
   893	        {
   894	          Dir& d = side == 0 ? dn : up;
   895	          long& fi = side == 0 ? fd : fu;
   896	          if (!d.active) continue;
   897	          if (side == 0 ? !(fi > 0) : !(fi + 1 < (long)F)) continue;
   898	          const size_t f = (size_t)(side == 0 ? fi - 1 : fi + 1);
   899	          // "empty" AFTER sub-noise deletion, as OpenMS tests it. SPEXTRACT_INT_EMPTY_RAW=1 tests
   900	          // raw emptiness instead: the A/B that attributes the 12,650 -> 12,466 move between the
   901	          // two corrected versions, which is the only semantic change between them.
   902	          static const bool empty_raw = std::getenv("SPEXTRACT_INT_EMPTY_RAW") != nullptr;
   903	          if (empty_raw ? (sl.frame_off[f + 1] > sl.frame_off[f]) : (bool)tp.frame_live[f])
   904	          {
   905	            bool taken = false;
   906	            const long k = best(f, cmz, sd, cim, taken);
   907	            if (k >= 0)
   908	            {
   909	              const double mz = mzAt((uint32_t)k), w = sl.inten[k];
   910	              iwm(mz, w, cmz, cnt, den);
   911	              iwm((double)sl.imq[k], w, cim, cnt_im, den_im);
   912	              sdRobust(mz, w, cmz, sd, wsum);   // reestimate_mt_sd: the tool never turns it off
   913	              got.push_back((uint32_t)k);
   914	              ++d.hits; d.missed = 0;
   915	            }
   916	            else ++d.missed;
   917	          }
   918	          fi += (side == 0 ? -1 : 1);
   919	          ++d.scans;
   920	          if (d.missed > max_missed) d.active = false;
   921	        }
   922	      }
   923	      // isTraceValid_
   924	      uint32_t fmin = frame_of[got[0]], fmax = fmin;
   925	      for (uint32_t k : got) { fmin = std::min(fmin, frame_of[k]); fmax = std::max(fmax, frame_of[k]); }
   926	      const double span_s = rtAxis()[sl.rt_index[fmax]] - rtAxis()[sl.rt_index[fmin]];
   927	      if (span_s < min_len_sec) continue;
   928	      if (max_len_sec > 0.0 && span_s > max_len_sec) continue;   // the tool passes 0 for "off"
   929	      const Size total = dn.scans + up.scans + 1;
   930	      const Size adjusted = total > dn.missed + up.missed ? total - dn.missed - up.missed : 1;
   931	      if ((double)got.size() / (double)adjusted < msr) continue;
   932	      for (uint32_t k : got) visited[k] = 1;                  // valid: now they are taken
   933	
   934	      // profile in frame order; pair BEFORE sorting (the first version sorted one array alone)
   935	      vector<pair<uint32_t, uint32_t>> pts;                   // (frame, peak)
   936	      pts.reserve(got.size());
   937	      for (uint32_t k : got) pts.emplace_back(frame_of[k], k);
   938	      sort(pts.begin(), pts.end());
   939	      Trace t;
   940	      t.xi.reserve(pts.size()); t.xv.reserve(pts.size()); t.xt.reserve(pts.size());
   941	      size_t ap = 0;
   942	      for (size_t q = 0; q < pts.size(); ++q)
   943	      {
   944	        t.xi.push_back(sl.rt_index[pts[q].first]); t.xv.push_back(sl.inten[pts[q].second]);
   945	        t.xt.push_back(sl.tof[pts[q].second]);
   946	        if (t.xv[q] > t.xv[ap]) ap = q;
   947	      }
   948	      const uint32_t kap = pts[ap].second;
   949	      t.tof = sl.tof[kap]; t.b = sl.b[frame_of[kap]];
   950	      t.mz = cmz;                                              // the weighted centroid, as OpenMS reports
   951	      t.rt = rtAxis()[t.xi[ap]];
   952	      t.im = IM_LO + cim / IM_Q;
   953	      t.intensity = t.xv[ap];
   954	      memAdd(MEM_TRACES, vbytes(t.xi) + vbytes(t.xv) + vbytes(t.xt) + (long long)sizeof(Trace));
   955	      out.push_back(std::move(t));
   956	    }
   957	    return out;
   958	  }
   959	
   960	  /// ElutionPeakDetection on a trace list -- the identical step the OpenMS path runs inside
   961	  /// detectTraces_ (same parameters), lifted out so the integer detector's output goes through it
   962	  /// too. The review of the first integer version found this step silently skipped.
   963	  vector<MassTrace> splitValleys(vector<MassTrace>& in, double split_valleys)
   964	  {
   965	    if (split_valleys <= 0.0 || in.empty()) return std::move(in);
   966	    ElutionPeakDetection epd;
   967	    epd.setLogType(ProgressLogger::NONE);
   968	    Param ep = epd.getParameters();
   969	    ep.setValue("chrom_fwhm", split_valleys);
   970	    ep.setValue("width_filtering", "off");
   971	    ep.setValue("masstrace_snr_filtering", "false");
   972	    epd.setParameters(ep);
   973	    vector<MassTrace> out; out.reserve(in.size());
   974	    epd.detectPeaks(in, out);
   975	    return out;
   976	  }
   977	
   978	  /// Integer traces -> MassTrace objects for EPD -> Trace again, with the flight-time bin
   979	  /// re-attached from the apex frame's calibration. Only the TRACES become OpenMS objects -- the
   980	  /// peak arrays never do, which is the point of the integer path.
   981	  ///
   982	  /// CHUNKED AND PARALLEL, like the OpenMS path's own valley-splitting step (do_split over
   983	  /// bands*4 chunks as tasks). The previous version converted every trace of a window into a
   984	  /// MassTrace (a list<Peak2D>, ~48 B/point) on ONE thread and then ran ElutionPeakDetection over
   985	  /// all of them at once, also on one thread: a serial section of a stage that is 95% of the window
   986	  /// loop, and the whole window's list-based copy alive at the same time. That is consistent with
   987	  /// what was measured -- occupancy 44x against 81x for the OpenMS path, and MORE peak memory,
   988	  /// after the per-band sorts and the per-visit calibration calls had already been removed and
   989	  /// changed nothing.
   990	  vector<Trace> splitIntegerTraces(vector<Trace>& in, double split_valleys, const PeakSlab& sl, int nchunk)
   991	  {
   992	    if (split_valleys <= 0.0 || in.size() < 2) return std::move(in);   // OpenMS branch: EPD needs > 1
   993	    std::unordered_map<uint32_t, double> b_of_rt;
   994	    for (size_t f = 0; f < sl.frames(); ++f) b_of_rt[sl.rt_index[f]] = sl.b[f];
   995	    const TofAxis& ax = tofAxis();
   996	    nchunk = std::max(1, std::min<int>(nchunk, (int)in.size()));
   997	    vector<vector<Trace>> parts(nchunk);
   998	    const size_t n_in = in.size();
   999	    #pragma omp taskloop grainsize(1) default(shared)
  1000	    for (int ci = 0; ci < nchunk; ++ci)
  1001	    {
  1002	      const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1003	      vector<MassTrace> mts; mts.reserve(hi - lo);
  1004	      long long list_bytes = 0, mt_bytes = 0;
  1005	      for (size_t q = lo; q < hi; ++q)
  1006	      {
  1007	        Trace& t = in[q];
  1008	        // a std::list node is the payload plus two pointers plus allocator overhead
  1009	        list_bytes += (long long)t.np() * (long long)(sizeof(Peak2D) + 2 * sizeof(void*) + 8);
  1010	        std::list<Peak2D> pk;
  1011	        for (size_t i = 0; i < t.np(); ++i)
  1012	        {
  1013	          Peak2D pt; pt.setRT(t.rtAt(i)); pt.setIntensity(t.xv[i]);
  1014	          const bool have_bin = ax.ok && i < t.xt.size();
  1015	          auto bi = have_bin ? b_of_rt.find(t.xi[i]) : b_of_rt.end();
  1016	          pt.setMZ(bi != b_of_rt.end() ? ax.mzOf(t.xt[i], bi->second) : t.mz);
  1017	          pk.push_back(pt);
  1018	        }
  1019	        MassTrace mt(pk);
  1020	        mt.setCentroidIM(t.im);
  1021	        mts.push_back(std::move(mt));
  1022	        mt_bytes += (long long)sizeof(MassTrace);
  1023	        memSub(MEM_TRACES, vbytes(t.xi) + vbytes(t.xv) + vbytes(t.xt));
  1024	        t.freeProfile();                                   // the list copy replaces it, chunk-wise
  1025	      }
  1026	      MemGuard g_list(MEM_EPD_LIST, list_bytes);
  1027	      MemGuard g_mt(MEM_EPD_MT, mt_bytes);
  1028	      vector<MassTrace> split = splitValleys(mts, split_valleys);
  1029	      g_mt.grow((long long)split.size() * (long long)sizeof(MassTrace));
  1030	      vector<Trace>& out = parts[ci];
  1031	      out.reserve(split.size());
  1032	      for (const MassTrace& mt : split)
  1033	      {
  1034	        Trace t = toTrace(mt);
  1035	        if (t.np() == 0) continue;
  1036	        size_t ap = 0; for (size_t i = 1; i < t.np(); ++i) if (t.xv[i] > t.xv[ap]) ap = i;
  1037	        auto it = b_of_rt.find(t.xi[ap]);
  1038	        t.b = it != b_of_rt.end() ? it->second : ax.factor(0);
  1039	        t.tof = ax.ok ? ax.tofOf(t.mz, t.b) : 0;
  1040	        memAdd(MEM_TRACES, vbytes(t.xi) + vbytes(t.xv) + vbytes(t.xt) + (long long)sizeof(Trace));
  1041	        out.push_back(std::move(t));
  1042	      }
  1043	    }
  1044	    vector<Trace>().swap(in);
  1045	    size_t tot = 0; for (const auto& v : parts) tot += v.size();
  1046	    vector<Trace> out; out.reserve(tot);
  1047	    for (auto& v : parts) { for (auto& t : v) out.push_back(std::move(t)); vector<Trace>().swap(v); }
  1048	    return out;
  1049	  }
  1050	
  1051	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
  1052	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
  1053	  PeakMap materializeWindow(vector<CompactFrame>& frames)
  1054	  {
  1055	    PeakMap m;
  1056	    m.reserve(frames.size());
  1057	    for (auto& f : frames)
  1058	    {
  1059	      MSSpectrum s;
  1060	      s.setRT(f.rt);
  1061	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
  1062	      s.reserve(f.mzq.size());
  1063	      OpenMS::DataArrays::FloatDataArray ima;
  1064	      ima.setName(Constants::UserParam::ION_MOBILITY);
  1065	      ima.reserve(f.mzq.size());
  1066	      for (size_t i = 0; i < f.mzq.size(); ++i)
  1067	      {
  1068	        Peak1D p;
  1069	        p.setMZ((double)f.mzq[i] / MZ_Q);
  1070	        p.setIntensity(f.inten[i]);
  1071	        s.push_back(p);
  1072	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
  1073	      }
  1074	      s.getFloatDataArrays().push_back(std::move(ima));
  1075	      m.addSpectrum(std::move(s));
  1076	      // release this frame's compact storage immediately
  1077	      vector<uint32_t>().swap(f.mzq);
  1078	      vector<float>().swap(f.inten);
  1079	      vector<uint16_t>().swap(f.imq);
  1080	    }
  1230	  /// 16:95, Methods: 2D Gaussian pre-filter, then Savitzky-Golay for elongated peaks). We copied
  1231	  /// its 0.3 correlation threshold WITHOUT copying the smoothing. Pearson r between two noisy
  1232	  /// profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker
  1233	  /// constraint than a smoothed 0.3 -- and the attenuation is worst exactly at faint precursors,
  1234	  /// which is where the coverage analysis says we lose peptides (MISS precursors are 3.2x dimmer).
  1235	  /// Raising the threshold to compensate was tried and produced only an FDR artefact; smoothing
  1236	  /// attacks the cause instead of the symptom.
  1237	  ///
  1238	  /// A-TROUS, not a decimated DWT: no downsampling, so the output stays sample-aligned with the
  1239	  /// input and can be scattered onto the correlation grid at the SAME RT positions. That matters
  1240	  /// for correctness here, not just convenience -- the overlap gate counts grid points where the
  1241	  /// precursor is non-zero, so a transform that moved or resampled points would silently change
  1242	  /// what `min_correlation_points` means.
  1243	  ///
  1244	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
  1245	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
  1246	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
  1247	  {
  1248	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
  1249	    const int n = (int)in.size();
  1250	    out = in;
  1251	    if (n < 3 || levels <= 0) return;
  1252	    vector<double> tmp(n);
  1253	    for (int j = 1; j <= levels; ++j)
  1254	    {
  1255	      const int step = 1 << (j - 1);
  1256	      for (int i = 0; i < n; ++i)
  1257	      {
  1258	        double acc = 0.0;
  1259	        for (int k = -2; k <= 2; ++k)
  1260	        {
  1261	          int idx = i + k * step;
  1262	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
  1263	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
  1264	          if (idx < 0) idx = -idx;
  1265	          if (idx >= n) idx = 2 * (n - 1) - idx;
  1266	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
  1267	          acc += H[k + 2] * out[idx];
  1268	        }
  1269	        tmp[i] = acc;
  1270	      }
  1271	      out.swap(tmp);
  1272	    }
  1273	  }
  1274	
  1275	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
  1276	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
  1277	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
  1278	  /// physical widths on different traces.
  1279	  int atrousLevels(const Trace& tr, double scale_sec)
  1280	  {
  1281	    if (tr.np() < 5 || scale_sec <= 0.0) return 0;
  1282	    vector<double> d;
  1283	    d.reserve(tr.np() - 1);
  1284	    for (size_t i = 1; i < tr.np(); ++i)
  1285	    {
  1286	      const double g = tr.rtAt(i) - tr.rtAt(i - 1);
  1287	      if (g > 0) d.push_back(g);
  1288	    }
  1289	    if (d.empty()) return 0;
  1290	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
  1291	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
  1292	    if (dt <= 0.0) return 0;
  1293	    const double want = scale_sec / dt;                // desired support, in SAMPLES
  1294	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
  1295	    const int j = (int)std::lround(std::log2(want));
  1296	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
  1297	  }
  1298	
  1299	  /// Build the per-window FragGrid from IM-sorted fragment traces.
  1300	  /// Resample every fragment XIC onto one common RT grid, as CSR. Takes `frags` by reference and
  1301	  /// CONSUMES each XIC as it is copied: the XIC vectors and the grid would otherwise be live at the
  1302	  /// same time, and their coexistence is what sets the per-window memory peak.
  1303	  FragGrid buildFragGrid(vector<Trace>& frags, double delta_rt)
  1304	  {
  1305	    FragGrid g;
  1306	    // On the global axis the grid is just the set of FRAME INDICES this window's fragments touch.
  1307	    // Mark them in a flat array over the axis, then number the used ones: no collecting of ~10^8
  1308	    // RT values, no large sort, and no binary search per point -- axis index to grid slot is a
  1309	    // single array read. G (the Pearson denominator) is the count of used frames, exactly as before.
  1310	    const size_t na = rtAxis().size();
  1311	    vector<char> used(na, 0);
  1312	    for (const auto& f : frags) for (uint32_t k : f.xi) used[k] = 1;
  1313	    g.slot_of_frame.assign(na, -1);
  1314	    g.rt.clear();
  1315	    for (size_t k = 0; k < na; ++k)
  1316	      if (used[k]) { g.slot_of_frame[k] = (int)g.rt.size(); g.rt.push_back(rtAxis()[k]); }
  1317	    const double G = (double)g.rt.size();
  1318	    // Precursor profiles live on MS1 frames, fragment profiles on MS2 frames, so a precursor point
  1319	    // must be matched to the NEAREST fragment frame within gate:delta_rt. That was a binary search
  1320	    // per point per precursor -- the same answer recomputed for every precursor in the window. It
  1321	    // depends only on the window, so compute it once for every frame of the axis. Ties go to the
  1322	    // LATER slot, as the search it replaces did.
  1323	    g.nearest_slot.assign(na, -1);
  1324	    {
  1325	      vector<size_t> u;
  1326	      u.reserve(g.rt.size());
  1327	      for (size_t k = 0; k < na; ++k) if (used[k]) u.push_back(k);
  1328	      size_t hi = 0;
  1329	      for (size_t f = 0; f < na; ++f)
  1330	      {
  1331	        while (hi < u.size() && u[hi] < f) ++hi;
  1332	        const double t = rtAxis()[f];
  1333	        double bd = delta_rt; int gi = -1;
  1334	        if (hi > 0)
  1335	        { const double d = fabs(rtAxis()[u[hi - 1]] - t); if (d <= bd) { bd = d; gi = g.slot_of_frame[u[hi - 1]]; } }
  1336	        if (hi < u.size())
  1337	        { const double d = fabs(rtAxis()[u[hi]] - t); if (d <= bd) { bd = d; gi = g.slot_of_frame[u[hi]]; } }
  1338	        g.nearest_slot[f] = gi;
  1339	      }
  1340	    }
  1341	    g.mean.resize(frags.size());
  1342	    g.invnorm.resize(frags.size());
  1343	    g.off.assign(frags.size() + 1, 0);
  1344	    // Offsets first, so each fragment owns a disjoint span and the fill is parallel and
  1345	    // deterministic (identical arithmetic per fragment, in the same order, whoever runs it).
  1346	    for (size_t i = 0; i < frags.size(); ++i) g.off[i + 1] = g.off[i] + (uint64_t)frags[i].np();
  1347	    g.flat.resize((size_t)g.off[frags.size()]);
  1348	    #pragma omp taskloop default(shared)
  1349	    for (long ii = 0; ii < (long)frags.size(); ++ii)
  1350	    {
  1351	      const size_t i = (size_t)ii;
  1352	      double sum = 0, sumsq = 0;
  1353	      size_t w = (size_t)g.off[i];
  1354	      const Trace& f = frags[i];
  1355	      for (size_t k = 0; k < f.np(); ++k)
  1356	      {
  1357	        const double v = f.intAt(k);
  1358	        g.flat[w++] = {g.slot_of_frame[f.xi[k]], (float)v};
  1359	        sum += v; sumsq += v * v;
  1360	      }
  1361	      g.mean[i] = sum / G;
  1362	      const double var = sumsq - G * g.mean[i] * g.mean[i];
  1363	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0;  // 0 => constant/degenerate -> never correlates
  1364	      memSub(MEM_TRACES, vbytes(frags[i].xi) + vbytes(frags[i].xv) + vbytes(frags[i].xt)
  1365	                         + (long long)sizeof(Trace));
  1366	      frags[i].freeProfile();   // consumed here, not after scoring
  1367	    }
  1368	    return g;
  1369	  }
  1370	}
  1371	
  1372	class TOPPDIAPseudoSpectra : public TOPPBase
  1373	{
  1374	public:
  1375	  TOPPDIAPseudoSpectra() :
  1376	    TOPPBase("DIAPseudoSpectra", "Extracts pseudo-MS/MS spectra from diaPASEF (ion-mobility DIA) data.")
  1377	  {
  1378	  }
  1379	
  1380	protected:
  1381	  void registerOptionsAndFlags_() override
  1382	  {
  1383	    registerInputFile_("in", "<file>", "", "Input diaPASEF data (ion-mobility DIA; 1/K0 / VSSC): mzML, mzPeak, or a Bruker .d directory.");
  1384	    setValidFormats_("in", {"mzML", "mzpeak", "d"});
  1385	    registerOutputFile_("out", "<file>", "", "Output pseudo-MS2 mzML (searchable by a DDA engine).");
  1386	    setValidFormats_("out", {"mzML"});
  1387	
  1388	    registerTOPPSubsection_("gate", "Precursor-to-fragment co-localization gate");
  1389	    // Conservative, documented defaults; these are placeholders pending a real-data sweep. [H-3]
  1390	    registerDoubleOption_("gate:delta_im", "<1/K0>", 0.01, "Max |precursor - fragment| ion mobility difference (1/K0). (diaTracer deltaApexIM default 0.01)", false);
  1690	        parts[ci] = do_split(chunk);
  1691	      }
  1692	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1693	      vector<MassTrace> out; out.reserve(tot);
  1694	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1695	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1696	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1697	      mts.swap(out);
  1698	    }
  1699	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1700	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1701	    if (!mts.empty())
  1702	    {
  1703	      vector<double> spans;
  1704	      spans.reserve(mts.size());
  1705	      for (const auto& mt : mts)
  1706	      {
  1707	        double lo = 1e30, hi = -1e30;
  1708	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1709	        spans.push_back(hi - lo);
  1710	      }
  1711	      sort(spans.begin(), spans.end());
  1712	      size_t n = spans.size();
  1713	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1714	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1715	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1716	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1717	    }
  1718	    vector<Trace> out;
  1719	    out.reserve(mts.size());
  1720	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1721	    return out;
  1722	  }
  1723	
  1724	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1725	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1726	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1727	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1728	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1729	  {
  1730	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1731	    out.assign(n, 0.0);
  1732	    double term = 1.0;
  1733	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1734	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1735	    if (mx > 0) for (double& v : out) v /= mx;
  1736	  }
  1737	
  1738	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1739	  {
  1740	    double dot = 0, na = 0, nb = 0;
  1741	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1742	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1743	  }
  1744	
  1745	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1746	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1747	  /// coincidental peak at the right m/z spacing usually does not.
  1748	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1749	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1750	  static double xicCorr(const Trace& a, const Trace& b, double /*rt_tol*/)
  1751	  {
  1752	    size_t i = 0, j = 0; double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1753	    while (i < a.np() && j < b.np())
  1754	    {
  1755	      if (a.xi[i] == b.xi[j])
  1756	      { const double x = a.intAt(i), y = b.intAt(j);
  1757	        sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; ++i; ++j; }
  1758	      else if (a.xi[i] < b.xi[j]) ++i; else ++j;
  1759	    }
  1760	    if (m < 3) return -2.0;
  1761	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1762	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1763	  }
  1764	
  1765	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1766	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1767	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, int max_charge,
  1768	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1769	                                      bool envelope_scoring, double ambig_margin)
  1770	  {
  1771	    const double ISO = 1.0033548;
  1772	    const double PROTON_ = 1.00727646;
  1773	    const size_t N = ms1.size();
  1774	
  1775	    // m/z-sorted index for O(log N) isotope-partner lookup (avoids O(N^2) over all MS1 traces). [H-8]
  1776	    vector<size_t> by_mz(N);
  1777	    for (size_t i = 0; i < N; ++i) by_mz[i] = i;
  1778	    sort(by_mz.begin(), by_mz.end(), [&](size_t a, size_t b) { return ms1[a].mz < ms1[b].mz; });
  1779	    vector<double> sorted_mz(N);
  1780	    for (size_t i = 0; i < N; ++i) sorted_mz[i] = ms1[by_mz[i]].mz;
  1781	
  1782	    vector<size_t> order(N);
  1783	    for (size_t i = 0; i < N; ++i) order[i] = i;
  1784	    sort(order.begin(), order.end(), [&](size_t a, size_t b) {
  1785	      if (ms1[a].intensity != ms1[b].intensity) return ms1[a].intensity > ms1[b].intensity;
  1786	      if (ms1[a].mz != ms1[b].mz) return ms1[a].mz < ms1[b].mz;
  1787	      return a < b; // total order so greedy isotope assignment is deterministic [code-review]
  1788	    });
  1789	
  1790	    vector<bool> used(N, false);
  1791	    vector<Precursor_> out;
  1792	    for (size_t seed : order)
  1793	    {
  1794	      if (used[seed]) continue;
  1795	      const Trace& s = ms1[seed];
  1796	      const double tol = s.mz * mass_ppm * 1e-6;
  1797	
  1798	      // Find an unused isotope partner near `target` m/z, co-localized in RT and IM (binary-search
  1799	      // the m/z index, scan only the ppm-window candidates); -1 if none. [H-8]
  1800	      auto findPartner = [&](double target) -> long {
  1801	        size_t klo = lower_bound(sorted_mz.begin(), sorted_mz.end(), target - tol) - sorted_mz.begin();
  1802	        size_t khi = upper_bound(sorted_mz.begin(), sorted_mz.end(), target + tol) - sorted_mz.begin();
  1803	        for (size_t k = klo; k < khi; ++k)
  1804	        {
  1805	          size_t j = by_mz[k];
  1806	          if (used[j] || j == seed) continue;
  1807	          if (fabs(ms1[j].rt - s.rt) <= delta_rt && fabs(ms1[j].im - s.im) <= iso_im_tol)
  1808	            return (long)j;
  1809	        }
  1810	        return -1;
  1811	      };
  1812	
  1813	      // [baseline-fix v2] When envelope scoring is OFF, run the ORIGINAL algorithm end-to-end, not
  1814	      // just the original scoring. The previous attempt reverted only the score while keeping the new
  1815	      // candidate generation (gapped walk + lead 0..3), producing a THIRD algorithm: 2.52M MS1 traces
  1816	      // -> 1.21M precursors, 967,956 spectra, 7,308 peptides (baseline: 1.76M -> 956k, 741k, 9,103).
  1817	      // The original is: contiguous walk with BREAK-ON-FIRST-MISS, seed is always the starting point
  1818	      // (no lead offsets), monoisotope = furthest-LEFT partner reached, pick z by partner COUNT with
  1819	      // ties favouring the LOWEST z.
  1820	      if (!envelope_scoring)
  1821	      {
  1822	        int best_z = 0, best_n = 1;
  1823	        double best_mono = s.mz;
  1824	        vector<size_t> best_partners;
  1825	        for (int z = 1; z <= max_charge; ++z)
  1826	        {
  1827	          vector<size_t> partners;
  1828	          double mono = s.mz;
  1829	          double prev_int = s.intensity;
  1830	          vector<long> lefts;
  1831	          for (int k = 1; k <= 5; ++k)          // lighter partners define the monoisotope
  1832	          {
  1833	            long j = findPartner(s.mz - k * ISO / z);
  1834	            if (j < 0) break;                   // BREAK on first miss (contiguous only)
  1835	            // [mono-guard] A LEFTWARD step asserts the new peak is a LIGHTER ISOTOPE of the same
  1836	            // peptide, but findPartner only checks m/z, RT and IM -- never intensity. So the walk
  1837	            // happily latches onto a noise peak or a co-eluting species' peak that happens to sit
  1838	            // one isotope spacing below, and the monoisotope ends up one isotope TOO LIGHT.
  1839	            // Closed search hides this (the engine enumerates isotope_errors [-1,2] and corrects it
  1840	            // for free); OPEN search cannot, so it becomes a phantom -1.003 Da "modification" --
  1841	            // measured as our single largest open-search delta-mass artefact on S30.
  1842	            // Averagine bounds how weak a genuine lighter isotope may be: stepping from isotope m+1
  1843	            // to m, theo[m]/theo[m+1] = (m+1)/lambda, minimised at m=0 -> 1/lambda. Requiring the
  1844	            // candidate to reach that (times a slack factor) rejects the latch without touching a
  1845	            // real envelope.
  1846	            if (mono_guard_ > 0.0)
  1847	            {
  1848	              const double neutral = (s.mz - k * ISO / z) * z - z * PROTON_;
  1849	              const double lam = std::max(0.10, 0.000594 * neutral);
  1850	              if (ms1[j].intensity < mono_guard_ * prev_int / lam) break;
  1851	            }
  1852	            lefts.push_back(j);
  1853	            partners.push_back((size_t)j); mono = ms1[j].mz; prev_int = ms1[j].intensity;
  1854	          }
  1855	          vector<long> rights;
  1856	          for (int k = 1; k <= 5; ++k)          // heavier partners add confidence
  1857	          {
  1858	            long j = findPartner(s.mz + k * ISO / z);
  1859	            if (j < 0) break;
  1860	            rights.push_back(j);
  1861	            partners.push_back((size_t)j);
  1862	          }
  1863	          // [mono-select] Choosing the monoisotope by "furthest-left peak reached" is a STOPPING
  1864	          // rule, and a stopping rule can only trade over-reach (-1.003 Da) for under-reach (+1.003
  1865	          // Da) -- measured: the guard above cut the -1 artefact 64% but tripled +1, because a walk
  1866	          // that stops early also leaves the M+1 peak unconsumed, so it later seeds its OWN
  1867	          // precursor one isotope too heavy. Make it a SCORING decision instead: walk the full run,
  1868	          // then pick which peak IS the monoisotope by averagine fit of the envelope starting
  1869	          // there. Corrects both directions, and every found peak is still marked used below, so
  1870	          // de-isotoping and emission are untouched (only the reported mono m/z changes).
  1871	          if (mono_select_ && !lefts.empty())
  1872	          {
  1873	            const int nL = (int)lefts.size();
  1874	            vector<double> runI;                                  // ascending m/z: lefts, seed, rights
  1875	            for (int i = nL - 1; i >= 0; --i) runI.push_back(ms1[lefts[i]].intensity);
  1876	            runI.push_back(s.intensity);
  1877	            for (long j : rights) runI.push_back(ms1[j].intensity);
  1878	            double best_cos = -1.0; int best_c = nL;              // default: seed is the mono
  1879	            vector<double> theo, obs;
  1880	            for (int c = 0; c <= nL; ++c)                         // mono cannot be right of the seed
  1881	            {
  1882	              const int len = std::min(4, (int)runI.size() - c);
  1883	              if (len < 2) break;                                 // need >=2 peaks to score a shape
  1884	              const double neutral = (s.mz - (double)(nL - c) * ISO / z) * z - z * PROTON_;
  1885	              averagineRatios(neutral, len, theo);
  1886	              obs.assign(runI.begin() + c, runI.begin() + c + len);
  1887	              double mx = 0.0; for (double v : obs) mx = std::max(mx, v);
  1888	              if (mx <= 0.0) continue;
  1889	              for (double& v : obs) v /= mx;
  1890	              // [adv-fix] The SAME trap the envelope scorer documents below: the cosine of a short
  1891	              // vector is nearly always high, and `len` SHRINKS as the candidate mono moves right,
  1892	              // so raw cosine systematically prefers a too-HEAVY mono. Measured (first cut, raw
  1893	              // cosine): -1 bin 7,616 -> 2,314 as intended, but +1 exploded 4,697 -> 21,591 and the
  1894	              // unmodified fraction fell 31.2% -> 26.4%, at flat emission -- i.e. precursors that
  1895	              // were CORRECT were pushed one isotope right. Weight by evidence exactly as the
  1896	              // envelope scorer does: (n-1)/3 capped at 1 (4 isotopes 1.00, 3 -> 0.67, 2 -> 0.33).
  1897	              const double cs = cosineSim(obs, theo) * std::min(1.0, (double)(len - 1) / 3.0);
  1898	              if (cs > best_cos) { best_cos = cs; best_c = c; }
  1899	            }
  1900	            mono = (best_c < nL) ? ms1[lefts[nL - 1 - best_c]].mz : s.mz;
  1901	          }
  1902	          const int n = 1 + (int)partners.size();
  1903	          if (n > best_n) { best_n = n; best_z = z; best_mono = mono; best_partners = partners; }
  1904	        }
  1905	        Precursor_ pc0;
  1906	        pc0.trace_idx = seed;
  1907	        pc0.rt = s.rt; pc0.im = s.im;
  1908	        pc0.mono_mz = best_mono;
  1909	        // Carry the bin of whichever trace the monoisotope call landed on, so the exported mass is
  1910	        // calibrated from a measurement rather than from a number that passed through the gates.
  1911	        pc0.mono_tof = ms1[seed].tof; pc0.mono_b = ms1[seed].b;
  1912	        for (size_t j : best_partners)
  1913	          if (ms1[j].mz == best_mono) { pc0.mono_tof = ms1[j].tof; pc0.mono_b = ms1[j].b; break; }
  1914	        pc0.charge = best_z;                    // 0 => unknown, default_charge applied later
  1915	        pc0.n_isotopes = best_n;                // [Q4] envelope confidence for the mono call
  1916	        out.push_back(pc0);
  1917	        used[seed] = true;
  1918	        for (size_t j : best_partners) used[j] = true;   // de-isotope
  1919	        continue;
  1920	      }
  1921	
  1922	      struct Hyp { int z; double mono; double score; vector<size_t> partners; };
  1923	      vector<Hyp> hyps;
  1924	      vector<double> theo, obs(4), obsn(4);
  1925	
  1926	      for (int z = 1; z <= max_charge; ++z)
  1927	      {
  1928	        // [route-1] GAPPED envelopes: no break-on-first-miss (a sub-threshold M+1 with a present
  1929	        // M+2 previously killed the whole walk). Try the seed AND up to 3 isotopes below it as the
  1930	        // monoisotope candidate; averagine decides which one really is the mono.
  1931	        for (int lead = 0; lead <= 3; ++lead)
  1932	        {
  1933	          const double mono_mz = s.mz - lead * ISO / z;
  1934	          long mono_idx = (lead == 0) ? (long)seed : findPartner(mono_mz);
  1935	          if (lead > 0 && mono_idx < 0) continue;
  1936	          const double neutral = mono_mz * z - z * PROTON_;
  1937	          if (neutral < 400.0 || neutral > 6000.0) continue;
  1938	
  1939	          vector<size_t> members;
  1940	          vector<long> iso_idx(4, -1);
  1941	          obs.assign(4, 0.0);
  1942	          obs[0] = ms1[mono_idx].intensity;
  1943	          iso_idx[0] = mono_idx;
  1944	          if ((size_t)mono_idx != seed) members.push_back((size_t)mono_idx);
  1945	          int found = 1;
  1946	          for (int k = 1; k <= 3; ++k)
  1947	          {
  1948	            long j = findPartner(mono_mz + k * ISO / z);
  1949	            if (j >= 0) { obs[k] = ms1[j].intensity; iso_idx[k] = j; ++found;
  1950	                          if ((size_t)j != seed) members.push_back((size_t)j); }
  1951	          }
  1952	          if (found < 2) continue;   // need >=2 isotopes before a shape can be scored
  1953	
  1954	          averagineRatios(neutral, 4, theo);
  1955	          double mx = 0.0; for (double v : obs) mx = std::max(mx, v);
  1956	          if (mx <= 0) continue;
  1957	          for (int k = 0; k < 4; ++k) obsn[k] = obs[k] / mx;
  1958	          const double cos_sim = cosineSim(obsn, theo);
  1959	
  1960	          double csum = 0.0; int cn = 0;
  1961	          for (int k = 1; k <= 3; ++k)
  1962	            if (iso_idx[k] >= 0) { csum += xicCorr(ms1[iso_idx[0]], ms1[iso_idx[k]], delta_rt); ++cn; }
  1963	          const double mean_corr = cn ? std::max(0.0, csum / cn) : 0.0;
  1964	
  1965	          // Composite: shape AND co-elution must BOTH hold, WEIGHTED BY EVIDENCE.
  1966	          // [adv-fix] The naive product cos*corr + 0.01*n is statistically indefensible: a 2-isotope
  1967	          // hypothesis (cos 0.99 x corr 0.95 = 0.9605) BEATS 4 genuine isotopes (0.95 x 0.85 = 0.8475),
  1968	          // because the cosine of a 2-vector is nearly always high and the +0.01*n bonus (0.02 between
  1969	          // 2 and 4 isotopes) sits far below correlation noise. That biases us toward exactly the
  1970	          // sparse, weakly-supported envelopes we are trying to eliminate.
  1971	          // Fix: multiply by an evidence weight (n-1)/3 capped at 1 => 4 isotopes 1.00, 3 -> 0.67,
  1972	          // 2 -> 0.33. The counterexample now scores 0.808 vs 0.313 - correctly ordered.
  1973	          const double evidence = std::min(1.0, (found - 1) / 3.0);
  1974	          hyps.push_back({z, mono_mz, cos_sim * mean_corr * evidence, members});
  1975	        }
  1976	      }
  1977	
  1978	      Precursor_ pc;
  1979	      pc.trace_idx = seed;
  1980	      pc.rt = s.rt; pc.im = s.im;
  1981	
  1982	      if (hyps.empty())
  1983	      {
  1984	        pc.mono_mz = s.mz; pc.charge = 0;   // no envelope evidence at all -> unknown charge
  1985	      pc.mono_tof = s.tof; pc.mono_b = s.b;
  1986	        out.push_back(pc);
  1987	        used[seed] = true;
  1988	        continue;
  1989	      }
  1990	
  1991	      // [baseline-fix] When envelope scoring is OFF we must still DE-ISOTOPE, otherwise every isotope
  1992	      // peak seeds its own precursor and the spectrum count explodes (measured: 741k -> 1,209,295
  1993	      // spectra, 9,103 -> 7,830 peptides). The off-branch therefore falls back to the ORIGINAL
  1994	      // partner-COUNT criterion with the original low-z tie-break, and still marks members used.
  1995	      if (!envelope_scoring)
  1996	      {
  1997	        for (auto& h : hyps) h.score = (double)h.partners.size();  // count, not shape
  1998	        sort(hyps.begin(), hyps.end(), [](const Hyp& a, const Hyp& b) {
  1999	          if (a.score != b.score) return a.score > b.score;
  2000	          if (a.z != b.z) return a.z < b.z;                        // original: ties favour LOW z
  2001	          return a.mono < b.mono;
  2002	        });
  2003	      }
  2004	      else
  2005	      sort(hyps.begin(), hyps.end(), [](const Hyp& a, const Hyp& b) {
  2006	        if (a.score != b.score) return a.score > b.score;
  2007	        if (a.z != b.z) return a.z > b.z;   // [route-1] ties now favour HIGHER z (old code favoured low z)
  2008	        return a.mono < b.mono;
  2009	      });
  2010	      const Hyp& best = hyps[0];
  2011	      pc.mono_mz = best.mono; pc.charge = best.z;
  2012	      pc.mono_tof = s.tof; pc.mono_b = s.b;
  2013	      for (size_t j : best.partners)
  2014	        if (ms1[j].mz == best.mono) { pc.mono_tof = ms1[j].tof; pc.mono_b = ms1[j].b; break; }
  2015	      // partners + the seed = envelope size. `members` excludes the seed, so this is the whole
  2016	      // envelope only because the seed is always one of its peaks. [adv-review kimi 2026-09-03]
  2017	      pc.n_isotopes = 1 + (int)best.partners.size();   // [Q4] envelope confidence for the mono call
  2018	      out.push_back(pc);
  2019	      used[seed] = true;
  2020	      for (size_t j : best.partners) used[j] = true;
  2021	
  2022	      // [route-3] Ambiguous charge -> retain a second hypothesis (diaTracer: "when the charge state
  2023	      // cannot be confidently determined, multiple values are retained"). 0 disables.
  2024	      if (ambig_margin > 0.0)
  2025	      {
  2026	        for (size_t h = 1; h < hyps.size(); ++h)
  2027	        {
  2028	          if (hyps[h].z == best.z) continue;
  2029	          if (best.score - hyps[h].score > ambig_margin) break;
  2030	          Precursor_ alt = pc;
  2031	          alt.mono_mz = hyps[h].mono; alt.charge = hyps[h].z;
  2032	          alt.n_isotopes = 1 + (int)hyps[h].partners.size();   // [Q4]
  2033	          out.push_back(alt);
  2034	          break;                            // at most one alternative
  2035	        }
  2036	      }
  2037	    }
  2038	    return out;
  2039	  }
  2040	
  2041	  /// [route-4] Collapse precursor hypotheses that are the SAME species (same charge, m/z within ppm,
  2042	  /// co-eluting in RT, co-located in IM). Measured redundancy is 4.6 identified spectra per unique
  2043	  /// peptide vs diaTracer's 1.46, so duplicates cost spectra, RAM and FDR budget without adding
  2044	  /// peptides. Keeps the most intense representative. Deterministic (total-order sort).
  2045	  static size_t dedupPrecursors_(vector<Precursor_>& pcs, const vector<Trace>& ms1,
  2046	                                 double mass_ppm, double rt_tol, double im_tol)
  2047	  {
  2048	    if (pcs.empty()) return 0;
  2049	    vector<size_t> idx(pcs.size());
  2050	    for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  2051	    sort(idx.begin(), idx.end(), [&](size_t a, size_t b) {
  2052	      if (pcs[a].charge != pcs[b].charge) return pcs[a].charge < pcs[b].charge;
  2053	      if (pcs[a].mono_mz != pcs[b].mono_mz) return pcs[a].mono_mz < pcs[b].mono_mz;
  2054	      if (pcs[a].rt != pcs[b].rt) return pcs[a].rt < pcs[b].rt;
  2055	      return a < b;
  2056	    });
  2057	    vector<bool> drop(pcs.size(), false);
  2058	    for (size_t a = 0; a < idx.size(); ++a)
  2059	    {
  2060	      size_t i = idx[a];
  2061	      if (drop[i]) continue;
  2062	      const double tol = pcs[i].mono_mz * mass_ppm * 1e-6;
  2063	      for (size_t b = a + 1; b < idx.size(); ++b)
  2064	      {
  2065	        size_t j = idx[b];
  2066	        if (pcs[j].charge != pcs[i].charge) break;
  2067	        if (pcs[j].mono_mz - pcs[i].mono_mz > tol) break;
  2068	        if (drop[j]) continue;
  2069	        if (fabs(pcs[j].rt - pcs[i].rt) <= rt_tol && fabs(pcs[j].im - pcs[i].im) <= im_tol)
  2070	        {
  2071	          if (ms1[pcs[j].trace_idx].intensity > ms1[pcs[i].trace_idx].intensity) { drop[i] = true; break; }
  2072	          drop[j] = true;
  2073	        }
  2074	      }
  2075	    }
  2076	    vector<Precursor_> keep;
  2077	    keep.reserve(pcs.size());
  2078	    size_t removed = 0;
  2079	    for (size_t i = 0; i < pcs.size(); ++i) { if (drop[i]) ++removed; else keep.push_back(pcs[i]); }
  2080	    pcs.swap(keep);
  2081	    return removed;
  2082	  }
  2083	
  2084	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  2085	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  2086	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  2087	  template <class Emit>
  2088	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  2089	                        const vector<double>& frag_im, const vector<double>& frag_rt,
  2090	                        const vector<Trace>& ms1_traces,
  2091	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
  2092	                        int min_corr_pts, vector<float>& pdense, Emit&& emit) const
  2093	  {
  2094	    const double G = (double)fg.rt.size();
  2095	    const Trace& p_tr = ms1_traces[pc.trace_idx];
  2096	    // [wavelet] Correlate against a SMOOTHED precursor profile, as diaTracer does. Only the
  2097	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  2098	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  2099	    // (diaTracer smooths only the precursor side), and emitted peak intensities are unaffected
  2100	    // because they come from the fragment traces, not from here.
  2101	    const vector<double>* p_int = nullptr;
  2102	    if (wl_scale_ > 0.0)
  2103	    {
  2104	      const int lv = atrousLevels(p_tr, wl_scale_);
  2105	      if (lv > 0)
  2106	      {
  2107	        thread_local vector<double> raw_i, sm_i;   // window loop is parallel; scratch is per-thread
  2108	        raw_i.resize(p_tr.np());
  2109	        for (size_t i = 0; i < p_tr.np(); ++i) raw_i[i] = p_tr.intAt(i);
  2110	        atrousSmooth(raw_i, lv, sm_i);
  2111	        p_int = &sm_i;
  2112	      }
  2113	    }
  2114	    vector<int> touched;
  2115	    touched.reserve(p_tr.np());
  2116	    for (size_t pi = 0; pi < p_tr.np(); ++pi)
  2117	    {
  2118	      const double pval = p_int ? (*p_int)[pi] : p_tr.intAt(pi);
  2119	      const int gi = fg.nearest_slot[p_tr.xi[pi]];        // one array read, precomputed per window
  2120	      if (gi >= 0) { if (pdense[gi] == 0.0f) touched.push_back(gi); pdense[gi] += (float)pval; }
  2121	    }
  2122	    double psum = 0, psumsq = 0, plogsum = 0;
  2123	    // plogsum normalises the precursor profile for gate:coelution=logoverlap. Constant across
  2124	    // every fragment of this precursor, so hoist it out of the inner loop.
  2125	    for (int gi : touched)
  2126	    {
  2127	      double v = pdense[gi];
  2128	      psum += v; psumsq += v * v;
  2129	      if (log_overlap_) plogsum += std::log1p(v);
  2130	    }
  2131	    double pmean = psum / G, pvar = psumsq - G * pmean * pmean;
  2132	    double pinv = pvar > 0 ? 1.0 / sqrt(pvar) : 0.0;
  2133	    if (pinv > 0.0)
  2134	    {
  2135	      size_t lo = lower_bound(frag_im.begin(), frag_im.end(), pc.im - delta_im) - frag_im.begin();
  2136	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  2137	      long long n_rtpass = 0;
  2138	      stat_slice_ += (long long)(hi - lo); ++stat_prec_;
  2139	      for (size_t fi = lo; fi < hi; ++fi)
  2140	      {
  2141	        // Read the gate field from a parallel array, and do NOT touch the 96-byte trace record
  2142	        // until the fragment has passed: 99.4% of visits end here, and at 8 B instead of 96 B the
  2143	        // scan moves ~12x fewer bytes. [soa]
  2144	        if (fabs(frag_rt[fi] - pc.rt) > delta_rt) continue;            // RT gate
  2145	        ++n_rtpass;
  2146	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  2147	        const Trace& f = frag_traces[fi];
  2148	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  2149	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  2150	        // "fragments" (unfragmented survivors). SPEXTRACT_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  2151	        if (drop_prec_iso_ && pc.charge > 0)
  2152	        {
  2153	          bool iso = false;
  2154	          for (int k = 1; k <= 3 && !iso; ++k) iso = fabs(f.mz - (pc.mono_mz + k * 1.00335 / pc.charge)) < 0.01;
  2155	          if (iso) continue;
  2156	        }
  2157	        double dot = 0; int overlap = 0;
  2158	        // [R2-late, 2026-09-02] overlap <= support, so a fragment with fewer support points than
  2159	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  2160	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  2161	        if (fg.supEnd(fi) - fg.supBegin(fi) < (size_t)std::max(min_corr_pts, 0)) continue;
  2162	        for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  2163	        { const auto& gv = fg.flat[k]; float pv = pdense[gv.first]; if (pv != 0.0f) { dot += (double)pv * gv.second; ++overlap; } }
  2164	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  2165	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  2166	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  2167	        // defect the adversarial review flagged. It rewards sparse fragments that happen to spike
  2168	        // where the precursor spikes, and its scale depends on G rather than on the evidence.
  2169	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  2170	        // independence, where one missing point does not zero the score (unlike a product) and
  2171	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  2172	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  2173	        // [0,1]. No zero padding, no dependence on G.
  2174	        double c;
  2175	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  2176	        {
  2177	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  2178	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  2179	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  2180	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  2181	          double fsum = 0.0, fsumsq = 0.0;
  2182	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  2183	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  2184	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  2185	          double pm = psum / n, fm = fsum / n;
  2580	    // intensity) instead of 16 (RT + intensity), and lets two profiles be aligned by integer
  2581	    // equality instead of a binary search per point. Frames are counted once even when an MS1 and
  2582	    // an MS2 frame share an RT, which is what makes the index a valid shared key.
  2583	    {
  2584	      vector<double>& ax = rtAxis();
  2585	      ax.clear();
  2586	      ax.reserve(ms1_map.size() + 1024);
  2587	      for (const auto& sp : ms1_map) ax.push_back(sp.getRT());
  2588	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) ax.push_back(f.rt);
  2589	      sort(ax.begin(), ax.end());
  2590	      ax.erase(unique(ax.begin(), ax.end()), ax.end());
  2591	      writeLogInfo_("RT axis: " + String(ax.size()) + " distinct frame retention times"
  2592	                    + (ax.empty() ? "" : " spanning " + String(ax.front()) + "-" + String(ax.back()) + " s"));
  2593	      if (ax.empty())
  2594	      {
  2595	        writeLogError_("Error: no frame retention times; cannot build the RT axis.");
  2596	        return INCOMPATIBLE_INPUT_DATA;
  2597	      }
  2598	    }
  2599	
  2600	    //-------------------------------------------------------------
  2601	    // MS1 traces + precursor/charge inference (shared, once) [H-8,H-10]
  2602	    //-------------------------------------------------------------
  2603	    const int agg_ms1 = getIntOption_("trace:frame_aggregation_ms1_n");
  2604	    ms1_map.sortSpectra();
  2605	    if (agg_ms1 > 1) { aggregateFrames_(ms1_map, agg_ms1, mass_ppm, delta_im); writeLogInfo_("MS1 cross-frame aggregation N=" + String(agg_ms1) + rss_()); }
  2606	    const double ms1_snr = getDoubleOption_("trace:ms1_chrom_peak_snr");
  2607	    const double ms2_snr = getDoubleOption_("trace:ms2_chrom_peak_snr");
  2608	    const double ms2_minlen = getDoubleOption_("trace:ms2_min_length_sec");
  2609	    const double ms2_msr = getDoubleOption_("trace:ms2_min_sample_rate");
  2610	    double ms2_split = getDoubleOption_("trace:ms2_split_valleys");
  2611	    const double max_trace_len = getDoubleOption_("trace:max_trace_length_sec");
  2612	    const int agg_n = getIntOption_("trace:frame_aggregation_n");
  2613	    String ms1_span;
  2614	    // [parallel] MS1 tracing was UNBANDED: the call never passed a band count, so it defaulted to
  2615	    // 1 and MassTraceDetection -- a serial greedy loop over an intensity-sorted apex list -- ran on
  2616	    // ONE core while MS2 was banded across the machine. Invisible at default thresholds (MS1 is ~4%
  2617	    // of frames), fatal for the MS1 sensitivity sweep, which is the one lever the literature names
  2618	    // as the root cause of low-abundance loss in this tool class.
  2619	    int ms1_bands = getIntOption_("perf:ms1_trace_bands");
  2620	    if (ms1_bands < 1) ms1_bands = 1;
  2621	    double _t_ms1 = phase_clock_(), _c_ms1 = cpu_seconds_();   // [perf-instr]
  2622	    // detectTraces_ distributes its bands as TASKS, which requires an enclosing parallel region;
  2623	    // the window loop provides one, this phase must open its own. It also lets MS1 tracing use the
  2624	    // whole machine instead of the band count (it was measured at only 5.0x on 12 bands).
  2625	    vector<Trace> ms1_traces;
  2626	    #pragma omp parallel
  2627	    #pragma omp single
  2628	    ms1_traces = detectTraces_(ms1_map, delta_im, getDoubleOption_("trace:noise_threshold_int"),
  2629	                                             ms1_snr, getDoubleOption_("trace:min_length_sec"), getDoubleOption_("trace:ms1_min_sample_rate"), max_trace_len, getDoubleOption_("trace:ms1_split_valleys"), &ms1_span, ms1_bands);
  2630	    if (detOn_()) writeLogInfo_("[det] MS1 traces n=" + String(ms1_traces.size()) + " digest=" + String(traceDigest_(ms1_traces)));
  2631	    { auto& st = phase_stats_()["MS1_TRACE"]; if (st.n++ == 0) phase_order_().push_back("MS1_TRACE");
  2632	      st.wall += phase_clock_() - _t_ms1; st.cpu += cpu_seconds_() - _c_ms1; st.rss_end_mb = rss_mb_(); }
  2633	    writeLogInfo_("MS1 " + ms1_span);   // [merged-trace] measure, do not assume
  2634	
  2635	    // [fwhm] Measure the actual chromatographic peak width from the MS1 traces just built, and
  2636	    // use it to set the MS2 valley-splitting window. chrom_fwhm is an ABSOLUTE TIME, so a fixed
  2637	    // default cannot be right across methods: 14.0 s gave +0.0% peptides on a 31 min gradient
  2638	    // and -1.06% on a 5.6 min one, where the same 14 s is proportionally 5.5x wider.
  2639	    // Median, not mean: FWHM distributions are heavy-tailed and a mean is dominated by a handful
  2640	    // of merged or truncated traces. Traces that never fall to half maximum on both sides are
  2641	    // EXCLUDED rather than imputed -- a truncated peak is not a narrow one, and imputing it
  2642	    // would bias the estimate downward exactly where peaks are broadest.
  2643	    double ms1_fwhm_med = -1.0;
  2644	    {
  2645	      vector<double> fw;
  2646	      fw.reserve(ms1_traces.size() / 4 + 1);
  2647	      for (const auto& t : ms1_traces)
  2648	      {
  2649	        if (t.np() < 5) continue;
  2650	        size_t ap = 0;
  2651	        for (size_t i = 1; i < t.np(); ++i) if (t.intAt(i) > t.intAt(ap)) ap = i;
  2652	        const double half = t.intAt(ap) * 0.5;
  2653	        if (half <= 0.0) continue;
  2654	        double lo = -1.0, hi = -1.0;
  2655	        for (size_t i = ap; i > 0; --i)
  2656	          if (t.intAt(i - 1) <= half)
  2657	          { const double d = t.intAt(i) - t.intAt(i - 1);
  2658	            const double f = d > 0 ? (t.intAt(i) - half) / d : 0.0;
  2659	            lo = t.rtAt(i) - f * (t.rtAt(i) - t.rtAt(i - 1)); break; }
  2660	        for (size_t i = ap; i + 1 < t.np(); ++i)
  2661	          if (t.intAt(i + 1) <= half)
  2662	          { const double d = t.intAt(i) - t.intAt(i + 1);
  2663	            const double f = d > 0 ? (t.intAt(i) - half) / d : 0.0;
  2664	            hi = t.rtAt(i) + f * (t.rtAt(i + 1) - t.rtAt(i)); break; }
  2665	        if (lo >= 0.0 && hi > lo) fw.push_back(hi - lo);
  2666	      }
  2667	      if (!fw.empty())
  2668	      {
  2669	        std::nth_element(fw.begin(), fw.begin() + fw.size() / 2, fw.end());
  2670	        ms1_fwhm_med = fw[fw.size() / 2];
  2671	        writeLogInfo_("Measured MS1 FWHM: median " + String(ms1_fwhm_med) + " s over "
  2672	                      + String(fw.size()) + " traces (of " + String(ms1_traces.size())
  2673	                      + "; truncated peaks excluded)");
  2674	      }
  2675	      else writeLogInfo_("Measured MS1 FWHM: NO usable traces -- falling back to absolute seconds");
  2676	    }
  2677	    // ms2_split is declared at :1324 but the FWHM is only known HERE, after MS1 tracing --
  2678	    // that ordering is why only the MS2 side can use the measured width for free. Doing the
  2679	    // same for MS1 needs a two-pass trace (measure with splitting off, then re-trace), which is
  2680	    // a real cost and is deliberately not done blind.
  2825	        for (auto it = lo; it != refs.end() && it->mz <= pc.mono_mz + tol; ++it)
  2826	          if (std::fabs(it->rt - pc.rt) <= 10.0 && (it->z == 0 || pc.charge == 0 || it->z == pc.charge)) return false;
