  2845	        size_t ap = 0;
  2846	        for (size_t i = 1; i < tr.np(); ++i) if (tr.intAt(i) > tr.intAt(ap)) ap = i;
  2847	        const double half = tr.intAt(ap) * 0.5;
  2848	        double lo = tr.rtAt(0), hi = tr.rtAt(tr.np() - 1);
  2849	        for (size_t i = ap; i > 0; --i)
  2850	          if (tr.intAt(i - 1) <= half)
  2851	          {
  2852	            const double d = tr.intAt(i) - tr.intAt(i - 1);
  2853	            const double f = d > 0 ? (tr.intAt(i) - half) / d : 0.0;
  2854	            lo = tr.rtAt(i) - f * (tr.rtAt(i) - tr.rtAt(i - 1));
