   322	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   323	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   324	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   325	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   326	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   327	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   328	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   329	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   330	  struct FragGrid
   331	  {
   332	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   333	    vector<int> slot_of_frame;                  ///< global frame index -> grid slot, -1 if unused
   334	    vector<int> nearest_slot;                   ///< global frame index -> NEAREST used slot within delta_rt
   335	    vector<uint64_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   336	                                                ///  64-bit on purpose: 8.5 M fragments x ~510 support
   337	                                                ///  points is within 2x of the 32-bit wrap, and an
   338	                                                ///  overflow here silently corrupts every correlation.
   339	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   340	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   341	    size_t supBegin(size_t i) const { return off[i]; }
   342	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   343	  };
