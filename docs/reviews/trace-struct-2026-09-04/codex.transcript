  1006	      {
  1007	        Trace& t = in[q];
  1008	        // a std::list node is the payload plus two pointers plus allocator overhead
  1009	        list_bytes += (long long)t.np() * (long long)(sizeof(Peak2D) + 2 * sizeof(void*) + 8);
  1010	        std::list<Peak2D> pk;
