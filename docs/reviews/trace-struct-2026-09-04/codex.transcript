   735	
   736	  /// Mass-trace detection on the integer m/z axis.
   737	  ///
   738	  /// The OpenMS detector accepts a peak when it lies within `mass_error_ppm` of a trace's RUNNING
   739	  /// centroid, which needs a tolerance comparison against every live trace and makes the cost
   740	  /// superlinear in peaks per band -- measured on S30: 4 bands 18:25 wall / 163 GB against 12 bands
   741	  /// 12:53 / 103 GB, i.e. the same work costs more when the bands are bigger. On a uniform integer
   742	  /// axis the candidates for a peak are found by ARITHMETIC: a live trace can only accept indices
   743	  /// within `ppmSpan` of its centroid, so bucketing by `mz >> shift` with a bucket wider than the
   744	  /// largest span puts every candidate in the peak's own bucket or its two neighbours.
   745	  ///
   746	  /// This is a DIFFERENT ALGORITHM, not a reimplementation: it will not reproduce the OpenMS
   747	  /// detector peak for peak. It is therefore gated behind `trace:detector=integer` (default
   748	  /// `openms`) and must be judged on identified peptides with both search engines, never on a
   749	  /// spectrum digest.
   750	  ///
   751	  /// Mobility is part of the identity, as in the IM-aware OpenMS path: a candidate must also be
   752	  /// within `im_tol` of the trace's mobility. Valley splitting is NOT done here -- the existing
   753	  /// ElutionPeakDetection step runs afterwards on the traces this produces.
   754	  /// Mass-trace detection on integer arrays, following OpenMS `MassTraceDetection::run_` step for
   755	  /// step -- written from that source, not from a description of it. The first version was written
   756	  /// from a description and lost 92% of the peptides; the review that found why is in
   757	  /// docs/reviews/integer-tracing-2026-09-03/ and the corrected semantics are:
   758	  ///   * seeds in intensity order, ties later-index-first (stable ascending sort, reverse walk);
   759	  ///   * the two directions extend INTERLEAVED, one frame down then one up, sharing one centroid;
   760	  ///   * acceptance is the CLOSEST peak within +-3 sd of the running m/z centroid and within the
   761	  ///     mobility tolerance of the running mobility centroid; if that closest peak is already
   762	  ///     taken, the frame is a MISS -- the next-closest is not tried;
   763	  ///   * sd starts at centroid*ppm and is RE-ESTIMATED from the accepted peaks (reestimate_mt_sd);
   764	  ///   * a direction stops after more than 5 consecutive misses; an empty frame is not a miss;
   765	  ///   * the trace is valid if its RT span is within [min,max] length and
   766	  ///     size / (frames visited - trailing misses) >= min_sample_rate (0.5 by default);
   767	  ///   * peaks are marked taken only when the trace is valid;
   768	  ///   * the seed is counted twice in the centroid, as run_ does (init, then update again).
   769	  /// Peaks stay integers (flight-time bin, quantised mobility); the running centroid and sd are
   770	  /// doubles in m/z, exactly as in OpenMS, so the tolerance semantics are the same. The bin<->m/z
   771	  /// conversion is one calibration call per frame step plus one per ACCEPTED peak -- never per
   772	  /// visited peak. Valley splitting runs afterwards on the result, as it does for the OpenMS path.
   773	  /// Per-window, read-only preparation shared by every band task: frame of each peak, the
   774	  /// noise-membership mask, per-frame "has any member" (OpenMS deletes sub-noise peaks first and
   775	  /// only then asks whether a frame is empty), and the intensity-ordered seed list. Built ONCE.
   776	  /// The first corrected version rebuilt all of this inside each of the 12 band tasks -- twelve
   777	  /// full-window sorts per window and twelve sets of P-sized arrays alive at once -- which is
   778	  /// exactly where its extra time (9:28 vs 7:22) and extra memory (174 vs 166 GB) came from.
   779	  struct TracePrep
   780	  {
   781	    vector<uint32_t> frame_of;    ///< P
   782	    vector<char>     member;      ///< P: intensity > noise
   783	    vector<char>     frame_live;  ///< F: has at least one member
   784	    vector<uint32_t> order;       ///< seeds, intensity desc, later-index-first among equals
   785	  };
   786	  TracePrep prepareTracing(const PeakSlab& sl, double noise, double snr)
   787	  {
   788	    TracePrep tp;
   789	    const size_t F = sl.frames(), P = sl.tof.size();
   790	    tp.frame_of.assign(P, 0); tp.member.assign(P, 0); tp.frame_live.assign(F, 0);
   791	    for (size_t f = 0; f < F; ++f)
   792	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k)
   793	      {
   794	        tp.frame_of[k] = (uint32_t)f;
   795	        if ((double)sl.inten[k] > noise) { tp.member[k] = 1; tp.frame_live[f] = 1; }   // double compare, as OpenMS
   796	      }
   797	    const double min_apex = snr * noise;
   798	    tp.order.reserve(P / 4);
   799	    for (uint32_t k = 0; k < P; ++k)
   800	      if (tp.member[k] && (double)sl.inten[k] > min_apex) tp.order.push_back(k);
   801	    // OpenMS: stable_sort ascending by intensity, then iterate in reverse -> among equal
   802	    // intensities the LATER peak seeds first.
   803	    sort(tp.order.begin(), tp.order.end(), [&](uint32_t a, uint32_t b) {
   804	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   805	      return a > b;
   806	    });
   807	    return tp;
   808	  }
