  2325	        const double kb = by_int ? frags[b].second : frag_scores[b];
  2326	        if (ka != kb) return ka > kb;
  2327	        if (frags[a].first != frags[b].first) return frags[a].first < frags[b].first;
  2328	        return a < b;
  2329	      });
