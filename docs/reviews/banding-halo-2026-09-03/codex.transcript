  1477	    if (pcs.empty()) return 0;
  1478	    vector<size_t> idx(pcs.size());
  1479	    for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  1480	    sort(idx.begin(), idx.end(), [&](size_t a, size_t b) {
  1481	      if (pcs[a].charge != pcs[b].charge) return pcs[a].charge < pcs[b].charge;
  1482	      if (pcs[a].mono_mz != pcs[b].mono_mz) return pcs[a].mono_mz < pcs[b].mono_mz;
  1483	      if (pcs[a].rt != pcs[b].rt) return pcs[a].rt < pcs[b].rt;
  1484	      return a < b;
