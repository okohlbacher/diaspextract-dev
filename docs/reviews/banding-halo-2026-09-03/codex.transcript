    61	
    62	    void MassTraceDetection::updateIterativeWeightedMean_(const double& added_value,
    63	                                                         const double& added_intensity,
    64	                                                         double& centroid_value,
    65	                                                         double& prev_counter,
    66	                                                         double& prev_denom)
    67	    {
    68	      double new_weight = added_intensity;
    69	      double new_val = added_value;
    70	
    71	      double counter_tmp = 1.0 + (new_weight * new_val) / prev_counter;
    72	      double denom_tmp = 1.0 + (new_weight) / prev_denom;
    73	
    74	      centroid_value *= (counter_tmp / denom_tmp);
    75	      prev_counter *= counter_tmp;
    76	      prev_denom *= denom_tmp;
    77	    }
    78	
    79	    // detect presence of ion mobility data and locate all relevant meta array indices.
    80	    void MassTraceDetection::getIMIndices_(
    81	      const PeakMap& spectra,
    82	      int& fwhm_meta_idx, bool& has_fwhm_mz,
    83	      int& im_idx, bool& has_centroid_im,
    84	      int& im_fwhm_idx, bool& has_fwhm_im
    85	    ) const
    86	    {
    87	      for (const auto& spec : spectra)
    88	      {
    89	        const auto& fda = spec.getFloatDataArrays();
    90	        if (!fda.empty())
    91	        {
    92	          auto it_fwhm = getDataArrayByName(fda, Constants::UserParam::FWHM_MZ_ppm);
    93	          auto it_im = getDataArrayByName(fda, Constants::UserParam::ION_MOBILITY);
    94	          auto it_imf = getDataArrayByName(fda, Constants::UserParam::FWHM_IM);
    95	
    96	          if (it_fwhm != fda.end())
    97	          {
    98	            fwhm_meta_idx = std::distance(fda.begin(), it_fwhm);
    99	            has_fwhm_mz = true;
   100	          }
   101	          if (it_im != fda.end())
   102	          {
   103	            im_idx = std::distance(fda.begin(), it_im);
   104	            has_centroid_im = true;
   105	          }
   106	          if (it_imf != fda.end())
   107	          {
   108	            im_fwhm_idx = std::distance(fda.begin(), it_imf);
   109	            has_fwhm_im = true;
   110	          }
   111	          break;
   112	        }
   113	      }
   114	
   115	      // validate that all meta arrays are consistently present or absent across all spectra
   116	      auto validate_meta_array = [&](const String& name, int idx) {
   117	        if (idx == -1) return;
   118	
   119	        Size valid_count = 0;
   120	        for (const auto& spec : spectra)
   121	        {
   122	          const auto& fda = spec.getFloatDataArrays();
   123	          if (!fda.empty() && idx < (int)fda.size() && fda[idx].getName() == name)
   124	          {
   125	            if (fda[idx].size() != spec.size())
   126	            {
   127	              throw OpenMS::Exception::InvalidSize(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, spec.size(), "FloatDataArray size does not match spectrum size");
   128	            }
   129	            ++valid_count;
   130	          }
   131	        }
   132	
   133	        if (valid_count > 0 && valid_count != spectra.size())
   134	        {
   135	          throw OpenMS::Exception::Precondition(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   136	                                                name + " meta arrays must be consistently present or absent across all MS spectra ["
   137	                                                  + String(valid_count) + "/" + String(spectra.size()) + "].");
   138	        }
   139	      };
   140	
   141	      validate_meta_array(Constants::UserParam::FWHM_MZ_ppm, fwhm_meta_idx);
   142	      validate_meta_array(Constants::UserParam::ION_MOBILITY, im_idx);
   143	      validate_meta_array(Constants::UserParam::FWHM_IM, im_fwhm_idx);
   144	    }
   145	
   146	    void MassTraceDetection::run(PeakMap::ConstAreaIterator& begin,
   147	                                 PeakMap::ConstAreaIterator& end,
   148	                                 std::vector<MassTrace>& found_masstraces)
   149	    {
   150	      PeakMap map;
   151	      MSSpectrum current_spectrum;
   152	
   153	      if (begin == end)
   154	      {
   155	        return;
   156	      }
   157	
   158	      for (; begin != end; ++begin)
   159	      {
   160	        // AreaIterator points on novel spectrum?
   161	        if (begin.getRT() != current_spectrum.getRT())
   162	        {
   163	          // save new spectrum in map
   164	          if (current_spectrum.getRT() != -1)
   165	          {
   166	            map.addSpectrum(current_spectrum);
   167	          }
   168	          current_spectrum.clear(false);
   169	          current_spectrum.setRT(begin.getRT());
   170	        }
   171	        current_spectrum.push_back(*begin);
   172	      }
   173	      map.addSpectrum(current_spectrum);
   174	
   175	      run(map, found_masstraces);
   176	    }
   177	
   178	    void updateWeightedSDEstimateRobust(const PeakType& p, const double& mean_t1, double& sd_t, double& last_weights_sum)
   179	    {
   180	      double denom1 = std::log(last_weights_sum) + 2 * std::log(sd_t);
   181	      double denom2 = std::log(p.getIntensity()) + 2 * std::log(std::abs(p.getMZ() - mean_t1));
   182	      double denom = std::sqrt(std::exp(denom1) + std::exp(denom2));
   183	      double weights_sum = last_weights_sum + p.getIntensity();
   184	      double tmp_sd = denom / std::sqrt(weights_sum);
   185	
   186	      if (tmp_sd > std::numeric_limits<double>::epsilon())
   187	      {
   188	        sd_t = tmp_sd;
   189	      }
   190	
   191	      last_weights_sum = weights_sum;
   192	    }
   193	
   194	    void MassTraceDetection::run(const PeakMap& input_exp, std::vector<MassTrace>& found_masstraces, const Size max_traces)
   195	    {
   196	      // make sure the output vector is empty
   197	      found_masstraces.clear();
   198	
   199	      // Check IM unit and warn if CCS data with small tolerance (single-threaded check at algorithm start)
   200	      for (const auto& spec : input_exp)
   201	      {
   202	        if (spec.containsIMData())
   203	        {
   204	          const auto [im_data_index, im_unit] = spec.getIMData();
   205	          if (im_unit == DriftTimeUnit::CCS && ion_mobility_tolerance_ < 1.0)
   206	          {
   207	            OPENMS_LOG_WARN << "Warning: Ion mobility data is in CCS units (square angstroms), but "
   208	                            << "ion_mobility_tolerance = " << ion_mobility_tolerance_
   209	                            << " appears to be set for 1/K0 data. "
   210	                            << "For CCS data, consider using larger values (e.g., 2-10)." << '\n';
   211	          }
   212	          break; // Found IM data, no need to check further spectra
   213	        }
   214	      }
   215	
   216	      // gather all peaks that are potential chromatographic peak apices
   217	      //   - use work_exp for actual work (remove peaks below noise threshold)
   218	      //   - store potential apices in chrom_apices
   219	      PeakMap work_exp;
   220	      std::vector<Apex> chrom_apices;
   221	
   222	      Size total_peak_count(0);
   223	      std::vector<Size> spec_offsets;
   224	      spec_offsets.reserve(input_exp.size() + 1); // Pre-allocate for performance
   225	      spec_offsets.push_back(0);
   226	
   227	      Size spectra_count(0);
   228	
   229	      // *********************************************************** //
   230	      //  Step 1: Detecting potential chromatographic apices
   231	      // *********************************************************** //
   232	      for (const MSSpectrum& it : input_exp)
   233	      {
   234	        // check if this is a MS1 survey scan
   235	        if (it.getMSLevel() != 1)
   236	        {
   237	          continue;
   238	        }
   239	        std::vector<Size> indices_passing;
   240	        for (Size peak_idx = 0; peak_idx < it.size(); ++peak_idx)
   241	        {
   242	          double tmp_peak_int((it)[peak_idx].getIntensity());
   243	          if (tmp_peak_int > noise_threshold_int_)
   244	          {
   245	            // Assume that noise_threshold_int_ contains the noise level of the
   246	            // data and we want to be chrom_peak_snr times above the noise level
   247	            // --> add this peak as possible chromatographic apex
   248	            if (tmp_peak_int > chrom_peak_snr_ * noise_threshold_int_)
   249	            {
   250	              chrom_apices.emplace_back(tmp_peak_int, spectra_count, indices_passing.size());
   251	            }
   252	            indices_passing.push_back(peak_idx);
   253	            ++total_peak_count;
   254	          }
   255	        }
   256	        PeakMap::SpectrumType tmp_spec(it);
   257	        tmp_spec.select(indices_passing);
   258	        work_exp.addSpectrum(tmp_spec);
   259	        spec_offsets.push_back(spec_offsets.back() + tmp_spec.size());
   260	        ++spectra_count;
   261	      }
   262	
   263	      if (spectra_count < 3)
   264	      {
   265	        throw Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   266	                                      "Input map consists of too few MS1 spectra (less than 3!). Aborting...", String(spectra_count));
   267	      }
   268	
   269	      // discard last spectrum's offset
   270	      spec_offsets.pop_back();
   271	
   272	      std::stable_sort(chrom_apices.begin(), chrom_apices.end(),
   273	                [](const Apex & a,
   274	                    const Apex & b) -> bool
   275	      {
   276	        return a.intensity < b.intensity;
   277	      });
   278	
   279	      // *********************************************************************
   280	      // Step 2: start extending mass traces beginning with the apex peak (go
   281	      // through all peaks in order of decreasing intensity)
   282	      // *********************************************************************
   283	      run_(chrom_apices, total_peak_count, work_exp, spec_offsets, found_masstraces, max_traces);
   284	
   285	      return;
   286	    } // end of MassTraceDetection::run
   287	
   288	    MassTraceDetection::PeakCandidate MassTraceDetection::findBestPeak_(
   289	        const MSSpectrum& spectrum,
   290	        double centroid_mz,
   291	        double ftl_sd,
   292	        double centroid_im) const
   293	    {
   294	      PeakCandidate candidate;
   295	      
   296	      if (spectrum.empty())
   297	      {
   298	        return candidate;
   299	      }
   300	
   301	      double right_bound = centroid_mz + 3 * ftl_sd;
   302	      double left_bound = centroid_mz - 3 * ftl_sd;
   303	
   304	      if (!has_centroid_im_)
   305	      {
   306	        // Standard LC-MS data: find peak closest to target m/z
   307	        candidate.idx = spectrum.findNearest(centroid_mz);
   308	        candidate.mz = spectrum[candidate.idx].getMZ();
   309	        candidate.intensity = spectrum[candidate.idx].getIntensity();
   310	        candidate.found = true;
   311	      }
   312	      else
   313	      {
   314	        // LC-IMS-MS data: find best peak considering both m/z and ion mobility
   315	        double right_bound_im = centroid_im + ion_mobility_tolerance_;
   316	        double left_bound_im = centroid_im - ion_mobility_tolerance_;
   317	
   318	        auto left_bound_it = spectrum.MZBegin(left_bound);
   319	        Size idx_left = left_bound_it - spectrum.begin();
   320	        auto right_bound_it = spectrum.MZEnd(right_bound);
   321	        Size idx_right = right_bound_it - spectrum.begin();
   322	
   323	        // Search within m/z window for peak with closest ion mobility match
   324	        for (Size i = idx_left; i < idx_right; ++i)
   325	        {
   326	          double im_value = spectrum.getFloatDataArrays()[ion_mobility_idx_][i];
   327	          
   328	          if (im_value >= left_bound_im && im_value <= right_bound_im)
   329	          {
   330	            if (!candidate.found || std::abs(spectrum[i].getMZ() - centroid_mz) < std::abs(candidate.mz - centroid_mz))
   331	            {
   332	              candidate.idx = i;
   333	              candidate.mz = spectrum[i].getMZ();
   334	              candidate.intensity = spectrum[i].getIntensity();
   335	              candidate.im = im_value;
   336	              candidate.found = true;
   337	            }
   338	          }
   339	        }
   340	      }
   341	
   342	      return candidate;
   343	    }
   344	
   345	    bool MassTraceDetection::isPeakAcceptable_(
   346	        const PeakCandidate& candidate,
   347	        double centroid_mz,
   348	        double ftl_sd,
   349	        double centroid_im,
   350	        Size spectrum_idx,
   351	        const std::vector<Size>& spec_offsets,
   352	        const boost::dynamic_bitset<>& peak_visited) const
   353	    {
   354	      if (!candidate.found)
   355	      {
   356	        return false;
   357	      }
   358	
   359	      double right_bound = centroid_mz + 3 * ftl_sd;
   360	      double left_bound = centroid_mz - 3 * ftl_sd;
   361	
   362	      // Peak must fall within m/z tolerance window (±3 standard deviations)
   363	      if (!((candidate.mz <= right_bound) && (candidate.mz >= left_bound)))
   364	      {
   365	        return false;
   366	      }
   367	
   368	      // For ion mobility data, peak must also fall within IM tolerance window
   369	      if (has_centroid_im_)
   370	      {
   371	        double right_bound_im = centroid_im + ion_mobility_tolerance_;
   372	        double left_bound_im = centroid_im - ion_mobility_tolerance_;
   373	        
   374	        if (candidate.im < left_bound_im || candidate.im > right_bound_im)
   375	        {
   376	          return false;
   377	        }
   378	      }
   379	
   380	      // Peak must not have been used in another trace already
   381	      return !peak_visited[spec_offsets[spectrum_idx] + candidate.idx];
   382	    }
   383	
   384	    void MassTraceDetection::processPeak_(
   385	        const PeakCandidate& candidate,
   386	        const MSSpectrum& spectrum,
   387	        std::list<PeakType>& current_trace,
   388	        std::vector<std::pair<Size, Size>>& gathered_idx,
   389	        std::vector<double>& fwhms_mz,
   390	        std::vector<double>& fwhms_im,
   391	        double& centroid_mz,
   392	        double& centroid_im,
   393	        double& prev_counter,
   394	        double& prev_denom,
   395	        double& prev_counter_im,
   396	        double& prev_denom_im,
   397	        double& ftl_sd,
   398	        double& intensity_so_far,
   399	        Size spectrum_idx,
   400	        bool is_upward_extension)
   401	    {
   402	      Peak2D next_peak;
   403	      next_peak.setRT(spectrum.getRT());
   404	      next_peak.setMZ(candidate.mz);
   405	      next_peak.setIntensity(candidate.intensity);
   406	
   407	      // Add peak to the growing mass trace
   408	      if (is_upward_extension)
   409	      {
   410	        current_trace.push_back(next_peak);
   411	      }
   412	      else
   413	      {
   414	        current_trace.push_front(next_peak);
   415	      }
   416	
   417	      // Update trace centroid m/z with intensity-weighted average
   418	      updateIterativeWeightedMean_(candidate.mz, candidate.intensity, centroid_mz, prev_counter, prev_denom);
   419	      gathered_idx.emplace_back(spectrum_idx, candidate.idx);
   420	
   421	      // Update ion mobility centroid if available
   422	      if (has_centroid_im_)
   423	      {
   424	        updateIterativeWeightedMean_(candidate.im, candidate.intensity, centroid_im, prev_counter_im, prev_denom_im);
   425	      }
   426	
   427	      // Collect FWHM metadata for trace quality assessment
   428	      if (has_fwhm_mz_)
   429	      {
   430	        fwhms_mz.push_back(spectrum.getFloatDataArrays()[fwhm_meta_idx_][candidate.idx]);
   431	      }
   432	      if (has_fwhm_im_)
   433	      {
   434	        fwhms_im.push_back(spectrum.getFloatDataArrays()[im_fwhm_idx_][candidate.idx]);
   435	      }
   436	
   437	      // Dynamically adjust m/z tolerance based on observed variance
   438	      if (reestimate_mt_sd_)
   439	      {
   440	        updateWeightedSDEstimateRobust(next_peak, centroid_mz, ftl_sd, intensity_so_far);
   441	      }
   442	    }
   443	
   444	
   445	    bool MassTraceDetection::isTraceValid_(
   446	        const std::list<PeakType>& trace,
   447	        Size total_scans_visited,
   448	        Size consecutive_missed_down,
   449	        Size consecutive_missed_up) const
   450	    {
   451	      double rt_range = std::fabs(trace.rbegin()->getRT() - trace.begin()->getRT());
   452	      
   453	      // Check length criteria
   454	      if (rt_range < min_trace_length_)
   455	      {
   456	        return false;
   457	      }
   458	      
   459	      if (max_trace_length_ >= 0.0 && rt_range > max_trace_length_)
   460	      {
   461	        return false;
   462	      }
   463	
   464	      // Check quality (sample rate)
   465	      Size adjusted_scans = total_scans_visited - consecutive_missed_down - consecutive_missed_up;
   466	      double mt_quality = static_cast<double>(trace.size()) / static_cast<double>(adjusted_scans);
   467	      
   468	      return mt_quality >= min_sample_rate_;
   469	    }
   470	
   471	    void MassTraceDetection::run_(const std::vector<Apex>& chrom_apices,
   472	                                  const Size total_peak_count,
   473	                                  const PeakMap& work_exp,
   474	                                  const std::vector<Size>& spec_offsets,
   475	                                  std::vector<MassTrace>& found_masstraces,
   476	                                  const Size max_traces)
   477	    {
   478	      boost::dynamic_bitset<> peak_visited(total_peak_count);
   479	      Size trace_number(1);
   480	
   481	      // Detect ion mobility and FWHM metadata arrays in the dataset
   482	      getIMIndices_(work_exp,
   483	                    fwhm_meta_idx_, has_fwhm_mz_,
   484	                    ion_mobility_idx_, has_centroid_im_,
   485	                    im_fwhm_idx_, has_fwhm_im_);
   486	
   487	      this->startProgress(0, total_peak_count, "mass trace detection");
   488	      Size peaks_detected(0);
   489	
   490	      for (auto m_it = chrom_apices.crbegin(); m_it != chrom_apices.crend(); ++m_it)
   491	      {
   492	        Size apex_scan_idx(m_it->scan_idx);
   493	        Size apex_peak_idx(m_it->peak_idx);
   494	
   495	        if (peak_visited[spec_offsets[apex_scan_idx] + apex_peak_idx]) { continue; }
   496	
   497	        Peak2D apex_peak;
   498	        apex_peak.setRT(work_exp[apex_scan_idx].getRT());
   499	        apex_peak.setMZ(work_exp[apex_scan_idx][apex_peak_idx].getMZ());
   500	        apex_peak.setIntensity(work_exp[apex_scan_idx][apex_peak_idx].getIntensity());
   501	
   502	        std::list<PeakType> current_trace;
   503	        current_trace.push_back(apex_peak);
   504	        std::vector<double> fwhms_mz; // peak-FWHM meta values of collected peaks
   505	        std::vector<double> fwhms_im; // peak-FWHM ion mobility peak FWHM of collected peaks
   506	
   507	        // Initialization for the iterative version of weighted m/z mean calculation
   508	        double centroid_mz(apex_peak.getMZ());
   509	        double prev_counter(apex_peak.getIntensity() * apex_peak.getMZ());
   510	        double prev_denom(apex_peak.getIntensity());
   511	
   512	        updateIterativeWeightedMean_(apex_peak.getMZ(), apex_peak.getIntensity(), centroid_mz, prev_counter, prev_denom);
   513	
   514	        // Initialization for the iterative version of weighted ion mobility mean calculation
   515	        double centroid_im(-1);
   516	        double prev_counter_im(-1);
   517	        double prev_denom_im(-1);
   518	        if (has_centroid_im_)
   519	        {
   520	          centroid_im = work_exp[apex_scan_idx].getFloatDataArrays()[ion_mobility_idx_][apex_peak_idx];
   521	          prev_counter_im = apex_peak.getIntensity() * centroid_im;
   522	          prev_denom_im = apex_peak.getIntensity();
   523	          updateIterativeWeightedMean_(work_exp[apex_scan_idx].getFloatDataArrays()[ion_mobility_idx_][apex_peak_idx],
   524	                                        apex_peak.getIntensity(), centroid_im, prev_counter_im, prev_denom_im);
   525	        }
   526	
   527	        std::vector<std::pair<Size, Size>> gathered_idx;
   528	        gathered_idx.emplace_back(apex_scan_idx, apex_peak_idx);
   529	        
   530	        if (has_fwhm_mz_) { fwhms_mz.push_back(work_exp[apex_scan_idx].getFloatDataArrays()[fwhm_meta_idx_][apex_peak_idx]); }
   531	        if (has_fwhm_im_) { fwhms_im.push_back(work_exp[apex_scan_idx].getFloatDataArrays()[im_fwhm_idx_][apex_peak_idx]); }
   532	
   533	        TraceExtensionState down_state, up_state;
   534	        Size trace_down_idx(apex_scan_idx);
   535	        Size trace_up_idx(apex_scan_idx);
   536	
   537	        double ftl_sd((centroid_mz / 1e6) * mass_error_ppm_);
   538	        double intensity_so_far(apex_peak.getIntensity());
   539	
   540	        while ((trace_down_idx > 0 && down_state.active) || (trace_up_idx < work_exp.size() - 1 && up_state.active))
   541	        {
   542	          // *********************************************************** //
   543	          // Step 2.1 MOVE DOWN in RT dim
   544	          // *********************************************************** //
   545	          if (trace_down_idx > 0 && down_state.active)
   546	          {
   547	            const MSSpectrum& spec_trace_down = work_exp[trace_down_idx - 1];
   548	            
   549	            // Only process spectra that contain peaks
   550	            if (!spec_trace_down.empty())
   551	            {
   552	              PeakCandidate candidate = findBestPeak_(spec_trace_down, centroid_mz, ftl_sd, centroid_im);
   553	              
   554	              if (isPeakAcceptable_(candidate, centroid_mz, ftl_sd, centroid_im, trace_down_idx - 1, spec_offsets, peak_visited))
   555	              {
   556	                processPeak_(candidate, spec_trace_down, current_trace, gathered_idx,
   557	                            fwhms_mz, fwhms_im, centroid_mz, centroid_im,
   558	                            prev_counter, prev_denom, prev_counter_im, prev_denom_im,
   559	                            ftl_sd, intensity_so_far, trace_down_idx - 1, false);
   560	                ++down_state.hitting_peak_count;
   561	                down_state.consecutive_missed = 0;
   562	              }
   563	              else
   564	              {
   565	                ++down_state.consecutive_missed;
   566	              }
   567	            }
   568	            // Empty spectra don't affect termination counters
   569	            
   570	            // Move to next spectrum regardless of whether peak was found
   571	            --trace_down_idx;
   572	            ++down_state.scan_counter;
   573	            
   574	            // Apply termination criteria based on user configuration
   575	            if (trace_termination_criterion_ == OUTLIER)
   576	            {
   577	              if (down_state.consecutive_missed > trace_termination_outliers_)
   578	              {
   579	                down_state.active = false;
   580	              }
   581	            }
   582	            else if (trace_termination_criterion_ == SAMPLE_RATE)
   583	            {
   584	              Size min_scans_to_consider = 5;
   585	              Size total_hits = down_state.hitting_peak_count + up_state.hitting_peak_count + 1; // +1 for apex
   586	              Size total_scans = down_state.scan_counter + up_state.scan_counter + 1;
   587	              double current_sample_rate = static_cast<double>(total_hits) / static_cast<double>(total_scans);
   588	              
   589	              if (down_state.scan_counter > min_scans_to_consider && current_sample_rate < min_sample_rate_)
   590	              {
   591	                down_state.active = false;
   592	              }
   593	            }
   594	          }
   595	          // *********************************************************** //
   596	          // Step 2.2 MOVE UP in RT dim
   597	          // *********************************************************** //
   598	          if (trace_up_idx < work_exp.size() - 1 && up_state.active)
   599	          {
   600	            const MSSpectrum& spec_trace_up = work_exp[trace_up_idx + 1];
   601	            
   602	            // Only process spectra that contain peaks
   603	            if (!spec_trace_up.empty())
   604	            {
   605	              PeakCandidate candidate = findBestPeak_(spec_trace_up, centroid_mz, ftl_sd, centroid_im);
   606	              
   607	              if (isPeakAcceptable_(candidate, centroid_mz, ftl_sd, centroid_im, trace_up_idx + 1, spec_offsets, peak_visited))
   608	              {
   609	                processPeak_(candidate, spec_trace_up, current_trace, gathered_idx,
   610	                            fwhms_mz, fwhms_im, centroid_mz, centroid_im,
   611	                            prev_counter, prev_denom, prev_counter_im, prev_denom_im,
   612	                            ftl_sd, intensity_so_far, trace_up_idx + 1, true);
   613	                ++up_state.hitting_peak_count;
   614	                up_state.consecutive_missed = 0;
   615	              }
   616	              else
   617	              {
   618	                ++up_state.consecutive_missed;
   619	              }
   620	            }
   621	            // Empty spectra don't affect termination counters
   622	            
   623	            // Move to next spectrum regardless of whether peak was found
   624	            ++trace_up_idx;
   625	            ++up_state.scan_counter;
   626	            
   627	            // Apply termination criteria based on user configuration
   628	            if (trace_termination_criterion_ == OUTLIER)
   629	            {
   630	              if (up_state.consecutive_missed > trace_termination_outliers_)
   631	              {
   632	                up_state.active = false;
   633	              }
   634	            }
   635	            else if (trace_termination_criterion_ == SAMPLE_RATE)
   636	            {
   637	              Size min_scans_to_consider = 5;
   638	              Size total_hits = down_state.hitting_peak_count + up_state.hitting_peak_count + 1; // +1 for apex
   639	              Size total_scans = down_state.scan_counter + up_state.scan_counter + 1;
   640	              double current_sample_rate = static_cast<double>(total_hits) / static_cast<double>(total_scans);
   641	              
   642	              if (up_state.scan_counter > min_scans_to_consider && current_sample_rate < min_sample_rate_)
   643	              {
   644	                up_state.active = false;
   645	              }
   646	            }
   647	          }
   648	        }
   649	
   650	        // *********************************************************** //
   651	        // Step 2.3 check if minimum length and quality of mass trace criteria are met
   652	        // *********************************************************** //
   653	        Size total_scans = down_state.scan_counter + up_state.scan_counter + 1;
   654	        if (isTraceValid_(current_trace, total_scans, down_state.consecutive_missed, up_state.consecutive_missed))
   655	        {
   656	          // mark all peaks as visited
   657	          for (Size i = 0; i < gathered_idx.size(); ++i)
   658	          {
   659	            peak_visited[spec_offsets[gathered_idx[i].first] + gathered_idx[i].second] = true;
   660	          }
   661	
   662	          // create new MassTrace object and store collected peaks from list current_trace
   663	          MassTrace new_trace(current_trace);
   664	          new_trace.updateWeightedMeanRT();
   665	          new_trace.updateWeightedMeanMZ();
   666	          if (!fwhms_mz.empty()) { new_trace.fwhm_mz_avg = Math::median(fwhms_mz.begin(), fwhms_mz.end()); }
   667	          if (!fwhms_im.empty()) { new_trace.fwhm_im_avg = Math::median(fwhms_im.begin(), fwhms_im.end()); }
   668	          if (has_centroid_im_) { new_trace.setCentroidIM(centroid_im); }
   669	
   670	          new_trace.setQuantMethod(quant_method_);
   671	          new_trace.updateWeightedMZsd();
   672	          new_trace.setLabel("T" + String(trace_number));
   673	          ++trace_number;
   674	
   675	          found_masstraces.push_back(new_trace);
   676	
   677	          peaks_detected += new_trace.getSize();
   678	          this->setProgress(peaks_detected);
   679	
   680	          // check if we already reached the (optional) maximum number of traces
   681	          if (max_traces > 0 && found_masstraces.size() == max_traces) { break; }
   682	        }
   683	      }
   684	      this->endProgress();
   685	    }
   686	
   687	
   688	    void MassTraceDetection::updateMembers_()
   689	    {
   690	      mass_error_ppm_ = (double)param_.getValue("mass_error_ppm");
   691	      noise_threshold_int_ = (double)param_.getValue("noise_threshold_int");
   692	      chrom_peak_snr_ = (double)param_.getValue("chrom_peak_snr");
   693	      ion_mobility_tolerance_ = (double)param_.getValue("ion_mobility_tolerance");
   694	      quant_method_ = MassTrace::getQuantMethod((String)param_.getValue("quant_method").toString());
   695	
   696	      String criterion_str = (String)param_.getValue("trace_termination_criterion").toString();
   697	      if (criterion_str == "outlier")
   698	      {
   699	        trace_termination_criterion_ = OUTLIER;
   700	      }
   701	      else if (criterion_str == "sample_rate")
   702	      {
   703	        trace_termination_criterion_ = SAMPLE_RATE;
   704	      }
   705	      else
   706	      {
   707	        throw Exception::InvalidParameter(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION, "Invalid trace_termination_criterion: " + criterion_str);
   708	      }
   709	      
   710	      trace_termination_outliers_ = (Size)param_.getValue("trace_termination_outliers");
   711	      min_sample_rate_ = (double)param_.getValue("min_sample_rate");
   712	      min_trace_length_ = (double)param_.getValue("min_trace_length");
   713	      max_trace_length_ = (double)param_.getValue("max_trace_length");
   714	      reestimate_mt_sd_ = param_.getValue("reestimate_mt_sd").toBool();
   715	    }
   716	
   717	}
