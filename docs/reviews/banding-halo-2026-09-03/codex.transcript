  1489	      size_t i = idx[a];
  1490	      if (drop[i]) continue;
  1491	      const double tol = pcs[i].mono_mz * mass_ppm * 1e-6;
  1492	      for (size_t b = a + 1; b < idx.size(); ++b)
  1493	      {
  1494	        size_t j = idx[b];
  1495	        if (pcs[j].charge != pcs[i].charge) break;
  1496	        if (pcs[j].mono_mz - pcs[i].mono_mz > tol) break;
  1497	        if (drop[j]) continue;
  1498	        if (fabs(pcs[j].rt - pcs[i].rt) <= rt_tol && fabs(pcs[j].im - pcs[i].im) <= im_tol)
  1499	        {
  1500	          if (ms1[pcs[j].trace_idx].intensity > ms1[pcs[i].trace_idx].intensity) { drop[i] = true; break; }

