    19	namespace OpenMS
    20	{
    21	
    22	    /**
    23	      @brief A mass trace extraction method that gathers peaks similar in m/z and moving along retention time.
    24	
    25	      Peaks of a @ref MSExperiment are sorted by their intensity and stored in a
    26	      list of potential chromatographic apex positions. Only peaks that are above
    27	      the noise threshold (user-defined) are analyzed and only peaks that are n
    28	      times above this minimal threshold are considered as apices. This saves
    29	      computational resources and decreases the noise in the resulting output.
    30	
    31	      Starting with these, mass traces are extended in- and decreasingly in
    32	      retention time. During this extension phase, the centroid m/z is computed
    33	      on-line as an intensity-weighted mean of peaks.
    34	
    35	      The extension phase ends when either the frequency of gathered peaks drops
    36	      below a threshold (min_sample_rate, see @ref MassTraceDetection parameters)
    37	      or when the number of missed scans exceeds a threshold
    38	      (trace_termination_outliers, see @ref MassTraceDetection parameters).
    39	
    40	      Finally, only mass traces that pass a filter (a certain minimal and maximal
    41	      length as well as having the minimal sample rate criterion fulfilled) get
    42	      added to the result.
    43	
    44	      @htmlinclude OpenMS_MassTraceDetection.parameters
    45	
    46	      @ingroup Quantitation
    47	    */
    48	    class OPENMS_DLLAPI MassTraceDetection :
    49	            public DefaultParamHandler,
    50	            public ProgressLogger
    51	    {
    52	    public:
    53	        /// Trace termination criteria enum for performance optimization
    54	        enum TraceTerminationCriterion
    55	        {
    56	            OUTLIER,        ///< Terminate when consecutive outliers exceed threshold
    57	            SAMPLE_RATE     ///< Terminate when sample rate falls below threshold
    58	        };
    59	
    60	        /// Default constructor
    61	        MassTraceDetection();
    62	
    63	        /// Default destructor
    64	        ~MassTraceDetection() override;
    65	
    66	        /** @name Helper methods
    67	        */
    68	
    69	        /** @name Main computation methods
    70	        */
    71	
    72	        /// Main method of MassTraceDetection. Extracts mass traces of a @ref MSExperiment and gathers them into a vector container.
    73	        void run(const PeakMap &, std::vector<MassTrace> &, const Size max_traces = 0);
    74	
    75	        /// Invokes the run method (see above) on merely a subregion of a @ref MSExperiment map.
    76	        void run(PeakMap::ConstAreaIterator & begin, PeakMap::ConstAreaIterator & end, std::vector<MassTrace> & found_masstraces);
    77	
    78	        /// determine if meta array is available
    79	        bool hasFwhmMz() const { return has_fwhm_mz_; }
    80	        bool hasFwhmIm() const { return has_fwhm_im_; }
    81	        bool hasCentroidIm() const { return has_centroid_im_; }
    82	
    83	        /** @name Private methods and members
    84	        */
    85	    protected:
    86	        void updateMembers_() override;
    87	        /// allows for the iterative computation of intensity weighted of a mass trace's centroid m/z or ion mobility
    88	        static void updateIterativeWeightedMean_(const double& added_value,
    89	                                                const double& added_intensity,
    90	                                                double& centroid_value,
    91	                                                double& prev_counter,
    92	                                                double& prev_denom);
    93	
    94	    private:
    95	
    96	        struct Apex
    97	        {
    98	          Apex(double intensity, Size scan_idx, Size peak_idx);
    99	          double intensity;
   100	          Size scan_idx;
   101	          Size peak_idx;
   102	        };
   103	
   104	        /// Encapsulates peak finding logic for both up and down directions
   105	        struct PeakCandidate
   106	        {
   107	          Size idx;
   108	          double mz;
   109	          double intensity;
   110	          double im;
   111	          bool found;
   112	          
   113	          PeakCandidate() : idx(0), mz(-1.0), intensity(-1.0), im(-1.0), found(false) {}
   114	        };
   115	
   116	        /// Encapsulates trace extension state
   117	        struct TraceExtensionState
   118	        {
   119	          Size scan_counter;
   120	          Size hitting_peak_count;
   121	          Size consecutive_missed;
   122	          bool active;
   123	          
   124	          TraceExtensionState() : scan_counter(0), hitting_peak_count(0), consecutive_missed(0), active(true) {}
   125	        };
   126	
   127	        /// The internal run method
   128	        void run_(const std::vector<Apex>& chrom_apices,
   129	                  const Size peak_count,
   130	                  const PeakMap & work_exp,
   131	                  const std::vector<Size>& spec_offsets,
   132	                  std::vector<MassTrace> & found_masstraces,
   133	                  const Size max_traces = 0);
   134	
   135	        /// Internal helper to extract and validate metadata float array indices
   136	        void getIMIndices_(const PeakMap& spectra,
   137	                           int& fwhm_meta_idx, bool& has_fwhm_mz,
   138	                           int& im_idx, bool& has_centroid_im,
   139	                           int& im_fwhm_idx, bool& has_fwhm_im) const;
   140	
   141	        /// Find the best matching peak in a spectrum considering m/z and optionally ion mobility
   142	        PeakCandidate findBestPeak_(const MSSpectrum& spectrum,
   143	                                    double centroid_mz,
   144	                                    double ftl_sd,
   145	                                    double centroid_im = -1.0) const;
   146	
   147	        /// Check if peak candidate meets acceptance criteria
   148	        bool isPeakAcceptable_(const PeakCandidate& candidate,
   149	                              double centroid_mz,
   150	                              double ftl_sd,
   151	                              double centroid_im,
   152	                              Size spectrum_idx,
   153	                              const std::vector<Size>& spec_offsets,
   154	                              const boost::dynamic_bitset<>& peak_visited) const;
   155	
   156	        /// Process a single peak during trace extension
   157	        void processPeak_(const PeakCandidate& candidate,
   158	                         const MSSpectrum& spectrum,
   159	                         std::list<PeakType>& current_trace,
   160	                         std::vector<std::pair<Size, Size>>& gathered_idx,
   161	                         std::vector<double>& fwhms_mz,
   162	                         std::vector<double>& fwhms_im,
   163	                         double& centroid_mz,
   164	                         double& centroid_im,
   165	                         double& prev_counter,
   166	                         double& prev_denom,
   167	                         double& prev_counter_im,
   168	                         double& prev_denom_im,
   169	                         double& ftl_sd,
   170	                         double& intensity_so_far,
   171	                         Size spectrum_idx,
   172	                         bool is_upward_extension);
   173	
   174	
   175	        /// Check if a mass trace meets quality criteria
   176	        bool isTraceValid_(const std::list<PeakType>& trace,
   177	                          Size total_scans_visited,
   178	                          Size consecutive_missed_down,
   179	                          Size consecutive_missed_up) const;
   180	
   181	        // Metadata availability flags – set by getIMIndices_ and valid after run_()
   182	        bool has_fwhm_mz_ = false;
   183	        bool has_fwhm_im_ = false;
   184	        bool has_centroid_im_ = false;
   185	
   186	        // parameter stuff
   187	        double mass_error_ppm_;
   188	        double mass_error_da_;
   189	        double noise_threshold_int_;
   190	        double chrom_peak_snr_;
   191	        double ion_mobility_tolerance_;
   192	        MassTrace::MT_QUANTMETHOD quant_method_;
   193	
   194	        TraceTerminationCriterion trace_termination_criterion_;
   195	        Size trace_termination_outliers_;
   196	        double min_sample_rate_;
   197	        double min_trace_length_;
   198	        double max_trace_length_;
   199	
   200	        bool reestimate_mt_sd_;
   201	
   202	        // Metadata array indices - set during run_()
   203	        mutable int fwhm_meta_idx_ = -1;
   204	        mutable int ion_mobility_idx_ = -1;
   205	        mutable int im_fwhm_idx_ = -1;
   206	    };
   207	}

