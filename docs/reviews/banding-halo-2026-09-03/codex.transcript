    52	  @brief Extracts pseudo-MS/MS ("pseudo-DDA") spectra from diaPASEF (ion-mobility DIA) data.
    53	
    54	  Reconstructs DDA-like MS2 spectra from ion-mobility DIA (timsTOF / diaPASEF) data by
    55	  exploiting the fact that, in PASEF, fragments are recorded at the ion-mobility (1/K0)
    56	  elution coordinate of their precursor. Precursor and fragment mass traces are detected
    57	  IM-aware (@ref MassTraceDetection with an ion-mobility tolerance), then fragments are
    58	  assigned to a precursor when they co-localize in ion mobility, retention time, and
    59	  elution-profile (Pearson) correlation. The result is written as searchable mzML.
    60	
    61	  This is the OpenMS-native, BSD-3 analogue of Nesvilab diaTracer. It is a discovery
    62	  front-end (enables open / semi-tryptic / PTM searches); it does not perform the database
    63	  search, FDR, library building or quantification.
    64	
    65	  See docs/S30-BASELINE.md for the measured decisions behind every default, and docs/reviews/
    66	  for the adversarial reviews.
    67	
    68	  <B>The command line parameters of this tool are:</B>
    69	  @verbinclude TOPP_DIAPseudoSpectra.cli
    70	  <B>INI file documentation of this tool:</B>
    71	  @htmlinclude TOPP_DIAPseudoSpectra.html
    72	*/
    73	
    74	/// @cond TOPPCLASSES
    75	
    76	namespace
    77	{
    78	  /// A detected mass trace reduced to the quantities we correlate/gate on.
    79	  /// Current + peak resident set, read from /proc/self/status (Linux). Logged at phase boundaries so
    80	  /// the memory peak is MEASURED rather than estimated: it tells us whether the peak sits in the
    81	  /// raw-load phase or in the parallel per-window phase. Returns "" where unsupported. [mem]
    82	  /// seconds since tool start, for per-phase bottleneck attribution [perf]
    83	  static double phase_clock_()
    84	  {
    85	    static const auto t0 = std::chrono::steady_clock::now();
    86	    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
    87	  }
    88	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
    89	
    90	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
    91	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
    92	  /// printed unconditionally at the end so a benchmark log always says where the time went.
    93	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
    94	  inline double& flush_wall_() { static double v = 0; return v; }   // [perf-load] pick inside LOAD
    95	  inline std::map<std::string, PhaseStat>& phase_stats_()
    96	  { static std::map<std::string, PhaseStat> m; return m; }
    97	  inline std::vector<std::string>& phase_order_()
    98	  { static std::vector<std::string> v; return v; }
    99	  static double cpu_seconds_()
   100	  {
   101	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   102	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
   103	    return ru.ru_utime.tv_sec + ru.ru_utime.tv_usec * 1e-6
   104	         + ru.ru_stime.tv_sec + ru.ru_stime.tv_usec * 1e-6;
   105	  }
   106	  static long rss_mb_()
   107	  {
   108	    std::ifstream f("/proc/self/status"); std::string k;   // deliberate: Linux-only, returns 0 elsewhere
   109	    while (f >> k) { if (k == "VmRSS:") { long v; f >> v; return v / 1024; } f.ignore(1 << 20, '\n'); }
   110	    return 0;
   111	  }
   112	  struct Phase
   113	  {
   114	    std::string name; double w0, c0;
   115	    explicit Phase(std::string n) : name(std::move(n)), w0(phase_clock_()), c0(cpu_seconds_()) {}
   116	    ~Phase()
   117	    {
   118	      auto& st = phase_stats_()[name];
   119	      if (st.n == 0) phase_order_().push_back(name);
   120	      st.wall += phase_clock_() - w0; st.cpu += cpu_seconds_() - c0;
   121	      st.rss_end_mb = rss_mb_(); ++st.n;
   122	    }
   123	  };
   124	  static void report_phases_(double total_wall)
   125	  {
   126	    if (phase_order_().empty()) return;
   127	    OPENMS_LOG_INFO << "\n[perf] phase breakdown (wall s | % of total | CPU s | par x | RSS MB at end)\n";
   128	    double acc = 0;
   129	    for (const auto& n : phase_order_())
   130	    {
   131	      const auto& p = phase_stats_()[n];
   132	      acc += p.wall;
   133	      char b[220];
   134	      snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  %9.1f  %5.1fx  %8ld%s\n", n.c_str(), p.wall,
   135	               total_wall > 0 ? 100.0 * p.wall / total_wall : 0.0, p.cpu,
   136	               p.wall > 0 ? p.cpu / p.wall : 0.0, p.rss_end_mb, p.n > 1 ? "  (summed)" : "");
   137	      OPENMS_LOG_INFO << b;
   138	    }
   139	    char b[160];
   140	    snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  (unattributed %.1f s)\n", "TOTAL(measured)", acc,
   141	             total_wall > 0 ? 100.0 * acc / total_wall : 0.0, total_wall - acc);
   142	    OPENMS_LOG_INFO << b;
   143	  }
   144	
   145	  bool log_overlap_ = false;   ///< [B0] gate:coelution == "logoverlap"
   146	  /// [wavelet] Precursor-XIC smoothing scale in SECONDS, derived from the MEASURED MS1 FWHM
   147	  /// (trace:wavelet_smooth x median FWHM). 0 = off. Set once, after MS1 tracing, before the
   148	  /// window loop -- it cannot be read from a parameter directly because the FWHM is a measurement.
   149	  double wl_scale_ = 0.0;
   150	  bool rank_by_intensity_ = false;   ///< [rank] assembly:rank_by == "intensity" (diaTracer-style)
   151	  double im_weight_sigma_ = 0.0;     ///< [recall] Gaussian IM-proximity weight on emitted fragment intensity (0=off)
   152	  double mono_guard_ = 0.0;          ///< [mono-guard] averagine slack on leftward isotope steps (0=off)
   153	  bool mono_select_ = false;         ///< [mono-select] pick the mono by averagine fit over the isotope run
   154	  std::atomic<long long> stat_slice_{0};    ///< fragments VISITED by the IM slice
   155	  std::atomic<long long> stat_rtpass_{0};   ///< of those, how many pass the RT gate
   156	  std::atomic<long long> stat_prec_{0};     ///< precursors scored
   157	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   158	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   159	  bool drop_prec_iso_ = std::getenv("SPEXTRACT_DROP_PREC_ISO") != nullptr;   ///< [C9 A/B] drop precursor M+1..M+3 from fragment lists
   160	
   161	  static std::string rss_()
   162	  {
   163	    std::ifstream st("/proc/self/status");
   164	    if (!st) return "";
   165	    std::string line, cur = "?", peak = "?";
   166	    while (std::getline(st, line))
   167	    {
   168	      auto val = [&line]() {
   169	        std::string v = line.substr(line.find(':') + 1);
   170	        size_t a = v.find_first_not_of(" \t");
   171	        return a == std::string::npos ? std::string("?") : v.substr(a);
   172	      };
   173	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   174	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   175	    }
   176	    return " [RSS " + cur + ", peak " + peak + "]";
   177	  }
   178	
   179	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   180	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   181	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   182	  /// the other users. Add our own RSS back: memory we already hold is part of our budget, not
   183	  /// somebody else's. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   184	  static size_t availableBytes_()
   185	  {
   186	    std::ifstream mi("/proc/meminfo");
   187	    if (!mi) return 0;
   188	    std::string line;
   189	    size_t avail_kb = 0;
   190	    while (std::getline(mi, line))
   191	      if (line.rfind("MemAvailable:", 0) == 0)
   192	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   193	    if (!avail_kb) return 0;
   194	    std::ifstream st("/proc/self/status");
   195	    size_t rss_kb = 0;
   196	    while (st && std::getline(st, line))
   197	      if (line.rfind("VmRSS:", 0) == 0)
   198	      { rss_kb = strtoull(line.c_str() + 6, nullptr, 10); break; }
   199	    return (avail_kb + rss_kb) * 1024ull;
   200	  }
   201	
   202	  /// THE RT AXIS IS GLOBAL AND DISCRETE. Every acquired frame has one retention time, and every
   203	  /// point of every mass trace sits on one of those frames -- so an RT value never needs to be
   204	  /// stored per point. It used to be: `vector<pair<double,double>>` cost 16 B per point and
   205	  /// duplicated the same ~33,000 values across hundreds of millions of points, and aligning two
   206	  /// profiles meant a binary search per point because the values had to be compared numerically.
   207	  /// Here the axis is stored ONCE, a point is (frame index, intensity) at 8 B, and alignment is
   208	  /// integer equality. Built once after loading, read-only thereafter.
   209	  inline vector<double>& rtAxis() { static vector<double> v; return v; }
   210	
   211	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   212	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   213	  inline uint32_t rtIndex(double rt)
   214	  {
   215	    const vector<double>& a = rtAxis();
   216	    if (a.empty()) return 0;
   217	    auto it = lower_bound(a.begin(), a.end(), rt);
   218	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   219	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   220	    return (uint32_t)(it - a.begin());
   221	  }
   222	
   223	  struct Trace
   224	  {
   225	    double mz = 0.0;
   226	    double rt = 0.0;   ///< apex/centroid RT
   227	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   228	    double intensity = 0.0;
   229	    /// Elution profile, ascending in RT: parallel arrays of frame index and intensity. 8 B/point.
   230	    vector<uint32_t> xi;
   231	    vector<float>    xv;
   232	    size_t np() const { return xi.size(); }
   233	    double rtAt(size_t i) const { return rtAxis()[xi[i]]; }
   234	    double intAt(size_t i) const { return (double)xv[i]; }
   235	    void freeProfile() { vector<uint32_t>().swap(xi); vector<float>().swap(xv); }
   236	  };
   237	
   238	  /// A precursor hypothesis after isotope/charge inference.
   239	  struct Precursor_
   240	  {
   241	    double mono_mz = 0.0;
   242	    int charge = 0;          ///< 0 == unknown
   243	    double rt = 0.0;
   244	    double im = 0.0;
   245	    size_t trace_idx = 0;    ///< index into ms1 traces
   246	    bool guessed = false;    ///< [way-4] charge was DEFAULTED, not isotope-supported
   247	    int n_isotopes = 0;      ///< [Q4] isotope peaks behind the mono call (0/1 = weak, mono ±1.00335 uncertain)
   248	  };
   249	
   250	  /// MassTraceDetection locates the per-peak IM array by the exact name
   251	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   252	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   253	  void ensureIMArrayName(MSSpectrum& s)
   254	  {
   255	    auto& fdas = s.getFloatDataArrays();
   256	    if (s.containsIMData())
   257	    {
   258	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   259	      return;
   260	    }
   261	    for (auto& fda : fdas)
   262	    {
   263	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   264	      {
   265	        fda.setName(Constants::UserParam::ION_MOBILITY);
   266	        return;
   267	      }
   268	    }
   269	  }
   270	
   271	  /// Reported-m/z estimator, set once from `trace:mz_estimator` before any trace is converted.
   272	  /// A file-scope value because toTrace() is a free helper with no access to the tool's parameters.
   273	  inline std::string& mzEstimator() { static std::string v = "apex"; return v; }
   274	
   275	  Trace toTrace(const MassTrace& mt)
   276	  {
   277	    Trace t;
   278	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   279	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   280	    // `trace:mz_estimator` -- see docs/S30-BASELINE.md for the comparison that chose apex.
   281	    const std::string& mz_est = mzEstimator();
   282	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   283	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   284	    else t.mz = mt.getCentroidMZ();
   285	    t.rt = mt.getCentroidRT();
   286	    t.im = mt.getCentroidIM();
   287	    t.intensity = mt.getMaxIntensity(false);
   288	    // MassTrace peaks are not guaranteed RT-ordered, and the profile must be ascending for the
   289	    // correlation loops, so index them and sort the small (index, intensity) pairs.
   290	    const Size np = mt.getSize();
   291	    vector<pair<uint32_t, float>> pts;
   292	    pts.reserve(np);
   293	    for (Size i = 0; i < np; ++i) pts.emplace_back(rtIndex(mt[i].getRT()), (float)mt[i].getIntensity());
   294	    sort(pts.begin(), pts.end());
   295	    t.xi.reserve(np); t.xv.reserve(np);
   296	    for (const auto& q : pts) { t.xi.push_back(q.first); t.xv.push_back(q.second); }
   297	    return t;
   298	  }
   299	
   300	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   301	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   302	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   303	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   304	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   305	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   306	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   307	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   308	  struct FragGrid
   309	  {
   310	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   311	    vector<int> slot_of_frame;                  ///< global frame index -> grid slot, -1 if unused
   312	    vector<int> nearest_slot;                   ///< global frame index -> NEAREST used slot within delta_rt
   313	    vector<uint64_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   314	                                                ///  64-bit on purpose: 8.5 M fragments x ~510 support
   315	                                                ///  points is within 2x of the 32-bit wrap, and an
   316	                                                ///  overflow here silently corrupts every correlation.
   317	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   318	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   319	    size_t supBegin(size_t i) const { return off[i]; }
   320	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   321	  };
   322	
   323	
   324	  /// [cross-frame] Sliding-window aggregation of adjacent RT frames within ONE isolation window.
   325	  ///
   326	  /// diaTracer sums "adjacent neighbor RT frames" of the same isolation window into a composite
   327	  /// (m/z x 1/K0) matrix BEFORE peak picking, which raises per-point S/N by ~sqrt(N) and lets weak
   328	  /// fragments form traces at all (Nat Commun 16:95 Methods). Because a diaPASEF isolation window is
   329	  /// sampled exactly ONCE per cycle, "adjacent frames" == adjacent CYCLES.
   330	  ///
   331	  /// SLIDING (stride 1), not block: block summing would divide our RT point count by N, and peaks here
   332	  /// span only 4-22 points, which would leave too few points to correlate at all. The cost of sliding
   333	  /// is that adjacent output points share input frames and are therefore AUTOCORRELATED, which inflates
   334	  /// Pearson r for signal and noise alike - the reason this must be benchmarked, not assumed.
   335	  ///
   336	  /// Output spectrum i = intensity-weighted (m/z, IM) clustering of the peaks of spectra
   337	  /// [i-N/2, i+N/2], carrying the ORIGINAL RT of spectrum i so the RT axis is unchanged.
   338	  void aggregateFrames_(PeakMap& wmap, int n_frames, double ppm, double im_tol)
   339	  {
   340	    if (n_frames <= 1 || wmap.empty()) return;
   341	    const int half = n_frames / 2;
   342	    const Size N = wmap.size();
   343	
   344	    struct Pk { double mz; double im; double in; };
   345	    PeakMap out;
   346	    out.reserve(N);
   347	
   348	    vector<Pk> buf;
   349	    for (Size i = 0; i < N; ++i)
   350	    {
   351	      const Size lo = (i > (Size)half) ? i - half : 0;
   352	      const Size hi = std::min(N - 1, i + (Size)half);
   353	
   354	      buf.clear();
   355	      for (Size k = lo; k <= hi; ++k)
   356	      {
   357	        const MSSpectrum& sp = wmap[k];
   358	        if (!sp.containsIMData()) continue;
   359	        const auto& imarr = sp.getFloatDataArrays()[sp.getIMData().first];
   360	        for (Size p = 0; p < sp.size(); ++p) buf.push_back({sp[p].getMZ(), (double)imarr[p], sp[p].getIntensity()});
   361	      }
   362	      sort(buf.begin(), buf.end(), [](const Pk& a, const Pk& b) {
   363	        if (a.mz != b.mz) return a.mz < b.mz;
   364	        return a.im < b.im;
   365	      });
   366	
   367	      MSSpectrum agg;
   368	      agg.setRT(wmap[i].getRT());                 // RT axis preserved (sliding, stride 1)
   369	      agg.setMSLevel(wmap[i].getMSLevel());
   370	      agg.setPrecursors(wmap[i].getPrecursors());
   371	      OpenMS::DataArrays::FloatDataArray im_out;
   372	      im_out.setName(Constants::UserParam::ION_MOBILITY);   // keep tracing IM-aware
   373	
   374	      // greedy cluster in m/z (ppm) then IM: same ion across adjacent cycles collapses, intensities SUM
   375	      for (size_t a = 0; a < buf.size(); )
   376	      {
   377	        const double mz0 = buf[a].mz;
   378	        const double tol = mz0 * ppm * 1e-6;
   379	        size_t b = a;
   380	        double sum = 0.0, wmz = 0.0, wim = 0.0;
   381	        while (b < buf.size() && buf[b].mz - mz0 <= tol)
   382	        {
   383	          if (fabs(buf[b].im - buf[a].im) <= im_tol)
   384	          {
   385	            sum += buf[b].in; wmz += buf[b].mz * buf[b].in; wim += buf[b].im * buf[b].in;
   386	            buf[b].in = -1.0;                    // consumed
   387	          }
   388	          ++b;
   389	        }
   390	        if (sum > 0.0)
   391	        {
   392	          Peak1D pk; pk.setMZ(wmz / sum); pk.setIntensity((float)sum);
   393	          agg.push_back(pk);
   394	          im_out.push_back((float)(wim / sum));
   395	        }
   396	        // advance to next unconsumed peak
   397	        while (a < buf.size() && buf[a].in < 0.0) ++a;
   398	        if (a >= buf.size()) break;
   399	      }
   400	      agg.getFloatDataArrays().push_back(im_out);
   401	      agg.sortByPosition();
   402	      out.addSpectrum(std::move(agg));
   403	    }
   404	    wmap = std::move(out);
   405	  }
   406	
   407	  /// [compact] Quantised frame store for the per-window buffer.
   408	  ///
   409	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   410	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   411	  /// cores (diaTracer uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   412	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   413	  /// that is about to trace it, freeing the compact copy immediately.
   414	  ///
   415	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   416	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   417	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   418	  ///   intensity: float32, unchanged (Peak1D already stores float)
   419	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   420	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   421	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   422	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   423	
   424	  struct CompactFrame
   425	  {
   426	    double rt = 0.0;
   427	    vector<uint32_t> mzq;
   428	    vector<float> inten;
   429	    vector<uint16_t> imq;
   430	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   431	  };
   432	
   433	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   434	  /// [adv-fix] The first version CLAMPED out-of-range 1/K0 to IM_LO/IM_HI, which would pin outliers
   435	  /// from many frames onto two artificial, perfectly-aligned mobility values — manufacturing spurious
   436	  /// traces out of nothing. NaN also passed straight through clamp into llround (UB on unsigned
   437	  /// conversion). Dropping + counting is the only defensible behaviour.
   438	  struct CompactStats
   439	  {
   440	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   441	    /// merge per-frame stats after a parallel batch [perf-load]
   442	    CompactStats& operator+=(const CompactStats& o)
   443	    {
   444	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   445	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   446	      return *this;
   447	    }
   448	  };
   449	
   450	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   451	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   452	  {
   453	    CompactFrame f;
   454	    f.rt = s.getRT();
   455	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   456	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   457	    const Size n = s.size();
   458	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
   459	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   460	    for (Size i = 0; i < n; ++i)
   461	    {
   462	      const double mz = s[i].getMZ();
   463	      const double imv = (double)im[i];
   464	      // [adv-fix] validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   465	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   466	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   467	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   468	      f.inten.push_back(s[i].getIntensity());
   469	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   470	      ++st.kept;
   471	    }
   472	    return f;
   473	  }
   474	
   475	
   476	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   477	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACT_DET=1.
   478	  static uint64_t detDigest_(vector<uint64_t> bits)
   479	  {
   480	    std::sort(bits.begin(), bits.end());
   481	    uint64_t h = 1469598103934665603ULL;
   482	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   483	    return h;
   484	  }
   485	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACT_DET") != nullptr; return on; }
   486	  static uint64_t traceDigest_(const vector<Trace>& ts)
   487	  {
   488	    vector<uint64_t> b; b.reserve(ts.size() * 3);
   489	    for (const auto& t : ts)
   490	    {
   491	      uint64_t u; double v;
   492	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   493	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   494	      v = t.intensity; std::memcpy(&u, &v, 8); b.push_back(u);
   495	    }
   496	    return detDigest_(std::move(b));
   497	  }
   498	
   499	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   500	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   501	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   502	  {
   503	    PeakMap m;
   504	    m.reserve(frames.size());
   505	    for (auto& f : frames)
   506	    {
   507	      MSSpectrum s;
   508	      s.setRT(f.rt);
   509	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   510	      s.reserve(f.mzq.size());
   511	      OpenMS::DataArrays::FloatDataArray ima;
   512	      ima.setName(Constants::UserParam::ION_MOBILITY);
   513	      ima.reserve(f.mzq.size());
   514	      for (size_t i = 0; i < f.mzq.size(); ++i)
   515	      {
   516	        Peak1D p;
   517	        p.setMZ((double)f.mzq[i] / MZ_Q);
   518	        p.setIntensity(f.inten[i]);
   519	        s.push_back(p);
   520	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   521	      }
   522	      s.getFloatDataArrays().push_back(std::move(ima));
   523	      m.addSpectrum(std::move(s));
   524	      // release this frame's compact storage immediately
   525	      vector<uint32_t>().swap(f.mzq);
   526	      vector<float>().swap(f.inten);
   527	      vector<uint16_t>().swap(f.imq);
   528	    }
   529	    vector<CompactFrame>().swap(frames);
   530	    return m;
   531	  }
   532	
   533	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
   534	  ///
   535	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
   536	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
   537	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
   538	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
   539	  ///
   540	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
   541	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
   542	  /// ordering is the reader's business and need not match ours.
   543	  class PickCompactConsumer : public FullSwathFileConsumer
   544	  {
   545	  public:
   546	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
   547	                        PeakMap& ms1, CompactStats& stats,
   548	                        std::function<pair<int, int>(double, double)> keyfn)
   549	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
   550	
   551	    size_t frames_seen = 0;
   552	
   553	    /// [perf-load] Pick+compact a BATCH of buffered frames in parallel, then append in arrival
   554	    /// order. OpenMS hands frames over a strictly serial `for (fid..) consumeSpectrum(spec)` loop,
   555	    /// so before this the peak picking of 1.26e9 peaks ran on ONE thread and was 53% of total wall
   556	    /// (measured: 1046 s wall, parallel factor 1.0). Buffering here parallelises it without
   557	    /// touching the reader. Appending strictly by buffer index keeps the output order identical to
   558	    /// the serial path; the emitted spectra matched it in m/z and differed in ~2% of intensities at
   559	    /// the 1e-5..1e-4 relative level (Sage count unchanged) -- see docs/RUNTIME-PLAN [pick-det].
   560	    void flush_()
   561	    {
   562	      const int n = (int)buf_.size();
   563	      if (n == 0) return;
   564	      const double _tf0 = phase_clock_();
   565	      std::vector<CompactFrame> compacted((size_t)n);
   566	      std::vector<CompactStats> st((size_t)n);          // per-frame stats, merged serially below
   567	      PeakPickerIM picker = picker_;                    // Param is a deep-copy value type
   568	      // SPEXTRACT_PICK_SERIAL=1 runs this loop on one thread: the A/B that separates picker
   569	      // scheduling-sensitivity from downstream chaos (kimi, plan review). [pick-det]
   570	      static const bool par_pick = std::getenv("SPEXTRACT_PICK_SERIAL") == nullptr;
   571	      static const bool sched_set = []{ const bool st = std::getenv("SPEXTRACT_PICK_STATIC") != nullptr; omp_set_schedule(st ? omp_sched_static : omp_sched_dynamic, st ? 0 : 1); return true; }(); (void)sched_set;
   572	      std::exception_ptr pick_err;                      // an exception escaping an OMP region aborts
   573	      // chunk 1: with chunk 8 a 64-frame batch made only 8 chunks = 8 workers (codex, plan review)
   574	      #pragma omp parallel for firstprivate(picker) schedule(runtime) if(par_pick)   // SPEXTRACT_PICK_STATIC=1 -> static (history-vs-race probe)
   575	      for (int i = 0; i < n; ++i)
   576	      {
   577	        try
   578	        {
   579	          auto& s = buf_[(size_t)i];
   580	          ensureIMArrayName(s);
   581	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   582	          ensureIMArrayName(s);
   583	          compacted[(size_t)i] = compactify(s, st[(size_t)i]);
   584	          s.clear(true);                                // raw frame dies here, inside the loop
   585	        }
   586	        catch (...)
   587	        {
   588	          #pragma omp critical(pick_err)
   589	          if (!pick_err) pick_err = std::current_exception();
   590	        }
   591	      }
   592	      if (pick_err) std::rethrow_exception(pick_err);
   593	      for (int i = 0; i < n; ++i)
   594	      {
   595	        stats_ += st[(size_t)i];
   596	        windows_[key_[(size_t)i]].push_back(std::move(compacted[(size_t)i]));
   597	      }
   598	      flush_wall_() += phase_clock_() - _tf0;
   599	      buf_.clear(); key_.clear();
   600	    }
   601	
   602	  protected:
   603	    void consumeMS1Spectrum_(MapType::SpectrumType& s) override
   604	    {
   605	      // MS1 stays a PeakMap (MassTraceDetection needs it whole), but its pick is NOT small: 1,343
   606	      // frames x ~690k raw peaks = 37% of all peaks, and it used to run serially here (~400 s of
   607	      // LOAD, measured 2026-09-02). Buffer and pick in parallel like MS2; order is kept by index.
   608	      ms1_buf_.push_back(std::move(s));
   609	      ++frames_seen;
   610	      if (ms1_buf_.size() >= kBatch) flushMS1_();
   611	    }
   612	
   613	    void flushMS1_()
   614	    {
   615	      const int n = (int)ms1_buf_.size();
   616	      if (n == 0) return;
   617	      const double _tf0 = phase_clock_();
   618	      PeakPickerIM picker = picker_;
   619	      std::exception_ptr pick_err;
   620	      #pragma omp parallel for firstprivate(picker) schedule(dynamic, 1)
   621	      for (int i = 0; i < n; ++i)
   622	      {
   623	        try
   624	        {
   625	          auto& s = ms1_buf_[(size_t)i];
   626	          ensureIMArrayName(s);
   627	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   628	          ensureIMArrayName(s);
   629	        }
   630	        catch (...)
   631	        {
   632	          #pragma omp critical(pick_err_ms1)
   633	          if (!pick_err) pick_err = std::current_exception();
   634	        }
   635	      }
   636	      if (pick_err) std::rethrow_exception(pick_err);
   637	      for (auto& s : ms1_buf_) ms1_.addSpectrum(std::move(s));
   638	      ms1_buf_.clear();
   639	      flush_wall_() += phase_clock_() - _tf0;
   640	    }
   641	
   642	    void consumeSwathSpectrum_(MapType::SpectrumType& s, size_t /*swath_nr*/) override
   643	    {
   644	      const auto& prec = s.getPrecursors();
   645	      if (prec.empty()) return;                      // no isolation window -> not routable
   646	      const double c = prec[0].getMZ();
   647	      const double lo = c - prec[0].getIsolationWindowLowerOffset();
   648	      const double hi = c + prec[0].getIsolationWindowUpperOffset();
   649	      flushMS1_();                                   // MS1 arrives first; pick it before any MS2 work
   650	      key_.push_back(keyfn_(lo, hi));
   651	      buf_.push_back(std::move(s));                  // pick+compact deferred to flush_()
   652	      ++frames_seen;
   653	      if (buf_.size() >= kBatch) flush_();
   654	    }
   655	
   656	    void ensureMapsAreFilled_() override { flushMS1_(); flush_(); }   // pick up the tails
   657	
   658	  private:
   659	    /// deliberate: 256 frames is ~1 GB of raw buffer at ~37k peaks/frame -- 2.5 work items per
   660	    /// thread at 100 threads (64 gave 8 chunks of 8 = 8 workers), small next to the 12 GB compact
   661	    /// store. SPEXTRACT_PICK_BATCH overrides for the sweep.
   662	    static const size_t kBatch;
   663	    std::vector<MapType::SpectrumType> buf_;
   664	    std::vector<pair<int, int>> key_;
   665	    PeakPickerIM& picker_;
   666	    std::vector<MapType::SpectrumType> ms1_buf_;   // MS1 frames awaiting the parallel pick
   667	    map<pair<int, int>, vector<CompactFrame>>& windows_;
   668	    PeakMap& ms1_;
   669	    CompactStats& stats_;
   670	    std::function<pair<int, int>(double, double)> keyfn_;
   671	  };
   672	  const size_t PickCompactConsumer::kBatch =
   673	    std::getenv("SPEXTRACT_PICK_BATCH") ? (size_t)std::atoi(std::getenv("SPEXTRACT_PICK_BATCH")) : 256;
   674	
   675	  /// [wavelet] Stationary ("a trous") B3-spline wavelet smoothing of an elution profile.
   676	  ///
   677	  /// WHY. diaTracer correlates a SMOOTHED precursor XIC against RAW fragment XICs (Nat Commun
   678	  /// 16:95, Methods: 2D Gaussian pre-filter, then Savitzky-Golay for elongated peaks). We copied
   679	  /// its 0.3 correlation threshold WITHOUT copying the smoothing. Pearson r between two noisy
   680	  /// profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker
   681	  /// constraint than a smoothed 0.3 -- and the attenuation is worst exactly at faint precursors,
   682	  /// which is where the coverage analysis says we lose peptides (MISS precursors are 3.2x dimmer).
   683	  /// Raising the threshold to compensate was tried and produced only an FDR artefact; smoothing
   684	  /// attacks the cause instead of the symptom.
   685	  ///
   686	  /// A-TROUS, not a decimated DWT: no downsampling, so the output stays sample-aligned with the
   687	  /// input and can be scattered onto the correlation grid at the SAME RT positions. That matters
   688	  /// for correctness here, not just convenience -- the overlap gate counts grid points where the
   689	  /// precursor is non-zero, so a transform that moved or resampled points would silently change
   690	  /// what `min_correlation_points` means.
   691	  ///
   692	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
   693	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
   694	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
   695	  {
   696	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
   697	    const int n = (int)in.size();
   698	    out = in;
   699	    if (n < 3 || levels <= 0) return;
   700	    vector<double> tmp(n);
   701	    for (int j = 1; j <= levels; ++j)
   702	    {
   703	      const int step = 1 << (j - 1);
   704	      for (int i = 0; i < n; ++i)
   705	      {
   706	        double acc = 0.0;
   707	        for (int k = -2; k <= 2; ++k)
   708	        {
   709	          int idx = i + k * step;
   710	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
   711	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
   712	          if (idx < 0) idx = -idx;
   713	          if (idx >= n) idx = 2 * (n - 1) - idx;
   714	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
   715	          acc += H[k + 2] * out[idx];
   716	        }
   717	        tmp[i] = acc;
   718	      }
   719	      out.swap(tmp);
   720	    }
   721	  }
   722	
   723	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
   724	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
   725	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
   726	  /// physical widths on different traces.
   727	  int atrousLevels(const Trace& tr, double scale_sec)
   728	  {
   729	    if (tr.np() < 5 || scale_sec <= 0.0) return 0;
   730	    vector<double> d;
   731	    d.reserve(tr.np() - 1);
   732	    for (size_t i = 1; i < tr.np(); ++i)
   733	    {
   734	      const double g = tr.rtAt(i) - tr.rtAt(i - 1);
   735	      if (g > 0) d.push_back(g);
   736	    }
   737	    if (d.empty()) return 0;
   738	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
   739	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
   740	    if (dt <= 0.0) return 0;
   741	    const double want = scale_sec / dt;                // desired support, in SAMPLES
   742	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
   743	    const int j = (int)std::lround(std::log2(want));
   744	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
   745	  }
   746	
   747	  /// Build the per-window FragGrid from IM-sorted fragment traces.
   748	  /// Resample every fragment XIC onto one common RT grid, as CSR. Takes `frags` by reference and
   749	  /// CONSUMES each XIC as it is copied: the XIC vectors and the grid would otherwise be live at the
   750	  /// same time, and their coexistence is what sets the per-window memory peak.
   751	  FragGrid buildFragGrid(vector<Trace>& frags, double delta_rt)
   752	  {
   753	    FragGrid g;
   754	    // On the global axis the grid is just the set of FRAME INDICES this window's fragments touch.
   755	    // Mark them in a flat array over the axis, then number the used ones: no collecting of ~10^8
   756	    // RT values, no large sort, and no binary search per point -- axis index to grid slot is a
   757	    // single array read. G (the Pearson denominator) is the count of used frames, exactly as before.
   758	    const size_t na = rtAxis().size();
   759	    vector<char> used(na, 0);
   760	    for (const auto& f : frags) for (uint32_t k : f.xi) used[k] = 1;

exec
/bin/bash -lc "nl -ba src/DIAPseudoSpectra.cpp | sed -n '761,1500p'" in /Users/kohlbach/Claude/speXtract
 succeeded in 0ms:
   761	    g.slot_of_frame.assign(na, -1);
   762	    g.rt.clear();
   763	    for (size_t k = 0; k < na; ++k)
   764	      if (used[k]) { g.slot_of_frame[k] = (int)g.rt.size(); g.rt.push_back(rtAxis()[k]); }
   765	    const double G = (double)g.rt.size();
   766	    // Precursor profiles live on MS1 frames, fragment profiles on MS2 frames, so a precursor point
   767	    // must be matched to the NEAREST fragment frame within gate:delta_rt. That was a binary search
   768	    // per point per precursor -- the same answer recomputed for every precursor in the window. It
   769	    // depends only on the window, so compute it once for every frame of the axis. Ties go to the
   770	    // LATER slot, as the search it replaces did.
   771	    g.nearest_slot.assign(na, -1);
   772	    {
   773	      vector<size_t> u;
   774	      u.reserve(g.rt.size());
   775	      for (size_t k = 0; k < na; ++k) if (used[k]) u.push_back(k);
   776	      size_t hi = 0;
   777	      for (size_t f = 0; f < na; ++f)
   778	      {
   779	        while (hi < u.size() && u[hi] < f) ++hi;
   780	        const double t = rtAxis()[f];
   781	        double bd = delta_rt; int gi = -1;
   782	        if (hi > 0)
   783	        { const double d = fabs(rtAxis()[u[hi - 1]] - t); if (d <= bd) { bd = d; gi = g.slot_of_frame[u[hi - 1]]; } }
   784	        if (hi < u.size())
   785	        { const double d = fabs(rtAxis()[u[hi]] - t); if (d <= bd) { bd = d; gi = g.slot_of_frame[u[hi]]; } }
   786	        g.nearest_slot[f] = gi;
   787	      }
   788	    }
   789	    g.mean.resize(frags.size());
   790	    g.invnorm.resize(frags.size());
   791	    g.off.assign(frags.size() + 1, 0);
   792	    // Offsets first, so each fragment owns a disjoint span and the fill is parallel and
   793	    // deterministic (identical arithmetic per fragment, in the same order, whoever runs it).
   794	    for (size_t i = 0; i < frags.size(); ++i) g.off[i + 1] = g.off[i] + (uint64_t)frags[i].np();
   795	    g.flat.resize((size_t)g.off[frags.size()]);
   796	    #pragma omp taskloop default(shared)
   797	    for (long ii = 0; ii < (long)frags.size(); ++ii)
   798	    {
   799	      const size_t i = (size_t)ii;
   800	      double sum = 0, sumsq = 0;
   801	      size_t w = (size_t)g.off[i];
   802	      const Trace& f = frags[i];
   803	      for (size_t k = 0; k < f.np(); ++k)
   804	      {
   805	        const double v = f.intAt(k);
   806	        g.flat[w++] = {g.slot_of_frame[f.xi[k]], (float)v};
   807	        sum += v; sumsq += v * v;
   808	      }
   809	      g.mean[i] = sum / G;
   810	      const double var = sumsq - G * g.mean[i] * g.mean[i];
   811	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0;  // 0 => constant/degenerate -> never correlates
   812	      frags[i].freeProfile();   // consumed here, not after scoring
   813	    }
   814	    return g;
   815	  }
   816	}
   817	
   818	class TOPPDIAPseudoSpectra : public TOPPBase
   819	{
   820	public:
   821	  TOPPDIAPseudoSpectra() :
   822	    TOPPBase("DIAPseudoSpectra", "Extracts pseudo-MS/MS spectra from diaPASEF (ion-mobility DIA) data.")
   823	  {
   824	  }
   825	
   826	protected:
   827	  void registerOptionsAndFlags_() override
   828	  {
   829	    registerInputFile_("in", "<file>", "", "Input diaPASEF data (ion-mobility DIA; 1/K0 / VSSC): mzML, mzPeak, or a Bruker .d directory.");
   830	    setValidFormats_("in", {"mzML", "mzpeak", "d"});
   831	    registerOutputFile_("out", "<file>", "", "Output pseudo-MS2 mzML (searchable by a DDA engine).");
   832	    setValidFormats_("out", {"mzML"});
   833	
   834	    registerTOPPSubsection_("gate", "Precursor-to-fragment co-localization gate");
   835	    // Conservative, documented defaults; these are placeholders pending a real-data sweep. [H-3]
   836	    registerDoubleOption_("gate:delta_im", "<1/K0>", 0.01, "Max |precursor - fragment| ion mobility difference (1/K0). (diaTracer deltaApexIM default 0.01)", false);
   837	    registerDoubleOption_("gate:delta_rt", "<sec>", 3.0, "Max |precursor - fragment| apex RT difference (seconds).", false);
   838	    registerDoubleOption_("gate:min_correlation", "<0..1>", 0.3, "Min Pearson correlation of elution profiles. (diaTracer ms1MS2Corr default 0.3; raise for cleaner but sparser spectra)", false);
   839	    registerIntOption_("gate:min_correlation_points", "<n>", 3, "Min overlapping XIC points required to accept a correlation.", false, true);
   840	
   841	    registerTOPPSubsection_("assembly", "Pseudo-spectrum assembly");
   842	    registerIntOption_("assembly:min_fragments", "<n>", 3, "Emit a pseudo-spectrum only if it has at least this many fragments.", false);
   843	    registerIntOption_("assembly:max_fragments", "<n>", 500, "Keep at most this many (top-ranked) fragments per pseudo-spectrum.", false);
   844	    registerFlag_("assembly:competitive", "Assign each fragment to only its single best-correlating precursor (de-chimerize). Shorthand for rp_max=1; the harder endpoint of the rp_max dial. [bench]");
   845	    registerDoubleOption_("assembly:apportion", "<p>", 0.0, "[route-4] Split a shared fragment's INTENSITY across the precursors that claim it, weight w_i = corr_i^p / sum(corr^p), instead of copying it at full intensity into all of them (mean fan-out 6.45). Fragment COUNT is unchanged - only the weighting - so it sidesteps every falsified count knob (rank-pruning, competitive, min_corr, min_corr_pts). 0 = OFF. Try 1 (linear) or 2 (sharper); p->inf degenerates to competitive, which IS falsified. Share-all path only.", false);
   846	    registerStringOption_("assembly:rank_by", "<mode>", "correlation", "[rank] Which score decides WHICH fragments survive the assembly:max_fragments cap. 'correlation' (current) keeps the top-N best-CORRELATING; 'intensity' keeps the top-N most INTENSE, as diaTracer does (Nat Commun 16:95: 'only the top N highest intensity peaks (RF max, default 500)'). This matters because the search engine re-ranks BY INTENSITY: Sage keeps max_peaks=150 by intensity and MSFragger reads the full list. A high-intensity, mediocre-correlation fragment that our cap discards would have been scored by the engine, so a correlation-ranked cap can throw away exactly the peaks that get matched. 70-75% of our spectra sit AT the 500 cap, so the choice is live for most spectra, not a corner case.", false);
   847	    setValidStrings_("assembly:rank_by", {"correlation", "intensity"});
   848	    registerDoubleOption_("assembly:im_weight_sigma", "<1/K0>", 0.0, "[recall] Down-weight each emitted fragment's intensity by a Gaussian of its ion-mobility distance from the precursor, exp(-(dIM)^2 / 2 sigma^2). TIMS precedes fragmentation so a TRUE fragment shares the precursor's 1/K0 exactly; a co-isolating interferent at the edge of the gate:delta_im band is suppressed. WITHIN-spectrum (no fragment removed or redistributed across precursors) so it escapes the fan-out depletion that falsified competitive/apex/deconvolution, and directly un-buries faint true fragments under the engine's intensity top-150. 0 = off. Try ~0.005 (half the 0.01 IM gate). [bench]", false);
   849	    registerDoubleOption_("assembly:corr_power", "<k>", 2.0, "[Q2] Multiply each emitted fragment's intensity by corr^k (k>=0), where corr is the fragment-precursor co-elution score. EMIT-ONLY (excluded from the max_fragments cap key), so it preserves peak membership and only re-ranks the intensities the search engine sees toward well-correlating (true co-eluting) fragments and away from bright interferents; WITHIN-spectrum so it escapes fan-out depletion. DEFAULT 2.0 since 2026-07-28: validated on S30 (tuning) + S08 + S23 (held out) at frozen k=2 -- +8-10%% Sage / +5-8%% MSFragger over base on all three, both engines, at controlled empirical FDR; k=2 sits one step below the ~k=3 Sage peak (the safe side of the crossover where c^k starts crushing the faint tail). 0 = off (pre-2026-07-28 behaviour). Dimensionless + bounded (c in [0.3,1]) so it transfers across instruments, unlike assembly:im_weight_sigma. [bench]", false);
   850	    registerIntOption_("assembly:rp_max", "<n>", 0, "FALSIFIED on S30 (2026-07, all cross-precursor redistributions lost peptides; note the A/B ran with corr_power silently OFF until 2026-09-02 [E5]) -- keep 0. Soft RP rank-pruning (DIA-Umpire style): keep each fragment in only its top-N best-correlating precursors. 0 = unlimited (share-all, the default); 1 = competitive (winner-take-all). Small N (2-8) is the useful range given typical fan-out ~6. RFmax (per-precursor fragment cap) is 'max_fragments'. Runs emit a fan-out histogram so you can see whether a given rp_max actually bites. [bench]", false);
   851	    registerFlag_("assembly:open_search_safe", "[way-4] ANNOTATION-SAFE output for BLIND/OPEN search. In open search a wrong charge is catastrophic in a way closed search hides: assigning z' instead of z shifts the neutral mass by dM=(z'-z)(m/z-1.0073), so ONE charge step at m/z 500 fabricates a ~499 Da 'modification'. Closed search barely notices (charge unset cost only 1.3%: 8,123->8,019) because the engine enumerates charge; an open engine trusts the annotation. This flag therefore: (a) emits charge UNSET for every precursor whose charge was GUESSED rather than isotope-supported, so the engine enumerates instead of trusting a default; (b) records the isotope-offset hypothesis as a meta value so delta-mass inference can correct BEFORE assigning a modification, rather than reporting phantom +-1.00335/+-2.0067 Da shifts. Use for open/variant search; leave off for closed-search peptide counting.");
   852	    registerIntOption_("assembly:default_charge", "<z>", 2, "Charge for precursors with no isotope support: >0 assigns that charge (diaTracer-style; 2 = most common); 0 = leave charge UNSET so the search engine searches its charge range and picks the right one (recovers 3+/4+ that a forced 2 would lose).", false);
   853	
   854	    registerTOPPSubsection_("trace", "Mass-trace detection (see MassTraceDetection)");
   855	    registerDoubleOption_("trace:mass_error_ppm", "<ppm>", 15.0, "m/z tolerance for trace detection.", false);
   856	    registerDoubleOption_("trace:noise_threshold_int", "<int>", 100.0, "MS1 (precursor) noise intensity threshold.", false);
   857	    registerDoubleOption_("trace:ms2_noise_threshold_int", "<int>", 10.0, "MS2 (fragment) noise threshold. Lower it (e.g. 50, 20) to recover weak fragments toward diaTracer-like density; the grid-Pearson optimization keeps that affordable.", false);
   858	    registerDoubleOption_("trace:min_length_sec", "<sec>", 3.0, "Minimum MS1 mass-trace length (seconds).", false, true);
   859	    // diaTracer runs MS2 with deliberately RELAXED constraints vs MS1 (Nat Commun 16:95). The OpenMS
   860	    // apex gate is chrom_peak_snr*noise_threshold_int, so the stock snr=3.0 silently TRIPLES the
   861	    // fragment threshold (a "noise 30" run really gated apices at 90). Decouple both for MS2. [recall]
   862	    registerDoubleOption_("trace:ms1_chrom_peak_snr", "<x>", 3.0, "Apex signal-to-noise multiplier for MS1 traces (effective apex threshold = this x noise_threshold_int). OpenMS default 3.0.", false, true);
   863	    registerDoubleOption_("trace:ms2_chrom_peak_snr", "<x>", 1.0, "Apex signal-to-noise multiplier for MS2 (fragment) traces. 1.0 = the ms2_noise_threshold_int you set IS the apex threshold; 3.0 would reproduce the old hidden 3x. Lower = more weak fragments recovered.", false);
   864	    registerDoubleOption_("trace:ms2_min_length_sec", "<sec>", 0.0, "Minimum MS2 (fragment) mass-trace length (seconds). 0 = no length filter (diaTracer-style relaxed MS2); MS1 keeps trace:min_length_sec.", false);
   865	    registerStringOption_("trace:mz_estimator", "<mode>", "apex", "Reported m/z of a mass trace. "
   866	                          "'apex' (default) uses the most intense peak's m/z; 'mean' the OpenMS intensity-weighted "
   867	                          "centroid; 'median' the median. apex was chosen on measured identifications with both "
   868	                          "search engines -- see docs/S30-BASELINE.md. Affects EVERY reported precursor and "
   869	                          "fragment m/z.", false);
   870	    setValidStrings_("trace:mz_estimator", {"apex", "mean", "median"});
   871	    registerDoubleOption_("trace:ms2_split_valleys", "<chrom_fwhm>", 7.0, "[way-2] Split MS2 mass traces at chromatographic local minima via ElutionPeakDetection (which MassTraceDetection never does - it only terminates on outliers, so two peptides 25 s apart within the m/z tolerance MERGE). Value is chrom_fwhm in seconds; it sets both the Savitzky-Golay window and the local-extrema half-window. 0 = OFF. Try 6-8 (peaks here are 5-30 s). width_filtering is forced off so this only SPLITS, never deletes.", false);
   872	    registerFlag_("diag:selftest_wavelet", "[wavelet] Run assertions on the a-trous smoother and exit. Tests the SHIPPED functions, not a copy: DC preservation (filter must sum to 1, or every correlation is rescaled), noise reduction, peak-height retention at the FWHM-derived scale, mirror edges (a truncated peak must not be dragged toward zero), and level selection from sampling. Exits non-zero on failure.", true);
   873	    registerDoubleOption_("trace:wavelet_smooth", "<x>", 0.0, "[wavelet] Smooth the PRECURSOR XIC with a stationary (a-trous) B3-spline wavelet before correlating fragments against it, at a scale of x TIMES THE MEASURED MS1 FWHM. diaTracer smooths its precursor profile (2D Gaussian + Savitzky-Golay) and then applies a 0.3 correlation threshold; we copied the 0.3 but not the smoothing. Pearson r between two NOISY profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker constraint than a smoothed 0.3 -- and worst at faint precursors, which is where the coverage analysis says peptides are lost. Fragment XICs stay RAW (as in diaTracer) and emitted peak intensities are unaffected. 0 = off. Try 0.25-0.5 (measured MS1 FWHM is 3.61 s on S30, so 0.5 ~ 1.8 s ~ 1.3 cycles).", false);
   874	    registerDoubleOption_("trace:split_valleys_fwhm", "<x>", 0.0, "[fwhm] Set the valley-splitting window as a MULTIPLE OF THE MEASURED MS1 FWHM instead of absolute seconds. Overrides trace:ms2_split_valleys when > 0 (the MS2 window is the one it sets). Absolute seconds cannot be right across methods: 14.0 s is +0.0% peptides on a 31 min gradient and -1.06% on a 5.6 min one. Measured MS1 FWHM is 3.61 s on S30, so the old 7.0 s default is ~1.9x FWHM and 14.0 s is ~3.9x. 0 = off (use absolute seconds).", false);
   875	    registerDoubleOption_("trace:ms1_split_valleys", "<chrom_fwhm>", 7.0, "Split MS1 mass traces at chromatographic valleys via ElutionPeakDetection. DEFAULT 7.0 s: MassTraceDetection never splits at a local minimum, so two peptides eluting ~25 s apart within the m/z tolerance merge into ONE multi-modal trace, producing a merged precursor with the wrong monoisotope and charge. Measured +36.7% peptides on S23 and +37.4% on S08 at peptide-level FDR. Costs ~1.7x wall time and ~25% peak RAM. 0 = off.", false);
   876	    registerDoubleOption_("trace:max_trace_length_sec", "<sec>", -1.0, "DANGER - NOT a guard. MassTraceDetection::isTraceValid_ RETURNS FALSE on over-length traces and peaks are marked visited only for VALID traces, so an over-length blob is rejected, re-seeded by the next apex, and rejected again - emitting NOTHING at that m/z. Setting this DELETES signal (the falsified direction). Kept only for diagnostics; leave at -1. Splitting requires ElutionPeakDetection, not this. [merged-trace]", false, true);
   877	registerIntOption_("trace:frame_aggregation_ms1_n", "<n>", 1, "[cross-frame] Same as frame_aggregation_n but for the MS1 (PRECURSOR) map. This is the one that can add DEPTH: measurement shows we identify MORE spectra than diaTracer (3.7%% vs 2.0%% of spectra) but cover FEWER distinct peptides (4.6 vs 1.46 PSMs/peptide), i.e. we miss low-abundance PRECURSORS. Aggregating MS2 alone cannot fix that. 1 = off.", false);
   878	    registerIntOption_("trace:frame_aggregation_n", "<n>", 1, "[cross-frame] Number of ADJACENT RT frames (= adjacent diaPASEF CYCLES, since each isolation window is sampled once per cycle) summed into a composite (m/z x 1/K0) frame BEFORE MS2 peak/trace detection, diaTracer-style. 1 = off (current behaviour). 5 = user request. Sliding window, stride 1, so the RT axis and point count are preserved; note adjacent output points then share input frames and are AUTOCORRELATED, which inflates Pearson r - benchmark, do not assume.", false);
   879	    registerDoubleOption_("trace:ms2_min_sample_rate", "<r>", -1.0, "MS2 min fraction of visited scans that must contain a peak (MassTraceDetection min_sample_rate). OpenMS default 0.5 hard-deletes gappy fragment traces; MEASURED: 0.3 and 0.1 both LOSE peptides (8,865 -> 8,735 at 0.3), so -1 (= OpenMS 0.5) is the default. Lowering it produces longer, more-merged traces with wrong apexes.", false);
   880	    registerDoubleOption_("trace:ms1_min_sample_rate", "<r>", -1.0, "MS1 min_sample_rate. -1 = OpenMS default 0.5 (strict, MS1 stays strict).", false, true);
   881	
   882	    // NB: "threads" is reserved by TOPPBase (the standard -threads option), so this lives under "perf".
   883	    // [route-1] feature-level consolidation: collapse spectra that are the SAME chromatographic
   884	    // feature emitted more than once (RT slices / IM sub-ranges / charge hypotheses). Targets the
   885	    // measured 4.6 vs 1.46 PSMs-per-peptide gap. OFF by default (delta_rt 0) - it is a deletion.
   886	    registerTOPPSubsection_("consolidate", "Feature-level de-duplication of emitted spectra");
   887	    registerTOPPSubsection_("merge", "Recombine split spectra (union, not selection)");
   888	    registerDoubleOption_("merge:rt_window", "<sec>", 0.0, "FALSIFIED on S30 (every merge/collapse variant lost peptides) -- keep 0 = OFF. [merge] Merge spectra sharing a precursor identity within this RT window into ONE spectrum by UNION of peaks; matching peaks take the MAX intensity by default (merge:sum_intensity sums instead). This is not consolidate: consolidate SELECTS the richest member and DISCARDS the rest (measured -12.7% peptides), while 41% of peaks are present in only one member. Measured MS1 FWHM is 3.61 s (2.61 cycles) and flat across the gradient, so ~3.6 s is one peak width -- the principled window. 0 = off.", false);
   889	    registerDoubleOption_("merge:mass_ppm", "<ppm>", 20.0, "[merge] Precursor m/z tolerance for deciding two spectra share an identity.", false, true);
   890	    registerDoubleOption_("merge:delta_im", "<1/K0>", 0.02, "[merge] Precursor ion-mobility tolerance.", false, true);
   891	    registerDoubleOption_("merge:mz_tol", "<Da>", 0.01, "[merge] Peak m/z tolerance when summing the union. Peaks within this of the running intensity-weighted centroid are combined.", false, true);
   892	    registerDoubleOption_("merge:min_cosine", "<x>", 0.0, "[merge] Require this normalised dot product between two spectra before merging them. Coordinate proximity is NOT the problem (the coordinate gate already admits only 1.8% different-peptide pairs); the problem is that only ~8% of emitted spectra identify at all, so a coordinate gate merges good spectra with unidentifiable ones whose peaks dilute the match. Measured reference: within-cycle pairs 0.845, same peptide across cycles 0.687, unrelated 0.007. 0 = off.", false);
   893	    registerFlag_("merge:sum_intensity", "[merge] Sum intensities of matching peaks instead of taking the MAX. Summing distorts the merged spectrum: members share only ~37% of peaks (Jaccard 0.374), so shared peaks get Nx and unique peaks 1x, wrecking the fragment intensity ratios the engine scores on. MAX takes each ion's best single observation. Off (i.e. MAX) by default.");
   894	    registerFlag_("merge:any_charge", "[merge] Also merge spectra whose precursor charges disagree. Off by default: 93.2% of split pairs already agree in charge, so merging across charges mostly pools genuinely different precursors.");
   895	    registerDoubleOption_("consolidate:delta_rt", "<sec>", 0.0, "FALSIFIED on S30 (-12.7% peptides at 5 s; every merge/collapse variant lost) -- keep 0 = OFF. Consolidate spectra whose precursors agree within this RT window (and mass_ppm/delta_im) into ONE feature, keeping the richest spectrum. Attacks emission multiplicity (ours 4.6 PSMs/peptide vs diaTracer 1.46) without changing fragment content.", false);
   896	    registerDoubleOption_("consolidate:mass_ppm", "<ppm>", 20.0, "Precursor m/z tolerance for feature consolidation.", false, true);
   897	    registerDoubleOption_("consolidate:delta_im", "<1/K0>", 0.02, "Precursor IM tolerance for feature consolidation. Set larger than the 12 m/z x 2 IM sub-range split to merge a feature emitted from BOTH IM sub-ranges.", false, true);
   898	    registerFlag_("consolidate:same_charge_only", "Only merge spectra that also agree in charge (safer; leaves genuine multi-charge observations intact).");
   899	
   900	    registerFlag_("perf:stream_load", "[stream] Read the .d frame-by-frame via BrukerTimsFile::loadDIAStreaming, peak-picking and compacting each frame on arrival, instead of loadExperiment() which holds the entire run (MEASURED 90.3 GB RSS at t=0s - that one-shot read IS the memory floor and no downstream compaction can lower it). Bruker .d only.");
   901	    registerIntOption_("trace:native_ms2_neighbors", "<n>", 0, "[stream] NATIVE cross-frame aggregation in the READER (BrukerTimsFile Config dia_ms2_n_neighbors): adjacent frames each side, 0=off, 1=3-frame sum, 2=5-frame sum. This sums RAW frames BEFORE centroiding, which is what diaTracer does; the tool-level frame_aggregation_n sums AFTER centroiding and lost 26% of peptides. Requires perf:stream_load.", false);
   902	    registerIntOption_("trace:native_ms1_neighbors", "<n>", 0, "[stream] Same, for MS1 frames (BrukerTimsFile Config ms1_n_neighbors). Requires perf:stream_load.", false);
   903	
   904	    registerTOPPSubsection_("perf", "Concurrency / memory tradeoff");
   905	    registerStringOption_("gate:coelution", "<mode>", "pearson", "[B0] Fragment-precursor co-elution statistic. 'pearson' takes variance over the FULL RT grid, so a fragment present in a handful of points is scored against ~1300 implicit zeros -- it rewards sparse fragments that spike where the precursor spikes, and its scale depends on grid size rather than evidence. 'logoverlap' is the AlphaDIA-style alternative: profile overlap in log space, summed only where the precursor has signal, normalised to [0,1]. The two are on DIFFERENT SCALES, so gate:min_correlation must be retuned when switching.", false);
   906	    setValidStrings_("gate:coelution", {"pearson", "logoverlap"});
   907	    registerFlag_("gate:variance_support", "[Q1] Compute the Pearson co-elution variance over the UNION SUPPORT of the precursor and fragment profiles (points where either is non-zero) rather than the full RT grid G (~1300). Fixes the [B0] zero-padding: a fragment present in a handful of grid points is no longer scored against ~1300 implicit zeros, and the score no longer depends on grid size. Only affects gate:coelution=pearson. Retune gate:min_correlation when enabling -- the score scale changes. [bench]");
   908	    registerIntOption_("perf:ms1_trace_bands", "<n>", 12, "[parallel] Band-parallel MS1 mass-trace detection, same exact-partition scheme as perf:trace_bands. MS1 tracing was running SINGLE-THREADED (the call simply never passed a band count) while MS2 was banded, so the MS1 phase pinned one core. That is invisible at default thresholds because MS1 is only ~4% of frames, but it makes the MS1 SENSITIVITY sweep impossible: lowering trace:noise_threshold_int / ms1_chrom_peak_snr explodes MassTraceDetection's intensity-sorted apex list, and MassTraceDetection is a SERIAL greedy loop, so runtime blows up superlinearly on one core (measured: 40 min with no progress at 1.5 of 128 cores, vs 24 min for a whole default run). 1 = off (old behaviour).", false);
   909	    registerIntOption_("perf:trace_bands", "<n>", 12, "[parallel] Split each window's fragment m/z range into N bands traced CONCURRENTLY. The diaPASEF method fixes the window count (24 here), which caps window-level parallelism far below the core count; banding lifts the ceiling to threads. Traces cannot span more than trace:mass_error_ppm in m/z, so banding with a halo is exact. 0 = auto (windows x bands >= threads), 1 = off.", false);
   910	    registerDoubleOption_("perf:mem_fraction", "<f>", 0.75, "[dyn-mem] Fraction of currently-FREE RAM (/proc/meminfo MemAvailable + our own RSS) the window loop may commit. Concurrency is re-decided at every window admission, so the run adapts to other jobs on a shared node. One window is always admitted regardless, so a single oversized window cannot deadlock.", false);
   911	    registerIntOption_("perf:max_concurrent_windows", "<n>", 0, "UPPER bound on isolation windows processed concurrently (memory admission may run fewer). Peak RAM scales with windows IN FLIGHT (each holds its frames + traces + grid), not with the total window count, so lowering this trades wall time for RAM. 0 = unlimited (use all threads).", false);
   912	
   913	    registerTOPPSubsection_("diag", "Diagnostics ('debug' is reserved by TOPP)");
   914	    registerStringOption_("diag:dump_ms1_tsv", "<prefix>", "", "[ms1-funnel] Write MS1 traces and inferred precursors to <prefix>.traces.tsv / <prefix>.precursors.tsv so precursor loss can be attributed to a stage (no trace / no hypothesis / no spectrum) rather than inferred from the final count. Empty = off.", false, true);
   915	
   916	    registerIntOption_("max_charge", "<n>", 5, "Maximum precursor charge considered during isotope inference.", false);
   917	
   918	    // NOTE: the subsection MUST be registered or printUsage_() throws ElementNotFound — which turns
   919	    // any user parameter typo into a FATAL crash instead of a usage message. [bugfix]
   920	    registerTOPPSubsection_("charge", "Isotope / charge-state inference");
   921	    registerIntOption_("charge:min_charge", "<n>", 2, "Minimum precursor charge to emit; hypotheses below it "
   922	                       "are dropped before extraction. Default 2, because tryptic peptides are essentially never singly "
   923	                       "charged in ESI: z=1 hypotheses were ~30%% of emission and ~1.7%% of identified peptides, and removing "
   924	                       "them raised peptide counts on both search engines on all three benchmark files while cutting runtime "
   925	                       "17%%. Use 1 to emit them. 3 or more removes charge 2 and most of the result. Measurements: "
   926	                       "docs/ISOTOPE-DUPLICATION-2026-09-03.md.", false);
   927	    // [route-1] Only 25.7%% of diaTracer's precursors are matched by us with the RIGHT m/z AND charge;
   928	    // 17.2%% have the wrong charge and 22.9%% (decoy-corrected) the wrong monoisotope. A wrong charge or
   929	    // mono gives a wrong NEUTRAL MASS, so the peptide can never be identified no matter how good the
   930	    // fragments are. Partner-COUNTING cannot tell a real envelope from a coincidence; averagine shape
   931	    // x isotope co-elution can.
   932	    registerStringOption_("charge:scoring", "<mode>", "count", "Charge/monoisotope inference. 'count' is the partner-count heuristic (ties favour LOW charge, break-on-first-miss) and is the DEFAULT: measured against a DIA-NN reference on S23 it gives 71.8% charge agreement vs 49.7% for 'envelope', and it eliminates the catastrophic 4->2 confusion (10,199 cases) that fabricates a ~-1198 Da phantom modification at m/z 600 in open search. 'envelope' scores each (charge, mono) hypothesis by averagine cosine x isotope co-elution and allows gapped envelopes; it was the default until 2026-07-21 and is kept for comparison. NOTE both are close to trivial: always answering z=2 scores 69.6%.", false);
   933	    setValidStrings_("charge:scoring", {"envelope", "count"});
   934	    registerDoubleOption_("charge:ambiguity_margin", "<x>", 0.0, "If a different-charge hypothesis scores within this margin of the best, emit it too (diaTracer retains multiple charges when ambiguous). 0 = single charge per precursor. ONLY EFFECTIVE with charge:scoring=envelope -- the default 'count' mode returns before this is consulted, so the value is ignored there.", false);
   935	    registerFlag_("assembly:dedup_precursors", "[route-4] Collapse precursor hypotheses that are the same species (same charge, m/z within ppm, co-eluting RT, co-located IM). Measured redundancy: 4.6 identified spectra per unique peptide vs diaTracer's 1.46.");
   936	    registerFlag_("assembly:require_isotope_support", "[emission] Drop precursor hypotheses with NO isotope partner (the 'guessed' singletons, ~40% of emission) instead of assigning them a default charge. Emission is over-GENERATION of distinct low-quality precursors, not redundancy, so merge/dedup cannot cut it (oracle: same-coordinate collapse only 1.1-1.3x); this gate can. Measured on S30 (2026-07-26): drops 603,858 of 1,528,113 spectra (-39.5%) for 78 of 10,036 peptides (-0.78%) -- guessed spectra identify at 1.30%% vs 11.39%% for supported (8.8x). The 0.78%% are low-abundance/no-envelope species (the open-search caveat), so keep this OFF by default and confirm FDR-recalibrated peptides on any run that enables it.");
   937	    registerDoubleOption_("charge:mono_averagine_guard", "<slack>", 0.0, "[mono-guard] Reject a leftward isotope step (the walk that defines the MONOISOTOPE in charge:scoring=count) when the candidate peak is too weak to be a real lighter isotope under averagine. The partner search matches m/z, RT and IM but NEVER intensity, so it can latch onto a noise peak or a co-eluting species one isotope spacing below the true monoisotope -- making the reported precursor mass ~1.00335 Da TOO LIGHT. Closed search hides this (the engine enumerates isotope_errors and corrects it for free); OPEN/blind search turns it into a phantom -1.003 Da modification, and it is our single largest open-search delta-mass artefact on S30 (8.20%% isotope-shifted PSMs vs diaTracer's 3.46%%). The bound is averagine's LOOSEST: stepping from isotope m+1 to m the lighter peak is >= (m+1)/lambda times the heavier one, minimised at m=0 -> 1/lambda (lambda = 0.000594*neutral mass), so a value of 1.0 enforces exactly that minimum and never rejects a legitimate envelope; smaller values add slack for noise. 0 = off (old behaviour). [bench]", false);
   938	    registerFlag_("charge:mono_averagine_select", "[mono-select] Choose the MONOISOTOPE by averagine envelope fit over the whole isotope run found by the charge:scoring=count walk, instead of taking the furthest-left peak reached. 'Furthest-left' is a STOPPING rule and can only trade over-reach (mono ~1.003 Da too LIGHT, a phantom -1 Da modification in open search) for under-reach (+1.003 Da) -- measured: an averagine STOPPING guard cut the -1 artefact 64%% but tripled +1, because a walk that halts early also leaves the M+1 peak unconsumed so it seeds its own too-heavy precursor. This is a SCORING decision instead: score every candidate mono position in the run by cosine against the averagine envelope and keep the best. Every found peak is still consumed, so de-isotoping and emission are unchanged -- only the reported precursor mass moves. [bench]");
   939	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). A reviewer argued 0.01 (isotopes of one species share mobility, so 0.05 can admit cross-species partners), but 0.01 has NOT been measured on S30; change only behind the S30 set gate.", false);
   940	
   941	    // Bounds, not documentation: without these a negative count wraps through `Size` (min_fragments
   942	    // -1 becomes ~1.8e19 and nothing is ever emitted) and a negative tolerance silently gates
   943	    // everything out. Both fail as an empty-but-valid result, the worst failure mode here.
   944	    // [adv-review codex/kimi 2026-09-03]
   945	    setMinInt_("assembly:min_fragments", 1);
   946	    setMinInt_("assembly:max_fragments", 1);
   947	    setMinInt_("assembly:default_charge", 0);
   948	    setMinInt_("max_charge", 1);
   949	    setMinInt_("perf:trace_bands", 0);      // 0 = auto (documented)
   950	    setMinFloat_("gate:delta_im", 0.0);
   951	    setMinFloat_("gate:delta_rt", 0.0);
   952	    setMinFloat_("gate:min_correlation", -1.0);
   953	    setMaxFloat_("gate:min_correlation", 1.0);
   954	    setMinFloat_("charge:iso_im_tolerance", 0.0);
   955	    setMinFloat_("trace:ms1_chrom_peak_snr", 0.0);
   956	    setMinFloat_("trace:ms2_chrom_peak_snr", 0.0);
   957	    setMinFloat_("trace:ms2_noise_threshold_int", 0.0);
   958	    setMinFloat_("trace:noise_threshold_int", 0.0);
   959	    setMinInt_("perf:ms1_trace_bands", 0);      // 0 = auto (documented)
   960	    setMinFloat_("perf:mem_fraction", 0.05);
   961	    setMaxFloat_("perf:mem_fraction", 0.95);
   962	    // deliberate: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
   963	  }
   964	
   965	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
   966	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
   967	  ///   peak_int > chrom_peak_snr * noise_threshold_int
   968	  /// so the EFFECTIVE apex threshold is snr*noise, while trace MEMBERSHIP only needs > noise.
   969	  /// Leaving snr at the OpenMS default 3.0 silently triples the fragment apex threshold.
   970	  /// diaTracer deliberately runs MS2 with "more relaxed constraints" than MS1 (Nat Commun 16:95
   971	  /// Methods) — so MS1 and MS2 get INDEPENDENT snr / min-length here. [recall]
   972	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
   973	  /// it is dead from that point on, but at ~20 B/peak (Peak1D 16 + IM float 4) it is ~1.1 GB per
   974	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
   975	  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
   976	                              double snr, double min_len, double min_sample_rate, double max_len,
   977	                              double split_valleys, String* span_log = nullptr, int bands = 1)
   978	  {
   979	    MassTraceDetection mtd;
   980	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
   981	    Param p = mtd.getParameters();
   982	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
   983	    p.setValue("noise_threshold_int", noise);
   984	    p.setValue("chrom_peak_snr", snr);
   985	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
   986	    p.setValue("min_trace_length", min_len);
   987	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
   988	    // trace extension when occupancy drops below it — an intensity-INDEPENDENT deletion of gappy but
   989	    // real fragment traces in sparse diaPASEF data. Relaxing it for MS2 is the sole surviving MS2
   990	    // trace-validity lever. [recall]
   991	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
   992	    if (max_len > 0.0) p.setValue("max_trace_length", max_len);
   993	    mtd.setParameters(p);
   994	
   995	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
   996	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
   997	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
   998	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
   999	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
  1000	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
  1001	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
  1002	      ElutionPeakDetection epd;
  1003	      epd.setLogType(ProgressLogger::NONE);
  1004	      Param ep = epd.getParameters();
  1005	      ep.setValue("chrom_fwhm", split_valleys);
  1006	      ep.setValue("width_filtering", "off");
  1007	      ep.setValue("masstrace_snr_filtering", "false");
  1008	      epd.setParameters(ep);
  1009	      vector<MassTrace> out; out.reserve(in.size());
  1010	      epd.detectPeaks(in, out);
  1011	      return out;
  1012	    };
  1013	
  1014	    vector<MassTrace> mts;
  1015	    if (bands > 1)
  1016	    {
  1017	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
  1018	      // windows caps us at 24 threads however many cores exist. Fragment traces at
  1019	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
  1020	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
  1021	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
  1022	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
  1023	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
  1024	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
  1025	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
  1026	      vector<double> sample;
  1027	      for (const auto& s : map)
  1028	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
  1029	      sort(sample.begin(), sample.end());
  1030	      vector<double> edge(bands + 1);
  1031	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
  1032	      else
  1033	        for (int b = 0; b <= bands; ++b)
  1034	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
  1035	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
  1036	      vector<double> ().swap(sample);
  1037	
  1038	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
  1039	      // then release the source map so the halo duplicates are the only overhead.
  1040	      vector<PeakMap> sub(bands);
  1041	      for (auto& s : map)          // non-const: each spectrum is released once distributed
  1042	      {
  1043	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
  1044	        for (int b = 0; b < bands; ++b)
  1045	        {
  1046	          // Size each halo from ITS OWN edge: one h derived from edge[b] under-sizes the upper
  1047	          // side by the ppm growth across the band. [adv-review 2026-09-03]
  1048	          const double lo = edge[b] - edge[b] * ppm * 1e-6 * 20.0;
  1049	          const double hi = edge[b + 1] + edge[b + 1] * ppm * 1e-6 * 20.0;
  1050	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
  1051	          OpenMS::DataArrays::FloatDataArray ia;
  1052	          ia.setName(Constants::UserParam::ION_MOBILITY);
  1053	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
  1054	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
  1055	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
  1056	          Size i0 = 0, i1 = s.size();
  1057	          if (s.isSorted())
  1058	          {
  1059	            i0 = (Size)(s.MZBegin(lo) - s.begin());
  1060	            i1 = (Size)(s.MZBegin(hi) - s.begin());
  1061	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
  1062	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1063	          }
  1064	          else
  1065	            for (Size i = 0; i < s.size(); ++i)
  1066	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
  1067	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1068	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); sub[b].addSpectrum(std::move(t)); }
  1069	        }
  1070	        s.clear(true);   // distributed: release it now, so the source and the copies do not both
  1071	      }                  // stand at full size (the transient was ~2x the map)
  1072	      map.clear(true);
  1073	      vector<vector<MassTrace>> per(bands);
  1074	      #pragma omp taskloop grainsize(1) default(shared)
  1075	      for (int b = 0; b < bands; ++b)
  1076	      {
  1077	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
  1078	        vector<MassTrace> t;
  1079	        sub[b].sortSpectra();
  1080	        if (sub[b].size() < 3) { sub[b].clear(true); continue; }   // MTD aborts below 3 spectra
  1081	        m2.run(sub[b], t);
  1082	        sub[b].clear(true);
  1083	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
  1084	        for (auto& mt : t)
  1085	        {
  1086	          const double c = mt.getCentroidMZ();
  1087	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
  1088	        }
  1089	      }
  1090	      size_t tot = 0; for (const auto& v : per) tot += v.size();
  1091	      mts.reserve(tot);
  1092	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
  1093	    }
  1094	    else
  1095	    {
  1096	      if (map.size() >= 3) mtd.run(map, mts);   // MTD aborts below 3 spectra; a tiny input is not an error
  1097	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
  1098	    }
  1099	
  1100	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
  1101	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1102	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1103	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1104	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1105	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1106	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1107	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off S30 20:46 vs 28:40 for
  1108	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1109	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1110	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1111	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1112	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1113	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1114	    // determinism bug, now fixed.
  1115	    if (split_valleys > 0.0 && mts.size() > 1)
  1116	    {
  1117	      const int nthreads = std::max(1, bands);
  1118	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1119	      const size_t n_in = mts.size();
  1120	      vector<vector<MassTrace>> parts(nchunk);
  1121	      #pragma omp taskloop grainsize(1) default(shared)
  1122	      for (int ci = 0; ci < nchunk; ++ci)
  1123	      {
  1124	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1125	        if (lo >= hi) continue;
  1126	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1127	                                std::make_move_iterator(mts.begin() + hi));
  1128	        parts[ci] = do_split(chunk);
  1129	      }
  1130	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1131	      vector<MassTrace> out; out.reserve(tot);
  1132	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1133	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1134	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1135	      mts.swap(out);
  1136	    }
  1137	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1138	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1139	    if (!mts.empty())
  1140	    {
  1141	      vector<double> spans;
  1142	      spans.reserve(mts.size());
  1143	      for (const auto& mt : mts)
  1144	      {
  1145	        double lo = 1e30, hi = -1e30;
  1146	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1147	        spans.push_back(hi - lo);
  1148	      }
  1149	      sort(spans.begin(), spans.end());
  1150	      size_t n = spans.size();
  1151	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1152	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1153	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1154	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1155	    }
  1156	    vector<Trace> out;
  1157	    out.reserve(mts.size());
  1158	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1159	    return out;
  1160	  }
  1161	
  1162	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1163	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1164	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1165	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1166	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1167	  {
  1168	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1169	    out.assign(n, 0.0);
  1170	    double term = 1.0;
  1171	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1172	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1173	    if (mx > 0) for (double& v : out) v /= mx;
  1174	  }
  1175	
  1176	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1177	  {
  1178	    double dot = 0, na = 0, nb = 0;
  1179	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1180	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1181	  }
  1182	
  1183	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1184	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1185	  /// coincidental peak at the right m/z spacing usually does not.
  1186	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1187	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1188	  static double xicCorr(const Trace& a, const Trace& b, double /*rt_tol*/)
  1189	  {
  1190	    size_t i = 0, j = 0; double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1191	    while (i < a.np() && j < b.np())
  1192	    {
  1193	      if (a.xi[i] == b.xi[j])
  1194	      { const double x = a.intAt(i), y = b.intAt(j);
  1195	        sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; ++i; ++j; }
  1196	      else if (a.xi[i] < b.xi[j]) ++i; else ++j;
  1197	    }
  1198	    if (m < 3) return -2.0;
  1199	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1200	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1201	  }
  1202	
  1203	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1204	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1205	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, int max_charge,
  1206	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1207	                                      bool envelope_scoring, double ambig_margin)
  1208	  {
  1209	    const double ISO = 1.0033548;
  1210	    const double PROTON_ = 1.00727646;
  1211	    const size_t N = ms1.size();
  1212	
  1213	    // m/z-sorted index for O(log N) isotope-partner lookup (avoids O(N^2) over all MS1 traces). [H-8]
  1214	    vector<size_t> by_mz(N);
  1215	    for (size_t i = 0; i < N; ++i) by_mz[i] = i;
  1216	    sort(by_mz.begin(), by_mz.end(), [&](size_t a, size_t b) { return ms1[a].mz < ms1[b].mz; });
  1217	    vector<double> sorted_mz(N);
  1218	    for (size_t i = 0; i < N; ++i) sorted_mz[i] = ms1[by_mz[i]].mz;
  1219	
  1220	    vector<size_t> order(N);
  1221	    for (size_t i = 0; i < N; ++i) order[i] = i;
  1222	    sort(order.begin(), order.end(), [&](size_t a, size_t b) {
  1223	      if (ms1[a].intensity != ms1[b].intensity) return ms1[a].intensity > ms1[b].intensity;
  1224	      if (ms1[a].mz != ms1[b].mz) return ms1[a].mz < ms1[b].mz;
  1225	      return a < b; // total order so greedy isotope assignment is deterministic [code-review]
  1226	    });
  1227	
  1228	    vector<bool> used(N, false);
  1229	    vector<Precursor_> out;
  1230	    for (size_t seed : order)
  1231	    {
  1232	      if (used[seed]) continue;
  1233	      const Trace& s = ms1[seed];
  1234	      const double tol = s.mz * mass_ppm * 1e-6;
  1235	
  1236	      // Find an unused isotope partner near `target` m/z, co-localized in RT and IM (binary-search
  1237	      // the m/z index, scan only the ppm-window candidates); -1 if none. [H-8]
  1238	      auto findPartner = [&](double target) -> long {
  1239	        size_t klo = lower_bound(sorted_mz.begin(), sorted_mz.end(), target - tol) - sorted_mz.begin();
  1240	        size_t khi = upper_bound(sorted_mz.begin(), sorted_mz.end(), target + tol) - sorted_mz.begin();
  1241	        for (size_t k = klo; k < khi; ++k)
  1242	        {
  1243	          size_t j = by_mz[k];
  1244	          if (used[j] || j == seed) continue;
  1245	          if (fabs(ms1[j].rt - s.rt) <= delta_rt && fabs(ms1[j].im - s.im) <= iso_im_tol)
  1246	            return (long)j;
  1247	        }
  1248	        return -1;
  1249	      };
  1250	
  1251	      // [baseline-fix v2] When envelope scoring is OFF, run the ORIGINAL algorithm end-to-end, not
  1252	      // just the original scoring. The previous attempt reverted only the score while keeping the new
  1253	      // candidate generation (gapped walk + lead 0..3), producing a THIRD algorithm: 2.52M MS1 traces
  1254	      // -> 1.21M precursors, 967,956 spectra, 7,308 peptides (baseline: 1.76M -> 956k, 741k, 9,103).
  1255	      // The original is: contiguous walk with BREAK-ON-FIRST-MISS, seed is always the starting point
  1256	      // (no lead offsets), monoisotope = furthest-LEFT partner reached, pick z by partner COUNT with
  1257	      // ties favouring the LOWEST z.
  1258	      if (!envelope_scoring)
  1259	      {
  1260	        int best_z = 0, best_n = 1;
  1261	        double best_mono = s.mz;
  1262	        vector<size_t> best_partners;
  1263	        for (int z = 1; z <= max_charge; ++z)
  1264	        {
  1265	          vector<size_t> partners;
  1266	          double mono = s.mz;
  1267	          double prev_int = s.intensity;
  1268	          vector<long> lefts;
  1269	          for (int k = 1; k <= 5; ++k)          // lighter partners define the monoisotope
  1270	          {
  1271	            long j = findPartner(s.mz - k * ISO / z);
  1272	            if (j < 0) break;                   // BREAK on first miss (contiguous only)
  1273	            // [mono-guard] A LEFTWARD step asserts the new peak is a LIGHTER ISOTOPE of the same
  1274	            // peptide, but findPartner only checks m/z, RT and IM -- never intensity. So the walk
  1275	            // happily latches onto a noise peak or a co-eluting species' peak that happens to sit
  1276	            // one isotope spacing below, and the monoisotope ends up one isotope TOO LIGHT.
  1277	            // Closed search hides this (the engine enumerates isotope_errors [-1,2] and corrects it
  1278	            // for free); OPEN search cannot, so it becomes a phantom -1.003 Da "modification" --
  1279	            // measured as our single largest open-search delta-mass artefact on S30.
  1280	            // Averagine bounds how weak a genuine lighter isotope may be: stepping from isotope m+1
  1281	            // to m, theo[m]/theo[m+1] = (m+1)/lambda, minimised at m=0 -> 1/lambda. Requiring the
  1282	            // candidate to reach that (times a slack factor) rejects the latch without touching a
  1283	            // real envelope.
  1284	            if (mono_guard_ > 0.0)
  1285	            {
  1286	              const double neutral = (s.mz - k * ISO / z) * z - z * PROTON_;
  1287	              const double lam = std::max(0.10, 0.000594 * neutral);
  1288	              if (ms1[j].intensity < mono_guard_ * prev_int / lam) break;
  1289	            }
  1290	            lefts.push_back(j);
  1291	            partners.push_back((size_t)j); mono = ms1[j].mz; prev_int = ms1[j].intensity;
  1292	          }
  1293	          vector<long> rights;
  1294	          for (int k = 1; k <= 5; ++k)          // heavier partners add confidence
  1295	          {
  1296	            long j = findPartner(s.mz + k * ISO / z);
  1297	            if (j < 0) break;
  1298	            rights.push_back(j);
  1299	            partners.push_back((size_t)j);
  1300	          }
  1301	          // [mono-select] Choosing the monoisotope by "furthest-left peak reached" is a STOPPING
  1302	          // rule, and a stopping rule can only trade over-reach (-1.003 Da) for under-reach (+1.003
  1303	          // Da) -- measured: the guard above cut the -1 artefact 64% but tripled +1, because a walk
  1304	          // that stops early also leaves the M+1 peak unconsumed, so it later seeds its OWN
  1305	          // precursor one isotope too heavy. Make it a SCORING decision instead: walk the full run,
  1306	          // then pick which peak IS the monoisotope by averagine fit of the envelope starting
  1307	          // there. Corrects both directions, and every found peak is still marked used below, so
  1308	          // de-isotoping and emission are untouched (only the reported mono m/z changes).
  1309	          if (mono_select_ && !lefts.empty())
  1310	          {
  1311	            const int nL = (int)lefts.size();
  1312	            vector<double> runI;                                  // ascending m/z: lefts, seed, rights
