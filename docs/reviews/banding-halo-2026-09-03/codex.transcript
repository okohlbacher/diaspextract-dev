  1512	
  1513	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  1514	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  1515	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  1516	  template <class Emit>
  1517	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  1518	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  1519	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
  1520	                        int min_corr_pts, vector<float>& pdense, Emit&& emit) const
  1521	  {
  1522	    const double G = (double)fg.rt.size();
  1523	    const Trace& p_tr = ms1_traces[pc.trace_idx];
  1524	    // [wavelet] Correlate against a SMOOTHED precursor profile, as diaTracer does. Only the
  1525	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  1526	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  1527	    // (diaTracer smooths only the precursor side), and emitted peak intensities are unaffected
  1528	    // because they come from the fragment traces, not from here.
  1529	    const vector<double>* p_int = nullptr;
  1530	    if (wl_scale_ > 0.0)
  1531	    {
  1532	      const int lv = atrousLevels(p_tr, wl_scale_);
  1533	      if (lv > 0)
  1534	      {
  1535	        thread_local vector<double> raw_i, sm_i;   // window loop is parallel; scratch is per-thread
  1536	        raw_i.resize(p_tr.np());
  1537	        for (size_t i = 0; i < p_tr.np(); ++i) raw_i[i] = p_tr.intAt(i);
  1538	        atrousSmooth(raw_i, lv, sm_i);
  1539	        p_int = &sm_i;
  1540	      }
  1541	    }
  1542	    vector<int> touched;
  1543	    touched.reserve(p_tr.np());
  1544	    for (size_t pi = 0; pi < p_tr.np(); ++pi)
  1545	    {
  1546	      const double pval = p_int ? (*p_int)[pi] : p_tr.intAt(pi);
  1547	      const int gi = fg.nearest_slot[p_tr.xi[pi]];        // one array read, precomputed per window
  1548	      if (gi >= 0) { if (pdense[gi] == 0.0f) touched.push_back(gi); pdense[gi] += (float)pval; }
  1549	    }
  1550	    double psum = 0, psumsq = 0, plogsum = 0;
  1551	    // plogsum normalises the precursor profile for gate:coelution=logoverlap. Constant across
  1552	    // every fragment of this precursor, so hoist it out of the inner loop.
  1553	    for (int gi : touched)
  1554	    {
  1555	      double v = pdense[gi];
  1556	      psum += v; psumsq += v * v;
  1557	      if (log_overlap_) plogsum += std::log1p(v);
  1558	    }
  1559	    double pmean = psum / G, pvar = psumsq - G * pmean * pmean;
  1560	    double pinv = pvar > 0 ? 1.0 / sqrt(pvar) : 0.0;
  1561	    if (pinv > 0.0)
  1562	    {
  1563	      size_t lo = lower_bound(frag_im.begin(), frag_im.end(), pc.im - delta_im) - frag_im.begin();
  1564	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  1565	      long long n_rtpass = 0;
  1566	      stat_slice_ += (long long)(hi - lo); ++stat_prec_;
  1567	      for (size_t fi = lo; fi < hi; ++fi)
  1568	      {
  1569	        const Trace& f = frag_traces[fi];
  1570	        if (fabs(f.rt - pc.rt) > delta_rt) continue;                   // RT gate
  1571	        ++n_rtpass;
  1572	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  1573	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  1574	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  1575	        // "fragments" (unfragmented survivors). SPEXTRACT_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  1576	        if (drop_prec_iso_ && pc.charge > 0)
  1577	        {
  1578	          bool iso = false;
  1579	          for (int k = 1; k <= 3 && !iso; ++k) iso = fabs(f.mz - (pc.mono_mz + k * 1.00335 / pc.charge)) < 0.01;
  1580	          if (iso) continue;
  1581	        }
  1582	        double dot = 0; int overlap = 0;
  1583	        // [R2-late, 2026-09-02] overlap <= support, so a fragment with fewer support points than
  1584	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  1585	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  1586	        if (fg.supEnd(fi) - fg.supBegin(fi) < (size_t)std::max(min_corr_pts, 0)) continue;
  1587	        for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1588	        { const auto& gv = fg.flat[k]; float pv = pdense[gv.first]; if (pv != 0.0f) { dot += (double)pv * gv.second; ++overlap; } }
  1589	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  1590	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  1591	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  1592	        // defect the adversarial review flagged. It rewards sparse fragments that happen to spike
  1593	        // where the precursor spikes, and its scale depends on G rather than on the evidence.
  1594	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  1595	        // independence, where one missing point does not zero the score (unlike a product) and
  1596	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  1597	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  1598	        // [0,1]. No zero padding, no dependence on G.
  1599	        double c;
  1600	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  1601	        {
  1602	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  1603	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  1604	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  1605	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  1606	          double fsum = 0.0, fsumsq = 0.0;
  1607	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1608	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  1609	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  1610	          double pm = psum / n, fm = fsum / n;
  1611	          double pv2 = psumsq - n * pm * pm, fv2 = fsumsq - n * fm * fm;
  1612	          if (pv2 <= 0.0 || fv2 <= 0.0) continue;                      // degenerate on union support
  1613	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  1614	        }
  1615	        else if (log_overlap_)
  1616	        {
  1617	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  1618	          // the intersection by the precursor's total log-intensity alone, which made the score
  1619	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  1620	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  1621	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  1622	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  1623	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  1624	          // which is what Pearson gets right and the first version did not.
  1625	          double fsum = 0.0;
  1626	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1627	            fsum += std::log1p((double)fg.flat[k].second);
  1628	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  1629	          double inter = 0.0;
  1630	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1631	          {
  1632	            const auto& gv = fg.flat[k];
  1633	            inter += std::min(std::log1p((double)gv.second) / fsum,
  1634	                              std::log1p((double)pdense[gv.first]) / plogsum);
  1635	          }
  1636	          c = inter;
  1637	        }
  1638	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  1639	        if (c < min_corr) continue;                                    // correlation gate
  1640	        emit(fi, c);
  1641	      }
  1642	      stat_rtpass_ += n_rtpass;
  1643	    }
  1644	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  1645	  }
  1646	
  1647	  /// [wavelet] Assertions on the SHIPPED a-trous smoother. Each check corresponds to a way the
  1648	  /// transform could be wrong while still "looking smoothed" in a plot.
  1649	  ExitCodes selftestWavelet_()
  1650	  {
  1651	    int fail = 0;
  1652	    auto chk = [&](bool ok, const char* what) {
  1653	      if (!ok) { writeLogError_(String("FAIL: ") + what); ++fail; }
  1654	      else writeLogInfo_(String("  ok  ") + what);
  1655	    };
  1656	
  1657	    // 1. DC preservation. The B3 taps must sum to exactly 1: if they do not, smoothing RESCALES
  1658	    //    the precursor profile, and since Pearson is scale-invariant the error would be silent
  1659	    //    here but corrupt gate:coelution=logoverlap, which is NOT scale-invariant.
  1660	    {
  1661	      vector<double> flat(64, 7.5), out;
  1662	      atrousSmooth(flat, 4, out);
  1663	      double worst = 0.0;
  1664	      for (double v : out) worst = std::max(worst, fabs(v - 7.5));
  1665	      chk(worst < 1e-9, "DC preserved (constant signal unchanged)");
  1666	    }
  1667	
  1668	    // 2. Noise reduction, and 3. peak retention -- the two must hold TOGETHER, else "smoothing"
  1669	    //    is either a no-op or a peak destroyer. Deterministic pseudo-noise (no RNG dependence).
  1670	    {
  1671	      const int n = 128;
  1672	      vector<double> sig(n), noisy(n), out;
  1673	      for (int i = 0; i < n; ++i)
  1674	      {
  1675	        const double x = (i - 64.0) / 8.0;               // Gaussian peak, sigma = 8 samples
  1676	        sig[i] = 1000.0 * std::exp(-0.5 * x * x);
  1677	        noisy[i] = sig[i] + 60.0 * std::sin(i * 2.7) * std::cos(i * 1.31);   // high-frequency
  1678	      }
  1679	      atrousSmooth(noisy, 2, out);
  1680	      double e_in = 0, e_out = 0;
  1681	      for (int i = 0; i < n; ++i) { e_in += fabs(noisy[i] - sig[i]); e_out += fabs(out[i] - sig[i]); }
  1682	      chk(e_out < 0.75 * e_in, "noise reduced (residual vs clean peak shrinks >25%)");
  1683	      chk(out[64] > 0.80 * sig[64], "peak height retained (>80% at apex)");
  1684	    }
  1685	
  1686	    // 4. Mirror edges. Zero-padding would fabricate a downslope at a truncated peak -- the same
  1687	    //    bias the FWHM estimator avoids by excluding truncated traces.
  1688	    {
  1689	      vector<double> edge(32, 0.0), out;
  1690	      for (int i = 0; i < 32; ++i) edge[i] = 1000.0 - 25.0 * i;    // apex sits AT sample 0
  1691	      atrousSmooth(edge, 2, out);
  1692	      chk(out[0] > 0.85 * edge[0], "mirror boundary (edge apex not pulled toward zero)");
  1693	    }
  1694	
  1695	    // 5. Level selection follows the SAMPLING, not a constant. Two traces of the same physical
  1696	    //    width but different cycle times must get different level counts.
  1697	    {
  1698	      // Profiles index the global axis, so the test builds an axis with the two spacings on it.
  1699	      vector<double>& ax = rtAxis();
  1700	      const vector<double> saved = ax;
  1701	      ax.clear();
  1702	      for (int i = 0; i < 40; ++i) ax.push_back(i * 0.5);      // dt = 0.5 s -> indices 0..39
  1703	      for (int i = 0; i < 40; ++i) ax.push_back(1000.0 + i * 2.0);   // dt = 2.0 s -> indices 40..79
  1704	      Trace fast, slow, tiny;
  1705	      for (int i = 0; i < 40; ++i) { fast.xi.push_back((uint32_t)i); fast.xv.push_back(100.0f); }
  1706	      for (int i = 0; i < 40; ++i) { slow.xi.push_back((uint32_t)(40 + i)); slow.xv.push_back(100.0f); }
  1707	      for (int i = 0; i < 3; ++i)  { tiny.xi.push_back((uint32_t)i); tiny.xv.push_back(1.0f); }
  1708	      const int lf = atrousLevels(fast, 4.0), ls = atrousLevels(slow, 4.0);
  1709	      chk(lf > ls, "levels scale with sampling (finer dt -> more levels)");
  1710	      chk(atrousLevels(fast, 0.0) == 0, "scale 0 disables smoothing");
  1711	      chk(atrousLevels(tiny, 4.0) == 0, "too-short XIC -> 0 levels");
  1712	      ax = saved;
  1713	    }
  1714	
  1715	    writeLogInfo_(fail ? "[wavelet] SELFTEST FAILED" : "[wavelet] selftest passed");
  1716	    return fail ? UNEXPECTED_RESULT : EXECUTION_OK;
  1717	  }
  1718	
  1719	  /// Build a pseudo-MS2 from a fragment list (m/z,intensity) + ranking scores: keeps top
  1720	  /// max_frags by score, drops if < min_frags, annotates the synthetic precursor. Deterministic.
  1721	  void assembleFromList_(const Precursor_& pc, double win_lo, double win_hi,
  1722	                         vector<pair<double, double>>& frags, vector<double>& frag_scores,
  1723	                         Size min_frags, Size max_frags, MSSpectrum& out) const
  1724	  {
  1725	    if (frags.size() < min_frags) return;
  1726	    if (frags.size() > max_frags)
  1727	    {
  1728	      vector<size_t> idx(frags.size());
  1729	      for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  1730	      // [rank] Rank by correlation (ours) or by intensity (diaTracer's "top N highest intensity").
  1731	      // The engine re-ranks by INTENSITY downstream (Sage max_peaks=150), so a correlation-ranked
  1732	      // cap can discard high-intensity peaks the engine would have scored. Ties break on m/z then
  1733	      // index in BOTH modes so the output stays deterministic.
  1734	      const bool by_int = rank_by_intensity_;
  1735	      partial_sort(idx.begin(), idx.begin() + max_frags, idx.end(), [&](size_t a, size_t b) {
  1736	        const double ka = by_int ? frags[a].second : frag_scores[a];
  1737	        const double kb = by_int ? frags[b].second : frag_scores[b];
  1738	        if (ka != kb) return ka > kb;
  1739	        if (frags[a].first != frags[b].first) return frags[a].first < frags[b].first;
  1740	        return a < b;
  1741	      });
  1742	      vector<pair<double, double>> keep; keep.reserve(max_frags);
  1743	      for (size_t i = 0; i < max_frags; ++i) keep.push_back(frags[idx[i]]);
  1744	      frags.swap(keep);
  1745	    }
  1746	    out.setMSLevel(2);
  1747	    out.setType(SpectrumSettings::SpectrumType::CENTROID);
  1748	    out.setRT(pc.rt);
  1749	    for (const auto& fr : frags) out.emplace_back(fr.first, fr.second);
  1750	    out.sortByPosition();
  1751	    OpenMS::Precursor prec;
  1752	    prec.setMZ(pc.mono_mz);
  1753	    if (pc.charge > 0) prec.setCharge(pc.charge);
  1754	    prec.setIsolationWindowLowerOffset(max(0.0, pc.mono_mz - win_lo));   // [C-5]
  1755	    prec.setIsolationWindowUpperOffset(max(0.0, win_hi - pc.mono_mz));
  1756	    prec.setDriftTime(pc.im);
  1757	    prec.setDriftTimeUnit(DriftTimeUnit::VSSC);
  1758	    out.setPrecursors({prec});
  1759	    // [provenance] Stamp the inference class onto the emitted spectrum so identified peptides can be
  1760	    // joined back to guessed (no isotope support) vs isotope-supported precursors -- the number that
  1761	    // sets the peptide cost of an isotope-support gate. Written as a <userParam> in the mzML.
  1762	    out.setMetaValue("spx_guessed", (int)(pc.guessed ? 1 : 0));
  1763	    // [Q4] Isotope-offset hypothesis for open/blind search: the number of isotope peaks behind the
  1764	    // mono call. 0/1 => the mono is weakly determined and could be off by +-k*1.00335 Da, so a
  1765	    // downstream delta-mass corrector should treat a near-integer-Da delta as an isotope miscall to
  1766	    // reassign rather than a real modification. This is the metadata assembly:open_search_safe's doc
  1767	    // promised but never wrote (only spx_guessed was stamped). Harmless in closed search (ignored).
  1768	    out.setMetaValue("spx_n_isotopes", pc.n_isotopes);
  1769	  }
  1770	
  1771	  /// [E5, 2026-09-02] The ONE place the emitted-intensity weights live. Returns {cap-key intensity,
  1772	  /// emitted intensity}: the IM-proximity weight feeds both (IM-on-c, orthogonal to correlation); the
  1773	  /// [Q2] correlation-power weight feeds ONLY the emitted (engine-visible) intensity -- putting it in the
  1774	  /// cap key made frag_scores = base*c^(k+1) and double-hit borderline-c faint fragments at the 500-cap.
  1775	  /// Until today apportion and rp_max emitted RAW intensities, so every A/B of those flags silently
  1776	  /// compared corr_power=2 against corr_power=0.
  1777	  pair<double, double> weighted_(double base, double c, double dim) const
  1778	  {
  1779	    double inten = base;
  1780	    if (im_weight_sigma_ > 0.0) inten *= std::exp(-(dim * dim) / (2.0 * im_weight_sigma_ * im_weight_sigma_));
  1781	    double emit_inten = inten;
  1782	    if (corr_power_ > 0.0 && c > 0.0) emit_inten *= std::pow(c, corr_power_);
  1783	    return {inten, emit_inten};
  1784	  }
  1785	
  1786	  /// Per-precursor assembly: this precursor claims every fragment passing its gate (a fragment may
  1787	  /// be shared across precursors -> chimeric). Leaves @p out empty on failure.
  1788	  void assembleOne_(const Precursor_& pc, double win_lo, double win_hi,
  1789	                    const vector<Trace>& frag_traces, const vector<double>& frag_im,
  1790	                    const vector<Trace>& ms1_traces, const FragGrid& fg,
  1791	                    double delta_im, double delta_rt, double min_corr, int min_corr_pts,
  1792	                    Size min_frags, Size max_frags, vector<float>& pdense, MSSpectrum& out) const
  1793	  {
  1794	    vector<pair<double, double>> frags;
  1795	    vector<double> frag_scores;
  1796	    scoreCandidates_(pc, frag_traces, frag_im, ms1_traces, fg, delta_im, delta_rt, min_corr,
  1797	                     min_corr_pts, pdense, [&](size_t fi, double c) {
  1798	      const auto [inten, emit_inten] = weighted_(frag_traces[fi].intensity, c, frag_im[fi] - pc.im);
  1799	      frags.emplace_back(frag_traces[fi].mz, emit_inten);
  1800	      frag_scores.push_back(c * inten);
  1801	    });
  1802	    assembleFromList_(pc, win_lo, win_hi, frags, frag_scores, min_frags, max_frags, out);
  1803	  }
  1804	
  1805	  ExitCodes main_(int, const char**) override
  1806	  {
  1807	    phase_clock_();   // [perf-instr] fix the epoch HERE: it is a first-call static, and the
  1808	                      // streaming path first touched it only AFTER loading, so load time was
  1809	                      // invisible and every [t=..] was relative to post-load. [codex review]
  1810	    const String in = getStringOption_("in");
  1811	    const String out = getStringOption_("out");
  1812	    const double delta_im = getDoubleOption_("gate:delta_im");
  1813	    const double delta_rt = getDoubleOption_("gate:delta_rt");
  1814	    if (getFlag_("diag:selftest_wavelet")) return selftestWavelet_();
  1815	    log_overlap_ = (getStringOption_("gate:coelution") == "logoverlap");
  1816	    rank_by_intensity_ = (getStringOption_("assembly:rank_by") == "intensity");
  1817	    im_weight_sigma_ = getDoubleOption_("assembly:im_weight_sigma");
  1818	    mono_guard_ = getDoubleOption_("charge:mono_averagine_guard");
  1819	    mono_select_ = getFlag_("charge:mono_averagine_select");
  1820	    var_support_ = getFlag_("gate:variance_support");
  1821	    corr_power_ = getDoubleOption_("assembly:corr_power");
  1822	    const double min_corr = getDoubleOption_("gate:min_correlation");
  1823	    const int min_corr_pts = getIntOption_("gate:min_correlation_points");
  1824	    const Size min_frags = (Size)getIntOption_("assembly:min_fragments");
  1825	    const Size max_frags = (Size)getIntOption_("assembly:max_fragments");
  1826	    const int max_charge = getIntOption_("max_charge");
  1827	    mzEstimator() = getStringOption_("trace:mz_estimator");   // before any toTrace() call
  1828	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  1829	
  1830	    PeakMap exp;
  1831	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  1832	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  1833	    PeakMap ms1_map;
  1834	    map<pair<int, int>, vector<CompactFrame>> ms2_by_window;
  1835	    CompactStats cstat;
  1836	    auto winKey = [](double lo, double hi) {
  1837	      return make_pair((int)llround(lo * 100.0), (int)llround(hi * 100.0));
  1838	    };
  1839	    const bool stream_load = getFlag_("perf:stream_load");
  1840	    bool streamed = false;
  1841	
  1842	    if (stream_load)
  1843	    {
  1844	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  1845	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  1846	      BrukerTimsFile::Config cfg;
  1847	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  1848	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  1849	      PeakPickerIM spicker;
  1850	      Param sp = spicker.getParameters();
  1851	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  1852	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  1853	      if (const char* m = std::getenv("SPEXTRACT_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  1854	      spicker.setParameters(sp);
  1855	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  1856	      try
  1857	      {
  1858	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  1859	        {
  1860	#ifdef SPEXTRACT_WITH_MZPEAK
  1861	          spx::loadMzPeakStreaming(in, consumer, getIntOption_("threads"));   // consumer counts frames itself
  1862	#else
  1863	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  1864	#endif
  1865	        }
  1866	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  1867	        streamed = true;
  1868	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  1869	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  1870	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  1871	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  1872	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  1873	        if (std::getenv("SPEXTRACT_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  1874	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  1875	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  1876	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
  1877	                      + String(cfg.dia_ms2_n_neighbors) + ")" + clk_() + rss_());
  1878	      }
  1879	      catch (const Exception::BaseException& e)
  1880	      {
  1881	        writeLogWarn_(String("[stream] streaming load failed (") + e.getName()
  1882	                      + "); falling back to loadExperiment. " + e.getMessage());
  1883	      }
  1884	    }
  1885	
  1886	    if (!streamed)
  1887	    {
  1888	      Phase _ph("LOAD(full)");
  1889	      FileHandler().loadExperiment(in, exp, {FileTypes::MZML, FileTypes::MZPEAK, FileTypes::BRUKER_TDF}, log_type_);
  1890	    }
  1891	
  1892	    //-------------------------------------------------------------
  1893	    // Input normalization / validation [C-4]
  1894	    //-------------------------------------------------------------
  1895	    // [stream] The streaming path fills ms1_map/ms2_by_window directly via an IM-aware consumer
  1896	    // (PickCompactConsumer calls ensureIMArrayName), leaving `exp` EMPTY -- so the exp-based IM check
  1897	    // only applies to the non-streaming load. Running it on the streamed (empty) `exp` wrongly aborted
  1898	    // with "no ion-mobility data at MS1", which is why native pre-centroiding aggregation could never
  1899	    // be benchmarked. Streamed data is guarded by the ms1_map.empty() check below instead.
  1900	    if (!streamed)
  1901	    {
  1902	      IMFormat imf = IMTypes::determineIMFormat(exp, 1);
  1903	      if (imf == IMFormat::NONE)
  1904	      {
  1905	        writeLogError_("Error: input has no ion-mobility data at MS1. DIAPseudoSpectra requires diaPASEF (IM DIA) input.");
  1906	        return ILLEGAL_PARAMETERS;
  1907	      }
  1908	    }
  1909	    // deliberate: assumes 1/K0 (VSSC). ms/CCS conversion and FAIMS rejection are Phase 2 [M-2].
  1910	
  1911	    // Centroid IM frames that are still profile, keeping per-peak IM at a tolerance no coarser
  1912	    // than the trace IM tolerance [C-2]. Split MS1 vs MS2 into separate working maps.
  1913	    PeakPickerIM picker;
  1914	    Param pp = picker.getParameters();
  1915	    pp.setValue("pickIMCluster:im_tolerance_cluster", delta_im);
  1916	    pp.setValue("pickIMCluster:ppm_tolerance_cluster", mass_ppm);
  1917	    picker.setParameters(pp);
  1918	
  1919	    // Peak-pick (centroid) all IM frames in PARALLEL. PeakPickerIM is firstprivate so each thread
  1920	    // has its own copy -> the mutable ccs_warning_shown_ flag is not shared (a shared const picker
  1921	    // would be a real data race). pickIMCluster mutates only its own spectrum; distinct indices are
  1922	    // independent. [par-Crit-1]
  1923	    writeLogInfo_("Loaded " + String(exp.size()) + " frames." + clk_() + rss_()); // raw residency peak? [mem]
  1924	    writeLogInfo_("Peak-picking " + String(exp.size()) + " frames (OpenMP)...");
  1925	    // Param is a deep-copy value type (mutable ParamNode root_, defaulted copy) so firstprivate
  1926	    // gives each thread a fully independent picker -> no refcount/COW race. pickIMCluster can throw
  1927	    // (e.g. unexpected IM format); an exception escaping an OMP region terminates the process, so
  1928	    // capture it and rethrow serially. [par-Crit-1, code-review]
  1929	    std::exception_ptr pick_err;
  1930	    #pragma omp parallel for firstprivate(picker) schedule(dynamic, 16)
  1931	    for (long i = 0; i < (long)exp.size(); ++i)
  1932	    {
  1933	      try
  1934	      {
  1935	        MSSpectrum& s = exp[i];
  1936	        if (!s.containsIMData()) continue;
  1937	        if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  1938	        ensureIMArrayName(s); // so MassTraceDetection reads per-peak IM (IM-aware tracing) [C-1]
  1939	      }
  1940	      catch (...)
  1941	      {
  1942	        #pragma omp critical
  1943	        if (!pick_err) pick_err = std::current_exception();
  1944	      }
  1945	    }
  1946	    if (pick_err) std::rethrow_exception(pick_err);
  1947	
  1948	    // Serial dispatch: MOVE (not copy) frames into the MS1 map / per-window MS2 maps to avoid
  1949	    // transient memory doubling; container inserts aren't thread-safe so this stays serial.
  1950	    if (!streamed)
  1951	    for (MSSpectrum& s : exp)
  1952	    {
  1953	      if (!s.containsIMData()) continue;
  1954	      if (s.getMSLevel() == 1)
  1955	      {
  1956	        ms1_map.addSpectrum(std::move(s));
  1957	      }
  1958	      else if (s.getMSLevel() == 2 && !s.getPrecursors().empty())
  1959	      {
  1960	        const OpenMS::Precursor& pr = s.getPrecursors()[0];
  1961	        double lo = pr.getMZ() - pr.getIsolationWindowLowerOffset();
  1962	        double hi = pr.getMZ() + pr.getIsolationWindowUpperOffset();
  1963	        ms2_by_window[winKey(lo, hi)].push_back(compactify(s, cstat));
  1964	      }
  1965	    }
  1966	    exp.clear(true); // frames moved out; release the container
  1967	    {
  1968	      size_t cb = 0, cp = 0;
  1969	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) { cb += f.bytes(); cp += f.mzq.size(); }
  1970	      const size_t lost = cstat.no_im_array + cstat.size_mismatch + cstat.bad_mz + cstat.bad_im;
  1971	      if (lost)
  1972	      {
  1973	        writeLogWarn_("[compact] DROPPED " + String(lost) + " peaks: no_im_array=" + String(cstat.no_im_array)
  1974	                      + " size_mismatch=" + String(cstat.size_mismatch) + " bad_mz=" + String(cstat.bad_mz)
  1975	                      + " bad_im=" + String(cstat.bad_im) + " (kept " + String(cstat.kept) + ") -- if this is"
  1976	                      + " nonzero the compact store is NOT lossless and results differ from the old path.");
  1977	      }
  1978	      writeLogInfo_("Split into MS1 + " + String(ms2_by_window.size()) + " windows (picked); compact store "
  1979	                    + String(cb / (1024ULL * 1024ULL)) + " MB for " + String(cp) + " peaks (~"
  1980	                    + String(cp ? (double)cb / cp : 0.0) + " B/peak)." + clk_() + rss_()); // [mem]
  1981	    }
  1982	
  1983	    if (ms1_map.empty())
  1984	    {
  1985	      writeLogError_("Error: no MS1 ion-mobility frames found; cannot seed precursors.");
  1986	      return INCOMPATIBLE_INPUT_DATA;
  1987	    }
  1988	
  1989	    // THE GLOBAL RT AXIS. Every frame contributes one retention time; every trace point sits on a
  1990	    // frame. Building it here, once, is what lets a trace point be 8 bytes (frame index +
  1991	    // intensity) instead of 16 (RT + intensity), and lets two profiles be aligned by integer
  1992	    // equality instead of a binary search per point. Frames are counted once even when an MS1 and
  1993	    // an MS2 frame share an RT, which is what makes the index a valid shared key.
  1994	    {
  1995	      vector<double>& ax = rtAxis();
  1996	      ax.clear();
  1997	      ax.reserve(ms1_map.size() + 1024);
  1998	      for (const auto& sp : ms1_map) ax.push_back(sp.getRT());
  1999	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) ax.push_back(f.rt);
  2000	      sort(ax.begin(), ax.end());
  2001	      ax.erase(unique(ax.begin(), ax.end()), ax.end());
  2002	      writeLogInfo_("RT axis: " + String(ax.size()) + " distinct frame retention times"
  2003	                    + (ax.empty() ? "" : " spanning " + String(ax.front()) + "-" + String(ax.back()) + " s"));
  2004	      if (ax.empty())
  2005	      {
  2006	        writeLogError_("Error: no frame retention times; cannot build the RT axis.");
  2007	        return INCOMPATIBLE_INPUT_DATA;
  2008	      }
  2009	    }
  2010	
  2011	    //-------------------------------------------------------------
  2012	    // MS1 traces + precursor/charge inference (shared, once) [H-8,H-10]
  2013	    //-------------------------------------------------------------
  2014	    const int agg_ms1 = getIntOption_("trace:frame_aggregation_ms1_n");
  2015	    ms1_map.sortSpectra();
  2016	    if (agg_ms1 > 1) { aggregateFrames_(ms1_map, agg_ms1, mass_ppm, delta_im); writeLogInfo_("MS1 cross-frame aggregation N=" + String(agg_ms1) + rss_()); }
  2017	    const double ms1_snr = getDoubleOption_("trace:ms1_chrom_peak_snr");
  2018	    const double ms2_snr = getDoubleOption_("trace:ms2_chrom_peak_snr");
  2019	    const double ms2_minlen = getDoubleOption_("trace:ms2_min_length_sec");
  2020	    const double ms2_msr = getDoubleOption_("trace:ms2_min_sample_rate");
  2021	    double ms2_split = getDoubleOption_("trace:ms2_split_valleys");
  2022	    const double max_trace_len = getDoubleOption_("trace:max_trace_length_sec");
  2023	    const int agg_n = getIntOption_("trace:frame_aggregation_n");
  2024	    String ms1_span;
  2025	    // [parallel] MS1 tracing was UNBANDED: the call never passed a band count, so it defaulted to
  2026	    // 1 and MassTraceDetection -- a serial greedy loop over an intensity-sorted apex list -- ran on
  2027	    // ONE core while MS2 was banded across the machine. Invisible at default thresholds (MS1 is ~4%
  2028	    // of frames), fatal for the MS1 sensitivity sweep, which is the one lever the literature names
  2029	    // as the root cause of low-abundance loss in this tool class.
  2030	    int ms1_bands = getIntOption_("perf:ms1_trace_bands");
  2031	    if (ms1_bands < 1) ms1_bands = 1;
  2032	    double _t_ms1 = phase_clock_(), _c_ms1 = cpu_seconds_();   // [perf-instr]
  2033	    // detectTraces_ distributes its bands as TASKS, which requires an enclosing parallel region;
  2034	    // the window loop provides one, this phase must open its own. It also lets MS1 tracing use the
  2035	    // whole machine instead of the band count (it was measured at only 5.0x on 12 bands).
  2036	    vector<Trace> ms1_traces;
  2037	    #pragma omp parallel
  2038	    #pragma omp single
  2039	    ms1_traces = detectTraces_(ms1_map, delta_im, getDoubleOption_("trace:noise_threshold_int"),
  2040	                                             ms1_snr, getDoubleOption_("trace:min_length_sec"), getDoubleOption_("trace:ms1_min_sample_rate"), max_trace_len, getDoubleOption_("trace:ms1_split_valleys"), &ms1_span, ms1_bands);
  2041	    if (detOn_()) writeLogInfo_("[det] MS1 traces n=" + String(ms1_traces.size()) + " digest=" + String(traceDigest_(ms1_traces)));
  2042	    { auto& st = phase_stats_()["MS1_TRACE"]; if (st.n++ == 0) phase_order_().push_back("MS1_TRACE");
  2043	      st.wall += phase_clock_() - _t_ms1; st.cpu += cpu_seconds_() - _c_ms1; st.rss_end_mb = rss_mb_(); }
  2044	    writeLogInfo_("MS1 " + ms1_span);   // [merged-trace] measure, do not assume
  2045	
  2046	    // [fwhm] Measure the actual chromatographic peak width from the MS1 traces just built, and
  2047	    // use it to set the MS2 valley-splitting window. chrom_fwhm is an ABSOLUTE TIME, so a fixed
  2048	    // default cannot be right across methods: 14.0 s gave +0.0% peptides on a 31 min gradient
  2049	    // and -1.06% on a 5.6 min one, where the same 14 s is proportionally 5.5x wider.
  2050	    // Median, not mean: FWHM distributions are heavy-tailed and a mean is dominated by a handful
  2051	    // of merged or truncated traces. Traces that never fall to half maximum on both sides are
  2052	    // EXCLUDED rather than imputed -- a truncated peak is not a narrow one, and imputing it
  2053	    // would bias the estimate downward exactly where peaks are broadest.
  2054	    double ms1_fwhm_med = -1.0;
  2055	    {
  2056	      vector<double> fw;
  2057	      fw.reserve(ms1_traces.size() / 4 + 1);
  2058	      for (const auto& t : ms1_traces)
  2059	      {
  2060	        if (t.np() < 5) continue;
  2061	        size_t ap = 0;
  2062	        for (size_t i = 1; i < t.np(); ++i) if (t.intAt(i) > t.intAt(ap)) ap = i;
  2063	        const double half = t.intAt(ap) * 0.5;
  2064	        if (half <= 0.0) continue;
  2065	        double lo = -1.0, hi = -1.0;
  2066	        for (size_t i = ap; i > 0; --i)
  2067	          if (t.intAt(i - 1) <= half)
  2068	          { const double d = t.intAt(i) - t.intAt(i - 1);
  2069	            const double f = d > 0 ? (t.intAt(i) - half) / d : 0.0;
  2070	            lo = t.rtAt(i) - f * (t.rtAt(i) - t.rtAt(i - 1)); break; }
  2071	        for (size_t i = ap; i + 1 < t.np(); ++i)
  2072	          if (t.intAt(i + 1) <= half)
  2073	          { const double d = t.intAt(i) - t.intAt(i + 1);
  2074	            const double f = d > 0 ? (t.intAt(i) - half) / d : 0.0;
  2075	            hi = t.rtAt(i) + f * (t.rtAt(i + 1) - t.rtAt(i)); break; }
  2076	        if (lo >= 0.0 && hi > lo) fw.push_back(hi - lo);
  2077	      }
  2078	      if (!fw.empty())
  2079	      {
  2080	        std::nth_element(fw.begin(), fw.begin() + fw.size() / 2, fw.end());
  2081	        ms1_fwhm_med = fw[fw.size() / 2];
  2082	        writeLogInfo_("Measured MS1 FWHM: median " + String(ms1_fwhm_med) + " s over "
  2083	                      + String(fw.size()) + " traces (of " + String(ms1_traces.size())
  2084	                      + "; truncated peaks excluded)");
  2085	      }
  2086	      else writeLogInfo_("Measured MS1 FWHM: NO usable traces -- falling back to absolute seconds");
  2087	    }
  2088	    // ms2_split is declared at :1324 but the FWHM is only known HERE, after MS1 tracing --
  2089	    // that ordering is why only the MS2 side can use the measured width for free. Doing the
  2090	    // same for MS1 needs a two-pass trace (measure with splitting off, then re-trace), which is
  2091	    // a real cost and is deliberately not done blind.
  2092	    // [wavelet] The smoothing scale is a MEASUREMENT, not a parameter: trace:wavelet_smooth is a
  2093	    // multiple of the median MS1 FWHM just measured above. A fixed absolute width cannot be right
  2094	    // across gradients (the same 14 s was +0.0% on a 31 min method and -1.06% on a 5.6 min one).
  2095	    // Refuse rather than guess if no FWHM could be measured -- silently falling back to some
  2096	    // absolute default is how the split_valleys work produced method-dependent results.
  2097	    const double wl_mult = getDoubleOption_("trace:wavelet_smooth");
  2098	    if (wl_mult > 0.0 && ms1_fwhm_med > 0.0)
  2099	    {
  2100	      wl_scale_ = wl_mult * ms1_fwhm_med;
  2101	      writeLogInfo_("[wavelet] precursor-XIC smoothing ON: " + String(wl_mult) + " x measured FWHM "
  2102	                    + String(ms1_fwhm_med) + " s = " + String(wl_scale_) + " s");
  2103	    }
  2104	    else if (wl_mult > 0.0)
  2105	    {
  2106	      wl_scale_ = 0.0;
  2107	      writeLogWarn_("[wavelet] trace:wavelet_smooth requested but NO MS1 FWHM could be measured; "
  2108	                    "smoothing stays OFF rather than guessing an absolute width");
  2109	    }
  2110	    const double sv_fwhm = getDoubleOption_("trace:split_valleys_fwhm");
  2111	    if (sv_fwhm > 0.0 && ms1_fwhm_med > 0.0)
  2112	    {
  2113	      const double old_split = ms2_split;
  2114	      ms2_split = sv_fwhm * ms1_fwhm_med;
  2115	      writeLogInfo_("MS2 valley-split window set from measured FWHM: " + String(sv_fwhm) + " x "
  2116	                    + String(ms1_fwhm_med) + " s = " + String(ms2_split) + " s (was "
  2117	                    + String(old_split) + " s absolute)");
  2118	    }
  2119	    else if (sv_fwhm > 0.0)
  2120	      writeLogWarn_("trace:split_valleys_fwhm requested but no FWHM could be measured; "
  2121	                    "keeping the absolute trace:ms2_split_valleys value");
  2122	    const double iso_im_tol = getDoubleOption_("charge:iso_im_tolerance");
  2123	    const double ms2_noise = getDoubleOption_("trace:ms2_noise_threshold_int");
  2124	    writeLogInfo_("MS2 trace gate: apex > " + String(ms2_snr * ms2_noise) + " (snr " + String(ms2_snr)
  2125	                  + " x noise " + String(ms2_noise) + "), membership > " + String(ms2_noise)
  2126	                  + ", min_length " + String(ms2_minlen) + " s");
  2127	    const bool env_scoring = (getStringOption_("charge:scoring") == "envelope");
  2128	    const double ambig_margin = getDoubleOption_("charge:ambiguity_margin");
  2129	    // [determinism] Canonically order the MS1 traces before precursor inference. inferPrecursors_
  2130	    // is a GREEDY seed-and-mark-used loop; its output depends on ms1_traces' CONTAINER ORDER, and
  2131	    // that order is non-deterministic -- MS1 detectTraces_ runs at top level so EPD's internal
  2132	    // parallel-for is active and appends split traces in thread-completion order. The greedy
  2133	    // seed sort already tie-breaks on index (a<b), but the index maps to a different physical
  2134	    // trace each run. Result: ~0.7% run-to-run peptide wobble, and the deterministic -0.8% when a
  2135	    // parallel change reshuffled the order. A total physical sort here mirrors the MS2-side sort
  2136	    // that already exists (fragment traces are canonicalised right after detectTraces_) and makes
  2137	    // the whole tool reproducible -- which also makes the emitted-count/peptide correctness gate
  2138	    // MEASURABLE. [adv-review kimi/codex 2026-07-26]
  2139	    // A non-finite coordinate makes the comparator below non-transitive, which is UB in sort()
  2140	    // and silently corrupts every lower_bound on the result. The fragment path already filtered;
  2141	    // this one did not. [adv-review codex/kimi 2026-09-03]
  2142	    {
  2143	      const size_t before = ms1_traces.size();
  2144	      ms1_traces.erase(remove_if(ms1_traces.begin(), ms1_traces.end(), [](const Trace& t) {
  2145	        return !std::isfinite(t.mz) || !std::isfinite(t.rt) || !std::isfinite(t.im)
  2146	               || !std::isfinite(t.intensity);
  2147	      }), ms1_traces.end());
  2148	      if (before != ms1_traces.size())
  2149	        writeLogInfo_("dropped " + String(before - ms1_traces.size()) + " MS1 traces with non-finite coordinates");
  2150	    }
  2151	    sort(ms1_traces.begin(), ms1_traces.end(), [](const Trace& a, const Trace& b) {
  2152	      if (a.mz != b.mz) return a.mz < b.mz;
  2153	      if (a.rt != b.rt) return a.rt < b.rt;
  2154	      if (a.im != b.im) return a.im < b.im;
  2155	      return a.intensity < b.intensity;
  2156	    });
  2157	    double _t_win = 0, _c_win = 0;                             // [perf-instr] window loop (function scope)
  2158	    double _t_inf = phase_clock_(), _c_inf = cpu_seconds_();   // [perf-instr]
  2159	    vector<Precursor_> precursors = inferPrecursors_(ms1_traces, max_charge, delta_rt, iso_im_tol,
  2160	                                                     mass_ppm, env_scoring, ambig_margin);
  2161	    if (detOn_())
  2162	    {
  2163	      vector<uint64_t> b;
  2164	      for (const auto& pc : precursors) { uint64_t u; double v; v = pc.rt; std::memcpy(&u, &v, 8); b.push_back(u); v = pc.im; std::memcpy(&u, &v, 8); b.push_back(u); }
  2165	      writeLogInfo_("[det] precursors n=" + String(precursors.size()) + " digest=" + String(detDigest_(std::move(b))));
  2166	    }
  2167	    if (getFlag_("assembly:dedup_precursors"))
  2168	    {
  2169	      const size_t before = precursors.size();
  2170	      const size_t removed = dedupPrecursors_(precursors, ms1_traces, mass_ppm, delta_rt, delta_im);
  2171	      writeLogInfo_("Precursor dedup: removed " + String(removed) + " of " + String(before)
  2172	                    + " hypotheses (" + String((int)(1000.0 * removed / std::max<size_t>(before, 1)) / 10.0) + "%)");
  2173	    }
  2174	    // Emulate diaTracer, which assigns a charge to every precursor: give isotope-unsupported
  2175	    // precursors the default charge (0 = keep the strict isotope-only behavior and drop them).
  2176	    const int default_charge = getIntOption_("assembly:default_charge");
  2177	    // rp_max = per-fragment precursor cap. 0 = share-all (stream, memory-light). competitive flag = rp_max 1.
  2178	    int rp_max = getIntOption_("assembly:rp_max");
  2179	    const double apportion = getDoubleOption_("assembly:apportion");
  2180	    if (getFlag_("assembly:competitive") && rp_max <= 0) rp_max = 1;
  2181	    Size n_default = 0;
  2182	    const bool open_safe = getFlag_("assembly:open_search_safe");
  2183	    // [way-4] A GUESSED charge and an isotope-SUPPORTED charge must not be emitted identically.
  2184	    // Closed search hides the difference (engine enumerates); open search does not.
  2185	    for (auto& pc : precursors)
  2186	      if (pc.charge == 0) { pc.guessed = true; pc.charge = open_safe ? 0 : default_charge; ++n_default; }
  2187	    // [emission] Isotope-support gate: drop the guessed singletons rather than emit them. They are
  2188	    // coordinate-distinct (merge/dedup cannot cut them) and identify 8.8x less often; dropping all
  2189	    // guessed cost 0.78% peptides for -39.5% emission on S30. OFF by default (open-search caveat).
  2190	    if (getFlag_("assembly:require_isotope_support"))
  2191	    {
  2192	      const size_t before = precursors.size();
