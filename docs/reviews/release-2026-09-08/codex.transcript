     1	cmake_minimum_required(VERSION 3.16)
     2	project(SpeXtractor VERSION 2.0.0 LANGUAGES CXX)
     3	
     4	# SpeXtractor is a STANDALONE application that links against an existing OpenMS
     5	# installation. It is deliberately not part of the OpenMS source tree: OpenMS is a
     6	# prerequisite here, not a host.
     7	#
     8	# Point CMake at an OpenMS build or install with:
     9	#   cmake -DOpenMS_DIR=/path/to/OpenMS/build ..
    10	
    11	set(CMAKE_CXX_STANDARD 20)
    12	set(CMAKE_CXX_STANDARD_REQUIRED ON)
    13	if(NOT CMAKE_BUILD_TYPE)
    14	  set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
    15	endif()
    16	
    17	# The tool itself cannot be built without a PATCHED OpenMS: it includes
    18	# <OpenMS/FORMAT/TdfMzCalibration.h>, which scripts/apply_openms_patches.sh installs into the
    19	# OpenMS tree, and calls BrukerTimsFile::lastMzCalibration, which the same patch adds. No released
    20	# OpenMS package contains either. The calibration model, however, is a self-contained header, so
    21	# it can be compiled and tested anywhere -- which is what CI does on every platform.
    22	option(SPEXTRACTOR_TESTS_ONLY "Build only the OpenMS-independent tests (portability CI)" OFF)
    23	if(SPEXTRACTOR_TESTS_ONLY)
    24	  add_executable(test_calibration_cpp tests/test_calibration_cpp.cpp)
    25	  target_include_directories(test_calibration_cpp PRIVATE src)
    26	  enable_testing()
    27	  add_test(NAME calibration_golden
    28	           COMMAND test_calibration_cpp ${CMAKE_CURRENT_SOURCE_DIR}/tests/calibration_golden.json)
    29	  return()
    30	endif()
    31	
    32	find_package(OpenMS REQUIRED)
    33	find_package(OpenMP)
    34	find_package(SQLite3 REQUIRED)   # analysis.tdf is read directly; a missing SQLite is a build error, not a fallback
