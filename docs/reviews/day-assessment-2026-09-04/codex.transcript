  1744	  1030	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1745	  1031	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1746	  1032	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1747	  1033	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1748	  1034	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1749	  1035	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1750	  1036	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off dataset D 20:46 vs 28:40 for
  1751	  1037	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1752	  1038	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1753	  1039	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1754	  1040	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1755	  1041	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1756	  1042	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1757	  1043	    // determinism bug, now fixed.
  1758	  1044	    if (split_valleys > 0.0 && mts.size() > 1)
  1759	  1045	    {
  1760	  1046	      const int nthreads = std::max(1, bands);
  1761	  1047	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1762	  1048	      const size_t n_in = mts.size();
  1763	  1049	      vector<vector<MassTrace>> parts(nchunk);
  1764	  1050	      #pragma omp parallel for schedule(dynamic) num_threads(nthreads)
  1765	  1051	      for (int ci = 0; ci < nchunk; ++ci)
  1766	  1052	      {
  1767	  1053	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1768	  1054	        if (lo >= hi) continue;
  1769	  1055	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1770	  1056	                                std::make_move_iterator(mts.begin() + hi));
  1771	  1057	        parts[ci] = do_split(chunk);
  1772	  1058	      }
  1773	  1059	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1774	  1060	      vector<MassTrace> out; out.reserve(tot);
  1775	  1061	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1776	  1062	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1777	  1063	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1778	  1064	      mts.swap(out);
  1779	  1065	    }
  1780	  1066	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1781	  1067	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1782	  1068	    if (!mts.empty())
  1783	  1069	    {
  1784	  1070	      vector<double> spans;
  1785	  1071	      spans.reserve(mts.size());
  1786	  1072	      for (const auto& mt : mts)
  1787	  1073	      {
  1788	  1074	        double lo = 1e30, hi = -1e30;
  1789	  1075	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1790	  1076	        spans.push_back(hi - lo);
  1791	  1077	      }
  1792	  1078	      sort(spans.begin(), spans.end());
  1793	  1079	      size_t n = spans.size();
  1794	  1080	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1795	  1081	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1796	  1082	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1797	  1083	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1798	  1084	    }
