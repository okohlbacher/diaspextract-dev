    64	def synth(path, n_cycles=14, cycle_s=1.4, gap_cycles=()):
    65	    """Two precursors that co-elute in one isolation window: a z=2 envelope and a z=1 envelope.
    66	
    67	    Both are given a 3-peak isotope envelope so `require_isotope_support` keeps them, matching
    68	    fragments that co-elute with the precursor, and a distinct ion mobility.
    69	
    70	    `gap_cycles`: cycles in which the z=2 precursor AND its first fragment are ABSENT. This is
    71	    the input that separates a correct trace-extension rule from a wrong one: OpenMS tolerates up
    72	    to five consecutive missing frames before it ends a trace, so one gap must still give ONE
    73	    trace, and seven consecutive gaps must give TWO. Every version of the integer detector that
    74	    lost 92% of peptides passed the other checks in this file; none would have passed this.
    75	    """
    76	    win = (600.0, 590.0, 620.0)                    # target, lo, hi
    77	    z2_mono, z2_im = 601.3, 0.90                   # a doubly-charged precursor
    78	    z1_mono, z1_im = 610.6, 1.20                   # a singly-charged one
    79	    z2_frags = [(233.11, 0.7), (348.19, 1.0), (461.27, 0.55)]
    80	    z1_frags = [(288.14, 0.8), (401.22, 0.9)]
    81	    specs, idx = [], 0
    82	    for c in range(n_cycles):
    83	        rt = 1.0 + c * cycle_s
    84	        shape = 1.0 - abs(c - n_cycles / 2.0) / (n_cycles / 2.0 + 1.0)   # a triangular elution
    85	        amp = max(shape, 0.05)
    86	        ms1, ms1_im = [], []
    87	        gap = c in gap_cycles
    88	        for k, rel in enumerate((1.0, 0.55, 0.20)):                      # averagine-ish envelope
    89	            if not gap:
    90	                ms1.append((z2_mono + k * ISO / 2.0, 6.0e5 * amp * rel)); ms1_im.append(z2_im)
    91	            ms1.append((z1_mono + k * ISO / 1.0, 4.0e5 * amp * rel)); ms1_im.append(z1_im)
    92	        order = sorted(range(len(ms1)), key=lambda i: ms1[i][0])
    93	        specs.append(spectrum(idx, 1, rt, [ms1[i] for i in order], [ms1_im[i] for i in order])); idx += 1
    94	        ms2, ms2_im = [], []
    95	        for fi, (mz, rel) in enumerate(z2_frags):
    96	            if gap and fi == 0: continue                                   # first fragment gapped too
    97	            ms2.append((mz, 2.0e5 * amp * rel)); ms2_im.append(z2_im)
    98	        for mz, rel in z1_frags: ms2.append((mz, 1.5e5 * amp * rel)); ms2_im.append(z1_im)
    99	        order = sorted(range(len(ms2)), key=lambda i: ms2[i][0])
   100	        specs.append(spectrum(idx, 2, rt, [ms2[i] for i in order], [ms2_im[i] for i in order],
   101	                              prec=win)); idx += 1
   102	    body = "\n".join(specs)
