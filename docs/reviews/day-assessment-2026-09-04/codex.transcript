   805	
   806	  /// Mass-trace detection on the integer m/z axis.
   807	  ///
   808	  /// The OpenMS detector accepts a peak when it lies within `mass_error_ppm` of a trace's RUNNING
   809	  /// centroid, which needs a tolerance comparison against every live trace and makes the cost
   810	  /// superlinear in peaks per band -- measured on dataset D: 4 bands 18:25 wall / 163 GB against 12 bands
   811	  /// 12:53 / 103 GB, i.e. the same work costs more when the bands are bigger. On a uniform integer
   812	  /// axis the candidates for a peak are found by ARITHMETIC: a live trace can only accept indices
   813	  /// within `ppmSpan` of its centroid, so bucketing by `mz >> shift` with a bucket wider than the
   814	  /// largest span puts every candidate in the peak's own bucket or its two neighbours.
   815	  ///
   816	  /// This is a DIFFERENT ALGORITHM, not a reimplementation: it will not reproduce the OpenMS
   817	  /// detector peak for peak. It is therefore gated behind `trace:detector=integer` (default
   818	  /// `openms`) and must be judged on identified peptides with both search engines, never on a
   819	  /// spectrum digest.
   820	  ///
   821	  /// Mobility is part of the identity, as in the IM-aware OpenMS path: a candidate must also be
   822	  /// within `im_tol` of the trace's mobility. Valley splitting is NOT done here -- the existing
   823	  /// ElutionPeakDetection step runs afterwards on the traces this produces.
   824	  /// Mass-trace detection on integer arrays, following OpenMS `MassTraceDetection::run_` step for
   825	  /// step -- written from that source, not from a description of it. The first version was written
   826	  /// from a description and lost 92% of the peptides; the review that found why is in
   827	  /// docs/reviews/integer-tracing-2026-09-03/ and the corrected semantics are:
   828	  ///   * seeds in intensity order, ties later-index-first (stable ascending sort, reverse walk);
   829	  ///   * the two directions extend INTERLEAVED, one frame down then one up, sharing one centroid;
   830	  ///   * acceptance is the CLOSEST peak within +-3 sd of the running m/z centroid and within the
   831	  ///     mobility tolerance of the running mobility centroid; if that closest peak is already
   832	  ///     taken, the frame is a MISS -- the next-closest is not tried;
   833	  ///   * sd starts at centroid*ppm and is RE-ESTIMATED from the accepted peaks (reestimate_mt_sd);
   834	  ///   * a direction stops after more than 5 consecutive misses; an empty frame is not a miss;
   835	  ///   * the trace is valid if its RT span is within [min,max] length and
   836	  ///     size / (frames visited - trailing misses) >= min_sample_rate (0.5 by default);
   837	  ///   * peaks are marked taken only when the trace is valid;
   838	  ///   * the seed is counted twice in the centroid, as run_ does (init, then update again).
   839	  /// Peaks stay integers (flight-time bin, quantised mobility); the running centroid and sd are
   840	  /// doubles in m/z, exactly as in OpenMS, so the tolerance semantics are the same. The bin<->m/z
   841	  /// conversion is one calibration call per frame step plus one per ACCEPTED peak -- never per
   842	  /// visited peak. Valley splitting runs afterwards on the result, as it does for the OpenMS path.
   843	  /// Per-window, read-only preparation shared by every band task: frame of each peak, the
   844	  /// noise-membership mask, per-frame "has any member" (OpenMS deletes sub-noise peaks first and
   845	  /// only then asks whether a frame is empty), and the intensity-ordered seed list. Built ONCE.
   846	  /// The first corrected version rebuilt all of this inside each of the 12 band tasks -- twelve
   847	  /// full-window sorts per window and twelve sets of P-sized arrays alive at once -- which is
   848	  /// exactly where its extra time (9:28 vs 7:22) and extra memory (174 vs 166 GB) came from.
   849	  struct TracePrep
   850	  {
   851	    vector<char>     frame_live;  ///< F: has at least one member
   852	    vector<uint32_t> order;       ///< seeds, intensity desc, later-index-first among equals
   853	  };
   854	  TracePrep prepareTracing(const PeakSlab& sl, double noise, double snr)
   855	  {
   856	    TracePrep tp;
   857	    const size_t F = sl.frames(), P = sl.tof.size();
   858	    // No per-peak frame map and no membership byte: a peak's frame is the loop variable at every
   859	    // hot site (and one binary search at the two that lack it), and membership IS
   860	    // `inten > noise`. Measured: 100% of above-noise peaks are seeds at the shipped snr of 1.0, so
   861	    // `order` was reserved at P/4 and grew by doubling to ~2P -- count first, reserve exactly.
   862	    tp.frame_live.assign(F, 0);
   863	    const double min_apex = snr * noise;
   864	    size_t n_seed = 0;
   865	    for (size_t f = 0; f < F; ++f)
   866	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k)
   867	        if ((double)sl.inten[k] > noise) { tp.frame_live[f] = 1; if ((double)sl.inten[k] > min_apex) ++n_seed; }
   868	    tp.order.reserve(n_seed);
   869	    for (uint32_t k = 0; k < P; ++k)
   870	      if ((double)sl.inten[k] > noise && (double)sl.inten[k] > min_apex) tp.order.push_back(k);
   871	    // OpenMS: stable_sort ascending by intensity, then iterate in reverse -> among equal
   872	    // intensities the LATER peak seeds first.
   873	    sort(tp.order.begin(), tp.order.end(), [&](uint32_t a, uint32_t b) {
   874	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   875	      return a > b;
   876	    });
   877	    return tp;
   878	  }
   879	
   880	  vector<Trace> detectTracesInteger_(const PeakSlab& sl, const TracePrep& tp, TraceStore& store, double mass_ppm,
   881	                                     double im_tol, double noise, double min_len_sec, double min_sample_rate,
   882	                                     double max_len_sec, TofIdx band_lo = 0, TofIdx band_hi = 0)
   883	  {
   884	    vector<Trace> out;
   885	    const size_t F = sl.frames(), P = sl.tof.size();
   886	    if (F == 0 || P == 0) return out;
   887	    const bool banded = band_hi > band_lo;
   888	    const TofAxis& ax = tofAxis();
   889	    const double msr = min_sample_rate >= 0.0 ? min_sample_rate : 0.5;   // -1 = OpenMS default
   890	    const double imq_tol = im_tol * IM_Q;
   891	    const Size max_missed = 5;                                            // trace_termination_outliers
   892	    // a peak's frame, for the two sites that do not already have it in a loop variable
   893	    auto frameOfPeak = [&](uint32_t k) {
   894	      return (uint32_t)(std::upper_bound(sl.frame_off.begin(), sl.frame_off.end(), k) - sl.frame_off.begin() - 1);
   895	    };
   896	    const auto member = [&](uint32_t k) { return (double)sl.inten[k] > noise; };
   897	
   898	    vector<uint64_t> visited((P + 63) / 64, 0);   // one BIT per peak: 8x less than the char array
   899	    auto seen = [&](size_t k) { return (visited[k >> 6] >> (k & 63)) & 1u; };
   900	    auto mark = [&](size_t k) { visited[k >> 6] |= (uint64_t)1 << (k & 63); };
   901	    MemGuard g_vis(MEM_VISITED, vbytes(visited));  // x n_bands concurrently: the thing to watch
   902	    auto mzAt = [&](uint32_t k, size_t f) { return ax.mzOf(sl.tof[k], sl.b[f]); };
   903	    auto iwm = [](double v, double w, double& c, double& cnt, double& den) {   // updateIterativeWeightedMean_
   904	      const double ct = 1.0 + (w * v) / cnt, dt = 1.0 + w / den;
   905	      c *= (ct / dt); cnt += w * v; den += w;
   906	    };
   907	    auto sdRobust = [](double mz, double w, double mean, double& sd, double& wsum) {   // updateWeightedSDEstimateRobust
   908	      const double d1 = std::log(wsum) + 2.0 * std::log(sd);
   909	      const double d2 = std::log(w) + 2.0 * std::log(std::abs(mz - mean));
   910	      const double denom = std::sqrt(std::exp(d1) + std::exp(d2));
   911	      const double ws = wsum + w;
   912	      const double t = denom / std::sqrt(ws);
   913	      if (t > std::numeric_limits<double>::epsilon()) sd = t;
   914	      wsum = ws;
   915	    };
   916	    /// findBestPeak_ + isPeakAcceptable_: the closest peak in m/z within +-3 sd of the running
   917	    /// centroid whose mobility is inside the gate; -1 for "no candidate", and `taken` set when the
   918	    /// closest one is already used, which OpenMS counts as a miss rather than trying the next.
   919	    /// The +-3 sd window is converted to a BIN range once per frame step, so the walk is bounded
   920	    /// by two calibration calls and a binary search; only candidates inside that window are
   921	    /// converted back to m/z for the comparison.
   922	    auto best = [&](size_t f, double cmz, double sd, double cim, bool& taken) -> long {
   923	      taken = false;
   924	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
   925	      if (b <= a) return -1;
   926	      const double bf = sl.b[f];
   927	      const double lo_mz = cmz - 3.0 * sd, hi_mz = cmz + 3.0 * sd;
   928	      const TofIdx lo_t = ax.tofOf(lo_mz > 0.0 ? lo_mz : 1e-9, bf);
   929	      const TofIdx hi_t = ax.tofOf(hi_mz, bf);
   930	      const uint32_t s0 = (uint32_t)(lower_bound(sl.tof.begin() + a, sl.tof.begin() + b, lo_t) - sl.tof.begin());
   931	      long bk = -1; double bd = std::numeric_limits<double>::infinity();
   932	      for (uint32_t k = s0; k < b && sl.tof[k] <= hi_t; ++k)
   933	      {
   934	        if (!member(k)) continue;
   935	        if (std::abs((double)sl.imq[k] - cim) > imq_tol) continue;
   936	        // "Closest" is measured in m/z, as OpenMS does, NOT in bins: I had argued the calibration
   937	        // is monotone so the two agree, and that is true only for candidates on the same side of
   938	        // the centroid -- across it, the map's curvature can flip which is nearer. Measured: the
   939	        // bin metric cost 1.4% of peptides (12,650 -> 12,466) and bought no time (the speed came
   940	        // from parallel valley splitting). The walk is still bounded in bins; only candidates
   941	        // inside the window pay the conversion.
   942	        const double d = std::abs(ax.mzOf(sl.tof[k], bf) - cmz);
   943	        if (d < bd) { bd = d; bk = (long)k; }          // strict <: first of equals wins
   944	      }
   945	      if (bk >= 0 && seen((size_t)bk)) { taken = true; return -1; }
   946	      return bk;
   947	    };
   948	
   949	    struct Dir { Size hits = 0, missed = 0, scans = 0; bool active = true; };
   950	    vector<pair<uint32_t, uint32_t>> got;   // (frame, peak); marked only if the trace is valid
   951	    for (uint32_t seed : tp.order)
   952	    {
   953	      if (banded && (sl.tof[seed] < band_lo || sl.tof[seed] >= band_hi)) continue;   // not this band's core
   954	      if (seen(seed)) continue;
   955	      const size_t f0 = frameOfPeak(seed);
   956	      const double w0 = sl.inten[seed], m0 = mzAt(seed, f0);
   957	      double cmz = m0, cnt = w0 * m0, den = w0;
   958	      iwm(m0, w0, cmz, cnt, den);                             // seed counted twice, as run_ does
   959	      double cim = sl.imq[seed], cnt_im = w0 * cim, den_im = w0;
   960	      iwm((double)sl.imq[seed], w0, cim, cnt_im, den_im);
   961	      double sd = (cmz / 1e6) * mass_ppm, wsum = w0;
   962	      got.clear(); got.emplace_back((uint32_t)f0, seed);
   963	      Dir dn, up;
   964	      long fd = (long)f0, fu = (long)f0;
   965	      while ((fd > 0 && dn.active) || (fu + 1 < (long)F && up.active))
   966	      {
   967	        for (int side = 0; side < 2; ++side)
   968	        {
   969	          Dir& d = side == 0 ? dn : up;
   970	          long& fi = side == 0 ? fd : fu;
   971	          if (!d.active) continue;
   972	          if (side == 0 ? !(fi > 0) : !(fi + 1 < (long)F)) continue;
   973	          const size_t f = (size_t)(side == 0 ? fi - 1 : fi + 1);
   974	          // "empty" AFTER sub-noise deletion, as OpenMS tests it. SPEXTRACTOR_INT_EMPTY_RAW=1 tests
   975	          // raw emptiness instead: the A/B that attributes the 12,650 -> 12,466 move between the
   976	          // two corrected versions, which is the only semantic change between them.
   977	          static const bool empty_raw = std::getenv("SPEXTRACTOR_INT_EMPTY_RAW") != nullptr;
   978	          if (empty_raw ? (sl.frame_off[f + 1] > sl.frame_off[f]) : (bool)tp.frame_live[f])
   979	          {
   980	            bool taken = false;
   981	            const long k = best(f, cmz, sd, cim, taken);
   982	            if (k >= 0)
   983	            {
   984	              const double mz = mzAt((uint32_t)k, f), w = sl.inten[k];
   985	              iwm(mz, w, cmz, cnt, den);
   986	              iwm((double)sl.imq[k], w, cim, cnt_im, den_im);
   987	              sdRobust(mz, w, cmz, sd, wsum);   // reestimate_mt_sd: the tool never turns it off
   988	              got.emplace_back((uint32_t)f, (uint32_t)k);
   989	              ++d.hits; d.missed = 0;
   990	            }
   991	            else ++d.missed;
   992	          }
   993	          fi += (side == 0 ? -1 : 1);
   994	          ++d.scans;
   995	          if (d.missed > max_missed) d.active = false;
   996	        }
   997	      }
   998	      // isTraceValid_
   999	      uint32_t fmin = got[0].first, fmax = fmin;
  1000	      for (const auto& g : got) { fmin = std::min(fmin, g.first); fmax = std::max(fmax, g.first); }
  1001	      const double span_s = rtAxis()[sl.rt_index[fmax]] - rtAxis()[sl.rt_index[fmin]];
  1002	      if (span_s < min_len_sec) continue;
  1003	      if (max_len_sec > 0.0 && span_s > max_len_sec) continue;   // the tool passes 0 for "off"
  1004	      const Size total = dn.scans + up.scans + 1;
  1005	      const Size adjusted = total > dn.missed + up.missed ? total - dn.missed - up.missed : 1;
  1006	      if ((double)got.size() / (double)adjusted < msr) continue;
  1007	      for (const auto& g : got) mark(g.second);               // valid: now they are taken
  1008	
  1009	      // the span: (store-local frame, intensity) points, plus the per-frame bin arena the valley
  1010	      // splitter needs to give each child ITS measured apex bin
  1011	      vector<pair<uint32_t, float>> pts;
  1012	      pts.reserve(got.size());
  1013	      uint32_t kap = got[0].second, fap = got[0].first;
  1014	      for (const auto& g : got) { pts.emplace_back(g.first, sl.inten[g.second]);
  1015	                                  if (sl.inten[g.second] > sl.inten[kap]) { kap = g.second; fap = g.first; } }
  1016	      Trace t = makeSpan(pts, store);
  1017	      store.bins.resize(store.inten.size(), 0u);
  1018	      for (const auto& g : got) store.bins[t.off + (g.first - t.frame0)] = sl.tof[g.second];
  1019	      t.tof = sl.tof[kap]; t.b = sl.b[fap];
  1020	      t.mz = cmz;                                              // the weighted centroid, as OpenMS reports
  1021	      t.rt = rtAxis()[sl.rt_index[fap]];
  1022	      t.im = IM_LO + cim / IM_Q;
  1023	      t.intensity = sl.inten[kap];
  1024	      out.push_back(std::move(t));
  1025	    }
  1026	    return out;
  1027	  }
  1028	
  1029	  /// ElutionPeakDetection on a trace list -- the identical step the OpenMS path runs inside
  1030	  /// detectTraces_ (same parameters), lifted out so the integer detector's output goes through it
  1031	  /// too. The review of the first integer version found this step silently skipped.
  1032	  vector<MassTrace> splitValleys(vector<MassTrace>& in, double split_valleys)
  1033	  {
  1034	    if (split_valleys <= 0.0 || in.empty()) return std::move(in);
  1035	    ElutionPeakDetection epd;
  1036	    epd.setLogType(ProgressLogger::NONE);
  1037	    Param ep = epd.getParameters();
  1038	    ep.setValue("chrom_fwhm", split_valleys);
  1039	    ep.setValue("width_filtering", "off");
  1040	    ep.setValue("masstrace_snr_filtering", "false");
  1041	    epd.setParameters(ep);
  1042	    vector<MassTrace> out; out.reserve(in.size());
  1043	    epd.detectPeaks(in, out);
  1044	    return out;
  1045	  }
  1046	
  1047	  /// Integer traces -> MassTrace objects for EPD -> Trace again, with the flight-time bin
  1048	  /// re-attached from the apex frame's calibration. Only the TRACES become OpenMS objects -- the
  1049	  /// peak arrays never do, which is the point of the integer path.
  1050	  ///
  1051	  /// CHUNKED AND PARALLEL, like the OpenMS path's own valley-splitting step (do_split over
  1052	  /// bands*4 chunks as tasks). The previous version converted every trace of a window into a
  1053	  /// MassTrace (a list<Peak2D>, ~48 B/point) on ONE thread and then ran ElutionPeakDetection over
  1054	  /// all of them at once, also on one thread: a serial section of a stage that is 95% of the window
  1055	  /// loop, and the whole window's list-based copy alive at the same time. That is consistent with
  1056	  /// what was measured -- occupancy 44x against 81x for the OpenMS path, and MORE peak memory,
  1057	  /// after the per-band sorts and the per-visit calibration calls had already been removed and
  1058	  /// changed nothing.
  1059	  vector<Trace> splitIntegerTraces(vector<Trace>& in, double split_valleys, TraceStore& wst, int nchunk)
  1060	  {
  1061	    if (split_valleys <= 0.0 || in.size() < 2) return std::move(in);   // OpenMS branch: EPD needs > 1
  1062	    const TofAxis& ax = tofAxis();
  1063	    nchunk = std::max(1, std::min<int>(nchunk, (int)in.size()));
  1064	    vector<vector<Trace>> parts(nchunk);
  1065	    vector<TraceStore> stores(nchunk);                         // chunk-private arenas, merged after
  1066	    const size_t n_in = in.size();
  1067	    #pragma omp taskloop grainsize(1) default(shared)
  1068	    for (int ci = 0; ci < nchunk; ++ci)
  1069	    {
  1070	      const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1071	      TraceStore& cst = stores[ci];
  1072	      cst.setFrames(wst.rt_index, &wst.b);
  1073	      vector<MassTrace> mts; mts.reserve(hi - lo);
  1074	      long long mt_in_bytes = 0;                            // the real payload: vector<Peak2D> + object
  1075	      for (size_t q = lo; q < hi; ++q)
  1076	      {
  1077	        const Trace& t = in[q];
  1078	        // (the std::list is per trace and dies each iteration -- the first ledger charged a
  1079	        //  chunk-wide list that never existed, a 6 GB phantom; the MassTrace's own vector<Peak2D>
  1080	        //  is what lives for the whole chunk)
  1081	        mt_in_bytes += (long long)t.np() * (long long)sizeof(Peak2D) + (long long)sizeof(MassTrace);
  1082	        std::list<Peak2D> pk;                                  // REAL points only: EPD smooths what it is given
  1083	        for (size_t k = 0; k < t.span(); ++k)
  1084	        {
  1085	          if (!t.real(k)) continue;
  1086	          Peak2D pt; pt.setRT(t.rtAtSpan(k)); pt.setIntensity(t.xv(k));
  1087	          const uint32_t bin = wst.bins.empty() ? 0u : wst.bins[t.off + k];
  1088	          pt.setMZ(ax.ok && bin ? ax.mzOf(bin, wst.b[t.frame0 + k]) : t.mz);
  1089	          pk.push_back(pt);
  1090	        }
  1091	        MassTrace mt(pk);
  1092	        mt.setCentroidIM(t.im);
  1093	        mts.push_back(std::move(mt));
  1094	      }
  1095	      MemGuard g_in(MEM_EPD_LIST, mt_in_bytes);               // input MassTraces, alive across the split
  1096	      vector<MassTrace> split = splitValleys(mts, split_valleys);
  1097	      long long mt_out_bytes = 0;
  1098	      for (const auto& m : split) mt_out_bytes += (long long)m.getSize() * (long long)sizeof(Peak2D) + (long long)sizeof(MassTrace);
  1099	      MemGuard g_out(MEM_EPD_MT, mt_out_bytes);               // split MassTraces, coexisting with the input
  1100	      vector<Trace>& out = parts[ci];
  1101	      out.reserve(split.size());
  1102	      // Each child carries its own measured m/z: the parent's per-frame bin was written into
  1103	      // every Peak2D above, so the child's APEX PEAK m/z is that bin's m/z and the bin comes back
  1104	      // by inverting the calibration -- which is what the pre-span code did.
  1105	      //
  1106	      // The first version of this walked the parent list to look the bin up by frame. That was
  1107	      // wrong: parents within a chunk are in IM/m-z order, not frame order, and their frame ranges
  1108	      // overlap freely, so the walk could attribute a child to the wrong parent and hand it another
  1109	      // trace's bin. It cost 3.3% of peptides on dataset D while the OpenMS arm stayed digest-identical,
  1110	      // which is what localised it here. [2026-09-04]
  1111	      for (const MassTrace& mt : split)
  1112	      {
  1113	        Trace c = toTrace(mt, cst);
  1114	        if (c.np() == 0) continue;
  1115	        const uint32_t cf = c.frame0 + c.apex;                 // apex frame, window-local
  1116	        c.b = wst.b.empty() ? ax.factor(0) : wst.b[cf];
  1117	        const double amz = mt.getSize() ? mt[mt.findMaxByIntPeak(false)].getMZ() : c.mz;
  1118	        c.tof = ax.ok ? ax.tofOf(amz, c.b) : 0u;
  1119	        out.push_back(std::move(c));
  1120	      }
  1121	    }
  1122	    // the parents' spans are dead: rebuild the window arena from the chunk arenas
  1123	    vector<Trace>().swap(in);
  1124	    vector<float>().swap(wst.inten); vector<uint32_t>().swap(wst.bins);
  1125	    size_t tot = 0; for (const auto& v : parts) tot += v.size();
  1126	    vector<Trace> out; out.reserve(tot);
  1127	    for (int ci = 0; ci < nchunk; ++ci)
  1128	    {
  1129	      const uint32_t base = wst.absorb(stores[ci]);
  1130	      for (auto& t : parts[ci]) { t.off += base; out.push_back(std::move(t)); }
  1131	      vector<Trace>().swap(parts[ci]);
  1132	    }
  1133	    return out;
  1134	  }
  1135	
  1136	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
  1137	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
  1138	  PeakMap materializeWindow(vector<CompactFrame>& frames)
  1139	  {
  1140	    PeakMap m;
  1141	    m.reserve(frames.size());
  1142	    for (auto& f : frames)
  1143	    {
  1144	      MSSpectrum s;
  1145	      s.setRT(f.rt);
  1146	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
  1147	      s.reserve(f.mzq.size());
  1148	      OpenMS::DataArrays::FloatDataArray ima;
  1149	      ima.setName(Constants::UserParam::ION_MOBILITY);
  1150	      ima.reserve(f.mzq.size());
  1151	      for (size_t i = 0; i < f.mzq.size(); ++i)
  1152	      {
  1153	        Peak1D p;
  1154	        p.setMZ((double)f.mzq[i] / MZ_Q);
  1155	        p.setIntensity(f.inten[i]);
  1156	        s.push_back(p);
  1157	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
  1158	      }
  1159	      s.getFloatDataArrays().push_back(std::move(ima));
  1160	      m.addSpectrum(std::move(s));

