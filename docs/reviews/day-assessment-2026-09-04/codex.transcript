   289	/**
   290	  @page TOPP_DIAPseudoSpectra DIAPseudoSpectra
   291	
   292	  @brief Extracts pseudo-MS/MS ("pseudo-DDA") spectra from diaPASEF (ion-mobility DIA) data.
   293	
   294	  Reconstructs DDA-like MS2 spectra from ion-mobility DIA (timsTOF / diaPASEF) data by
   295	  exploiting the fact that, in PASEF, fragments are recorded at the ion-mobility (1/K0)
   296	  elution coordinate of their precursor. Precursor and fragment mass traces are detected
   297	  IM-aware (@ref MassTraceDetection with an ion-mobility tolerance), then fragments are
   298	  assigned to a precursor when they co-localize in ion mobility, retention time, and
   299	  elution-profile (Pearson) correlation. The result is written as searchable mzML.
   300	
   301	  This is the OpenMS-native, BSD-3 analogue of Nesvilab the reference implementation. It is a discovery
   302	  front-end (enables open / semi-tryptic / PTM searches); it does not perform the database
   303	  search, FDR, library building or quantification.
   304	
   305	  See docs/dataset D-BASELINE.md for the measured decisions behind every default, and docs/reviews/
   306	  for the adversarial reviews.
   307	
   308	  <B>The command line parameters of this tool are:</B>
   309	  @verbinclude TOPP_DIAPseudoSpectra.cli
   310	  <B>INI file documentation of this tool:</B>
   311	  @htmlinclude TOPP_DIAPseudoSpectra.html
   312	*/
   313	
   314	/// @cond TOPPCLASSES
   315	
   316	namespace
   317	{
   318	  /// A detected mass trace reduced to the quantities we correlate/gate on.
   319	  /// Current + peak resident set, read from /proc/self/status (Linux). Logged at phase boundaries so
   320	  /// the memory peak is MEASURED rather than estimated: it tells us whether the peak sits in the
   321	  /// raw-load phase or in the parallel per-window phase. Returns "" where unsupported. [mem]
   322	  /// seconds since tool start, for per-phase bottleneck attribution [perf]
   323	  static double phase_clock_()
   324	  {
   325	    static const auto t0 = std::chrono::steady_clock::now();
   326	    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
   327	  }
   328	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
   329	
   330	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
   331	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
   332	  /// printed unconditionally at the end so a benchmark log always says where the time went.
   333	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
   334	  inline double& flush_wall_() { static double v = 0; return v; }   // [perf-load] pick inside LOAD
   335	  inline std::map<std::string, PhaseStat>& phase_stats_()
   336	  { static std::map<std::string, PhaseStat> m; return m; }
   337	  inline std::vector<std::string>& phase_order_()
   338	  { static std::vector<std::string> v; return v; }
   339	  static double cpu_seconds_()
   340	  {
   341	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   342	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
   343	    return ru.ru_utime.tv_sec + ru.ru_utime.tv_usec * 1e-6
   344	         + ru.ru_stime.tv_sec + ru.ru_stime.tv_usec * 1e-6;
   345	  }
   346	  static long rss_mb_()
   347	  {
   348	    std::ifstream f("/proc/self/status"); std::string k;   // deliberate: Linux-only, returns 0 elsewhere
   349	    while (f >> k) { if (k == "VmRSS:") { long v; f >> v; return v / 1024; } f.ignore(1 << 20, '\n'); }
   350	    return 0;
   351	  }
   352	  struct Phase
   353	  {
   354	    std::string name; double w0, c0;
   355	    explicit Phase(std::string n) : name(std::move(n)), w0(phase_clock_()), c0(cpu_seconds_()) {}
   356	    ~Phase()
   357	    {
   358	      auto& st = phase_stats_()[name];
   359	      if (st.n == 0) phase_order_().push_back(name);
   360	      st.wall += phase_clock_() - w0; st.cpu += cpu_seconds_() - c0;
   361	      st.rss_end_mb = rss_mb_(); ++st.n;
   362	    }
   363	  };
   364	  static void report_phases_(double total_wall)
   365	  {
   366	    if (phase_order_().empty()) return;
   367	    OPENMS_LOG_INFO << "\n[perf] phase breakdown (wall s | % of total | CPU s | par x | RSS MB at end)\n";
   368	    double acc = 0;
   369	    for (const auto& n : phase_order_())
   370	    {
   371	      const auto& p = phase_stats_()[n];
   372	      acc += p.wall;
   373	      char b[220];
   374	      snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  %9.1f  %5.1fx  %8ld%s\n", n.c_str(), p.wall,
   375	               total_wall > 0 ? 100.0 * p.wall / total_wall : 0.0, p.cpu,
   376	               p.wall > 0 ? p.cpu / p.wall : 0.0, p.rss_end_mb, p.n > 1 ? "  (summed)" : "");
   377	      OPENMS_LOG_INFO << b;
   378	    }
   379	    char b[160];
   380	    snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  (unattributed %.1f s)\n", "TOTAL(measured)", acc,
   381	             total_wall > 0 ? 100.0 * acc / total_wall : 0.0, total_wall - acc);
   382	    OPENMS_LOG_INFO << b;
   383	  }
   384	
   385	  bool log_overlap_ = false;   ///< [B0] gate:coelution == "logoverlap"
   386	  /// [wavelet] Precursor-XIC smoothing scale in SECONDS, derived from the MEASURED MS1 FWHM
   387	  /// (trace:wavelet_smooth x median FWHM). 0 = off. Set once, after MS1 tracing, before the
   388	  /// window loop -- it cannot be read from a parameter directly because the FWHM is a measurement.
   389	  double wl_scale_ = 0.0;
   390	  bool rank_by_intensity_ = false;   ///< [rank] assembly:rank_by == "intensity" (the reference implementation-style)
   391	  double im_weight_sigma_ = 0.0;     ///< [recall] Gaussian IM-proximity weight on emitted fragment intensity (0=off)
   392	  double mono_guard_ = 0.0;          ///< [mono-guard] averagine slack on leftward isotope steps (0=off)
   393	  bool mono_select_ = false;         ///< [mono-select] pick the mono by averagine fit over the isotope run
   394	  std::atomic<long long> stat_slice_{0};    ///< fragments VISITED by the IM slice
   395	  std::atomic<long long> stat_rtpass_{0};   ///< of those, how many pass the RT gate
   396	  std::atomic<long long> stat_prec_{0};     ///< precursors scored
   397	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   398	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   399	  bool drop_prec_iso_ = std::getenv("SPEXTRACTOR_DROP_PREC_ISO") != nullptr;   ///< [C9 A/B] drop precursor M+1..M+3 from fragment lists
   400	
   401	  static std::string rss_()
   402	  {
   403	    std::ifstream st("/proc/self/status");
   404	    if (!st) return "";
   405	    std::string line, cur = "?", peak = "?";
   406	    while (std::getline(st, line))
   407	    {
   408	      auto val = [&line]() {
   409	        std::string v = line.substr(line.find(':') + 1);
   410	        size_t a = v.find_first_not_of(" \t");
   411	        return a == std::string::npos ? std::string("?") : v.substr(a);
   412	      };
   413	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   414	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   415	    }
   416	    return " [RSS " + cur + ", peak " + peak + "]";
   417	  }
   418	
   419	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   420	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   421	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   422	  /// the other users. Add our own RSS back: memory we already hold is part of our budget, not
   423	  /// somebody else's. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   424	  static size_t availableBytes_()
   425	  {
   426	    std::ifstream mi("/proc/meminfo");
   427	    if (!mi) return 0;
   428	    std::string line;
   429	    size_t avail_kb = 0;
   430	    while (std::getline(mi, line))
   431	      if (line.rfind("MemAvailable:", 0) == 0)
   432	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   433	    if (!avail_kb) return 0;
   434	    std::ifstream st("/proc/self/status");
   435	    size_t rss_kb = 0;
   436	    while (st && std::getline(st, line))
   437	      if (line.rfind("VmRSS:", 0) == 0)
   438	      { rss_kb = strtoull(line.c_str() + 6, nullptr, 10); break; }
   439	    return (avail_kb + rss_kb) * 1024ull;
   440	  }
   441	
   442	  /// THE RT AXIS IS GLOBAL AND DISCRETE. Every acquired frame has one retention time, and every
   443	  /// point of every mass trace sits on one of those frames -- so an RT value never needs to be
   444	  /// stored per point. It used to be: `vector<pair<double,double>>` cost 16 B per point and
   445	  /// duplicated the same ~33,000 values across hundreds of millions of points, and aligning two
   446	  /// profiles meant a binary search per point because the values had to be compared numerically.
   447	  /// Here the axis is stored ONCE, a point is (frame index, intensity) at 8 B, and alignment is
   448	  /// integer equality. Built once after loading, read-only thereafter.
   449	  inline vector<double>& rtAxis() { static vector<double> v; return v; }
   450	
   451	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   452	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   453	  inline uint32_t rtIndex(double rt)
   454	  {
   455	    const vector<double>& a = rtAxis();
   456	    if (a.empty()) return 0;
   457	    auto it = lower_bound(a.begin(), a.end(), rt);
   458	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   459	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   460	    return (uint32_t)(it - a.begin());
   461	  }
   462	
   463	  struct Trace
   464	  {
   465	    double mz = 0.0;
   466	    double rt = 0.0;   ///< apex/centroid RT
   467	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   468	    double intensity = 0.0;
   469	    /// The flight-time bin this trace was measured on, and the calibration factor of its apex
   470	    /// frame. The pair is the AUTHORITATIVE m/z: `mz` below is a cached convenience for the gates
   471	    /// that still compare in m/z space, and the value actually written out is recomputed from these
   472	    /// two at export. 0 means the trace came from the OpenMS detector, which has no bin.
   473	    uint32_t tof = 0;
   474	    double   b = 0.0;
   475	    /// Elution profile, ascending in RT: parallel arrays of frame index and intensity. 8 B/point.
   476	    vector<uint32_t> xi;
   477	    vector<float>    xv;
   478	    size_t np() const { return xi.size(); }
   479	    double rtAt(size_t i) const { return rtAxis()[xi[i]]; }
   480	    double intAt(size_t i) const { return (double)xv[i]; }
   481	    void freeProfile() { vector<uint32_t>().swap(xi); vector<float>().swap(xv); }
   482	  };
   483	
   484	  /// A precursor hypothesis after isotope/charge inference.
   485	  struct Precursor_
   486	  {
   487	    double mono_mz = 0.0;
   488	    uint32_t mono_tof = 0;   ///< the monoisotope's flight-time bin, and its frame's factor: the
   489	    double   mono_b = 0.0;   ///  reported m/z is recomputed from these when the spectrum is written
   490	    int charge = 0;          ///< 0 == unknown
   491	    double rt = 0.0;
   492	    double im = 0.0;
   493	    size_t trace_idx = 0;    ///< index into ms1 traces
   494	    bool guessed = false;    ///< [way-4] charge was DEFAULTED, not isotope-supported
   495	    int n_isotopes = 0;      ///< [Q4] isotope peaks behind the mono call (0/1 = weak, mono ±1.00335 uncertain)
   496	  };
   497	
   498	  /// MassTraceDetection locates the per-peak IM array by the exact name
   499	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   500	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   501	  void ensureIMArrayName(MSSpectrum& s)
   502	  {
   503	    auto& fdas = s.getFloatDataArrays();
   504	    if (s.containsIMData())
   505	    {
   506	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   507	      return;
   508	    }
   509	    for (auto& fda : fdas)
   510	    {
   511	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   512	      {
   513	        fda.setName(Constants::UserParam::ION_MOBILITY);
   514	        return;
   515	      }
   516	    }
   517	  }
   518	
   519	  /// Reported-m/z estimator, set once from `trace:mz_estimator` before any trace is converted.
   520	  /// A file-scope value because toTrace() is a free helper with no access to the tool's parameters.
   521	  inline std::string& mzEstimator() { static std::string v = "apex"; return v; }
   522	
   523	  Trace toTrace(const MassTrace& mt)
   524	  {
   525	    Trace t;
   526	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   527	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   528	    // `trace:mz_estimator` -- see docs/dataset D-BASELINE.md for the comparison that chose apex.
   529	    const std::string& mz_est = mzEstimator();
   530	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   531	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   532	    else t.mz = mt.getCentroidMZ();
   533	    t.rt = mt.getCentroidRT();
   534	    t.im = mt.getCentroidIM();
   535	    t.intensity = mt.getMaxIntensity(false);
   536	    // MassTrace peaks are not guaranteed RT-ordered, and the profile must be ascending for the
   537	    // correlation loops, so index them and sort the small (index, intensity) pairs.
   538	    const Size np = mt.getSize();
   539	    vector<pair<uint32_t, float>> pts;
   540	    pts.reserve(np);
   541	    for (Size i = 0; i < np; ++i) pts.emplace_back(rtIndex(mt[i].getRT()), (float)mt[i].getIntensity());
   542	    sort(pts.begin(), pts.end());
   543	    t.xi.reserve(np); t.xv.reserve(np);
   544	    for (const auto& q : pts) { t.xi.push_back(q.first); t.xv.push_back(q.second); }
   545	    return t;
   546	  }
   547	
   548	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   549	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   550	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   551	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   552	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   553	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   554	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   555	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   556	  struct FragGrid
   557	  {
   558	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   559	    vector<int> slot_of_frame;                  ///< global frame index -> grid slot, -1 if unused
   560	    vector<int> nearest_slot;                   ///< global frame index -> NEAREST used slot within delta_rt
   561	    vector<uint64_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   562	                                                ///  64-bit on purpose: 8.5 M fragments x ~510 support
   563	                                                ///  points is within 2x of the 32-bit wrap, and an
   564	                                                ///  overflow here silently corrupts every correlation.
   565	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   566	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   567	    size_t supBegin(size_t i) const { return off[i]; }
   568	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   569	  };
