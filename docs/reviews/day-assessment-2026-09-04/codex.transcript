  1862	  1477	    {
  1863	  1478	      const auto& p = p_xic[pi];
  1864	  1479	      const double pval = p_int ? (*p_int)[pi] : p.second;
  1865	  1480	      auto it = lower_bound(fg.rt.begin(), fg.rt.end(), p.first);
  1866	  1481	      int gi = -1; double bd = delta_rt;
  1867	  1482	      for (auto c : {it == fg.rt.begin() ? it : prev(it), it})
  1868	  1483	      {
  1869	  1484	        if (c == fg.rt.end()) continue;
  1870	  1485	        double d = fabs(*c - p.first);
