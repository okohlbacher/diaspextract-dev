  2379	  {
  2380	    if (tof == 0 || !(b > 0.0) || !tofAxis().ok) return cached;
  2381	    const double v = tofAxis().mzOf(tof, b);
  2382	    return std::isfinite(v) && v > 0.0 ? v : cached;
  2383	  }
