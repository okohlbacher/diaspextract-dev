  4464	  1985	        const double half = t.xic[ap].second * 0.5;
  4465	  1986	        if (half <= 0.0) continue;
  4466	  1987	        double lo = -1.0, hi = -1.0;
  4467	  1988	        for (size_t i = ap; i > 0; --i)
  4468	  1989	          if (t.xic[i - 1].second <= half)
  4469	  1990	          { const double d = t.xic[i].second - t.xic[i - 1].second;
  4470	  1991	            const double f = d > 0 ? (t.xic[i].second - half) / d : 0.0;
