  1926	  1541	        {
  1927	  1542	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  1928	  1543	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  1929	  1544	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
