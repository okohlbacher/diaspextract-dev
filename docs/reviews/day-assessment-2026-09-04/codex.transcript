  1354	  1103	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1355	  1104	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1356	  1105	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1357	  1106	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1358	  1107	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1359	  1108	  {
  1360	  1109	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1361	  1110	    out.assign(n, 0.0);
  1362	  1111	    double term = 1.0;
  1363	  1112	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1364	  1113	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1365	  1114	    if (mx > 0) for (double& v : out) v /= mx;
  1366	  1115	  }
