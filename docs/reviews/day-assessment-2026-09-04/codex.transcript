  1311	
  1312	  /// [wavelet] Stationary ("a trous") B3-spline wavelet smoothing of an elution profile.
  1313	  ///
  1314	  /// WHY. the reference implementation correlates a SMOOTHED precursor XIC against RAW fragment XICs (Nat Commun
  1315	  /// 16:95, Methods: 2D Gaussian pre-filter, then Savitzky-Golay for elongated peaks). We copied
  1316	  /// its 0.3 correlation threshold WITHOUT copying the smoothing. Pearson r between two noisy
  1317	  /// profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker
  1318	  /// constraint than a smoothed 0.3 -- and the attenuation is worst exactly at faint precursors,
  1319	  /// which is where the coverage analysis says we lose peptides (MISS precursors are 3.2x dimmer).
  1320	  /// Raising the threshold to compensate was tried and produced only an FDR artefact; smoothing
  1321	  /// attacks the cause instead of the symptom.
  1322	  ///
  1323	  /// A-TROUS, not a decimated DWT: no downsampling, so the output stays sample-aligned with the
  1324	  /// input and can be scattered onto the correlation grid at the SAME RT positions. That matters
  1325	  /// for correctness here, not just convenience -- the overlap gate counts grid points where the
  1326	  /// precursor is non-zero, so a transform that moved or resampled points would silently change
  1327	  /// what `min_correlation_points` means.
  1328	  ///
  1329	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
  1330	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
  1331	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
  1332	  {
  1333	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
  1334	    const int n = (int)in.size();
  1335	    out = in;
  1336	    if (n < 3 || levels <= 0) return;
  1337	    vector<double> tmp(n);
  1338	    for (int j = 1; j <= levels; ++j)
  1339	    {
  1340	      const int step = 1 << (j - 1);
  1341	      for (int i = 0; i < n; ++i)
  1342	      {
  1343	        double acc = 0.0;
  1344	        for (int k = -2; k <= 2; ++k)
  1345	        {
  1346	          int idx = i + k * step;
  1347	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
  1348	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
  1349	          if (idx < 0) idx = -idx;
  1350	          if (idx >= n) idx = 2 * (n - 1) - idx;
  1351	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
  1352	          acc += H[k + 2] * out[idx];
  1353	        }
  1354	        tmp[i] = acc;
  1355	      }
  1356	      out.swap(tmp);
  1357	    }
  1358	  }
  1359	
  1360	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
  1361	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
  1362	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
  1363	  /// physical widths on different traces.
  1364	  int atrousLevels(const Trace& tr, double scale_sec)
  1365	  {
  1366	    if (tr.np() < 5 || scale_sec <= 0.0) return 0;
  1367	    thread_local vector<double> prt, pv;
  1368	    packReal(tr, prt, pv);                             // the smoother's gaps are between REAL points
  1369	    vector<double> d;
  1370	    d.reserve(prt.size());
  1371	    for (size_t i = 1; i < prt.size(); ++i)
  1372	    {
  1373	      const double g = prt[i] - prt[i - 1];
  1374	      if (g > 0) d.push_back(g);
  1375	    }
  1376	    if (d.empty()) return 0;
  1377	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
  1378	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
  1379	    if (dt <= 0.0) return 0;
  1380	    const double want = scale_sec / dt;                // desired support, in SAMPLES
  1381	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
  1382	    const int j = (int)std::lround(std::log2(want));
  1383	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
  1384	  }
  1385	
  1386	  /// Per-window scoring statistics from IM-sorted fragment traces (see FragStats).
  1387	  /// What the scorer needs per window, now that a fragment's profile is a span in the window's
  1388	  /// own frame sequence: the Pearson denominator G (distinct frames carrying a REAL fragment
  1389	  /// point -- not the window's frame count), per-fragment mean and 1/norm over real points, and
  1390	  /// the precursor-to-fragment nearest-frame table. No copy of any profile: the arena is the grid.
  1391	  struct FragStats
  1392	  {
  1393	    vector<double> mean, invnorm;   ///< per fragment, over the full grid of G frames
  1394	    vector<int>    nearest_local;   ///< MS1-store frame -> window frame with real fragment data, or -1
  1395	    vector<char>   used;            ///< window frame carries >= 1 real fragment point
  1396	    size_t G = 0;
  1397	  };
  1398	
  1399	  FragStats buildFragStats(const vector<Trace>& frags, const TraceStore& wst, const TraceStore& ms1st, double delta_rt)
  1400	  {
  1401	    FragStats g;
  1402	    const size_t F = wst.frames();
  1403	    g.used.assign(F, 0);
  1404	    for (const auto& f : frags)
  1405	      for (size_t k = 0; k < f.span(); ++k) if (f.real(k)) g.used[f.frame0 + k] = 1;
  1406	    for (char u : g.used) g.G += u ? 1 : 0;
  1407	    const double G = (double)g.G;
  1408	    // Precursor points live on MS1 frames; each maps to the NEAREST window frame that carries real
  1409	    // fragment data, within gate:delta_rt, ties to the LATER frame -- the rule the old grid used.
  1410	    vector<uint32_t> uf; uf.reserve(g.G);
  1411	    for (uint32_t f = 0; f < F; ++f) if (g.used[f]) uf.push_back(f);
  1412	    g.nearest_local.assign(ms1st.frames(), -1);
  1413	    size_t hi = 0;
  1414	    for (size_t m = 0; m < ms1st.frames(); ++m)
  1415	    {
  1416	      const double t = ms1st.frame_rt[m];
  1417	      while (hi < uf.size() && wst.frame_rt[uf[hi]] < t) ++hi;
  1418	      double bd = delta_rt; int gi = -1;
  1419	      if (hi > 0)          { const double d = fabs(wst.frame_rt[uf[hi - 1]] - t); if (d <= bd) { bd = d; gi = (int)uf[hi - 1]; } }
  1420	      if (hi < uf.size())  { const double d = fabs(wst.frame_rt[uf[hi]] - t);     if (d <= bd) { bd = d; gi = (int)uf[hi]; } }
  1421	      g.nearest_local[m] = gi;
  1422	    }
  1423	    g.mean.resize(frags.size()); g.invnorm.resize(frags.size());
  1424	    #pragma omp taskloop default(shared)
  1425	    for (long ii = 0; ii < (long)frags.size(); ++ii)
  1426	    {
  1427	      const Trace& f = frags[(size_t)ii];
  1428	      double sum = 0, sumsq = 0;
  1429	      for (size_t k = 0; k < f.span(); ++k) { const double v = f.xv(k); if (v > 0.0) { sum += v; sumsq += v * v; } }
  1430	      g.mean[ii] = sum / G;
  1431	      const double var = sumsq - G * g.mean[ii] * g.mean[ii];
  1432	      g.invnorm[ii] = var > 0 ? 1.0 / sqrt(var) : 0.0;  // 0 => constant/degenerate -> never correlates
  1433	    }
  1434	    return g;
  1435	  }
  1436	}
