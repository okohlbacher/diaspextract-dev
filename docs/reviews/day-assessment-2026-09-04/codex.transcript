   763	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   764	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   765	  PeakSlab toSlab(vector<CompactFrame>& frames)
   766	  {
   767	    PeakSlab sl;
   768	    const size_t F = frames.size();
   769	    sl.frame_off.resize(F + 1, 0);
   770	    sl.rt_index.resize(F);
   771	    size_t total = 0;
   772	    for (const auto& f : frames) total += f.mzq.size();
   773	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   774	    sl.b.resize(F);
   775	    const TofAxis& ax = tofAxis();
   776	    for (size_t i = 0; i < F; ++i)
   777	    {
   778	      CompactFrame& f = frames[i];
   779	      sl.rt_index[i] = rtIndex(f.rt);
   780	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   781	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   782	      // introduced here, and the loader does not have to change.
   783	      const double b = ax.factor(f.frame_id);
   784	      sl.b[i] = b;
   785	      sl.frame_off[i] = (uint32_t)sl.tof.size();

