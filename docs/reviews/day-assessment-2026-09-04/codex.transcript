    37	def spectrum(idx, ms_level, rt, peaks, im, prec=None):
    38	    """One mzML spectrum. `peaks` is [(mz, intensity)], `im` one 1/K0 per peak."""
    39	    mz = b64f([p[0] for p in peaks])
