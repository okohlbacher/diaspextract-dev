   854	  TracePrep prepareTracing(const PeakSlab& sl, double noise, double snr)
   855	  {
   856	    TracePrep tp;
   857	    const size_t F = sl.frames(), P = sl.tof.size();
   858	    // No per-peak frame map and no membership byte: a peak's frame is the loop variable at every
   859	    // hot site (and one binary search at the two that lack it), and membership IS
   860	    // `inten > noise`. Measured: 100% of above-noise peaks are seeds at the shipped snr of 1.0, so
   861	    // `order` was reserved at P/4 and grew by doubling to ~2P -- count first, reserve exactly.
   862	    tp.frame_live.assign(F, 0);
   863	    const double min_apex = snr * noise;
   864	    size_t n_seed = 0;
   865	    for (size_t f = 0; f < F; ++f)
   866	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k)
   867	        if ((double)sl.inten[k] > noise) { tp.frame_live[f] = 1; if ((double)sl.inten[k] > min_apex) ++n_seed; }
   868	    tp.order.reserve(n_seed);
   869	    for (uint32_t k = 0; k < P; ++k)
   870	      if ((double)sl.inten[k] > noise && (double)sl.inten[k] > min_apex) tp.order.push_back(k);
   871	    // OpenMS: stable_sort ascending by intensity, then iterate in reverse -> among equal
   872	    // intensities the LATER peak seeds first.
   873	    sort(tp.order.begin(), tp.order.end(), [&](uint32_t a, uint32_t b) {
   874	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   875	      return a > b;
   876	    });
   877	    return tp;
   878	  }
