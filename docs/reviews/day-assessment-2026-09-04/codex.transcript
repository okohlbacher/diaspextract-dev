  4088	  1457	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  4089	  1458	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  4090	  1457	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  4091	  1458	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  4092	  1459	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  4093	  1460	  template <class Emit>
  4094	  1461	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  4095	  1462	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  4096	  1463	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
