  1050	   660	  ///
  1051	   661	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
  1052	   662	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
  1053	   663	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
  1054	   664	  {
  1055	   665	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
  1056	   666	    const int n = (int)in.size();
  1057	   667	    out = in;
  1058	   668	    if (n < 3 || levels <= 0) return;
  1059	   669	    vector<double> tmp(n);
  1060	   670	    for (int j = 1; j <= levels; ++j)
  1061	   671	    {
  1062	   672	      const int step = 1 << (j - 1);
  1063	   673	      for (int i = 0; i < n; ++i)
  1064	   674	      {
  1065	   675	        double acc = 0.0;
  1066	   676	        for (int k = -2; k <= 2; ++k)
  1067	   677	        {
  1068	   678	          int idx = i + k * step;
  1069	   679	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
  1070	   680	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
  1071	   681	          if (idx < 0) idx = -idx;
  1072	   682	          if (idx >= n) idx = 2 * (n - 1) - idx;
  1073	   683	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
  1074	   684	          acc += H[k + 2] * out[idx];
  1075	   685	        }
  1076	   686	        tmp[i] = acc;
  1077	   687	      }
  1078	   688	      out.swap(tmp);
  1079	   689	    }
  1080	   690	  }
  1081	   691	
  1082	   692	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
  1083	   693	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
  1084	   694	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
  1085	   695	  /// physical widths on different traces.
  1086	   696	  int atrousLevels(const vector<pair<double, double>>& xic, double scale_sec)
  1087	   697	  {
  1088	   698	    if (xic.size() < 5 || scale_sec <= 0.0) return 0;
  1089	   699	    vector<double> d;
  1090	   700	    d.reserve(xic.size() - 1);
  1091	   701	    for (size_t i = 1; i < xic.size(); ++i)
  1092	   702	    {
  1093	   703	      const double g = xic[i].first - xic[i - 1].first;
  1094	   704	      if (g > 0) d.push_back(g);
  1095	   705	    }
  1096	   706	    if (d.empty()) return 0;
  1097	   707	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
  1098	   708	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
  1099	   709	    if (dt <= 0.0) return 0;
  1100	   710	    const double want = scale_sec / dt;                // desired support, in SAMPLES
  1101	   711	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
  1102	   712	    const int j = (int)std::lround(std::log2(want));
  1103	   713	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
  1104	   714	  }
