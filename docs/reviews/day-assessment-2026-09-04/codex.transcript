  1451	   419	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
  1452	   420	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
  1453	   421	  {
  1454	   422	    CompactFrame f;
  1455	   423	    f.rt = s.getRT();
  1456	   424	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
  1457	   425	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
  1458	   426	    const Size n = s.size();
  1459	   427	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
  1460	   428	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
  1461	   429	    for (Size i = 0; i < n; ++i)
  1462	   430	    {
  1463	   431	      const double mz = s[i].getMZ();
  1464	   432	      const double imv = (double)im[i];
