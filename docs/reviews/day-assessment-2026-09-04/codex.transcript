  4113	  1480	        raw_i.resize(p_xic.size());
  4114	  1481	        for (size_t i = 0; i < p_xic.size(); ++i) raw_i[i] = p_xic[i].second;
  4115	  1482	        atrousSmooth(raw_i, lv, sm_i);
  4116	  1483	        p_int = &sm_i;
  4117	  1484	      }
  4118	  1485	    }
  4119	  1486	    vector<int> touched;
  4120	  1487	    touched.reserve(p_xic.size());
  4121	  1488	    for (size_t pi = 0; pi < p_xic.size(); ++pi)
  4122	  1489	    {
  4123	  1490	      const auto& p = p_xic[pi];
  4124	  1491	      const double pval = p_int ? (*p_int)[pi] : p.second;
  4125	  1492	      auto it = lower_bound(fg.rt.begin(), fg.rt.end(), p.first);
  4126	  1493	      int gi = -1; double bd = delta_rt;
  4127	  1494	      for (auto c : {it == fg.rt.begin() ? it : prev(it), it})
  4128	  1495	      {
  4129	  1496	        if (c == fg.rt.end()) continue;
  4130	  1497	        double d = fabs(*c - p.first);
