  1569	   716	  /// Build the per-window FragGrid from IM-sorted fragment traces.
  1570	   717	  FragGrid buildFragGrid(const vector<Trace>& frags)
  1571	   718	  {
  1572	   719	    FragGrid g;
  1573	   720	    // union of all fragment RTs -> the common grid
  1574	   721	    for (const auto& f : frags) for (const auto& p : f.xic) g.rt.push_back(p.first);
  1575	   722	    sort(g.rt.begin(), g.rt.end());
  1576	   723	    g.rt.erase(unique(g.rt.begin(), g.rt.end()), g.rt.end());
  1577	   724	    const double G = (double)g.rt.size();
  1578	   725	    g.mean.resize(frags.size());
  1579	   726	    g.invnorm.resize(frags.size());
  1580	   727	    g.off.resize(frags.size() + 1, 0);
  1581	   728	    size_t total = 0;
  1582	   729	    for (const auto& f : frags) total += f.xic.size();
  1583	   730	    g.flat.reserve(total);
  1584	   731	    for (size_t i = 0; i < frags.size(); ++i)
  1585	   732	    {
  1586	   733	      double sum = 0, sumsq = 0;
  1587	   734	      g.off[i] = (uint32_t)g.flat.size();
  1588	   735	      for (const auto& p : frags[i].xic)
  1589	   736	      {
  1590	   737	        int gi = (int)(lower_bound(g.rt.begin(), g.rt.end(), p.first) - g.rt.begin());
  1591	   738	        g.flat.emplace_back(gi, (float)p.second);
  1592	   739	        sum += p.second; sumsq += p.second * p.second;
  1593	   740	      }
  1594	   741	      g.mean[i] = sum / G;
  1595	   742	      double var = sumsq - G * g.mean[i] * g.mean[i];
  1596	   743	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0; // 0 => constant/degenerate -> never correlates
  1597	   744	    }
  1598	   745	    g.off[frags.size()] = (uint32_t)g.flat.size();   // CSR sentinel
  1599	   746	    return g;
  1600	   747	  }
  1601	   748	}
