  1106	   716	  /// Build the per-window FragGrid from IM-sorted fragment traces.
  1107	   717	  /// Resample every fragment XIC onto one common RT grid, as CSR. Takes `frags` by reference and
  1108	   718	  /// CONSUMES each XIC as it is copied: the XIC vectors and the grid would otherwise be live at the
  1109	   719	  /// same time, and their coexistence is what sets the per-window memory peak.
  1110	   720	  FragGrid buildFragGrid(vector<Trace>& frags)
  1111	   721	  {
  1112	   722	    FragGrid g;
  1113	   723	    // The grid is the set of DISTINCT fragment RTs, and there is one per frame in this window --
  1114	   724	    // roughly 1,400 values. Collecting all ~10^8 individual points and sorting them cost a ~700 MB
  1115	   725	    // temporary and an 10^8-element sort per window, to produce those 1,400 values. Grow a sorted
  1116	   726	    // vector by insertion instead: the same set exactly, no temporary, and no large sort.
  1117	   727	    for (const auto& f : frags)
  1118	   728	      for (const auto& p : f.xic)
  1119	   729	      {
