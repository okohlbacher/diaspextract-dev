  4098	  1465	  {
  4099	  1466	    const double G = (double)fg.rt.size();
  4100	  1467	    const vector<pair<double, double>>& p_xic = ms1_traces[pc.trace_idx].xic;
  4101	  1468	    // [wavelet] Correlate against a SMOOTHED precursor profile, as the reference implementation does. Only the
  4102	  1469	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  4103	  1470	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  4104	  1471	    // (the reference implementation smooths only the precursor side), and emitted peak intensities are unaffected
  4105	  1472	    // because they come from the fragment traces, not from here.
  4106	  1473	    const vector<double>* p_int = nullptr;
  4107	  1474	    if (wl_scale_ > 0.0)
  4108	  1475	    {
  4109	  1476	      const int lv = atrousLevels(p_xic, wl_scale_);
  4110	  1477	      if (lv > 0)
  4111	  1478	      {
