    14	  set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
    15	endif()
    16	
    17	find_package(OpenMS REQUIRED)
    18	find_package(OpenMP)
    19	
    20	add_executable(DIAPseudoSpectra src/DIAPseudoSpectra.cpp)
    21	target_link_libraries(DIAPseudoSpectra PRIVATE OpenMS)
    22	
    23	if(OpenMP_CXX_FOUND)
    24	  # The window/band loop is OpenMP-parallel; without it the tool still builds and runs,
    25	  # but serially -- and the memory-admission logic degrades to one window at a time.
    26	  target_link_libraries(DIAPseudoSpectra PRIVATE OpenMP::OpenMP_CXX)
    27	else()
    28	  message(WARNING "OpenMP not found: DIAPseudoSpectra will run single-threaded.")
    29	endif()
    30	
    31	install(TARGETS DIAPseudoSpectra RUNTIME DESTINATION bin)
    32	
    33	# Optional streaming .mzpeak input through the mzPeak C++ library (github.com/OpenMS/mzpeak).
    34	# -DMZPEAK_ROOT=<checkout with include/ and a built libmzpeak in build*/>. Without it the tool
