  1834	  1449	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  1835	  1450	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  1836	  1451	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
