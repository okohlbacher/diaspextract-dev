  1932	  1547	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1933	  1548	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  1934	  1549	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  1935	  1550	          double pm = psum / n, fm = fsum / n;
