  1500	   468	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
  1501	   469	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
  1502	   470	  PeakMap materializeWindow(vector<CompactFrame>& frames)
  1503	   471	  {
  1504	   472	    PeakMap m;
  1505	   473	    m.reserve(frames.size());
  1506	   474	    for (auto& f : frames)
  1507	   475	    {
  1508	   476	      MSSpectrum s;
  1509	   477	      s.setRT(f.rt);
