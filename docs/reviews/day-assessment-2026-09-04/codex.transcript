  1477	   445	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
  1478	   446	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACTOR_DET=1.
  1479	   447	  static uint64_t detDigest_(vector<uint64_t> bits)
  1480	   448	  {
  1481	   449	    std::sort(bits.begin(), bits.end());
