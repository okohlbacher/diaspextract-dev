  1087	          const uint32_t bin = wst.bins.empty() ? 0u : wst.bins[t.off + k];
  1088	          pt.setMZ(ax.ok && bin ? ax.mzOf(bin, wst.b[t.frame0 + k]) : t.mz);
  1089	          pk.push_back(pt);
  1090	        }
  1091	        MassTrace mt(pk);
  1092	        mt.setCentroidIM(t.im);
  1093	        mts.push_back(std::move(mt));
  1094	      }
  1095	      MemGuard g_in(MEM_EPD_LIST, mt_in_bytes);               // input MassTraces, alive across the split
  1096	      vector<MassTrace> split = splitValleys(mts, split_valleys);
  1097	      long long mt_out_bytes = 0;
  1098	      for (const auto& m : split) mt_out_bytes += (long long)m.getSize() * (long long)sizeof(Peak2D) + (long long)sizeof(MassTrace);
  1099	      MemGuard g_out(MEM_EPD_MT, mt_out_bytes);               // split MassTraces, coexisting with the input
  1100	      vector<Trace>& out = parts[ci];
  1101	      out.reserve(split.size());
  1102	      // Each child carries its own measured m/z: the parent's per-frame bin was written into
  1103	      // every Peak2D above, so the child's APEX PEAK m/z is that bin's m/z and the bin comes back
  1104	      // by inverting the calibration -- which is what the pre-span code did.
  1105	      //
  1106	      // The first version of this walked the parent list to look the bin up by frame. That was
  1107	      // wrong: parents within a chunk are in IM/m-z order, not frame order, and their frame ranges
  1108	      // overlap freely, so the walk could attribute a child to the wrong parent and hand it another
  1109	      // trace's bin. It cost 3.3% of peptides on dataset D while the OpenMS arm stayed digest-identical,
  1110	      // which is what localised it here. [2026-09-04]
  1111	      for (const MassTrace& mt : split)
  1112	      {
  1113	        Trace c = toTrace(mt, cst);
  1114	        if (c.np() == 0) continue;
  1115	        const uint32_t cf = c.frame0 + c.apex;                 // apex frame, window-local
  1116	        c.b = wst.b.empty() ? ax.factor(0) : wst.b[cf];
  1117	        const double amz = mt.getSize() ? mt[mt.findMaxByIntPeak(false)].getMZ() : c.mz;
  1118	        c.tof = ax.ok ? ax.tofOf(amz, c.b) : 0u;
  1119	        out.push_back(std::move(c));
  1120	      }
  1121	    }
  1122	    // the parents' spans are dead: rebuild the window arena from the chunk arenas
  1123	    vector<Trace>().swap(in);
  1124	    vector<float>().swap(wst.inten); vector<uint32_t>().swap(wst.bins);
  1125	    size_t tot = 0; for (const auto& v : parts) tot += v.size();
  1126	    vector<Trace> out; out.reserve(tot);
  1127	    for (int ci = 0; ci < nchunk; ++ci)
  1128	    {
  1129	      const uint32_t base = wst.absorb(stores[ci]);
  1130	      for (auto& t : parts[ci]) { t.off += base; out.push_back(std::move(t)); }
  1131	      vector<Trace>().swap(parts[ci]);
  1132	    }
  1133	    return out;
  1134	  }
