  2294	  /// [wavelet] Assertions on the SHIPPED a-trous smoother. Each check corresponds to a way the
  2295	  /// transform could be wrong while still "looking smoothed" in a plot.
  2296	  ExitCodes selftestWavelet_()
  2297	  {
  2298	    int fail = 0;
  2299	    auto chk = [&](bool ok, const char* what) {
  2300	      if (!ok) { writeLogError_(String("FAIL: ") + what); ++fail; }
  2301	      else writeLogInfo_(String("  ok  ") + what);
  2302	    };
  2303	
  2304	    // 1. DC preservation. The B3 taps must sum to exactly 1: if they do not, smoothing RESCALES
  2305	    //    the precursor profile, and since Pearson is scale-invariant the error would be silent
  2306	    //    here but corrupt gate:coelution=logoverlap, which is NOT scale-invariant.
  2307	    {
  2308	      vector<double> flat(64, 7.5), out;
  2309	      atrousSmooth(flat, 4, out);
  2310	      double worst = 0.0;
  2311	      for (double v : out) worst = std::max(worst, fabs(v - 7.5));
  2312	      chk(worst < 1e-9, "DC preserved (constant signal unchanged)");
  2313	    }
  2314	
  2315	    // 2. Noise reduction, and 3. peak retention -- the two must hold TOGETHER, else "smoothing"
  2316	    //    is either a no-op or a peak destroyer. Deterministic pseudo-noise (no RNG dependence).
  2317	    {
  2318	      const int n = 128;
  2319	      vector<double> sig(n), noisy(n), out;
  2320	      for (int i = 0; i < n; ++i)
  2321	      {
  2322	        const double x = (i - 64.0) / 8.0;               // Gaussian peak, sigma = 8 samples
  2323	        sig[i] = 1000.0 * std::exp(-0.5 * x * x);
  2324	        noisy[i] = sig[i] + 60.0 * std::sin(i * 2.7) * std::cos(i * 1.31);   // high-frequency
  2325	      }
  2326	      atrousSmooth(noisy, 2, out);
  2327	      double e_in = 0, e_out = 0;
  2328	      for (int i = 0; i < n; ++i) { e_in += fabs(noisy[i] - sig[i]); e_out += fabs(out[i] - sig[i]); }
  2329	      chk(e_out < 0.75 * e_in, "noise reduced (residual vs clean peak shrinks >25%)");
  2330	      chk(out[64] > 0.80 * sig[64], "peak height retained (>80% at apex)");
  2331	    }
  2332	
  2333	    // 4. Mirror edges. Zero-padding would fabricate a downslope at a truncated peak -- the same
