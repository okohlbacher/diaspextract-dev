  1421	   389	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
  1422	   390	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
  1423	   391	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
