   371	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   372	      {
   373	        fda.setName(Constants::UserParam::ION_MOBILITY);
   374	        return;
   375	      }
   376	    }
   377	  }
