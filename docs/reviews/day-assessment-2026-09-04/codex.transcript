  1079	        //  chunk-wide list that never existed, a 6 GB phantom; the MassTrace's own vector<Peak2D>
  1080	        //  is what lives for the whole chunk)
  1081	        mt_in_bytes += (long long)t.np() * (long long)sizeof(Peak2D) + (long long)sizeof(MassTrace);
  1082	        std::list<Peak2D> pk;                                  // REAL points only: EPD smooths what it is given
  1083	        for (size_t k = 0; k < t.span(); ++k)
  1084	        {
  1085	          if (!t.real(k)) continue;
