  1805	  1091	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1806	  1092	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1807	  1093	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1808	  1094	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1809	  1095	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1810	  1096	  {
  1811	  1097	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1812	  1098	    out.assign(n, 0.0);
  1813	  1099	    double term = 1.0;
  1814	  1100	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1815	  1101	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1816	  1102	    if (mx > 0) for (double& v : out) v /= mx;
  1817	  1103	  }
  1818	  1104	
