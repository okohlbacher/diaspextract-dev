  2353	      vector<pair<uint32_t, float>> pf, ps, pt;
  2354	      for (int i = 0; i < 40; ++i) pf.emplace_back((uint32_t)i, 100.0f);
  2355	      for (int i = 0; i < 40; ++i) ps.emplace_back((uint32_t)(40 + i), 100.0f);
  2356	      for (int i = 0; i < 3; ++i)  pt.emplace_back((uint32_t)i, 1.0f);
