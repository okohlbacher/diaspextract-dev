  1545	   513	  {
  1546	   514	  public:
  1547	   515	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
  1548	   516	                        PeakMap& ms1, CompactStats& stats,
  1549	   517	                        std::function<pair<int, int>(double, double)> keyfn)
  1550	   518	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
  1551	   519	
  1552	   520	    size_t frames_seen = 0;
  1553	   700	    d.reserve(xic.size() - 1);
  1554	   701	    for (size_t i = 1; i < xic.size(); ++i)
  1555	   702	    {
  1556	   703	      const double g = xic[i].first - xic[i - 1].first;
  1557	   704	      if (g > 0) d.push_back(g);
  1558	   705	    }
  1559	   706	    if (d.empty()) return 0;
  1560	   707	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
  1561	   708	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
  1562	   709	    if (dt <= 0.0) return 0;
  1563	   710	    const double want = scale_sec / dt;                // desired support, in SAMPLES
  1564	   711	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
  1565	   712	    const int j = (int)std::lround(std::log2(want));
  1566	   713	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
  1567	   714	  }
