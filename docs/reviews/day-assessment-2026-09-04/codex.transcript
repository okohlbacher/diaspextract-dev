  4043	  1412	  }
  4044	  1413	
  4045	  1414	  /// [route-4] Collapse precursor hypotheses that are the SAME species (same charge, m/z within ppm,
  4046	  1415	  /// co-eluting in RT, co-located in IM). Measured redundancy is 4.6 identified spectra per unique
  4047	  1416	  /// peptide vs the reference implementation's 1.46, so duplicates cost spectra, RAM and FDR budget without adding
  4048	  1417	  /// peptides. Keeps the most intense representative. Deterministic (total-order sort).
  4049	  1418	  static size_t dedupPrecursors_(vector<Precursor_>& pcs, const vector<Trace>& ms1,
  4050	  1419	                                 double mass_ppm, double rt_tol, double im_tol)
  4051	  1420	  {
  4052	  1421	    if (pcs.empty()) return 0;
  4053	  1422	    vector<size_t> idx(pcs.size());
  4054	  1423	    for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  4055	  1424	    sort(idx.begin(), idx.end(), [&](size_t a, size_t b) {
  4056	  1425	      if (pcs[a].charge != pcs[b].charge) return pcs[a].charge < pcs[b].charge;
  4057	  1426	      if (pcs[a].mono_mz != pcs[b].mono_mz) return pcs[a].mono_mz < pcs[b].mono_mz;
  4058	  1427	      if (pcs[a].rt != pcs[b].rt) return pcs[a].rt < pcs[b].rt;
  4059	  1428	      return a < b;
  4060	  1429	    });
  4061	  1430	    vector<bool> drop(pcs.size(), false);
  4062	  1431	    for (size_t a = 0; a < idx.size(); ++a)
  4063	  1432	    {
  4064	  1433	      size_t i = idx[a];
  4065	  1434	      if (drop[i]) continue;
  4066	  1435	      const double tol = pcs[i].mono_mz * mass_ppm * 1e-6;
  4067	  1436	      for (size_t b = a + 1; b < idx.size(); ++b)
  4068	  1437	      {
  4069	  1438	        size_t j = idx[b];
  4070	  1439	        if (pcs[j].charge != pcs[i].charge) break;
  4071	  1440	        if (pcs[j].mono_mz - pcs[i].mono_mz > tol) break;
  4072	  1441	        if (drop[j]) continue;
  4073	  1442	        if (fabs(pcs[j].rt - pcs[i].rt) <= rt_tol && fabs(pcs[j].im - pcs[i].im) <= im_tol)
  4074	  1443	        {
  4075	  1444	          if (ms1[pcs[j].trace_idx].intensity > ms1[pcs[i].trace_idx].intensity) { drop[i] = true; break; }
  4076	  1445	          drop[j] = true;
  4077	  1446	        }
  4078	  1447	      }
  4079	  1448	    }
  4080	  1449	    vector<Precursor_> keep;
  4081	  1450	    keep.reserve(pcs.size());
  4082	  1451	    size_t removed = 0;
  4083	  1452	    for (size_t i = 0; i < pcs.size(); ++i) { if (drop[i]) ++removed; else keep.push_back(pcs[i]); }
  4084	  1453	    pcs.swap(keep);
  4085	  1454	    return removed;
  4086	  1455	  }
