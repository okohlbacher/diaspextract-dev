   211	  /// THE RT AXIS IS GLOBAL AND DISCRETE. Every acquired frame has one retention time, and every
   212	  /// point of every mass trace sits on one of those frames -- so an RT value never needs to be
   213	  /// stored per point. It used to be: `vector<pair<double,double>>` cost 16 B per point and
   214	  /// duplicated the same ~33,000 values across hundreds of millions of points, and aligning two
   215	  /// profiles meant a binary search per point because the values had to be compared numerically.
   216	  /// Here the axis is stored ONCE, a point is (frame index, intensity) at 8 B, and alignment is
   217	  /// integer equality. Built once after loading, read-only thereafter.
   218	  inline vector<double>& rtAxis() { static vector<double> v; return v; }
   219	
   220	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   221	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   222	  inline uint32_t rtIndex(double rt)
   223	  {
   224	    const vector<double>& a = rtAxis();
   225	    if (a.empty()) return 0;
   226	    auto it = lower_bound(a.begin(), a.end(), rt);
   227	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   228	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   229	    return (uint32_t)(it - a.begin());
   230	  }
   231	
   232	  struct Trace
   233	  {
   234	    double mz = 0.0;
   235	    double rt = 0.0;   ///< apex/centroid RT
   236	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   237	    double intensity = 0.0;
   238	    /// The flight-time bin this trace was measured on, and the calibration factor of its apex
   239	    /// frame. The pair is the AUTHORITATIVE m/z: `mz` below is a cached convenience for the gates
   240	    /// that still compare in m/z space, and the value actually written out is recomputed from these
   241	    /// two at export. 0 means the trace came from the OpenMS detector, which has no bin.
   242	    uint32_t tof = 0;
   243	    double   b = 0.0;
   244	    /// THE PROFILE IS A SPAN, NOT A POINT LIST. A trace is contiguous in its window's frame
   245	    /// sequence (with gaps the detector tolerates), so it needs an entry frame and its
   246	    /// intensities -- not a frame per point and not a bin per point, which is what the three
   247	    /// parallel vectors this replaces stored (12 B/point + 3 mallocs/trace, measured 35.6 GB).
   248	    /// The intensities live in the owning TraceStore's arena at [off, off+len); ZERO MEANS
   249	    /// MISSING, which is valid because every observed intensity is > noise_threshold >= 0.
   250	    /// Every consumer walks REAL points in frame order (skipping zeros), so the floating-point
   251	    /// sums are visited in the same order as before: the change is pure representation.
   252	    /// `frame0` is LOCAL to the store's frame table (a window's, or the MS1 map's) -- a
   253	    /// window's consecutive frames are ~13 apart on the global RT axis, so a global entry
   254	    /// frame would not be contiguous. See docs/TRACE-STRUCT-REDESIGN.md, revision 2.
   255	    const struct TraceStore* st = nullptr;   ///< set once the store is immutable (after merges)
   256	    uint32_t frame0 = 0;   ///< first frame of the span, store-local
   257	    uint32_t off = 0;      ///< offset of the span in the store's arena
   258	    uint16_t len = 0;      ///< frames spanned (a gradient is ~1,400; asserted < 65536)
   259	    uint16_t npts = 0;     ///< REAL points in the span
   260	    uint16_t apex = 0;     ///< position of the apex within the span
   261	    size_t np() const { return npts; }
   262	    size_t span() const { return len; }
   263	    float  xv(size_t k) const;                       ///< intensity at span position k (0 = missing)
   264	    bool   real(size_t k) const { return xv(k) > 0.0f; }
   265	    uint32_t gframe(size_t k) const;                 ///< global RT-axis index of span position k
   266	    double rtAtSpan(size_t k) const { return rtAxis()[gframe(k)]; }
   267	    void freeProfile() { len = 0; npts = 0; }        ///< the arena is the store's; nothing to free
   268	  };
   269	
   270	  /// The frame table and the arenas that a set of traces point into: one per window, one for the
   271	  /// MS1 map. `rt_index`/`b` are per FRAME (store-local index); `inten` holds every trace's span
   272	  /// back to back (zero = missing); `bins` holds the per-frame flight-time bin for the integer
   273	  /// path only and is freed once valley splitting has assigned each child its apex bin.
   274	  struct TraceStore
   275	  {
   276	    vector<uint32_t> rt_index;   ///< frame -> global RT axis
   277	    vector<double>   b;          ///< frame -> calibration factor (empty on the OpenMS path)
   278	    vector<double>   frame_rt;   ///< frame -> RT value, for toTrace()'s frame lookup
   279	    vector<float>    inten;      ///< arena of spans
   280	    vector<uint32_t> bins;       ///< arena of per-frame bins (integer path, until EPD)
   281	    size_t frames() const { return rt_index.size(); }
   282	    void setFrames(const vector<uint32_t>& ri, const vector<double>* bb)
   283	    {
   284	      rt_index = ri; if (bb) b = *bb; else b.clear();
   285	      frame_rt.resize(ri.size());
   286	      for (size_t f = 0; f < ri.size(); ++f) frame_rt[f] = rtAxis()[ri[f]];
   287	    }
   288	    /// Store-local frame of an RT value (exact by construction; nearest guards a last-ulp slip).
   289	    uint32_t frameOf(double rt) const
   290	    {
   291	      auto it = lower_bound(frame_rt.begin(), frame_rt.end(), rt);
   292	      if (it == frame_rt.end()) return (uint32_t)(frame_rt.size() - 1);
   293	      if (it != frame_rt.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   294	      return (uint32_t)(it - frame_rt.begin());
   295	    }
   296	    /// Append `other`'s arenas and return the offset they now start at (for rebasing).
   297	    uint32_t absorb(TraceStore& other)
   298	    {
   299	      const size_t base = inten.size();
   300	      if (base + other.inten.size() >= (size_t)std::numeric_limits<uint32_t>::max())
   301	        throw OpenMS::Exception::OutOfRange(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION);
   302	      inten.insert(inten.end(), other.inten.begin(), other.inten.end());
   303	      if (!other.bins.empty()) { bins.resize(base, 0u); bins.insert(bins.end(), other.bins.begin(), other.bins.end()); }
   304	      vector<float>().swap(other.inten); vector<uint32_t>().swap(other.bins);
   305	      return (uint32_t)base;
   306	    }
   307	  };
   308	  inline float    Trace::xv(size_t k) const { return st->inten[off + k]; }
   309	  inline uint32_t Trace::gframe(size_t k) const { return st->rt_index[frame0 + k]; }
   310	
   311	  /// The real points of a trace, packed in frame order, for the consumers that were written over
   312	  /// point lists (smoother, FWHM): identical sequences, so identical arithmetic.
   313	  inline void packReal(const Trace& t, vector<double>& rt, vector<double>& v)
   314	  {
   315	    rt.clear(); v.clear();
   316	    for (size_t k = 0; k < t.span(); ++k)
   317	      if (t.real(k)) { rt.push_back(t.rtAtSpan(k)); v.push_back((double)t.xv(k)); }
   318	  }
   319	
   320	  /// Build a span from (store-local frame, intensity) points into `store`, returning the trace
   321	  /// with `st` UNSET: the caller sets it once the store is immutable. Points may arrive unsorted.
   322	  inline Trace makeSpan(vector<pair<uint32_t, float>>& pts, TraceStore& store)
   323	  {
   324	    Trace t;
   325	    if (pts.empty()) return t;
   326	    sort(pts.begin(), pts.end());
   327	    const uint32_t f0 = pts.front().first, f1 = pts.back().first;
   328	    const size_t L = (size_t)f1 - f0 + 1;
   329	    if (L >= 65536) throw OpenMS::Exception::OutOfRange(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION);
   330	    t.frame0 = f0; t.len = (uint16_t)L; t.off = (uint32_t)store.inten.size();
   331	    store.inten.resize(store.inten.size() + L, 0.0f);
   332	    float best = -1.0f; uint16_t np = 0;
   333	    for (const auto& q : pts)
   334	    {
   335	      const size_t k = q.first - f0;
   336	      if (store.inten[t.off + k] == 0.0f) ++np;      // one point per frame; a repeat overwrites
   337	      store.inten[t.off + k] = q.second;
   338	      if (q.second > best) { best = q.second; t.apex = (uint16_t)k; }
   339	    }
   340	    t.npts = np;
   341	    return t;
   342	  }
