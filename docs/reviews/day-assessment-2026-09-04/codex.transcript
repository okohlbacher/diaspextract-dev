  1442	   410	    /// merge per-frame stats after a parallel batch [perf-load]
  1443	   411	    CompactStats& operator+=(const CompactStats& o)
  1444	   412	    {
  1445	   413	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
  1446	   414	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
  1447	   415	      return *this;
  1448	   416	    }
  1449	   417	  };
