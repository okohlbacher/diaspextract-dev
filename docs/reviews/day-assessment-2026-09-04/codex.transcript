  4149	  1516	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  4150	  1517	      long long n_rtpass = 0;
  4151	  1518	      stat_slice_ += (long long)(hi - lo); ++stat_prec_;
  4152	  1519	      for (size_t fi = lo; fi < hi; ++fi)
  4153	  1520	      {
  4154	  1521	        const Trace& f = frag_traces[fi];
  4155	  1522	        if (fabs(f.rt - pc.rt) > delta_rt) continue;                   // RT gate
  4156	  1523	        ++n_rtpass;
  4157	  1524	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  4158	  1525	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  4159	  1526	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  4160	  1527	        // "fragments" (unfragmented survivors). SPEXTRACTOR_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  4161	  1528	        if (drop_prec_iso_ && pc.charge > 0)
