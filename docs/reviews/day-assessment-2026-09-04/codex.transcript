  1811	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1812	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1813	  /// coincidental peak at the right m/z spacing usually does not.
  1814	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1815	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1816	  static double xicCorr(const Trace& a, const Trace& b, double /*rt_tol*/)
  1817	  {
  1818	    // both are MS1 traces on the same frame table: the shared frames are the overlap of the two
  1819	    // spans, and a frame counts only where BOTH have a real point -- the old index intersection
  1820	    double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1821	    const uint32_t lo = std::max(a.frame0, b.frame0);
  1822	    const uint32_t hi = std::min(a.frame0 + a.len, b.frame0 + b.len);
  1823	    for (uint32_t f = lo; f < hi; ++f)
  1824	    {
  1825	      const double x = a.xv(f - a.frame0), y = b.xv(f - b.frame0);
  1826	      if (x > 0.0 && y > 0.0) { sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; }
  1827	    }
  1828	    if (m < 3) return -2.0;
  1829	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1830	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1831	  }
