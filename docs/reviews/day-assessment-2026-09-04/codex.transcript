  1739	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1740	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1741	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1742	    // determinism bug, now fixed.
  1743	    if (split_valleys > 0.0 && mts.size() > 1)
  1744	    {
  1745	      const int nthreads = std::max(1, bands);
  1746	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1747	      const size_t n_in = mts.size();
  1748	      vector<vector<MassTrace>> parts(nchunk);
  1749	      #pragma omp taskloop grainsize(1) default(shared)
  1750	      for (int ci = 0; ci < nchunk; ++ci)
  1751	      {
  1752	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1753	        if (lo >= hi) continue;
  1754	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1755	                                std::make_move_iterator(mts.begin() + hi));
  1756	        parts[ci] = do_split(chunk);
  1757	      }
  1758	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1759	      vector<MassTrace> out; out.reserve(tot);
  1760	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1761	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1762	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1763	      mts.swap(out);
  1764	    }
  1765	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1766	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1767	    if (!mts.empty())
  1768	    {
  1769	      vector<double> spans;
  1770	      spans.reserve(mts.size());
  1771	      for (const auto& mt : mts)
  1772	      {
  1773	        double lo = 1e30, hi = -1e30;
  1774	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1775	        spans.push_back(hi - lo);
  1776	      }
  1777	      sort(spans.begin(), spans.end());
  1778	      size_t n = spans.size();
  1779	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1780	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1781	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1782	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1783	    }
  1784	    vector<Trace> out;
  1785	    out.reserve(mts.size());
  1786	    for (const auto& mt : mts) out.push_back(toTrace(mt, store));
  1787	    return out;
  1788	  }
  1789	
  1790	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1791	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1792	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1793	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1794	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1795	  {
  1796	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1797	    out.assign(n, 0.0);
  1798	    double term = 1.0;
  1799	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1800	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1801	    if (mx > 0) for (double& v : out) v /= mx;
  1802	  }
  1803	
