+    bool integer_detector = (getStringOption_("trace:detector") == "integer");
     String why = "not attempted";
     if (integer_detector && !tofAxis().ok)
     {
@@ -3125,13 +3125,16 @@ registerIntOption_("trace:frame_aggregation_ms1_n", "<n>", 1, "[cross-frame] Sam
     }
     if (integer_detector && !tofAxis().ok)
