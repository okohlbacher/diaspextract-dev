   815	    registerDoubleOption_("trace:ms2_split_valleys", "<chrom_fwhm>", 7.0, "[way-2] Split MS2 mass traces at chromatographic local minima via ElutionPeakDetection (which MassTraceDetection never does - it only terminates on outliers, so two peptides 25 s apart within the m/z tolerance MERGE). Value is chrom_fwhm in seconds; it sets both the Savitzky-Golay window and the local-extrema half-window. 0 = OFF. Try 6-8 (peaks here are 5-30 s). width_filtering is forced off so this only SPLITS, never deletes.", false);
   816	    registerFlag_("diag:selftest_wavelet", "[wavelet] Run assertions on the a-trous smoother and exit. Tests the SHIPPED functions, not a copy: DC preservation (filter must sum to 1, or every correlation is rescaled), noise reduction, peak-height retention at the FWHM-derived scale, mirror edges (a truncated peak must not be dragged toward zero), and level selection from sampling. Exits non-zero on failure.", true);
   817	    registerDoubleOption_("trace:wavelet_smooth", "<x>", 0.0, "[wavelet] Smooth the PRECURSOR XIC with a stationary (a-trous) B3-spline wavelet before correlating fragments against it, at a scale of x TIMES THE MEASURED MS1 FWHM. diaTracer smooths its precursor profile (2D Gaussian + Savitzky-Golay) and then applies a 0.3 correlation threshold; we copied the 0.3 but not the smoothing. Pearson r between two NOISY profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker constraint than a smoothed 0.3 -- and worst at faint precursors, which is where the coverage analysis says peptides are lost. Fragment XICs stay RAW (as in diaTracer) and emitted peak intensities are unaffected. 0 = off. Try 0.25-0.5 (measured MS1 FWHM is 3.61 s on S30, so 0.5 ~ 1.8 s ~ 1.3 cycles).", false);
   818	    registerDoubleOption_("trace:split_valleys_fwhm", "<x>", 0.0, "[fwhm] Set the valley-splitting window as a MULTIPLE OF THE MEASURED MS1 FWHM instead of absolute seconds. Overrides trace:ms2_split_valleys when > 0 (the MS2 window is the one it sets). Absolute seconds cannot be right across methods: 14.0 s is +0.0% peptides on a 31 min gradient and -1.06% on a 5.6 min one. Measured MS1 FWHM is 3.61 s on S30, so the old 7.0 s default is ~1.9x FWHM and 14.0 s is ~3.9x. 0 = off (use absolute seconds).", false);
   819	    registerDoubleOption_("trace:ms1_split_valleys", "<chrom_fwhm>", 7.0, "Split MS1 mass traces at chromatographic valleys via ElutionPeakDetection. DEFAULT 7.0 s: MassTraceDetection never splits at a local minimum, so two peptides eluting ~25 s apart within the m/z tolerance merge into ONE multi-modal trace, producing a merged precursor with the wrong monoisotope and charge. Measured +36.7% peptides on S23 and +37.4% on S08 at peptide-level FDR. Costs ~1.7x wall time and ~25% peak RAM. 0 = off.", false);
   820	    registerDoubleOption_("trace:max_trace_length_sec", "<sec>", -1.0, "DANGER - NOT a guard. MassTraceDetection::isTraceValid_ RETURNS FALSE on over-length traces and peaks are marked visited only for VALID traces, so an over-length blob is rejected, re-seeded by the next apex, and rejected again - emitting NOTHING at that m/z. Setting this DELETES signal (the falsified direction). Kept only for diagnostics; leave at -1. Splitting requires ElutionPeakDetection, not this. [merged-trace]", false, true);
   821	registerIntOption_("trace:frame_aggregation_ms1_n", "<n>", 1, "[cross-frame] Same as frame_aggregation_n but for the MS1 (PRECURSOR) map. This is the one that can add DEPTH: measurement shows we identify MORE spectra than diaTracer (3.7%% vs 2.0%% of spectra) but cover FEWER distinct peptides (4.6 vs 1.46 PSMs/peptide), i.e. we miss low-abundance PRECURSORS. Aggregating MS2 alone cannot fix that. 1 = off.", false);
   822	    registerIntOption_("trace:frame_aggregation_n", "<n>", 1, "[cross-frame] Number of ADJACENT RT frames (= adjacent diaPASEF CYCLES, since each isolation window is sampled once per cycle) summed into a composite (m/z x 1/K0) frame BEFORE MS2 peak/trace detection, diaTracer-style. 1 = off (current behaviour). 5 = user request. Sliding window, stride 1, so the RT axis and point count are preserved; note adjacent output points then share input frames and are AUTOCORRELATED, which inflates Pearson r - benchmark, do not assume.", false);
   823	    registerDoubleOption_("trace:ms2_min_sample_rate", "<r>", -1.0, "MS2 min fraction of visited scans that must contain a peak (MassTraceDetection min_sample_rate). OpenMS default 0.5 hard-deletes gappy fragment traces; MEASURED: 0.3 and 0.1 both LOSE peptides (8,865 -> 8,735 at 0.3), so -1 (= OpenMS 0.5) is the default. Lowering it produces longer, more-merged traces with wrong apexes.", false);
   824	    registerDoubleOption_("trace:ms1_min_sample_rate", "<r>", -1.0, "MS1 min_sample_rate. -1 = OpenMS default 0.5 (strict, MS1 stays strict).", false, true);
   825	
   826	    // NB: "threads" is reserved by TOPPBase (the standard -threads option), so this lives under "perf".
   827	    // [route-1] feature-level consolidation: collapse spectra that are the SAME chromatographic
   828	    // feature emitted more than once (RT slices / IM sub-ranges / charge hypotheses). Targets the
   829	    // measured 4.6 vs 1.46 PSMs-per-peptide gap. OFF by default (delta_rt 0) - it is a deletion.
   830	    registerTOPPSubsection_("consolidate", "Feature-level de-duplication of emitted spectra");
   831	    registerTOPPSubsection_("merge", "Recombine split spectra (union, not selection)");
   832	    registerDoubleOption_("merge:rt_window", "<sec>", 0.0, "FALSIFIED on S30 (every merge/collapse variant lost peptides) -- keep 0 = OFF. [merge] Merge spectra sharing a precursor identity within this RT window into ONE spectrum by UNION of peaks; matching peaks take the MAX intensity by default (merge:sum_intensity sums instead). This is not consolidate: consolidate SELECTS the richest member and DISCARDS the rest (measured -12.7% peptides), while 41% of peaks are present in only one member. Measured MS1 FWHM is 3.61 s (2.61 cycles) and flat across the gradient, so ~3.6 s is one peak width -- the principled window. 0 = off.", false);
   833	    registerDoubleOption_("merge:mass_ppm", "<ppm>", 20.0, "[merge] Precursor m/z tolerance for deciding two spectra share an identity.", false, true);
   834	    registerDoubleOption_("merge:delta_im", "<1/K0>", 0.02, "[merge] Precursor ion-mobility tolerance.", false, true);
   835	    registerDoubleOption_("merge:mz_tol", "<Da>", 0.01, "[merge] Peak m/z tolerance when summing the union. Peaks within this of the running intensity-weighted centroid are combined.", false, true);
   836	    registerDoubleOption_("merge:min_cosine", "<x>", 0.0, "[merge] Require this normalised dot product between two spectra before merging them. Coordinate proximity is NOT the problem (the coordinate gate already admits only 1.8% different-peptide pairs); the problem is that only ~8% of emitted spectra identify at all, so a coordinate gate merges good spectra with unidentifiable ones whose peaks dilute the match. Measured reference: within-cycle pairs 0.845, same peptide across cycles 0.687, unrelated 0.007. 0 = off.", false);
   837	    registerFlag_("merge:sum_intensity", "[merge] Sum intensities of matching peaks instead of taking the MAX. Summing distorts the merged spectrum: members share only ~37% of peaks (Jaccard 0.374), so shared peaks get Nx and unique peaks 1x, wrecking the fragment intensity ratios the engine scores on. MAX takes each ion's best single observation. Off (i.e. MAX) by default.");
   838	    registerFlag_("merge:any_charge", "[merge] Also merge spectra whose precursor charges disagree. Off by default: 93.2% of split pairs already agree in charge, so merging across charges mostly pools genuinely different precursors.");
   839	    registerDoubleOption_("consolidate:delta_rt", "<sec>", 0.0, "FALSIFIED on S30 (-12.7% peptides at 5 s; every merge/collapse variant lost) -- keep 0 = OFF. Consolidate spectra whose precursors agree within this RT window (and mass_ppm/delta_im) into ONE feature, keeping the richest spectrum. Attacks emission multiplicity (ours 4.6 PSMs/peptide vs diaTracer 1.46) without changing fragment content.", false);
   840	    registerDoubleOption_("consolidate:mass_ppm", "<ppm>", 20.0, "Precursor m/z tolerance for feature consolidation.", false, true);
   841	    registerDoubleOption_("consolidate:delta_im", "<1/K0>", 0.02, "Precursor IM tolerance for feature consolidation. Set larger than the 12 m/z x 2 IM sub-range split to merge a feature emitted from BOTH IM sub-ranges.", false, true);
   842	    registerFlag_("consolidate:same_charge_only", "Only merge spectra that also agree in charge (safer; leaves genuine multi-charge observations intact).");
   843	
   844	    registerFlag_("perf:stream_load", "[stream] Read the .d frame-by-frame via BrukerTimsFile::loadDIAStreaming, peak-picking and compacting each frame on arrival, instead of loadExperiment() which holds the entire run (MEASURED 90.3 GB RSS at t=0s - that one-shot read IS the memory floor and no downstream compaction can lower it). Bruker .d only.");
   845	    registerIntOption_("trace:native_ms2_neighbors", "<n>", 0, "[stream] NATIVE cross-frame aggregation in the READER (BrukerTimsFile Config dia_ms2_n_neighbors): adjacent frames each side, 0=off, 1=3-frame sum, 2=5-frame sum. This sums RAW frames BEFORE centroiding, which is what diaTracer does; the tool-level frame_aggregation_n sums AFTER centroiding and lost 26% of peptides. Requires perf:stream_load.", false);
   846	    registerIntOption_("trace:native_ms1_neighbors", "<n>", 0, "[stream] Same, for MS1 frames (BrukerTimsFile Config ms1_n_neighbors). Requires perf:stream_load.", false);
   847	
   848	    registerTOPPSubsection_("perf", "Concurrency / memory tradeoff");
   849	    registerStringOption_("gate:coelution", "<mode>", "pearson", "[B0] Fragment-precursor co-elution statistic. 'pearson' takes variance over the FULL RT grid, so a fragment present in a handful of points is scored against ~1300 implicit zeros -- it rewards sparse fragments that spike where the precursor spikes, and its scale depends on grid size rather than evidence. 'logoverlap' is the AlphaDIA-style alternative: profile overlap in log space, summed only where the precursor has signal, normalised to [0,1]. The two are on DIFFERENT SCALES, so gate:min_correlation must be retuned when switching.", false);
   850	    setValidStrings_("gate:coelution", {"pearson", "logoverlap"});
   851	    registerFlag_("gate:variance_support", "[Q1] Compute the Pearson co-elution variance over the UNION SUPPORT of the precursor and fragment profiles (points where either is non-zero) rather than the full RT grid G (~1300). Fixes the [B0] zero-padding: a fragment present in a handful of grid points is no longer scored against ~1300 implicit zeros, and the score no longer depends on grid size. Only affects gate:coelution=pearson. Retune gate:min_correlation when enabling -- the score scale changes. [bench]");
   852	    registerIntOption_("perf:ms1_trace_bands", "<n>", 12, "[parallel] Band-parallel MS1 mass-trace detection, same exact-partition scheme as perf:trace_bands. MS1 tracing was running SINGLE-THREADED (the call simply never passed a band count) while MS2 was banded, so the MS1 phase pinned one core. That is invisible at default thresholds because MS1 is only ~4% of frames, but it makes the MS1 SENSITIVITY sweep impossible: lowering trace:noise_threshold_int / ms1_chrom_peak_snr explodes MassTraceDetection's intensity-sorted apex list, and MassTraceDetection is a SERIAL greedy loop, so runtime blows up superlinearly on one core (measured: 40 min with no progress at 1.5 of 128 cores, vs 24 min for a whole default run). 1 = off (old behaviour).", false);
   853	    registerIntOption_("perf:trace_bands", "<n>", 12, "[parallel] Split each window's fragment m/z range into N bands traced CONCURRENTLY. The diaPASEF method fixes the window count (24 here), which caps window-level parallelism far below the core count; banding lifts the ceiling to threads. Traces cannot span more than trace:mass_error_ppm in m/z, so banding with a halo is exact. 0 = auto (windows x bands >= threads), 1 = off.", false);
   854	    registerDoubleOption_("perf:mem_fraction", "<f>", 0.75, "[dyn-mem] Fraction of currently-FREE RAM (/proc/meminfo MemAvailable + our own RSS) the window loop may commit. Concurrency is re-decided at every window admission, so the run adapts to other jobs on a shared node. One window is always admitted regardless, so a single oversized window cannot deadlock.", false);
   855	    registerIntOption_("perf:max_concurrent_windows", "<n>", 0, "UPPER bound on isolation windows processed concurrently (memory admission may run fewer). Peak RAM scales with windows IN FLIGHT (each holds its frames + traces + grid), not with the total window count, so lowering this trades wall time for RAM. 0 = unlimited (use all threads).", false);
   856	
   857	    registerTOPPSubsection_("diag", "Diagnostics ('debug' is reserved by TOPP)");
   858	    registerStringOption_("diag:dump_ms1_tsv", "<prefix>", "", "[ms1-funnel] Write MS1 traces and inferred precursors to <prefix>.traces.tsv / <prefix>.precursors.tsv so precursor loss can be attributed to a stage (no trace / no hypothesis / no spectrum) rather than inferred from the final count. Empty = off.", false, true);
   859	
   860	    registerIntOption_("max_charge", "<n>", 5, "Maximum precursor charge considered during isotope inference.", false);
   861	
   862	    // NOTE: the subsection MUST be registered or printUsage_() throws ElementNotFound — which turns
   863	    // any user parameter typo into a FATAL crash instead of a usage message. [bugfix]
   864	    registerTOPPSubsection_("charge", "Isotope / charge-state inference");
   865	    registerIntOption_("charge:min_charge", "<n>", 2, "Minimum precursor charge to emit; hypotheses below it "
   866	                       "are dropped before extraction. Default 2, because tryptic peptides are essentially never singly "
   867	                       "charged in ESI: z=1 hypotheses were ~30%% of emission and ~1.7%% of identified peptides, and removing "
   868	                       "them raised peptide counts on both search engines on all three benchmark files while cutting runtime "
   869	                       "17%%. Use 1 to emit them. 3 or more removes charge 2 and most of the result. Measurements: "
   870	                       "docs/ISOTOPE-DUPLICATION-2026-09-03.md.", false);
   871	    // [route-1] Only 25.7%% of diaTracer's precursors are matched by us with the RIGHT m/z AND charge;
   872	    // 17.2%% have the wrong charge and 22.9%% (decoy-corrected) the wrong monoisotope. A wrong charge or
   873	    // mono gives a wrong NEUTRAL MASS, so the peptide can never be identified no matter how good the
   874	    // fragments are. Partner-COUNTING cannot tell a real envelope from a coincidence; averagine shape
   875	    // x isotope co-elution can.
   876	    registerStringOption_("charge:scoring", "<mode>", "count", "Charge/monoisotope inference. 'count' is the partner-count heuristic (ties favour LOW charge, break-on-first-miss) and is the DEFAULT: measured against a DIA-NN reference on S23 it gives 71.8% charge agreement vs 49.7% for 'envelope', and it eliminates the catastrophic 4->2 confusion (10,199 cases) that fabricates a ~-1198 Da phantom modification at m/z 600 in open search. 'envelope' scores each (charge, mono) hypothesis by averagine cosine x isotope co-elution and allows gapped envelopes; it was the default until 2026-07-21 and is kept for comparison. NOTE both are close to trivial: always answering z=2 scores 69.6%.", false);
   877	    setValidStrings_("charge:scoring", {"envelope", "count"});
   878	    registerDoubleOption_("charge:ambiguity_margin", "<x>", 0.0, "If a different-charge hypothesis scores within this margin of the best, emit it too (diaTracer retains multiple charges when ambiguous). 0 = single charge per precursor. ONLY EFFECTIVE with charge:scoring=envelope -- the default 'count' mode returns before this is consulted, so the value is ignored there.", false);
   879	    registerFlag_("assembly:dedup_precursors", "[route-4] Collapse precursor hypotheses that are the same species (same charge, m/z within ppm, co-eluting RT, co-located IM). Measured redundancy: 4.6 identified spectra per unique peptide vs diaTracer's 1.46.");
   880	    registerFlag_("assembly:require_isotope_support", "[emission] Drop precursor hypotheses with NO isotope partner (the 'guessed' singletons, ~40% of emission) instead of assigning them a default charge. Emission is over-GENERATION of distinct low-quality precursors, not redundancy, so merge/dedup cannot cut it (oracle: same-coordinate collapse only 1.1-1.3x); this gate can. Measured on S30 (2026-07-26): drops 603,858 of 1,528,113 spectra (-39.5%) for 78 of 10,036 peptides (-0.78%) -- guessed spectra identify at 1.30%% vs 11.39%% for supported (8.8x). The 0.78%% are low-abundance/no-envelope species (the open-search caveat), so keep this OFF by default and confirm FDR-recalibrated peptides on any run that enables it.");
   881	    registerDoubleOption_("charge:mono_averagine_guard", "<slack>", 0.0, "[mono-guard] Reject a leftward isotope step (the walk that defines the MONOISOTOPE in charge:scoring=count) when the candidate peak is too weak to be a real lighter isotope under averagine. The partner search matches m/z, RT and IM but NEVER intensity, so it can latch onto a noise peak or a co-eluting species one isotope spacing below the true monoisotope -- making the reported precursor mass ~1.00335 Da TOO LIGHT. Closed search hides this (the engine enumerates isotope_errors and corrects it for free); OPEN/blind search turns it into a phantom -1.003 Da modification, and it is our single largest open-search delta-mass artefact on S30 (8.20%% isotope-shifted PSMs vs diaTracer's 3.46%%). The bound is averagine's LOOSEST: stepping from isotope m+1 to m the lighter peak is >= (m+1)/lambda times the heavier one, minimised at m=0 -> 1/lambda (lambda = 0.000594*neutral mass), so a value of 1.0 enforces exactly that minimum and never rejects a legitimate envelope; smaller values add slack for noise. 0 = off (old behaviour). [bench]", false);
   882	    registerFlag_("charge:mono_averagine_select", "[mono-select] Choose the MONOISOTOPE by averagine envelope fit over the whole isotope run found by the charge:scoring=count walk, instead of taking the furthest-left peak reached. 'Furthest-left' is a STOPPING rule and can only trade over-reach (mono ~1.003 Da too LIGHT, a phantom -1 Da modification in open search) for under-reach (+1.003 Da) -- measured: an averagine STOPPING guard cut the -1 artefact 64%% but tripled +1, because a walk that halts early also leaves the M+1 peak unconsumed so it seeds its own too-heavy precursor. This is a SCORING decision instead: score every candidate mono position in the run by cosine against the averagine envelope and keep the best. Every found peak is still consumed, so de-isotoping and emission are unchanged -- only the reported precursor mass moves. [bench]");
   883	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). A reviewer argued 0.01 (isotopes of one species share mobility, so 0.05 can admit cross-species partners), but 0.01 has NOT been measured on S30; change only behind the S30 set gate.", false);
   884	
   885	    // Bounds, not documentation: without these a negative count wraps through `Size` (min_fragments
   886	    // -1 becomes ~1.8e19 and nothing is ever emitted) and a negative tolerance silently gates
   887	    // everything out. Both fail as an empty-but-valid result, the worst failure mode here.
   888	    // [adv-review codex/kimi 2026-09-03]
   889	    setMinInt_("assembly:min_fragments", 1);
   890	    setMinInt_("assembly:max_fragments", 1);
   891	    setMinInt_("assembly:default_charge", 0);
   892	    setMinInt_("max_charge", 1);
   893	    setMinInt_("perf:trace_bands", 0);      // 0 = auto (documented)
   894	    setMinFloat_("gate:delta_im", 0.0);
   895	    setMinFloat_("gate:delta_rt", 0.0);
   896	    setMinFloat_("gate:min_correlation", -1.0);
   897	    setMaxFloat_("gate:min_correlation", 1.0);
   898	    setMinFloat_("charge:iso_im_tolerance", 0.0);
   899	    setMinFloat_("trace:ms1_chrom_peak_snr", 0.0);
   900	    setMinFloat_("trace:ms2_chrom_peak_snr", 0.0);
   901	    setMinFloat_("trace:ms2_noise_threshold_int", 0.0);
   902	    setMinFloat_("trace:noise_threshold_int", 0.0);
   903	    setMinInt_("perf:ms1_trace_bands", 0);      // 0 = auto (documented)
   904	    setMinFloat_("perf:mem_fraction", 0.05);
   905	    setMaxFloat_("perf:mem_fraction", 0.95);
   906	    // deliberate: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
   907	  }
   908	
   909	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
   910	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
  1740	    vector<double> frag_scores;
  1741	    scoreCandidates_(pc, frag_traces, frag_im, ms1_traces, fg, delta_im, delta_rt, min_corr,
  1742	                     min_corr_pts, pdense, [&](size_t fi, double c) {
  1743	      const auto [inten, emit_inten] = weighted_(frag_traces[fi].intensity, c, frag_im[fi] - pc.im);
  1744	      frags.emplace_back(frag_traces[fi].mz, emit_inten);
  1745	      frag_scores.push_back(c * inten);
  1746	    });
  1747	    assembleFromList_(pc, win_lo, win_hi, frags, frag_scores, min_frags, max_frags, out);
  1748	  }
  1749	
  1750	  ExitCodes main_(int, const char**) override
  1751	  {
  1752	    phase_clock_();   // [perf-instr] fix the epoch HERE: it is a first-call static, and the
  1753	                      // streaming path first touched it only AFTER loading, so load time was
  1754	                      // invisible and every [t=..] was relative to post-load. [codex review]
  1755	    const String in = getStringOption_("in");
  1756	    const String out = getStringOption_("out");
  1757	    const double delta_im = getDoubleOption_("gate:delta_im");
  1758	    const double delta_rt = getDoubleOption_("gate:delta_rt");
  1759	    if (getFlag_("diag:selftest_wavelet")) return selftestWavelet_();
  1760	    log_overlap_ = (getStringOption_("gate:coelution") == "logoverlap");
  1761	    rank_by_intensity_ = (getStringOption_("assembly:rank_by") == "intensity");
  1762	    im_weight_sigma_ = getDoubleOption_("assembly:im_weight_sigma");
  1763	    mono_guard_ = getDoubleOption_("charge:mono_averagine_guard");
  1764	    mono_select_ = getFlag_("charge:mono_averagine_select");
  1765	    var_support_ = getFlag_("gate:variance_support");
  1766	    corr_power_ = getDoubleOption_("assembly:corr_power");
  1767	    const double min_corr = getDoubleOption_("gate:min_correlation");
  1768	    const int min_corr_pts = getIntOption_("gate:min_correlation_points");
  1769	    const Size min_frags = (Size)getIntOption_("assembly:min_fragments");
  1770	    const Size max_frags = (Size)getIntOption_("assembly:max_fragments");
  1771	    const int max_charge = getIntOption_("max_charge");
  1772	    mzEstimator() = getStringOption_("trace:mz_estimator");   // before any toTrace() call
  1773	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  1774	
  1775	    PeakMap exp;
  1776	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  1777	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  1778	    PeakMap ms1_map;
  1779	    map<pair<int, int>, vector<CompactFrame>> ms2_by_window;
  1780	    CompactStats cstat;
  1781	    auto winKey = [](double lo, double hi) {
  1782	      return make_pair((int)llround(lo * 100.0), (int)llround(hi * 100.0));
  1783	    };
  1784	    const bool stream_load = getFlag_("perf:stream_load");
  1785	    bool streamed = false;
  1786	
  1787	    if (stream_load)
  1788	    {
  1789	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  1790	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  1791	      BrukerTimsFile::Config cfg;
  1792	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  1793	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  1794	      PeakPickerIM spicker;
  1795	      Param sp = spicker.getParameters();
  1796	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  1797	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  1798	      if (const char* m = std::getenv("SPEXTRACT_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  1799	      spicker.setParameters(sp);
  1800	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  1801	      try
  1802	      {
  1803	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  1804	        {
  1805	#ifdef SPEXTRACT_WITH_MZPEAK
  1806	          spx::loadMzPeakStreaming(in, consumer, getIntOption_("threads"));   // consumer counts frames itself
  1807	#else
  1808	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  1809	#endif
  1810	        }
  1811	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  1812	        streamed = true;
  1813	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  1814	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  1815	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  1816	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  1817	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  1818	        if (std::getenv("SPEXTRACT_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  1819	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  1820	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  1821	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
  1822	                      + String(cfg.dia_ms2_n_neighbors) + ")" + clk_() + rss_());
  1823	      }
  1824	      catch (const Exception::BaseException& e)
  1825	      {
  1826	        writeLogWarn_(String("[stream] streaming load failed (") + e.getName()
