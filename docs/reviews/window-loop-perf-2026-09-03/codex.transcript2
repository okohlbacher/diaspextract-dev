  1981	      {
  1982	        if (t.xic.size() < 5) continue;
  1983	        size_t ap = 0;
  1984	        for (size_t i = 1; i < t.xic.size(); ++i) if (t.xic[i].second > t.xic[ap].second) ap = i;
  1985	        const double half = t.xic[ap].second * 0.5;
  1986	        if (half <= 0.0) continue;
  1987	        double lo = -1.0, hi = -1.0;
  1988	        for (size_t i = ap; i > 0; --i)
