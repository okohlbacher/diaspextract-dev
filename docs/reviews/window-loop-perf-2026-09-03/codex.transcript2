  1103	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1104	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1105	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1106	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1107	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1108	  {
  1109	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1110	    out.assign(n, 0.0);
  1111	    double term = 1.0;
  1112	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1113	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1114	    if (mx > 0) for (double& v : out) v /= mx;
  1115	  }
  1116	
  1117	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1118	  {
  1119	    double dot = 0, na = 0, nb = 0;
  1120	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1121	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1122	  }
