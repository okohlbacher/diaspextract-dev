  1565	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  1566	        }
  1567	        else if (log_overlap_)
  1568	        {
  1569	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  1570	          // the intersection by the precursor's total log-intensity alone, which made the score
  1571	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  1572	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  1573	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  1574	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  1575	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  1576	          // which is what Pearson gets right and the first version did not.
  1577	          double fsum = 0.0;
  1578	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1579	            fsum += std::log1p((double)fg.flat[k].second);
  1580	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  1581	          double inter = 0.0;
  1582	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1583	          {
  1584	            const auto& gv = fg.flat[k];
  1585	            inter += std::min(std::log1p((double)gv.second) / fsum,
  1586	                              std::log1p((double)pdense[gv.first]) / plogsum);
  1587	          }
  1588	          c = inter;
  1589	        }
  1590	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  1591	        if (c < min_corr) continue;                                    // correlation gate
  1592	        emit(fi, c);
  1593	      }
  1594	      stat_rtpass_ += n_rtpass;
  1595	    }
  1596	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  1597	  }
