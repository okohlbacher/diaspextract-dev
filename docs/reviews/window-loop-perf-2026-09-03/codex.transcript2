   978	          const double h = edge[b] * ppm * 1e-6 * 20.0;
   979	          const double lo = edge[b] - h, hi = edge[b + 1] + h;
   980	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
   981	          OpenMS::DataArrays::FloatDataArray ia;
   982	          ia.setName(Constants::UserParam::ION_MOBILITY);
   983	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
   984	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
   985	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
   986	          Size i0 = 0, i1 = s.size();
   987	          if (s.isSorted())
   988	          {
   989	            i0 = (Size)(s.MZBegin(lo) - s.begin());
   990	            i1 = (Size)(s.MZBegin(hi) - s.begin());
   991	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
   992	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
   993	          }
   994	          else
   995	            for (Size i = 0; i < s.size(); ++i)
   996	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
   997	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
   998	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); sub[b].addSpectrum(std::move(t)); }
   999	        }
  1000	      }
  1001	      map.clear(true);
  1002	      vector<vector<MassTrace>> per(bands);
  1003	      #pragma omp parallel for schedule(dynamic) num_threads(bands)
  1004	      for (int b = 0; b < bands; ++b)
  1005	      {
  1006	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
  1007	        vector<MassTrace> t;
  1008	        sub[b].sortSpectra();
  1009	        if (sub[b].size() < 3) { sub[b].clear(true); continue; }   // MTD aborts below 3 spectra
  1010	        m2.run(sub[b], t);
  1011	        sub[b].clear(true);
  1012	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
  1013	        for (auto& mt : t)
  1014	        {
  1015	          const double c = mt.getCentroidMZ();
  1016	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
  1017	        }
  1018	      }
  1019	      size_t tot = 0; for (const auto& v : per) tot += v.size();
  1020	      mts.reserve(tot);
  1021	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
  1022	    }
  1023	    else
  1024	    {
  1025	      if (map.size() >= 3) mtd.run(map, mts);   // MTD aborts below 3 spectra; a tiny input is not an error
  1026	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
  1027	    }
  1028	
  1029	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
  1030	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1031	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1032	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1033	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1034	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1035	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1036	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off S30 20:46 vs 28:40 for
  1037	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1038	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1039	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1040	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1041	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1042	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1043	    // determinism bug, now fixed.
  1044	    if (split_valleys > 0.0 && mts.size() > 1)
  1045	    {
  1046	      const int nthreads = std::max(1, bands);
  1047	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1048	      const size_t n_in = mts.size();
  1049	      vector<vector<MassTrace>> parts(nchunk);
  1050	      #pragma omp parallel for schedule(dynamic) num_threads(nthreads)
  1051	      for (int ci = 0; ci < nchunk; ++ci)
  1052	      {
  1053	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1054	        if (lo >= hi) continue;
  1055	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1056	                                std::make_move_iterator(mts.begin() + hi));
  1057	        parts[ci] = do_split(chunk);
  1058	      }
  1059	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1060	      vector<MassTrace> out; out.reserve(tot);
  1061	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1062	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1063	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1064	      mts.swap(out);
  1065	    }
  1066	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1067	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1068	    if (!mts.empty())
  1069	    {
  1070	      vector<double> spans;
  1071	      spans.reserve(mts.size());
  1072	      for (const auto& mt : mts)
  1073	      {
  1074	        double lo = 1e30, hi = -1e30;
  1075	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1076	        spans.push_back(hi - lo);
  1077	      }
  1078	      sort(spans.begin(), spans.end());
  1079	      size_t n = spans.size();
  1080	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1081	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1082	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1083	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1084	    }
  1085	    vector<Trace> out;
  1086	    out.reserve(mts.size());
  1087	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1088	    return out;
  1089	  }
  1090	
  1091	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1092	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1093	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1094	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1095	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1096	  {
  1097	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1098	    out.assign(n, 0.0);
  1099	    double term = 1.0;
  1100	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1101	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1102	    if (mx > 0) for (double& v : out) v /= mx;
  1103	  }
  1104	
  1105	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1435	      }
  1436	    }
  1437	    vector<Precursor_> keep;
  1438	    keep.reserve(pcs.size());
  1439	    size_t removed = 0;
  1440	    for (size_t i = 0; i < pcs.size(); ++i) { if (drop[i]) ++removed; else keep.push_back(pcs[i]); }
  1441	    pcs.swap(keep);
  1442	    return removed;
  1443	  }
  1444	
  1445	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  1446	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  1447	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  1448	  template <class Emit>
  1449	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  1450	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  1451	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
  1452	                        int min_corr_pts, vector<float>& pdense, Emit&& emit) const
  1453	  {
  1454	    const double G = (double)fg.rt.size();
  1455	    const vector<pair<double, double>>& p_xic = ms1_traces[pc.trace_idx].xic;
  1456	    // [wavelet] Correlate against a SMOOTHED precursor profile, as diaTracer does. Only the
  1457	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  1458	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  1459	    // (diaTracer smooths only the precursor side), and emitted peak intensities are unaffected
  1460	    // because they come from the fragment traces, not from here.
  1461	    const vector<double>* p_int = nullptr;
  1462	    if (wl_scale_ > 0.0)
  1463	    {
  1464	      const int lv = atrousLevels(p_xic, wl_scale_);
  1465	      if (lv > 0)
  1466	      {
  1467	        thread_local vector<double> raw_i, sm_i;   // window loop is parallel; scratch is per-thread
  1468	        raw_i.resize(p_xic.size());
  1469	        for (size_t i = 0; i < p_xic.size(); ++i) raw_i[i] = p_xic[i].second;
  1470	        atrousSmooth(raw_i, lv, sm_i);
  1471	        p_int = &sm_i;
  1472	      }
  1473	    }
  1474	    vector<int> touched;
  1475	    touched.reserve(p_xic.size());
  1476	    for (size_t pi = 0; pi < p_xic.size(); ++pi)
  1477	    {
  1478	      const auto& p = p_xic[pi];
  1479	      const double pval = p_int ? (*p_int)[pi] : p.second;
  1480	      auto it = lower_bound(fg.rt.begin(), fg.rt.end(), p.first);
  1481	      int gi = -1; double bd = delta_rt;
  1482	      for (auto c : {it == fg.rt.begin() ? it : prev(it), it})
  1483	      {
  1484	        if (c == fg.rt.end()) continue;
  1485	        double d = fabs(*c - p.first);
  1486	        if (d <= bd) { bd = d; gi = (int)(c - fg.rt.begin()); }
  1487	      }
  1488	      if (gi >= 0) { if (pdense[gi] == 0.0f) touched.push_back(gi); pdense[gi] += (float)pval; }
  1489	    }
  1490	    double psum = 0, psumsq = 0, plogsum = 0;
  1491	    // plogsum normalises the precursor profile for gate:coelution=logoverlap. Constant across
  1492	    // every fragment of this precursor, so hoist it out of the inner loop.
  1493	    for (int gi : touched)
  1494	    {
  1495	      double v = pdense[gi];
  1496	      psum += v; psumsq += v * v;
  1497	      if (log_overlap_) plogsum += std::log1p(v);
  1498	    }
  1499	    double pmean = psum / G, pvar = psumsq - G * pmean * pmean;
  1500	    double pinv = pvar > 0 ? 1.0 / sqrt(pvar) : 0.0;
  1501	    if (pinv > 0.0)
  1502	    {
  1503	      size_t lo = lower_bound(frag_im.begin(), frag_im.end(), pc.im - delta_im) - frag_im.begin();
  1504	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  1505	      long long n_rtpass = 0;
  1506	      stat_slice_ += (long long)(hi - lo); ++stat_prec_;
  1507	      for (size_t fi = lo; fi < hi; ++fi)
  1508	      {
  1509	        const Trace& f = frag_traces[fi];
  1510	        if (fabs(f.rt - pc.rt) > delta_rt) continue;                   // RT gate
  1511	        ++n_rtpass;
  1512	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  1513	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  1514	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  1515	        // "fragments" (unfragmented survivors). SPEXTRACT_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  1516	        if (drop_prec_iso_ && pc.charge > 0)
  1517	        {
  1518	          bool iso = false;
  1519	          for (int k = 1; k <= 3 && !iso; ++k) iso = fabs(f.mz - (pc.mono_mz + k * 1.00335 / pc.charge)) < 0.01;
  1520	          if (iso) continue;
  1521	        }
  1522	        double dot = 0; int overlap = 0;
  1523	        // [R2-late, 2026-09-02] overlap <= support, so a fragment with fewer support points than
  1524	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  1525	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  1526	        if (fg.supEnd(fi) - fg.supBegin(fi) < (size_t)std::max(min_corr_pts, 0)) continue;
  1527	        for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1528	        { const auto& gv = fg.flat[k]; float pv = pdense[gv.first]; if (pv != 0.0f) { dot += (double)pv * gv.second; ++overlap; } }
  1529	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  1530	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  1531	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  1532	        // defect the adversarial review flagged. It rewards sparse fragments that happen to spike
  1533	        // where the precursor spikes, and its scale depends on G rather than on the evidence.
  1534	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  1535	        // independence, where one missing point does not zero the score (unlike a product) and
  1536	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  1537	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  1538	        // [0,1]. No zero padding, no dependence on G.
  1539	        double c;
  1540	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  1541	        {
  1542	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  1543	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  1544	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  1545	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  1546	          double fsum = 0.0, fsumsq = 0.0;
  1547	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1548	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  1549	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  1550	          double pm = psum / n, fm = fsum / n;
  1551	          double pv2 = psumsq - n * pm * pm, fv2 = fsumsq - n * fm * fm;
  1552	          if (pv2 <= 0.0 || fv2 <= 0.0) continue;                      // degenerate on union support
  1553	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  1554	        }
  1555	        else if (log_overlap_)
  1556	        {
  1557	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  1558	          // the intersection by the precursor's total log-intensity alone, which made the score
  1559	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  1560	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  1561	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  1562	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  1563	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  1564	          // which is what Pearson gets right and the first version did not.
  1565	          double fsum = 0.0;
  1566	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1567	            fsum += std::log1p((double)fg.flat[k].second);
  1568	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  1569	          double inter = 0.0;
  1570	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1571	          {
  1572	            const auto& gv = fg.flat[k];
  1573	            inter += std::min(std::log1p((double)gv.second) / fsum,
  1574	                              std::log1p((double)pdense[gv.first]) / plogsum);
  1575	          }
  1576	          c = inter;
  1577	        }
  1578	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  1579	        if (c < min_corr) continue;                                    // correlation gate
  1580	        emit(fi, c);
  1581	      }
  1582	      stat_rtpass_ += n_rtpass;
  1583	    }
  1584	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  1585	  }
  1586	
  1587	  /// [wavelet] Assertions on the SHIPPED a-trous smoother. Each check corresponds to a way the
  1588	  /// transform could be wrong while still "looking smoothed" in a plot.
  1589	  ExitCodes selftestWavelet_()
  1590	  {
  1591	    int fail = 0;
  1592	    auto chk = [&](bool ok, const char* what) {
  1593	      if (!ok) { writeLogError_(String("FAIL: ") + what); ++fail; }
  1594	      else writeLogInfo_(String("  ok  ") + what);
  1595	    };
  1596	
  1597	    // 1. DC preservation. The B3 taps must sum to exactly 1: if they do not, smoothing RESCALES
  1598	    //    the precursor profile, and since Pearson is scale-invariant the error would be silent
  1599	    //    here but corrupt gate:coelution=logoverlap, which is NOT scale-invariant.
  1600	    {
  1601	      vector<double> flat(64, 7.5), out;
  1602	      atrousSmooth(flat, 4, out);
  1603	      double worst = 0.0;
  1604	      for (double v : out) worst = std::max(worst, fabs(v - 7.5));
  1605	      chk(worst < 1e-9, "DC preserved (constant signal unchanged)");
  1606	    }
  1607	
  1608	    // 2. Noise reduction, and 3. peak retention -- the two must hold TOGETHER, else "smoothing"
  1609	    //    is either a no-op or a peak destroyer. Deterministic pseudo-noise (no RNG dependence).
  1610	    {
  1760	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  1761	
  1762	    PeakMap exp;
  1763	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  1764	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  1765	    PeakMap ms1_map;
  1766	    map<pair<int, int>, vector<CompactFrame>> ms2_by_window;
  1767	    CompactStats cstat;
  1768	    auto winKey = [](double lo, double hi) {
  1769	      return make_pair((int)llround(lo * 100.0), (int)llround(hi * 100.0));
  1770	    };
  1771	    const bool stream_load = getFlag_("perf:stream_load");
  1772	    bool streamed = false;
  1773	
  1774	    if (stream_load)
  1775	    {
  1776	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  1777	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  1778	      BrukerTimsFile::Config cfg;
  1779	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  1780	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  1781	      PeakPickerIM spicker;
  1782	      Param sp = spicker.getParameters();
  1783	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  1784	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  1785	      if (const char* m = std::getenv("SPEXTRACT_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  1786	      spicker.setParameters(sp);
  1787	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  1788	      try
  1789	      {
  1790	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  1791	        {
  1792	#ifdef SPEXTRACT_WITH_MZPEAK
  1793	          spx::loadMzPeakStreaming(in, consumer, getIntOption_("threads"));   // consumer counts frames itself
  1794	#else
  1795	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  1796	#endif
  1797	        }
  1798	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  1799	        streamed = true;
  1800	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  1801	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  1802	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  1803	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  1804	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  1805	        if (std::getenv("SPEXTRACT_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  1806	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  1807	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  1808	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
