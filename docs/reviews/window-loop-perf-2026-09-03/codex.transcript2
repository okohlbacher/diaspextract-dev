   134	      snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  %9.1f  %5.1fx  %8ld%s\n", n.c_str(), p.wall,
   135	               total_wall > 0 ? 100.0 * p.wall / total_wall : 0.0, p.cpu,
   136	               p.wall > 0 ? p.cpu / p.wall : 0.0, p.rss_end_mb, p.n > 1 ? "  (summed)" : "");
   137	      OPENMS_LOG_INFO << b;
   138	    }
   139	    char b[160];
   140	    snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  (unattributed %.1f s)\n", "TOTAL(measured)", acc,
   141	             total_wall > 0 ? 100.0 * acc / total_wall : 0.0, total_wall - acc);
   142	    OPENMS_LOG_INFO << b;
   143	  }
   144	
   145	  bool log_overlap_ = false;   ///< [B0] gate:coelution == "logoverlap"
   146	  /// [wavelet] Precursor-XIC smoothing scale in SECONDS, derived from the MEASURED MS1 FWHM
   147	  /// (trace:wavelet_smooth x median FWHM). 0 = off. Set once, after MS1 tracing, before the
   148	  /// window loop -- it cannot be read from a parameter directly because the FWHM is a measurement.
   149	  double wl_scale_ = 0.0;
   150	  bool rank_by_intensity_ = false;   ///< [rank] assembly:rank_by == "intensity" (diaTracer-style)
   151	  double im_weight_sigma_ = 0.0;     ///< [recall] Gaussian IM-proximity weight on emitted fragment intensity (0=off)
   152	  double mono_guard_ = 0.0;          ///< [mono-guard] averagine slack on leftward isotope steps (0=off)
   153	  bool mono_select_ = false;         ///< [mono-select] pick the mono by averagine fit over the isotope run
   154	  std::atomic<long long> stat_slice_{0};    ///< fragments VISITED by the IM slice
   155	  std::atomic<long long> stat_rtpass_{0};   ///< of those, how many pass the RT gate
   156	  std::atomic<long long> stat_prec_{0};     ///< precursors scored
   157	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   158	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   159	  bool drop_prec_iso_ = std::getenv("SPEXTRACT_DROP_PREC_ISO") != nullptr;   ///< [C9 A/B] drop precursor M+1..M+3 from fragment lists
   160	
   161	  static std::string rss_()
   162	  {
   163	    std::ifstream st("/proc/self/status");
   164	    if (!st) return "";
   165	    std::string line, cur = "?", peak = "?";
   166	    while (std::getline(st, line))
   167	    {
   168	      auto val = [&line]() {
   169	        std::string v = line.substr(line.find(':') + 1);
   170	        size_t a = v.find_first_not_of(" \t");
   171	        return a == std::string::npos ? std::string("?") : v.substr(a);
   172	      };
   173	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   174	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   175	    }
   176	    return " [RSS " + cur + ", peak " + peak + "]";
   177	  }
   178	
   179	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   180	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   181	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   182	  /// the other users. Add our own RSS back: memory we already hold is part of our budget, not
   183	  /// somebody else's. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   184	  static size_t availableBytes_()
   185	  {
   186	    std::ifstream mi("/proc/meminfo");
   187	    if (!mi) return 0;
   188	    std::string line;
   189	    size_t avail_kb = 0;
   190	    while (std::getline(mi, line))
   191	      if (line.rfind("MemAvailable:", 0) == 0)
   192	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   193	    if (!avail_kb) return 0;
   194	    std::ifstream st("/proc/self/status");
   195	    size_t rss_kb = 0;
   196	    while (st && std::getline(st, line))
   197	      if (line.rfind("VmRSS:", 0) == 0)
   198	      { rss_kb = strtoull(line.c_str() + 6, nullptr, 10); break; }
   199	    return (avail_kb + rss_kb) * 1024ull;
   200	  }
   201	
   202	  struct Trace
   203	  {
   204	    double mz = 0.0;
   205	    double rt = 0.0;   ///< apex/centroid RT
   206	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   207	    double intensity = 0.0;
   208	    // elution profile as (rt, intensity) points, sorted by rt
   209	    vector<pair<double, double>> xic;
   210	  };
   211	
   212	  /// A precursor hypothesis after isotope/charge inference.
   213	  struct Precursor_
   214	  {
   215	    double mono_mz = 0.0;
   216	    int charge = 0;          ///< 0 == unknown
   217	    double rt = 0.0;
   218	    double im = 0.0;
   219	    size_t trace_idx = 0;    ///< index into ms1 traces
   220	    bool guessed = false;    ///< [way-4] charge was DEFAULTED, not isotope-supported
   221	    int n_isotopes = 0;      ///< [Q4] isotope peaks behind the mono call (0/1 = weak, mono ±1.00335 uncertain)
   222	  };
   223	
   224	  /// MassTraceDetection locates the per-peak IM array by the exact name
   225	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   226	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   227	  void ensureIMArrayName(MSSpectrum& s)
   228	  {
   229	    auto& fdas = s.getFloatDataArrays();
   230	    if (s.containsIMData())
   231	    {
   232	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   233	      return;
   234	    }
   235	    for (auto& fda : fdas)
   236	    {
   237	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   238	      {
   239	        fda.setName(Constants::UserParam::ION_MOBILITY);
   240	        return;
   241	      }
   242	    }
   243	  }
   244	
   245	  /// Reported-m/z estimator, set once from `trace:mz_estimator` before any trace is converted.
   246	  /// A file-scope value because toTrace() is a free helper with no access to the tool's parameters.
   247	  inline std::string& mzEstimator() { static std::string v = "apex"; return v; }
   248	
   249	  Trace toTrace(const MassTrace& mt)
   250	  {
   251	    Trace t;
   252	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   253	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   254	    // `trace:mz_estimator` -- see docs/S30-BASELINE.md for the comparison that chose apex.
   255	    const std::string& mz_est = mzEstimator();
   256	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   257	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   258	    else t.mz = mt.getCentroidMZ();
   259	    t.rt = mt.getCentroidRT();
   260	    t.im = mt.getCentroidIM();
   261	    t.intensity = mt.getMaxIntensity(false);
   262	    t.xic.reserve(mt.getSize());
   263	    for (Size i = 0; i < mt.getSize(); ++i)
   264	    {
   265	      t.xic.emplace_back(mt[i].getRT(), mt[i].getIntensity());
   266	    }
   267	    sort(t.xic.begin(), t.xic.end());
   268	    return t;
   269	  }
   270	
   271	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   272	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   273	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   274	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   275	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   276	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   277	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   278	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   279	  struct FragGrid
   280	  {
   281	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   282	    vector<uint64_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   283	                                                ///  64-bit on purpose: 8.5 M fragments x ~510 support
   284	                                                ///  points is within 2x of the 32-bit wrap, and an
   285	                                                ///  overflow here silently corrupts every correlation.
   286	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   287	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   288	    size_t supBegin(size_t i) const { return off[i]; }
   289	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   290	  };
   291	
   292	
   293	  /// [cross-frame] Sliding-window aggregation of adjacent RT frames within ONE isolation window.
   294	  ///
   295	  /// diaTracer sums "adjacent neighbor RT frames" of the same isolation window into a composite
   296	  /// (m/z x 1/K0) matrix BEFORE peak picking, which raises per-point S/N by ~sqrt(N) and lets weak
   297	  /// fragments form traces at all (Nat Commun 16:95 Methods). Because a diaPASEF isolation window is
   298	  /// sampled exactly ONCE per cycle, "adjacent frames" == adjacent CYCLES.
   299	  ///
   300	  /// SLIDING (stride 1), not block: block summing would divide our RT point count by N, and peaks here
   301	  /// span only 4-22 points, which would leave too few points to correlate at all. The cost of sliding
   302	  /// is that adjacent output points share input frames and are therefore AUTOCORRELATED, which inflates
   303	  /// Pearson r for signal and noise alike - the reason this must be benchmarked, not assumed.
   304	  ///
   305	  /// Output spectrum i = intensity-weighted (m/z, IM) clustering of the peaks of spectra
   306	  /// [i-N/2, i+N/2], carrying the ORIGINAL RT of spectrum i so the RT axis is unchanged.
   307	  void aggregateFrames_(PeakMap& wmap, int n_frames, double ppm, double im_tol)
   308	  {
   309	    if (n_frames <= 1 || wmap.empty()) return;
   310	    const int half = n_frames / 2;
   311	    const Size N = wmap.size();
   312	
   313	    struct Pk { double mz; double im; double in; };
   314	    PeakMap out;
   315	    out.reserve(N);
   316	
   317	    vector<Pk> buf;
   318	    for (Size i = 0; i < N; ++i)
   319	    {
   320	      const Size lo = (i > (Size)half) ? i - half : 0;
   321	      const Size hi = std::min(N - 1, i + (Size)half);
   322	
   323	      buf.clear();
   324	      for (Size k = lo; k <= hi; ++k)
   325	      {
   326	        const MSSpectrum& sp = wmap[k];
   327	        if (!sp.containsIMData()) continue;
   328	        const auto& imarr = sp.getFloatDataArrays()[sp.getIMData().first];
   329	        for (Size p = 0; p < sp.size(); ++p) buf.push_back({sp[p].getMZ(), (double)imarr[p], sp[p].getIntensity()});
   330	      }
   331	      sort(buf.begin(), buf.end(), [](const Pk& a, const Pk& b) {
   332	        if (a.mz != b.mz) return a.mz < b.mz;
   333	        return a.im < b.im;
   334	      });
   335	
   336	      MSSpectrum agg;
   337	      agg.setRT(wmap[i].getRT());                 // RT axis preserved (sliding, stride 1)
   338	      agg.setMSLevel(wmap[i].getMSLevel());
   339	      agg.setPrecursors(wmap[i].getPrecursors());
   340	      OpenMS::DataArrays::FloatDataArray im_out;
   341	      im_out.setName(Constants::UserParam::ION_MOBILITY);   // keep tracing IM-aware
   342	
   343	      // greedy cluster in m/z (ppm) then IM: same ion across adjacent cycles collapses, intensities SUM
   344	      for (size_t a = 0; a < buf.size(); )
   345	      {
   346	        const double mz0 = buf[a].mz;
   347	        const double tol = mz0 * ppm * 1e-6;
   348	        size_t b = a;
   349	        double sum = 0.0, wmz = 0.0, wim = 0.0;
   350	        while (b < buf.size() && buf[b].mz - mz0 <= tol)
   351	        {
   352	          if (fabs(buf[b].im - buf[a].im) <= im_tol)
   353	          {
   354	            sum += buf[b].in; wmz += buf[b].mz * buf[b].in; wim += buf[b].im * buf[b].in;
   355	            buf[b].in = -1.0;                    // consumed
   356	          }
   357	          ++b;
   358	        }
   359	        if (sum > 0.0)
   360	        {
   361	          Peak1D pk; pk.setMZ(wmz / sum); pk.setIntensity((float)sum);
   362	          agg.push_back(pk);
   363	          im_out.push_back((float)(wim / sum));
   364	        }
   365	        // advance to next unconsumed peak
   366	        while (a < buf.size() && buf[a].in < 0.0) ++a;
   367	        if (a >= buf.size()) break;
   368	      }
   369	      agg.getFloatDataArrays().push_back(im_out);
   370	      agg.sortByPosition();
   371	      out.addSpectrum(std::move(agg));
   372	    }
   373	    wmap = std::move(out);
   374	  }
   375	
   376	  /// [compact] Quantised frame store for the per-window buffer.
   377	  ///
   378	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   379	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   380	  /// cores (diaTracer uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   381	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   382	  /// that is about to trace it, freeing the compact copy immediately.
   383	  ///
   384	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   385	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   386	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   387	  ///   intensity: float32, unchanged (Peak1D already stores float)
   388	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   389	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   390	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   391	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   392	
   393	  struct CompactFrame
   394	  {
   395	    double rt = 0.0;
   396	    vector<uint32_t> mzq;
   397	    vector<float> inten;
   398	    vector<uint16_t> imq;
   399	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   400	  };
   401	
   402	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   403	  /// [adv-fix] The first version CLAMPED out-of-range 1/K0 to IM_LO/IM_HI, which would pin outliers
   404	  /// from many frames onto two artificial, perfectly-aligned mobility values — manufacturing spurious
   405	  /// traces out of nothing. NaN also passed straight through clamp into llround (UB on unsigned
   406	  /// conversion). Dropping + counting is the only defensible behaviour.
   407	  struct CompactStats
   408	  {
   409	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   410	    /// merge per-frame stats after a parallel batch [perf-load]
   411	    CompactStats& operator+=(const CompactStats& o)
   412	    {
   413	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   414	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   415	      return *this;
   416	    }
   417	  };
   418	
   419	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   420	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   421	  {
   422	    CompactFrame f;
   423	    f.rt = s.getRT();
   424	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   425	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   426	    const Size n = s.size();
   427	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
   428	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   429	    for (Size i = 0; i < n; ++i)
   430	    {
   431	      const double mz = s[i].getMZ();
   432	      const double imv = (double)im[i];
   433	      // [adv-fix] validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   434	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   435	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   436	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   437	      f.inten.push_back(s[i].getIntensity());
   438	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   439	      ++st.kept;
   440	    }
   441	    return f;
   442	  }
   443	
   444	
   445	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   446	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACT_DET=1.
   447	  static uint64_t detDigest_(vector<uint64_t> bits)
   448	  {
   449	    std::sort(bits.begin(), bits.end());
   450	    uint64_t h = 1469598103934665603ULL;
   451	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   452	    return h;
   453	  }
   454	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACT_DET") != nullptr; return on; }
   455	  static uint64_t traceDigest_(const vector<Trace>& ts)
   456	  {
   457	    vector<uint64_t> b; b.reserve(ts.size() * 3);
   458	    for (const auto& t : ts)
   459	    {
   460	      uint64_t u; double v;
   461	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   462	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   463	      v = t.intensity; std::memcpy(&u, &v, 8); b.push_back(u);
   464	    }
   465	    return detDigest_(std::move(b));
   466	  }
   467	
   468	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   469	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   470	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   471	  {
   472	    PeakMap m;
   473	    m.reserve(frames.size());
   474	    for (auto& f : frames)
   475	    {
   476	      MSSpectrum s;
   477	      s.setRT(f.rt);
   478	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   479	      s.reserve(f.mzq.size());
   480	      OpenMS::DataArrays::FloatDataArray ima;
   481	      ima.setName(Constants::UserParam::ION_MOBILITY);
   482	      ima.reserve(f.mzq.size());
   483	      for (size_t i = 0; i < f.mzq.size(); ++i)
   484	      {
   485	        Peak1D p;
   486	        p.setMZ((double)f.mzq[i] / MZ_Q);
   487	        p.setIntensity(f.inten[i]);
   488	        s.push_back(p);
   489	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   490	      }
   491	      s.getFloatDataArrays().push_back(std::move(ima));
   492	      m.addSpectrum(std::move(s));
   493	      // release this frame's compact storage immediately
   494	      vector<uint32_t>().swap(f.mzq);
   495	      vector<float>().swap(f.inten);
   496	      vector<uint16_t>().swap(f.imq);
   497	    }
   498	    vector<CompactFrame>().swap(frames);
   499	    return m;
   500	  }
   501	
   502	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
   503	  ///
   504	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
   505	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
   506	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
   507	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
   508	  ///
   509	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
   510	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
   511	  /// ordering is the reader's business and need not match ours.
   512	  class PickCompactConsumer : public FullSwathFileConsumer
   513	  {
   514	  public:
   515	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
   516	                        PeakMap& ms1, CompactStats& stats,
   517	                        std::function<pair<int, int>(double, double)> keyfn)
   518	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
   519	
   520	    size_t frames_seen = 0;
   521	
   522	    /// [perf-load] Pick+compact a BATCH of buffered frames in parallel, then append in arrival
   523	    /// order. OpenMS hands frames over a strictly serial `for (fid..) consumeSpectrum(spec)` loop,
   524	    /// so before this the peak picking of 1.26e9 peaks ran on ONE thread and was 53% of total wall
   525	    /// (measured: 1046 s wall, parallel factor 1.0). Buffering here parallelises it without
   526	    /// touching the reader. Appending strictly by buffer index keeps the output order identical to
   527	    /// the serial path; the emitted spectra matched it in m/z and differed in ~2% of intensities at
   528	    /// the 1e-5..1e-4 relative level (Sage count unchanged) -- see docs/RUNTIME-PLAN [pick-det].
   529	    void flush_()
   530	    {
   531	      const int n = (int)buf_.size();
   532	      if (n == 0) return;
   533	      const double _tf0 = phase_clock_();
   534	      std::vector<CompactFrame> compacted((size_t)n);
   535	      std::vector<CompactStats> st((size_t)n);          // per-frame stats, merged serially below
   536	      PeakPickerIM picker = picker_;                    // Param is a deep-copy value type
   537	      // SPEXTRACT_PICK_SERIAL=1 runs this loop on one thread: the A/B that separates picker
   538	      // scheduling-sensitivity from downstream chaos (kimi, plan review). [pick-det]
   539	      static const bool par_pick = std::getenv("SPEXTRACT_PICK_SERIAL") == nullptr;
   540	      static const bool sched_set = []{ const bool st = std::getenv("SPEXTRACT_PICK_STATIC") != nullptr; omp_set_schedule(st ? omp_sched_static : omp_sched_dynamic, st ? 0 : 1); return true; }(); (void)sched_set;
   541	      std::exception_ptr pick_err;                      // an exception escaping an OMP region aborts
   542	      // chunk 1: with chunk 8 a 64-frame batch made only 8 chunks = 8 workers (codex, plan review)
   543	      #pragma omp parallel for firstprivate(picker) schedule(runtime) if(par_pick)   // SPEXTRACT_PICK_STATIC=1 -> static (history-vs-race probe)
   544	      for (int i = 0; i < n; ++i)
   545	      {
   546	        try
   547	        {
   548	          auto& s = buf_[(size_t)i];
   549	          ensureIMArrayName(s);
   550	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   551	          ensureIMArrayName(s);
   552	          compacted[(size_t)i] = compactify(s, st[(size_t)i]);
   553	          s.clear(true);                                // raw frame dies here, inside the loop
   554	        }
   555	        catch (...)
   556	        {
   557	          #pragma omp critical(pick_err)
   558	          if (!pick_err) pick_err = std::current_exception();
   559	        }
   560	      }
   561	      if (pick_err) std::rethrow_exception(pick_err);
   562	      for (int i = 0; i < n; ++i)
   563	      {
   564	        stats_ += st[(size_t)i];
   565	        windows_[key_[(size_t)i]].push_back(std::move(compacted[(size_t)i]));
   566	      }
   567	      flush_wall_() += phase_clock_() - _tf0;
   568	      buf_.clear(); key_.clear();
   569	    }
   570	
   571	  protected:
   572	    void consumeMS1Spectrum_(MapType::SpectrumType& s) override
   573	    {
   574	      // MS1 stays a PeakMap (MassTraceDetection needs it whole), but its pick is NOT small: 1,343
   575	      // frames x ~690k raw peaks = 37% of all peaks, and it used to run serially here (~400 s of
   576	      // LOAD, measured 2026-09-02). Buffer and pick in parallel like MS2; order is kept by index.
   577	      ms1_buf_.push_back(std::move(s));
   578	      ++frames_seen;
   579	      if (ms1_buf_.size() >= kBatch) flushMS1_();
   580	    }
   581	
   582	    void flushMS1_()
   583	    {
   584	      const int n = (int)ms1_buf_.size();
   585	      if (n == 0) return;
   586	      const double _tf0 = phase_clock_();
   587	      PeakPickerIM picker = picker_;
   588	      std::exception_ptr pick_err;
   589	      #pragma omp parallel for firstprivate(picker) schedule(dynamic, 1)
   590	      for (int i = 0; i < n; ++i)
   591	      {
   592	        try
   593	        {
   594	          auto& s = ms1_buf_[(size_t)i];
   595	          ensureIMArrayName(s);
   596	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
   597	          ensureIMArrayName(s);
   598	        }
   599	        catch (...)
   600	        {
   601	          #pragma omp critical(pick_err_ms1)
   602	          if (!pick_err) pick_err = std::current_exception();
   603	        }
   604	      }
   605	      if (pick_err) std::rethrow_exception(pick_err);
   606	      for (auto& s : ms1_buf_) ms1_.addSpectrum(std::move(s));
   607	      ms1_buf_.clear();
   608	      flush_wall_() += phase_clock_() - _tf0;
   609	    }
   610	
   611	    void consumeSwathSpectrum_(MapType::SpectrumType& s, size_t /*swath_nr*/) override
   612	    {
   613	      const auto& prec = s.getPrecursors();
   614	      if (prec.empty()) return;                      // no isolation window -> not routable
   615	      const double c = prec[0].getMZ();
   616	      const double lo = c - prec[0].getIsolationWindowLowerOffset();
   617	      const double hi = c + prec[0].getIsolationWindowUpperOffset();
   618	      flushMS1_();                                   // MS1 arrives first; pick it before any MS2 work
   619	      key_.push_back(keyfn_(lo, hi));
   620	      buf_.push_back(std::move(s));                  // pick+compact deferred to flush_()
   621	      ++frames_seen;
   622	      if (buf_.size() >= kBatch) flush_();
   623	    }
   624	
   625	    void ensureMapsAreFilled_() override { flushMS1_(); flush_(); }   // pick up the tails
   626	
   627	  private:
   628	    /// deliberate: 256 frames is ~1 GB of raw buffer at ~37k peaks/frame -- 2.5 work items per
   629	    /// thread at 100 threads (64 gave 8 chunks of 8 = 8 workers), small next to the 12 GB compact
   630	    /// store. SPEXTRACT_PICK_BATCH overrides for the sweep.
   631	    static const size_t kBatch;
   632	    std::vector<MapType::SpectrumType> buf_;
   633	    std::vector<pair<int, int>> key_;
   634	    PeakPickerIM& picker_;
   635	    std::vector<MapType::SpectrumType> ms1_buf_;   // MS1 frames awaiting the parallel pick
   636	    map<pair<int, int>, vector<CompactFrame>>& windows_;
   637	    PeakMap& ms1_;
   638	    CompactStats& stats_;
   639	    std::function<pair<int, int>(double, double)> keyfn_;
   640	  };
   641	  const size_t PickCompactConsumer::kBatch =
   642	    std::getenv("SPEXTRACT_PICK_BATCH") ? (size_t)std::atoi(std::getenv("SPEXTRACT_PICK_BATCH")) : 256;
   643	
   644	  /// [wavelet] Stationary ("a trous") B3-spline wavelet smoothing of an elution profile.
   645	  ///
   646	  /// WHY. diaTracer correlates a SMOOTHED precursor XIC against RAW fragment XICs (Nat Commun
   647	  /// 16:95, Methods: 2D Gaussian pre-filter, then Savitzky-Golay for elongated peaks). We copied
   648	  /// its 0.3 correlation threshold WITHOUT copying the smoothing. Pearson r between two noisy
   649	  /// profiles is attenuated toward 0 as S/N falls, so an unsmoothed 0.3 is a systematically weaker
   650	  /// constraint than a smoothed 0.3 -- and the attenuation is worst exactly at faint precursors,
   651	  /// which is where the coverage analysis says we lose peptides (MISS precursors are 3.2x dimmer).
   652	  /// Raising the threshold to compensate was tried and produced only an FDR artefact; smoothing
   653	  /// attacks the cause instead of the symptom.
   654	  ///
   655	  /// A-TROUS, not a decimated DWT: no downsampling, so the output stays sample-aligned with the
   656	  /// input and can be scattered onto the correlation grid at the SAME RT positions. That matters
   657	  /// for correctness here, not just convenience -- the overlap gate counts grid points where the
   658	  /// precursor is non-zero, so a transform that moved or resampled points would silently change
   659	  /// what `min_correlation_points` means.
   660	  ///
   661	  /// B3-spline scaling filter [1,4,6,4,1]/16, dilated by 2^(j-1) at level j; c_J is a low-pass of
   662	  /// support ~2^J samples. J comes from the MEASURED MS1 FWHM (see atrousLevels), never a guess.
   663	  void atrousSmooth(const vector<double>& in, int levels, vector<double>& out)
   664	  {
   665	    static const double H[5] = {1.0 / 16, 4.0 / 16, 6.0 / 16, 4.0 / 16, 1.0 / 16};
   666	    const int n = (int)in.size();
   667	    out = in;
   668	    if (n < 3 || levels <= 0) return;
   669	    vector<double> tmp(n);
   670	    for (int j = 1; j <= levels; ++j)
   671	    {
   672	      const int step = 1 << (j - 1);
   673	      for (int i = 0; i < n; ++i)
   674	      {
   675	        double acc = 0.0;
   676	        for (int k = -2; k <= 2; ++k)
   677	        {
   678	          int idx = i + k * step;
   679	          // MIRROR both ends. Zero-padding would pull an edge-truncated peak toward zero and
   680	          // fabricate a downslope -- the same bias the FWHM measurement excludes truncated peaks for.
   681	          if (idx < 0) idx = -idx;
   682	          if (idx >= n) idx = 2 * (n - 1) - idx;
   683	          idx = std::max(0, std::min(n - 1, idx));   // degenerate after double reflection (tiny n)
   684	          acc += H[k + 2] * out[idx];
   685	        }
   686	        tmp[i] = acc;
   687	      }
   688	      out.swap(tmp);
   689	    }
   690	  }
   691	
   692	  /// Number of a-trous levels whose smoothing support best matches @p scale_sec at this profile's
   693	  /// OWN sampling. Sampling is read per-trace rather than assumed: diaPASEF cycles are regular, but
   694	  /// a valley-split trace can carry gaps, and a fixed level count would then smooth different
   695	  /// physical widths on different traces.
   696	  int atrousLevels(const vector<pair<double, double>>& xic, double scale_sec)
   697	  {
   698	    if (xic.size() < 5 || scale_sec <= 0.0) return 0;
   699	    vector<double> d;
   700	    d.reserve(xic.size() - 1);
   701	    for (size_t i = 1; i < xic.size(); ++i)
   702	    {
   703	      const double g = xic[i].first - xic[i - 1].first;
   704	      if (g > 0) d.push_back(g);
   705	    }
   706	    if (d.empty()) return 0;
   707	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
   708	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
   709	    if (dt <= 0.0) return 0;
   710	    const double want = scale_sec / dt;                // desired support, in SAMPLES
   711	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
   712	    const int j = (int)std::lround(std::log2(want));
   713	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
   714	  }
   715	
   716	  /// Build the per-window FragGrid from IM-sorted fragment traces.
   717	  /// Resample every fragment XIC onto one common RT grid, as CSR. Takes `frags` by reference and
   718	  /// CONSUMES each XIC as it is copied: the XIC vectors and the grid would otherwise be live at the
   719	  /// same time, and their coexistence is what sets the per-window memory peak.
   720	  FragGrid buildFragGrid(vector<Trace>& frags)
   721	  {
   722	    FragGrid g;
   723	    // The grid is the set of DISTINCT fragment RTs, and there is one per frame in this window --
   724	    // roughly 1,400 values. Collecting all ~10^8 individual points and sorting them cost a ~700 MB
   725	    // temporary and an 10^8-element sort per window, to produce those 1,400 values. Grow a sorted
   726	    // vector by insertion instead: the same set exactly, no temporary, and no large sort.
   727	    for (const auto& f : frags)
   728	      for (const auto& p : f.xic)
   729	      {
   730	        auto it = lower_bound(g.rt.begin(), g.rt.end(), p.first);
   731	        if (it == g.rt.end() || *it != p.first) g.rt.insert(it, p.first);
   732	      }
   733	    const double G = (double)g.rt.size();
   734	    g.mean.resize(frags.size());
   735	    g.invnorm.resize(frags.size());
   736	    g.off.assign(frags.size() + 1, 0);
   737	    // Offsets first, so each fragment owns a disjoint span and the fill is parallel and
   738	    // deterministic (identical arithmetic per fragment, in the same order, whoever runs it).
   739	    for (size_t i = 0; i < frags.size(); ++i) g.off[i + 1] = g.off[i] + (uint64_t)frags[i].xic.size();
   740	    g.flat.resize((size_t)g.off[frags.size()]);
   741	    #pragma omp taskloop default(shared)
   742	    for (long ii = 0; ii < (long)frags.size(); ++ii)
   743	    {
   744	      const size_t i = (size_t)ii;
   745	      double sum = 0, sumsq = 0;
   746	      size_t w = (size_t)g.off[i];
   747	      for (const auto& p : frags[i].xic)
   748	      {
   749	        const int gi = (int)(lower_bound(g.rt.begin(), g.rt.end(), p.first) - g.rt.begin());
   750	        g.flat[w++] = {gi, (float)p.second};
   751	        sum += p.second; sumsq += p.second * p.second;
   752	      }
   753	      g.mean[i] = sum / G;
   754	      const double var = sumsq - G * g.mean[i] * g.mean[i];
   755	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0;  // 0 => constant/degenerate -> never correlates
   756	      vector<pair<double, double>>().swap(frags[i].xic);   // consumed here, not after scoring
   757	    }
   758	    return g;
   759	  }
   760	}
   900	    setMinFloat_("trace:ms2_chrom_peak_snr", 0.0);
   901	    setMinFloat_("trace:ms2_noise_threshold_int", 0.0);
   902	    setMinFloat_("trace:noise_threshold_int", 0.0);
   903	    setMinInt_("perf:ms1_trace_bands", 0);      // 0 = auto (documented)
   904	    setMinFloat_("perf:mem_fraction", 0.05);
   905	    setMaxFloat_("perf:mem_fraction", 0.95);
   906	    // deliberate: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
   907	  }
   908	
   909	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
   910	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
   911	  ///   peak_int > chrom_peak_snr * noise_threshold_int
   912	  /// so the EFFECTIVE apex threshold is snr*noise, while trace MEMBERSHIP only needs > noise.
   913	  /// Leaving snr at the OpenMS default 3.0 silently triples the fragment apex threshold.
   914	  /// diaTracer deliberately runs MS2 with "more relaxed constraints" than MS1 (Nat Commun 16:95
   915	  /// Methods) — so MS1 and MS2 get INDEPENDENT snr / min-length here. [recall]
   916	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
   917	  /// it is dead from that point on, but at ~20 B/peak (Peak1D 16 + IM float 4) it is ~1.1 GB per
   918	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
   919	  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
   920	                              double snr, double min_len, double min_sample_rate, double max_len,
   921	                              double split_valleys, String* span_log = nullptr, int bands = 1)
   922	  {
   923	    MassTraceDetection mtd;
   924	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
   925	    Param p = mtd.getParameters();
   926	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
   927	    p.setValue("noise_threshold_int", noise);
   928	    p.setValue("chrom_peak_snr", snr);
   929	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
   930	    p.setValue("min_trace_length", min_len);
   931	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
   932	    // trace extension when occupancy drops below it — an intensity-INDEPENDENT deletion of gappy but
   933	    // real fragment traces in sparse diaPASEF data. Relaxing it for MS2 is the sole surviving MS2
   934	    // trace-validity lever. [recall]
   935	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
   936	    if (max_len > 0.0) p.setValue("max_trace_length", max_len);
   937	    mtd.setParameters(p);
   938	
   939	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
   940	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
   941	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
   942	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
   943	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
   944	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
   945	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
   946	      ElutionPeakDetection epd;
   947	      epd.setLogType(ProgressLogger::NONE);
   948	      Param ep = epd.getParameters();
   949	      ep.setValue("chrom_fwhm", split_valleys);
   950	      ep.setValue("width_filtering", "off");
   951	      ep.setValue("masstrace_snr_filtering", "false");
   952	      epd.setParameters(ep);
   953	      vector<MassTrace> out; out.reserve(in.size());
   954	      epd.detectPeaks(in, out);
   955	      return out;
   956	    };
   957	
   958	    vector<MassTrace> mts;
   959	    if (bands > 1)
   960	    {
   961	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
   962	      // windows caps us at 24 threads however many cores exist. Fragment traces at
   963	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
   964	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
   965	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
   966	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
   967	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
   968	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
   969	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
   970	      vector<double> sample;
   971	      for (const auto& s : map)
   972	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
   973	      sort(sample.begin(), sample.end());
   974	      vector<double> edge(bands + 1);
   975	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
   976	      else
   977	        for (int b = 0; b <= bands; ++b)
   978	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
   979	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
   980	      vector<double> ().swap(sample);
   981	
   982	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
   983	      // then release the source map so the halo duplicates are the only overhead.
   984	      vector<PeakMap> sub(bands);
   985	      for (const auto& s : map)
   986	      {
   987	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
   988	        for (int b = 0; b < bands; ++b)
   989	        {
   990	          const double h = edge[b] * ppm * 1e-6 * 20.0;
   991	          const double lo = edge[b] - h, hi = edge[b + 1] + h;
   992	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
   993	          OpenMS::DataArrays::FloatDataArray ia;
   994	          ia.setName(Constants::UserParam::ION_MOBILITY);
   995	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
   996	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
   997	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
   998	          Size i0 = 0, i1 = s.size();
   999	          if (s.isSorted())
  1000	          {
  1001	            i0 = (Size)(s.MZBegin(lo) - s.begin());
  1002	            i1 = (Size)(s.MZBegin(hi) - s.begin());
  1003	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
  1004	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1005	          }
  1006	          else
  1007	            for (Size i = 0; i < s.size(); ++i)
  1008	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
  1009	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1010	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); sub[b].addSpectrum(std::move(t)); }
  1011	        }
  1012	      }
  1013	      map.clear(true);
  1014	      vector<vector<MassTrace>> per(bands);
  1015	      #pragma omp taskloop grainsize(1) default(shared)
  1016	      for (int b = 0; b < bands; ++b)
  1017	      {
  1018	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
  1019	        vector<MassTrace> t;
  1020	        sub[b].sortSpectra();
  1021	        if (sub[b].size() < 3) { sub[b].clear(true); continue; }   // MTD aborts below 3 spectra
  1022	        m2.run(sub[b], t);
  1023	        sub[b].clear(true);
  1024	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
  1025	        for (auto& mt : t)
  1026	        {
  1027	          const double c = mt.getCentroidMZ();
  1028	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
  1029	        }
  1030	      }
  1031	      size_t tot = 0; for (const auto& v : per) tot += v.size();
  1032	      mts.reserve(tot);
  1033	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
  1034	    }
  1035	    else
  1036	    {
  1037	      if (map.size() >= 3) mtd.run(map, mts);   // MTD aborts below 3 spectra; a tiny input is not an error
  1038	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
  1039	    }
  1040	
  1041	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
  1042	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1043	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1044	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1045	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1046	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1047	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1048	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off S30 20:46 vs 28:40 for
  1049	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1050	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1051	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1052	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1053	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1054	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1055	    // determinism bug, now fixed.
  1056	    if (split_valleys > 0.0 && mts.size() > 1)
  1057	    {
  1058	      const int nthreads = std::max(1, bands);
  1059	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1060	      const size_t n_in = mts.size();
  1061	      vector<vector<MassTrace>> parts(nchunk);
  1062	      #pragma omp taskloop grainsize(1) default(shared)
  1063	      for (int ci = 0; ci < nchunk; ++ci)
  1064	      {
  1065	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1066	        if (lo >= hi) continue;
  1067	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1068	                                std::make_move_iterator(mts.begin() + hi));
  1069	        parts[ci] = do_split(chunk);
  1070	      }
  1071	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1072	      vector<MassTrace> out; out.reserve(tot);
  1073	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1074	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1075	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1076	      mts.swap(out);
  1077	    }
  1078	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1079	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1080	    if (!mts.empty())
  1081	    {
  1082	      vector<double> spans;
  1083	      spans.reserve(mts.size());
  1084	      for (const auto& mt : mts)
  1085	      {
  1086	        double lo = 1e30, hi = -1e30;
  1087	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1088	        spans.push_back(hi - lo);
  1089	      }
  1090	      sort(spans.begin(), spans.end());
  1091	      size_t n = spans.size();
  1092	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1093	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1094	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1095	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1096	    }
  1097	    vector<Trace> out;
  1098	    out.reserve(mts.size());
  1099	    for (const auto& mt : mts) out.push_back(toTrace(mt));
  1100	    return out;
  1101	  }
