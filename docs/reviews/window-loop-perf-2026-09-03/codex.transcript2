   444	
   445	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   446	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACT_DET=1.
   447	  static uint64_t detDigest_(vector<uint64_t> bits)
   448	  {
   449	    std::sort(bits.begin(), bits.end());
   450	    uint64_t h = 1469598103934665603ULL;
   451	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   452	    return h;
   453	  }
   454	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACT_DET") != nullptr; return on; }
   455	  static uint64_t traceDigest_(const vector<Trace>& ts)
   456	  {
   457	    vector<uint64_t> b; b.reserve(ts.size() * 3);
   458	    for (const auto& t : ts)
   459	    {
   460	      uint64_t u; double v;
   461	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   462	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   463	      v = t.intensity; std::memcpy(&u, &v, 8); b.push_back(u);
   464	    }
   465	    return detDigest_(std::move(b));
   466	  }
   467	
   468	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   469	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   470	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   471	  {
   472	    PeakMap m;
   473	    m.reserve(frames.size());
   474	    for (auto& f : frames)
   475	    {
   476	      MSSpectrum s;
   477	      s.setRT(f.rt);
   478	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   479	      s.reserve(f.mzq.size());
   480	      OpenMS::DataArrays::FloatDataArray ima;
   481	      ima.setName(Constants::UserParam::ION_MOBILITY);
   482	      ima.reserve(f.mzq.size());
   483	      for (size_t i = 0; i < f.mzq.size(); ++i)
   484	      {
   485	        Peak1D p;
   486	        p.setMZ((double)f.mzq[i] / MZ_Q);
   487	        p.setIntensity(f.inten[i]);
   488	        s.push_back(p);
   489	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
   490	      }
   491	      s.getFloatDataArrays().push_back(std::move(ima));
   492	      m.addSpectrum(std::move(s));
   493	      // release this frame's compact storage immediately
   494	      vector<uint32_t>().swap(f.mzq);
   495	      vector<float>().swap(f.inten);
   496	      vector<uint16_t>().swap(f.imq);
   497	    }
   498	    vector<CompactFrame>().swap(frames);
   499	    return m;
   500	  }
