  1401	          if (hyps[h].z == best.z) continue;
  1402	          if (best.score - hyps[h].score > ambig_margin) break;
  1403	          Precursor_ alt = pc;
  1404	          alt.mono_mz = hyps[h].mono; alt.charge = hyps[h].z;
  1405	          alt.n_isotopes = 1 + (int)hyps[h].partners.size();   // [Q4]
  1406	          out.push_back(alt);
  1407	          break;                            // at most one alternative
  1408	        }
  1409	      }
  1410	    }
  1411	    return out;
  1412	  }
  1413	
  1414	  /// [route-4] Collapse precursor hypotheses that are the SAME species (same charge, m/z within ppm,
  1415	  /// co-eluting in RT, co-located in IM). Measured redundancy is 4.6 identified spectra per unique
  1416	  /// peptide vs diaTracer's 1.46, so duplicates cost spectra, RAM and FDR budget without adding
  1417	  /// peptides. Keeps the most intense representative. Deterministic (total-order sort).
  1418	  static size_t dedupPrecursors_(vector<Precursor_>& pcs, const vector<Trace>& ms1,
  1419	                                 double mass_ppm, double rt_tol, double im_tol)
  1420	  {
  1421	    if (pcs.empty()) return 0;
  1422	    vector<size_t> idx(pcs.size());
  1423	    for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  1424	    sort(idx.begin(), idx.end(), [&](size_t a, size_t b) {
  1425	      if (pcs[a].charge != pcs[b].charge) return pcs[a].charge < pcs[b].charge;
  1426	      if (pcs[a].mono_mz != pcs[b].mono_mz) return pcs[a].mono_mz < pcs[b].mono_mz;
  1427	      if (pcs[a].rt != pcs[b].rt) return pcs[a].rt < pcs[b].rt;
  1428	      return a < b;
  1429	    });
  1430	    vector<bool> drop(pcs.size(), false);
  1431	    for (size_t a = 0; a < idx.size(); ++a)
  1432	    {
  1433	      size_t i = idx[a];
  1434	      if (drop[i]) continue;
  1435	      const double tol = pcs[i].mono_mz * mass_ppm * 1e-6;
  1436	      for (size_t b = a + 1; b < idx.size(); ++b)
  1437	      {
  1438	        size_t j = idx[b];
  1439	        if (pcs[j].charge != pcs[i].charge) break;
  1440	        if (pcs[j].mono_mz - pcs[i].mono_mz > tol) break;
  1441	        if (drop[j]) continue;
  1442	        if (fabs(pcs[j].rt - pcs[i].rt) <= rt_tol && fabs(pcs[j].im - pcs[i].im) <= im_tol)
  1443	        {
  1444	          if (ms1[pcs[j].trace_idx].intensity > ms1[pcs[i].trace_idx].intensity) { drop[i] = true; break; }
  1445	          drop[j] = true;
  1446	        }
  1447	      }
  1448	    }
  1449	    vector<Precursor_> keep;
  1450	    keep.reserve(pcs.size());
  1451	    size_t removed = 0;
  1452	    for (size_t i = 0; i < pcs.size(); ++i) { if (drop[i]) ++removed; else keep.push_back(pcs[i]); }
  1453	    pcs.swap(keep);
  1454	    return removed;
  1455	  }
  1456	
  1457	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  1458	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  1457	  /// Resample the precursor XIC onto the window grid (once), then for every IM+RT+overlap-passing
  1458	  /// candidate fragment compute the Pearson correlation and, if >= min_corr, call emit(fi, corr).
  1459	  /// Shared by the per-precursor path and the competitive (best-precursor) assignment. [bench]
  1460	  template <class Emit>
  1461	  void scoreCandidates_(const Precursor_& pc, const vector<Trace>& frag_traces,
  1462	                        const vector<double>& frag_im, const vector<Trace>& ms1_traces,
  1463	                        const FragGrid& fg, double delta_im, double delta_rt, double min_corr,
  1464	                        int min_corr_pts, vector<float>& pdense, Emit&& emit) const
  1465	  {
  1466	    const double G = (double)fg.rt.size();
  1467	    const vector<pair<double, double>>& p_xic = ms1_traces[pc.trace_idx].xic;
  1468	    // [wavelet] Correlate against a SMOOTHED precursor profile, as diaTracer does. Only the
  1469	    // INTENSITIES change: RT positions, touched grid points and the overlap count are untouched,
  1470	    // so this cannot silently redefine the min_correlation_points gate. Fragment XICs stay RAW
  1471	    // (diaTracer smooths only the precursor side), and emitted peak intensities are unaffected
  1472	    // because they come from the fragment traces, not from here.
  1473	    const vector<double>* p_int = nullptr;
  1474	    if (wl_scale_ > 0.0)
  1475	    {
  1476	      const int lv = atrousLevels(p_xic, wl_scale_);
  1477	      if (lv > 0)
  1478	      {
  1479	        thread_local vector<double> raw_i, sm_i;   // window loop is parallel; scratch is per-thread
  1480	        raw_i.resize(p_xic.size());
  1481	        for (size_t i = 0; i < p_xic.size(); ++i) raw_i[i] = p_xic[i].second;
  1482	        atrousSmooth(raw_i, lv, sm_i);
  1483	        p_int = &sm_i;
  1484	      }
  1485	    }
  1486	    vector<int> touched;
  1487	    touched.reserve(p_xic.size());
  1488	    for (size_t pi = 0; pi < p_xic.size(); ++pi)
  1489	    {
  1490	      const auto& p = p_xic[pi];
  1491	      const double pval = p_int ? (*p_int)[pi] : p.second;
  1492	      auto it = lower_bound(fg.rt.begin(), fg.rt.end(), p.first);
  1493	      int gi = -1; double bd = delta_rt;
  1494	      for (auto c : {it == fg.rt.begin() ? it : prev(it), it})
  1495	      {
  1496	        if (c == fg.rt.end()) continue;
  1497	        double d = fabs(*c - p.first);
  1498	        if (d <= bd) { bd = d; gi = (int)(c - fg.rt.begin()); }
  1499	      }
  1500	      if (gi >= 0) { if (pdense[gi] == 0.0f) touched.push_back(gi); pdense[gi] += (float)pval; }
  1501	    }
  1502	    double psum = 0, psumsq = 0, plogsum = 0;
  1503	    // plogsum normalises the precursor profile for gate:coelution=logoverlap. Constant across
  1504	    // every fragment of this precursor, so hoist it out of the inner loop.
  1505	    for (int gi : touched)
  1506	    {
  1507	      double v = pdense[gi];
  1508	      psum += v; psumsq += v * v;
  1509	      if (log_overlap_) plogsum += std::log1p(v);
  1510	    }
  1511	    double pmean = psum / G, pvar = psumsq - G * pmean * pmean;
  1512	    double pinv = pvar > 0 ? 1.0 / sqrt(pvar) : 0.0;
  1513	    if (pinv > 0.0)
  1514	    {
  1515	      size_t lo = lower_bound(frag_im.begin(), frag_im.end(), pc.im - delta_im) - frag_im.begin();
  1516	      size_t hi = upper_bound(frag_im.begin(), frag_im.end(), pc.im + delta_im) - frag_im.begin();
  1517	      long long n_rtpass = 0;
  1518	      stat_slice_ += (long long)(hi - lo); ++stat_prec_;
  1519	      for (size_t fi = lo; fi < hi; ++fi)
  1520	      {
  1521	        const Trace& f = frag_traces[fi];
  1522	        if (fabs(f.rt - pc.rt) > delta_rt) continue;                   // RT gate
  1523	        ++n_rtpass;
  1524	        if (fg.invnorm[fi] == 0.0) continue;                           // degenerate fragment
  1525	        if (fabs(f.mz - pc.mono_mz) < 0.01) continue;                  // exclude precursor peak [M-7]
  1526	        // [C9 A/B, 2026-09-02] 28% of emitted spectra carry the precursor's M+1 and 25% its M+2 as
  1527	        // "fragments" (unfragmented survivors). SPEXTRACT_DROP_PREC_ISO=1 drops M+1..M+3 (z known) too.
  1528	        if (drop_prec_iso_ && pc.charge > 0)
  1529	        {
  1530	          bool iso = false;
  1531	          for (int k = 1; k <= 3 && !iso; ++k) iso = fabs(f.mz - (pc.mono_mz + k * 1.00335 / pc.charge)) < 0.01;
  1532	          if (iso) continue;
  1533	        }
  1534	        double dot = 0; int overlap = 0;
  1535	        // [R2-late, 2026-09-02] overlap <= support, so a fragment with fewer support points than
  1536	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  1537	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  1538	        if (fg.supEnd(fi) - fg.supBegin(fi) < (size_t)std::max(min_corr_pts, 0)) continue;
  1539	        for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1540	        { const auto& gv = fg.flat[k]; float pv = pdense[gv.first]; if (pv != 0.0f) { dot += (double)pv * gv.second; ++overlap; } }
  1541	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  1542	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  1543	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  1544	        // defect the adversarial review flagged. It rewards sparse fragments that happen to spike
  1545	        // where the precursor spikes, and its scale depends on G rather than on the evidence.
  1546	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  1547	        // independence, where one missing point does not zero the score (unlike a product) and
  1548	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  1549	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  1550	        // [0,1]. No zero padding, no dependence on G.
  1551	        double c;
  1552	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  1553	        {
  1554	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  1555	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  1556	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  1557	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  1558	          double fsum = 0.0, fsumsq = 0.0;
  1559	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1560	          { double fv = (double)fg.flat[k].second; fsum += fv; fsumsq += fv * fv; }
  1561	          double n = (double)(touched.size() + (fg.supEnd(fi) - fg.supBegin(fi)) - (size_t)overlap);
  1562	          double pm = psum / n, fm = fsum / n;
  1563	          double pv2 = psumsq - n * pm * pm, fv2 = fsumsq - n * fm * fm;
  1564	          if (pv2 <= 0.0 || fv2 <= 0.0) continue;                      // degenerate on union support
  1565	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  1566	        }
  1567	        else if (log_overlap_)
  1568	        {
  1569	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  1570	          // the intersection by the precursor's total log-intensity alone, which made the score
  1571	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  1572	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  1573	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  1574	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  1575	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  1576	          // which is what Pearson gets right and the first version did not.
  1577	          double fsum = 0.0;
  1578	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1579	            fsum += std::log1p((double)fg.flat[k].second);
  1580	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  1581	          double inter = 0.0;
  1582	          for (size_t k = fg.supBegin(fi), ke = fg.supEnd(fi); k < ke; ++k)
  1583	          {
  1584	            const auto& gv = fg.flat[k];
  1585	            inter += std::min(std::log1p((double)gv.second) / fsum,
  1586	                              std::log1p((double)pdense[gv.first]) / plogsum);
  1587	          }
  1588	          c = inter;
  1589	        }
  1590	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  1591	        if (c < min_corr) continue;                                    // correlation gate
  1592	        emit(fi, c);
  1593	      }
  1594	      stat_rtpass_ += n_rtpass;
  1595	    }
  1596	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  1597	  }
  1598	
  1599	  /// [wavelet] Assertions on the SHIPPED a-trous smoother. Each check corresponds to a way the
  1600	  /// transform could be wrong while still "looking smoothed" in a plot.
  1601	  ExitCodes selftestWavelet_()
  1602	  {
  1603	    int fail = 0;
  1604	    auto chk = [&](bool ok, const char* what) {
  1605	      if (!ok) { writeLogError_(String("FAIL: ") + what); ++fail; }
  1760	    rank_by_intensity_ = (getStringOption_("assembly:rank_by") == "intensity");
  1761	    im_weight_sigma_ = getDoubleOption_("assembly:im_weight_sigma");
  1762	    mono_guard_ = getDoubleOption_("charge:mono_averagine_guard");
  1763	    mono_select_ = getFlag_("charge:mono_averagine_select");
  1764	    var_support_ = getFlag_("gate:variance_support");
  1765	    corr_power_ = getDoubleOption_("assembly:corr_power");
  1766	    const double min_corr = getDoubleOption_("gate:min_correlation");
  1767	    const int min_corr_pts = getIntOption_("gate:min_correlation_points");
  1768	    const Size min_frags = (Size)getIntOption_("assembly:min_fragments");
  1769	    const Size max_frags = (Size)getIntOption_("assembly:max_fragments");
  1770	    const int max_charge = getIntOption_("max_charge");
  1771	    mzEstimator() = getStringOption_("trace:mz_estimator");   // before any toTrace() call
  1772	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  1773	
  1774	    PeakMap exp;
  1775	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  1776	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  1777	    PeakMap ms1_map;
  1778	    map<pair<int, int>, vector<CompactFrame>> ms2_by_window;
  1779	    CompactStats cstat;
  1780	    auto winKey = [](double lo, double hi) {
  1781	      return make_pair((int)llround(lo * 100.0), (int)llround(hi * 100.0));
  1782	    };
  1783	    const bool stream_load = getFlag_("perf:stream_load");
  1784	    bool streamed = false;
  1785	
  1786	    if (stream_load)
  1787	    {
  1788	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  1789	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  1790	      BrukerTimsFile::Config cfg;
  1791	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  1792	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  1793	      PeakPickerIM spicker;
  1794	      Param sp = spicker.getParameters();
  1795	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  1796	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  1797	      if (const char* m = std::getenv("SPEXTRACT_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  1798	      spicker.setParameters(sp);
  1799	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  1800	      try
  1801	      {
  1802	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  1803	        {
  1804	#ifdef SPEXTRACT_WITH_MZPEAK
  1805	          spx::loadMzPeakStreaming(in, consumer, getIntOption_("threads"));   // consumer counts frames itself
  1806	#else
  1807	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  1808	#endif
  1809	        }
  1810	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  1811	        streamed = true;
  1812	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  1813	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  1814	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  1815	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  1816	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  1817	        if (std::getenv("SPEXTRACT_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  1818	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  1819	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  1820	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
  1821	                      + String(cfg.dia_ms2_n_neighbors) + ")" + clk_() + rss_());
  1822	      }
  1823	      catch (const Exception::BaseException& e)
  1824	      {
  1825	        writeLogWarn_(String("[stream] streaming load failed (") + e.getName()
  1826	                      + "); falling back to loadExperiment. " + e.getMessage());
  1827	      }
  1828	    }
  1829	
  1830	    if (!streamed)
  1831	    {
  1832	      Phase _ph("LOAD(full)");
  1833	      FileHandler().loadExperiment(in, exp, {FileTypes::MZML, FileTypes::MZPEAK, FileTypes::BRUKER_TDF}, log_type_);
  1834	    }
  1835	
  1836	    //-------------------------------------------------------------
  1837	    // Input normalization / validation [C-4]
  1838	    //-------------------------------------------------------------
  1839	    // [stream] The streaming path fills ms1_map/ms2_by_window directly via an IM-aware consumer
  1840	    // (PickCompactConsumer calls ensureIMArrayName), leaving `exp` EMPTY -- so the exp-based IM check
  1841	    // only applies to the non-streaming load. Running it on the streamed (empty) `exp` wrongly aborted
  1842	    // with "no ion-mobility data at MS1", which is why native pre-centroiding aggregation could never
  1843	    // be benchmarked. Streamed data is guarded by the ms1_map.empty() check below instead.
  1844	    if (!streamed)
  1845	    {
  1846	      IMFormat imf = IMTypes::determineIMFormat(exp, 1);
  1847	      if (imf == IMFormat::NONE)
  1848	      {
  1849	        writeLogError_("Error: input has no ion-mobility data at MS1. DIAPseudoSpectra requires diaPASEF (IM DIA) input.");
  1850	        return ILLEGAL_PARAMETERS;
  1851	      }
  1852	    }
  1853	    // deliberate: assumes 1/K0 (VSSC). ms/CCS conversion and FAIMS rejection are Phase 2 [M-2].
  1854	
  1855	    // Centroid IM frames that are still profile, keeping per-peak IM at a tolerance no coarser
  1856	    // than the trace IM tolerance [C-2]. Split MS1 vs MS2 into separate working maps.
  1857	    PeakPickerIM picker;
  1858	    Param pp = picker.getParameters();
  1859	    pp.setValue("pickIMCluster:im_tolerance_cluster", delta_im);
  1860	    pp.setValue("pickIMCluster:ppm_tolerance_cluster", mass_ppm);
  1861	    picker.setParameters(pp);
  1862	
  1863	    // Peak-pick (centroid) all IM frames in PARALLEL. PeakPickerIM is firstprivate so each thread
  1864	    // has its own copy -> the mutable ccs_warning_shown_ flag is not shared (a shared const picker
  1865	    // would be a real data race). pickIMCluster mutates only its own spectrum; distinct indices are
  1866	    // independent. [par-Crit-1]
  1867	    writeLogInfo_("Loaded " + String(exp.size()) + " frames." + clk_() + rss_()); // raw residency peak? [mem]
  1868	    writeLogInfo_("Peak-picking " + String(exp.size()) + " frames (OpenMP)...");
  1869	    // Param is a deep-copy value type (mutable ParamNode root_, defaulted copy) so firstprivate
  1870	    // gives each thread a fully independent picker -> no refcount/COW race. pickIMCluster can throw
  1871	    // (e.g. unexpected IM format); an exception escaping an OMP region terminates the process, so
  1872	    // capture it and rethrow serially. [par-Crit-1, code-review]
  1873	    std::exception_ptr pick_err;
  1874	    #pragma omp parallel for firstprivate(picker) schedule(dynamic, 16)
  1875	    for (long i = 0; i < (long)exp.size(); ++i)
  1876	    {
  1877	      try
  1878	      {
  1879	        MSSpectrum& s = exp[i];
  1880	        if (!s.containsIMData()) continue;
  1881	        if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  1882	        ensureIMArrayName(s); // so MassTraceDetection reads per-peak IM (IM-aware tracing) [C-1]
  1883	      }
  1884	      catch (...)
  1885	      {
  1886	        #pragma omp critical
  1887	        if (!pick_err) pick_err = std::current_exception();
  1888	      }
  1889	    }
  1890	    if (pick_err) std::rethrow_exception(pick_err);
  1891	
  1892	    // Serial dispatch: MOVE (not copy) frames into the MS1 map / per-window MS2 maps to avoid
  1893	    // transient memory doubling; container inserts aren't thread-safe so this stays serial.
  1894	    if (!streamed)
  1895	    for (MSSpectrum& s : exp)
  1896	    {
  1897	      if (!s.containsIMData()) continue;
  1898	      if (s.getMSLevel() == 1)
  1899	      {
  1900	        ms1_map.addSpectrum(std::move(s));
  1901	      }
  1902	      else if (s.getMSLevel() == 2 && !s.getPrecursors().empty())
  1903	      {
  1904	        const OpenMS::Precursor& pr = s.getPrecursors()[0];
  1905	        double lo = pr.getMZ() - pr.getIsolationWindowLowerOffset();
  1906	        double hi = pr.getMZ() + pr.getIsolationWindowUpperOffset();
  1907	        ms2_by_window[winKey(lo, hi)].push_back(compactify(s, cstat));
  1908	      }
  1909	    }
  1910	    exp.clear(true); // frames moved out; release the container
  1911	    {
  1912	      size_t cb = 0, cp = 0;
  1913	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) { cb += f.bytes(); cp += f.mzq.size(); }
  1914	      const size_t lost = cstat.no_im_array + cstat.size_mismatch + cstat.bad_mz + cstat.bad_im;
  1915	      if (lost)
  1916	      {
