   701	    for (size_t i = 1; i < xic.size(); ++i)
   702	    {
   703	      const double g = xic[i].first - xic[i - 1].first;
   704	      if (g > 0) d.push_back(g);
   705	    }
   706	    if (d.empty()) return 0;
   707	    nth_element(d.begin(), d.begin() + d.size() / 2, d.end());
   708	    const double dt = d[d.size() / 2];                 // median, not mean: gaps are heavy-tailed
   709	    if (dt <= 0.0) return 0;
   710	    const double want = scale_sec / dt;                // desired support, in SAMPLES
   711	    if (want < 2.0) return 0;                          // finer than one step: nothing to smooth
   712	    const int j = (int)std::lround(std::log2(want));
   713	    return std::max(0, std::min(j, 4));                // level 5 spans ~64 samples, wider than any peak here
   714	  }
   715	
   716	  /// Build the per-window FragGrid from IM-sorted fragment traces.
   717	  FragGrid buildFragGrid(const vector<Trace>& frags)
   718	  {
   719	    FragGrid g;
   720	    // union of all fragment RTs -> the common grid
   721	    for (const auto& f : frags) for (const auto& p : f.xic) g.rt.push_back(p.first);
   722	    sort(g.rt.begin(), g.rt.end());
   723	    g.rt.erase(unique(g.rt.begin(), g.rt.end()), g.rt.end());
   724	    const double G = (double)g.rt.size();
   725	    g.mean.resize(frags.size());
   726	    g.invnorm.resize(frags.size());
   727	    g.off.resize(frags.size() + 1, 0);
   728	    size_t total = 0;
   729	    for (const auto& f : frags) total += f.xic.size();
   730	    g.flat.reserve(total);
   731	    for (size_t i = 0; i < frags.size(); ++i)
   732	    {
   733	      double sum = 0, sumsq = 0;
   734	      g.off[i] = (uint32_t)g.flat.size();
   735	      for (const auto& p : frags[i].xic)
   736	      {
   737	        int gi = (int)(lower_bound(g.rt.begin(), g.rt.end(), p.first) - g.rt.begin());
   738	        g.flat.emplace_back(gi, (float)p.second);
   739	        sum += p.second; sumsq += p.second * p.second;
   740	      }
   741	      g.mean[i] = sum / G;
   742	      double var = sumsq - G * g.mean[i] * g.mean[i];
   743	      g.invnorm[i] = var > 0 ? 1.0 / sqrt(var) : 0.0; // 0 => constant/degenerate -> never correlates
   744	    }
   745	    g.off[frags.size()] = (uint32_t)g.flat.size();   // CSR sentinel
   746	    return g;
   747	  }
   748	}
