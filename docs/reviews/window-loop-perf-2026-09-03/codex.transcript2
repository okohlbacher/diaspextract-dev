   376	  /// [compact] Quantised frame store for the per-window buffer.
   377	  ///
   378	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   379	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   380	  /// cores (diaTracer uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   381	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   382	  /// that is about to trace it, freeing the compact copy immediately.
   383	  ///
   384	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   385	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   386	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   387	  ///   intensity: float32, unchanged (Peak1D already stores float)
   388	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   389	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   390	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   391	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   392	
   393	  struct CompactFrame
   394	  {
   395	    double rt = 0.0;
   396	    vector<uint32_t> mzq;
   397	    vector<float> inten;
   398	    vector<uint16_t> imq;
   399	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   400	  };
   401	
   402	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   403	  /// [adv-fix] The first version CLAMPED out-of-range 1/K0 to IM_LO/IM_HI, which would pin outliers
   404	  /// from many frames onto two artificial, perfectly-aligned mobility values — manufacturing spurious
   405	  /// traces out of nothing. NaN also passed straight through clamp into llround (UB on unsigned
   406	  /// conversion). Dropping + counting is the only defensible behaviour.
   407	  struct CompactStats
   408	  {
   409	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   410	    /// merge per-frame stats after a parallel batch [perf-load]
   411	    CompactStats& operator+=(const CompactStats& o)
   412	    {
   413	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   414	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   415	      return *this;
   416	    }
   417	  };
   418	
   419	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   420	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   421	  {
   422	    CompactFrame f;
   423	    f.rt = s.getRT();
   424	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   425	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   426	    const Size n = s.size();
   427	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
   428	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   429	    for (Size i = 0; i < n; ++i)
   430	    {
   431	      const double mz = s[i].getMZ();
   432	      const double imv = (double)im[i];
   433	      // [adv-fix] validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   434	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   435	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   436	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   437	      f.inten.push_back(s[i].getIntensity());
   438	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   439	      ++st.kept;
   440	    }
   441	    return f;
   442	  }
