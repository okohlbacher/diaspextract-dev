+trap 'rm -rf "$S"' EXIT
+mkdir "$LOCK" 2>/dev/null || { echo "REFUSED: another deploy holds $LOCK ($(cat "$LOCK/owner" 2>/dev/null || echo 'owner unknown')) - nothing changed"; exit 1; }
+COMMITTED=0; PROMOTED=""
+trap finish EXIT
