 2292|     static size_t kBatchMS1_() { static const size_t v = []{ const char* e = std::getenv("SPEXTRACTOR_PICK_BATCH_MS1");
 2293|       const long x = e ? std::atol(e) : 0; return x > 0 ? (size_t)x : (size_t)0; }();
