    57	        }
    58	      }
    59	
    60	      // compute the singular-value decomposition of A
    61	      Eigen::JacobiSVD<Eigen::MatrixXd> svd (A, Eigen::ComputeThinU | Eigen::ComputeThinV);
    62	
    63	      Eigen::VectorXd B (order_ + 1);
    64	      for (UInt i = 0; i <= order_; ++i)
    65	      {
    66	        B(i) = svd.matrixV()(0, i) / svd.singularValues()(i);
    67	      }
    68	
    69	      // compute B*transpose(U)*b, where b is the unit vector b=[1 0 ... 0]
    70	      for (UInt i = 0; i < frame_size_; ++i)
    71	      {
    72	        coeffs_[(nl + 1) * frame_size_ - i - 1] = 0;
    73	        for (UInt j = 0; j <= order_; ++j)
    74	        {
    75	          coeffs_[(nl + 1) * frame_size_ - i - 1] += B(j) * svd.matrixU()(i, j);
