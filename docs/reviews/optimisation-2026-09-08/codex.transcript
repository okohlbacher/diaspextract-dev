   418	    // Step 3: Split mass trace according to detected peaks
   419	    // *********************************************************************
   420	
   421	    // if only one maximum exists: finished!
   422	    if (maxes.size() == 1)
   423	    {
   424	      bool pw_ok = true;
   425	      bool snr_ok = true;
   426	
   427	      // *********************************************************************
   428	      // Step 3.1: check mass trace length criteria (if fixed filter is enabled)
   429	      // *********************************************************************
   430	      if (pw_filtering_ == "fixed")
   431	      {
   432	        double act_fwhm(mt.estimateFWHM(true));
   433	        if (act_fwhm < min_fwhm_ || act_fwhm > max_fwhm_)
   434	        {
