     4	// every CI platform -- including Windows, which has no sqlite3.h. Only the tool needs this file.
     5	#pragma once
     6	#include <OpenMS/FORMAT/TdfMzCalibration.h>   // the copy the OpenMS patch installs; same header as src/TdfMzCalibration.h
     7	#include <sqlite3.h>
     8	#include <cmath>
     9	#include <limits>
    10	#include <string>
    11	#include <vector>
    12	
    13	namespace spextractor
    14	{
    15	// ---------------------------------------------------------------------------------------------
    16	// Read the calibration a .d actually uses, straight from analysis.tdf with the sqlite3 C API.
    17	//
    18	// This deliberately does NOT use SQLiteCpp. That wrapper is an OpenMS in-tree extern whose headers
    19	// are not on the include path of an OpenMS *installation*, so the two callers used to sit behind
    20	// `#if __has_include(<SQLiteCpp/SQLiteCpp.h>)` -- false for the documented public build -- and fell
    21	// back to "built without SQLiteCpp", which made the integer detector silently revert to `openms`.
    22	// The stock-OpenMS CI caught it: 9/10 checks passed and the tenth said the shipped detector never
    23	// ran. sqlite3.h is what OpenMS itself links, so a missing SQLite is now a compile error, never a
    24	// behaviour switch.
    25	//
    26	// The row is the one the FRAMES reference (Frames.MzCalibration), not "the only row": PXD017703
    27	// acquisitions carry two rows with every frame on Id 1. Refuses when frames reference more than
    28	// one row (per-frame recalibration, unsupported). t1_by_frame[id] = Frames.T1, T1_ref when NULL;
    29	// index 0 is never a frame (Ids start at 1) and is left for the caller to treat as a sentinel.
    30	// ---------------------------------------------------------------------------------------------
    31	inline bool loadTdfCalibration(const std::string& tdf, TdfMzCalibration& cal,
    32	                               std::vector<double>& t1_by_frame, std::string& why)
    33	{
    34	  sqlite3* db = nullptr;
    35	  if (sqlite3_open_v2(tdf.c_str(), &db, SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK)
    36	  { why = std::string("cannot open ") + tdf + ": " + (db ? sqlite3_errmsg(db) : "out of memory"); sqlite3_close(db); return false; }
    37	  sqlite3_stmt* st = nullptr;
    38	  long long cal_id = -1; int ncal = 0;
    39	  if (sqlite3_prepare_v2(db, "SELECT DISTINCT MzCalibration FROM Frames", -1, &st, nullptr) == SQLITE_OK)
    40	  {
    41	    while (sqlite3_step(st) == SQLITE_ROW) { cal_id = sqlite3_column_int64(st, 0); ++ncal; }
    42	    sqlite3_finalize(st); st = nullptr;
    43	    if (ncal != 1) { why = "frames reference " + std::to_string(ncal) + " distinct MzCalibration rows"; sqlite3_close(db); return false; }
    44	  }
    45	  else
    46	  {
    47	    // Frames has no MzCalibration column (a minimal or very old tdf): fall back to the single-row
    48	    // rule rather than refusing -- the reference is then unambiguous only if there IS one row.
    49	    sqlite3_finalize(st); st = nullptr;
    50	    if (sqlite3_prepare_v2(db, "SELECT Id FROM MzCalibration", -1, &st, nullptr) == SQLITE_OK)
    51	      while (sqlite3_step(st) == SQLITE_ROW) { cal_id = sqlite3_column_int64(st, 0); ++ncal; }
    52	    sqlite3_finalize(st); st = nullptr;
    53	    if (ncal != 1) { why = "Frames has no MzCalibration column and MzCalibration has " + std::to_string(ncal) + " rows (need exactly 1)"; sqlite3_close(db); return false; }
    54	  }
    55	  if (sqlite3_prepare_v2(db, "SELECT ModelType, DigitizerTimebase, DigitizerDelay, C0, C1, C2, T1, dC1, dC2, C3, C4 "
    56	                             "FROM MzCalibration WHERE Id = ?", -1, &st, nullptr) != SQLITE_OK
    57	      || sqlite3_bind_int64(st, 1, cal_id) != SQLITE_OK || sqlite3_step(st) != SQLITE_ROW)
    58	  { why = "no MzCalibration row with Id " + std::to_string(cal_id); sqlite3_finalize(st); sqlite3_close(db); return false; }
    59	  cal.model_type = sqlite3_column_int(st, 0);
    60	  cal.digitizer_timebase = sqlite3_column_double(st, 1); cal.digitizer_delay = sqlite3_column_double(st, 2);
    61	  cal.C0 = sqlite3_column_double(st, 3); cal.C1 = sqlite3_column_double(st, 4);
    62	  cal.C2 = (sqlite3_column_type(st, 5) == SQLITE_NULL) ? std::numeric_limits<double>::quiet_NaN()
    63	                                                       : sqlite3_column_double(st, 5);
    64	  cal.T1_ref = sqlite3_column_double(st, 6); cal.dC1 = sqlite3_column_double(st, 7); cal.dC2 = sqlite3_column_double(st, 8);
    65	  cal.C3 = sqlite3_column_double(st, 9); cal.C4 = sqlite3_column_double(st, 10);
    66	  sqlite3_finalize(st); st = nullptr;
    67	  if (std::isnan(cal.C2)) { why = "MzCalibration C2 is NULL (missing, not zero)"; sqlite3_close(db); return false; }
    68	  if (!cal.isSupported()) { why = cal.unsupportedReason(); sqlite3_close(db); return false; }
    69	  t1_by_frame.clear();
    70	  if (sqlite3_prepare_v2(db, "SELECT Id, T1 FROM Frames", -1, &st, nullptr) == SQLITE_OK)
    71	    while (sqlite3_step(st) == SQLITE_ROW)
    72	    {
    73	      const long long id = sqlite3_column_int64(st, 0);
    74	      if (id < 0 || id > 10000000) { why = "implausible Frames.Id"; sqlite3_finalize(st); sqlite3_close(db); return false; }
    75	      if ((size_t)id >= t1_by_frame.size()) t1_by_frame.resize((size_t)id + 1, cal.T1_ref);
    76	      t1_by_frame[(size_t)id] = (sqlite3_column_type(st, 1) == SQLITE_NULL) ? cal.T1_ref : sqlite3_column_double(st, 1);
    77	    }
    78	  sqlite3_finalize(st); sqlite3_close(db);
    79	  if (t1_by_frame.size() < 2) { why = "no Frames rows"; return false; }
    80	  return true;
    81	}
    82	} // namespace spextractor
     1	// SpeXtractor: streaming diaPASEF load from an .mzpeak archive through the mzPeak C++ library
     2	// (github.com/OpenMS/mzpeak, fork okohlbacher/mzpeak-openms). Mirrors BrukerTimsFile::
     3	// loadDIAStreaming's contract so PickCompactConsumer sees the same stream: every MS1 spectrum
     4	// first (frame order), then one MSSpectrum per (MS2 frame, isolation window) holding only the
     5	// peaks inside that window's 1/K0 band, handed over serially in frame order.
     6	//
     7	// mzPeak stores a diaPASEF frame as ONE spectrum carrying N precursors (one per window, each
     8	// with an ion-mobility band) and a per-peak ion-mobility array; ims-compact archives carry raw
     9	// TOF and the library reconstructs m/z with the archive's own two-point transform. Peaks arrive
    10	// mobility-major, so each per-window spectrum is m/z-sorted here.
    11	//
    12	// ponytail: decode is parallel over contiguous frame ranges with one Index per thread (decodes
    13	// serialise on a reader's mutex); the hand-off is serial. No caching beyond the library's own.
    14	#pragma once
    15	#ifdef SPEXTRACTOR_WITH_MZPEAK
    16	
    17	#include "TdfLoad.h"
    18	#include <mzpeak/open.h>
    19	#include <mzpeak/index.h>
    20	#include <mzpeak/spectra.h>
    21	#include <mzpeak/spectrum.h>
    22	#include <mzpeak/spectrum_metadata.h>
    23	
    24	// [D1 exact m/z] the archive stores raw TOF behind a two-point transform; the exact ModelType-1 calibration
    25	// lives only in the embedded vendor/analysis.tdf.gz. Recover tof = round((sqrt(mz) - c0) / c1) and re-apply
    26	// TdfMzCalibration per frame. ON BY DEFAULT and fail-closed; SPEXTRACTOR_MZPEAK_EXACT=0 disables it and
    27	// falls back to the archive's two-point transform, which costs ~12% of identified peptides.
    28	#include <OpenMS/FORMAT/TdfMzCalibration.h>   // installed by the OpenMS patch (same header as src/TdfMzCalibration.h)
    29	#include <zip.h>
    30	#include <zlib.h>
    31	#include <arrow/api.h>
    32	#include <arrow/io/memory.h>
    33	#include <parquet/file_reader.h>
    34	#include <parquet/arrow/schema.h>
    35	#include <cstdio>
    36	#include <cstdlib>
    37	#include <unistd.h>
    38	
    39	#include <OpenMS/KERNEL/MSSpectrum.h>
    40	#include <OpenMS/METADATA/Precursor.h>
    41	#include <OpenMS/CONCEPT/Exception.h>
    42	#include <OpenMS/IONMOBILITY/IMDataConverter.h>
    43	#include <OpenMS/FORMAT/DATAACCESS/SwathFileConsumer.h>
    44	
    45	#include <algorithm>
    46	#include <cmath>
    47	#include <exception>
    48	#include <limits>
    49	#include <memory>
    50	#include <string>
    51	#include <vector>
    52	#include <cstring>
    53	#include <stdexcept>
    54	#ifdef _OPENMP
    55	#include <omp.h>
    56	#endif
    57	
    58	namespace spx
    59	{
    60	  struct MzPeakWin { double lo, hi, im_lo, im_hi; };
    61	
    62	  /// Calibration provenance of the last mzPeak load (the archive's two-point tof transform, applied by the
    63	  /// library; NOT the TDF table model). Stamped into the output instead of BrukerTimsFile's state.
    64	  inline std::string& lastMzPeakCalibration() { static std::string s = "unset"; return s; }
    65	
    66	
    67	  /// Exact TOF->m/z for an ims-compact archive: (c0, c1) from the peaks table's column metadata, the
    68	  /// MzCalibration row and Frames.T1 from the embedded vendor tdf. Throws on anything missing (fail closed).
    69	  struct MzPeakExactMz
    70	  {
    71	    double c0 = 0, c1 = 0;
    72	    spextractor::TdfMzCalibration cal;
    73	    std::vector<double> t1_by_frame;          // index = Frames.Id
    74	    bool enabled = false;
    75	
    76	    static std::vector<char> readMember_(zip_t* z, const char* name, zip_int64_t from = 0, zip_int64_t len = -1)
    77	    {
    78	      zip_int64_t idx = zip_name_locate(z, name, 0);
    79	      if (idx < 0) throw std::runtime_error(std::string("mzpeak: member missing: ") + name);
    80	      zip_stat_t st; zip_stat_index(z, (zip_uint64_t)idx, 0, &st);
    81	      if (len < 0) len = (zip_int64_t)st.size - from;
    82	      zip_file_t* f = zip_fopen_index(z, (zip_uint64_t)idx, 0);
    83	      if (!f) throw std::runtime_error(std::string("mzpeak: cannot open member ") + name);
    84	      if (from > 0 && zip_fseek(f, from, SEEK_SET) != 0) { zip_fclose(f); throw std::runtime_error(std::string("mzpeak: cannot seek in ") + name + " (member not stored?)"); }
    85	      std::vector<char> buf((size_t)len); zip_int64_t got = 0;
    86	      while (got < len) { zip_int64_t n = zip_fread(f, buf.data() + got, (zip_uint64_t)(len - got)); if (n <= 0) break; got += n; }
    87	      zip_fclose(f);
    88	      if (got != len) throw std::runtime_error(std::string("mzpeak: short read of ") + name);
    89	      return buf;
    90	    }
    91	
    92	    explicit MzPeakExactMz(const std::string& path)
    93	    {
    94	      int err = 0; zip_t* z = zip_open(path.c_str(), ZIP_RDONLY, &err);
    95	      if (!z) throw std::runtime_error("mzpeak: zip_open failed on " + path);
    96	      try
    97	      {
    98	        // (1) two-point transform params from the parquet footer of spectra_peaks.parquet (stored member)
    99	        zip_int64_t idx = zip_name_locate(z, "spectra_peaks.parquet", 0);
   100	        if (idx < 0) throw std::runtime_error("mzpeak: spectra_peaks.parquet missing");
   101	        zip_stat_t st; zip_stat_index(z, (zip_uint64_t)idx, 0, &st);
   102	        std::vector<char> tail = readMember_(z, "spectra_peaks.parquet", (zip_int64_t)st.size - 8, 8);
   103	        uint32_t flen; std::memcpy(&flen, tail.data(), 4);
   104	        if (std::string(tail.data() + 4, 4) != "PAR1") throw std::runtime_error("mzpeak: peaks member is not parquet");
   105	        std::vector<char> footer = readMember_(z, "spectra_peaks.parquet", (zip_int64_t)st.size - 8 - flen, flen);
   106	        uint32_t flen2 = flen;
   107	        std::shared_ptr<parquet::FileMetaData> md = parquet::FileMetaData::Make(footer.data(), &flen2);
   108	        std::shared_ptr<arrow::Schema> schema;
   109	        parquet::ArrowReaderProperties props;
   110	        PARQUET_THROW_NOT_OK(parquet::arrow::FromParquetSchema(md->schema(), props, md->key_value_metadata(), &schema));
   111	        auto point = schema->GetFieldByName("point");
   112	        if (!point) throw std::runtime_error("mzpeak: no 'point' column");
   113	        auto tof = std::dynamic_pointer_cast<arrow::StructType>(point->type())->GetFieldByName("tof");
   114	        if (!tof || !tof->metadata()) throw std::runtime_error("mzpeak: no tof column / metadata (not an ims-compact archive?)");
   115	        auto tp = tof->metadata()->Get("mzpeak:transform_params");
   116	        if (!tp.ok()) throw std::runtime_error("mzpeak: tof column has no mzpeak:transform_params");
   117	        if (std::sscanf(tp->c_str(), "%lf,%lf", &c0, &c1) != 2 || !(c1 > 0)) throw std::runtime_error("mzpeak: bad transform_params " + *tp);
   118	
   119	        // (2) the vendor tdf: gunzip vendor/analysis.tdf.gz to a temp file, read MzCalibration + Frames.T1
   120	        // --no-vendor archives have no embedded tdf: accept a sidecar via SPEXTRACTOR_MZPEAK_TDF=<analysis.tdf.gz>
   121	        std::vector<char> gz;
   122	        if (const char* side = std::getenv("SPEXTRACTOR_MZPEAK_TDF"))
   123	        {
   124	          FILE* sf = std::fopen(side, "rb"); if (!sf) throw std::runtime_error(std::string("mzpeak: cannot read SPEXTRACTOR_MZPEAK_TDF ") + side);
   125	          char b[1 << 16]; size_t n; while ((n = std::fread(b, 1, sizeof b, sf)) > 0) gz.insert(gz.end(), b, b + n); std::fclose(sf);
   126	        }
   127	        else gz = readMember_(z, "vendor/analysis.tdf.gz");
   128	        char tmpl[] = "/tmp/spx_mzpeak_tdf_XXXXXX"; int fd = mkstemp(tmpl); if (fd < 0) throw std::runtime_error("mzpeak: mkstemp");
   129	        close(fd);
   130	        { z_stream zs{}; inflateInit2(&zs, 16 + MAX_WBITS); FILE* out = std::fopen(tmpl, "wb");
   131	          zs.next_in = (Bytef*)gz.data(); zs.avail_in = (uInt)gz.size(); std::vector<char> ob(1 << 20); int rc;
   132	          do { zs.next_out = (Bytef*)ob.data(); zs.avail_out = (uInt)ob.size(); rc = inflate(&zs, Z_NO_FLUSH);
   133	               if (rc != Z_OK && rc != Z_STREAM_END) { std::fclose(out); inflateEnd(&zs); throw std::runtime_error("mzpeak: gunzip of analysis.tdf.gz failed"); }
   134	               std::fwrite(ob.data(), 1, ob.size() - zs.avail_out, out); } while (rc != Z_STREAM_END);
   135	          inflateEnd(&zs); std::fclose(out); }
   136	        { std::string why;
   137	          if (!spextractor::loadTdfCalibration(std::string(tmpl), cal, t1_by_frame, why))
   138	            throw std::runtime_error("mzpeak: " + why); }
   139	        std::remove(tmpl);
   140	        enabled = true;
   141	      }
   142	      catch (...) { zip_close(z); throw; }
   143	      zip_close(z);
   144	    }
   145	
   146	    /// Recover the integer tof from the archive's two-point m/z and re-apply the exact model.
   147	    void exact(std::vector<double>& mz, long frame_id) const
   148	    {
   149	      // Fail rather than fall back to the reference T1: substituting it for an unknown frame stamps
   150	      // masses calibrated at the wrong temperature as "exact", which is silent wrongness the
   151	      // provenance record would then vouch for.
   152	      if (frame_id < 0 || (size_t)frame_id >= t1_by_frame.size())
   153	        throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   154	              "mzPeak exact calibration: no tdf T1 for frame", std::to_string(frame_id));
   155	      const double b = cal.frameFactor(t1_by_frame[(size_t)frame_id]);
   156	      for (double& v : mz)
   157	      {
   158	        if (!std::isfinite(v) || v <= 0.0)
   159	          throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   160	                "mzPeak exact calibration: non-positive archive m/z", std::to_string(v));
   161	        const double tof = std::llround((std::sqrt(v) - c0) / c1);
   162	        const double e = cal.tofToMz(tof, b);
   163	        if (!std::isfinite(e))
   164	          throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   165	                "mzPeak exact calibration produced a non-finite m/z at tof", std::to_string(tof));
   166	        v = e;
   167	      }
   168	    }
   169	  };
   170	
   171	  /// One decoded frame split per window (index-aligned with `wins` of that frame).
   172	  inline void frameToSpectra_(const MzPeak::Spectrum& sp, double rt, std::size_t frame_idx,
   173	                              const std::vector<MzPeakWin>& wins, std::vector<OpenMS::MSSpectrum>& out,
   174	                              const MzPeakExactMz* exact = nullptr, long frame_id = -1)
   175	  {
   176	    using namespace OpenMS;
   177	    std::vector<double> mz_exact;
   178	    if (exact && exact->enabled) { mz_exact = sp.mz(); exact->exact(mz_exact, frame_id); }
   179	    const std::vector<double>& mz = (exact && exact->enabled) ? mz_exact : sp.mz();
   180	    const std::vector<float>& in = sp.intensity();
   181	    const std::vector<double>& im = sp.ion_mobility_array();
   182	    // Array lengths must agree. Truncating to the shorter one turns a malformed archive into a
   183	    // smaller frame that looks valid, and the peaks that vanish are never reported anywhere.
   184	    if (mz.size() != in.size())
   185	      throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   186	            "mzPeak frame has mismatched m/z and intensity array lengths",
   187	            std::to_string(mz.size()) + " vs " + std::to_string(in.size()));
   188	    const std::size_t n = mz.size();
   189	    const bool have_im = im.empty() || im.size() >= n;
   190	    if (!im.empty() && im.size() < n)
   191	      throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   192	            "mzPeak frame has a short ion-mobility array", std::to_string(im.size()));
   193	    out.assign(wins.size(), MSSpectrum());
   194	    for (std::size_t w = 0; w < wins.size(); ++w)
   195	    {
   196	      const MzPeakWin& win = wins[w];
   197	      MSSpectrum& spec = out[w];
   198	      spec.setRT(rt);
   199	      spec.setMSLevel(wins.size() == 1 && !(win.lo < win.hi) ? 1 : 2);
   200	      spec.setDriftTimeUnit(DriftTimeUnit::VSSC);
   201	      spec.setNativeID("mzpeak=" + std::to_string(frame_idx) + " window=" + std::to_string(w));
   202	      if (spec.getMSLevel() == 2)
   203	      {
   204	        Precursor prec;
   205	        prec.setMZ(0.5 * (win.lo + win.hi));
   206	        prec.setIsolationWindowLowerOffset(0.5 * (win.hi - win.lo));
   207	        prec.setIsolationWindowUpperOffset(0.5 * (win.hi - win.lo));
   208	        spec.setPrecursors({prec});
   209	        spec.setMetaValue("ion mobility lower limit", win.im_lo);
   210	        spec.setMetaValue("ion mobility upper limit", win.im_hi);
   211	      }
   212	      DataArrays::FloatDataArray im_array;
   213	      IMDataConverter::setIMUnit(im_array, DriftTimeUnit::VSSC);
   214	      spec.reserve(n / wins.size() + 64); im_array.reserve(n / wins.size() + 64);
   215	      for (std::size_t k = 0; k < n; ++k)
   216	      {
   217	        const double k0 = have_im ? im[k] : 0.0;
   218	        if (have_im && (k0 < win.im_lo || k0 > win.im_hi)) continue;
   219	        if (!(in[k] > 0)) continue;
   220	        spec.emplace_back(mz[k], in[k]);
   221	        im_array.push_back(static_cast<float>(k0));
   222	      }
   223	      if (spec.empty()) continue;
   224	      // mobility-major on disk -> sort by m/z, carrying the IM array along
   225	      std::vector<std::size_t> ord(spec.size());
   226	      for (std::size_t k = 0; k < ord.size(); ++k) ord[k] = k;
   227	      std::stable_sort(ord.begin(), ord.end(), [&](std::size_t a, std::size_t b) { return spec[a].getMZ() < spec[b].getMZ(); });
   228	      std::vector<Peak1D> sorted; sorted.reserve(spec.size());
   229	      DataArrays::FloatDataArray im_sorted; IMDataConverter::setIMUnit(im_sorted, DriftTimeUnit::VSSC); im_sorted.reserve(spec.size());
   230	      for (std::size_t k : ord) { sorted.push_back(spec[k]); im_sorted.push_back(im_array[k]); }
   231	      spec.clear(false);                                          // peaks only; RT/precursor/meta stay
   232	      for (const Peak1D& pk : sorted) spec.push_back(pk);
   233	      spec.getFloatDataArrays().push_back(std::move(im_sorted));
   234	      spec.setIMPeakType(IMPeakType::IM_PROFILE);
   235	    }
   236	  }
   237	
   238	  /// Stream an .mzpeak run into `consumer` (MS1 first, then MS2 per (frame, window), frame order).
   239	  /// Returns the number of frames seen.
   240	  inline std::size_t loadMzPeakStreaming(const std::string& path, OpenMS::FullSwathFileConsumer& consumer, int threads)
   241	  {
   242	    // 1) metadata sweep (no peak decode): RT, level, windows with IM bands, per frame
   243	    MzPeak::Index index = MzPeak::open(path);
   244	    MzPeak::Spectra spectra = index.spectra();
   245	    const std::size_t n = spectra.size();
   246	    lastMzPeakCalibration() = "mzpeak_two_point_transform (library-applied MS:1003825 from the archive; not the TDF MzCalibration model) archive=" + path.substr(path.find_last_of('/') + 1);
   247	    std::vector<double> rt(n);
   248	    std::vector<long> frame_id(n, -1);
   249	    std::vector<std::vector<MzPeakWin>> wins(n);
   250	    std::vector<std::size_t> ms1, ms2;
   251	    std::unique_ptr<MzPeakExactMz> exact;
   252	    // DEFAULT ON (2026-09-02 18:58): with the exact model recovered from the tdf, mzPeak input gives 12,082 Sage
   253	    // peptides vs 10,785 with the archive's two-point transform (and 12,217 from .d): the transform was 91% of the
   254	    // loss. Fail closed like the .d path: no tdf (embedded or SPEXTRACTOR_MZPEAK_TDF sidecar) -> error, unless
   255	    // SPEXTRACTOR_MZPEAK_EXACT=0 explicitly accepts the two-point m/z.
   256	    const char* ex = std::getenv("SPEXTRACTOR_MZPEAK_EXACT");
   257	    if (!(ex && std::string(ex) == "0"))
   258	    {
   259	      try { exact = std::make_unique<MzPeakExactMz>(path); }
   260	      catch (const std::exception& e)
   261	      {
   262	        throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   263	          std::string("mzPeak input: cannot recover the exact TDF calibration (") + e.what() + "). The archive's two-point transform is ~7 ppm off and costs ~12% peptides; set SPEXTRACTOR_MZPEAK_TDF=<analysis.tdf.gz> or SPEXTRACTOR_MZPEAK_EXACT=0 to accept it.", path);
   264	      }
   265	      lastMzPeakCalibration() = "tdf_table_modeltype1 (recovered from the archive's two-point transform + embedded vendor/analysis.tdf.gz) archive=" + path.substr(path.find_last_of('/') + 1);
   266	    }
   267	    for (std::size_t i = 0; i < n; ++i)
   268	    {
   269	      MzPeak::Spectrum sp = spectra[i];
   270	      const auto& md = sp.metadata();
   271	      rt[i] = md.retention_time.value_or(0.0);
   272	      { const std::string& id = md.id; const auto pos = id.find("frame="); if (pos != std::string::npos) frame_id[i] = std::atol(id.c_str() + pos + 6); }
   273	      if (md.ms_level.value_or(1) == 1) { wins[i] = {MzPeakWin{0, 0, -1e9, 1e9}}; ms1.push_back(i); continue; }
   274	      // Selected ions carry the per-window 1/K0 band. mzpeak-convert 0.9.x writes precursor_index
   275	      // as NULL and the band as NAME-ONLY CV params; the reader then attaches every ion of the
   276	      // frame to the FIRST precursor. So: flatten all ions of the spectrum and match each window
   277	      // to the ion whose selected_ion_mz is its isolation target.
   278	      struct Ion { double mz, lo, hi; };
   279	      std::vector<Ion> ions;
   280	      for (const auto& p : md.precursors)
   281	        for (const auto& si : p.selected_ions)
   282	        {
   283	          Ion ion{si.selected_ion_mz.value_or(-1.0), -1e9, 1e9};
   284	          if (si.ion_mobility_lower_limit && si.ion_mobility_upper_limit) { ion.lo = *si.ion_mobility_lower_limit; ion.hi = *si.ion_mobility_upper_limit; }
   285	          for (const auto& cv : si.parameters)
   286	          {
   287	            if (!cv.name || !cv.value) continue;
   288	            if (cv.name->find("ion mobility lower limit") != std::string::npos) ion.lo = std::stod(*cv.value);
   289	            else if (cv.name->find("ion mobility upper limit") != std::string::npos) ion.hi = std::stod(*cv.value);
   290	          }
   291	          ions.push_back(ion);
   292	        }
   293	      for (const auto& p : md.precursors)
   294	      {
   295	        if (!p.isolation_window.target_mz) continue;
   296	        const double c = *p.isolation_window.target_mz;
   297	        const double lo = c - p.isolation_window.lower_offset.value_or(0.f), hi = c + p.isolation_window.upper_offset.value_or(0.f);
   298	        const Ion* best = nullptr;
   299	        for (const Ion& ion : ions) if (!best || std::fabs(ion.mz - c) < std::fabs(best->mz - c)) best = &ion;
   300	        if (!best || std::fabs(best->mz - c) > 0.05 || best->lo < -1e8 || best->hi > 1e8)
   301	          throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   302	                                                "mzPeak MS2 window without a matching ion-mobility band (spectrum " + std::to_string(i) + ")", std::to_string(c));
   303	        wins[i].push_back(MzPeakWin{lo, hi, best->lo, best->hi});
   304	      }
   305	      if (!wins[i].empty()) ms2.push_back(i);
   306	    }
   307	
   308	    // 2) decode in parallel over contiguous ranges (row-group locality), hand off serially in order
   309	    int nthr = std::max(1, threads);
   310	#ifdef _OPENMP
   311	    nthr = std::min(nthr, std::max(1, omp_get_max_threads()));
   312	#endif
   313	    auto run = [&](const std::vector<std::size_t>& ids)
   314	    {
   315	      const std::size_t per = 12;                                  // frames per thread per batch (~1 row group)
   316	      const std::size_t batch = std::max<std::size_t>(per, per * (std::size_t)nthr);
   317	      for (std::size_t b0 = 0; b0 < ids.size(); b0 += batch)
   318	      {
   319	        const std::size_t b1 = std::min(ids.size(), b0 + batch);
   320	        const int nchunk = (int)((b1 - b0 + per - 1) / per);
   321	        std::vector<std::vector<std::vector<OpenMS::MSSpectrum>>> out((std::size_t)nchunk);
   322	        std::exception_ptr err;
   323	        #pragma omp parallel for schedule(dynamic, 1) num_threads(nthr)
   324	        for (int c = 0; c < nchunk; ++c)
   325	        {
   326	          try
   327	          {
   328	            const std::size_t c0 = b0 + (std::size_t)c * per, c1 = std::min(b1, c0 + per);
   329	            // one reader per THREAD (not per work item): MzPeak::open re-reads the zip directory and
   330	            // every parquet footer; ~1,450 opens cost ~1 h of system time on dataset D (measured 13:55).
   331	            static thread_local std::unique_ptr<MzPeak::Index> tidx;   // Index is neither movable nor copyable:
   332	            static thread_local std::string tidx_path;                  // construct it from the prvalue (elided)
   333	            if (!tidx || tidx_path != path) { tidx.reset(new MzPeak::Index(MzPeak::open(path))); tidx_path = path; }
   334	            MzPeak::Spectra tsp = tidx->spectra();
   335	            std::vector<std::size_t> want(ids.begin() + (std::ptrdiff_t)c0, ids.begin() + (std::ptrdiff_t)c1);
   336	            std::vector<MzPeak::Spectrum> got = tsp.get_spectra_batch(want);
   337	            // A short batch result used to be clamped away with min(), leaving the tail frames as
   338	            // empty spectra: fewer peaks, no warning, and a run that still reports success.
   339	            if (got.size() != want.size())
   340	              throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   341	                    "mzPeak reader returned fewer frames than requested",
   342	                    std::to_string(got.size()) + " of " + std::to_string(want.size()));
   343	            auto& slot = out[(std::size_t)c]; slot.resize(want.size());
   344	            for (std::size_t k = 0; k < want.size(); ++k)
   345	              frameToSpectra_(got[k], rt[want[k]], want[k], wins[want[k]], slot[k], exact.get(), frame_id[want[k]]);
   346	          }
   347	          catch (...)
   348	          {
   349	            #pragma omp critical(mzpeak_err)
   350	            if (!err) err = std::current_exception();
   351	          }
   352	        }
   353	        if (err) std::rethrow_exception(err);
   354	        for (auto& chunk : out) for (auto& frame : chunk) for (auto& spec : frame)
   355	          if (!spec.empty()) consumer.consumeSpectrum(spec);
   356	      }
   357	    };
   358	    run(ms1);
   359	    run(ms2);
   360	    return ms1.size() + ms2.size();
   361	  }
   362	} // namespace spx
   363	#endif // SPEXTRACTOR_WITH_MZPEAK

