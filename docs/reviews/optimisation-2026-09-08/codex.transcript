  1256	  /// [stream] Pick-and-compact consumer: removes the one-shot-read memory floor.
  1257	  ///
  1258	  /// MEASURED: `loadExperiment` reaches 90.3 GB RSS / 99.0 GB peak at t=0s, BEFORE any compaction
  1259	  /// exists — so the compact store (10 B/peak, 20.9 GB for 2.19e9 peaks) can never lower the peak.
  1260	  /// The floor is the whole run being resident at once. BrukerTimsFile::loadDIAStreaming hands us one
  1261	  /// frame at a time, so we peak-pick and compact each frame on arrival and never hold the raw run.
  1262	  ///
  1263	  /// Windows are keyed by the SAME (lo,hi) isolation-window key used downstream, taken from the
  1264	  /// spectrum's own precursor, so routing is identical to the old split - not by swath_nr, whose
  1265	  /// ordering is the reader's business and need not match ours.
  1266	  /// Isolation window identity: (lo*100, hi*100, WindowGroup). The group is part of it because
  1267	  /// one diaPASEF scheme (Meier 2020 "py3", PXD017703) acquires the SAME m/z window in two window
  1268	  /// groups with shifted, overlapping ion-mobility slices ~1.7 s apart in the cycle. Keyed by m/z
  1269	  /// alone the two halves land in one window as all of group A then all of group B (RT not
  1270	  /// monotone, and a precursor outside the overlap would see every other frame empty). Every
  1271	  /// other scheme has one slice per m/z, so for those this key orders and partitions exactly as
  1272	  /// the old (lo, hi) pair did.
  1273	  using WinKey = std::array<int, 3>;
  1274	
  1275	  class PickCompactConsumer : public FullSwathFileConsumer
  1276	  {
  1277	  public:
  1278	    PickCompactConsumer(PeakPickerIM& picker, map<WinKey, vector<CompactFrame>>& windows,
  1279	                        PeakMap& ms1, CompactStats& stats,
  1280	                        std::function<WinKey(double, double, uint32_t)> keyfn)
  1281	      : picker_(picker), windows_(windows), ms1_(ms1), stats_(stats), keyfn_(std::move(keyfn)) {}
  1282	
  1283	    size_t frames_seen = 0;
  1284	
  1285	    /// [perf-load] Pick+compact a BATCH of buffered frames in parallel, then append in arrival
  1286	    /// order. OpenMS hands frames over a strictly serial `for (fid..) consumeSpectrum(spec)` loop,
  1287	    /// so before this the peak picking of 1.26e9 peaks ran on ONE thread and was 53% of total wall
  1288	    /// (measured: 1046 s wall, parallel factor 1.0). Buffering here parallelises it without
  1289	    /// touching the reader. Appending strictly by buffer index keeps the output order identical to
  1290	    /// the serial path; the emitted spectra matched it in m/z and differed in ~2% of intensities at
  1291	    /// the 1e-5..1e-4 relative level (Sage count unchanged).
  1292	    void flush_()
  1293	    {
  1294	      const int n = (int)buf_.size();
  1295	      if (n == 0) return;
  1296	      const double _tf0 = phase_clock_();
  1297	      std::vector<CompactFrame> compacted((size_t)n);
  1298	      std::vector<CompactStats> st((size_t)n);          // per-frame stats, merged serially below
  1299	      PeakPickerIM picker = picker_;                    // Param is a deep-copy value type
  1300	      // SPEXTRACTOR_PICK_SERIAL=1 runs this loop on one thread: the A/B that separates picker
  1301	      // scheduling-sensitivity from downstream chaos.
  1302	      static const bool par_pick = std::getenv("SPEXTRACTOR_PICK_SERIAL") == nullptr;
  1303	      static const bool sched_set = []{ const bool st = std::getenv("SPEXTRACTOR_PICK_STATIC") != nullptr; omp_set_schedule(st ? omp_sched_static : omp_sched_dynamic, st ? 0 : 1); return true; }(); (void)sched_set;
  1304	      std::exception_ptr pick_err;                      // an exception escaping an OMP region aborts
  1305	      // chunk 1: with chunk 8 a 64-frame batch made only 8 chunks = 8 workers
  1306	      #pragma omp parallel for firstprivate(picker) schedule(runtime) if(par_pick)   // SPEXTRACTOR_PICK_STATIC=1 -> static (history-vs-race probe)
  1307	      for (int i = 0; i < n; ++i)
  1308	      {
  1309	        try
  1310	        {
  1311	          auto& s = buf_[(size_t)i];
  1312	          ensureIMArrayName(s);
  1313	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  1314	          ensureIMArrayName(s);
  1315	          compacted[(size_t)i] = compactify(s, st[(size_t)i]);
  1316	          s.clear(true);                                // raw frame dies here, inside the loop
  1317	        }
  1318	        catch (...)
  1319	        {
  1320	          #pragma omp critical(pick_err)
  1321	          if (!pick_err) pick_err = std::current_exception();
  1322	        }
  1323	      }
  1324	      if (pick_err) std::rethrow_exception(pick_err);
  1325	      for (int i = 0; i < n; ++i)
  1326	      {
  1327	        stats_ += st[(size_t)i];
  1328	        windows_[key_[(size_t)i]].push_back(std::move(compacted[(size_t)i]));
  1329	      }
  1330	      flush_wall_() += phase_clock_() - _tf0;
  1331	      buf_.clear(); key_.clear();
  1332	    }
  1333	
  1334	  protected:
  1335	    void consumeMS1Spectrum_(MapType::SpectrumType& s) override
  1336	    {
  1337	      // MS1 stays a PeakMap (MassTraceDetection needs it whole), but its pick is NOT small: 1,343
  1338	      // frames x ~690k raw peaks = 37% of all peaks, and it used to run serially here (~400 s of
  1339	      // LOAD, measured 2026-09-02). Buffer and pick in parallel like MS2; order is kept by index.
  1340	      ms1_buf_.push_back(std::move(s));
  1341	      ++frames_seen;
  1342	      if (ms1_buf_.size() >= kBatch) flushMS1_();
  1343	    }
  1344	
  1345	    void flushMS1_()
  1346	    {
  1347	      const int n = (int)ms1_buf_.size();
  1348	      if (n == 0) return;
  1349	      const double _tf0 = phase_clock_();
  1350	      PeakPickerIM picker = picker_;
  1351	      std::exception_ptr pick_err;
  1352	      #pragma omp parallel for firstprivate(picker) schedule(dynamic, 1)
  1353	      for (int i = 0; i < n; ++i)
  1354	      {
  1355	        try
  1356	        {
  1357	          auto& s = ms1_buf_[(size_t)i];
  1358	          ensureIMArrayName(s);
  1359	          if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  1360	          ensureIMArrayName(s);
  1361	        }
  1362	        catch (...)
  1363	        {
  1364	          #pragma omp critical(pick_err_ms1)
  1365	          if (!pick_err) pick_err = std::current_exception();
  1366	        }
  1367	      }
  1368	      if (pick_err) std::rethrow_exception(pick_err);
  1369	      for (auto& s : ms1_buf_) ms1_.addSpectrum(std::move(s));
  1370	      ms1_buf_.clear();
  1371	      flush_wall_() += phase_clock_() - _tf0;
  1372	    }
  1373	
  1374	    void consumeSwathSpectrum_(MapType::SpectrumType& s, size_t /*swath_nr*/) override
  1375	    {
  1376	      const auto& prec = s.getPrecursors();
  1377	      if (prec.empty()) return;                      // no isolation window -> not routable
  1378	      const double c = prec[0].getMZ();
  1379	      const double lo = c - prec[0].getIsolationWindowLowerOffset();
  1380	      const double hi = c + prec[0].getIsolationWindowUpperOffset();
  1381	      flushMS1_();                                   // MS1 arrives first; pick it before any MS2 work
  1382	      key_.push_back(keyfn_(lo, hi, windowGroupOf(s.getNativeID())));
  1383	      buf_.push_back(std::move(s));                  // pick+compact deferred to flush_()
  1384	      ++frames_seen;
  1385	      if (buf_.size() >= kBatch) flush_();
  1386	    }
  1387	
  1388	    void ensureMapsAreFilled_() override { flushMS1_(); flush_(); }   // pick up the tails
  1389	
  1390	  private:
  1391	    /// deliberate: 256 frames is ~1 GB of raw buffer at ~37k peaks/frame -- 2.5 work items per
  1392	    /// thread at 100 threads (64 gave 8 chunks of 8 = 8 workers), small next to the 12 GB compact
  1393	    /// store.
  1394	    static const size_t kBatch = 256;
  1395	    std::vector<MapType::SpectrumType> buf_;
  1396	    std::vector<WinKey> key_;
  1397	    PeakPickerIM& picker_;
  1398	    std::vector<MapType::SpectrumType> ms1_buf_;   // MS1 frames awaiting the parallel pick
  1399	    map<WinKey, vector<CompactFrame>>& windows_;
  1400	    PeakMap& ms1_;
  1401	    CompactStats& stats_;
  1402	    std::function<WinKey(double, double, uint32_t)> keyfn_;
  1403	  };
  1404	
  1405	  /// Per-window scoring statistics from IM-sorted fragment traces (see FragStats).
  1406	  /// What the scorer needs per window, now that a fragment's profile is a span in the window's
  1407	  /// own frame sequence: the Pearson denominator G (distinct frames carrying a REAL fragment
  1408	  /// point -- not the window's frame count), per-fragment mean and 1/norm over real points, and
  1409	  /// the precursor-to-fragment nearest-frame table. No copy of any profile: the arena is the grid.
  1410	  struct FragStats
  1411	  {
  1412	    vector<double> mean, invnorm;   ///< per fragment, over the full grid of G frames
  1413	    vector<int>    nearest_local;   ///< MS1-store frame -> window frame with real fragment data, or -1
  1414	    size_t G = 0;
  1415	  };
  1416	
  1417	  FragStats buildFragStats(const vector<Trace>& frags, const TraceStore& wst, const TraceStore& ms1st, double delta_rt)
  1418	  {
  1419	    FragStats g;
  1420	    const size_t F = wst.frames();
  1421	    vector<char> used(F, 0);            // window frame carries >= 1 real fragment point
  1422	    for (const auto& f : frags)
  1423	      for (size_t k = 0; k < f.span(); ++k) if (real(wst, f, k)) used[f.frame0 + k] = 1;
  1424	    for (char u : used) g.G += u ? 1 : 0;
  1425	    const double G = (double)g.G;
  1426	    // Precursor points live on MS1 frames; each maps to the NEAREST window frame that carries real
  1427	    // fragment data, within gate:delta_rt, ties to the LATER frame -- the rule the old grid used.
  1428	    vector<uint32_t> uf; uf.reserve(g.G);
  1429	    for (uint32_t f = 0; f < F; ++f) if (used[f]) uf.push_back(f);
  1430	    g.nearest_local.assign(ms1st.frames(), -1);
  1431	    size_t hi = 0;
  1432	    for (size_t m = 0; m < ms1st.frames(); ++m)
  1433	    {
  1434	      const double t = ms1st.frame_rt[m];
  1435	      while (hi < uf.size() && wst.frame_rt[uf[hi]] < t) ++hi;
  1436	      double bd = delta_rt; int gi = -1;
  1437	      if (hi > 0)          { const double d = fabs(wst.frame_rt[uf[hi - 1]] - t); if (d <= bd) { bd = d; gi = (int)uf[hi - 1]; } }
  1438	      if (hi < uf.size())  { const double d = fabs(wst.frame_rt[uf[hi]] - t);     if (d <= bd) { bd = d; gi = (int)uf[hi]; } }
  1439	      g.nearest_local[m] = gi;
  1440	    }
  1441	    g.mean.resize(frags.size()); g.invnorm.resize(frags.size());
  1442	    #pragma omp taskloop default(shared)
  1443	    for (long ii = 0; ii < (long)frags.size(); ++ii)
  1444	    {
  1445	      const Trace& f = frags[(size_t)ii];
  1446	      double sum = 0, sumsq = 0;
  1447	      for (size_t k = 0; k < f.span(); ++k) { const double v = xv(wst, f, k); if (v > 0.0) { sum += v; sumsq += v * v; } }
  1448	      g.mean[ii] = sum / G;
  1449	      const double var = sumsq - G * g.mean[ii] * g.mean[ii];
  1450	      g.invnorm[ii] = var > 0 ? 1.0 / sqrt(var) : 0.0;  // 0 => constant/degenerate -> never correlates
  1451	    }
  1452	    return g;
  1453	  }
  1454	}
  1455	
  1456	class TOPPSpeXtractor : public TOPPBase
  1457	{
  1458	public:
  1459	  TOPPSpeXtractor() :
  1460	    // official=false: SpeXtractor is a STANDALONE tool that links against OpenMS, not a tool IN
  1668	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
  1669	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
  1670	  ///   peak_int > chrom_peak_snr * noise_threshold_int
  1671	  /// so the EFFECTIVE apex threshold is snr*noise, while trace MEMBERSHIP only needs > noise.
  1672	  /// Leaving snr at the OpenMS default 3.0 silently triples the fragment apex threshold.
  1673	  /// the reference implementation deliberately runs MS2 with "more relaxed constraints" than MS1 (Nat Commun 16:95
  1674	  /// Methods) — so MS1 and MS2 get INDEPENDENT snr / min-length here. [recall]
  1675	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
  1676	  /// it is dead from that point on, but at ~20 B/peak (Peak1D 16 + IM float 4) it is ~1.1 GB per
  1677	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
  1678	  vector<Trace> detectTraces_(PeakMap& map, TraceStore& store, double delta_im, double noise,
  1679	                              double snr, double min_len, double min_sample_rate,
  1680	                              double split_valleys, String* span_log = nullptr, int bands = 1)
  1681	  {
  1682	    MassTraceDetection mtd;
  1683	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
  1684	    Param p = mtd.getParameters();
  1685	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
  1686	    p.setValue("noise_threshold_int", noise);
  1687	    p.setValue("chrom_peak_snr", snr);
  1688	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
  1689	    p.setValue("min_trace_length", min_len);
  1690	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
  1691	    // trace extension when occupancy drops below it — an intensity-INDEPENDENT deletion of gappy but
  1692	    // real fragment traces in sparse diaPASEF data. Relaxing it for MS2 is the sole surviving MS2
  1693	    // trace-validity lever. [recall]
  1694	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
  1695	    mtd.setParameters(p);
  1696	
  1697	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
  1698	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
  1699	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
  1700	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
  1701	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
  1702	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
  1703	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
  1704	      ElutionPeakDetection epd;
  1705	      epd.setLogType(ProgressLogger::NONE);
  1706	      Param ep = epd.getParameters();
  1707	      ep.setValue("chrom_fwhm", split_valleys);
  1708	      ep.setValue("width_filtering", "off");
  1709	      ep.setValue("masstrace_snr_filtering", "false");
  1710	      epd.setParameters(ep);
  1711	      vector<MassTrace> out; out.reserve(in.size());
  1712	      epd.detectPeaks(in, out);
  1713	      return out;
  1714	    };
  1715	
  1716	    vector<MassTrace> mts;
  1717	    // [tstage] Sub-stage seconds for this phase. MS1_TRACE runs at 4.8x on 100 threads and is the
  1718	    // second-largest phase on a 2-hour acquisition, and the milestone timer alone cannot say
  1719	    // whether that is the SERIAL band distribution, imbalance across the band detectors, or the
  1720	    // valley split. One line, so the next decision here is measured rather than assumed.
  1721	    double tt_edge = 0, tt_dist = 0, tt_mtd = 0, tt_gather = 0, tt_split = 0;
  1722	    auto tt_now = []() { return std::chrono::steady_clock::now(); };
  1723	    auto tt_s = [](auto a, auto b) { return std::chrono::duration<double>(b - a).count(); };
  1724	    if (bands > 1)
  1725	    {
  1726	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
  1727	      // windows caps us at 24 threads however many cores exist. Fragment traces at
  1728	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
  1729	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
  1730	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
  1731	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
  1732	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
  1733	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
  1734	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
  1735	      auto _te0 = tt_now();
  1736	      vector<double> sample;
  1737	      for (const auto& s : map)
  1738	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
  1739	      sort(sample.begin(), sample.end());
  1740	      vector<double> edge(bands + 1);
  1741	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
  1742	      else
  1743	        for (int b = 0; b <= bands; ++b)
  1744	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
  1745	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
  1746	      vector<double> ().swap(sample);
  1747	
  1748	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
  1749	      // then release the source map so the halo duplicates are the only overhead.
  1750	      tt_edge = tt_s(_te0, tt_now());
  1751	      auto _td0 = tt_now();
  1752	      // [dist-par 2026-09-07] The distribution was SERIAL and, measured, 51% of this phase
  1753	      // (dataset D: 39.0 s of 75.9 s; and raising the band count made the phase strictly worse --
  1754	      // 12/24/48 bands -> 75.0/93.7/147.9 s -- because more bands means more of exactly this
  1755	      // copy). Split the SPECTRA into chunks instead: each chunk builds its own per-band maps
  1756	      // and releases its source spectra as it goes, then the chunks are concatenated in chunk
  1757	      // order. Same spectra, same peaks, same order in every band, so byte-identical -- and the
  1758	      // source still shrinks as the copies grow, which is what keeps the transient at ~1x rather
  1759	      // than 2x the map.
  1760	      int n_thr = 1;
  1761	#ifdef _OPENMP
  1762	      n_thr = omp_get_max_threads();
  1763	#endif
  1764	      const int nchunk = std::max(1, std::min((int)map.size(), 4 * n_thr));
  1765	      vector<vector<PeakMap>> csub((size_t)nchunk, vector<PeakMap>(bands));
  1766	      #pragma omp taskloop grainsize(1) default(shared)
  1767	      for (int ci = 0; ci < nchunk; ++ci)
  1768	      {
  1769	      const size_t sp0 = (size_t)ci * map.size() / nchunk, sp1 = (size_t)(ci + 1) * map.size() / nchunk;
  1770	      for (size_t spi = sp0; spi < sp1; ++spi)
  1771	      {
  1772	        auto& s = map[spi];        // non-const: each spectrum is released once distributed
  1773	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
  1774	        for (int b = 0; b < bands; ++b)
  1775	        {
  1776	          // Size each halo from ITS OWN edge: one h derived from edge[b] under-sizes the upper
  1777	          // side by the ppm growth across the band.
  1778	          const double lo = edge[b] - edge[b] * ppm * 1e-6 * 20.0;
  1779	          const double hi = edge[b + 1] + edge[b + 1] * ppm * 1e-6 * 20.0;
  1780	          MSSpectrum t; t.setRT(s.getRT()); t.setMSLevel(1);
  1781	          OpenMS::DataArrays::FloatDataArray ia;
  1782	          ia.setName(Constants::UserParam::ION_MOBILITY);
  1783	          // [R3, 2026-09-02] spectra arrive m/z-sorted (loader sortByPosition), so the band's peak range is
  1784	          // two lower_bounds instead of a scan of every peak for every band (O(bands x peaks) -> O(bands log
  1785	          // peaks)). Same peaks in the same order -> byte-identical; the scan stays as the unsorted fallback.
  1786	          Size i0 = 0, i1 = s.size();
  1787	          if (s.isSorted())
  1788	          {
  1789	            i0 = (Size)(s.MZBegin(lo) - s.begin());
  1790	            i1 = (Size)(s.MZBegin(hi) - s.begin());
  1791	            t.reserve(i1 - i0); ia.reserve(i1 - i0);
  1792	            for (Size i = i0; i < i1; ++i) { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1793	          }
  1794	          else
  1795	            for (Size i = 0; i < s.size(); ++i)
  1796	              if (s[i].getMZ() >= lo && s[i].getMZ() < hi)
  1797	              { t.push_back(s[i]); if (ima && i < ima->size()) ia.push_back((*ima)[i]); }
  1798	          if (!t.empty()) { t.getFloatDataArrays().push_back(std::move(ia)); csub[ci][b].addSpectrum(std::move(t)); }
  1799	        }
  1800	        s.clear(true);   // distributed: release it now, so the source and the copies do not both
  1801	      }                  // stand at full size (the transient was ~2x the map)
  1802	      }
  1803	      map.clear(true);
  1804	      vector<PeakMap> sub(bands);
  1805	      for (int b = 0; b < bands; ++b)
  1806	      {
  1807	        size_t nsp = 0; for (int ci = 0; ci < nchunk; ++ci) nsp += csub[ci][b].size();
  1808	        sub[b].reserveSpaceSpectra(nsp);
  1809	        for (int ci = 0; ci < nchunk; ++ci)
  1810	        { for (auto& sp : csub[ci][b]) sub[b].addSpectrum(std::move(sp)); csub[ci][b].clear(true); }
  1811	      }
  1812	      vector<vector<PeakMap>>().swap(csub);
  1813	      tt_dist = tt_s(_td0, tt_now());
  1814	      auto _tm0 = tt_now();
  1815	      vector<vector<MassTrace>> per(bands);
  1816	      #pragma omp taskloop grainsize(1) default(shared)
  1817	      for (int b = 0; b < bands; ++b)
  1818	      {
  1819	        MassTraceDetection m2; m2.setLogType(ProgressLogger::NONE); m2.setParameters(p);
  1820	        vector<MassTrace> t;
  1821	        sub[b].sortSpectra();
  1822	        if (sub[b].size() < 3) { sub[b].clear(true); continue; }   // MTD aborts below 3 spectra
  1823	        m2.run(sub[b], t);
  1824	        sub[b].clear(true);
  1825	        // keep only traces whose centroid lies in this band's CORE -> no duplicates from the halo
  1826	        for (auto& mt : t)
  1827	        {
  1828	          const double c = mt.getCentroidMZ();
  1829	          if (c >= edge[b] && c < edge[b + 1]) per[b].push_back(std::move(mt));
  1830	        }
  1831	      }
  1832	      tt_mtd = tt_s(_tm0, tt_now());
  1833	      auto _tg0 = tt_now();
  1834	      size_t tot = 0; for (const auto& v : per) tot += v.size();
  1835	      mts.reserve(tot);
  1836	      for (auto& v : per) { for (auto& t : v) mts.push_back(std::move(t)); vector<MassTrace>().swap(v); }
  1837	      tt_gather = tt_s(_tg0, tt_now());
  1838	    }
  1839	    else
  1840	    {
  1841	      if (map.size() >= 3) mtd.run(map, mts);   // MTD aborts below 3 spectra; a tiny input is not an error
  1842	      map.clear(true); // [compact] dead from here; ~1.1 GB/window freed before the EPD peak
  1843	    }
  1844	
  1845	    // [way-2] SPLIT MASS TRACES AT CHROMATOGRAPHIC VALLEYS.
  1846	    // MassTraceDetection never splits at a local minimum: it terminates only on consecutive-miss
  1847	    // outliers or sample_rate, and max_trace_length only DISCARDS. So two peptides eluting 25 s apart
  1848	    // within the m/z tolerance merge into ONE multi-modal trace, whose XIC then correlates with
  1849	    // everything under it. ElutionPeakDetection is the OpenMS stage that actually smooths and splits
  1850	    // at local minima - we never ran it. width_filtering is forced to "off" because "fixed" is a
  1851	    // DELETION filter ([min_fwhm,max_fwhm]) and blanket deletion is on the falsified list.
  1852	    // [epd-parallel] Valley-splitting is the dominant serial phase (EPD-off dataset D 20:46 vs 28:40 for
  1853	    // MS2 alone). It is per-trace independent, so run it as a BALANCED parallel-for over the merged
  1854	    // traces -- more chunks than threads + dynamic schedule so no chunk's long traces stall the
  1855	    // rest. Lock-free (patched OpenMS), so the 8 concurrent windows above never contend. Trace SET
  1856	    // is identical to one serial split (per-trace, deterministic); only order differs, and both
  1857	    // consumers are order-independent (MS2 re-sorted after detectTraces_, MS1 sorted before
  1858	    // inferPrecursors_). Reverted once for a -0.8% "regression" that was actually the ms1_traces
  1859	    // determinism bug, now fixed.
  1860	    auto _ts0 = tt_now();
  1861	    if (split_valleys > 0.0 && mts.size() > 1)
  1862	    {
  1863	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1864	      const size_t n_in = mts.size();
  1865	      vector<vector<MassTrace>> parts(nchunk);
  1866	      #pragma omp taskloop grainsize(1) default(shared)
  1867	      for (int ci = 0; ci < nchunk; ++ci)
  1868	      {
  1869	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1870	        if (lo >= hi) continue;
  1871	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1872	                                std::make_move_iterator(mts.begin() + hi));
  1873	        parts[ci] = do_split(chunk);
  1874	      }
  1875	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1876	      vector<MassTrace> out; out.reserve(tot);
  1877	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1878	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1879	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1880	      mts.swap(out);
  1881	    }
  1882	    tt_split = tt_s(_ts0, tt_now());
  1883	    writeLogInfo_("[tstage] " + String(bands) + " bands -> " + String(mts.size()) + " traces: edges "
  1884	                  + String(tt_edge) + " s | distribute " + String(tt_dist) + " s (serial) | detect "
  1885	                  + String(tt_mtd) + " s | gather " + String(tt_gather) + " s (serial) | valley-split "
  1886	                  + String(tt_split) + " s");
  1887	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1888	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1889	    if (!mts.empty())
  1890	    {
  1891	      vector<double> spans;
  1892	      spans.reserve(mts.size());
  1893	      for (const auto& mt : mts)
  1894	      {
  1895	        double lo = 1e30, hi = -1e30;
  1896	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1897	        spans.push_back(hi - lo);
  1898	      }
  1899	      sort(spans.begin(), spans.end());
  1900	      size_t n = spans.size();
  1901	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1902	      // the tail fractions the trace:max_span_sec cap is priced against
  1903	      size_t over120 = spans.end() - lower_bound(spans.begin(), spans.end(), 120.0);
  1904	      size_t over240 = spans.end() - lower_bound(spans.begin(), spans.end(), 240.0);
  1905	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1906	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " p99=" + String(spans[(size_t)(0.99*n)])
  1907	                      + " max=" + String(spans.back())
  1908	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%"
  1909	                      + " frac>120s=" + String((int)(10000.0*over120/n)/100.0) + "%"
  1910	                      + " frac>240s=" + String((int)(10000.0*over240/n)/100.0) + "%";
  1911	    }
  1912	    vector<Trace> out;
  1913	    out.reserve(mts.size());
  1914	    // toTrace only reads, so each MassTrace is dead the moment it is converted. Releasing it here
  1915	    // keeps the peak at one MassTrace instead of the whole vector plus the whole Trace vector; the
  1916	    // same discipline is already applied to the band and chunk vectors above.
  1917	    for (size_t i = 0; i < mts.size(); ++i) { out.push_back(toTrace(mts[i], store)); mts[i] = MassTrace(); }   // move-assign an empty one: the payload goes now, not at return
  1918	    return out;
  1919	  }
  1920	
  1921	  /// [route-1] Averagine isotope envelope, Poisson approximation: for neutral mass M the expected
  1922	  /// number of 13C is lambda ~ 0.000594*M, giving relative intensities [1, l, l^2/2, l^3/6, ...].
  1923	  /// This is what lets us pick the MONOISOTOPE: the mono is NOT always the most intense peak
  1924	  /// (above ~1800 Da M+1 exceeds M), so intensity-ranking alone mis-assigns it.
  1925	  static void averagineRatios(double neutral_mass, int n, vector<double>& out)
  1926	  {
  1927	    const double lam = std::max(0.10, 0.000594 * neutral_mass);
  1928	    out.assign(n, 0.0);
  1929	    double term = 1.0;
  1930	    for (int k = 0; k < n; ++k) { out[k] = term; term *= lam / (double)(k + 1); }
  1931	    double mx = 0.0; for (double v : out) mx = std::max(mx, v);
  1932	    if (mx > 0) for (double& v : out) v /= mx;
  1933	  }
  1934	
  1935	  static double cosineSim(const vector<double>& a, const vector<double>& b)
  1936	  {
  1937	    double dot = 0, na = 0, nb = 0;
  1938	    for (size_t i = 0; i < a.size() && i < b.size(); ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  1939	    return (na > 0 && nb > 0) ? dot / (sqrt(na) * sqrt(nb)) : 0.0;
  1940	  }
  1941	
  1942	  /// [route-1] Pearson of two XICs over their OVERLAPPING RT points, properly mean-centred on the
  1943	  /// overlap (NOT zero-padded over a global grid). Isotopes of one peptide must co-elute; a
  1944	  /// coincidental peak at the right m/z spacing usually does not.
  1945	  /// Pearson correlation of two elution profiles over their shared frames. On a global axis the
  1946	  /// intersection is an integer merge -- no RT comparison, no tolerance, no binary search.
  1947	  static double xicCorr(const TraceStore& s, const Trace& a, const Trace& b, double /*rt_tol*/)
  1948	  {
  1949	    // both are MS1 traces on the same frame table: the shared frames are the overlap of the two
  1950	    // spans, and a frame counts only where BOTH have a real point -- the old index intersection
  1951	    double sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0; int m = 0;
  1952	    const uint32_t lo = std::max(a.frame0, b.frame0);
  1953	    const uint32_t hi = std::min(a.frame0 + a.len, b.frame0 + b.len);
  1954	    for (uint32_t f = lo; f < hi; ++f)
  1955	    {
  1956	      const double x = xv(s, a, f - a.frame0), y = xv(s, b, f - b.frame0);
  1957	      if (x > 0.0 && y > 0.0) { sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; ++m; }
  1958	    }
  1959	    if (m < 3) return -2.0;
  1960	    const double cov = sxy - sx * sy / m, vx = sxx - sx * sx / m, vy = syy - sy * sy / m;
  1961	    return (vx > 0 && vy > 0) ? cov / std::sqrt(vx * vy) : -2.0;
  1962	  }
  1963	
  1964	  /// [route-1] Isotope/charge inference on MS1 traces. Scores each (charge, monoisotope) hypothesis
  1965	  /// by averagine-shape agreement x isotope-XIC co-elution, instead of counting partners.
  1966	  vector<Precursor_> inferPrecursors_(const vector<Trace>& ms1, const TraceStore& ms1st, int max_charge,
  1967	                                      double delta_rt, double iso_im_tol, double mass_ppm,
  1968	                                      bool envelope_scoring)
  1969	  {
  1970	    const double ISO = 1.0033548;
  1971	    const double PROTON_ = 1.00727646;
  1972	    const size_t N = ms1.size();
  1973	
  1974	    // m/z-sorted index for O(log N) isotope-partner lookup (avoids O(N^2) over all MS1 traces).
  1975	    auto _pi_t0 = std::chrono::steady_clock::now();
  1976	    vector<size_t> by_mz(N);
  1977	    for (size_t i = 0; i < N; ++i) by_mz[i] = i;
  1978	    sort(by_mz.begin(), by_mz.end(), [&](size_t a, size_t b) { return ms1[a].mz < ms1[b].mz; });
  1979	    vector<double> sorted_mz(N);
  1980	    for (size_t i = 0; i < N; ++i) sorted_mz[i] = ms1[by_mz[i]].mz;
  1981	    // [soa] findPartner's candidate scan walks `by_mz` and dereferences ms1[j].rt / ms1[j].im --
  1982	    // two 8-byte fields out of a 48-byte record, reached through an index, i.e. one cache miss per
  1983	    // candidate per field. This phase is single-threaded and 26% of TNBC wall, so lay the two gate
  1984	    // fields out in m/z order next to `sorted_mz` and scan them sequentially. Same values, same
  1985	    // order, same first match: output-identical by construction. 16 B/trace of transient state.
  1986	    vector<double> sorted_rt(N), sorted_im(N);
  1987	    for (size_t i = 0; i < N; ++i) { const Trace& t = ms1[by_mz[i]]; sorted_rt[i] = t.rt; sorted_im[i] = t.im; }
  1988	    // [mzidx] A DIRECTLY COMPUTED integer index over `sorted_mz` -- no search to find the bucket
  1989	    // and no floating-point arithmetic to compute it. The greedy walk below is the single-threaded
  1990	    // residue of this phase (measured: 138.3 s of 155.7 on a 2-hour file) and it spent that in
  1991	    // `lower_bound`/`upper_bound` over 22e6 doubles: ~25 probes, each a cache miss, for up to 50
  1992	    // partner queries per seed.
  1993	    //
  1994	    // The key is the top bits of the IEEE-754 bit pattern, which for positive doubles is monotone
  1995	    // non-decreasing in the value -- one load and one shift, exact, with no rounding of its own.
  1996	    // Because the exponent leads, the bucket width is RELATIVE (2^-20 of the binade, ~0.5 mDa at
  1997	    // m/z 512-1024), which is the right shape for a ppm tolerance and keeps the occupancy even
  1998	    // across the m/z range in a way a uniform-in-m/z grid does not.
  1999	    //
  2000	    // NOTE: the natural key here is the flight-time bin itself -- an integer the instrument
  2001	    // already produced, with no calibration applied -- but `Trace::tof` is 0 on the OpenMS MS1
  2002	    // path (`toTrace` never sets it), and MS1 tracing still runs that path by default. Keying on
  2003	    // tof, and deferring the calibrated m/z to the end, becomes available once MS1 goes through
  2004	    // the integer detector.
  2005	    //
  2006	    // The POSITION found is unchanged: the key is monotone, so every element below the query's
  2007	    // bucket is strictly less than the query and every element above is strictly greater; the
  2008	    // standard-library search then runs on a sub-range that provably contains the answer.
  2009	    const double mz_lo = N ? sorted_mz.front() : 0.0, mz_hi = N ? sorted_mz.back() : 1.0;
  2010	    unsigned kshift = 32;
  2011	    auto rawKey = [](double x, unsigned sh) { uint64_t b; std::memcpy(&b, &x, sizeof b); return b >> sh; };
  2012	    while (kshift < 52 && (rawKey(mz_hi, kshift) - rawKey(mz_lo, kshift)) > (1u << 23)) ++kshift;
  2013	    const uint64_t klo = N ? rawKey(mz_lo, kshift) : 0;
  2014	    const size_t kspan = N ? (size_t)(rawKey(mz_hi, kshift) - klo) : 0;
  2015	    auto bucketOf = [&](double x) -> size_t {
  2016	      if (!(x > mz_lo)) return 0;
  2017	      const uint64_t k = rawKey(x, kshift);
  2018	      return k >= klo + kspan ? kspan : (size_t)(k - klo);
  2019	    };
  2020	    vector<uint32_t> bstart(kspan + 2, 0);
  2021	    {
  2022	      size_t i = 0;
  2023	      for (size_t b = 0; b <= kspan; ++b) { while (i < N && bucketOf(sorted_mz[i]) < b) ++i; bstart[b] = (uint32_t)i; }
  2024	      bstart[kspan + 1] = (uint32_t)N;
  2025	    }
  2026	    auto lbmz = [&](double x) -> size_t {
  2027	      if (N == 0 || x <= mz_lo) return 0;
  2028	      if (x > mz_hi) return N;
  2029	      const size_t b = bucketOf(x);
  2030	      return (size_t)(std::lower_bound(sorted_mz.begin() + bstart[b], sorted_mz.begin() + bstart[b + 1], x) - sorted_mz.begin());
  2031	    };
  2032	    auto ubmz = [&](double x) -> size_t {
  2033	      if (N == 0 || x < mz_lo) return 0;
  2034	      if (x >= mz_hi) return N;
  2035	      const size_t b = bucketOf(x);
  2036	      return (size_t)(std::upper_bound(sorted_mz.begin() + bstart[b], sorted_mz.begin() + bstart[b + 1], x) - sorted_mz.begin());
  2037	    };
  2038	    auto _pi_t1 = std::chrono::steady_clock::now();
  2039	
  2040	    // The apex intensity now lives in the store's arena. This phase reads it O(N log N) times in the
  2041	    // sort below and again in every isotope walk, so pull it into one contiguous float array first:
  2042	    // 4 B per trace, sequentially laid out, against 8 B scattered through 56-byte records before.
  2043	    vector<float> inten(N);
  2044	    for (size_t i = 0; i < N; ++i) inten[i] = (float)intensityOf(ms1st, ms1[i]);
  2045	    vector<size_t> order(N);

codex
Two claims need revising already: the code frees compact frames as it builds each slab, and frees MS1 spectra as it distributes them into bands. Neither copy is necessarily a full second live dataset. I also found `s.isSorted()` inside the MS1 band loop, which appears to scan each source spectrum 48 times; I’m checking its cost.
