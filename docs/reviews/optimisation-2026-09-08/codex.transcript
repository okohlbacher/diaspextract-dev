   380	  void ElutionPeakDetection::detectElutionPeaks_(MassTrace& mt, std::vector<MassTrace>& single_mtraces)
   381	  {
   382	
   383	    // *********************************************************************
   384	    // Step 1: Smooth data
   385	    // *********************************************************************
   386	
   387	    double scan_time(mt.getAverageMS1CycleTime());
