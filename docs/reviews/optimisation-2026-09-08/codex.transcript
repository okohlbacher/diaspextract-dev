   344	  inline double bOf(const TraceStore& s, const Trace& t) { return s.b.empty() ? 0.0 : s.b[t.bframe]; }
   345	  /// The trace's apex intensity. It was an 8-byte field holding a copy of a number the arena already
   346	  /// stores: makeSpan sets `apex` to the position of the largest value in the span, and both
   347	  /// producers set the field to exactly that value (sl.inten[kap] on the integer path,
   348	  /// MassTrace::getMaxIntensity on the OpenMS one). Trimming moves `apex` with the data, so the
   349	  /// identity survives it. A trace whose profile was released (len == 0) has no apex to read; it is
   350	  /// also never scored, which is why its profile was released.
   351	  inline double intensityOf(const TraceStore& s, const Trace& t)
   352	  { return t.len ? (double)s.inten[t.off + t.apex] : 0.0; }
