  1499	    registerDoubleOption_("gate:delta_rt", "<sec>", 3.0, "Max |precursor - fragment| apex RT difference (seconds).", false);
  1500	    registerDoubleOption_("gate:min_correlation", "<0..1>", 0.3, "Min Pearson correlation of elution profiles. (the reference implementation ms1MS2Corr default 0.3; raise for cleaner but sparser spectra)", false);
  1501	    registerIntOption_("gate:min_correlation_points", "<n>", 3, "Min overlapping XIC points required to accept a correlation.", false, true);
  1502	
  1503	    registerTOPPSubsection_("assembly", "Pseudo-spectrum assembly");
  1504	    registerIntOption_("assembly:min_fragments", "<n>", 3, "Emit a pseudo-spectrum only if it has at least this many fragments.", false);
  1505	    registerIntOption_("assembly:max_fragments", "<n>", 500, "Keep at most this many (top-ranked) fragments per pseudo-spectrum.", false);
  1506	    registerDoubleOption_("assembly:im_weight_sigma", "<1/K0>", 0.0, "Down-weight each emitted fragment's intensity by a Gaussian of its ion-mobility distance from the precursor, exp(-(dIM)^2 / 2 sigma^2). TIMS precedes fragmentation so a TRUE fragment shares the precursor's 1/K0 exactly; a co-isolating interferent at the edge of the gate:delta_im band is suppressed. WITHIN-spectrum (no fragment removed or redistributed across precursors) so it escapes the fan-out depletion that falsified competitive/apex/deconvolution, and directly un-buries faint true fragments under the engine's intensity top-150. 0 = off. Try ~0.005 (half the 0.01 IM gate).", false);
  1507	    registerDoubleOption_("assembly:corr_power", "<k>", 2.0, "Multiply each emitted fragment's intensity by corr^k (k>=0), where corr is the fragment-precursor co-elution score. EMIT-ONLY (excluded from the max_fragments cap key), so it preserves peak membership and only re-ranks the intensities the search engine sees toward well-correlating (true co-eluting) fragments and away from bright interferents; WITHIN-spectrum so it escapes fan-out depletion. DEFAULT 2.0 since 2026-07-28: validated on dataset D (tuning) + dataset A + dataset B (held out) at frozen k=2 -- +8-10%% Sage / +5-8%% MSFragger over base on all three, both engines, at controlled empirical FDR; k=2 sits one step below the ~k=3 Sage peak (the safe side of the crossover where c^k starts crushing the faint tail). 0 = off (pre-2026-07-28 behaviour). Dimensionless + bounded (c in [0.3,1]) so it transfers across instruments, unlike assembly:im_weight_sigma.", false);
  1508	    registerIntOption_("assembly:default_charge", "<z>", 2, "Charge for precursors with no isotope support: >0 assigns that charge (the reference implementation-style; 2 = most common); 0 = leave charge UNSET so the search engine searches its charge range and picks the right one (recovers 3+/4+ that a forced 2 would lose).", false);
  1509	
  1510	    registerTOPPSubsection_("trace", "Mass-trace detection (see MassTraceDetection)");
  1511	    registerDoubleOption_("trace:mass_error_ppm", "<ppm>", 15.0, "m/z tolerance for trace detection.", false);
  1512	    registerDoubleOption_("trace:noise_threshold_int", "<int>", 100.0, "MS1 (precursor) noise intensity threshold.", false);
  1513	    registerDoubleOption_("trace:ms2_noise_threshold_int", "<int>", 10.0, "MS2 (fragment) noise threshold. Lower it (e.g. 50, 20) to recover weak fragments toward the reference implementation-like density; the grid-Pearson optimization keeps that affordable.", false);
  1514	    registerDoubleOption_("trace:min_length_sec", "<sec>", 3.0, "Minimum MS1 mass-trace length (seconds).", false, true);
  1515	    // the reference implementation runs MS2 with deliberately RELAXED constraints vs MS1 (Nat Commun 16:95). The OpenMS
  1516	    // apex gate is chrom_peak_snr*noise_threshold_int, so the stock snr=3.0 silently TRIPLES the
  1517	    // fragment threshold (a "noise 30" run really gated apices at 90). Decouple both for MS2. [recall]
  1518	    registerDoubleOption_("trace:ms1_chrom_peak_snr", "<x>", 3.0, "Apex signal-to-noise multiplier for MS1 traces (effective apex threshold = this x noise_threshold_int). OpenMS default 3.0.", false, true);
  1519	    registerDoubleOption_("trace:ms2_chrom_peak_snr", "<x>", 1.0, "Apex signal-to-noise multiplier for MS2 (fragment) traces. 1.0 = the ms2_noise_threshold_int you set IS the apex threshold; 3.0 would reproduce the old hidden 3x. Lower = more weak fragments recovered.", false);
  1520	    registerDoubleOption_("trace:ms2_min_length_sec", "<sec>", 0.0, "Minimum MS2 (fragment) mass-trace length (seconds). 0 = no length filter (the reference implementation-style relaxed MS2); MS1 keeps trace:min_length_sec.", false);
  1521	    registerStringOption_("trace:detector", "<mode>", "integer", "Mass-trace detector. 'integer' "
  1522	                          "(default) works on the global integer m/z axis: it finds a peak's candidate traces by "
  1523	                          "arithmetic instead of a tolerance search, and never converts the compact store back "
  1524	                          "to double m/z. It needs the vendor flight-time calibration and falls back to 'openms' "
  1525	                          "without it. 'openms' is OpenMS MassTraceDetection on a materialised PeakMap. These are "
  1526	                          "DIFFERENT algorithms, not reimplementations: they agree on about 85% of the union of "
  1527	                          "identified peptides, and which one identifies more depends on the search engine AND the "
  1528	                          "file. Integer costs ~40% less memory. See docs/MZ-AXIS-DESIGN.md.", false);
  1529	    setValidStrings_("trace:detector", {"openms", "integer"});
  1530	    registerStringOption_("trace:mz_estimator", "<mode>", "apex", "Reported m/z of a mass trace. "
  1531	                          "'apex' (default) uses the most intense peak's m/z; 'mean' the OpenMS intensity-weighted "
  1532	                          "centroid; 'median' the median. apex was chosen on measured identifications with both "
  1533	                          "search engines -- see docs/BASELINE.md. Affects EVERY reported precursor and "
  1534	                          "fragment m/z.", false);
  1535	    setValidStrings_("trace:mz_estimator", {"apex", "mean", "median"});
  1536	    registerDoubleOption_("trace:ms2_split_valleys", "<chrom_fwhm>", 7.0, "Split MS2 mass traces at chromatographic local minima via ElutionPeakDetection (which MassTraceDetection never does - it only terminates on outliers, so two peptides 25 s apart within the m/z tolerance MERGE). Value is chrom_fwhm in seconds; it sets both the Savitzky-Golay window and the local-extrema half-window. 0 = OFF. Try 6-8 (peaks here are 5-30 s). width_filtering is forced off so this only SPLITS, never deletes.", false);
  1537	    registerFlag_("diag:selftest_arena", "Run assertions on the MS1 arena compaction (compactUnreferenced) and exit: kept spans must survive a container order that differs from their offset order", true);
  1538	    registerDoubleOption_("trace:ms1_split_valleys", "<chrom_fwhm>", 7.0, "Split MS1 mass traces at chromatographic valleys via ElutionPeakDetection. DEFAULT 7.0 s: MassTraceDetection never splits at a local minimum, so two peptides eluting ~25 s apart within the m/z tolerance merge into ONE multi-modal trace, producing a merged precursor with the wrong monoisotope and charge. Measured +36.7% peptides on dataset B and +37.4% on dataset A at peptide-level FDR. Costs ~1.7x wall time and ~25% peak RAM. 0 = off.", false);
  1539	    registerDoubleOption_("trace:max_span_sec", "<sec>", 120.0, "Trim a mass trace to at most this many "
  1540	                          "seconds around its apex, AFTER detection and valley splitting have decided what the peak "
  1541	                          "is. Applies to precursor and fragment traces alike. An unbounded trace has no locality: "
  1542	                          "15.2%% of dataset D precursor traces span >45 s and the longest spans 1,244 s of a 1,860 s "
  1543	                          "gradient, while real chromatographic peaks here are 5-30 s -- so what a 120 s cap removes "
  1544	                          "is the far tail of a blob ElutionPeakDetection did not split. Trimming AFTER the fact is "
  1545	                          "deliberate: it leaves detection's peak ownership untouched, unlike terminating "
  1546	                          "extension, and unlike a length limit that DISCARDS an over-length trace and deletes "
  1547	                          "all signal at that m/z (the falsified direction). 0 = no cap. "
  1548	                          "CHANGES OUTPUT.", false);
  1549	    setMinFloat_("trace:max_span_sec", 0.0);
  1550	    registerDoubleOption_("trace:ms2_min_sample_rate", "<r>", -1.0, "MS2 min fraction of visited scans that must contain a peak (MassTraceDetection min_sample_rate). OpenMS default 0.5 hard-deletes gappy fragment traces; MEASURED: 0.3 and 0.1 both LOSE peptides (8,865 -> 8,735 at 0.3), so -1 (= OpenMS 0.5) is the default. Lowering it produces longer, more-merged traces with wrong apexes.", false);
  1551	    registerDoubleOption_("trace:ms1_min_sample_rate", "<r>", -1.0, "MS1 min_sample_rate. -1 = OpenMS default 0.5 (strict, MS1 stays strict).", false, true);
  1552	
  1553	    // NB: "threads" is reserved by TOPPBase (the standard -threads option), so this lives under "perf".
  1554	
  1555	    registerStringOption_("perf:malloc_trim", "<true/false>", "true",
  1556	                          "Return the allocator's free pages to the OS at the two phase boundaries (glibc only). "
  1557	                          "The window loop's allocations otherwise stack on top of everything the loading and MS1 "
  1558	                          "phases freed but the allocator kept: measured on a 2-h acquisition that floor is 138 GB "
  1559	                          "at the loop start, and trimming it first takes the run's PEAK from 265 to 186 GB. "
  1560	                          "IT IS NOT FREE: the loop then faults those pages back in cold (minor faults +26%), which "
  1561	                          "costs about 8.5% of wall time -- so this trades ~30% of peak memory for ~8% of runtime, "
  1562	                          "measured interleaved on one node. On by default because memory is what bounds this tool "
  1563	                          "(it decides how many isolation windows fit at once, and whether the run fits the machine "
  1564	                          "at all). Turn it off when time is the binding constraint. Output is byte-identical "
  1565	                          "either way.", false);
  1566	    setValidStrings_("perf:malloc_trim", {"true", "false"});
  1567	    registerStringOption_("perf:stream_load", "<true/false>", "true",
  1568	                          "Read the .d frame-by-frame via BrukerTimsFile::loadDIAStreaming, "
  1569	                          "peak-picking and compacting each frame on arrival, instead of loadExperiment() "
  1570	                          "which holds the entire run (MEASURED 90.3 GB RSS at t=0s -- that one-shot read IS "
  1571	                          "the memory floor and no downstream compaction can lower it, so with this off the "
  1572	                          "floor alone exceeds the whole tool's current peak). ON BY DEFAULT since 2026-09-04; "
  1573	                          "every benchmark figure on record was taken with it on. Bruker .d only -- ignored "
  1574	                          "for other inputs, which fall back to the one-shot reader. "
  1575	                          "CHANGES OUTPUT: this is not a pure performance switch. Measured on dataset D 2026-09-04, "
  1576	                          "true = 655,776 spectra in 5:11 at 78.4 GB, false = 656,371 in 10:30 at 121.8 GB, "
  1577	                          "spectrum lists NOT identical (0.09% more spectra with the one-shot reader). The two "
  1578	                          "readers pick peaks on different frame groupings; which is closer to the truth is "
  1579	                          "measured 2026-09-05: false is slightly MORE sensitive on a large file (+2.0%% Sage peptides at unchanged entrapment FDR) for 1.75x the memory and ~1.7x the wall. Every benchmark figure used true.", false);
  1580	    setValidStrings_("perf:stream_load", {"true", "false"});
  1581	    registerIntOption_("trace:native_ms2_neighbors", "<n>", 0, "NATIVE cross-frame aggregation in the READER (BrukerTimsFile Config dia_ms2_n_neighbors): adjacent frames each side, 0=off, 1=3-frame sum, 2=5-frame sum. This sums RAW frames BEFORE centroiding, which is what the reference implementation does; summing AFTER centroiding instead lost 26% of peptides. Requires perf:stream_load.", false);
  1582	    registerIntOption_("trace:native_ms1_neighbors", "<n>", 0, "Same, for MS1 frames (BrukerTimsFile Config ms1_n_neighbors). Requires perf:stream_load.", false);
  1583	
  1584	    registerTOPPSubsection_("perf", "Concurrency / memory tradeoff");
  1585	    registerStringOption_("gate:coelution", "<mode>", "pearson", "Fragment-precursor co-elution statistic. 'pearson' takes variance over the FULL RT grid, so a fragment present in a handful of points is scored against ~1300 implicit zeros -- it rewards sparse fragments that spike where the precursor spikes, and its scale depends on grid size rather than evidence. 'logoverlap' is the AlphaDIA-style alternative: profile overlap in log space, summed only where the precursor has signal, normalised to [0,1]. The two are on DIFFERENT SCALES, so gate:min_correlation must be retuned when switching.", false);
  1586	    setValidStrings_("gate:coelution", {"pearson", "logoverlap"});
  1587	    registerFlag_("gate:variance_support", "Compute the Pearson co-elution variance over the UNION SUPPORT of the precursor and fragment profiles (points where either is non-zero) rather than the full RT grid G (~1300). Fixes the zero-padding: a fragment present in a handful of grid points is no longer scored against ~1300 implicit zeros, and the score no longer depends on grid size. Only affects gate:coelution=pearson. Retune gate:min_correlation when enabling -- the score scale changes.");
  1588	    registerIntOption_("perf:ms1_trace_bands", "<n>", 48, "Band-parallel MS1 mass-trace detection, same exact-partition scheme as perf:trace_bands. DEFAULT RAISED 12 -> 48 on 2026-09-07: the earlier sweep found more bands to be WORSE (12/24/48 -> 75.0/93.7/147.9 s) but it was measuring a SERIAL band distribution that grew with band count; with that step parallel the order inverts (41.7/27.1/20.4 s at 9.8x/18.4x/32.4x) and 48 was gated on both datasets -- Sage 0.9999 and 0.9994, MSFragger 1.0002 and 1.0203, entrapment FDR 1.26->1.24%% and 1.12->1.07%%. MS1 tracing was running SINGLE-THREADED (the call simply never passed a band count) while MS2 was banded, so the MS1 phase pinned one core. That is invisible at default thresholds because MS1 is only ~4% of frames, but it makes the MS1 SENSITIVITY sweep impossible: lowering trace:noise_threshold_int / ms1_chrom_peak_snr explodes MassTraceDetection's intensity-sorted apex list, and MassTraceDetection is a SERIAL greedy loop, so runtime blows up superlinearly on one core (measured: 40 min with no progress at 1.5 of 128 cores, vs 24 min for a whole default run). 1 = off (old behaviour).", false);
  1589	    registerIntOption_("perf:trace_bands", "<n>", 12, "Split each window's fragment m/z range into N bands traced CONCURRENTLY. The diaPASEF method fixes the window count (24 here), which caps window-level parallelism far below the core count; banding lifts the ceiling to threads. Traces cannot span more than trace:mass_error_ppm in m/z, so banding with a halo is exact. 0 = auto (windows x bands >= threads), 1 = off.", false);
  1590	    registerDoubleOption_("perf:mem_fraction", "<f>", 0.75, "Fraction of currently-FREE RAM (/proc/meminfo MemAvailable) the window loop may commit. Concurrency is re-decided at every window admission, so the run adapts to other jobs on a shared node. One window is always admitted regardless, so a single oversized window cannot deadlock.", false);
  1591	    registerIntOption_("perf:max_concurrent_windows", "<n>", 0, "UPPER bound on isolation windows processed concurrently (memory admission may run fewer). Peak RAM scales with windows IN FLIGHT (each holds its frames + traces + grid), not with the total window count, so lowering this trades wall time for RAM. 0 = unlimited (use all threads).", false);
  1592	
  1593	    registerTOPPSubsection_("diag", "Diagnostics ('debug' is reserved by TOPP)");
  1594	    registerStringOption_("diag:dump_ms1_tsv", "<prefix>", "", "Write MS1 traces and inferred precursors to <prefix>.traces.tsv / <prefix>.precursors.tsv so precursor loss can be attributed to a stage (no trace / no hypothesis / no spectrum) rather than inferred from the final count. Empty = off.", false, true);
  1595	
  1596	    registerIntOption_("max_charge", "<n>", 5, "Maximum precursor charge considered during isotope inference.", false);
  1597	
  1598	    // NOTE: the subsection MUST be registered or printUsage_() throws ElementNotFound — which turns
  1599	    // any user parameter typo into a FATAL crash instead of a usage message. [bugfix]
  1600	    registerTOPPSubsection_("charge", "Isotope / charge-state inference");
  1601	    registerIntOption_("charge:min_charge", "<n>", 1, "Minimum precursor charge to emit; hypotheses below it "
  1602	                       "are dropped before extraction. DEFAULT CHANGED 2 -> 1 on 2026-09-08. The old default rested on "
  1603	                       "dataset D, where z=1 was ~30%% of emission and ~1.7%% of peptides; on a 2-hour tryptic acquisition "
  1604	                       "(TNBC) it discards 14-20%% of Sage peptides and most of the MSFragger deficit against the reference "
  1605	                       "implementation. Those identifications are physically singly charged: short (7-9 aa), lysine-terminated, "
  1606	                       "single-basic-site tryptic peptides whose ion mobility sits +0.29 Vs/cm2 above the 2+ trend line at "
  1607	                       "the same m/z in 99.4-99.9%% of cases -- a halved 2+ ion would carry the 2+ mobility. The halved 2+ "
  1608	                       "ions that DO occur (~13%% of z=1 calls, sitting on the 2+ band) are re-called by charge:im_charge_veto. "
  1609	                       "The z=1 stratum carries ~2.8%% entrapment FDR at a nominal 1%% global cut (a lower true-match prior in that stratum under one pooled threshold, not peptide length; decoys "
  1610	                       "reproduce it), so per-charge FDR control downstream is advised. Old text: "
  1611	                       "docs/ISOTOPE-DUPLICATION-2026-09-03.md.", false);
  1612	    // [route-1] Only 25.7%% of the reference implementation's precursors are matched by us with the RIGHT m/z AND charge;
  1613	    // 17.2%% have the wrong charge and 22.9%% (decoy-corrected) the wrong monoisotope. A wrong charge or
  1614	    // mono gives a wrong NEUTRAL MASS, so the peptide can never be identified no matter how good the
  1615	    // fragments are. Partner-COUNTING cannot tell a real envelope from a coincidence; averagine shape
  1616	    // x isotope co-elution can.
  1617	    registerStringOption_("charge:scoring", "<mode>", "count", "Charge/monoisotope inference. 'count' is the partner-count heuristic (ties favour LOW charge, break-on-first-miss) and is the DEFAULT: measured against a DIA-NN reference on dataset B it gives 71.8% charge agreement vs 49.7% for 'envelope', and it eliminates the catastrophic 4->2 confusion (10,199 cases) that fabricates a ~-1198 Da phantom modification at m/z 600 in open search. 'envelope' scores each (charge, mono) hypothesis by averagine cosine x isotope co-elution and allows gapped envelopes; it was the default until 2026-07-21 and is kept for comparison. NOTE both are close to trivial: always answering z=2 scores 69.6%.", false);
  1618	    setValidStrings_("charge:scoring", {"envelope", "count"});
  1619	    registerStringOption_("charge:im_charge_veto", "<true/false>", "true", "Use the ion-mobility charge-state trend "
  1620	                          "lines to correct charge halving. In TIMS, 1+ and 2+ ions of the same m/z sit on separate 1/K0 lines "
  1621	                          "(~+0.29 Vs/cm2 apart). The count walk calls a real 2+ envelope z=1 whenever its M+1 (+0.5017) is "
  1622	                          "missing or already claimed and its M+2 (+1.0034) is present -- measured at ~13%% of z=1 calls on a "
  1623	                          "2-hour file, 60%% of them below m/z 750 where a 1+ cannot be scored at all. The 2+ and 3+ lines are "
  1624	                          "fitted per run from the run's own confident calls (>= 3 isotopes; 25-Th bin medians, MAD residual "
  1625	                          "scale), and a z=1 call whose 1/K0 lies within charge:im_veto_band sigma of the 2+ (3+) line is "
  1626	                          "re-assigned 2+; one on the 3+ band is dropped (re-calling it 3+ identified nothing on two files). "
  1627	                          "Genuine 1+ ions are untouched: 0.0-0.6%% of identified z=1 peptides sit on the 2+ band.", false);
  1628	    setValidStrings_("charge:im_charge_veto", {"true", "false"});
  1629	    registerDoubleOption_("charge:im_veto_band", "<sigma>", 2.5, "Half-width of the 2+/3+ mobility band, in MAD-sigma of "
  1630	                          "the confident calls' residuals (measured residual sd ~0.037 1/K0 against a 1+/2+ separation of ~0.29).", false);
  1631	    registerStringOption_("assembly:require_isotope_support", "<true/false>", "true",
  1632	                          "Drop precursor hypotheses with NO isotope partner -- the 'guessed' "
  1633	                          "singletons. ON BY DEFAULT since 2026-09-04, when the shipped default (off) was "
  1634	                          "measured for the first time and found to be 6.9x SLOWER and worse on both engines: "
  1635	                          "dataset D off = 1,255,577 spectra, 36:25 wall, 6.0x occupancy, Sage 12,212 / MSFragger "
  1636	                          "12,148; on = 655,776 spectra, 5:15, 65.7x, Sage 12,482 / MSFragger 12,337. An "
  1637	                          "earlier measurement (2026-07-26, at 10,036 peptides, before the charge gate, the "
  1638	                          "apex estimator and the integer detector) had put the cost at -0.78% peptides; the "
  1639	                          "sign has since flipped. Set false to keep the guessed singletons.", false);
  1640	    setValidStrings_("assembly:require_isotope_support", {"true", "false"});
  1641	    registerDoubleOption_("charge:mono_averagine_guard", "<slack>", 0.0, "Reject a leftward isotope step (the walk that defines the MONOISOTOPE in charge:scoring=count) when the candidate peak is too weak to be a real lighter isotope under averagine. The partner search matches m/z, RT and IM but NEVER intensity, so it can latch onto a noise peak or a co-eluting species one isotope spacing below the true monoisotope -- making the reported precursor mass ~1.00335 Da TOO LIGHT. Closed search hides this (the engine enumerates isotope_errors and corrects it for free); OPEN/blind search turns it into a phantom -1.003 Da modification, and it is our single largest open-search delta-mass artefact on dataset D (8.20%% isotope-shifted PSMs vs the reference implementation's 3.46%%). The bound is averagine's LOOSEST: stepping from isotope m+1 to m the lighter peak is >= (m+1)/lambda times the heavier one, minimised at m=0 -> 1/lambda (lambda = 0.000594*neutral mass), so a value of 1.0 enforces exactly that minimum and never rejects a legitimate envelope; smaller values add slack for noise. 0 = off (old behaviour).", false);
  1642	    registerFlag_("charge:mono_averagine_select", "Choose the MONOISOTOPE by averagine envelope fit over the whole isotope run found by the charge:scoring=count walk, instead of taking the furthest-left peak reached. 'Furthest-left' is a STOPPING rule and can only trade over-reach (mono ~1.003 Da too LIGHT, a phantom -1 Da modification in open search) for under-reach (+1.003 Da) -- measured: an averagine STOPPING guard cut the -1 artefact 64%% but tripled +1, because a walk that halts early also leaves the M+1 peak unconsumed so it seeds its own too-heavy precursor. This is a SCORING decision instead: score every candidate mono position in the run by cosine against the averagine envelope and keep the best. Every found peak is still consumed, so de-isotoping and emission are unchanged -- only the reported precursor mass moves.");
  1643	    registerDoubleOption_("charge:iso_im_tolerance", "<1/K0>", 0.05, "IM tolerance for matching isotope partners. Default 0.05 (= 5x the fragment gate). 0.01 is arguable -- isotopes of one species share mobility, so 0.05 can admit cross-species partners -- but 0.01 has not been measured; change it only behind a peptide-set gate.", false);
  1644	
  1645	    // Bounds, not documentation: without these a negative count wraps through `Size` (min_fragments
  1646	    // -1 becomes ~1.8e19 and nothing is ever emitted) and a negative tolerance silently gates
  1647	    // everything out. Both fail as an empty-but-valid result, the worst failure mode here.
  1648	    setMinInt_("assembly:min_fragments", 1);
  1649	    setMinInt_("assembly:max_fragments", 1);
  1650	    setMinInt_("assembly:default_charge", 0);
  1651	    setMinInt_("max_charge", 1);
  1652	    setMinInt_("perf:trace_bands", 0);      // 0 = auto (documented)
  1653	    setMinFloat_("gate:delta_im", 0.0);
  1654	    setMinFloat_("gate:delta_rt", 0.0);
  1655	    setMinFloat_("gate:min_correlation", -1.0);
  1656	    setMaxFloat_("gate:min_correlation", 1.0);
  1657	    setMinFloat_("charge:iso_im_tolerance", 0.0);
  1658	    setMinFloat_("trace:ms1_chrom_peak_snr", 0.0);
  1659	    setMinFloat_("trace:ms2_chrom_peak_snr", 0.0);
  1660	    setMinFloat_("trace:ms2_noise_threshold_int", 0.0);
  1661	    setMinFloat_("trace:noise_threshold_int", 0.0);
  1662	    setMinInt_("perf:ms1_trace_bands", 0);      // 0 = auto (documented)
  1663	    setMinFloat_("perf:mem_fraction", 0.05);
  1664	    setMaxFloat_("perf:mem_fraction", 0.95);
  1665	    // deliberate: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
  1666	  }
  1667	
     1	// Read the calibration a Bruker .d actually uses, straight from analysis.tdf via the sqlite3 C API.
     2	// Kept OUT of TdfMzCalibration.h on purpose: that header is the pure arithmetic model, is installed
     3	// into the OpenMS tree by the patch script, and is compiled by the dependency-free golden test on
     4	// every CI platform -- including Windows, which has no sqlite3.h. Only the tool needs this file.
     5	#pragma once
     6	#include <OpenMS/FORMAT/TdfMzCalibration.h>   // the copy the OpenMS patch installs; same header as src/TdfMzCalibration.h
     7	#include <sqlite3.h>
     8	#include <cmath>
     9	#include <limits>
    10	#include <string>
    11	#include <vector>
    12	
    13	namespace spextractor
    14	{
    15	// ---------------------------------------------------------------------------------------------
    16	// Read the calibration a .d actually uses, straight from analysis.tdf with the sqlite3 C API.
    17	//
    18	// This deliberately does NOT use SQLiteCpp. That wrapper is an OpenMS in-tree extern whose headers
    19	// are not on the include path of an OpenMS *installation*, so the two callers used to sit behind
    20	// `#if __has_include(<SQLiteCpp/SQLiteCpp.h>)` -- false for the documented public build -- and fell
    21	// back to "built without SQLiteCpp", which made the integer detector silently revert to `openms`.
    22	// The stock-OpenMS CI caught it: 9/10 checks passed and the tenth said the shipped detector never
    23	// ran. sqlite3.h is what OpenMS itself links, so a missing SQLite is now a compile error, never a
    24	// behaviour switch.
    25	//
    26	// The row is the one the FRAMES reference (Frames.MzCalibration), not "the only row": PXD017703
    27	// acquisitions carry two rows with every frame on Id 1. Refuses when frames reference more than
    28	// one row (per-frame recalibration, unsupported). t1_by_frame[id] = Frames.T1, T1_ref when NULL;
    29	// index 0 is never a frame (Ids start at 1) and is left for the caller to treat as a sentinel.
    30	// ---------------------------------------------------------------------------------------------
    31	inline bool loadTdfCalibration(const std::string& tdf, TdfMzCalibration& cal,
    32	                               std::vector<double>& t1_by_frame, std::string& why)
    33	{
    34	  sqlite3* db = nullptr;
    35	  if (sqlite3_open_v2(tdf.c_str(), &db, SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK)
    36	  { why = std::string("cannot open ") + tdf + ": " + (db ? sqlite3_errmsg(db) : "out of memory"); sqlite3_close(db); return false; }
    37	  sqlite3_stmt* st = nullptr;
    38	  long long cal_id = -1; int ncal = 0;
    39	  if (sqlite3_prepare_v2(db, "SELECT DISTINCT MzCalibration FROM Frames", -1, &st, nullptr) == SQLITE_OK)
    40	  {
    41	    while (sqlite3_step(st) == SQLITE_ROW) { cal_id = sqlite3_column_int64(st, 0); ++ncal; }
    42	    sqlite3_finalize(st); st = nullptr;
    43	    if (ncal != 1) { why = "frames reference " + std::to_string(ncal) + " distinct MzCalibration rows"; sqlite3_close(db); return false; }
    44	  }
    45	  else
    46	  {
    47	    // Frames has no MzCalibration column (a minimal or very old tdf): fall back to the single-row
    48	    // rule rather than refusing -- the reference is then unambiguous only if there IS one row.
    49	    sqlite3_finalize(st); st = nullptr;
    50	    if (sqlite3_prepare_v2(db, "SELECT Id FROM MzCalibration", -1, &st, nullptr) == SQLITE_OK)
    51	      while (sqlite3_step(st) == SQLITE_ROW) { cal_id = sqlite3_column_int64(st, 0); ++ncal; }
    52	    sqlite3_finalize(st); st = nullptr;
    53	    if (ncal != 1) { why = "Frames has no MzCalibration column and MzCalibration has " + std::to_string(ncal) + " rows (need exactly 1)"; sqlite3_close(db); return false; }
    54	  }
    55	  if (sqlite3_prepare_v2(db, "SELECT ModelType, DigitizerTimebase, DigitizerDelay, C0, C1, C2, T1, dC1, dC2, C3, C4 "
    56	                             "FROM MzCalibration WHERE Id = ?", -1, &st, nullptr) != SQLITE_OK
    57	      || sqlite3_bind_int64(st, 1, cal_id) != SQLITE_OK || sqlite3_step(st) != SQLITE_ROW)
    58	  { why = "no MzCalibration row with Id " + std::to_string(cal_id); sqlite3_finalize(st); sqlite3_close(db); return false; }
    59	  cal.model_type = sqlite3_column_int(st, 0);
    60	  cal.digitizer_timebase = sqlite3_column_double(st, 1); cal.digitizer_delay = sqlite3_column_double(st, 2);
    61	  cal.C0 = sqlite3_column_double(st, 3); cal.C1 = sqlite3_column_double(st, 4);
    62	  cal.C2 = (sqlite3_column_type(st, 5) == SQLITE_NULL) ? std::numeric_limits<double>::quiet_NaN()
    63	                                                       : sqlite3_column_double(st, 5);
    64	  cal.T1_ref = sqlite3_column_double(st, 6); cal.dC1 = sqlite3_column_double(st, 7); cal.dC2 = sqlite3_column_double(st, 8);
    65	  cal.C3 = sqlite3_column_double(st, 9); cal.C4 = sqlite3_column_double(st, 10);
    66	  sqlite3_finalize(st); st = nullptr;
    67	  if (std::isnan(cal.C2)) { why = "MzCalibration C2 is NULL (missing, not zero)"; sqlite3_close(db); return false; }
    68	  if (!cal.isSupported()) { why = cal.unsupportedReason(); sqlite3_close(db); return false; }
    69	  t1_by_frame.clear();
    70	  if (sqlite3_prepare_v2(db, "SELECT Id, T1 FROM Frames", -1, &st, nullptr) == SQLITE_OK)
    71	    while (sqlite3_step(st) == SQLITE_ROW)
    72	    {
    73	      const long long id = sqlite3_column_int64(st, 0);
    74	      if (id < 0 || id > 10000000) { why = "implausible Frames.Id"; sqlite3_finalize(st); sqlite3_close(db); return false; }
    75	      if ((size_t)id >= t1_by_frame.size()) t1_by_frame.resize((size_t)id + 1, cal.T1_ref);
    76	      t1_by_frame[(size_t)id] = (sqlite3_column_type(st, 1) == SQLITE_NULL) ? cal.T1_ref : sqlite3_column_double(st, 1);
    77	    }
    78	  sqlite3_finalize(st); sqlite3_close(db);
    79	  if (t1_by_frame.size() < 2) { why = "no Frames rows"; return false; }
    80	  return true;
    81	}
