  2491	        // min_corr_pts can never pass the overlap guard below: skip it before the dot product.
  2492	        // Output-identical by construction (the guard's continue is the only thing it would reach).
  2493	        if (f.np() < (size_t)std::max(min_corr_pts, 0)) continue;
  2494	        // two sequential streams: the fragment's span in the arena and pdense over window frames
  2495	        for (size_t k = 0; k < f.span(); ++k)
  2496	        { const float fv = xv(wst, f, k); if (fv == 0.0f) continue;
  2497	          const float pv = pdense[f.frame0 + k]; if (pv != 0.0f) { dot += (double)pv * fv; ++overlap; } }
  2498	        if (overlap < min_corr_pts) continue;                          // overlap guard [H-4]
  2499	        // [B0] Pearson takes variance over the FULL grid G, so a fragment present in 5 of ~1300
  2500	        // grid points has its variance computed against ~1300 implicit zeros -- the zero-padding
  2501	        // defect. It rewards sparse fragments that happen to spike where the precursor spikes,
  2502	        // and its scale depends on G rather than on the evidence.
  2503	        // AlphaDIA instead collapses fragments with sum(log(intensity+1)): a likelihood under
  2504	        // independence, where one missing point does not zero the score (unlike a product) and
  2505	        // one huge point cannot dominate (unlike a sum). Adapted to a (precursor, fragment) pair:
  2506	        // profile overlap in log space, summed ONLY where the precursor has signal, normalised to
  2507	        // [0,1]. No zero padding, no dependence on G.
  2508	        double c;
  2509	        if (var_support_ && !log_overlap_)                             // [Q1] pearson-only, per the flag doc
  2510	        {
  2511	          // [Q1] Pearson over the UNION SUPPORT (points where precursor OR fragment is non-zero),
  2512	          // not the full grid G. Removes the [B0] zero-padding: no ~1300 implicit zeros inflating
  2513	          // sparse fragments, no dependence on grid size. n = |touched U f.support|. fsum/fsumsq
  2514	          // over f.support are accumulated here (support is tiny, so a second pass is negligible).
  2515	          double fsum = 0.0, fsumsq = 0.0;
  2516	          for (size_t k = 0; k < f.span(); ++k)
  2517	          { const double fv = xv(wst, f, k); if (fv > 0.0) { fsum += fv; fsumsq += fv * fv; } }
  2518	          double n = (double)(touched.size() + f.np() - (size_t)overlap);
  2519	          double pm = psum / n, fm = fsum / n;
  2520	          double pv2 = psumsq - n * pm * pm, fv2 = fsumsq - n * fm * fm;
  2521	          if (pv2 <= 0.0 || fv2 <= 0.0) continue;                      // degenerate on union support
  2522	          c = (dot - n * pm * fm) / std::sqrt(pv2 * fv2);
  2523	        }
  2524	        else if (log_overlap_)
  2525	        {
  2526	          // Normalise BOTH log-profiles to unit sum, then intersect. The first attempt divided
  2527	          // the intersection by the precursor's total log-intensity alone, which made the score
  2528	          // bounded by the fragment/precursor INTENSITY RATIO: a genuine fragment at 1% of
  2529	          // precursor intensity scored ~0.01 however perfectly it co-eluted, and was gated out.
  2530	          // Measured -18.9% peptides at gate 0.5 and -9.1% at 0.3 -- a magnitude statistic
  2531	          // standing in for a shape statistic. Unit-sum normalisation makes this a distributional
  2532	          // intersection: 1 iff the two normalised elution shapes agree, invariant to scale --
  2533	          // which is what Pearson gets right and the first version did not.
  2534	          double fsum = 0.0;
  2535	          for (size_t k = 0; k < f.span(); ++k)
  2536	          { const double fv = xv(wst, f, k); if (fv > 0.0) fsum += std::log1p(fv); }
  2537	          if (fsum <= 0.0 || plogsum <= 0.0) continue;
  2538	          double inter = 0.0;
  2539	          for (size_t k = 0; k < f.span(); ++k)
  2540	          {
  2541	            const double fv = xv(wst, f, k); if (fv <= 0.0) continue;
  2542	            inter += std::min(std::log1p(fv) / fsum,
  2543	                              std::log1p((double)pdense[f.frame0 + k]) / plogsum);
  2544	          }
  2545	          c = inter;
  2546	        }
  2547	        else c = (dot - G * pmean * fg.mean[fi]) * pinv * fg.invnorm[fi]; // Pearson
  2548	        if (c < min_corr) continue;                                    // correlation gate
  2549	        emit(fi, c);
  2550	      }
  2551	      stat_rtpass_ += n_rtpass;
  2552	    }
  2553	    for (int gi : touched) pdense[gi] = 0.0f;                          // reset scratch
  2554	  }
  2555	
  2625	
  2626	  /// Build a pseudo-MS2 from a fragment list (m/z,intensity) + ranking scores: keeps top
  2627	  /// max_frags by score, drops if < min_frags, annotates the synthetic precursor. Deterministic.
  2628	  /// EXPORT-TIME CALIBRATION. On a flight-time axis the measured quantity is a bin; m/z is a
  2629	  /// calibrated function of it and of the frame's digitizer temperature. Applying that function
  2630	  /// ONCE, here, when the value is written, is what keeps the reported mass free of anything the
  2631	  /// intermediate gates did in cached m/z space -- and the apex frame's own factor is the most
  2632	  /// accurate one to use. A zero bin means the trace came from the OpenMS detector, which has no
  2633	  /// bin, and the value it computed stands.
  2634	  static double exportMz_(uint32_t tof, double b, double cached)
  2635	  {
  2636	    if (tof == 0 || !(b > 0.0) || !tofAxis().ok) return cached;
  2637	    const double v = tofAxis().mzOf(tof, b);
  2638	    return std::isfinite(v) && v > 0.0 ? v : cached;
  2639	  }
  2640	
  2641	  void assembleFromList_(const Precursor_& pc, double win_lo, double win_hi,
  2642	                         vector<pair<double, double>>& frags, vector<double>& frag_scores,
  2643	                         Size min_frags, Size max_frags, MSSpectrum& out) const
  2644	  {
  2645	    if (frags.size() < min_frags) return;
  2646	    if (frags.size() > max_frags)
  2647	    {
  2648	      vector<size_t> idx(frags.size());
  2649	      for (size_t i = 0; i < idx.size(); ++i) idx[i] = i;
  2650	      // Rank by correlation. Ties break on m/z, then index, so the output is deterministic.
  2651	      partial_sort(idx.begin(), idx.begin() + max_frags, idx.end(), [&](size_t a, size_t b) {
  2652	        const double ka = frag_scores[a];
  2653	        const double kb = frag_scores[b];
  2654	        if (ka != kb) return ka > kb;
  2655	        if (frags[a].first != frags[b].first) return frags[a].first < frags[b].first;
  2656	        return a < b;
  2657	      });
  2658	      vector<pair<double, double>> keep; keep.reserve(max_frags);
  2659	      for (size_t i = 0; i < max_frags; ++i) keep.push_back(frags[idx[i]]);
  2660	      frags.swap(keep);
  2661	    }
  2662	    out.setMSLevel(2);
  2663	    out.setType(SpectrumSettings::SpectrumType::CENTROID);
  2664	    out.setRT(pc.rt);
  2665	    for (const auto& fr : frags) out.emplace_back(fr.first, fr.second);
  2666	    out.sortByPosition();
  2667	    OpenMS::Precursor prec;
  2668	    prec.setMZ(exportMz_(pc.mono_tof, pc.mono_b, pc.mono_mz));   // calibrate on write
  2669	    if (pc.charge > 0) prec.setCharge(pc.charge);
  2670	    prec.setIsolationWindowLowerOffset(max(0.0, pc.mono_mz - win_lo));   // [C-5]
  2671	    prec.setIsolationWindowUpperOffset(max(0.0, win_hi - pc.mono_mz));
  2672	    prec.setDriftTime(pc.im);
  2673	    prec.setDriftTimeUnit(DriftTimeUnit::VSSC);
  2674	    out.setPrecursors({prec});
  2675	    // [provenance] Stamp the inference class onto the emitted spectrum so identified peptides can be
  2676	    // joined back to guessed (no isotope support) vs isotope-supported precursors -- the number that
  2677	    // sets the peptide cost of an isotope-support gate. Written as a <userParam> in the mzML.
  2678	    out.setMetaValue("spx_guessed", (int)(pc.guessed ? 1 : 0));
  2679	    // [Q4] Isotope-offset hypothesis for open/blind search: the number of isotope peaks behind the
  2680	    // mono call. 0/1 => the mono is weakly determined and could be off by +-k*1.00335 Da, so a
  2681	    // downstream delta-mass corrector should treat a near-integer-Da delta as an isotope miscall to
  2682	    // reassign rather than a real modification. Harmless in closed search (ignored).
  2683	    out.setMetaValue("spx_n_isotopes", pc.n_isotopes);
  2684	  }
  2685	
  2686	  /// [E5, 2026-09-02] The ONE place the emitted-intensity weights live. Returns {cap-key intensity,
  2687	  /// emitted intensity}: the IM-proximity weight feeds both (IM-on-c, orthogonal to correlation); the
  2688	  /// [Q2] correlation-power weight feeds ONLY the emitted (engine-visible) intensity -- putting it in the
  2689	  /// cap key made frag_scores = base*c^(k+1) and double-hit borderline-c faint fragments at the 500-cap.
  2690	  pair<double, double> weighted_(double base, double c, double dim) const
  2691	  {
  2692	    double inten = base;
  2693	    if (im_weight_sigma_ > 0.0) inten *= std::exp(-(dim * dim) / (2.0 * im_weight_sigma_ * im_weight_sigma_));
  2694	    double emit_inten = inten;
  2695	    if (corr_power_ > 0.0 && c > 0.0) emit_inten *= std::pow(c, corr_power_);
  2696	    return {inten, emit_inten};
  2697	  }
  2698	
  2699	  /// Per-precursor assembly: this precursor claims every fragment passing its gate (a fragment may
  2700	  /// be shared across precursors -> chimeric). Leaves @p out empty on failure.
  2701	  void assembleOne_(const Precursor_& pc, double win_lo, double win_hi,
  2702	                    const vector<Trace>& frag_traces, const TraceStore& wst, const vector<double>& frag_im,
  2703	                    const FragRt& frag_rt,
  2704	                    const vector<Trace>& ms1_traces, const TraceStore& ms1st, const FragStats& fg,
  2705	                    double delta_im, double delta_rt, double min_corr, int min_corr_pts,
  2706	                    Size min_frags, Size max_frags, vector<float>& pdense, MSSpectrum& out) const
  2707	  {
  2708	    vector<pair<double, double>> frags;
  2709	    vector<double> frag_scores;
  2710	    scoreCandidates_(pc, frag_traces, wst, frag_im, frag_rt, ms1_traces, ms1st, fg, delta_im, delta_rt, min_corr,
  2711	                     min_corr_pts, pdense, [&](size_t fi, double c) {
  2712	      const auto [inten, emit_inten] = weighted_(intensityOf(wst, frag_traces[fi]), c, frag_im[fi] - pc.im);
  2713	      frags.emplace_back(exportMz_(frag_traces[fi].tof, bOf(wst, frag_traces[fi]), frag_traces[fi].mz), emit_inten);
  2714	      frag_scores.push_back(c * inten);
  2715	    });
  2716	    assembleFromList_(pc, win_lo, win_hi, frags, frag_scores, min_frags, max_frags, out);
  2717	  }
  2718	
  2719	  ExitCodes main_(int argc, const char** argv) override
  2720	  {
  2721	    phase_clock_();   // [perf-instr] fix the epoch HERE: it is a first-call static, and the
  2722	                      // streaming path first touched it only AFTER loading, so load time was
  2723	                      // invisible and every [t=..] was relative to post-load.
  2724	
  2725	    // -threads defaults to 1 in TOPPBase, a poor default for a tool whose window loop IS the
  2726	    // runtime. Default to every core. The command line is scanned rather than the value tested,
  2727	    // so that an EXPLICIT `-threads 1` still means one thread: testing `value == 1` alone would
  2728	    // silently override the one user who actually wants it serial.
  2729	    int n_threads_req = getIntOption_("threads");
  2730	    {
  2731	      bool given = false;
  2732	      for (int i = 1; i < argc && !given; ++i) given = (String(argv[i]) == "-threads");
  2733	      if (!given && n_threads_req == 1)
  2734	      {
  2735	        n_threads_req = std::max(1, (int)std::thread::hardware_concurrency());
  2736	        omp_set_num_threads(n_threads_req);
  2737	        writeLogInfo_("-threads not given: using all " + String(n_threads_req) + " cores. Pass "
  2738	                      "-threads <n> to limit it, which is what you want on a shared machine.");
  2739	      }
  2740	    }
  2741	    const String in = getStringOption_("in");
  2742	    const String out = getStringOption_("out");
  2743	    const double delta_im = getDoubleOption_("gate:delta_im");
  2744	    const double delta_rt = getDoubleOption_("gate:delta_rt");
  2745	    if (getFlag_("diag:selftest_arena")) return selftestArena_();
  2746	    log_overlap_ = (getStringOption_("gate:coelution") == "logoverlap");
  2747	    im_weight_sigma_ = getDoubleOption_("assembly:im_weight_sigma");
  2748	    mono_guard_ = getDoubleOption_("charge:mono_averagine_guard");
  2749	    mono_select_ = getFlag_("charge:mono_averagine_select");
  2750	    var_support_ = getFlag_("gate:variance_support");
  2751	    corr_power_ = getDoubleOption_("assembly:corr_power");
  2752	    const double min_corr = getDoubleOption_("gate:min_correlation");
  2753	    const int min_corr_pts = getIntOption_("gate:min_correlation_points");
  2754	    const Size min_frags = (Size)getIntOption_("assembly:min_fragments");
  2755	    const Size max_frags = (Size)getIntOption_("assembly:max_fragments");
  2756	    const int max_charge = getIntOption_("max_charge");
  2757	    mzEstimator() = getStringOption_("trace:mz_estimator");   // before any toTrace() call
  2758	    const double mass_ppm = getDoubleOption_("trace:mass_error_ppm");
  2759	
  2760	    PeakMap exp;
  2761	    // Accept mzML, mzPeak, or a Bruker .d directory; FileHandler auto-detects the format
  2762	    // (mzPeak -> MzPeakFile; .d -> BrukerTimsFile, requires WITH_OPENTIMS).
  2763	    PeakMap ms1_map;
  2764	    map<WinKey, vector<CompactFrame>> ms2_by_window;
  2765	    CompactStats cstat;
  2766	    auto winKey = [](double lo, double hi, uint32_t window_group) -> WinKey {
  2767	      return {(int)llround(lo * 100.0), (int)llround(hi * 100.0), (int)window_group};
  2768	    };
  2769	    const bool stream_load = (getStringOption_("perf:stream_load") == "true");
  2770	    const bool trim_on = (getStringOption_("perf:malloc_trim") == "true");
  2771	    bool streamed = false;
  2772	
  2773	    if (stream_load)
  2774	    {
  2775	      // [stream] frame-by-frame: pick + compact on arrival, never hold the whole run.
  2776	      // Also the ONLY place the reader's NATIVE pre-centroid frame aggregation is reachable.
  2777	      BrukerTimsFile::Config cfg;
  2778	      cfg.dia_ms2_n_neighbors = getIntOption_("trace:native_ms2_neighbors");
  2779	      cfg.ms1_n_neighbors     = getIntOption_("trace:native_ms1_neighbors");
  2780	      PeakPickerIM spicker;
  2781	      Param sp = spicker.getParameters();
  2782	      sp.setValue("pickIMCluster:im_tolerance_cluster", getDoubleOption_("gate:delta_im"));
  2783	      sp.setValue("pickIMCluster:ppm_tolerance_cluster", getDoubleOption_("trace:mass_error_ppm"));
  2784	      if (const char* m = std::getenv("SPEXTRACTOR_PICK_MZ_MODE")) sp.setValue("pickIMCluster:mz_mode", std::string(m));   // [C2 pick-level A/B] weighted|seed|top3
  2785	      spicker.setParameters(sp);
  2786	      PickCompactConsumer consumer(spicker, ms2_by_window, ms1_map, cstat, winKey);
  2787	      try
  2788	      {
  2789	#ifdef SPEXTRACTOR_WITH_MZPEAK
  2790	        if (FileHandler::getTypeByFileName(in) == FileTypes::MZPEAK)
  2791	#else
  2792	        if (false)
  2793	#endif
  2794	        {
  2795	#ifdef SPEXTRACTOR_WITH_MZPEAK
  2796	          spx::loadMzPeakStreaming(in, consumer, n_threads_req);   // consumer counts frames itself
  2797	#else
  2798	          throw Exception::NotImplemented(__FILE__, __LINE__, "streaming .mzpeak input needs a build with -DMZPEAK_ROOT");
  2799	#endif
  2800	        }
  2801	        else BrukerTimsFile().loadDIAStreaming(in, consumer, cfg);
  2802	        streamed = true;
  2803	        phase_stats_()["LOAD(stream)"].wall = phase_clock_();      // [perf-instr] start-to-here
  2804	        phase_stats_()["LOAD(stream)"].cpu  = cpu_seconds_();
  2805	        phase_stats_()["LOAD(stream)"].rss_end_mb = rss_mb_();
  2806	        if (phase_stats_()["LOAD(stream)"].n++ == 0) phase_order_().push_back("LOAD(stream)");
  2807	        writeLogInfo_("[perf-load] pick(flush) wall=" + String(flush_wall_(), 1) + " s inside LOAD(stream)");
  2808	        if (std::getenv("SPEXTRACTOR_LOAD_ONLY")) { report_phases_(phase_clock_()); return EXECUTION_OK; }   // [perf-load] decode/hand-off/pick split only
  2809	        writeLogInfo_("[stream] frame-by-frame load done: " + String(consumer.frames_seen)
  2810	                      + " frames, MS1 " + String(ms1_map.size()) + ", windows "
  2811	                      + String(ms2_by_window.size()) + " (native ms2_neighbors="
  2812	                      + String(cfg.dia_ms2_n_neighbors) + ")" + clk_() + rss_() + mem_());
  2813	      }
  2814	      catch (const Exception::BaseException& e)
  2815	      {
  2816	        writeLogWarn_(String("[stream] streaming load failed (") + e.getName()
  2817	                      + "); falling back to loadExperiment. " + e.getMessage());
  2818	      }
  2819	    }
  2820	
  2821	    if (!streamed)
  2822	    {
  2823	      Phase _ph("LOAD(full)");
  2824	      FileHandler().loadExperiment(in, exp,
  2825	#ifdef SPEXTRACTOR_WITH_MZPEAK
  2826	                                   {FileTypes::MZML, FileTypes::MZPEAK, FileTypes::BRUKER_TDF},
  2827	#else
  2828	                                   {FileTypes::MZML, FileTypes::BRUKER_TDF},
  2829	#endif
  2830	                                   log_type_);
  2831	    }
  2832	
  2833	    //-------------------------------------------------------------
  2834	    // Input normalization / validation [C-4]
  2835	    //-------------------------------------------------------------
  2836	    // [stream] The streaming path fills ms1_map/ms2_by_window directly via an IM-aware consumer
  2837	    // (PickCompactConsumer calls ensureIMArrayName), leaving `exp` EMPTY -- so the exp-based IM check
  2838	    // only applies to the non-streaming load. Running it on the streamed (empty) `exp` wrongly aborted
  2839	    // with "no ion-mobility data at MS1", which is why native pre-centroiding aggregation could never
  2840	    // be benchmarked. Streamed data is guarded by the ms1_map.empty() check below instead.
  2841	    if (!streamed)
  2842	    {
  2843	      IMFormat imf = IMTypes::determineIMFormat(exp, 1);
  2844	      if (imf == IMFormat::NONE)
  2845	      {
  2846	        writeLogError_("Error: input has no ion-mobility data at MS1. SpeXtractor requires diaPASEF (IM DIA) input.");
  2847	        return ILLEGAL_PARAMETERS;
  2848	      }
  2849	    }
  2850	    // deliberate: assumes 1/K0 (VSSC). ms/CCS conversion and FAIMS rejection are Phase 2 [M-2].
  2851	
  2852	    // Centroid IM frames that are still profile, keeping per-peak IM at a tolerance no coarser
  2853	    // than the trace IM tolerance [C-2]. Split MS1 vs MS2 into separate working maps.
  2854	    if (!streamed)
  2855	    {
  2856	    PeakPickerIM picker;
  2857	    Param pp = picker.getParameters();
  2858	    pp.setValue("pickIMCluster:im_tolerance_cluster", delta_im);
  2859	    pp.setValue("pickIMCluster:ppm_tolerance_cluster", mass_ppm);
  2860	    picker.setParameters(pp);
  2861	
  2862	    // Peak-pick (centroid) all IM frames in PARALLEL. PeakPickerIM is firstprivate so each thread
  2863	    // has its own copy -> the mutable ccs_warning_shown_ flag is not shared (a shared const picker
  2864	    // would be a real data race). pickIMCluster mutates only its own spectrum; distinct indices are
  2865	    // independent. [par-Crit-1]
  2866	    writeLogInfo_("Loaded " + String(exp.size()) + " frames." + clk_() + rss_()); // raw residency peak? [mem]
  2867	    writeLogInfo_("Peak-picking " + String(exp.size()) + " frames (OpenMP)...");
  2868	    // Param is a deep-copy value type (mutable ParamNode root_, defaulted copy) so firstprivate
  2869	    // gives each thread a fully independent picker -> no refcount/COW race. pickIMCluster can throw
  2870	    // (e.g. unexpected IM format); an exception escaping an OMP region terminates the process, so
  2871	    // capture it and rethrow serially. [par-Crit-1, code-review]
  2872	    std::exception_ptr pick_err;
  2873	    #pragma omp parallel for firstprivate(picker) schedule(dynamic, 16)
  2874	    for (long i = 0; i < (long)exp.size(); ++i)
  2875	    {
  2876	      try
  2877	      {
  2878	        MSSpectrum& s = exp[i];
  2879	        if (!s.containsIMData()) continue;
  2880	        if (s.getIMPeakType() != IMPeakType::IM_CENTROIDED) picker.pickIMCluster(s);
  2881	        ensureIMArrayName(s); // so MassTraceDetection reads per-peak IM (IM-aware tracing) [C-1]
  2882	      }
  2883	      catch (...)
  2884	      {
  2885	        #pragma omp critical
  2886	        if (!pick_err) pick_err = std::current_exception();
  2887	      }
  2888	    }
  2889	    if (pick_err) std::rethrow_exception(pick_err);
  2890	
  2891	    // Serial dispatch: MOVE (not copy) frames into the MS1 map / per-window MS2 maps to avoid
  2892	    // transient memory doubling; container inserts aren't thread-safe so this stays serial.
  2893	    for (MSSpectrum& s : exp)
  2894	    {
  2895	      if (!s.containsIMData()) continue;
  2896	      if (s.getMSLevel() == 1)
  2897	      {
  2898	        ms1_map.addSpectrum(std::move(s));
  2899	      }
  2900	      else if (s.getMSLevel() == 2 && !s.getPrecursors().empty())
  2901	      {
  2902	        const OpenMS::Precursor& pr = s.getPrecursors()[0];
  2903	        double lo = pr.getMZ() - pr.getIsolationWindowLowerOffset();
  2904	        double hi = pr.getMZ() + pr.getIsolationWindowUpperOffset();
  2905	        ms2_by_window[winKey(lo, hi, windowGroupOf(s.getNativeID()))].push_back(compactify(s, cstat));
  2906	        s.clear(true);   // [mem] the picked frame is dead once compacted; waiting for exp.clear()
  2907	      }                  // below held the whole picked run (20 B/peak) beside the compact store
  2908	    }
  2909	    }
  2910	    exp.clear(true); // frames moved out; release the container
  2911	    {
  2912	      size_t cb = 0, cp = 0;
  2913	      for (const auto& kv : ms2_by_window) for (const auto& f : kv.second) { cb += f.bytes(); cp += f.mzq.size(); }
  2914	      const size_t lost = cstat.no_im_array + cstat.size_mismatch + cstat.bad_mz + cstat.bad_im;
  2915	      if (lost)
  2916	      {
  2917	        writeLogWarn_("[compact] DROPPED " + String(lost) + " peaks: no_im_array=" + String(cstat.no_im_array)
  2918	                      + " size_mismatch=" + String(cstat.size_mismatch) + " bad_mz=" + String(cstat.bad_mz)
