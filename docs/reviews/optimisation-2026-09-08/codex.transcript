   480	  /// MassTraceDetection locates the per-peak IM array by the exact name
   481	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   482	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   483	  void ensureIMArrayName(MSSpectrum& s)
   484	  {
   485	    auto& fdas = s.getFloatDataArrays();
   486	    if (s.containsIMData())
   487	    {
   488	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   489	      return;
   490	    }
   491	    for (auto& fda : fdas)
   492	    {
   493	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   494	      {
