   446	          snr_ok = false;
   447	        }
   448	      }
   449	
   450	      if (pw_ok && snr_ok)
   451	      {
   452	        mt.updateSmoothedMaxRT();
   453	
   454	        if (pw_filtering_ != "fixed")
   455	        {
   456	          mt.estimateFWHM(true);
   457	        }
   458	
   459	#ifdef _OPENMP
   460	#pragma omp critical (OPENMS_ElutionPeakDetection_mtraces)
   461	#endif
   462	        {
   463	          single_mtraces.push_back(mt);
   464	        }
   465	
   466	      }
   467	    }
   468	    else if (maxes.empty())
