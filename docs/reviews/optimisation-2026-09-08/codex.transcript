   924	    // intensities the LATER peak seeds first.
   925	    auto cmp = [&](uint32_t a, uint32_t b) {
   926	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   927	      return a > b;
   928	    };
   929	    const int nb = (int)bnd.size() - 1;
   930	    tp.order.resize(n_seed);
   931	    if (nb < 2)                                          // unbanded: one globally sorted list
   932	    {
   933	      size_t w = 0;
   934	      for (uint32_t k = 0; k < P; ++k)
   935	        if ((double)sl.inten[k] > noise && (double)sl.inten[k] > min_apex) tp.order[w++] = k;
   936	      sort(tp.order.begin(), tp.order.end(), cmp);
   937	      tp.seg = {0, n_seed};
   938	      return tp;
   939	    }
   940	    // Band of a peak: the same half-open [bnd[b], bnd[b+1]) partition the detector applies, found
   941	    // by upper_bound so that empty bands (bnd[b] == bnd[b+1], reachable when nb exceeds the tof
   942	    // range) are skipped exactly as the detector's own range test skips them.
   943	    auto bandOf = [&](TofIdx t) {
   944	      return (size_t)(std::upper_bound(bnd.begin(), bnd.end(), t) - bnd.begin() - 1);
   945	    };
   946	    vector<size_t> cnt(nb, 0);
   947	    for (uint32_t k = 0; k < P; ++k)
   948	      if ((double)sl.inten[k] > noise && (double)sl.inten[k] > min_apex) ++cnt[bandOf(sl.tof[k])];
   949	    tp.seg.assign(nb + 1, 0);
   950	    for (int b = 0; b < nb; ++b) tp.seg[b + 1] = tp.seg[b] + cnt[b];
   951	    vector<size_t> cur(tp.seg.begin(), tp.seg.end() - 1);
   952	    for (uint32_t k = 0; k < P; ++k)
   953	      if ((double)sl.inten[k] > noise && (double)sl.inten[k] > min_apex) tp.order[cur[bandOf(sl.tof[k])]++] = k;
   954	    #pragma omp taskloop grainsize(1) default(shared)
   955	    for (int b = 0; b < nb; ++b)
   956	      sort(tp.order.begin() + tp.seg[b], tp.order.begin() + tp.seg[b + 1], cmp);
   957	    buildTofIndex(sl, tp, tlo, thi);
   958	    return tp;
   959	  }
   960	
   961	  vector<Trace> detectTracesInteger_(const PeakSlab& sl, const TracePrep& tp, TraceStore& store, double mass_ppm,
   962	                                     double im_tol, double noise, double min_len_sec, double min_sample_rate,
   963	                                     TofIdx band_lo = 0, TofIdx band_hi = 0,
   964	                                     int band = -1)
   965	  {
   966	    vector<Trace> out;
   967	    const size_t F = sl.frames(), P = sl.tof.size();
   968	    if (F == 0 || P == 0) return out;
   969	    const bool banded = band_hi > band_lo;
   970	    const TofAxis& ax = tofAxis();
   971	    const double msr = min_sample_rate >= 0.0 ? min_sample_rate : 0.5;   // -1 = OpenMS default
   972	    const double imq_tol = im_tol * IM_Q;
   973	    const Size max_missed = 5;                                            // trace_termination_outliers
   974	    // a peak's frame, for the two sites that do not already have it in a loop variable
   975	    auto frameOfPeak = [&](uint32_t k) {
   976	      return (uint32_t)(std::upper_bound(sl.frame_off.begin(), sl.frame_off.end(), k) - sl.frame_off.begin() - 1);
   977	    };
   978	    const auto member = [&](uint32_t k) { return (double)sl.inten[k] > noise; };
   979	
   980	    vector<uint64_t> visited((P + 63) / 64, 0);   // one BIT per peak: 8x less than the char array
   981	    auto seen = [&](size_t k) { return (visited[k >> 6] >> (k & 63)) & 1u; };
   982	    auto mark = [&](size_t k) { visited[k >> 6] |= (uint64_t)1 << (k & 63); };
   983	    auto mzAt = [&](uint32_t k, size_t f) { return ax.mzOf(sl.tof[k], sl.b[f]); };
   984	    auto iwm = [](double v, double w, double& c, double& cnt, double& den) {   // updateIterativeWeightedMean_
   985	      const double ct = 1.0 + (w * v) / cnt, dt = 1.0 + w / den;
   986	      c *= (ct / dt); cnt += w * v; den += w;
   987	    };
   988	    auto sdRobust = [](double mz, double w, double mean, double& sd, double& wsum) {   // updateWeightedSDEstimateRobust
   989	      const double d1 = std::log(wsum) + 2.0 * std::log(sd);
   990	      const double d2 = std::log(w) + 2.0 * std::log(std::abs(mz - mean));
   991	      const double denom = std::sqrt(std::exp(d1) + std::exp(d2));
   992	      const double ws = wsum + w;
   993	      const double t = denom / std::sqrt(ws);
   994	      if (t > std::numeric_limits<double>::epsilon()) sd = t;
   995	      wsum = ws;
   996	    };
   997	    /// findBestPeak_ + isPeakAcceptable_: the closest peak in m/z within +-3 sd of the running
   998	    /// centroid whose mobility is inside the gate; -1 for "no candidate", and `taken` set when the
   999	    /// closest one is already used, which OpenMS counts as a miss rather than trying the next.
  1000	    /// The +-3 sd window is converted to a BIN range once per frame step, so the walk is bounded
  1001	    /// by two calibration calls and a binary search; only candidates inside that window are
  1002	    /// converted back to m/z for the comparison.
  1003	    auto best = [&](size_t f, double cmz, double sd, double cim, bool& taken) -> long {
  1004	      taken = false;
  1005	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
  1006	      if (b <= a) return -1;
  1007	      const double bf = sl.b[f];
  1008	      const double lo_mz = cmz - 3.0 * sd, hi_mz = cmz + 3.0 * sd;
  1009	      const TofIdx lo_t = ax.tofOf(lo_mz > 0.0 ? lo_mz : 1e-9, bf);
  1010	      const TofIdx hi_t = ax.tofOf(hi_mz, bf);
  1011	      uint32_t r0 = a, r1 = b; tp.range(f, lo_t, a, b, r0, r1);   // [tofidx] computed, not searched
  1012	      const uint32_t s0 = (uint32_t)(lower_bound(sl.tof.begin() + r0, sl.tof.begin() + r1, lo_t) - sl.tof.begin());
  1013	      long bk = -1; double bd = std::numeric_limits<double>::infinity();
  1014	      for (uint32_t k = s0; k < b && sl.tof[k] <= hi_t; ++k)
  1015	      {
  1016	        if (!member(k)) continue;
  1017	        if (std::abs((double)sl.imq[k] - cim) > imq_tol) continue;
  1018	        // "Closest" is measured in m/z, as OpenMS does, NOT in bins: I had argued the calibration
  1019	        // is monotone so the two agree, and that is true only for candidates on the same side of
  1020	        // the centroid -- across it, the map's curvature can flip which is nearer. Measured: the
  1021	        // bin metric cost 1.4% of peptides (12,650 -> 12,466) and bought no time (the speed came
  1022	        // from parallel valley splitting). The walk is still bounded in bins; only candidates
  1023	        // inside the window pay the conversion.
  1024	        const double d = std::abs(ax.mzOf(sl.tof[k], bf) - cmz);
  1025	        if (d < bd) { bd = d; bk = (long)k; }          // strict <: first of equals wins
  1026	      }
  1027	      if (bk >= 0 && seen((size_t)bk)) { taken = true; return -1; }
  1028	      return bk;
  1029	    };
  1030	
  1031	    struct Dir { Size hits = 0, missed = 0, scans = 0; bool active = true; };
  1032	    vector<pair<uint32_t, uint32_t>> got;   // (frame, peak); marked only if the trace is valid
  1033	    // [seg] Only this band's own segment of the seed list; the range test below stays as the
  1034	    // invariant it always was (and is what the unbanded/whole-list call still relies on).
  1035	    const bool segd = band >= 0 && (size_t)band + 1 < tp.seg.size();
  1036	    const size_t s0 = segd ? tp.seg[band] : 0, s1 = segd ? tp.seg[band + 1] : tp.order.size();
  1037	    for (size_t si = s0; si < s1; ++si)
  1038	    {
  1039	      const uint32_t seed = tp.order[si];
  1040	      if (banded && (sl.tof[seed] < band_lo || sl.tof[seed] >= band_hi)) continue;   // not this band's core
  1041	      if (seen(seed)) continue;
  1042	      const size_t f0 = frameOfPeak(seed);
  1043	      const double w0 = sl.inten[seed], m0 = mzAt(seed, f0);
  1044	      double cmz = m0, cnt = w0 * m0, den = w0;
  1045	      iwm(m0, w0, cmz, cnt, den);                             // seed counted twice, as run_ does
  1046	      double cim = sl.imq[seed], cnt_im = w0 * cim, den_im = w0;
  1047	      iwm((double)sl.imq[seed], w0, cim, cnt_im, den_im);
  1048	      double sd = (cmz / 1e6) * mass_ppm, wsum = w0;
  1049	      got.clear(); got.emplace_back((uint32_t)f0, seed);
  1050	      Dir dn, up;
  1051	      long fd = (long)f0, fu = (long)f0;
  1052	      while ((fd > 0 && dn.active) || (fu + 1 < (long)F && up.active))
  1053	      {
  1054	        for (int side = 0; side < 2; ++side)
  1055	        {
  1056	          Dir& d = side == 0 ? dn : up;
  1057	          long& fi = side == 0 ? fd : fu;
  1058	          if (!d.active) continue;
  1059	          if (side == 0 ? !(fi > 0) : !(fi + 1 < (long)F)) continue;
  1060	          const size_t f = (size_t)(side == 0 ? fi - 1 : fi + 1);
  1061	          // "empty" AFTER sub-noise deletion, as OpenMS tests it. Testing raw emptiness instead is
  1062	          // the A/B that attributes the 12,650 -> 12,466 move between the two corrected versions,
  1063	          // which is the only semantic change between them.
  1064	          if (tp.frame_live[f])
  1065	          {
  1066	            bool taken = false;
  1067	            const long k = best(f, cmz, sd, cim, taken);
  1068	            if (k >= 0)
  1069	            {
  1070	              const double mz = mzAt((uint32_t)k, f), w = sl.inten[k];
  1071	              iwm(mz, w, cmz, cnt, den);
  1072	              iwm((double)sl.imq[k], w, cim, cnt_im, den_im);
  1073	              sdRobust(mz, w, cmz, sd, wsum);   // reestimate_mt_sd: the tool never turns it off
  1074	              got.emplace_back((uint32_t)f, (uint32_t)k);
  1075	              ++d.hits; d.missed = 0;
  1076	            }
  1077	            else ++d.missed;
  1078	          }
  1079	          fi += (side == 0 ? -1 : 1);
  1080	          ++d.scans;
  1081	          if (d.missed > max_missed) d.active = false;
  1082	        }
  1083	      }
  1084	      // isTraceValid_
  1085	      uint32_t fmin = got[0].first, fmax = fmin;
  1086	      for (const auto& g : got) { fmin = std::min(fmin, g.first); fmax = std::max(fmax, g.first); }
  1087	      const double span_s = rtAxis()[sl.rt_index[fmax]] - rtAxis()[sl.rt_index[fmin]];
  1088	      if (span_s < min_len_sec) continue;
  1089	      const Size total = dn.scans + up.scans + 1;
  1090	      const Size adjusted = total > dn.missed + up.missed ? total - dn.missed - up.missed : 1;
  1091	      if ((double)got.size() / (double)adjusted < msr) continue;
  1092	      for (const auto& g : got) mark(g.second);               // valid: now they are taken
  1093	
  1094	      // the span: (store-local frame, intensity) points, plus the per-frame bin arena the valley
  1095	      // splitter needs to give each child ITS measured apex bin
  1096	      vector<pair<uint32_t, float>> pts;
  1097	      pts.reserve(got.size());
  1098	      uint32_t kap = got[0].second, fap = got[0].first;
  1099	      for (const auto& g : got) { pts.emplace_back(g.first, sl.inten[g.second]);
  1100	                                  if (sl.inten[g.second] > sl.inten[kap]) { kap = g.second; fap = g.first; } }
  1101	      Trace t = makeSpan(pts, store);
  1102	      store.bins.resize(store.inten.size(), 0u);
  1103	      for (const auto& g : got) store.bins[t.off + (g.first - t.frame0)] = sl.tof[g.second];
  1104	      t.tof = sl.tof[kap]; t.bframe = fap;   // got-order first max: the frame the bin was measured on
  1105	      t.mz = cmz;                                              // the weighted centroid, as OpenMS reports
  1106	      t.rt = rtAxis()[sl.rt_index[fap]];
  1107	      t.im = IM_LO + cim / IM_Q;
  1108	      out.push_back(std::move(t));
  1109	    }
  1110	    return out;
  1111	  }
  1112	
  1113	  /// Integer traces -> MassTrace objects for EPD -> Trace again, with the flight-time bin
  1114	  /// re-attached from the apex frame's calibration. Only the TRACES become OpenMS objects -- the
  1115	  /// peak arrays never do, which is the point of the integer path.
  1116	  ///
  1117	  /// CHUNKED AND PARALLEL, like the OpenMS path's own valley-splitting step (do_split over
  1118	  /// bands*4 chunks as tasks). The previous version converted every trace of a window into a
  1119	  /// MassTrace (a list<Peak2D>, ~48 B/point) on ONE thread and then ran ElutionPeakDetection over
  1120	  /// all of them at once, also on one thread: a serial section of a stage that is 95% of the window
  1121	  /// loop, and the whole window's list-based copy alive at the same time. That is consistent with
  1122	  /// what was measured -- occupancy 44x against 81x for the OpenMS path, and MORE peak memory,
  1123	  /// after the per-band sorts and the per-visit calibration calls had already been removed and
  1124	  /// changed nothing.
  1125	  vector<Trace> splitIntegerTraces(vector<Trace>& in, double split_valleys, TraceStore& wst, int nchunk)
  1126	  {
  1127	    if (split_valleys <= 0.0 || in.size() < 2) return std::move(in);   // OpenMS branch: EPD needs > 1
  1128	    const TofAxis& ax = tofAxis();
  1129	    nchunk = std::max(1, std::min<int>(nchunk, (int)in.size()));
  1130	    vector<vector<Trace>> parts(nchunk);
  1131	    vector<TraceStore> stores(nchunk);                         // chunk-private arenas, merged after
  1132	    const size_t n_in = in.size();
  1133	    #pragma omp taskloop grainsize(1) default(shared)
  1134	    for (int ci = 0; ci < nchunk; ++ci)
  1135	    {
  1136	      const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1137	      TraceStore& cst = stores[ci];
  1138	      cst.setFrames(wst.rt_index, &wst.b);
  1139	      // STREAMED: one MassTrace in flight, not the chunk's worth. The two-phase version built every
  1140	      // input trace of the chunk as a MassTrace and kept them all alive across the split, so the
  1141	      // input payload and the whole split output coexisted -- the two largest ledger lines after the
  1142	      // slab. Per-trace is exactly equivalent: with width_filtering=off and masstrace_snr_filtering
  1143	      // =false the cross-trace routines are unreachable, and the lock-free patch's nested path is
  1144	      // itself `for (i..) detectElutionPeaks_(mt_vec[i], out)` appending in the same order.
  1145	      //
  1146	      // epd is hoisted to chunk scope deliberately. splitValleys constructed one and did
  1147	      // getParameters/setValue x4/setParameters on EVERY call; moving that inside a per-trace loop
  1148	      // would be ~4e4 Param round-trips per chunk and would trade the memory win for a slowdown.
  1149	      ElutionPeakDetection epd;
  1150	      epd.setLogType(ProgressLogger::NONE);
  1151	      {
  1152	        Param ep = epd.getParameters();
  1153	        ep.setValue("chrom_fwhm", split_valleys);
  1154	        ep.setValue("width_filtering", "off");
  1155	        ep.setValue("masstrace_snr_filtering", "false");
  1156	        epd.setParameters(ep);
  1157	      }
  1158	      vector<Trace>& out = parts[ci];
  1159	      out.reserve((hi - lo) + (hi - lo) / 3);   // measured 1.316 children per parent over 28 windows:
  1160	      // reserving the PARENT count made every chunk cross exactly one doubling. [2026-09-06]
  1161	                              // Measured no regression (dataset D got faster and lighter); revisit only if it shows up.
  1162	      vector<Peak2D> pk;                                      // reused: a vector, not a per-point list
  1163	      vector<MassTrace> split;                                // reused: detectPeaks clears it itself
  1164	      for (size_t q = lo; q < hi; ++q)
  1165	      {
  1166	        const Trace& t = in[q];
  1167	        pk.clear();
  1168	        for (size_t k = 0; k < t.span(); ++k)                 // REAL points only: EPD smooths what it is given
  1169	        {
  1170	          if (!real(wst, t, k)) continue;
  1171	          Peak2D pt; pt.setRT(rtAtSpan(wst, t, k)); pt.setIntensity(xv(wst, t, k));
  1172	          const uint32_t bin = wst.bins.empty() ? 0u : wst.bins[t.off + k];
  1173	          pt.setMZ(ax.ok && bin ? ax.mzOf(bin, wst.b[t.frame0 + k]) : t.mz);
  1174	          pk.push_back(pt);
  1175	        }
  1176	        MassTrace mt(pk);
  1177	        mt.setCentroidIM(t.im);
  1178	        epd.detectPeaks(mt, split);
  1179	        // Each child carries its own measured m/z: the parent's per-frame bin was written into
  1180	        // every Peak2D above, so the child's APEX PEAK m/z is that bin's m/z and the bin comes back
  1181	        // by inverting the calibration -- which is what the pre-span code did.
  1182	        //
  1183	        // The first version of this walked the parent list to look the bin up by frame. That was
  1184	        // wrong: parents within a chunk are in IM/m-z order, not frame order, and their frame ranges
  1185	        // overlap freely, so the walk could attribute a child to the wrong parent and hand it another
  1186	        // trace's bin. It cost 3.3% of peptides on dataset D while the OpenMS arm stayed digest-identical,
  1187	        // which is what localised it here. [2026-09-04]
  1188	        for (const MassTrace& cm : split)
  1189	        {
  1190	          Trace c = toTrace(cm, cst);
  1191	          if (c.np() == 0) continue;
  1192	          const uint32_t cf = c.frame0 + c.apex;               // apex frame, window-local
  1193	          c.bframe = cf;
  1194	          const double cb = wst.b.empty() ? ax.factor(0) : wst.b[cf];
  1195	          const double amz = cm.getSize() ? cm[cm.findMaxByIntPeak(false)].getMZ() : c.mz;
  1196	          c.tof = ax.ok ? ax.tofOf(amz, cb) : 0u;
  1197	          out.push_back(std::move(c));
  1198	        }
  1199	      }
  1200	    }
  1201	    // the parents' spans are dead: rebuild the window arena from the chunk arenas
  1202	    vector<Trace>().swap(in);
  1203	    vector<float>().swap(wst.inten); vector<uint32_t>().swap(wst.bins);
  1204	    size_t tot = 0, arena = 0; bool any_bins = false;
  1205	    for (int ci = 0; ci < nchunk; ++ci)
  1206	    { tot += parts[ci].size(); arena += stores[ci].inten.size(); any_bins |= !stores[ci].bins.empty(); }
  1207	    // absorb() appends without reserving and the window arena was just swapped empty, so without
  1208	    // this the 48 chunk appends regrow it geometrically. Note this trades regrowth for allocating
  1209	    // the whole destination while every source is still live: it removes the copies, but whether
  1210	    // it lowers the PEAK is a measurement, not a deduction.
  1211	    wst.inten.reserve(arena); if (any_bins) wst.bins.reserve(arena);
  1212	    vector<Trace> out; out.reserve(tot);
  1213	    for (int ci = 0; ci < nchunk; ++ci)
  1214	    {
  1215	      const uint32_t base = wst.absorb(stores[ci]);
  1216	      for (auto& t : parts[ci]) { t.off += base; out.push_back(std::move(t)); }
  1217	      vector<Trace>().swap(parts[ci]);
  1218	    }
  1219	    return out;
  1220	  }
  1221	
  1222	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
  1223	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
  1224	  PeakMap materializeWindow(vector<CompactFrame>& frames)
  1225	  {
  1226	    PeakMap m;
  1227	    m.reserve(frames.size());
  1228	    for (auto& f : frames)
  1229	    {
  1230	      MSSpectrum s;
  1231	      s.setRT(f.rt);
  1232	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
  1233	      s.reserve(f.mzq.size());
  1234	      OpenMS::DataArrays::FloatDataArray ima;
  1235	      ima.setName(Constants::UserParam::ION_MOBILITY);
  1236	      ima.reserve(f.mzq.size());
  1237	      for (size_t i = 0; i < f.mzq.size(); ++i)
  1238	      {
  1239	        Peak1D p;
  1240	        p.setMZ((double)f.mzq[i] / MZ_Q);
  1241	        p.setIntensity(f.inten[i]);
  1242	        s.push_back(p);
  1243	        ima.push_back((float)(IM_LO + (double)f.imq[i] / IM_Q));
  1244	      }
  1245	      s.getFloatDataArrays().push_back(std::move(ima));
  1246	      m.addSpectrum(std::move(s));
  1247	      // release this frame's compact storage immediately
  1248	      vector<uint32_t>().swap(f.mzq);
  1249	      vector<float>().swap(f.inten);
  1250	      vector<uint16_t>().swap(f.imq);
  1251	    }
  1252	    vector<CompactFrame>().swap(frames);
  1253	    return m;
  1254	  }
