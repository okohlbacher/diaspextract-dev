   112	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
   113	
   114	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
   115	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
   116	  /// printed unconditionally at the end so a benchmark log always says where the time went.
   117	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
