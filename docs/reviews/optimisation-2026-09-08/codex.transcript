   119	  inline std::map<std::string, PhaseStat>& phase_stats_()
   120	  { static std::map<std::string, PhaseStat> m; return m; }
   121	  inline std::vector<std::string>& phase_order_()
   122	  { static std::vector<std::string> v; return v; }
   123	  static double cpu_seconds_()
   124	  {
   125	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   126	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
