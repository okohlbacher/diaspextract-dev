   501	  /// Reported-m/z estimator, set once from `trace:mz_estimator` before any trace is converted.
   502	  /// A file-scope value because toTrace() is a free helper with no access to the tool's parameters.
   503	  inline std::string& mzEstimator() { static std::string v = "apex"; return v; }
   504	
   505	  Trace toTrace(const MassTrace& mt, TraceStore& store)
   506	  {
   507	    Trace t;
   508	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   509	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   510	    // `trace:mz_estimator` -- see docs/BASELINE.md for the comparison that chose apex.
   511	    const std::string& mz_est = mzEstimator();
   512	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   513	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   514	    else t.mz = mt.getCentroidMZ();
   515	    t.rt = mt.getCentroidRT();
   516	    t.im = mt.getCentroidIM();
   517	    // One peak per frame (MassTraceDetection takes at most one candidate per spectrum), so the
   518	    // profile is a span over the store's frame table with zeros where frames were missed.
   519	    const Size np = mt.getSize();
   520	    vector<pair<uint32_t, float>> pts;
   521	    pts.reserve(np);
   522	    for (Size i = 0; i < np; ++i) pts.emplace_back(store.frameOf(mt[i].getRT()), (float)mt[i].getIntensity());
   523	    Trace sp = makeSpan(pts, store);
   524	    sp.mz = t.mz; sp.rt = t.rt; sp.im = t.im;
   525	    return sp;
   526	  }
   527	
   528	
   529	  /// [compact] Quantised frame store for the per-window buffer.
   530	  ///
   531	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   532	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   533	  /// cores (the reference implementation uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   534	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   535	  /// that is about to trace it, freeing the compact copy immediately.
   536	  ///
   537	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   538	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   539	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   540	  ///   intensity: float32, unchanged (Peak1D already stores float)
   541	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   542	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   543	
   544	  /// THE M/Z AXIS IS THE INSTRUMENT'S FLIGHT-TIME INDEX. A timsTOF measures an integer TOF bin;
   545	  /// m/z is a calibrated function of it, not a measured quantity. The compact store had been
   546	  /// quantising the CALIBRATED m/z onto a uniform 1e-5 Da grid -- a second discretisation on top of
   547	  /// the instrument's own, and a coarse approximation of the wrong axis. This tool only runs on
   548	  /// ion-mobility TOF data, so the native axis is always available and there is no reason to
   549	  /// approximate it.
   550	  ///
   551	  /// Why the native axis is better than a uniform m/z grid, not merely smaller:
   552	  ///   * it is LOSSLESS -- the bin IS the measurement, so no quantum has to be justified;
   553	  ///   * ~5e5 bins instead of ~1.7e8 grid points, so a bin index is a usable array subscript;
   554	  ///   * the SAME ion gives the SAME bin in every frame, while its calibrated m/z wobbles with the
   555	  ///     digitizer temperature -- so grouping in TOF space does not have to spend part of its ppm
   556	  ///     tolerance absorbing calibration drift, which is exactly what the m/z-space tolerance does;
   557	  ///   * a tolerance in m/z ppm becomes a handful of integer bins (m ~ tof^2, so a relative m/z
   558	  ///     tolerance is about half of it in tof), which makes candidate lookup pure arithmetic.
   559	  ///
   560	  /// The per-frame factor `b` (from the digitizer temperature) is what turns a bin into an m/z, and
   561	  /// it is applied at REPORT time, where it belongs -- the extraction never needs a calibrated m/z.
   562	  using TofIdx = uint32_t;
   563	
   564	  /// The flight-time axis for one run: the calibration model plus each frame's temperature factor.
   565	  /// Fail-closed: without a calibration there is no TOF axis and the caller must not pretend there
   566	  /// is one.
   567	  struct TofAxis
   568	  {
   569	    spextractor::TdfMzCalibration cal;
   570	    vector<double> b_by_frame;        ///< frame factor per FRAME ID (index 0 unused, as in the tdf)
   571	    bool ok = false;
   572	
   573	    double factor(size_t frame_id) const
   574	    { return frame_id < b_by_frame.size() ? b_by_frame[frame_id] : cal.frameFactor(cal.T1_ref); }
   575	    double mzOf(TofIdx tof, double b) const { return cal.tofToMz((double)tof, b); }
   576	    TofIdx tofOf(double mz, double b) const
   577	    {
   578	      const double t = cal.mzToTof(mz, b);
   579	      return t > 0.0 ? (TofIdx)llround(t) : 0u;
   580	    }
   581	    /// A relative m/z tolerance as a bin count, derived rather than assumed: convert both ends.
   582	    TofIdx span(TofIdx tof, double b, double ppm) const
   583	    {
   584	      const double mz = mzOf(tof, b);
   585	      if (!(mz > 0.0)) return 1u;
   586	      const double t2 = cal.mzToTof(mz * (1.0 + ppm * 1e-6), b);
   587	      const double d = fabs(t2 - (double)tof);
   588	      return (TofIdx)std::max(1.0, d + 0.5);
   589	    }
   590	  };
   591	
   592	  inline TofAxis& tofAxis() { static TofAxis a; return a; }
   593	
   594	  /// Populate the flight-time axis from a Bruker analysis.tdf (the .d directory, or a sidecar).
   595	  /// Returns false and leaves the axis unusable if anything is missing -- the detector that needs it
   596	  /// refuses to run rather than substituting a reference temperature for every frame.
   597	  inline bool loadTofAxis(const std::string& tdf_path, String& why)
   598	  {
   599	    TofAxis& ax = tofAxis();
   600	    ax.ok = false;
   601	    std::vector<double> t1;
   602	    if (!spextractor::loadTdfCalibration(tdf_path, ax.cal, t1, why)) return false;
   603	    ax.b_by_frame.assign(t1.size(), 0.0);
   604	    for (size_t i = 1; i < t1.size(); ++i) ax.b_by_frame[i] = ax.cal.frameFactor(t1[i]);
   605	    // Frames the tdf did not list keep the reference factor rather than a zero -- but index 0
   606	    // is NOT such a frame. It is the "unknown frame" sentinel (the tdf's Frames.Id starts at 1),
   607	    // and frameIdOf() returns 0 for any nativeID it cannot parse. Backfilling it to bref is what
   608	    // let an mzML+sidecar input skip the fallback warning and calibrate every unmapped frame at
   609	    // reference temperature -- the invented calibration this path is supposed to refuse.
   610	    const double bref = ax.cal.frameFactor(ax.cal.T1_ref);
   611	    for (size_t i = 1; i < ax.b_by_frame.size(); ++i) if (!(ax.b_by_frame[i] > 0.0)) ax.b_by_frame[i] = bref;
   612	    ax.b_by_frame[0] = 0.0;
   613	    ax.ok = true;
   614	    return true;
   615	  }
   616	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   617	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   618	
   619	  struct CompactFrame
   620	  {
   621	    double rt = 0.0;
   622	    uint32_t frame_id = 0;   ///< vendor frame Id: the key the per-frame calibration factor is on
   623	    vector<uint32_t> mzq;
   624	    vector<float> inten;
   625	    vector<uint16_t> imq;
   626	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   627	  };
   628	
   629	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   630	  /// Clamping out-of-range 1/K0 to IM_LO/IM_HI would pin outliers from many frames onto two
   631	  /// artificial, perfectly-aligned mobility values — manufacturing spurious traces out of nothing.
   632	  /// NaN also passed straight through clamp into llround (UB on unsigned conversion). Dropping +
   633	  /// counting is the only defensible behaviour.
   634	  struct CompactStats
   635	  {
   636	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   637	    size_t unmapped_frame = 0;   ///< nativeID carried no parseable "frame=": cannot be calibrated
   638	    /// merge per-frame stats after a parallel batch [perf-load]
   639	    CompactStats& operator+=(const CompactStats& o)
   640	    {
   641	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   642	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   643	      unmapped_frame += o.unmapped_frame;
   644	      return *this;
   645	    }
   646	  };
   647	
   648	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   649	  /// Vendor frame Id from a native identifier. Bruker writes "frame=<N> scan=<M>"; the mzPeak
   650	  /// reader writes "mzpeak=<frame index> window=<w>". Anything else yields 0, which makes the
   651	  /// calibration fall back to the reference temperature -- so the caller must treat 0 as unknown.
   652	  inline uint32_t nidField(const String& nid, const char* key)
   653	  {
   654	    const size_t i = nid.find(key);
   655	    if (i == std::string::npos) return 0;
   656	    uint32_t v = 0; size_t k = i + strlen(key);
   657	    for (; k < nid.size() && isdigit((unsigned char)nid[k]); ++k) v = v * 10 + (uint32_t)(nid[k] - '0');
   658	    return v;
   659	  }
   660	  /// Only the vendor's own "frame=" key names a Frames.Id. The mzPeak reader's "mzpeak=" is an
   661	  /// ARCHIVE index and must not be used as one; that input falls back to the reference factor.
   662	  inline uint32_t frameIdOf(const String& nid) { return nidField(nid, "frame="); }
   663	  /// "windowGroup=<WindowGroup>": which acquisition group this frame belongs to. A group holds each
   664	  /// isolation m/z at most once, so (m/z, group) names one ion-mobility slice of the window; the
   665	  /// scan range alone does not (two slices can share ScanNumBegin = 0 and differ in ScanNumEnd).
   666	  /// 0 when absent (mzPeak input), which keeps that path keyed by m/z alone, as before.
   667	  inline uint32_t windowGroupOf(const String& nid) { return nidField(nid, "windowGroup="); }
   668	
   669	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   670	  {
   671	    CompactFrame f;
   672	    f.rt = s.getRT();
   673	    f.frame_id = frameIdOf(s.getNativeID());
   674	    if (f.frame_id == 0) ++st.unmapped_frame;
   675	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   676	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   677	    const Size n = s.size();
   678	    if (im.size() != n) { st.size_mismatch += n; return f; }   // no out-of-bounds read
   679	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   680	    for (Size i = 0; i < n; ++i)
   681	    {
   682	      const double mz = s[i].getMZ();
   683	      const double imv = (double)im[i];
   684	      // validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   685	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   686	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   687	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   688	      f.inten.push_back(s[i].getIntensity());
   689	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   690	      ++st.kept;
   691	    }
   692	    return f;
   693	  }
   694	
   695	
   696	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   697	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACTOR_DET=1.
   698	  static uint64_t detDigest_(vector<uint64_t> bits)
   699	  {
   700	    std::sort(bits.begin(), bits.end());
   701	    uint64_t h = 1469598103934665603ULL;
   702	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   703	    return h;
   704	  }
   705	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACTOR_DET") != nullptr; return on; }
   706	  static uint64_t traceDigest_(const TraceStore& st, const vector<Trace>& ts)
   707	  {
   708	    // im and tof are hashed too. im is the PRIMARY key of the fragment sort and the axis of the only
   709	    // binary search in scoring, and tof decides the exported m/z -- a digest blind to them would
   710	    // report "identical" across a change that moved every candidate slice. [2026-09-06]
   711	    vector<uint64_t> b; b.reserve(ts.size() * 5);
   712	    for (const auto& t : ts)
   713	    {
   714	      uint64_t u; double v;
   715	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   716	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   717	      v = t.im; std::memcpy(&u, &v, 8); b.push_back(u);
   718	      v = intensityOf(st, t); std::memcpy(&u, &v, 8); b.push_back(u);
   719	      b.push_back((uint64_t)t.tof);
   720	    }
   721	    return detDigest_(std::move(b));
   722	  }
   723	
   724	  /// One window's peaks in INDEX SPACE, frame-major. This is what the compact store already holds;
   725	  /// the point is that it is never converted back to Peak1D doubles. Replaces the materialised
   726	  /// PeakMap for the integer detector. See docs/MZ-AXIS-DESIGN.md.
   727	  struct PeakSlab
   728	  {
   729	    vector<uint32_t> frame_off;    ///< size F+1: frame f owns [frame_off[f], frame_off[f+1])
   730	    vector<uint32_t> rt_index;     ///< size F: the frame's index on the GLOBAL RT axis
   731	    vector<TofIdx>   tof;          ///< flight-time bin, ascending within a frame
   732	    vector<double>   b;            ///< size F: the frame's calibration factor (bin -> m/z)
   733	    vector<float>    inten;
   734	    vector<uint16_t> imq;          ///< the store's quantised 1/K0, kept for export
   735	    size_t frames() const { return rt_index.size(); }
   736	    size_t peaks()  const { return tof.size(); }
   737	  };
   738	
   739	  /// Ordered, incremental digest of a window's slab: frame table (rt index, factor bits, count) then
   740	  /// every (tof, intensity bits, imq) tuple in frame order. Unlike detDigest_ it is NOT sorted, so a
   741	  /// reordered equal-intensity peak or a tuple swapped between frames changes it -- which is what a
   742	  /// representation change of the store must not do. [det]
   743	  static uint64_t slabDigest_(const PeakSlab& sl)
   744	  {
   745	    uint64_t h = 1469598103934665603ULL;
   746	    auto mix = [&](uint64_t v) { h ^= v; h *= 1099511628211ULL; };
   747	    for (size_t f = 0; f < sl.frames(); ++f)
   748	    {
   749	      uint64_t bb; std::memcpy(&bb, &sl.b[f], 8);
   750	      mix(sl.rt_index[f]); mix(bb); mix(sl.frame_off[f + 1] - sl.frame_off[f]);
   751	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k)
   752	      { uint32_t ib; std::memcpy(&ib, &sl.inten[k], 4); mix(sl.tof[k]); mix(ib); mix(sl.imq[k]); }
   753	    }
   754	    return h;
   755	  }
   756	
   757	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   758	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   759	  PeakSlab toSlab(vector<CompactFrame>& frames)
   760	  {
   761	    PeakSlab sl;
   762	    const size_t F = frames.size();
   763	    sl.frame_off.resize(F + 1, 0);
   764	    sl.rt_index.resize(F);
   765	    size_t total = 0;
   766	    for (const auto& f : frames) total += f.mzq.size();
   767	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   768	    sl.b.resize(F);
   769	    const TofAxis& ax = tofAxis();
   770	    for (size_t i = 0; i < F; ++i)
   771	    {
   772	      CompactFrame& f = frames[i];
   773	      sl.rt_index[i] = rtIndex(f.rt);
   774	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   775	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   776	      // introduced here, and the loader does not have to change.
   777	      const double b = ax.factor(f.frame_id);
   778	      sl.b[i] = b;
   779	      sl.frame_off[i] = (uint32_t)sl.tof.size();
   780	      for (size_t k = 0; k < f.mzq.size(); ++k)
   781	        sl.tof.push_back(ax.tofOf((double)f.mzq[k] / MZ_Q, b));
   782	      sl.inten.insert(sl.inten.end(), f.inten.begin(), f.inten.end());
   783	      sl.imq.insert(sl.imq.end(), f.imq.begin(), f.imq.end());
   784	      vector<uint32_t>().swap(f.mzq);
   785	      vector<float>().swap(f.inten);
   786	      vector<uint16_t>().swap(f.imq);
   787	    }
   788	    sl.frame_off[F] = (uint32_t)sl.tof.size();
   789	    // The extension loop steps frames by index and takes the RT span as last minus first, so the
   790	    // frames must be in RT order -- the OpenMS path sorts its spectra for the same reason. The
   791	    // loader delivers them ordered; this checks rather than assumes.
   792	    for (size_t i = 1; i < F; ++i)
   793	      if (sl.rt_index[i] < sl.rt_index[i - 1])
   794	        throw OpenMS::Exception::InvalidValue(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   795	              "window frames are not in retention-time order at frame", std::to_string(i));
   796	    return sl;
   797	  }
