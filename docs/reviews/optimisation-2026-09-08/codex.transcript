  2053	    auto _pi_t2 = std::chrono::steady_clock::now();
  2054	    vector<bool> used(N, false);
  2055	    vector<Precursor_> out;
  2056	    // [spec 2026-09-07] ORDERED SPECULATION. The claim loop is greedy -- each seed marks its isotope
  2057	    // partners used, so what a later seed sees depends on every earlier one -- and it was the
  2058	    // single-threaded residue of this phase (measured 112-138 s of ~150). It is nevertheless
  2059	    // parallelisable EXACTLY, because the only mutable state a seed reads is `used`, and `used` is
  2060	    // monotone (false -> true, never back).
  2061	    //
  2062	    // Evaluate a batch of seeds concurrently against a frozen `used`, recording for each seed the
  2063	    // partner indices its searches actually returned. Then walk the batch in the ORIGINAL order and
  2064	    // commit: if the seed is now used, skip it exactly as the sequential loop would; otherwise, if
  2065	    // any recorded partner has since been claimed, re-evaluate that one seed against the current
  2066	    // `used`. Everything else is unchanged, so the emitted sequence and the final bitmap are
  2067	    // identical to the sequential algorithm.
  2068	    //
  2069	    // Why the dependency set is just the returned partners: findPartner reads `used[j]` only for
  2070	    // candidates that already passed the RT/IM gate, and it returns the FIRST such j that is unused.
  2071	    // A call that returned j depended on used[j] being false -- that can change, so it is recorded.
  2072	    // A call that returned -1 saw every candidate either fail the gate (no read) or already used;
  2073	    // both are stable under a monotone bitmap, so -1 stays -1 and needs no dependency.
  2074	    struct SeedRes { vector<Precursor_> emit; vector<size_t> claims; vector<size_t> deps; };
  2075	    auto evalSeed = [&](size_t seed, SeedRes& R)
  2076	    {
  2077	      R.emit.clear(); R.claims.clear(); R.deps.clear();
  2078	      // do/while(0): the body below is the sequential loop body VERBATIM, and its seed-level
  2079	      // `continue` statements exit this wrapper exactly as they used to exit one loop iteration,
  2080	      // while `continue` inside the body's own inner loops keeps binding to those loops.
  2081	      do
  2082	      {
  2083	      if (used[seed]) continue;
  2084	      const Trace& s = ms1[seed];
  2085	      const double tol = s.mz * mass_ppm * 1e-6;
  2086	
  2087	      // Find an unused isotope partner near `target` m/z, co-localized in RT and IM (binary-search
  2088	      // the m/z index, scan only the ppm-window candidates); -1 if none.
  2089	      auto findPartner = [&](double target) -> long {
  2090	        size_t klo = lbmz(target - tol), khi = ubmz(target + tol);   // [mzidx] same positions, local search
  2091	        for (size_t k = klo; k < khi; ++k)
  2092	        {
  2093	          if (fabs(sorted_rt[k] - s.rt) > delta_rt || fabs(sorted_im[k] - s.im) > iso_im_tol) continue;   // [soa]
  2094	          size_t j = by_mz[k];
  2095	          if (used[j] || j == seed) continue;
  2096	          { R.deps.push_back((size_t)j); return (long)j; }
  2097	        }
  2098	        return -1;
  2099	      };
  2100	
  2101	      // [baseline-fix v2] When envelope scoring is OFF, run the ORIGINAL algorithm end-to-end, not
  2102	      // just the original scoring. The previous attempt reverted only the score while keeping the new
  2103	      // candidate generation (gapped walk + lead 0..3), producing a THIRD algorithm: 2.52M MS1 traces
  2104	      // -> 1.21M precursors, 967,956 spectra, 7,308 peptides (baseline: 1.76M -> 956k, 741k, 9,103).
  2105	      // The original is: contiguous walk with BREAK-ON-FIRST-MISS, seed is always the starting point
  2106	      // (no lead offsets), monoisotope = furthest-LEFT partner reached, pick z by partner COUNT with
  2107	      // ties favouring the LOWEST z.
  2108	      if (!envelope_scoring)
  2109	      {
  2110	        int best_z = 0, best_n = 1;
  2111	        double best_mono = s.mz;
  2112	        vector<size_t> best_partners;
  2113	        for (int z = 1; z <= max_charge; ++z)
  2114	        {
  2115	          vector<size_t> partners;
  2116	          double mono = s.mz;
  2117	          double prev_int = inten[seed];
  2118	          vector<long> lefts;
  2119	          for (int k = 1; k <= 5; ++k)          // lighter partners define the monoisotope
  2120	          {
  2121	            long j = findPartner(s.mz - k * ISO / z);
  2122	            if (j < 0) break;                   // BREAK on first miss (contiguous only)
  2123	            // [mono-guard] A LEFTWARD step asserts the new peak is a LIGHTER ISOTOPE of the same
  2124	            // peptide, but findPartner only checks m/z, RT and IM -- never intensity. So the walk
  2125	            // happily latches onto a noise peak or a co-eluting species' peak that happens to sit
  2126	            // one isotope spacing below, and the monoisotope ends up one isotope TOO LIGHT.
  2127	            // Closed search hides this (the engine enumerates isotope_errors [-1,2] and corrects it
  2128	            // for free); OPEN search cannot, so it becomes a phantom -1.003 Da "modification" --
  2129	            // measured as our single largest open-search delta-mass artefact on dataset D.
  2130	            // Averagine bounds how weak a genuine lighter isotope may be: stepping from isotope m+1
  2131	            // to m, theo[m]/theo[m+1] = (m+1)/lambda, minimised at m=0 -> 1/lambda. Requiring the
  2132	            // candidate to reach that (times a slack factor) rejects the latch without touching a
  2133	            // real envelope.
  2134	            if (mono_guard_ > 0.0)
  2135	            {
  2136	              const double neutral = (s.mz - k * ISO / z) * z - z * PROTON_;
  2137	              const double lam = std::max(0.10, 0.000594 * neutral);
  2138	              if (inten[j] < mono_guard_ * prev_int / lam) break;
  2139	            }
  2140	            lefts.push_back(j);
  2141	            partners.push_back((size_t)j); mono = ms1[j].mz; prev_int = inten[j];
  2142	          }
  2143	          vector<long> rights;
  2144	          for (int k = 1; k <= 5; ++k)          // heavier partners add confidence
  2145	          {
  2146	            long j = findPartner(s.mz + k * ISO / z);
  2147	            if (j < 0) break;
  2148	            rights.push_back(j);
  2149	            partners.push_back((size_t)j);
  2150	          }
  2151	          // [mono-select] Choosing the monoisotope by "furthest-left peak reached" is a STOPPING
  2152	          // rule, and a stopping rule can only trade over-reach (-1.003 Da) for under-reach (+1.003
  2153	          // Da) -- measured: the guard above cut the -1 artefact 64% but tripled +1, because a walk
  2154	          // that stops early also leaves the M+1 peak unconsumed, so it later seeds its OWN
  2155	          // precursor one isotope too heavy. Make it a SCORING decision instead: walk the full run,
  2156	          // then pick which peak IS the monoisotope by averagine fit of the envelope starting
  2157	          // there. Corrects both directions, and every found peak is still marked used below, so
