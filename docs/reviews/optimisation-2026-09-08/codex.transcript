   174	  std::atomic<long long> stat_rtpass_{0};   ///< of those, how many pass the RT gate
   175	  std::atomic<long long> stat_prec_{0};     ///< precursors scored
   176	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   177	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   178	
   179	  /// glibc arena accounting at a milestone: what the allocator holds in arenas vs mmapped blocks
   180	  /// and how much of it is free-but-retained. RSS alone cannot tell live data from retained pages.
   181	  static std::string mem_()
   182	  {
   183	#ifdef __GLIBC__
   184	    const struct mallinfo2 mi = mallinfo2();
   185	    return " [malloc arena=" + std::to_string(mi.arena >> 20) + " MB mmap=" + std::to_string(mi.hblkhd >> 20)
   186	         + " MB free=" + std::to_string(mi.fordblks >> 20) + " MB]";
   187	#else
   188	    return "";
   189	#endif
   190	  }
   191	  static std::string rss_()
   192	  {
   193	    std::ifstream st("/proc/self/status");
   194	    if (!st) return "";
   195	    std::string line, cur = "?", peak = "?";
   196	    while (std::getline(st, line))
   197	    {
   198	      auto val = [&line]() {
   199	        std::string v = line.substr(line.find(':') + 1);
   200	        size_t a = v.find_first_not_of(" \t");
   201	        return a == std::string::npos ? std::string("?") : v.substr(a);
   202	      };
   203	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   204	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   205	    }
   206	    return " [RSS " + cur + ", peak " + peak + "]";
   207	  }
   208	
   209	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   210	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   211	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   212	  /// the other users. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   213	  ///
   214	  /// It does NOT add our own RSS back any more. That was defensible when most of our resident set
   215	  /// was allocator memory we would reuse; with perf:malloc_trim returning it at the phase boundary
   216	  /// (measured 92 GB of 138 at the loop start), what remains resident during the loop is the
   217	  /// windows actually in flight -- memory that is spoken for, not budget. Counting it as available
   218	  /// double-booked exactly the bytes the gate exists to bound. [2026-09-06]
   219	  static size_t availableBytes_()
   220	  {
   221	    std::ifstream mi("/proc/meminfo");
   222	    if (!mi) return 0;
   223	    std::string line;
   224	    size_t avail_kb = 0;
   225	    while (std::getline(mi, line))
   226	      if (line.rfind("MemAvailable:", 0) == 0)
   227	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   228	    if (!avail_kb) return 0;
   229	
   230	    return avail_kb * 1024ull;
   231	  }
   232	
   233	  /// THE RT AXIS IS GLOBAL AND DISCRETE. Every acquired frame has one retention time, and every
   234	  /// point of every mass trace sits on one of those frames -- so an RT value never needs to be
   235	  /// stored per point. It used to be: `vector<pair<double,double>>` cost 16 B per point and
   236	  /// duplicated the same ~33,000 values across hundreds of millions of points, and aligning two
   237	  /// profiles meant a binary search per point because the values had to be compared numerically.
   238	  /// Here the axis is stored ONCE, a point is (frame index, intensity) at 8 B, and alignment is
   239	  /// integer equality. Built once after loading, read-only thereafter.
   240	  inline vector<double>& rtAxis() { static vector<double> v; return v; }
   241	
   242	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   243	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   244	  inline uint32_t rtIndex(double rt)
   245	  {
   246	    const vector<double>& a = rtAxis();
   247	    if (a.empty()) return 0;
   248	    auto it = lower_bound(a.begin(), a.end(), rt);
   249	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   250	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   251	    return (uint32_t)(it - a.begin());
   252	  }
   253	
   254	  struct Trace
   255	  {
   256	    double mz = 0.0;
   257	    double rt = 0.0;   ///< apex/centroid RT
   258	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   259	    /// The flight-time bin this trace was measured on, and the calibration factor of its apex
   260	    /// frame. The pair is the AUTHORITATIVE m/z: `mz` below is a cached convenience for the gates
   261	    /// that still compare in m/z space, and the value actually written out is recomputed from these
   262	    /// two at export. 0 means the trace came from the OpenMS detector, which has no bin.
   263	    uint32_t tof = 0;
   264	    uint32_t bframe = 0;   ///< store-local frame whose factor calibrates `tof` (see bOf())
   265	    /// THE PROFILE IS A SPAN, NOT A POINT LIST. A trace is contiguous in its window's frame
   266	    /// sequence (with gaps the detector tolerates), so it needs an entry frame and its
   267	    /// intensities -- not a frame per point and not a bin per point, which is what the three
   268	    /// parallel vectors this replaces stored (12 B/point + 3 mallocs/trace, measured 35.6 GB).
   269	    /// The intensities live in the owning TraceStore's arena at [off, off+len); ZERO MEANS
   270	    /// MISSING, which is valid because every observed intensity is > noise_threshold >= 0.
   271	    /// Every consumer walks REAL points in frame order (skipping zeros), so the floating-point
   272	    /// sums are visited in the same order as before: the change is pure representation.
   273	    /// `frame0` is LOCAL to the store's frame table (a window's, or the MS1 map's) -- a
   274	    /// window's consecutive frames are ~13 apart on the global RT axis, so a global entry
   275	    /// frame would not be contiguous.
   276	    uint32_t frame0 = 0;   ///< first frame of the span, store-local
   277	    uint32_t off = 0;      ///< offset of the span in the store's arena
   278	    uint16_t len = 0;      ///< frames spanned (a gradient is ~1,400; asserted < 65536)
   279	    uint16_t npts = 0;     ///< REAL points in the span
   280	    uint16_t apex = 0;     ///< position of the apex within the span
   281	    size_t np() const { return npts; }
   282	    size_t span() const { return len; }
   283	    void freeProfile() { len = 0; npts = 0; }        ///< the arena is the store's; nothing to free
   284	  };
   285	
   286	  /// The frame table and the arenas that a set of traces point into: one per window, one for the
   287	  /// MS1 map. `rt_index`/`b` are per FRAME (store-local index); `inten` holds every trace's span
   288	  /// back to back (zero = missing); `bins` holds the per-frame flight-time bin for the integer
   289	  /// path only and is freed once valley splitting has assigned each child its apex bin.
   290	  struct TraceStore
   291	  {
   292	    vector<uint32_t> rt_index;   ///< frame -> global RT axis
   293	    vector<double>   b;          ///< frame -> calibration factor (empty on the OpenMS path)
   294	    vector<double>   frame_rt;   ///< frame -> RT value, for toTrace()'s frame lookup
   295	    vector<float>    inten;      ///< arena of spans
   296	    vector<uint32_t> bins;       ///< arena of per-frame bins (integer path, until EPD)
   297	    size_t frames() const { return rt_index.size(); }
   298	    void setFrames(const vector<uint32_t>& ri, const vector<double>* bb)
   299	    {
   300	      rt_index = ri; if (bb) b = *bb; else b.clear();
   301	      frame_rt.resize(ri.size());
   302	      for (size_t f = 0; f < ri.size(); ++f) frame_rt[f] = rtAxis()[ri[f]];
   303	    }
   304	    /// Store-local frame of an RT value (exact by construction; nearest guards a last-ulp slip).
   305	    uint32_t frameOf(double rt) const
   306	    {
   307	      auto it = lower_bound(frame_rt.begin(), frame_rt.end(), rt);
   308	      if (it == frame_rt.end()) return (uint32_t)(frame_rt.size() - 1);
   309	      if (it != frame_rt.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   310	      return (uint32_t)(it - frame_rt.begin());
   311	    }
   312	    /// Append `other`'s arenas and return the offset they now start at (for rebasing).
   313	    uint32_t absorb(TraceStore& other)
   314	    {
   315	      const size_t base = inten.size();
   316	      if (base + other.inten.size() >= (size_t)std::numeric_limits<uint32_t>::max())
   317	        throw OpenMS::Exception::OutOfRange(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION);
   318	      inten.insert(inten.end(), other.inten.begin(), other.inten.end());
   319	      if (!other.bins.empty()) { bins.resize(base, 0u); bins.insert(bins.end(), other.bins.begin(), other.bins.end()); }
   320	      // Once ANY source has contributed bins, keep bins index-parallel to inten: a later binless
   321	      // source would otherwise leave bins short, and a bins[t.off + k] read would run off the end.
   322	      // No current caller mixes the two, which is exactly why this is worth pinning down here.
   323	      else if (!bins.empty()) bins.resize(inten.size(), 0u);
   324	      vector<float>().swap(other.inten); vector<uint32_t>().swap(other.bins);
   325	      return (uint32_t)base;
   326	    }
   327	  };
   328	  static_assert(sizeof(Trace) == 48, "Trace must stay 48 bytes: it is the largest structure in the tool "
   329	                                    "(2.1e9 records on a 2-h file), and a silent 8-byte regrowth costs ~16 GiB");
   330	
   331	  /// Span accessors take the owning store EXPLICITLY. Every trace of a vector shares one store, so
   332	  /// a per-record 8-byte back-pointer bought nothing but 8 bytes x 2.1e9 records on a 2-h file.
   333	  /// The store is an argument, not a member: passing the wrong one is the failure mode this
   334	  /// replaces, so it is asserted in a debug build rather than left to a silent wrong-arena read.
   335	  inline float xv(const TraceStore& s, const Trace& t, size_t k)
   336	  { assert(t.off + k < s.inten.size()); return s.inten[t.off + k]; }
   337	  inline bool real(const TraceStore& s, const Trace& t, size_t k) { return xv(s, t, k) > 0.0f; }
   338	  inline uint32_t gframe(const TraceStore& s, const Trace& t, size_t k)
   339	  { assert(t.frame0 + k < s.rt_index.size()); return s.rt_index[t.frame0 + k]; }
   340	  inline double rtAtSpan(const TraceStore& s, const Trace& t, size_t k) { return rtAxis()[gframe(s, t, k)]; }
   341	  /// The calibration factor of the trace's own apex/measurement frame. Empty table (the OpenMS
   342	  /// detector has no per-frame factors) yields 0.0, which is what the field held there before, and
   343	  /// exportMz_ returns the cached m/z for those traces because their `tof` is 0.
   344	  inline double bOf(const TraceStore& s, const Trace& t) { return s.b.empty() ? 0.0 : s.b[t.bframe]; }
   345	  /// The trace's apex intensity. It was an 8-byte field holding a copy of a number the arena already
   346	  /// stores: makeSpan sets `apex` to the position of the largest value in the span, and both
   347	  /// producers set the field to exactly that value (sl.inten[kap] on the integer path,
   348	  /// MassTrace::getMaxIntensity on the OpenMS one). Trimming moves `apex` with the data, so the
   349	  /// identity survives it. A trace whose profile was released (len == 0) has no apex to read; it is
   350	  /// also never scored, which is why its profile was released.
   351	  inline double intensityOf(const TraceStore& s, const Trace& t)
   352	  { return t.len ? (double)s.inten[t.off + t.apex] : 0.0; }
   353	
   354	  /// The real points of a trace, packed in frame order, for the consumers that were written over
   355	  /// point lists (smoother, FWHM): identical sequences, so identical arithmetic.
   356	  inline void packReal(const TraceStore& s, const Trace& t, vector<double>& rt, vector<double>& v)
   357	  {
   358	    rt.clear(); v.clear();
   359	    for (size_t k = 0; k < t.span(); ++k)
   360	      if (real(s, t, k)) { rt.push_back(rtAtSpan(s, t, k)); v.push_back((double)xv(s, t, k)); }
   361	  }
   362	
   363	  /// TRIM a trace to at most `cap` seconds around its apex, AFTER detection and valley splitting
   364	  /// have decided what the peak is. This is the safe form of a length limit:
   365	  ///   * detection is untouched, so the greedy consume-and-mark ownership of peaks is unchanged --
   366	  ///     unlike terminating extension, which changes which peaks belong to which trace;
   367	  ///   * it works on MS1 as well as MS2, because it is a step on Trace objects rather than
   368	  ///     something inside OpenMS's extension loop (MS1 is always traced by the OpenMS path, and
   369	  ///     MS1 is where the long traces are: 15.2% of dataset D MS1 traces span >45 s, the longest 1,244 s
   370	  ///     of a 1,860 s gradient, against a 375 s maximum for fragments);
   371	  ///   * what it removes is the far tail of a blob that ElutionPeakDetection did not split, not
   372	  ///     part of a chromatographic peak -- real peaks here are 5-30 s wide.
   373	  /// On the span representation this is free: three integers move, no bytes are copied. The arena
   374	  /// still holds the untrimmed bytes; reclaiming them needs a compaction pass (MS1 already has one).
   375	  inline void trimToSpan(const TraceStore& s, Trace& t, double cap)
   376	  {
   377	    if (cap <= 0.0 || t.span() == 0) return;
   378	    const size_t a = t.apex;
   379	    size_t lo = a, hi = a;
   380	    // grow symmetrically outward from the apex while the span fits, preferring the earlier frame on
   381	    // a tie so the result does not depend on which side is tested first
   382	    for (;;)
   383	    {
   384	      const bool can_lo = lo > 0, can_hi = hi + 1 < t.span();
   385	      if (!can_lo && !can_hi) break;
   386	      const double d_lo = can_lo ? rtAtSpan(s, t, hi) - rtAtSpan(s, t, lo - 1) : 1e30;
   387	      const double d_hi = can_hi ? rtAtSpan(s, t, hi + 1) - rtAtSpan(s, t, lo) : 1e30;
   388	      if (d_lo <= d_hi) { if (!can_lo || d_lo > cap) { if (!can_hi || d_hi > cap) break; ++hi; } else --lo; }
   389	      else              { if (!can_hi || d_hi > cap) { if (!can_lo || d_lo > cap) break; --lo; } else ++hi; }
   390	    }
   391	    // Zero-trim the ends. makeSpan starts and ends a span on a real point by construction, but
   392	    // growing outward from the apex can stop on a gap, and a leading or trailing zero is pure
   393	    // padding: it costs 4 B, it is skipped by every consumer, and it makes `span()` overstate the
   394	    // trace. Interior zeros are the gaps and MUST stay -- they are the presence encoding.
   395	    while (lo < hi && xv(s, t, lo) == 0.0f) ++lo;
   396	    while (hi > lo && xv(s, t, hi) == 0.0f) --hi;
   397	    if (lo == 0 && hi + 1 == t.span()) return;                  // already within the cap, ends real
   398	    uint16_t np = 0;
   399	    for (size_t k = lo; k <= hi; ++k) if (xv(s, t, k) > 0.0f) ++np;
   400	    t.frame0 += (uint32_t)lo; t.off += (uint32_t)lo;
   401	    t.len = (uint16_t)(hi - lo + 1); t.apex = (uint16_t)(a - lo); t.npts = np;
   402	  }
   403	
   404	  /// Drop the spans of the traces nobody references and compact the arena IN PLACE, walking the kept
   405	  /// spans in ORIGINAL OFFSET order -- not container order. ms1_traces is sorted by m/z after its
   406	  /// spans were appended in detection order, so container order is not offset order, and the
   407	  /// previous walk (monotone write cursor over the container) overwrote spans it had not copied yet:
   408	  /// ~1% of precursor XICs, deterministically. Spans are pairwise disjoint on this path (every
   409	  /// child gets its own makeSpan append; trimToSpan only shrinks), and that is VALIDATED before a
   410	  /// byte moves: in ascending-offset order the write cursor can never pass the next source.
   411	  /// A freed trace keeps its scalars and loses its span. Returns the number of profiles released.
   412	  inline Size compactUnreferenced(vector<Trace>& tr, TraceStore& store, const vector<bool>& needed)
   413	  {
   414	    vector<uint32_t> ids;
   415	    Size freed = 0;
   416	    for (size_t i = 0; i < tr.size(); ++i)
   417	    {
   418	      if (!needed[i]) { if (tr[i].np() > 0) ++freed; tr[i].freeProfile(); continue; }
   419	      if (tr[i].len > 0) ids.push_back((uint32_t)i);     // a zero-length span owns no bytes
   420	    }
   421	    sort(ids.begin(), ids.end(), [&](uint32_t a, uint32_t b) { return tr[a].off < tr[b].off; });
   422	    uint64_t prev_end = 0;
   423	    for (uint32_t i : ids)
   424	    {
   425	      const uint64_t beg = tr[i].off, end = beg + (uint64_t)tr[i].len;
   426	      if (end > store.inten.size() || beg < prev_end)
   427	        throw OpenMS::Exception::Precondition(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
   428	                                              "MS1 spans overlap or exceed the arena");
   429	      prev_end = end;
   430	    }
   431	    size_t w = 0;
   432	    for (uint32_t i : ids)
   433	    {
   434	      Trace& t = tr[i];
   435	      if (w != t.off) std::memmove(store.inten.data() + w, store.inten.data() + t.off, (size_t)t.len * sizeof(float));
   436	      t.off = (uint32_t)w; w += t.len;
   437	    }
   438	    store.inten.resize(w); store.inten.shrink_to_fit();
   439	    return freed;
   440	  }
   441	
   442	  /// Build a span from (store-local frame, intensity) points into `store`, returning the trace
   443	  /// with `st` UNSET: the caller sets it once the store is immutable. Points may arrive unsorted.
   444	  inline Trace makeSpan(vector<pair<uint32_t, float>>& pts, TraceStore& store)
   445	  {
   446	    Trace t;
   447	    if (pts.empty()) return t;
   448	    sort(pts.begin(), pts.end());
   449	    const uint32_t f0 = pts.front().first, f1 = pts.back().first;
   450	    const size_t L = (size_t)f1 - f0 + 1;
   451	    if (L >= 65536) throw OpenMS::Exception::OutOfRange(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION);
   452	    t.frame0 = f0; t.len = (uint16_t)L; t.off = (uint32_t)store.inten.size();
   453	    store.inten.resize(store.inten.size() + L, 0.0f);
   454	    float best = -1.0f; uint16_t np = 0;
   455	    for (const auto& q : pts)
   456	    {
   457	      const size_t k = q.first - f0;
   458	      if (store.inten[t.off + k] == 0.0f) ++np;      // one point per frame; a repeat overwrites
   459	      store.inten[t.off + k] = q.second;
   460	      if (q.second > best) { best = q.second; t.apex = (uint16_t)k; }
   461	    }
   462	    t.npts = np;
   463	    return t;
   464	  }
