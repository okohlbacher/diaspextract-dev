   14  TracePrep prepareTracing(const PeakSlab& sl, double noise, double snr)
   15  {
   16    TracePrep tp;
   17    const size_t F = sl.frames(), P = sl.tof.size();
   18    tp.frame_of.assign(P, 0); tp.member.assign(P, 0); tp.frame_live.assign(F, 0);
