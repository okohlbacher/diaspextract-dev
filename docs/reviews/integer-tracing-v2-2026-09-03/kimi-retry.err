  ```cpp
    bool isTraceValid_(const MassTrace& trace, const Size& total_scans_visited, const Size& missed_down, const Size& missed_up)
    {
      // Check rt range
      double rt_range = std::fabs(trace.rbegin()->getRT() - trace.begin()->getRT());
      if (rt_range < min_trace_length_) return false;
      if (max_trace_length_ >= 0.0 && rt_range > max_trace_length_) return false;
      // Check sample rate
      Size adjusted_scans = total_scans_visited - missed_down - missed_up;
      double sample_rate = static_cast<double>(trace.getSize()) / static_cast<double>(adjusted_scans);
      return sample_rate >= min_sample_rate_;
    }
  ```
