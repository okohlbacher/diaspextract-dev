   101	def run(binary, inp, out, extra=(), threads=1, expect_fail=False):
   102	    cmd = [binary, "-in", inp, "-out", out, "-threads", str(threads),
   103	           "-assembly:min_fragments", "2", "-assembly:require_isotope_support",
   104	           "-trace:ms2_min_length_sec", "0", "-trace:ms1_split_valleys", "0",
   105	           "-trace:ms2_split_valleys", "0"] + list(extra)
   106	    r = subprocess.run(cmd, capture_output=True, text=True)
   107	    if expect_fail:
   108	        assert r.returncode != 0, "expected a non-zero exit, got success:\n" + r.stdout[-800:]
   109	        return r
   110	    assert r.returncode == 0, "run failed:\n" + (r.stdout + r.stderr)[-2000:]
   111	    return r
