  1553	    if (split_valleys > 0.0 && mts.size() > 1)
  1554	    {
  1555	      const int nthreads = std::max(1, bands);
  1556	      const int nchunk = std::max(1, bands * 4);      // 4x chunks vs threads -> dynamic load balance
  1557	      const size_t n_in = mts.size();
  1558	      vector<vector<MassTrace>> parts(nchunk);
  1559	      #pragma omp taskloop grainsize(1) default(shared)
  1560	      for (int ci = 0; ci < nchunk; ++ci)
  1561	      {
  1562	        const size_t lo = (size_t)ci * n_in / nchunk, hi = (size_t)(ci + 1) * n_in / nchunk;
  1563	        if (lo >= hi) continue;
  1564	        vector<MassTrace> chunk(std::make_move_iterator(mts.begin() + lo),
  1565	                                std::make_move_iterator(mts.begin() + hi));
  1566	        parts[ci] = do_split(chunk);
  1567	      }
  1568	      size_t tot = 0; for (auto& pth : parts) tot += pth.size();
  1569	      vector<MassTrace> out; out.reserve(tot);
  1570	      for (auto& pth : parts) { for (auto& t : pth) out.push_back(std::move(t)); vector<MassTrace>().swap(pth); }
  1571	      if (span_log) *span_log += " | valley-split " + String(n_in) + " -> " + String(out.size())
  1572	                               + " traces (" + String((int)(1000.0 * out.size() / std::max<size_t>(n_in,1)) / 10.0) + "%)";
  1573	      mts.swap(out);
  1574	    }
  1575	    // [merged-trace] instrumentation: is trace merging actually happening? Log the RT-span
  1576	    // distribution. Peaks are 5-30 s here, so a large p90/max means multi-modal merged traces.
  1577	    if (!mts.empty())
  1578	    {
  1579	      vector<double> spans;
  1580	      spans.reserve(mts.size());
  1581	      for (const auto& mt : mts)
  1582	      {
  1583	        double lo = 1e30, hi = -1e30;
  1584	        for (Size i = 0; i < mt.getSize(); ++i) { double r = mt[i].getRT(); lo = min(lo, r); hi = max(hi, r); }
  1585	        spans.push_back(hi - lo);
  1586	      }
  1587	      sort(spans.begin(), spans.end());
  1588	      size_t n = spans.size();
  1589	      size_t over45 = spans.end() - lower_bound(spans.begin(), spans.end(), 45.0);
  1590	      if (span_log) *span_log = "traces=" + String(n) + " span_s median=" + String(spans[n/2])
  1591	                      + " p90=" + String(spans[(size_t)(0.9*n)]) + " max=" + String(spans.back())
  1592	                      + " frac>45s=" + String((int)(1000.0*over45/n)/10.0) + "%";
  1593	    }
  1594	    vector<Trace> out;
  1595	    out.reserve(mts.size());
  1596	    for (const auto& mt : mts) out.push_back(toTrace(mt));
