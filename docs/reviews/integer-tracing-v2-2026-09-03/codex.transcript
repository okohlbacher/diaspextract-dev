  1320	    // NB: "threads" is reserved by TOPPBase (the standard -threads option), so this lives under "perf".
  1321	    // [route-1] feature-level consolidation: collapse spectra that are the SAME chromatographic
  1322	    // feature emitted more than once (RT slices / IM sub-ranges / charge hypotheses). Targets the
     1	#!/usr/bin/env python3
     2	"""End-to-end checks on a synthetic input. No framework, no fixtures: one file, plain asserts.
     3	
     4	Verification on this project has been whole-file cluster benchmarks, which catch regressions in
     5	aggregate but cannot say WHY a number moved, and cannot run before a commit. These are the smallest
     6	checks that fail if the things most likely to break do break:
     7	
     8	  1. isotope ownership   one z=2 envelope (M, M+1, M+2) must yield ONE precursor at the mono, not
     9	                         three, and the M+1/M+2 peaks must not reseed precursors of their own
    10	  2. min_charge          a supported z=1 envelope is dropped at the default and kept at 1, while a
    11	                         z=2 envelope is unaffected either way
    12	  3. parameter bounds    a negative count must be REJECTED, not wrapped through Size into an
    13	                         empty-but-successful run
    14	  4. determinism         the same input at 1 and 4 threads must give byte-identical spectrum data
    15	
    16	Usage: test_spextract.py /path/to/DIAPseudoSpectra [workdir]
    17	Exit status is 0 only if every check passes.
    18	"""
    19	import base64, hashlib, os, re, struct, subprocess, sys, tempfile
    20	
    21	ISO = 1.0033548
    22	PROTON = 1.007276
    23	
    24	
    25	def b64f(vals, double=True):
    26	    fmt = "<%d%s" % (len(vals), "d" if double else "f")
    27	    return base64.b64encode(struct.pack(fmt, *vals)).decode()
    28	
    29	
    30	def spectrum(idx, ms_level, rt, peaks, im, prec=None):
    31	    """One mzML spectrum. `peaks` is [(mz, intensity)], `im` one 1/K0 per peak."""
    32	    mz = b64f([p[0] for p in peaks])
    33	    inten = b64f([p[1] for p in peaks], double=False)
    34	    imarr = b64f(im)
    35	    pre = ""
    36	    if prec:
    37	        target, lo, hi = prec
    38	        pre = f"""<precursorList count="1"><precursor><isolationWindow>
    39	<cvParam cvRef="MS" accession="MS:1000827" name="isolation window target m/z" value="{target}" unitAccession="MS:1000040" unitName="m/z" unitCvRef="MS"/>
    40	<cvParam cvRef="MS" accession="MS:1000828" name="isolation window lower offset" value="{target-lo}" unitAccession="MS:1000040" unitName="m/z" unitCvRef="MS"/>
    41	<cvParam cvRef="MS" accession="MS:1000829" name="isolation window upper offset" value="{hi-target}" unitAccession="MS:1000040" unitName="m/z" unitCvRef="MS"/>
    42	</isolationWindow><activation><cvParam cvRef="MS" accession="MS:1000044" name="dissociation method"/></activation></precursor></precursorList>"""
    43	    return f"""<spectrum id="spectrum={idx}" index="{idx}" defaultArrayLength="{len(peaks)}">
    44	<cvParam cvRef="MS" accession="MS:1000127" name="centroid spectrum"/>
    45	<cvParam cvRef="MS" accession="MS:1000511" name="ms level" value="{ms_level}"/>
    46	<cvParam cvRef="MS" accession="MS:1000294" name="mass spectrum"/>
    47	<scanList count="1"><cvParam cvRef="MS" accession="MS:1000795" name="no combination"/>
    48	<scan><cvParam cvRef="MS" accession="MS:1000016" name="scan start time" value="{rt}" unitAccession="UO:0000010" unitName="second" unitCvRef="UO"/></scan></scanList>
    49	{pre}
    50	<binaryDataArrayList count="3">
    51	<binaryDataArray encodedLength="{len(mz)}"><cvParam cvRef="MS" accession="MS:1000514" name="m/z array" unitAccession="MS:1000040" unitName="m/z" unitCvRef="MS"/><cvParam cvRef="MS" accession="MS:1000523" name="64-bit float"/><cvParam cvRef="MS" accession="MS:1000576" name="no compression"/><binary>{mz}</binary></binaryDataArray>
    52	<binaryDataArray encodedLength="{len(inten)}"><cvParam cvRef="MS" accession="MS:1000515" name="intensity array" unitAccession="MS:1000131" unitName="number of counts" unitCvRef="MS"/><cvParam cvRef="MS" accession="MS:1000521" name="32-bit float"/><cvParam cvRef="MS" accession="MS:1000576" name="no compression"/><binary>{inten}</binary></binaryDataArray>
    53	<binaryDataArray arrayLength="{len(im)}" encodedLength="{len(imarr)}"><cvParam cvRef="MS" accession="MS:1002816" name="mean inverse reduced ion mobility array" unitAccession="MS:1002814" unitName="volt-second per square centimeter" unitCvRef="MS"/><cvParam cvRef="MS" accession="MS:1000523" name="64-bit float"/><cvParam cvRef="MS" accession="MS:1000576" name="no compression"/><binary>{imarr}</binary></binaryDataArray>
    54	</binaryDataArrayList></spectrum>"""
    55	
    56	
    57	def synth(path, n_cycles=14, cycle_s=1.4, gap_cycles=()):
    58	    """Two precursors that co-elute in one isolation window: a z=2 envelope and a z=1 envelope.
    59	
    60	    Both are given a 3-peak isotope envelope so `require_isotope_support` keeps them, matching
    61	    fragments that co-elute with the precursor, and a distinct ion mobility.
    62	
    63	    `gap_cycles`: cycles in which the z=2 precursor AND its first fragment are ABSENT. This is
    64	    the input that separates a correct trace-extension rule from a wrong one: OpenMS tolerates up
    65	    to five consecutive missing frames before it ends a trace, so one gap must still give ONE
    66	    trace, and seven consecutive gaps must give TWO. Every version of the integer detector that
    67	    lost 92% of peptides passed the other checks in this file; none would have passed this.
    68	    """
    69	    win = (600.0, 590.0, 620.0)                    # target, lo, hi
    70	    z2_mono, z2_im = 601.3, 0.90                   # a doubly-charged precursor
    71	    z1_mono, z1_im = 610.6, 1.20                   # a singly-charged one
    72	    z2_frags = [(233.11, 0.7), (348.19, 1.0), (461.27, 0.55)]
    73	    z1_frags = [(288.14, 0.8), (401.22, 0.9)]
    74	    specs, idx = [], 0
    75	    for c in range(n_cycles):
    76	        rt = 1.0 + c * cycle_s
    77	        shape = 1.0 - abs(c - n_cycles / 2.0) / (n_cycles / 2.0 + 1.0)   # a triangular elution
    78	        amp = max(shape, 0.05)
    79	        ms1, ms1_im = [], []
    80	        gap = c in gap_cycles
    81	        for k, rel in enumerate((1.0, 0.55, 0.20)):                      # averagine-ish envelope
    82	            if not gap:
    83	                ms1.append((z2_mono + k * ISO / 2.0, 6.0e5 * amp * rel)); ms1_im.append(z2_im)
    84	            ms1.append((z1_mono + k * ISO / 1.0, 4.0e5 * amp * rel)); ms1_im.append(z1_im)
    85	        order = sorted(range(len(ms1)), key=lambda i: ms1[i][0])
    86	        specs.append(spectrum(idx, 1, rt, [ms1[i] for i in order], [ms1_im[i] for i in order])); idx += 1
    87	        ms2, ms2_im = [], []
    88	        for fi, (mz, rel) in enumerate(z2_frags):
    89	            if gap and fi == 0: continue                                   # first fragment gapped too
    90	            ms2.append((mz, 2.0e5 * amp * rel)); ms2_im.append(z2_im)
    91	        for mz, rel in z1_frags: ms2.append((mz, 1.5e5 * amp * rel)); ms2_im.append(z1_im)
    92	        order = sorted(range(len(ms2)), key=lambda i: ms2[i][0])
    93	        specs.append(spectrum(idx, 2, rt, [ms2[i] for i in order], [ms2_im[i] for i in order],
    94	                              prec=win)); idx += 1
    95	    body = "\n".join(specs)
    96	    open(path, "w").write(f"""<?xml version="1.0" encoding="ISO-8859-1"?>
    97	<indexedmzML xmlns="http://psi.hupo.org/ms/mzml"><mzML version="1.1.0" id="spextract_test">
    98	<cvList count="1"><cv id="MS" fullName="Proteomics Standards Initiative Mass Spectrometry Ontology" URI="https://raw.githubusercontent.com/HUPO-PSI/psi-ms-CV/master/psi-ms.obo"/></cvList>
    99	<fileDescription><fileContent><cvParam cvRef="MS" accession="MS:1000580" name="MSn spectrum"/></fileContent></fileDescription>
   100	<softwareList count="1"><software id="so_test" version="0"><cvParam cvRef="MS" accession="MS:1000799" name="custom unreleased software tool" value="spextract-test"/></software></softwareList>
   101	<instrumentConfigurationList count="1"><instrumentConfiguration id="ic_test"><cvParam cvRef="MS" accession="MS:1000031" name="instrument model"/></instrumentConfiguration></instrumentConfigurationList>
   102	<dataProcessingList count="1"><dataProcessing id="dp_test"><processingMethod order="0" softwareRef="so_test"><cvParam cvRef="MS" accession="MS:1000544" name="Conversion to mzML"/></processingMethod></dataProcessing></dataProcessingList>
   103	<run id="run_test" defaultInstrumentConfigurationRef="ic_test">
   104	<spectrumList count="{len(specs)}" defaultDataProcessingRef="dp_test">
   105	{body}
   106	</spectrumList></run></mzML></indexedmzML>
   107	""")
   108	    return z2_mono, z1_mono
   109	
   110	
   111	def run(binary, inp, out, extra=(), threads=1, expect_fail=False):
   112	    cmd = [binary, "-in", inp, "-out", out, "-threads", str(threads),
   113	           "-assembly:min_fragments", "2", "-assembly:require_isotope_support",
   114	           "-trace:ms2_min_length_sec", "0", "-trace:ms1_split_valleys", "0",
   115	           "-trace:ms2_split_valleys", "0"] + list(extra)
   116	    r = subprocess.run(cmd, capture_output=True, text=True)
   117	    if expect_fail:
   118	        assert r.returncode != 0, "expected a non-zero exit, got success:\n" + r.stdout[-800:]
   119	        return r
   120	    assert r.returncode == 0, "run failed:\n" + (r.stdout + r.stderr)[-2000:]
   121	    return r
