   124	def digest(mzml):
   125	    """Hash the spectrum data only -- the header carries a wall-clock stamp and parameters."""
   126	    h, on = hashlib.sha256(), False
   127	    for line in open(mzml, "rb"):
   128	        if b"<spectrumList" in line: on = True
   129	        if on: h.update(line)
   130	        if b"</spectrumList>" in line: break
   131	    return h.hexdigest()
