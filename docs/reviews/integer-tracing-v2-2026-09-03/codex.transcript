   135	    if len(sys.argv) < 2: sys.exit(__doc__)
   136	    binary = sys.argv[1]
   137	    work = sys.argv[2] if len(sys.argv) > 2 else tempfile.mkdtemp(prefix="spextract_test_")
   138	    os.makedirs(work, exist_ok=True)
   139	    inp = os.path.join(work, "synth.mzML")
   140	    z2_mono, z1_mono = synth(inp)
   141	    print(f"synthetic input: {inp}  (z=2 mono {z2_mono}, z=1 mono {z1_mono})")
   142	    fails = []
   143	
   144	    def check(name, fn):
   145	        try:
   146	            fn(); print(f"  PASS  {name}")
   147	        except AssertionError as e:
   148	            print(f"  FAIL  {name}: {e}"); fails.append(name)
   149	
   150	    # 1 + 2: the default drops the z=1 envelope and keeps one precursor per envelope
   151	    out_def = os.path.join(work, "default.mzML")
   152	    run(binary, inp, out_def)
   153	    pd = precursors(out_def)
   154	
   155	    def c1():
   156	        z2 = [p for p in pd if p[1] == 2]
   157	        assert z2, f"no z=2 precursor emitted; got {pd}"
   158	        assert all(abs(m - z2_mono) < 0.02 for m, _ in z2), \
   159	            f"a z=2 precursor is not at the monoisotope {z2_mono}: {z2} -- an M+1/M+2 peak reseeded"
   160	    check("isotope ownership: one z=2 precursor, at the mono", c1)
   161	
   162	    def c2():
   163	        assert not [p for p in pd if p[1] == 1], \
   164	            f"charge:min_charge=2 is the default but a z=1 precursor was emitted: {pd}"
   165	    check("min_charge default 2 drops the z=1 envelope", c2)
   166	
   167	    out_z1 = os.path.join(work, "z1.mzML")
   168	    run(binary, inp, out_z1, extra=["-charge:min_charge", "1"])
   169	    p1 = precursors(out_z1)
   170	
   171	    def c3():
   172	        assert [p for p in p1 if p[1] == 1], f"charge:min_charge=1 must emit the z=1 envelope: {p1}"
   173	        assert len([p for p in p1 if p[1] == 2]) == len([p for p in pd if p[1] == 2]), \
   174	            "lowering min_charge changed the z=2 result"
   175	    check("min_charge 1 restores it and leaves z=2 alone", c3)
   176	
   177	    # 3: a negative count must be rejected, not wrapped through Size
   178	    def c4():
   179	        run(binary, inp, os.path.join(work, "bad.mzML"),
   180	            extra=["-assembly:min_fragments", "-1"], expect_fail=True)
   181	    check("a negative min_fragments is rejected", c4)
   182	
   183	    def c5():
   184	        run(binary, inp, os.path.join(work, "bad2.mzML"),
   185	            extra=["-gate:delta_rt", "-5"], expect_fail=True)
   186	    check("a negative gate:delta_rt is rejected", c5)
   187	
   188	    # 4: determinism across thread counts for a fixed binary
   189	    out_t4 = os.path.join(work, "t4.mzML")
   190	    run(binary, inp, out_t4, threads=4)
   191	
   192	    def c6():
   193	        a, b = digest(out_def), digest(out_t4)
   194	        assert a == b, f"spectrum data differs between 1 and 4 threads:\n  {a}\n  {b}"
   195	    check("byte-identical at 1 vs 4 threads", c6)
   196	
   197	    print(f"\n{6 - len(fails)}/6 checks passed" + (f"; FAILED: {', '.join(fails)}" if fails else ""))
   198	    return 1 if fails else 0
   199	
   200	
   201	if __name__ == "__main__":
   202	    sys.exit(main())
