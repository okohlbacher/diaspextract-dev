     9	//
    10	// Model, derived numerically against Bruker's timsdata library used as a local oracle (no vendor
    11	// code was read, no vendor binary is redistributed; every constant comes from the user's own file):
    12	//
    13	//     t_ns   = tof * DigitizerTimebase + DigitizerDelay
    14	//     C1_eff = C1 * (1 + dC1 * (T1_ref - T1_frame) / 1e6)        // digitizer temperature drift
    15	//     t_ns   = C0 + (1e6 / sqrt(C1_eff)) * sqrt(m) + C2 * m      // solved for sqrt(m)
    16	//
    17	// Verified to 2.5e-5 ppm max against the vendor library (tests/calibration_golden.json).
    18	// SCOPE OF THAT CLAIM, stated precisely because it is narrower than the file count suggests: the
    19	// three files share ONE identical MzCalibration vector (same C0/C1/C2/timebase/delay/T1_ref/dC1),
    20	// so independent coverage of the parameter space is ONE vector -- 12 frames spanning only 0.034 K,
    21	// probed at five TOF positions covering m/z 133.7-1573.7. ModelType 1, single-row table, dC2 == 0,
    22	// one instrument cohort. Everything outside that is REJECTED rather than
    23	// approximated -- see isSupported(): silently emitting wrong masses is the failure mode this whole
    24	// file exists to prevent (the previous two-point chord was -5..-11 ppm and nobody noticed for months).
    25	//
    26	// Note for implementers: the widely-copied open implementation (timsrust-calibration, adapted then
    27	// disabled by mzdata as "not consistently better") DROPS the C2*m term, which is worth -11..-40 ppm
    28	// on this data. That omission -- not translation subtlety -- is why the port underperformed.
    29	
    30	#pragma once
    31	#include <cmath>
    32	#include <initializer_list>
    33	#include <limits>
    34	#include <string>
    35	
    36	namespace spextract
    37	{
    38	
    39	/// Constants as stored in the TDF `MzCalibration` row plus the per-frame digitizer temperature.
    40	struct TdfMzCalibration
    41	{
    42	  int model_type = 0;
    43	  double digitizer_timebase = 0.0;
    44	  double digitizer_delay = 0.0;
    45	  double C0 = 0.0;
    46	  double C1 = 0.0;      ///< must be > 0
    47	  double C2 = 0.0;      ///< the quadratic term the open implementations drop
    48	  double T1_ref = 0.0;  ///< reference digitizer temperature for the calibration
    49	  double dC1 = 0.0;     ///< ppm/K drift of C1
    50	  double dC2 = 0.0;     ///< drift of C2 -- NOT modelled; must be 0 (see isSupported)
    51	  double C3 = 0.0, C4 = 0.0;   ///< higher-order terms -- NOT modelled; must be 0
    52	
    53	  /// Why this calibration cannot be used, or empty if it can. Fail closed, never approximate.
    54	  std::string unsupportedReason() const
    55	  {
    56	    // NaN defeats ordered comparisons (every < and > below is false for NaN), so screen first.
    57	    for (double v : {digitizer_timebase, digitizer_delay, C0, C1, C2, T1_ref, dC1, dC2, C3, C4})
    58	      if (std::isnan(v)) return "MzCalibration contains NaN";
    59	    if (model_type != 1) return "MzCalibration ModelType " + std::to_string(model_type) + " != 1";
    60	    // A merely-positive C1 is not enough: C1 < ~5.6e-297 overflows b*b to +inf and yields m/z 0.0
    61	    // for every peak, silently, under an "exact" log line. Real values are ~1e5. [claude review]
    62	    if (!(C1 > 1.0) || !(C1 < 1e12)) return "MzCalibration C1 outside the plausible range (1, 1e12)";
    63	    if (dC2 != 0.0) return "MzCalibration dC2 != 0 (temperature drift of C2 is not modelled)";
    64	    if (C3 != 0.0 || C4 != 0.0) return "MzCalibration C3/C4 != 0 (higher-order terms are not modelled)";
    65	    // C2 == 0 is NOT a benign degenerate case: the pure-sqrt law it selects is exactly the
    66	    // known-bad open implementation (2-39 ppm on real vectors). The vendor schema declares
    67	    // C0..C4 with no type and no NOT NULL, so a NULL or text C2 arrives here as 0.0 through
    68	    // sqlite3_column_double -- indistinguishable from a real zero. Reject both. [claude review]
    69	    if (!(C2 > 0.0)) return "MzCalibration C2 <= 0 or missing (the quadratic term is required)";
    70	    if (!(digitizer_timebase > 0.0)) return "DigitizerTimebase <= 0";
    71	    return std::string();
    72	  }
    73	  bool isSupported() const { return unsupportedReason().empty(); }
    74	
    75	  /// Temperature-corrected 1e6/sqrt(C1_eff) for one frame; hoist out of per-peak loops.
    76	  double frameFactor(double t1_frame) const
    77	  {
    78	    const double cf = 1.0 + (dC1 * (T1_ref - t1_frame)) / 1e6;
    79	    return 1e6 / std::sqrt(C1 * cf);
    80	  }
    81	
    82	  /// TOF index -> m/z. @p b is frameFactor() for this frame.
    83	  double tofToMz(double tof, double b) const
    84	  {
    85	    const double t = tof * digitizer_timebase + digitizer_delay;
    86	    // Stable root of C2*u^2 + b*u + (C0 - t) = 0: the textbook form (-b + sqrt(disc))/(2*C2)
    87	    // subtracts two nearly equal numbers (b ~ 2.5e3, C2 ~ 1e-3), throwing away ~4 digits.
    88	    // u = 2*(t - C0) / (b + sqrt(disc)) is algebraically identical and cancellation-free.
    89	    // t < C0 is unphysical (arrival before the calibration zero) and would yield a NEGATIVE u whose
    90	    // square is a plausible-looking but WRONG mass -- the exact silent-wrongness this file exists to
    91	    // prevent. Both it and a negative discriminant return 0.0, which callers see as an out-of-range
    92	    // peak rather than a credible m/z.
    93	    const double disc = b * b - 4.0 * C2 * (C0 - t);
    94	    // Out-of-model inputs return NaN, never 0.0: a zero m/z is a plausible-looking number that
    95	    // sorts first and propagates silently, which is the failure shape this file exists to remove.
    96	    if (!(disc >= 0.0) || !(t > C0)) return std::numeric_limits<double>::quiet_NaN();
    97	    const double denom = b + std::sqrt(disc);
    98	    if (!(denom > 0.0)) return std::numeric_limits<double>::quiet_NaN();
    99	    const double u = 2.0 * (t - C0) / denom;
   100	    return u * u;
   101	  }
   102	
   103	  /// m/z -> TOF index (exact inverse of tofToMz; the model is closed-form in this direction).
   104	  double mzToTof(double mz, double b) const
   105	  {
   106	    const double t = C0 + b * std::sqrt(mz > 0.0 ? mz : 0.0) + C2 * mz;
   107	    return (t - digitizer_delay) / digitizer_timebase;
   108	  }
   109	};
   110	
   111	} // namespace spextract

