    82	
    83	/// @cond TOPPCLASSES
    84	
    85	namespace
    86	{
    87	  /// A detected mass trace reduced to the quantities we correlate/gate on.
    88	  /// Current + peak resident set, read from /proc/self/status (Linux). Logged at phase boundaries so
    89	  /// the memory peak is MEASURED rather than estimated: it tells us whether the peak sits in the
    90	  /// raw-load phase or in the parallel per-window phase. Returns "" where unsupported. [mem]
    91	  /// seconds since tool start, for per-phase bottleneck attribution [perf]
    92	  static double phase_clock_()
    93	  {
    94	    static const auto t0 = std::chrono::steady_clock::now();
    95	    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
    96	  }
    97	  static std::string clk_() { char b[32]; snprintf(b, sizeof b, " [t=%.0fs]", phase_clock_()); return b; }
    98	
    99	  /// [perf-instr] Per-phase wall/CPU/RSS accounting. Sparse [t=..] markers left ~53% of wall time
   100	  /// unattributed, which is how you optimise the wrong thing. Every phase is timed; the table is
   101	  /// printed unconditionally at the end so a benchmark log always says where the time went.
   102	  struct PhaseStat { double wall = 0; double cpu = 0; long rss_end_mb = 0; int n = 0; };
   103	  inline double& flush_wall_() { static double v = 0; return v; }   // [perf-load] pick inside LOAD
   104	  inline std::map<std::string, PhaseStat>& phase_stats_()
   105	  { static std::map<std::string, PhaseStat> m; return m; }
   106	  inline std::vector<std::string>& phase_order_()
   107	  { static std::vector<std::string> v; return v; }
   108	  static double cpu_seconds_()
   109	  {
   110	    struct rusage ru;                       // RUSAGE_SELF sums ALL threads -> parallel efficiency
   111	    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0.0;
   112	    return ru.ru_utime.tv_sec + ru.ru_utime.tv_usec * 1e-6
   113	         + ru.ru_stime.tv_sec + ru.ru_stime.tv_usec * 1e-6;
   114	  }
   115	  static long rss_mb_()
   116	  {
   117	    std::ifstream f("/proc/self/status"); std::string k;   // deliberate: Linux-only, returns 0 elsewhere
   118	    while (f >> k) { if (k == "VmRSS:") { long v; f >> v; return v / 1024; } f.ignore(1 << 20, '\n'); }
   119	    return 0;
   120	  }
   121	  struct Phase
   122	  {
   123	    std::string name; double w0, c0;
   124	    explicit Phase(std::string n) : name(std::move(n)), w0(phase_clock_()), c0(cpu_seconds_()) {}
   125	    ~Phase()
   126	    {
   127	      auto& st = phase_stats_()[name];
   128	      if (st.n == 0) phase_order_().push_back(name);
   129	      st.wall += phase_clock_() - w0; st.cpu += cpu_seconds_() - c0;
   130	      st.rss_end_mb = rss_mb_(); ++st.n;
   131	    }
   132	  };
   133	  static void report_phases_(double total_wall)
   134	  {
   135	    if (phase_order_().empty()) return;
   136	    OPENMS_LOG_INFO << "\n[perf] phase breakdown (wall s | % of total | CPU s | par x | RSS MB at end)\n";
   137	    double acc = 0;
   138	    for (const auto& n : phase_order_())
   139	    {
   140	      const auto& p = phase_stats_()[n];
   141	      acc += p.wall;
   142	      char b[220];
   143	      snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  %9.1f  %5.1fx  %8ld%s\n", n.c_str(), p.wall,
   144	               total_wall > 0 ? 100.0 * p.wall / total_wall : 0.0, p.cpu,
   145	               p.wall > 0 ? p.cpu / p.wall : 0.0, p.rss_end_mb, p.n > 1 ? "  (summed)" : "");
   146	      OPENMS_LOG_INFO << b;
   147	    }
   148	    char b[160];
   149	    snprintf(b, sizeof b, "[perf] %-22s %8.1f  %5.1f%%  (unattributed %.1f s)\n", "TOTAL(measured)", acc,
   150	             total_wall > 0 ? 100.0 * acc / total_wall : 0.0, total_wall - acc);
   151	    OPENMS_LOG_INFO << b;
   152	  }
   153	
   154	  bool log_overlap_ = false;   ///< [B0] gate:coelution == "logoverlap"
   155	  /// [wavelet] Precursor-XIC smoothing scale in SECONDS, derived from the MEASURED MS1 FWHM
   156	  /// (trace:wavelet_smooth x median FWHM). 0 = off. Set once, after MS1 tracing, before the
   157	  /// window loop -- it cannot be read from a parameter directly because the FWHM is a measurement.
   158	  double wl_scale_ = 0.0;
   159	  bool rank_by_intensity_ = false;   ///< [rank] assembly:rank_by == "intensity" (diaTracer-style)
   160	  double im_weight_sigma_ = 0.0;     ///< [recall] Gaussian IM-proximity weight on emitted fragment intensity (0=off)
   161	  double mono_guard_ = 0.0;          ///< [mono-guard] averagine slack on leftward isotope steps (0=off)
   162	  bool mono_select_ = false;         ///< [mono-select] pick the mono by averagine fit over the isotope run
   163	  std::atomic<long long> stat_slice_{0};    ///< fragments VISITED by the IM slice
   164	  std::atomic<long long> stat_rtpass_{0};   ///< of those, how many pass the RT gate
   165	  std::atomic<long long> stat_prec_{0};     ///< precursors scored
   166	  bool var_support_ = false;         ///< [Q1] Pearson variance over union support, not full grid G (0-pad fix)
   167	  double corr_power_ = 0.0;          ///< [Q2] emitted fragment intensity *= corr^corr_power (0=off; engine-agnostic)
   168	  bool drop_prec_iso_ = std::getenv("SPEXTRACT_DROP_PREC_ISO") != nullptr;   ///< [C9 A/B] drop precursor M+1..M+3 from fragment lists
   169	
   170	  static std::string rss_()
   171	  {
   172	    std::ifstream st("/proc/self/status");
   173	    if (!st) return "";
   174	    std::string line, cur = "?", peak = "?";
   175	    while (std::getline(st, line))
   176	    {
   177	      auto val = [&line]() {
   178	        std::string v = line.substr(line.find(':') + 1);
   179	        size_t a = v.find_first_not_of(" \t");
   180	        return a == std::string::npos ? std::string("?") : v.substr(a);
   181	      };
   182	      if (line.rfind("VmRSS:", 0) == 0) cur = val();
   183	      else if (line.rfind("VmHWM:", 0) == 0) peak = val();
   184	    }
   185	    return " [RSS " + cur + ", peak " + peak + "]";
   186	  }
   187	
   188	  /// [dyn-mem] Bytes we may still allocate. MemAvailable is the kernel's own estimate of what
   189	  /// can be handed out without swapping (it accounts for reclaimable page cache), which is the
   190	  /// right quantity on a SHARED node -- MemFree would ignore cache and MemTotal would ignore
   191	  /// the other users. Add our own RSS back: memory we already hold is part of our budget, not
   192	  /// somebody else's. Returns 0 if unreadable, which the caller treats as "admit one at a time".
   193	  static size_t availableBytes_()
   194	  {
   195	    std::ifstream mi("/proc/meminfo");
   196	    if (!mi) return 0;
   197	    std::string line;
   198	    size_t avail_kb = 0;
   199	    while (std::getline(mi, line))
   200	      if (line.rfind("MemAvailable:", 0) == 0)
   201	      { avail_kb = strtoull(line.c_str() + 13, nullptr, 10); break; }
   202	    if (!avail_kb) return 0;
   203	    std::ifstream st("/proc/self/status");
   204	    size_t rss_kb = 0;
   205	    while (st && std::getline(st, line))
   206	      if (line.rfind("VmRSS:", 0) == 0)
   207	      { rss_kb = strtoull(line.c_str() + 6, nullptr, 10); break; }
   208	    return (avail_kb + rss_kb) * 1024ull;
   209	  }
   210	
   211	  /// THE RT AXIS IS GLOBAL AND DISCRETE. Every acquired frame has one retention time, and every
   212	  /// point of every mass trace sits on one of those frames -- so an RT value never needs to be
   213	  /// stored per point. It used to be: `vector<pair<double,double>>` cost 16 B per point and
   214	  /// duplicated the same ~33,000 values across hundreds of millions of points, and aligning two
   215	  /// profiles meant a binary search per point because the values had to be compared numerically.
   216	  /// Here the axis is stored ONCE, a point is (frame index, intensity) at 8 B, and alignment is
   217	  /// integer equality. Built once after loading, read-only thereafter.
   218	  inline vector<double>& rtAxis() { static vector<double> v; return v; }
   219	
   220	  /// Frame index of an RT. Used only while BUILDING traces: the value comes from a frame, so the
   221	  /// match is exact, and the nearest-neighbour fallback only guards a last-ulp difference.
   222	  inline uint32_t rtIndex(double rt)
   223	  {
   224	    const vector<double>& a = rtAxis();
   225	    if (a.empty()) return 0;
   226	    auto it = lower_bound(a.begin(), a.end(), rt);
   227	    if (it == a.end()) return (uint32_t)(a.size() - 1);
   228	    if (it != a.begin() && (*it - rt) > (rt - *(it - 1))) --it;
   229	    return (uint32_t)(it - a.begin());
   230	  }
   231	
   232	  struct Trace
   233	  {
   234	    double mz = 0.0;
   235	    double rt = 0.0;   ///< apex/centroid RT
   236	    double im = 0.0;   ///< centroid ion mobility (1/K0)
   237	    double intensity = 0.0;
   238	    /// The flight-time bin this trace was measured on, and the calibration factor of its apex
   239	    /// frame. The pair is the AUTHORITATIVE m/z: `mz` below is a cached convenience for the gates
   240	    /// that still compare in m/z space, and the value actually written out is recomputed from these
   241	    /// two at export. 0 means the trace came from the OpenMS detector, which has no bin.
   242	    uint32_t tof = 0;
   243	    double   b = 0.0;
   244	    /// Elution profile, ascending in RT: parallel arrays of frame index and intensity. 8 B/point.
   245	    vector<uint32_t> xi;
   246	    vector<float>    xv;
   247	    size_t np() const { return xi.size(); }
   248	    double rtAt(size_t i) const { return rtAxis()[xi[i]]; }
   249	    double intAt(size_t i) const { return (double)xv[i]; }
   250	    void freeProfile() { vector<uint32_t>().swap(xi); vector<float>().swap(xv); }
   251	  };
   252	
   253	  /// A precursor hypothesis after isotope/charge inference.
   254	  struct Precursor_
   255	  {
   256	    double mono_mz = 0.0;
   257	    uint32_t mono_tof = 0;   ///< the monoisotope's flight-time bin, and its frame's factor: the
   258	    double   mono_b = 0.0;   ///  reported m/z is recomputed from these when the spectrum is written
   259	    int charge = 0;          ///< 0 == unknown
   260	    double rt = 0.0;
   261	    double im = 0.0;
   262	    size_t trace_idx = 0;    ///< index into ms1 traces
   263	    bool guessed = false;    ///< [way-4] charge was DEFAULTED, not isotope-supported
   264	    int n_isotopes = 0;      ///< [Q4] isotope peaks behind the mono call (0/1 = weak, mono ±1.00335 uncertain)
   265	  };
   266	
   267	  /// MassTraceDetection locates the per-peak IM array by the exact name
   268	  /// Constants::UserParam::ION_MOBILITY ("Ion Mobility"). Converters name it via CV term and
   269	  /// PeakPickerIM names it "Ion Mobility Centroid"; rename whichever exists so tracing is IM-aware.
   270	  void ensureIMArrayName(MSSpectrum& s)
   271	  {
   272	    auto& fdas = s.getFloatDataArrays();
   273	    if (s.containsIMData())
   274	    {
   275	      fdas[s.getIMData().first].setName(Constants::UserParam::ION_MOBILITY);
   276	      return;
   277	    }
   278	    for (auto& fda : fdas)
   279	    {
   280	      if (fda.getName() == Constants::UserParam::ION_MOBILITY_CENTROID)
   281	      {
   282	        fda.setName(Constants::UserParam::ION_MOBILITY);
   283	        return;
   284	      }
   285	    }
   286	  }
   287	
   288	  /// Reported-m/z estimator, set once from `trace:mz_estimator` before any trace is converted.
   289	  /// A file-scope value because toTrace() is a free helper with no access to the tool's parameters.
   290	  inline std::string& mzEstimator() { static std::string v = "apex"; return v; }
   291	
   292	  Trace toTrace(const MassTrace& mt)
   293	  {
   294	    Trace t;
   295	    // Reported m/z of a mass trace. "apex" (the default) takes the m/z of the most intense peak;
   296	    // "mean" is the OpenMS intensity-weighted centroid; "median" the median m/z. Set by
   297	    // `trace:mz_estimator` -- see docs/S30-BASELINE.md for the comparison that chose apex.
   298	    const std::string& mz_est = mzEstimator();
   299	    if (mz_est == "apex" && mt.getSize() > 0) t.mz = mt[mt.findMaxByIntPeak(false)].getMZ();
   300	    else if (mz_est == "median" && mt.getSize() > 0) { MassTrace m2 = mt; m2.updateMedianMZ(); t.mz = m2.getCentroidMZ(); }
   301	    else t.mz = mt.getCentroidMZ();
   302	    t.rt = mt.getCentroidRT();
   303	    t.im = mt.getCentroidIM();
   304	    t.intensity = mt.getMaxIntensity(false);
   305	    // MassTrace peaks are not guaranteed RT-ordered, and the profile must be ascending for the
   306	    // correlation loops, so index them and sort the small (index, intensity) pairs.
   307	    const Size np = mt.getSize();
   308	    vector<pair<uint32_t, float>> pts;
   309	    pts.reserve(np);
   310	    for (Size i = 0; i < np; ++i) pts.emplace_back(rtIndex(mt[i].getRT()), (float)mt[i].getIntensity());
   311	    sort(pts.begin(), pts.end());
   312	    t.xi.reserve(np); t.xv.reserve(np);
   313	    for (const auto& q : pts) { t.xi.push_back(q.first); t.xv.push_back(q.second); }
   314	    return t;
   315	  }
   316	
   317	  /// Per-window correlation grid: all fragment XICs are resampled onto ONE common RT axis
   318	  /// (the sorted union of fragment-trace RTs) so a precursor can be correlated against every
   319	  /// candidate fragment as a precomputed dot product instead of an O(P log F) per-pair search.
   320	  /// This is the hot-path optimization: precursor XIC is prepared once per precursor (not per
   321	  /// fragment), fragment means/norms are precomputed once per window. [perf]
   322	  /// CSR layout: one `vector<vector<...>>` costs 24 B of header PER FRAGMENT before a single
   323	  /// support point is stored -- ~200 MB/window at 8.5 M fragments, and scattered allocations.
   324	  /// A flat array + offsets costs 4 B/fragment and is contiguous for the correlation loop. [compact]
   325	  struct FragGrid
   326	  {
   327	    vector<double> rt;                          ///< sorted unique grid RTs (size G)
   328	    vector<int> slot_of_frame;                  ///< global frame index -> grid slot, -1 if unused
   329	    vector<int> nearest_slot;                   ///< global frame index -> NEAREST used slot within delta_rt
   330	    vector<uint64_t> off;                       ///< size F+1; fragment i spans [off[i], off[i+1])
   331	                                                ///  64-bit on purpose: 8.5 M fragments x ~510 support
   332	                                                ///  points is within 2x of the 32-bit wrap, and an
   333	                                                ///  overflow here silently corrupts every correlation.
   334	    vector<pair<int, float>> flat;              ///< (grid index, intensity), concatenated
   335	    vector<double> mean, invnorm;               ///< per fragment: mean and 1/norm over the full grid
   336	    size_t supBegin(size_t i) const { return off[i]; }
   337	    size_t supEnd(size_t i)   const { return off[i + 1]; }
   338	  };
   339	
   340	
   410	          agg.push_back(pk);
   411	          im_out.push_back((float)(wim / sum));
   412	        }
   413	        // advance to next unconsumed peak
   414	        while (a < buf.size() && buf[a].in < 0.0) ++a;
   415	        if (a >= buf.size()) break;
   416	      }
   417	      agg.getFloatDataArrays().push_back(im_out);
   418	      agg.sortByPosition();
   419	      out.addSpectrum(std::move(agg));
   420	    }
   421	    wmap = std::move(out);
   422	  }
   423	
   424	  /// [compact] Quantised frame store for the per-window buffer.
   425	  ///
   426	  /// Holding all 24 isolation windows as full OpenMS PeakMaps costs ~89 GB resident before any window
   427	  /// is consumed, which is what forces `max_concurrent_windows` down and caps our parallelism at ~7
   428	  /// cores (diaTracer uses ~43). A frame only needs (m/z, intensity, 1/K0) per peak plus one RT, so we
   429	  /// store structure-of-arrays with quantised keys and materialise a PeakMap ONLY inside the worker
   430	  /// that is about to trace it, freeing the compact copy immediately.
   431	  ///
   432	  /// Precision (deliberately far finer than every downstream tolerance, so tracing is unaffected):
   433	  ///   m/z : uint32 at 1e-5 Da  -> 0.007 ppm at m/z 1400, vs a 20 ppm trace tolerance (2800x margin)
   434	  ///   1/K0: uint16 over [0.4,1.8] -> 2.1e-5, vs a 0.01 IM tolerance (470x margin)
   435	  ///   intensity: float32, unchanged (Peak1D already stores float)
   436	  /// Cost: 10 B/peak (4+4+2) vs ~20 B/peak for Peak1D+FloatDataArray, plus no per-MSSpectrum overhead.
   437	  constexpr double MZ_Q = 1e5;      ///< m/z quantum = 1e-5 Da
   438	
   439	  /// THE M/Z AXIS IS THE INSTRUMENT'S FLIGHT-TIME INDEX. A timsTOF measures an integer TOF bin;
   440	  /// m/z is a calibrated function of it, not a measured quantity. The compact store had been
   441	  /// quantising the CALIBRATED m/z onto a uniform 1e-5 Da grid -- a second discretisation on top of
   442	  /// the instrument's own, and a coarse approximation of the wrong axis. This tool only runs on
   443	  /// ion-mobility TOF data, so the native axis is always available and there is no reason to
   444	  /// approximate it.
   445	  ///
   446	  /// Why the native axis is better than a uniform m/z grid, not merely smaller:
   447	  ///   * it is LOSSLESS -- the bin IS the measurement, so no quantum has to be justified;
   448	  ///   * ~5e5 bins instead of ~1.7e8 grid points, so a bin index is a usable array subscript;
   449	  ///   * the SAME ion gives the SAME bin in every frame, while its calibrated m/z wobbles with the
   450	  ///     digitizer temperature -- so grouping in TOF space does not have to spend part of its ppm
   451	  ///     tolerance absorbing calibration drift, which is exactly what the m/z-space tolerance does;
   452	  ///   * a tolerance in m/z ppm becomes a handful of integer bins (m ~ tof^2, so a relative m/z
   453	  ///     tolerance is about half of it in tof), which makes candidate lookup pure arithmetic.
   454	  ///
   455	  /// The per-frame factor `b` (from the digitizer temperature) is what turns a bin into an m/z, and
   456	  /// it is applied at REPORT time, where it belongs -- the extraction never needs a calibrated m/z.
   457	  using TofIdx = uint32_t;
   458	
   459	  /// The flight-time axis for one run: the calibration model plus each frame's temperature factor.
   460	  /// Fail-closed: without a calibration there is no TOF axis and the caller must not pretend there
   461	  /// is one.
   462	  struct TofAxis
   463	  {
   464	    spextract::TdfMzCalibration cal;
   465	    vector<double> b_by_frame;        ///< frame factor per FRAME ID (index 0 unused, as in the tdf)
   466	    bool ok = false;
   467	
   468	    double factor(size_t frame_id) const
   469	    { return frame_id < b_by_frame.size() ? b_by_frame[frame_id] : cal.frameFactor(cal.T1_ref); }
   470	    double mzOf(TofIdx tof, double b) const { return cal.tofToMz((double)tof, b); }
   471	    TofIdx tofOf(double mz, double b) const
   472	    {
   473	      const double t = cal.mzToTof(mz, b);
   474	      return t > 0.0 ? (TofIdx)llround(t) : 0u;
   475	    }
   476	    /// A relative m/z tolerance as a bin count, derived rather than assumed: convert both ends.
   477	    TofIdx span(TofIdx tof, double b, double ppm) const
   478	    {
   479	      const double mz = mzOf(tof, b);
   480	      if (!(mz > 0.0)) return 1u;
   481	      const double t2 = cal.mzToTof(mz * (1.0 + ppm * 1e-6), b);
   482	      const double d = fabs(t2 - (double)tof);
   483	      return (TofIdx)std::max(1.0, d + 0.5);
   484	    }
   485	  };
   486	
   487	  inline TofAxis& tofAxis() { static TofAxis a; return a; }
   488	
   489	  /// Populate the flight-time axis from a Bruker analysis.tdf (the .d directory, or a sidecar).
   490	  /// Returns false and leaves the axis unusable if anything is missing -- the detector that needs it
   491	  /// refuses to run rather than substituting a reference temperature for every frame.
   492	  inline bool loadTofAxis(const std::string& tdf_path, String& why)
   493	  {
   494	#if __has_include(<SQLiteCpp/SQLiteCpp.h>)
   495	    TofAxis& ax = tofAxis();
   496	    ax.ok = false;
   497	    try
   498	    {
   499	      SQLite::Database db(tdf_path, SQLite::OPEN_READONLY);
   500	      SQLite::Statement q(db, "SELECT ModelType, DigitizerTimebase, DigitizerDelay, C0, C1, C2, T1, dC1, dC2, C3, C4 FROM MzCalibration");
   501	      if (!q.executeStep()) { why = "no MzCalibration row"; return false; }
   502	      ax.cal.model_type = q.getColumn(0).getInt();   // was never assigned: the check then saw 0
   503	      ax.cal.digitizer_timebase = q.getColumn(1).getDouble();
   504	      ax.cal.digitizer_delay = q.getColumn(2).getDouble();
   505	      ax.cal.C0 = q.getColumn(3).getDouble(); ax.cal.C1 = q.getColumn(4).getDouble();
   506	      ax.cal.C2 = q.getColumn(5).getDouble(); ax.cal.T1_ref = q.getColumn(6).getDouble();
   507	      ax.cal.dC1 = q.getColumn(7).getDouble(); ax.cal.dC2 = q.getColumn(8).getDouble();
   508	      ax.cal.C3 = q.getColumn(9).getDouble(); ax.cal.C4 = q.getColumn(10).getDouble();
   509	      if (q.executeStep()) { why = "more than one MzCalibration row"; return false; }
   510	      if (!ax.cal.isSupported()) { why = ax.cal.unsupportedReason(); return false; }
   511	      SQLite::Statement fr(db, "SELECT Id, T1 FROM Frames");
   512	      while (fr.executeStep())
   513	      {
   514	        const long long id = fr.getColumn(0).getInt64();
   515	        if (id < 0) continue;
   516	        if ((size_t)id >= ax.b_by_frame.size()) ax.b_by_frame.resize((size_t)id + 1, 0.0);
   517	        ax.b_by_frame[(size_t)id] = ax.cal.frameFactor(fr.getColumn(1).getDouble());
   518	      }
   519	      // frames the tdf did not list keep the reference factor rather than a zero
   520	      const double bref = ax.cal.frameFactor(ax.cal.T1_ref);
   521	      for (double& b : ax.b_by_frame) if (!(b > 0.0)) b = bref;
   522	      if (ax.b_by_frame.size() < 2) { why = "no Frames rows"; return false; }
   523	      ax.ok = true;
   524	      return true;
   525	    }
   526	    catch (const std::exception& e) { why = e.what(); return false; }
   527	#else
   528	    why = "built without SQLiteCpp";
   529	    (void)tdf_path;
   530	    return false;
   531	#endif
   532	  }
   533	  constexpr double IM_LO = 0.4, IM_HI = 1.8;
   534	  constexpr double IM_Q = 65535.0 / (IM_HI - IM_LO);
   535	
   536	  struct CompactFrame
   537	  {
   538	    double rt = 0.0;
   539	    uint32_t frame_id = 0;   ///< vendor frame Id: the key the per-frame calibration factor is on
   540	    vector<uint32_t> mzq;
   541	    vector<float> inten;
   542	    vector<uint16_t> imq;
   543	    size_t bytes() const { return mzq.size() * 4 + inten.size() * 4 + imq.size() * 2; }
   544	  };
   545	
   546	  /// Peaks that cannot be represented exactly are DROPPED and COUNTED, never silently altered.
   547	  /// [adv-fix] The first version CLAMPED out-of-range 1/K0 to IM_LO/IM_HI, which would pin outliers
   548	  /// from many frames onto two artificial, perfectly-aligned mobility values — manufacturing spurious
   549	  /// traces out of nothing. NaN also passed straight through clamp into llround (UB on unsigned
   550	  /// conversion). Dropping + counting is the only defensible behaviour.
   551	  struct CompactStats
   552	  {
   553	    size_t no_im_array = 0, size_mismatch = 0, bad_mz = 0, bad_im = 0, kept = 0;
   554	    /// merge per-frame stats after a parallel batch [perf-load]
   555	    CompactStats& operator+=(const CompactStats& o)
   556	    {
   557	      no_im_array += o.no_im_array; size_mismatch += o.size_mismatch;
   558	      bad_mz += o.bad_mz; bad_im += o.bad_im; kept += o.kept;
   559	      return *this;
   560	    }
   561	  };
   562	
   563	  /// Convert one picked MSSpectrum into the compact form (drops everything tracing does not read).
   564	  /// Vendor frame Id from a native identifier. Bruker writes "frame=<N> scan=<M>"; the mzPeak
   565	  /// reader writes "mzpeak=<frame index> window=<w>". Anything else yields 0, which makes the
   566	  /// calibration fall back to the reference temperature -- so the caller must treat 0 as unknown.
   567	  inline uint32_t frameIdOf(const String& nid)
   568	  {
   569	    for (const char* key : {"frame=", "mzpeak="})
   570	    {
   571	      const size_t i = nid.find(key);
   572	      if (i == std::string::npos) continue;
   573	      const size_t j = i + strlen(key);
   574	      uint32_t v = 0; size_t k = j;
   575	      for (; k < nid.size() && isdigit((unsigned char)nid[k]); ++k) v = v * 10 + (uint32_t)(nid[k] - '0');
   576	      if (k > j) return v;
   577	    }
   578	    return 0;
   579	  }
   580	
   581	  CompactFrame compactify(const MSSpectrum& s, CompactStats& st)
   582	  {
   583	    CompactFrame f;
   584	    f.rt = s.getRT();
   585	    f.frame_id = frameIdOf(s.getNativeID());
   586	    if (!s.containsIMData()) { st.no_im_array += s.size(); return f; }
   587	    const auto& im = s.getFloatDataArrays()[s.getIMData().first];
   588	    const Size n = s.size();
   589	    if (im.size() != n) { st.size_mismatch += n; return f; }   // [adv-fix] no out-of-bounds read
   590	    f.mzq.reserve(n); f.inten.reserve(n); f.imq.reserve(n);
   591	    for (Size i = 0; i < n; ++i)
   592	    {
   593	      const double mz = s[i].getMZ();
   594	      const double imv = (double)im[i];
   595	      // [adv-fix] validate BEFORE the unsigned conversion (NaN/inf/negative -> UB otherwise)
   596	      if (!std::isfinite(mz) || mz <= 0.0 || mz * MZ_Q > 4.2e9) { ++st.bad_mz; continue; }
   597	      if (!std::isfinite(imv) || imv < IM_LO || imv > IM_HI)    { ++st.bad_im; continue; }
   598	      f.mzq.push_back((uint32_t)llround(mz * MZ_Q));
   599	      f.inten.push_back(s[i].getIntensity());
   600	      f.imq.push_back((uint16_t)llround((imv - IM_LO) * IM_Q));
   601	      ++st.kept;
   602	    }
   603	    return f;
   604	  }
   605	
   606	
   607	  /// [det] Order-insensitive 64-bit digest of a stage's numeric output, for localising
   608	  /// run-to-run nondeterminism: sort the bit patterns, then FNV-1a. Logged under SPEXTRACT_DET=1.
   609	  static uint64_t detDigest_(vector<uint64_t> bits)
   610	  {
   611	    std::sort(bits.begin(), bits.end());
   612	    uint64_t h = 1469598103934665603ULL;
   613	    for (uint64_t b : bits) { h ^= b; h *= 1099511628211ULL; }
   614	    return h;
   615	  }
   616	  static bool detOn_() { static const bool on = std::getenv("SPEXTRACT_DET") != nullptr; return on; }
   617	  static uint64_t traceDigest_(const vector<Trace>& ts)
   618	  {
   619	    vector<uint64_t> b; b.reserve(ts.size() * 3);
   620	    for (const auto& t : ts)
   621	    {
   622	      uint64_t u; double v;
   623	      v = t.mz; std::memcpy(&u, &v, 8); b.push_back(u);
   624	      v = t.rt; std::memcpy(&u, &v, 8); b.push_back(u);
   625	      v = t.intensity; std::memcpy(&u, &v, 8); b.push_back(u);
   626	    }
   627	    return detDigest_(std::move(b));
   628	  }
   629	
   630	  /// One window's peaks in INDEX SPACE, frame-major. This is what the compact store already holds;
   631	  /// the point is that it is never converted back to Peak1D doubles. Replaces the materialised
   632	  /// PeakMap for the integer detector. See docs/MZ-AXIS-DESIGN.md.
   633	  struct PeakSlab
   634	  {
   635	    vector<uint32_t> frame_off;    ///< size F+1: frame f owns [frame_off[f], frame_off[f+1])
   636	    vector<uint32_t> rt_index;     ///< size F: the frame's index on the GLOBAL RT axis
   637	    vector<TofIdx>   tof;          ///< flight-time bin, ascending within a frame
   638	    vector<double>   b;            ///< size F: the frame's calibration factor (bin -> m/z)
   639	    vector<float>    inten;
   640	    vector<uint16_t> imq;          ///< the store's quantised 1/K0, kept for export
   641	    size_t frames() const { return rt_index.size(); }
   642	    size_t peaks()  const { return tof.size(); }
   643	  };
   644	
   645	  /// Move a window's compact frames into a slab, consuming them as it goes (the compact store has
   646	  /// to shrink in step, exactly as materializeWindow does, or the two representations coexist).
   647	  PeakSlab toSlab(vector<CompactFrame>& frames)
   648	  {
   649	    PeakSlab sl;
   650	    const size_t F = frames.size();
   651	    sl.frame_off.resize(F + 1, 0);
   652	    sl.rt_index.resize(F);
   653	    size_t total = 0;
   654	    for (const auto& f : frames) total += f.mzq.size();
   655	    sl.tof.reserve(total); sl.inten.reserve(total); sl.imq.reserve(total);
   656	    sl.b.resize(F);
   657	    const TofAxis& ax = tofAxis();
   658	    for (size_t i = 0; i < F; ++i)
   659	    {
   660	      CompactFrame& f = frames[i];
   661	      sl.rt_index[i] = rtIndex(f.rt);
   662	      // The compact store keeps m/z at a 1e-5 Da quantum, ~400x finer than one TOF bin at m/z 600,
   663	      // so inverting the calibration recovers the ORIGINAL bin exactly -- no approximation is
   664	      // introduced here, and the loader does not have to change.
   665	      const double b = ax.factor(f.frame_id);
   666	      sl.b[i] = b;
   667	      sl.frame_off[i] = (uint32_t)sl.tof.size();
   668	      for (size_t k = 0; k < f.mzq.size(); ++k)
   669	        sl.tof.push_back(ax.tofOf((double)f.mzq[k] / MZ_Q, b));
   670	      sl.inten.insert(sl.inten.end(), f.inten.begin(), f.inten.end());
   671	      sl.imq.insert(sl.imq.end(), f.imq.begin(), f.imq.end());
   672	      vector<uint32_t>().swap(f.mzq);
   673	      vector<float>().swap(f.inten);
   674	      vector<uint16_t>().swap(f.imq);
   675	    }
   676	    sl.frame_off[F] = (uint32_t)sl.tof.size();
   677	    return sl;
   678	  }
   679	
   680	
   681	  /// Mass-trace detection on the integer m/z axis.
   682	  ///
   683	  /// The OpenMS detector accepts a peak when it lies within `mass_error_ppm` of a trace's RUNNING
   684	  /// centroid, which needs a tolerance comparison against every live trace and makes the cost
   685	  /// superlinear in peaks per band -- measured on S30: 4 bands 18:25 wall / 163 GB against 12 bands
   686	  /// 12:53 / 103 GB, i.e. the same work costs more when the bands are bigger. On a uniform integer
   687	  /// axis the candidates for a peak are found by ARITHMETIC: a live trace can only accept indices
   688	  /// within `ppmSpan` of its centroid, so bucketing by `mz >> shift` with a bucket wider than the
   689	  /// largest span puts every candidate in the peak's own bucket or its two neighbours.
   690	  ///
   691	  /// This is a DIFFERENT ALGORITHM, not a reimplementation: it will not reproduce the OpenMS
   692	  /// detector peak for peak. It is therefore gated behind `trace:detector=integer` (default
   693	  /// `openms`) and must be judged on identified peptides with both search engines, never on a
   694	  /// spectrum digest.
   695	  ///
   696	  /// Mobility is part of the identity, as in the IM-aware OpenMS path: a candidate must also be
   697	  /// within `im_tol` of the trace's mobility. Valley splitting is NOT done here -- the existing
   698	  /// ElutionPeakDetection step runs afterwards on the traces this produces.
   699	  /// Mass-trace detection on integer arrays, following OpenMS `MassTraceDetection::run_` step for
   700	  /// step -- written from that source, not from a description of it. The first version was written
   701	  /// from a description and lost 92% of the peptides; the review that found why is in
   702	  /// docs/reviews/integer-tracing-2026-09-03/ and the corrected semantics are:
   703	  ///   * seeds in intensity order, ties later-index-first (stable ascending sort, reverse walk);
   704	  ///   * the two directions extend INTERLEAVED, one frame down then one up, sharing one centroid;
   705	  ///   * acceptance is the CLOSEST peak within +-3 sd of the running m/z centroid and within the
   706	  ///     mobility tolerance of the running mobility centroid; if that closest peak is already
   707	  ///     taken, the frame is a MISS -- the next-closest is not tried;
   708	  ///   * sd starts at centroid*ppm and is RE-ESTIMATED from the accepted peaks (reestimate_mt_sd);
   709	  ///   * a direction stops after more than 5 consecutive misses; an empty frame is not a miss;
   710	  ///   * the trace is valid if its RT span is within [min,max] length and
   711	  ///     size / (frames visited - trailing misses) >= min_sample_rate (0.5 by default);
   712	  ///   * peaks are marked taken only when the trace is valid;
   713	  ///   * the seed is counted twice in the centroid, as run_ does (init, then update again).
   714	  /// Peaks stay integers (flight-time bin, quantised mobility); the running centroid and sd are
   715	  /// doubles in m/z, exactly as in OpenMS, so the tolerance semantics are the same. The bin<->m/z
   716	  /// conversion is one calibration call per frame step plus one per ACCEPTED peak -- never per
   717	  /// visited peak. Valley splitting runs afterwards on the result, as it does for the OpenMS path.
   718	  vector<Trace> detectTracesInteger_(PeakSlab& sl, double mass_ppm, double im_tol,
   719	                                     double noise, double snr, double min_len_sec,
   720	                                     double min_sample_rate, double max_len_sec,
   721	                                     const std::string& /*mz_est: applied in toTrace() after EPD*/,
   722	                                     TofIdx band_lo = 0, TofIdx band_hi = 0)
   723	  {
   724	    vector<Trace> out;
   725	    const size_t F = sl.frames(), P = sl.tof.size();
   726	    if (F == 0 || P == 0) return out;
   727	    const bool banded = band_hi > band_lo;
   728	    const TofAxis& ax = tofAxis();
   729	    const double msr = min_sample_rate >= 0.0 ? min_sample_rate : 0.5;   // -1 = OpenMS default
   730	    const double imq_tol = im_tol * IM_Q;
   731	    const Size max_missed = 5;                                            // trace_termination_outliers
   732	
   733	    vector<uint32_t> frame_of(P, 0);
   734	    for (size_t f = 0; f < F; ++f)
   735	      for (uint32_t k = sl.frame_off[f]; k < sl.frame_off[f + 1]; ++k) frame_of[k] = (uint32_t)f;
   736	
   737	    // Membership: OpenMS deletes every peak <= noise before tracing, so they cannot join a trace.
   738	    // Seeds additionally need intensity > snr*noise (strict). Banding: seed only in the core.
   739	    vector<char> member(P, 0);
   740	    for (uint32_t k = 0; k < P; ++k) member[k] = sl.inten[k] > (float)noise;
   741	    vector<uint32_t> order;
   742	    order.reserve(P / 4);
   743	    const float min_apex = (float)(snr * noise);
   744	    for (uint32_t k = 0; k < P; ++k)
   745	      if (member[k] && sl.inten[k] > min_apex && (!banded || (sl.tof[k] >= band_lo && sl.tof[k] < band_hi)))
   746	        order.push_back(k);
   747	    // OpenMS: stable_sort ascending by intensity, then iterate in reverse -> among equal
   748	    // intensities the LATER peak seeds first.
   749	    sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) {
   750	      if (sl.inten[a] != sl.inten[b]) return sl.inten[a] > sl.inten[b];
   751	      return a > b;
   752	    });
   753	
   754	    vector<char> visited(P, 0);
   755	    auto mzAt = [&](uint32_t k) { return ax.mzOf(sl.tof[k], sl.b[frame_of[k]]); };
   756	    auto iwm = [](double v, double w, double& c, double& cnt, double& den) {   // updateIterativeWeightedMean_
   757	      const double ct = 1.0 + (w * v) / cnt, dt = 1.0 + w / den;
   758	      c *= (ct / dt); cnt += w * v; den += w;
   759	    };
   760	    auto sdRobust = [](double mz, double w, double mean, double& sd, double& wsum) {   // updateWeightedSDEstimateRobust
   761	      const double d1 = std::log(wsum) + 2.0 * std::log(sd);
   762	      const double d2 = std::log(w) + 2.0 * std::log(std::abs(mz - mean));
   763	      const double denom = std::sqrt(std::exp(d1) + std::exp(d2));
   764	      const double ws = wsum + w;
   765	      const double t = denom / std::sqrt(ws);
   766	      if (t > std::numeric_limits<double>::epsilon()) sd = t;
   767	      wsum = ws;
   768	    };
   769	    /// findBestPeak_ + isPeakAcceptable_: closest m/z inside +-3sd with mobility inside the gate;
   770	    /// returns the index, or -1 for "no candidate"; sets `taken` if the closest one is visited.
   771	    auto best = [&](size_t f, double cmz, double sd, double cim, bool& taken) -> long {
   772	      taken = false;
   773	      const uint32_t a = sl.frame_off[f], b = sl.frame_off[f + 1];
   774	      if (b <= a) return -1;
   775	      const double bf = sl.b[f];
   776	      const double lo_mz = cmz - 3.0 * sd, hi_mz = cmz + 3.0 * sd;
   777	      const TofIdx lo_t = ax.tofOf(lo_mz > 0.0 ? lo_mz : 1e-9, bf);
   778	      const uint32_t s0 = (uint32_t)(lower_bound(sl.tof.begin() + a, sl.tof.begin() + b, lo_t) - sl.tof.begin());
   779	      long bk = -1; double bd = std::numeric_limits<double>::infinity();
   780	      for (uint32_t k = s0; k < b; ++k)
   781	      {
   782	        const double mz = ax.mzOf(sl.tof[k], bf);
   783	        if (mz > hi_mz) break;
   784	        if (mz < lo_mz || !member[k]) continue;
   785	        if (std::abs((double)sl.imq[k] - cim) > imq_tol) continue;
   786	        const double d = std::abs(mz - cmz);
   787	        if (d < bd) { bd = d; bk = (long)k; }          // strict <: first of equals wins
   788	      }
   789	      if (bk >= 0 && visited[(size_t)bk]) { taken = true; return -1; }
   790	      return bk;
   791	    };
   792	
   793	    struct Dir { Size hits = 0, missed = 0, scans = 0; bool active = true; };
   794	    vector<uint32_t> got;                 // provisional members, marked only if the trace is valid
   795	    for (uint32_t seed : order)
   796	    {
   797	      if (visited[seed]) continue;
   798	      const size_t f0 = frame_of[seed];
   799	      const double w0 = sl.inten[seed], m0 = mzAt(seed);
   800	      double cmz = m0, cnt = w0 * m0, den = w0;
   801	      iwm(m0, w0, cmz, cnt, den);                             // seed counted twice, as run_ does
   802	      double cim = sl.imq[seed], cnt_im = w0 * cim, den_im = w0;
   803	      iwm((double)sl.imq[seed], w0, cim, cnt_im, den_im);
   804	      double sd = (cmz / 1e6) * mass_ppm, wsum = w0;
   805	      got.clear(); got.push_back(seed);
   806	      Dir dn, up;
   807	      long fd = (long)f0, fu = (long)f0;
   808	      while ((fd > 0 && dn.active) || (fu + 1 < (long)F && up.active))
   809	      {
   810	        for (int side = 0; side < 2; ++side)
   811	        {
   812	          Dir& d = side == 0 ? dn : up;
   813	          long& fi = side == 0 ? fd : fu;
   814	          if (!d.active) continue;
   815	          if (side == 0 ? !(fi > 0) : !(fi + 1 < (long)F)) continue;
   816	          const size_t f = (size_t)(side == 0 ? fi - 1 : fi + 1);
   817	          if (sl.frame_off[f + 1] > sl.frame_off[f])            // an empty frame is not a miss
   818	          {
   819	            bool taken = false;
   820	            const long k = best(f, cmz, sd, cim, taken);
   821	            if (k >= 0)
   822	            {
   823	              const double mz = mzAt((uint32_t)k), w = sl.inten[k];
   824	              iwm(mz, w, cmz, cnt, den);
   825	              iwm((double)sl.imq[k], w, cim, cnt_im, den_im);
   826	              sdRobust(mz, w, cmz, sd, wsum);
   827	              got.push_back((uint32_t)k);
   828	              ++d.hits; d.missed = 0;
   829	            }
   830	            else ++d.missed;
   831	          }
   832	          fi += (side == 0 ? -1 : 1);
   833	          ++d.scans;
   834	          if (d.missed > max_missed) d.active = false;
   835	        }
   836	      }
   837	      // isTraceValid_
   838	      uint32_t fmin = frame_of[got[0]], fmax = fmin;
   839	      for (uint32_t k : got) { fmin = std::min(fmin, frame_of[k]); fmax = std::max(fmax, frame_of[k]); }
   840	      const double span_s = rtAxis()[sl.rt_index[fmax]] - rtAxis()[sl.rt_index[fmin]];
   841	      if (span_s < min_len_sec) continue;
   842	      if (max_len_sec >= 0.0 && span_s > max_len_sec) continue;
   843	      const Size total = dn.scans + up.scans + 1;
   844	      const Size adjusted = total > dn.missed + up.missed ? total - dn.missed - up.missed : 1;
   845	      if ((double)got.size() / (double)adjusted < msr) continue;
   846	      for (uint32_t k : got) visited[k] = 1;                  // valid: now they are taken
   847	      if (banded && (sl.tof[seed] < band_lo || sl.tof[seed] >= band_hi)) continue;   // core owns it
   848	
   849	      // profile in frame order; pair BEFORE sorting (the first version sorted one array alone)
   850	      vector<pair<uint32_t, uint32_t>> pts;                   // (frame, peak)
   851	      pts.reserve(got.size());
   852	      for (uint32_t k : got) pts.emplace_back(frame_of[k], k);
   853	      sort(pts.begin(), pts.end());
   854	      Trace t;
   855	      t.xi.reserve(pts.size()); t.xv.reserve(pts.size());
   856	      size_t ap = 0;
   857	      for (size_t q = 0; q < pts.size(); ++q)
   858	      {
   859	        t.xi.push_back(sl.rt_index[pts[q].first]); t.xv.push_back(sl.inten[pts[q].second]);
   860	        if (t.xv[q] > t.xv[ap]) ap = q;
   861	      }
   862	      const uint32_t kap = pts[ap].second;
   863	      t.tof = sl.tof[kap]; t.b = sl.b[frame_of[kap]];
   864	      t.mz = cmz;                                              // the weighted centroid, as OpenMS reports
   865	      t.rt = rtAxis()[t.xi[ap]];
   866	      t.im = IM_LO + cim / IM_Q;
   867	      t.intensity = t.xv[ap];
   868	      out.push_back(std::move(t));
   869	    }
   870	    return out;
   871	  }
   872	
   873	  /// ElutionPeakDetection on a trace list -- the identical step the OpenMS path runs inside
   874	  /// detectTraces_ (same parameters), lifted out so the integer detector's output goes through it
   875	  /// too. The review of the first integer version found this step silently skipped.
   876	  vector<MassTrace> splitValleys(vector<MassTrace>& in, double split_valleys)
   877	  {
   878	    if (split_valleys <= 0.0 || in.empty()) return std::move(in);
   879	    ElutionPeakDetection epd;
   880	    epd.setLogType(ProgressLogger::NONE);
   881	    Param ep = epd.getParameters();
   882	    ep.setValue("chrom_fwhm", split_valleys);
   883	    ep.setValue("width_filtering", "off");
   884	    ep.setValue("masstrace_snr_filtering", "false");
   885	    epd.setParameters(ep);
   886	    vector<MassTrace> out; out.reserve(in.size());
   887	    epd.detectPeaks(in, out);
   888	    return out;
   889	  }
   890	
   891	  /// Integer traces -> MassTrace objects for EPD -> Trace again, with the flight-time bin
   892	  /// re-attached from the apex frame's calibration (the store is ~400x finer than a bin, so the
   893	  /// inversion recovers the measured bin exactly). Only the TRACES become OpenMS objects here --
   894	  /// the peak arrays never do, which is the point of the integer path.
   895	  vector<Trace> splitIntegerTraces(vector<Trace>& in, double split_valleys, const PeakSlab& sl)
   896	  {
   897	    if (split_valleys <= 0.0 || in.empty()) return std::move(in);
   898	    vector<MassTrace> mts; mts.reserve(in.size());
   899	    for (Trace& t : in)
   900	    {
   901	      std::list<Peak2D> pk;
   902	      for (size_t i = 0; i < t.np(); ++i)
   903	      { Peak2D q; q.setRT(t.rtAt(i)); q.setMZ(t.mz); q.setIntensity(t.xv[i]); pk.push_back(q); }
   904	      MassTrace mt(pk);
   905	      mt.setCentroidIM(t.im);
   906	      mts.push_back(std::move(mt));
   907	      t.freeProfile();
   908	    }
   909	    vector<Trace>().swap(in);
   910	    vector<MassTrace> split = splitValleys(mts, split_valleys);
   911	    // frame factor by RT index, to re-attach the bin at each split trace's apex
   912	    std::unordered_map<uint32_t, double> b_of_rt;
   913	    for (size_t f = 0; f < sl.frames(); ++f) b_of_rt[sl.rt_index[f]] = sl.b[f];
   914	    vector<Trace> out; out.reserve(split.size());
   915	    const TofAxis& ax = tofAxis();
   916	    for (const MassTrace& mt : split)
   917	    {
   918	      Trace t = toTrace(mt);
   919	      if (t.np() == 0) continue;
   920	      size_t ap = 0; for (size_t i = 1; i < t.np(); ++i) if (t.xv[i] > t.xv[ap]) ap = i;
   921	      auto it = b_of_rt.find(t.xi[ap]);
   922	      t.b = it != b_of_rt.end() ? it->second : ax.factor(0);
   923	      t.tof = ax.ok ? ax.tofOf(t.mz, t.b) : 0;
   924	      out.push_back(std::move(t));
   925	    }
   926	    return out;
   927	  }
   928	
   929	  /// Rebuild a PeakMap for ONE window from its compact frames, for MassTraceDetection.
   930	  /// Frames are consumed (cleared) as they are materialised so the compact store shrinks in step.
   931	  PeakMap materializeWindow(vector<CompactFrame>& frames)
   932	  {
   933	    PeakMap m;
   934	    m.reserve(frames.size());
   935	    for (auto& f : frames)
   936	    {
   937	      MSSpectrum s;
   938	      s.setRT(f.rt);
   939	      s.setMSLevel(1); // MassTraceDetection traces MS1-level only
   940	      s.reserve(f.mzq.size());
  1400	    // deliberate: mass-defect filter default OFF (would silently drop PTM/nonspecific — the discovery cases). [H-7]
  1401	  }
  1402	
  1403	  /// Configure an IM-aware MassTraceDetection and run it on @p map.
  1404	  /// MassTraceDetection wrapper. NOTE the apex gate inside MassTraceDetection is
  1405	  ///   peak_int > chrom_peak_snr * noise_threshold_int
  1406	  /// so the EFFECTIVE apex threshold is snr*noise, while trace MEMBERSHIP only needs > noise.
  1407	  /// Leaving snr at the OpenMS default 3.0 silently triples the fragment apex threshold.
  1408	  /// diaTracer deliberately runs MS2 with "more relaxed constraints" than MS1 (Nat Commun 16:95
  1409	  /// Methods) — so MS1 and MS2 get INDEPENDENT snr / min-length here. [recall]
  1410	  /// `map` is taken by NON-const ref and CLEARED as soon as MassTraceDetection has consumed it:
  1411	  /// it is dead from that point on, but at ~20 B/peak (Peak1D 16 + IM float 4) it is ~1.1 GB per
  1412	  /// window that would otherwise stay resident through the valley-splitting peak. [compact]
  1413	  vector<Trace> detectTraces_(PeakMap& map, double delta_im, double noise,
  1414	                              double snr, double min_len, double min_sample_rate, double max_len,
  1415	                              double split_valleys, String* span_log = nullptr, int bands = 1)
  1416	  {
  1417	    MassTraceDetection mtd;
  1418	    mtd.setLogType(ProgressLogger::NONE); // quiet + thread-safe (called from the parallel window loop)
  1419	    Param p = mtd.getParameters();
  1420	    p.setValue("mass_error_ppm", getDoubleOption_("trace:mass_error_ppm"));
  1421	    p.setValue("noise_threshold_int", noise);
  1422	    p.setValue("chrom_peak_snr", snr);
  1423	    p.setValue("ion_mobility_tolerance", delta_im);        // IM-aware tracing [C-1]
  1424	    p.setValue("min_trace_length", min_len);
  1425	    // min_sample_rate (OpenMS default 0.5) requires a peak in >=50% of visited scans AND terminates
  1426	    // trace extension when occupancy drops below it — an intensity-INDEPENDENT deletion of gappy but
  1427	    // real fragment traces in sparse diaPASEF data. Relaxing it for MS2 is the sole surviving MS2
  1428	    // trace-validity lever. [recall]
  1429	    if (min_sample_rate >= 0.0) p.setValue("min_sample_rate", min_sample_rate);
  1430	    if (max_len > 0.0) p.setValue("max_trace_length", max_len);
  1431	    mtd.setParameters(p);
  1432	
  1433	    // [epd-parallel] Reusable valley-split step. Called from a balanced parallel-for below, so 12
  1434	    // chunks split concurrently instead of once serially. Lock-free now that OpenMS EPD is patched
  1435	    // (patches/openms-epd-lockfree.patch); 96 concurrent callers (8 windows x 12 chunks) do not
  1436	    // contend. Output is order-independent downstream: MS2 traces are canonically re-sorted right
  1437	    // after detectTraces_, and ms1_traces are canonically sorted before inferPrecursors_.
  1438	    auto do_split = [&](vector<MassTrace>& in) -> vector<MassTrace> {
  1439	      if (split_valleys <= 0.0 || in.empty()) return std::move(in);
  1440	      ElutionPeakDetection epd;
  1441	      epd.setLogType(ProgressLogger::NONE);
  1442	      Param ep = epd.getParameters();
  1443	      ep.setValue("chrom_fwhm", split_valleys);
  1444	      ep.setValue("width_filtering", "off");
  1445	      ep.setValue("masstrace_snr_filtering", "false");
  1446	      epd.setParameters(ep);
  1447	      vector<MassTrace> out; out.reserve(in.size());
  1448	      epd.detectPeaks(in, out);
  1449	      return out;
  1450	    };
  1451	
  1452	    vector<MassTrace> mts;
  1453	    if (bands > 1)
  1454	    {
  1455	      // [bands] The diaPASEF method fixes the window count at 24, so parallelising over
  1456	      // windows caps us at 24 threads however many cores exist. Fragment traces at
  1457	      // different m/z are INDEPENDENT, so a window's peaks can be partitioned by m/z and
  1458	      // traced concurrently. A trace can never span more than mass_error_ppm in m/z, so a
  1459	      // halo of 20x that tolerance makes the partition exact; each trace is kept only by the
  1460	      // band whose CORE contains its centroid, so halo duplicates are dropped rather than merged.
  1461	      const double ppm = getDoubleOption_("trace:mass_error_ppm");
  1462	      // Band edges from m/z QUANTILES, not uniform m/z: peak density varies by orders of
  1463	      // magnitude across a window, and uniform edges would leave one band holding most of the work.
  1464	      vector<double> sample;
  1465	      for (const auto& s : map)
  1466	        for (Size i = 0; i < s.size(); i += 97) sample.push_back(s[i].getMZ());
  1467	      sort(sample.begin(), sample.end());
  1468	      vector<double> edge(bands + 1);
  1469	      if (sample.empty()) { edge.assign(bands + 1, 0.0); }
  1470	      else
  1471	        for (int b = 0; b <= bands; ++b)
  1472	          edge[b] = sample[std::min(sample.size() - 1, (size_t)((double)b / bands * sample.size()))];
  1473	      edge.front() = 0.0; edge.back() = std::numeric_limits<double>::max();
  1474	      vector<double> ().swap(sample);
  1475	
  1476	      // Partition ONCE (peaks are copied into exactly one core band plus any halo it falls in),
  1477	      // then release the source map so the halo duplicates are the only overhead.
  1478	      vector<PeakMap> sub(bands);
  1479	      for (auto& s : map)          // non-const: each spectrum is released once distributed
  1480	      {
  1481	        const auto* ima = s.getFloatDataArrays().empty() ? nullptr : &s.getFloatDataArrays()[0];
  1482	        for (int b = 0; b < bands; ++b)
  1483	        {
  1484	          // Size each halo from ITS OWN edge: one h derived from edge[b] under-sizes the upper
  1485	          // side by the ppm growth across the band. [adv-review 2026-09-03]
