   123	
   124	def precursors(mzml):
   125	    """(mz, charge) of every emitted spectrum."""
   126	    out, mz = [], None
   127	    for line in open(mzml, errors="replace"):
   128	        if "selected ion m/z" in line: mz = float(re.search(r'value="([^"]+)"', line).group(1))
   129	        elif "charge state" in line and mz is not None:
   130	            out.append((mz, int(re.search(r'value="([^"]+)"', line).group(1)))); mz = None
   131	    return out
   132	
   133	
   134	def peaks_of(mzml, prec_mz, tol=0.02):
   135	    """m/z list of the first spectrum whose selected ion is within tol of prec_mz."""
   136	    want, arr, prec = False, None, 8
   137	    for line in open(mzml, errors="replace"):
   138	        if "<spectrum " in line: want = False
   139	        elif "selected ion m/z" in line:
   140	            v = float(re.search(r'value="([^"]+)"', line).group(1)); want = abs(v - prec_mz) < tol
   141	        elif want and 'name="m/z array"' in line: arr = "mz"
   142	        elif want and 'name="intensity array"' in line: arr = "it"
   143	        elif want and 'name="64-bit float"' in line: prec = 8
   144	        elif want and 'name="32-bit float"' in line: prec = 4
   145	        elif want and arr == "mz" and "<binary>" in line:
   146	            b = line[line.find("<binary>") + 8: line.find("</binary>")]
   147	            raw = base64.b64decode(b)
   148	            return list(struct.unpack(f"<{len(raw)//prec}{'d' if prec == 8 else 'f'}", raw))
   149	    return []
   150	
   151	
   152	def ms1_traces_near(tsv, mz, tol=0.02):
   153	    """(n_xic, ...) of every MS1 trace in a diag:dump_ms1_tsv dump near an m/z."""
   154	    out = []
   155	    with open(tsv) as f:
   156	        hdr = next(f).rstrip("\n").split("\t")
   157	        for line in f:
   158	            q = dict(zip(hdr, line.rstrip("\n").split("\t")))
   159	            if abs(float(q["mz"]) - mz) < tol: out.append(int(q["n_xic"]))
   160	    return out
   161	
   162	
   163	def digest(mzml):
   164	    """Hash the spectrum data only -- the header carries a wall-clock stamp and parameters."""
   165	    h, on = hashlib.sha256(), False
   166	    for line in open(mzml, "rb"):
   167	        if b"<spectrumList" in line: on = True
   168	        if on: h.update(line)
   169	        if b"</spectrumList>" in line: break
   170	    return h.hexdigest()
   171	
