   114	def precursors(mzml):
   115	    """(mz, charge) of every emitted spectrum."""
   116	    out, mz = [], None
   117	    for line in open(mzml, errors="replace"):
   118	        if "selected ion m/z" in line: mz = float(re.search(r'value="([^"]+)"', line).group(1))
   119	        elif "charge state" in line and mz is not None:
   120	            out.append((mz, int(re.search(r'value="([^"]+)"', line).group(1)))); mz = None
   121	    return out
