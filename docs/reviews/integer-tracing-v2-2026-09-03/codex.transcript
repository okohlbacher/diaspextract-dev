   972	  /// ordering is the reader's business and need not match ours.
   973	  class PickCompactConsumer : public FullSwathFileConsumer
   974	  {
   975	  public:
   976	    PickCompactConsumer(PeakPickerIM& picker, map<pair<int, int>, vector<CompactFrame>>& windows,
   977	                        PeakMap& ms1, CompactStats& stats,
