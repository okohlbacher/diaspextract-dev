+    // 2b. [speXtract table-mz] EXACT license-free m/z from the MzCalibration table.
+    // Gated on strategy: an explicit LINEAR request must still get the linear chord (otherwise we
+    // silently override the user AND step 4 logs 'linear (GlobalMetadata)', which would be false).
+    // (Only where the SDK did not already install a vendor m/z converter -- that path returns early.)
+    if (strategy == Strategy::AUTO || strategy == Strategy::RATIONAL)
+    {
+    try
+    {
+      handle->tof2mz_converter = std::make_unique<TdfTableTof2MzConverter>(path_string);
+      g_mz_calibration = "tdf_table_modeltype1";
+      OPENMS_LOG_INFO << "TOF m/z calibration: TDF MzCalibration table model (exact, license-free)" << std::endl;
+    }
+    catch (const std::exception& e)
+    {
+      // FAIL CLOSED: the legacy chord is -5..-11 ppm wrong; emitting that silently is the defect
+      // this converter exists to remove, so an unusable calibration is an error, not a warning.
+      const char* allow_env = std::getenv("SPEXTRACT_ALLOW_CHORD_FALLBACK");
+      // Only an explicit "1" opts in: getenv() != nullptr would treat
+      // SPEXTRACT_ALLOW_CHORD_FALLBACK=0 (and "") as ENABLE, defeating the whole point.
+      if (allow_env == nullptr || std::string(allow_env) != "1")
+      {
+        throw Exception::FileNotReadable(__FILE__, __LINE__, OPENMS_PRETTY_FUNCTION,
+          String("exact TOF->m/z calibration unavailable (") + e.what() +
+          "). The legacy linear-in-sqrt fallback is -5..-11 ppm biased; set "
+          "SPEXTRACT_ALLOW_CHORD_FALLBACK=1 to use it anyway.");
+      }
+      g_mz_calibration = "legacy_chord_APPROXIMATE";
+      OPENMS_LOG_WARN << "TDF table m/z model unavailable (" << e.what()
+                      << "); SPEXTRACT_ALLOW_CHORD_FALLBACK=1 -> linear-in-sqrt approximation"
+                      << " (-5..-11 ppm bias)" << std::endl;
+    }
+    }  // end strategy gate
+
     // 3. Try rational model from TimsCalibration table (AUTO or RATIONAL)
     if (strategy == Strategy::AUTO || strategy == Strategy::RATIONAL)
     {
